  },
  {
    "name": "術士",
    "words": "…………",
    "voice": "vo_adv_2216003_001"
  },
  {
    "name": "旁白",
    "words": "在遠離蘭德索爾的荒地上──",
    "voice": null
  },
  {
    "name": "旁白",
    "words": "\\n【美食殿堂】與【術士】正對峙著。",
    "voice": null
  },
  {
    "name": "格魯尼",
    "words": "哎呀",
    "voice": "vo_adv_2216003_002"
  },
  {
    "name": "格魯尼",
    "words": "哎呀，各位。",
    "voice": null
  },
  {
    "name": "格魯尼",
    "words": "\\n勞駕你們特地前來，",
    "voice": null
  },
  {
    "name": "格魯尼",
    "words": "實在不勝榮幸。",
    "voice": null
  },
  {
    "name": "凱留",
    "words": "……把人叫到這麼冷清地方來。",
    "voice": "vo_adv_2216003_003"
  },
  {
    "name": "凱留",
    "words": "\\n是打算埋伏偷襲嗎？",
    "voice": null
  },
  {
    "name": "可可蘿",
    "words": "吉歐‧尼布爾黑爾──",
    "voice": "vo_adv_2216003_004"
  },
  {
    "name": "可可蘿",
    "words": "黑曜宮那場對決，",
    "voice": null
  },
  {
    "name": "可可蘿",
    "words": "雖然在下沒能參加。",
    "voice": null
  },
  {
    "name": "可可蘿",
    "words": "\\n但這一次，",
    "voice": null
  },
  {
    "name": "可可蘿",
    "words": "在下會全力輔佐主公大人他們，",
    "voice": null
  },
  {
    "name": "可可蘿",
    "words": "對抗到底。",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "正如聯絡時說的，",
    "voice": "vo_adv_2216003_005"
  },
  {
    "name": "八斗神",
    "words": "我們並沒有交戰的意思。",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "畢竟「這邊」的你們，",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "不是能輕易對付的對手，",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "這一點我們已經充分體會到了。",
    "voice": null
  },
  {
    "name": "雪菲",
    "words": "……在黑曜宮和我交手的，",
    "voice": "vo_adv_2216003_006"
  },
  {
    "name": "雪菲",
    "words": "是那邊那位穿鎧甲的人。",
    "voice": null
  },
  {
    "name": "雪菲",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "雪菲",
    "words": "在涅婭小姐的幫助下，",
    "voice": null
  },
  {
    "name": "雪菲",
    "words": "我拚盡全力，",
    "voice": null
  },
  {
    "name": "雪菲",
    "words": "\\n才總算讓對方撤退……",
    "voice": null
  },
  {
    "name": "雪菲",
    "words": "如果可以的話，",
    "voice": null
  },
  {
    "name": "雪菲",
    "words": "我也不想再打了。",
    "voice": null
  },
  {
    "name": "羅蘭",
    "words": "……是啊。",
    "voice": "vo_adv_2216003_007"
  },
  {
    "name": "羅蘭",
    "words": "\\n我也一樣。",
    "voice": null
  },
  {
    "name": "貪吃佩可",
    "words": "會想在這種地方，",
    "voice": "vo_adv_2216003_008"
  },
  {
    "name": "貪吃佩可",
    "words": "和原本敵對的我們談判。",
    "voice": null
  },
  {
    "name": "貪吃佩可",
    "words": "\\n應該是相當重要的事……",
    "voice": null
  },
  {
    "name": "貪吃佩可",
    "words": "對吧。",
    "voice": null
  },
  {
    "name": "格魯尼",
    "words": "我非常理解你們心中有所戒備。",
    "voice": "vo_adv_2216003_009"
  },
  {
    "name": "格魯尼",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "格魯尼",
    "words": "不過通訊魔法這種東西，",
    "voice": null
  },
  {
    "name": "格魯尼",
    "words": "還是有辦法監聽的。",
    "voice": null
  },
  {
    "name": "格魯尼",
    "words": "\\n如果是擁有高超駭客技術的人就有可能。",
    "voice": null
  },
  {
    "name": "雪菲",
    "words": "也就是說，",
    "voice": "vo_adv_2216003_010"
  },
  {
    "name": "雪菲",
    "words": "是件不想被別人聽見",
    "voice": null
  },
  {
    "name": "雪菲",
    "words": "的重要事情呢。",
    "voice": null
  },
  {
    "name": "雪菲",
    "words": "\\n那到底是……？",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "我就單刀直入地說了。",
    "voice": "vo_adv_2216003_011"
  },
  {
    "name": "八斗神",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "要不要，",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "和我們聯手？",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "這是我的提議。",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "我也曾經向尤絲蒂亞娜前公主",
    "voice": "vo_adv_2216003_012"
  },
  {
    "name": "八斗神",
    "words": "提出過類似的方案，卻遭到拒絕。",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "\\n那時候，",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "條件是建立在我方占有優勢的前提上。",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "但這一次我會盡可能",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "做出最大讓步。",
    "voice": null
  },
  {
    "name": "貪吃佩可",
    "words": "……在醫院被抓到的時候，",
    "voice": "vo_adv_2216003_013"
  },
  {
    "name": "貪吃佩可",
    "words": "我記得，",
    "voice": null
  },
  {
    "name": "貪吃佩可",
    "words": "\\n那時的提案是要我們",
    "voice": null
  },
  {
    "name": "貪吃佩可",
    "words": "協助",
    "voice": null
  },
  {
    "name": "貪吃佩可",
    "words": "逮捕七冠吧。",
    "voice": null
  },
  {
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "貪吃佩可",
    "words": "作為交換，",
    "voice": null
  },
  {
    "name": "貪吃佩可",
    "words": "會確保我們在現實中的安全……",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "是的。",
    "voice": "vo_adv_2216003_014"
  },
  {
    "name": "八斗神",
    "words": "\\n那之後你們逃走時造成的",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "器物損壞，",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "以及妨礙公務執行，都既往不咎。",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "當然，",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "也不會把你們當成引誘七冠現身的誘餌。",
    "voice": null
  },
  {
    "name": "凱留",
    "words": "哼……！",
    "voice": "vo_adv_2216003_015"
  },
  {
    "name": "凱留",
    "words": "\\n那種條件，",
    "voice": null
  },
  {
    "name": "凱留",
    "words": "我們怎麼可能",
    "voice": null
  },
  {
    "name": "凱留",
    "words": "接受啊！",
    "voice": null
  },
  {
    "name": "可可蘿",
    "words": "是的。",
    "voice": "vo_adv_2216003_016"
  },
  {
    "name": "可可蘿",
    "words": "\\n在下不想做出",
    "voice": null
  },
  {
    "name": "可可蘿",
    "words": "會造成父親大人負擔的事。",
    "voice": null
  },
  {
    "name": "凱留",
    "words": "……再說，",
    "voice": "vo_adv_2216003_017"
  },
  {
    "name": "凱留",
    "words": "我本來就不覺得",
    "voice": null
  },
  {
    "name": "凱留",
    "words": "自己能成為",
    "voice": null
  },
  {
    "name": "凱留",
    "words": "\\n讓陛下現身的「誘餌」就是了……",
    "voice": null
  },
  {
    "name": "雪菲",
    "words": "──那個，",
    "voice": "vo_adv_2216003_018"
  },
  {
    "name": "雪菲",
    "words": "\\n既然如此，",
    "voice": null
  },
  {
    "name": "雪菲",
    "words": "你們為什麼想和我們聯手呢？",
    "voice": null
  },
  {
    "name": "雪菲",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "雪菲",
    "words": "只要你們什麼都不做，",
    "voice": null
  },
  {
    "name": "雪菲",
    "words": "我們也不會做什麼……",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "那當然是──",
    "voice": "vo_adv_2216003_019"
  },
  {
    "name": "八斗神",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "為了對抗",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "幻境龍后。",
    "voice": null
  },
  {
    "name": "貪吃佩可",
    "words": "咦？",
    "voice": "vo_adv_2216003_020"
  },
  {
    "name": "貪吃佩可",
    "words": "\\n可是，",
    "voice": null
  },
  {
    "name": "貪吃佩可",
    "words": "你們不是",
    "voice": null
  },
  {
    "name": "貪吃佩可",
    "words": "和幻境龍后──",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "……嗯。",
    "voice": "vo_adv_2216003_021"
  },
  {
    "name": "八斗神",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "聯合國與幻境龍后",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "曾經是合作關係。",
    "voice": null
  },
  {
    "name": "凱留",
    "words": "事到如今還說什麼啊。",
    "voice": "vo_adv_2216003_022"
  },
  {
    "name": "凱留",
    "words": "\\nWISDOM",
    "voice": null
  },
  {
    "name": "凱留",
    "words": "是隸屬於聯合國的組織。",
    "voice": null
  },
  {
    "name": "凱留",
    "words": "\\n而七冠，",
    "voice": null
  },
  {
    "name": "凱留",
    "words": "就是WISDOM的最高層吧。",
    "voice": null
  },
  {
    "name": "格魯尼",
    "words": "正確來說，",
    "voice": "vo_adv_2216003_023"
  },
  {
    "name": "格魯尼",
    "words": "那是在七冠成立前──",
    "voice": null
  },
  {
    "name": "格魯尼",
    "words": "\\n早在LoA正式開發之前，",
    "voice": null
  },
  {
    "name": "格魯尼",
    "words": "就已經存在的關係了。",
    "voice": null
  },
  {
    "name": "格魯尼",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "格魯尼",
    "words": "……順帶一提，",
    "voice": null
  },
  {
    "name": "格魯尼",
    "words": "那也是在我就職之前的事。",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "當時──",
    "voice": "vo_adv_2216003_024"
  },
  {
    "name": "八斗神",
    "words": "ICPO內部，",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "存在著一個隱藏的問題。",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "\\n「無法處刑的存在」。",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "\\n因為是超乎常理的現象，",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "只能設法應對那些無法處刑或囚禁的人。",
    "voice": null
  },
  {
    "name": "可可蘿",
    "words": "……超乎常理的",
    "voice": "vo_adv_2216003_025"
  },
  {
    "name": "可可蘿",
    "words": "現象……？",
    "voice": null
  },
  {
    "name": "可可蘿",
    "words": "\\n是像矛依未小姐，",
    "voice": null
  },
  {
    "name": "可可蘿",
    "words": "或美空小姐那樣……？",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "矛依未──",
    "voice": "vo_adv_2216003_026"
  },
  {
    "name": "八斗神",
    "words": "園上矛依未嗎。",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "不算完全對，",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "但也差不多。",
    "voice": null
  },
  {
    "name": "格魯尼",
    "words": "根據傳聞，",
    "voice": "vo_adv_2216003_027"
  },
  {
    "name": "格魯尼",
    "words": "LoA的開發目的之一？",
    "voice": null
  },
  {
    "name": "格魯尼",
    "words": "\\n似乎就是園上矛依未小姐",
    "voice": null
  },
  {
    "name": "格魯尼",
    "words": "的「超能力模擬」。",
    "voice": null
  },
  {
    "name": "格魯尼",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "格魯尼",
    "words": "不過，到假想空間的「靈魂轉換」研究，",
    "voice": null
  },
  {
    "name": "格魯尼",
    "words": "似乎在那之前就已經開始了。",
    "voice": null
  },
  {
    "name": "雪菲",
    "words": "你說的那個",
    "voice": "vo_adv_2216003_028"
  },
  {
    "name": "雪菲",
    "words": "應該",
    "voice": null
  },
  {
    "name": "雪菲",
    "words": "就是mimi……",
    "voice": null
  },
  {
    "name": "雪菲",
    "words": "對吧。",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "在初期階段，",
    "voice": "vo_adv_2216003_029"
  },
  {
    "name": "八斗神",
    "words": "它被稱為「M２轉換器」。",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "而在將近十年前──",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "創造出其核心技術的人，",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "便是棗宙氏。",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "以及，",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "一位名為「Vision's Error」",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "的約聘人員。",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "那個，",
    "voice": "vo_adv_2216003_030"
  },
  {
    "name": "八斗神",
    "words": "就是幻境龍后過去使用的暱稱。",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "雖然真實身分不明，",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "但她從當時開始，",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "就已經是Wizard級的白帽駭客。",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "\\n而將構築中的假想空間",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "作為「牢籠」使用的，",
    "voice": null
  },
  {
    "name": "八斗神",
    "words": "也是她。",
    "voice": null
  },
  {
    "name": "大家",
    "words": "……！！",
    "voice": "vo_adv_2216003_031"
  },
  {
    "name": "凱留",
    "words": "──這樣啊。",
    "voice": "vo_adv_2216003_032"
  },
  {
    "name": "凱留",
    "words": "說到牢籠……",
    "voice": null
  },
  {
    "name": "凱留",
    "words": "\\n造成「米奈娃的禁錮」的元兇，",
    "voice": null
  },
  {
    "name": "凱留",
    "words": "也是幻境龍后對吧。",
    "voice": null
  },
  {
    "name": "凱留",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "凱留",
    "words": "她破壞了",
    "voice": null
  },
  {
    "name": "凱留",
    "words": "拉比林斯達",
