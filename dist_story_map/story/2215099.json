    },
    {
        "name": "芙蕾雅",
        "words": "\\n聽說，",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "會讀取造訪者的記憶，",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "\\n並創造出角色的幻影……",
