    },
    {
        "name": "拿娜",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "拿娜",
        "words": "怎麼辦～",
        "voice": null
    },
    {
        "name": "拿娜",
        "words": "要是魔物跑出來的話，",
        "voice": null
