    {
        "name": "旁白",
        "words": "慶祝戰勝阿剌克涅女士的宴會結束後，",
        "voice": null
    },
    {
        "name": "旁白",
        "words": "\\n萊拉耶爾一行人離開了吉歐‧格黑納。",
        "voice": null
    },
    {
        "name": "旁白",
        "words": "\\n隔天──",
        "voice": null
    },
    {
        "name": "拿娜",
        "words": "咦～！",
        "voice": "vo_adv_2209108_000"
    },
    {
        "name": "拿娜",
        "words": "\\n庫露露她",
        "voice": null
    },
    {
        "name": "拿娜",
        "words": "在那個叫吉歐‧提格尼亞的地方嗎！？",
        "voice": null
    },
    {
        "name": "鳳凰",
        "words": "拿娜，",
        "voice": "vo_adv_2209108_001"
    },
    {
        "name": "鳳凰",
        "words": "發生什麼事了嗎？",
        "voice": null
    },
    {
        "name": "鳳凰",
        "words": "\\n聽妳叫得那麼大聲。",
        "voice": null
    },
    {
        "name": "拿娜",
        "words": "那個啊，",
        "voice": "vo_adv_2209108_002"
    },
    {
        "name": "拿娜",
        "words": "剛才可可蘿在跟雪菲說話，",
        "voice": null
    },
    {
        "name": "拿娜",
        "words": "\\n但是",
        "voice": null
    },
    {
        "name": "拿娜",
        "words": "大家好像也認識庫露露……",
        "voice": null
    },
    {
        "name": "鳳凰",
        "words": "嗯、",
        "voice": "vo_adv_2209108_003"
    },
    {
        "name": "鳳凰",
        "words": "嗯～？",
        "voice": null
    },
    {
        "name": "可可蘿",
        "words": "剛才",
        "voice": "vo_adv_2209108_004"
    },
    {
        "name": "可可蘿",
        "words": "加上拿娜小姐，",
        "voice": null
    },
    {
        "name": "可可蘿",
        "words": "我們正在和雪菲小姐講述",
        "voice": null
    },
    {
        "name": "可可蘿",
        "words": "\\n在背面世界的所見所聞。",
        "voice": null
    },
    {
        "name": "雪菲",
        "words": "在我聽著有關吉歐‧提格尼亞這個世界的事情時，",
        "voice": "vo_adv_2209108_005"
    },
    {
        "name": "雪菲",
        "words": "\\n對話中似乎提到了拿娜小姐認識的人。",
        "voice": null
    },
    {
        "name": "拿娜",
        "words": "不對，",
        "voice": "vo_adv_2209108_006"
    },
    {
        "name": "拿娜",
        "words": "不只是認識的人。",
        "voice": null
    },
    {
        "name": "拿娜",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "拿娜",
        "words": "庫露露是拿娜的表妹喔～！",
        "voice": null
    },
    {
        "name": "可可蘿",
        "words": "原來如此，",
        "voice": "vo_adv_2209108_007"
    },
    {
        "name": "可可蘿",
        "words": "她是您的親戚啊。",
        "voice": null
    },
    {
        "name": "可可蘿",
        "words": "\\n儘管有著獨角兔與寶石兔的種族差異，",
        "voice": null
    },
    {
        "name": "可可蘿",
        "words": "\\n不過經您這麼一說，",
        "voice": null
    },
    {
        "name": "可可蘿",
        "words": "兩位確實",
        "voice": null
    },
    {
        "name": "可可蘿",
        "words": "感覺有些相像呢。",
        "voice": null
    },
    {
        "name": "拿娜",
        "words": "嘿嘿，",
        "voice": "vo_adv_2209108_008"
    },
    {
        "name": "拿娜",
        "words": "就是說啊～",
        "voice": null
    },
    {
        "name": "拿娜",
        "words": "\\n庫露露",
        "voice": null
    },
    {
        "name": "拿娜",
        "words": "不知道過得好不好呢？",
        "voice": null
    },
    {
        "name": "拿娜",
        "words": "\\n好久沒見到她了，",
        "voice": null
    },
    {
        "name": "拿娜",
        "words": "真想跟她聊聊呀～",
        "voice": null
    },
    {
        "name": "鳳凰",
        "words": "想見的話不是見得到嗎？",
        "voice": "vo_adv_2209108_009"
    },
    {
        "name": "鳳凰",
        "words": "\\n據說只要穿過那個叫門的地方，",
        "voice": null
    },
    {
        "name": "鳳凰",
        "words": "就能一口氣飛到不同世界了。",
        "voice": null
    },
    {
        "name": "拿娜",
        "words": "啊，",
        "voice": "vo_adv_2209108_010"
    },
    {
        "name": "拿娜",
        "words": "這樣啊！",
        "voice": null
    },
    {
        "name": "拿娜",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "拿娜",
        "words": "那拿娜",
        "voice": null
    },
    {
        "name": "拿娜",
        "words": "就去找庫露露好了～",
        "voice": null
    },
    {
        "name": "拿娜",
        "words": "\\n拿娜要跟她一起在甜點遊樂園玩～♪",
        "voice": null
    },
    {
        "name": "雪菲",
        "words": "等等，",
        "voice": "vo_adv_2209108_011"
    },
    {
        "name": "雪菲",
        "words": "那裡是能這麼隨便就過去的地方嗎？",
        "voice": null
    },
    {
        "name": "雪菲",
        "words": "\\n應該",
