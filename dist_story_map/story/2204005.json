    },
    {
        "name": "可可蘿",
        "words": "飯糰先生，",
        "voice": "vo_adv_2204005_002"
    },
    {
        "name": "可可蘿",
        "words": "非常感謝您……！",
        "voice": null
    },
    {
        "name": "小飯糰",
        "words": "嗶咕～！",
        "voice": "vo_adv_2204005_003"
    },
    {
        "name": "庫露露",
        "words": "好的！",
        "voice": "vo_adv_2204005_004"
    },
    {
        "name": "庫露露",
        "words": "\\n祝各位",
        "voice": null
    },
    {
        "name": "庫露露",
        "words": "武運昌隆！",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "…………",
        "voice": "vo_adv_2204005_005"
    },
    {
        "name": "芙蕾雅",
        "words": "強化了奇怪的巨鼠，",
        "voice": "vo_adv_2204005_006"
    },
    {
        "name": "芙蕾雅",
        "words": "讓牠加速。",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "\\n周圍則是用寶石魔法展開防禦屏障，",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "來對抗妨礙──",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "看起來是成功突破魔物陣，",
        "voice": "vo_adv_2204005_007"
    },
    {
        "name": "芙蕾雅",
        "words": "\\n也同時保留自己的力量了。",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "不過那滑稽的樣子，",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "已經不是傻眼……",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "而是啞口無言了呢。",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "而且……",
        "voice": "vo_adv_2204005_008"
    },
    {
        "name": "可可蘿",
        "words": "請老實地束手就擒吧，",
        "voice": "vo_adv_2204005_009"
    },
    {
        "name": "可可蘿",
        "words": "芙蕾雅小姐！",
        "voice": null
    },
    {
        "name": "凱留",
        "words": "妳快給我把魔物給停下來！",
        "voice": "vo_adv_2204005_010"
    },
    {
        "name": "凱留",
        "words": "\\n不然我就把妳這比該死的眼鏡女還該死的黑眼鏡，",
        "voice": null
    },
    {
        "name": "凱留",
        "words": "\\n連同腦袋一起炸飛！",
        "voice": null
    },
    {
        "name": "貪吃佩可",
        "words": "比起妳叫魔物過來，",
        "voice": "vo_adv_2204005_011"
    },
    {
        "name": "貪吃佩可",
        "words": "\\n我們攻擊的速度可是更快的！",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "……初次會面。",
        "voice": "vo_adv_2204005_012"
    },
    {
        "name": "芙蕾雅",
        "words": "\\n公主‧尤絲蒂亞娜。",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "本來應該是",
        "voice": "vo_adv_2204005_013"
    },
    {
        "name": "芙蕾雅",
        "words": "要把妳帶上處刑台的……",
        "voice": null
    },
    {
        "name": "貪吃佩可",
        "words": "請容我全力拒絕！",
        "voice": "vo_adv_2204005_014"
    },
    {
        "name": "貪吃佩可",
        "words": "\\n我不只還有很多該做的事，",
        "voice": null
    },
    {
        "name": "貪吃佩可",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "貪吃佩可",
        "words": "也",
        "voice": null
    },
    {
        "name": "貪吃佩可",
        "words": "還有該咬的小凱留！",
        "voice": null
    },
    {
        "name": "凱留",
        "words": "慢著！？",
        "voice": "vo_adv_2204005_015"
    },
    {
        "name": "凱留",
        "words": "\\n後半不管怎麼想都不需要吧！",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "該做的事……",
        "voice": "vo_adv_2204005_016"
    },
    {
        "name": "芙蕾雅",
        "words": "是嗎。",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "那是",
        "voice": "vo_adv_2204005_017"
    },
    {
        "name": "芙蕾雅",
        "words": "身為【美食殿堂】的貪吃佩可，",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "奪回夥伴嗎？",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "還是──",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "身為被革命而遭放逐的",
        "voice": "vo_adv_2204005_018"
    },
    {
        "name": "芙蕾雅",
        "words": "尤絲蒂亞娜‧F‧阿斯特賴亞。",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "\\n藉由拯救昏睡狀態的玩家，",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "彰顯功績，",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "\\n找回失散的民心，",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "好奪回失去的王國呢？",
        "voice": null
    },
    {
        "name": "貪吃佩可",
        "words": "咦！？",
        "voice": "vo_adv_2204005_019"
    },
    {
        "name": "凱留",
        "words": "妳",
        "voice": "vo_adv_2204005_020"
    },
    {
        "name": "凱留",
        "words": "為什麼會連這種事都知道！？",
        "voice": null
    },
    {
        "name": "凱留",
        "words": "\\n妳沒有受到",
        "voice": null
    },
    {
        "name": "凱留",
        "words": "認知修正嗎！？",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "…………",
        "voice": "vo_adv_2204005_021"
    },
    {
        "name": "可可蘿",
        "words": "並不只是知道這邊的事而已。",
        "voice": "vo_adv_2204005_022"
    },
    {
        "name": "可可蘿",
        "words": "\\n妳所操控的魔物，",
        "voice": null
    },
    {
        "name": "可可蘿",
        "words": "是阿斯特賴亞大陸的魔物對吧。",
        "voice": null
    },
    {
        "name": "可可蘿",
        "words": "\\n也就是說，",
        "voice": null
    },
    {
        "name": "可可蘿",
        "words": "在這個世界裡釋放魔物的人",
        "voice": null
    },
    {
        "name": "可可蘿",
        "words": "就是妳嗎？",
        "voice": null
    },
    {
        "name": "貪吃佩可",
        "words": "假設就算是這樣，",
        "voice": "vo_adv_2204005_023"
    },
    {
        "name": "貪吃佩可",
        "words": "那又是為什麼要這麼做……？",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "…………",
        "voice": "vo_adv_2204005_024"
    },
    {
        "name": "芙蕾雅",
        "words": "還真是",
        "voice": "vo_adv_2204005_025"
    },
    {
        "name": "芙蕾雅",
        "words": "接二連三地問人問題呢。",
        "voice": null
    },
    {
        "name": "凱留",
        "words": "哼！",
        "voice": "vo_adv_2204005_026"
    },
    {
        "name": "凱留",
        "words": "\\n看妳是要在這邊還能輕鬆的時候說，",
        "voice": null
    },
    {
        "name": "凱留",
        "words": "還是要在牢房裡接受拷問，",
        "voice": null
    },
    {
        "name": "凱留",
        "words": "\\n選一個妳喜歡的啦！",
        "voice": null
    },
    {
        "name": "可可蘿",
        "words": "凱留小姐……",
        "voice": "vo_adv_2204005_027"
    },
    {
        "name": "可可蘿",
        "words": "\\n那種態度",
        "voice": null
    },
    {
        "name": "可可蘿",
        "words": "會被人當成是找架吵的。",
        "voice": null
    },
    {
        "name": "凱留",
        "words": "沒關係啦，反正是她先打過來的！",
        "voice": "vo_adv_2204005_028"
    },
    {
        "name": "芙蕾雅",
        "words": "是的。",
        "voice": "vo_adv_2204005_029"
    },
    {
        "name": "芙蕾雅",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "如同霸瞳皇帝的前公主騎士所說，",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "\\n是我方先宣戰的。",
        "voice": null
    },
    {
        "name": "凱留",
        "words": "……！？",
        "voice": "vo_adv_2204005_030"
    },
    {
        "name": "芙蕾雅",
        "words": "接著來",
        "voice": "vo_adv_2204005_031"
    },
    {
        "name": "芙蕾雅",
        "words": "回答嚮導老君之女的提問。",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "\\n在這個世界裡肆虐的魔物，",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "確實是出自於我。",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "畢竟也有著",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "間接證據……",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "我不會說任何藉口。",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "目的是……",
        "voice": "vo_adv_2204005_032"
    },
    {
        "name": "芙蕾雅",
        "words": "武力偵查，",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "該這麼說吧。",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "\\n因為我也必須認識這個世界。",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "隨後就馬上知道了，",
        "voice": "vo_adv_2204005_033"
    },
    {
        "name": "芙蕾雅",
        "words": "\\n這裡是個與爭鬥無緣、",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "和平癡呆般的世界。",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "當初若是",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "能就那樣推翻王政的話，",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "事情就簡單了……",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "但多虧了從某處來的某群人，",
        "voice": "vo_adv_2204005_034"
    },
    {
        "name": "芙蕾雅",
        "words": "親切地打倒了",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "\\n我特地從阿斯特賴亞大陸",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "召喚過來的魔物。",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "\\n導致事情沒有那麼順利。",
        "voice": null
    },
    {
        "name": "凱留",
        "words": "那還真是不好意思～",
        "voice": "vo_adv_2204005_035"
    },
    {
        "name": "凱留",
        "words": "\\n感覺超棒的啊！",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "……果然沒錯。",
        "voice": "vo_adv_2204005_036"
    },
    {
        "name": "芙蕾雅",
        "words": "\\n你們是如此愚昧，",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "無藥可救的存在。",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "但對我來說，",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "卻是絕不可能相容的敵人呢。",
        "voice": null
    },
    {
        "name": "可可蘿",
        "words": "……",
        "voice": "vo_adv_2204005_037"
    },
    {
        "name": "可可蘿",
        "words": "妳說「我」，",
        "voice": "vo_adv_2204005_038"
    },
    {
        "name": "可可蘿",
        "words": "但不應該是「我們」",
        "voice": null
    },
    {
        "name": "可可蘿",
        "words": "嗎？",
        "voice": null
    },
    {
        "name": "可可蘿",
        "words": "\\n能夠操控如此眾多的魔物，",
        "voice": null
    },
    {
        "name": "可可蘿",
        "words": "還把它們從不同世界帶過來……",
        "voice": null
    },
    {
        "name": "可可蘿",
        "words": "\\n不──",
        "voice": null
    },
    {
        "name": "可可蘿",
        "words": "如果只是暫時打開空間的孔洞並不困難，",
        "voice": "vo_adv_2204005_039"
    },
    {
        "name": "可可蘿",
        "words": "但要像現在這樣，",
        "voice": null
    },
    {
        "name": "可可蘿",
        "words": "\\n雖是斷斷續續，",
        "voice": null
    },
    {
        "name": "可可蘿",
        "words": "卻「恆常維持連結的狀態」的話。",
        "voice": null
    },
    {
        "name": "可可蘿",
        "words": "\\n就算是跳躍王，",
        "voice": null
    },
    {
        "name": "可可蘿",
        "words": "也不可能獨力完成這種事。",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "……真是慧眼。",
        "voice": "vo_adv_2204005_040"
    },
    {
        "name": "芙蕾雅",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "以妳的年紀來說，",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "只能說佩服了。",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "就如同你們所知道的。",
        "voice": "vo_adv_2204005_041"
    },
    {
        "name": "芙蕾雅",
        "words": "現在的阿斯特朗傳奇，",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "\\n雖然看似",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "與以前的一模一樣……",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "\\n但跟再再構築前相比，",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "非常「脆弱」。",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "只要多少知道要領，",
        "voice": "vo_adv_2204005_042"
    },
    {
        "name": "芙蕾雅",
        "words": "就算是本來無法存取的領域──",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "\\n也能夠連接。",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "例如，",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "\\n「原本是用以測試新種族功能的環境」。",
        "voice": null
    },
    {
        "name": "大家",
        "words": "……！！",
        "voice": "vo_adv_2204005_043"
    },
    {
        "name": "芙蕾雅",
        "words": "若將「米奈娃的禁錮」以前的，",
        "voice": "vo_adv_2204005_044"
    },
    {
        "name": "芙蕾雅",
        "words": "\\n「正常營運的阿斯特朗傳奇」稱為",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "version 1，",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "\\n禁錮後的version 2",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "稱為「扭曲的世界」。",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "現在這個再再構築後的世界",
        "voice": "vo_adv_2204005_045"
    },
    {
        "name": "芙蕾雅",
        "words": "──version 3，",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "並不是像version 2那樣，",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "\\n有著「冒險會永遠持續下去」這種願望",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "支撐的世界。",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "\\n只是由集合的無意識幻想",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "撐起，",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "沒有梁柱的脆弱之屋。",
        "voice": null
    },
    {
        "name": "芙蕾雅",
        "words": "……我也是。",
        "voice": "vo_adv_2204005_046"
