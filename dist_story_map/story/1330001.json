  {
    "name": "格蕾斯",
    "words": "呵呵。",
    "voice": "vo_adv_1330001_003"
  },
  {
    "name": "格蕾斯",
    "words": "我開玩笑的。",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "而且說起來牆壁根本就沒有意義。",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "\\n我可是亡靈，",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "能輕易穿透牆壁。",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "就像這樣，",
    "voice": "vo_adv_1330001_004"
  },
  {
    "name": "格蕾斯",
    "words": "你看。",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "\\n咻──",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "哇。",
    "voice": "vo_adv_1330001_005"
  },
  {
    "name": "格蕾斯",
    "words": "……嗯。",
    "voice": "vo_adv_1330001_006"
  },
  {
