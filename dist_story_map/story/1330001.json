  {
    "name": "旁白",
    "words": "與阿剌克涅的戰鬥結束後，在吉歐‧格黑納的鬼岩城塞──",
    "voice": null
  },
  {
    "name": "旁白",
    "words": "\\n格蕾斯與{0}，",
    "voice": null
  },
  {
