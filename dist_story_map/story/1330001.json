    "words": "騎士氏。",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "是的。",
    "voice": "vo_adv_1330001_002"
  },
  {
    "name": "格蕾斯",
    "words": "\\n我打算偷窺溫泉。",
    "voice": null
