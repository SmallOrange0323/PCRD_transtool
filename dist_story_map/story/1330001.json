    "name": "格蕾斯",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "但是很感謝你",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "陪同我進行調查。",
    "voice": null
