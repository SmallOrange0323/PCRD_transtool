  },
  {
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "肯定是在平時，",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "就以會被魔物破壞為前提……",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null
  },
