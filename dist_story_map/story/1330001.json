  },
  {
    "name": "格蕾斯",
    "words": "是嗎。",
    "voice": "vo_adv_1330001_011"
  },
  {
    "name": "格蕾斯",
    "words": "那真是失禮了。",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "……不過就是因為這樣，",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "我才來調查溫泉周圍的。",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "絕對不能讓我們家公主的柔嫩肌膚",
    "voice": "vo_adv_1330001_012"
  },
  {
    "name": "格蕾斯",
    "words": "\\n被任何不肖之徒看到。",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "所以說騎士氏。",
    "voice": "vo_adv_1330001_013"
  },
  {
