    "words": "涅妃‧涅羅皇女她，",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "\\n提議要邀請我們的公主",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "\\n一起去泡溫泉，",
    "voice": null
  },
  {
