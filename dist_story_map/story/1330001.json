  {
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "雖然現在才說有點晚了，",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "但簡單來說就是……",
    "voice": null
  },
  {
    "name": "格蕾斯",
