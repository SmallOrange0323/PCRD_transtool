[
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這一帶雪積得太厚了，",
    "voice": "vo_adv_9042155_000",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好難前進啊～",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嘿咻、",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嘿咻。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我說，",
    "voice": "vo_adv_9042155_001",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我們從早上到現在一直走個不停，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "但根本完全沒前進多少吧？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我們有辦法在太陽下山前抵達安全的地方嗎……",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "確實是",
    "voice": "vo_adv_9042155_002",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "有點令人不安呢。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "再次",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "深切地感受到雪山的可怕。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不過，",
    "voice": "vo_adv_9042155_003",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我們這次也是有備而來的♪",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我們身上還掛著避獸鈴呢！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "更重要的是，多虧了可蘿仔為我們做的禦寒用品，",
    "voice": "vo_adv_9042155_004",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就不用擔心會凍傷了！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小凱留說的沒錯！",
    "voice": "vo_adv_9042155_005",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小可蘿用之前打倒的格里芬的羽毛",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "親手做了禦寒用品♪",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "又輕盈又保暖，",
    "voice": "vo_adv_9042155_006",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "真是",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "太理想了！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "外觀也毛茸茸的，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "很可愛，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "太讚了吧☆",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呵呵，",
    "voice": "vo_adv_9042155_007",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "謝謝您的誇獎。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n不愧是",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "棲息在這座雪山的",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "格里芬的羽毛。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "只是走了一段路，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "全身就暖烘烘的了。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是呀♪",
    "voice": "vo_adv_9042155_008",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "多虧這樣，探索也輕鬆許多──",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "哇啊！？",
    "voice": "vo_adv_9042155_009",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那是",
    "voice": "vo_adv_9042155_010",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "狼嗎？",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不過，看起來又是沒見過的顏色的……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "稀有品種呢。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "比起這個……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "等一下！",
    "voice": "vo_adv_9042155_011",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這個鈴鐺的用途",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不是避獸嗎！？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "完全沒有派上用場呀！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我還滿心期待的掛在身上，虧大了～！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "才不虧呢！",
    "voice": "vo_adv_9042155_012",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "掛著鈴鐺的小凱留像隻貓咪一樣，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "非常可愛呀♪",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳是從什麼角度在看這件事呀！？",
    "voice": "vo_adv_9042155_013",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n小心我宰了妳！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但也不光是這樣……",
    "voice": "vo_adv_9042155_014",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "有點令人意外呢。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "原本狼就是一種",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "高智商的生物，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "沒道理無緣無故攻擊人類的。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "可是，",
    "voice": "vo_adv_9042155_015",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "妳們不覺得牠有點亢奮嗎？",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "感覺隨時都要撲過來了。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是呀，",
    "voice": "vo_adv_9042155_016",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "牠很明顯盯上我們了。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不會無緣無故攻擊人類的說法",
    "voice": "vo_adv_9042155_017",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "本身就是一種迷信吧？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不然牠把我們當成什麼──",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "啊。",
    "voice": "vo_adv_9042155_018",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "恐怕是──",
    "voice": "vo_adv_9042155_019",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "莫非──",
    "voice": "vo_adv_9042155_020",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "難不成──",
    "voice": "vo_adv_9042155_021",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "牠把我們誤認成格里芬的幼鳥了！？",
    "voice": "vo_adv_9042155_022",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "等、",
    "voice": "vo_adv_9042155_023",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "等一下！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你看清楚！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我們是",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "人類！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不是格里芬啦！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "唔……",
    "voice": "vo_adv_9042155_024",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "如果我們卸下禦寒用品，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "或許牠就會認出我們是人類了。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "可是……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "駁回！",
    "voice": "vo_adv_9042155_025",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我已經受夠寒冷的環境了！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "既然如此，",
    "voice": "vo_adv_9042155_026",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我們就反過來收拾牠吧！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "今天就決定吃",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "狼肋排囉♪",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳別擅自決定啦！",
    "voice": "vo_adv_9042155_027",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "沒有人答應要吃那種東西吧！？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "貪吃佩可小姐，",
    "voice": "vo_adv_9042155_028",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "凱留小姐，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "魔物朝這邊過來了……！",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n就先聊到這裡吧。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "迎戰吧！",
    "voice": null,
    "unit_id": 105911
  }
