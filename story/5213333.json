[
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "尤絲蒂亞娜……",
    "voice": "vo_adv_5213333_000",
    "unit_id": 20013
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "這傢伙，",
    "voice": null,
    "unit_id": 20013
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "\\n就算被打成這樣也還不倒下……！",
    "voice": null,
    "unit_id": 20013
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "\\n明明已經傷痕累累、",
    "voice": null,
    "unit_id": 20013
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "搖搖欲墜了，",
    "voice": null,
    "unit_id": 20013
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "可是即使如此……！！",
    "voice": null,
    "unit_id": 20013
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "我無法想像……",
    "voice": "vo_adv_5213333_001",
    "unit_id": 20013
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "她倒下的樣子……！",
    "voice": null,
    "unit_id": 20013
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "耶嘿嘿……",
    "voice": "vo_adv_5213333_002",
    "unit_id": 138312
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 138312
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "如果只有我一個人，早就已經倒下了喔。",
    "voice": null,
    "unit_id": 138312
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……是我",
    "voice": "vo_adv_5213333_003",
    "unit_id": 138312
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "誤會了。",
    "voice": null,
    "unit_id": 138312
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 138312
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "即使不使用皇家裝備，",
    "voice": null,
    "unit_id": 138312
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我也一直都有從大家身上獲得力量呢。",
    "voice": null,
    "unit_id": 138312
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "「連結的心意」──",
    "voice": "vo_adv_5213333_004",
    "unit_id": 138312
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 138312
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "所化作的力量。",
    "voice": null,
    "unit_id": 138312
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那麼……",
    "voice": "vo_adv_5213333_005",
    "unit_id": 138312
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "梅莉莎小姐。",
    "voice": null,
    "unit_id": 138312
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n讓我們做個了斷吧。",
    "voice": null,
    "unit_id": 138312
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "……正合我意。",
    "voice": "vo_adv_5213333_006",
    "unit_id": 20013
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "\\n因為最後贏的人，",
    "voice": null,
    "unit_id": 20013
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "會是我……！",
    "voice": null,
    "unit_id": 20013
  },
  {
    "type": "dialogue",
    "name": "兩人",
    "words": "「「喝啊啊啊啊～！！」」",
    "voice": "vo_adv_5213333_007",
    "unit_id": null
  }
]
