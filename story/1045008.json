[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}和空花會合之後，前往了某個地方。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "要去蘭德索爾的中央公園……嗎？",
    "voice": "vo_adv_1045008_000",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "原、",
    "voice": "vo_adv_1045008_001",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "原來如此……",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n打算在那裡把空花當作遊樂器材，",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "好好玩弄一番對吧……！",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "只、只是很平常地去玩而已……？",
    "voice": "vo_adv_1045008_002",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "哇、哇哇哇哇！？",
    "voice": "vo_adv_1045008_003",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "和虐待狂先生在公園玩……！？",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n這、這樣，簡直就像是……",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "呀！？好刺眼……",
    "voice": "vo_adv_1045008_004",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n這是……之前也發生過的！？",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "呀哇哇哇哇！",
    "voice": "vo_adv_1045008_005",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "？",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "background",
    "bg_id": "510320"
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "虐、虐虐、虐待狂先生跟空花，",
    "voice": "vo_adv_1045008_006",
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n一起來到主題樂園了……",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "空花該怎麼辦才好……！？",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "沒、沒想到會和男孩子，",
    "voice": "vo_adv_1045008_007",
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n一起來這種地方……",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "旋轉木馬……",
    "voice": "vo_adv_1045008_008",
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "讓空花坐在木馬上面，",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "打算要做什麼！？",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "馬上就帶到這麼暗的地方，",
    "voice": "vo_adv_1045008_009",
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "打算把空花怎麼樣呢……！？",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "欸……讓空花來決定嗎？",
    "voice": "vo_adv_1045008_010",
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n那、那麼……我們去坐咖啡杯好嗎？",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "still",
    "still_id": "104500801"
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "嗯……",
    "voice": "vo_adv_1045008_011",
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n這、這個……沒想到轉得這麼快呢……",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "虐、虐待狂先生……請、請……",
    "voice": "vo_adv_1045008_012",
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n轉、轉、轉得……慢一點……",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "呀啊！",
    "voice": "vo_adv_1045008_013",
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "就算說慢慢轉……這也太慢……",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "呀啊啊啊！？",
    "voice": "vo_adv_1045008_014",
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n虐待狂先生……太刺激了！",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "啊啊……設、設置在大人的主題樂園裡的，",
    "voice": "vo_adv_1045008_015",
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n這些大人的遊樂設施，",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "要、要把空花弄得亂七八糟……！？",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "啊……啊嗯……",
    "voice": "vo_adv_1045008_016",
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "這、這該不會是在時代劇常見的那個……",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "對！",
    "voice": "vo_adv_1045008_017",
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "虐待狂貪官假裝要看一下衣服的腰帶……",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n硬把不情願的姑娘強拉過來！",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "腰帶很美嘛，嘿嘿嘿～過來這邊……",
    "voice": "vo_adv_1045008_018",
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "貪官說著就露出下流的笑容……",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "然後就把不情願的姑娘的腰帶鬆～開……",
    "voice": "vo_adv_1045008_019",
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "……嘻嘻、嘻嘻嘻！",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "請、請住手，大人～！",
    "voice": "vo_adv_1045008_020",
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n咦～咦～……",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "流口水。",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "這樣不好嗎，這樣不好嗎……",
    "voice": "vo_adv_1045008_021",
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "貪官說著就把手伸進姑娘的衣服裡……",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "嘻嘻嘻。",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "不、不可以～！",
    "voice": "vo_adv_1045008_022",
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n至少要在沒有人的地方啊～～～",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "嘻嘻、嘻嘻嘻……流口水。",
    "voice": "vo_adv_1045008_023",
    "unit_id": 104532
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好～的，辛苦了～♪",
    "voice": "vo_adv_1045008_024",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "……嗯，表情看起來真的很累呢。",
    "voice": "vo_adv_1045008_025",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "咖啡杯讓你這麼頭暈嗎？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "空花呀～",
    "voice": "vo_adv_1045008_026",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n如果不說話就是個感覺清純的女孩，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n但是幻想爆發的時候就會暴走呢～",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "但是這些都很好！",
    "voice": "vo_adv_1045008_027",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n雖然她腦中一直胡思亂想，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "實際對她採取強硬攻勢，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n她就會突然變得很乖巧，很可愛呢！",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不過真要你對她強硬，你應該是做不到吧。",
    "voice": "vo_adv_1045008_028",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "也許空花正因為了解這一點，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n所以非常安心地幻想下去呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "或者她根本是希望真的被你硬來，",
    "voice": "vo_adv_1045008_029",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n所以才那樣幻想的……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "之類的？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "正確答案就請你自己去證實吧。",
    "voice": "vo_adv_1045008_030",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n那麼，閒聊就到此為止吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "掰掰～♪",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "嘻嘻嘻……大人……",
    "voice": "vo_adv_1045008_031",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "……奇怪？這裡是？",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "空花，又睡著了呢……",
    "voice": "vo_adv_1045008_032",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "……虐待狂先生也是剛才醒來的嗎？",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "明明要去公園的說，居然睡著了……",
    "voice": "vo_adv_1045008_033",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "是因為那個的關係嗎？",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n空花夢見和虐待狂先生坐在旋轉遊樂器材上玩……",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "虐待狂先生也做了一樣的夢……！？",
    "voice": "vo_adv_1045008_034",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "真不可思議呢……雖然之前也發生過一樣的事情……",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "只有",
    "voice": "vo_adv_1045008_035",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "做夢的話，太浪費了……",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "我們趕快去公園吧。",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "欸？該、",
    "voice": "vo_adv_1045008_036",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "該不會是，",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n因為玩夢中的遊樂器材玩到頭暈……",
