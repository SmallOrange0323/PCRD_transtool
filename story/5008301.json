[
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "長眠至今才一醒來，",
    "voice": "vo_adv_5008301_000",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "就遇到了我們一行人呀，",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n運氣還真是不好呢……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "嘻嘻。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "有同感。",
    "voice": "vo_adv_5008301_001",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "然而，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我們不會因此放水唷？",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我們的憤怒，",
    "voice": "vo_adv_5008301_002",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不讓你用那大得要命的身體嘗嘗可不行呢。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "要上囉杏奈美眉！",
    "voice": "vo_adv_5008301_003",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "讓我們賞他強烈的一擊吧！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "那可是當然囉！",
    "voice": "vo_adv_5008301_004",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "集眾人之力，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "將那邪惡的野望體無完膚地徹底擊碎！！",
    "voice": null,
    "unit_id": 100911
  }
