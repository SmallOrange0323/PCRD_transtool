[
  {
    "type": "background",
    "bg_id": "509040"
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "天哪，",
    "voice": "vo_adv_9500083_000",
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "此話當真？",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家能得騎士閣下傾心，",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "當真歡喜至極、三生有幸。",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "縱使歷經漫長歲月，",
    "voice": "vo_adv_9500083_001",
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n這份教人心潮澎湃的思慕之情，",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "也未曾自記憶中淡去。",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "這世間",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "當真是",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "妙不",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "可言哪。",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "話雖如此，",
    "voice": "vo_adv_9500083_002",
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n騎士閣下所言定是真心實意，",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "絕非玩笑。",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "然則──",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家也定當全心全意",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "予以回應。",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "……此身乃星[rub:核]核[/rub]之化身，",
    "voice": "vo_adv_9500083_003",
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "本該平等將稚子們捧於",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "[rub:手心]手心[/rub]護佑。",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "過去奴家",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "從未對何人有過這般[rub:特殊]特殊[/rub]的",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "情感。",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "此皆因",
    "voice": "vo_adv_9500083_004",
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "凡是天下能呼吸吐納的生命，",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "皆為奴家之愛子。",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "……然而，",
    "voice": "vo_adv_9500083_005",
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "騎士閣下啊。",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "隨著日子於平淡中一天天流逝，",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "與恁交換的一言一語……",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家的心",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "好似已無法僅滿足於此。",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家也曾",
    "voice": "vo_adv_9500083_006",
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "獨自陷入苦思，",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "內心所生的",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "這份衝動究竟為何。",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "此等連名字都無從知曉的",
    "voice": "vo_adv_9500083_007",
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "未知衝動，",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "若",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "是能執起騎士閣下的手，",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "或許",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家便能領悟。",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "……與愛子們相伴的時光，",
    "voice": "vo_adv_9500083_008",
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "對奴家而言",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "不過彈指一瞬。",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "然而，",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "在這般虛幻的剎那間，",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "所蘊含的光芒竟如此美麗……",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n教會奴家這點的，",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "毫無疑問",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "正是騎士閣下。",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "因此奴家",
    "voice": "vo_adv_9500083_009",
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n也定當回應騎士閣下的心意。",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "作為同懷守護",
    "voice": "vo_adv_9500083_010",
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "眾人之志的同伴……",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n亦作為此刻",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "彼此心意相通、",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "締結深厚緣分",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "的伴侶。",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家在此起誓，",
    "voice": "vo_adv_9500083_011",
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "會發自真心地",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "永遠愛恁。",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "然則──",
    "voice": "vo_adv_9500083_012",
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "便讓吾等偕手",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "同行吧。",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n為了守護於此星生生不息的生命，",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "為了守護奴家與恁",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "並肩前行",
    "voice": null,
    "unit_id": 129741
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "的未來……",
    "voice": null,
    "unit_id": 129741
  }
]
