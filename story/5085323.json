    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "抱歉。",
    "voice": "vo_adv_5085323_004",
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n好像是調整出錯了。",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "另一邊的力量",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "似乎已經超過極限了。",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "咦～～～～～！？",
    "voice": "vo_adv_5085323_005",
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "哎呀，",
    "voice": "vo_adv_5085323_006",
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "果然是強到誇張的力量呢。",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n只是試著重現就變成這樣了～",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "要、",
    "voice": "vo_adv_5085323_007",
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "要怎麼辦才好……？",
    "voice": null,
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "只要有大家的力量就沒問題沒問題。",
    "voice": "vo_adv_5085323_008",
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不要全丟給我們啦！",
    "voice": "vo_adv_5085323_009",
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "既然這樣就別無他法了。",
    "voice": "vo_adv_5085323_010",
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小凱留！",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我們上吧，",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "朝向可能性的彼方前進！",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不要連妳都被局勢拖著走啦～～～！",
    "voice": "vo_adv_5085323_011",
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "……沒事的。",
    "voice": "vo_adv_5085323_012",
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n妳們一定可以超越它的。",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "都已經輕易超出我的預期……",
    "voice": null,
    "unit_id": 121211
  },
  {
