    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "……這有點糟糕啊。",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "兩人",
    "words": "？",
