  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "呼……",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "今天的練跑……",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "結束！",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n咦──？",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "你為什麼會在這裡──？",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "……啊哈♪",
    "voice": "vo_adv_4010185_001",
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "難道說是因為我生日，",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "所以你來找我了嗎～？",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "沒想到能跟你像這樣碰面，",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "超開心的～！",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "真多謝～♪",
    "voice": "vo_adv_4010185_002",
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "謝謝你～！",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "其實呀～",
    "voice": "vo_adv_4010185_003",
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "因為好久沒見到你了，",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n所以我想說要來向星星",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "許願呢～",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "你看，",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "今天不是七夕嗎～？",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我還做了短籤哦～",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "不過，",
    "voice": "vo_adv_4010185_004",
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "在許願之前，",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "願望就實現了呢～♪",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n嘿嘿♪",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我說",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我說，",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "等等能陪我一下嗎？",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "background",
    "bg_id": "510362"
  },
  {
    "type": "background",
    "bg_id": "510272"
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "銀河是那個嗎──",
    "voice": "vo_adv_4010185_005",
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n還是那個呢──？",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "織女與牛郎，",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "你",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "找到了嗎？",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "從剛剛開始心臟就一直",
    "voice": "vo_adv_4010185_006",
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "跳個不停啊～",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "織女他們也是像這樣",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "噗通噗通跳個不停嗎～？",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "background",
    "bg_id": "510362"
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "啊哈♪",
    "voice": "vo_adv_4010185_007",
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "對吧──！",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "說你呀，",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "明年也能幫我",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "慶祝",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "生日嗎──？",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我想跟織女和牛郎一樣，",
    "voice": "vo_adv_4010185_008",
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n一～直一～直，",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "跟你做約定啊～♪",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "啊哈，",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "因為我，",
    "voice": null,
    "unit_id": 101731
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "最喜歡你了喔～♪",
    "voice": null,
