    "type": "dialogue",
    "name": "千歌",
    "words": "給我",
    "voice": "vo_adv_1084002_048",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "一點點時間喔。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我會將發至內心的歌聲，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "當作禮物。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "千歌這麼說著，嬌顏泛起了笑靨。",
