[
  {
    "type": "background",
    "bg_id": "500050"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "到了約定交還嬰兒的時間，\\n{0}與千歌一起拜訪蛋糕店。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "哇……",
    "voice": "vo_adv_1084002_000",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "聖誕節的蛋糕店，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "還真是華麗呢。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n每個蛋糕都看起來好好吃……",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "蛋糕店老闆",
    "words": "唉。",
    "voice": "vo_adv_1084002_001",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "蛋糕店老闆",
    "words": "怎麼在這個時候……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "蛋糕店老闆",
    "words": "可惡。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "哎，",
    "voice": "vo_adv_1084002_002",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "哎呀……？",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n蛋糕店老闆，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "怎麼了嗎？",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "　臉色非常難看啊。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "蛋糕店老闆",
    "words": "咦？",
    "voice": "vo_adv_1084002_003",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "蛋糕店老闆",
    "words": "　",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "蛋糕店老闆",
    "words": "啊啊，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "蛋糕店老闆",
    "words": "是你啊。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "蛋糕店老闆",
    "words": "謝謝幫我看顧小孩。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "蛋糕店老闆",
    "words": "是嗎，",
    "voice": "vo_adv_1084002_004",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "蛋糕店老闆",
    "words": "已經是這種時候了嗎……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "蛋糕店老闆",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "蛋糕店老闆",
    "words": "唉呀、",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "蛋糕店老闆",
    "words": "讓你們看到陰暗的一面，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "蛋糕店老闆",
    "words": "真不好意思。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "那個，",
    "voice": "vo_adv_1084002_005",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是發生什麼事了嗎？",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "蛋糕店老闆",
    "words": "嗯……",
    "voice": "vo_adv_1084002_006",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "蛋糕店老闆",
    "words": "遇上一點點小問題吧。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "蛋糕店老闆",
    "words": "其實，本來準備要運送聖誕節蛋糕前往蘭德索爾鎮外",
    "voice": "vo_adv_1084002_007",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "蛋糕店老闆",
    "words": "\\n但是路上湧出了大量的魔物，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "蛋糕店老闆",
    "words": "因此接到禁止通行的通知，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "蛋糕店老闆",
    "words": "\\n不知道這下怎麼辦……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "怎麼這樣！",
    "voice": "vo_adv_1084002_008",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "　",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "那就是說，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "要送這個蛋糕……",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "蛋糕店老闆",
    "words": "就是這樣。",
    "voice": "vo_adv_1084002_009",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "蛋糕店老闆",
    "words": "很多人是很早以前",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "蛋糕店老闆",
    "words": "\\n就大老遠跑來蘭德索爾下訂單，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "蛋糕店老闆",
    "words": "\\n就為了等這個蛋糕呢……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "蛋糕店老闆",
    "words": "聖誕節蛋糕，",
    "voice": "vo_adv_1084002_010",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "蛋糕店老闆",
    "words": "是期待著聖誕節的家庭的",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "蛋糕店老闆",
    "words": "\\n幸福象徵啊。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "蛋糕店老闆",
    "words": "想到得讓這些家庭，",
    "voice": "vo_adv_1084002_011",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "蛋糕店老闆",
    "words": "過著寂寞的聖誕節",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "蛋糕店老闆",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "蛋糕店老闆",
    "words": "就感到既難過、",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "蛋糕店老闆",
    "words": "又愧疚……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "…………",
    "voice": "vo_adv_1084002_012",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "那個，{0}。",
    "voice": "vo_adv_1084002_013",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n我們能不能",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "出力幫忙呢？",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是啊。",
    "voice": "vo_adv_1084002_014",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n如果是我們兩人，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "應該能順利將蛋糕送上門的！",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "咦？",
    "voice": "vo_adv_1084002_015",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "　那個、",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "你說堆放著太可惜這我知道，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "但不是那個問題啦……",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "比起那個、",
    "voice": "vo_adv_1084002_016",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "應該要想辦法",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "將蛋糕送達至訂購的家庭手中！",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "蛋糕店老闆，",
    "voice": "vo_adv_1084002_017",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "能讓我們",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "幫您運送蛋糕嗎？",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "蛋糕店老闆",
    "words": "你們要去啊？",
    "voice": "vo_adv_1084002_018",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "蛋糕店老闆",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "蛋糕店老闆",
    "words": "你們志願幫忙我是很感謝，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "蛋糕店老闆",
    "words": "但是要讓你們冒生命危險就……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "請您放心吧。",
    "voice": "vo_adv_1084002_019",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "憑藉{0}跟我的本事，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "肯定能守護等待著蛋糕的家庭們\\n的笑容。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "{0}。\\n用唱喚術邊驅趕魔物、",
    "voice": "vo_adv_1084002_020",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "或讓牠們睡著再同時前進，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n應該可以順利抵達目的地。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "來，",
    "voice": "vo_adv_1084002_021",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "快準備開始送貨吧！",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "background",
    "bg_id": "500036"
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "魔物可不會在乎什麼聖誕節呢。",
    "voice": "vo_adv_1084002_022",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "雖然是理所當然的事。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "雖說是突發的現象，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "但是居然出現這麼大量的魔物……",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "總之",
    "voice": "vo_adv_1084002_023",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "要注意別把蛋糕壓爛，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "小心前進吧。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "打開盒子，發現裡面裝飾的聖誕老公公已經被壓爛……",
    "voice": "vo_adv_1084002_024",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "如果發生這種事，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "那就太悲慘了。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "background",
    "bg_id": "500540"
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "現在，",
    "voice": "vo_adv_1084002_025",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "到了蘭德索爾與交貨地的中間地點吧。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n雖然弱小的魔物",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "可以用唱喚術讓牠們睡著、",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n但也差不多",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "會出現強大的魔物也說不定……",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "――咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "啊、",
    "voice": "vo_adv_1084002_026",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "出現了！",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "　",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "魔物向這邊",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "襲擊過來了！",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "{0}請將力量借給我！",
    "voice": "vo_adv_1084002_027",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n我要使用更強的唱喚術，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "擊退那個魔物！",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "唔唔……",
    "voice": "vo_adv_1084002_028",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "力量從身體深處湧出來的這股感覺，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "{0}的能力，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "真的好厲害……！",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "風之精靈啊，",
    "voice": "vo_adv_1084002_029",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "將魔物擊退吧……！",
    "voice": null,
