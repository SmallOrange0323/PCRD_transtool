    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "耶？",
    "voice": "vo_adv_1084002_036",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "　啊、不、",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "那個……",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "不客氣。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "能讓您高興真是太好了。",
    "voice": "vo_adv_1084002_037",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "來、",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "前往下一個家庭吧！",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "background",
    "bg_id": "500541"
  },
  {
    "type": "still",
    "still_id": "108400201"
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "能平安地、",
    "voice": "vo_adv_1084002_038",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "將蛋糕送達至全部的家庭，真是太好了。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我想現在每個人，",
    "voice": "vo_adv_1084002_039",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "都能夠一起度過\\n幸福的聖誕節時光吧……",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "呵呵。",
    "voice": "vo_adv_1084002_040",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "有許多人",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "都對我們說、",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "聖誕老公公",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n謝謝你呢。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "……{0}是聖誕老公公的話",
    "voice": "vo_adv_1084002_041",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n那我就是馴鹿了嗎。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "雖然鼻子是紅的。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我的唱喚術",
    "voice": "vo_adv_1084002_042",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "能夠幫助這麼多的人，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我覺得非常高興。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "呵呵，",
    "voice": "vo_adv_1084002_043",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "只要想到大家幸福的表情，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n就覺得很滿足。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n真的是，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "太好了……",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "對了。",
    "voice": "vo_adv_1084002_044",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "如果也能對精靈們，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n表達感謝的心情就好了……",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "看來，",
    "voice": "vo_adv_1084002_045",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "要說我能做的事情，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "就是唱歌……",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "對吧。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "謝謝。",
    "voice": "vo_adv_1084002_046",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "那麼，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n當我唱歌時，{0}",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "你要來聽喔。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "哎呀？",
    "voice": "vo_adv_1084002_047",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "　在空中飛舞的精靈們都靠過來了。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "呵呵、",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "不要那麼急嘛。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n我也還沒決定要唱什麼呀。",
    "voice": null,
    "unit_id": 108411
  },
