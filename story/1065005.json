    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "適合練習對象正好出現了呢！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "啊哈哈，",
    "voice": "vo_adv_1065005_026",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "看起來那樣子我也沒辦法！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "因為事情的確好像會變得好玩，我也控制不了！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "上囉，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "喝啊！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我才不會害怕呢！",
    "voice": "vo_adv_1065005_027",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "倒不如說我很興奮！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你退下吧！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我來跟這傢伙單挑！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "喝啊！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "background",
    "bg_id": "500140"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "怎麼了？",
    "voice": "vo_adv_1065005_028",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "才一擊就要倒了嗎？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "難不成這傢伙，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "在我攻擊之前就已經變弱了嗎？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "無所謂了！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "就這樣一口氣打倒它！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "冒險者1",
    "words": "兩位！",
    "voice": "vo_adv_1065005_029",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "冒險者1",
    "words": "沒事吧！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "喔！",
    "voice": "vo_adv_1065005_030",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "有干擾來了……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "喲。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你們是什麼人？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "冒險者2",
    "words": "我們是受到",
    "voice": "vo_adv_1065005_031",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "冒險者2",
    "words": "【公會管理協會】委託，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "冒險者2",
    "words": "\\n要討伐那裡的魔物。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "冒險者2",
    "words": "但是要擊殺時功虧一簣被它逃掉了。",
    "voice": "vo_adv_1065005_032",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "冒險者2",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "冒險者2",
    "words": "所以才追到了這裡，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "冒險者2",
    "words": "遇見了你們。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "冒險者1",
    "words": "那傢伙是個強敵！",
    "voice": "vo_adv_1065005_033",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "冒險者1",
    "words": "讓我們一起戰鬥吧！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "啊？",
    "voice": "vo_adv_1065005_034",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "給我等一下。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "現在和這傢伙戰鬥的是我吧？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你該不是要插手我跟它的單挑吧？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "如果你要打的話，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "首先得打倒我再說！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "冒險者1",
    "words": "和魔物單挑打架……！？",
    "voice": "vo_adv_1065005_035",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "冒險者1",
    "words": "\\n",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "冒險者1",
    "words": "但是那個傢伙可是很危險的！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "冒險者2",
    "words": "……但這個孩子，",
    "voice": "vo_adv_1065005_036",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "冒險者2",
    "words": "很有魄力呢……",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "冒險者2",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "冒險者2",
    "words": "或許，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "冒險者2",
    "words": "或許沒問題吧……",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "────咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "冒險者1",
    "words": "怎麼了那傢伙。",
    "voice": "vo_adv_1065005_037",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "冒險者1",
    "words": "\\n難道是",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "冒險者1",
    "words": "對那個孩子敞開心房了嗎……？",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我才不是要救你啦！",
    "voice": "vo_adv_1065005_038",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n是在大意些什麼啊！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "background",
    "bg_id": "500140"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "已經結束了嗎……",
    "voice": "vo_adv_1065005_039",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "真是掃興。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n這樣的話就不能代替練習了。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "冒險者2",
    "words": "竟然才一擊就打倒了……",
    "voice": "vo_adv_1065005_040",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "冒險者2",
    "words": "妳真的很強呢。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "冒險者1",
    "words": "幫了大忙呢。",
    "voice": "vo_adv_1065005_041",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "冒險者1",
    "words": "這裡是打倒那個魔物的一半報酬。",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "冒險者1",
    "words": "\\n我們當成訂金先收下了，",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "冒險者1",
    "words": "和妳一起平分吧。",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "咦？",
    "voice": "vo_adv_1065005_042",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "真的可以收下嗎。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n我其實只要能",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "和魔物打架就好。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這其實是你們的獵物不是嗎？",
    "voice": "vo_adv_1065005_043",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n很抱歉被我搶走了呢。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "呀啊！",
    "voice": "vo_adv_1065005_044",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不要突然抓我肚子啦！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "幹嘛啦！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你有什麼想說的嗎？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "哇呀！",
    "voice": "vo_adv_1065005_045",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你、",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你突然做什麼啊！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "打手啊，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "可是禁止偷襲的唷！？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "哇呀！",
    "voice": "vo_adv_1065005_046",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "喂、",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "喂，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我說別這樣啦！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n你，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這是剛才的報復是不是？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "咦？",
    "voice": "vo_adv_1065005_047",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我只是",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "給它致命的一擊而已唷？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "嗯，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "接下委託工作的那些人都已經說了可以，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n那麼就應該可以吧……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "嗯，",
    "voice": "vo_adv_1065005_048",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "是這樣嗎？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不對，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "與其說順著事情發展，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "但打倒魔物的人",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "確實是我呢……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "知道了。",
    "voice": "vo_adv_1065005_049",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "既然你們這麼說的話，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "那我就收下嘍。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n也是難得的機會，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我領收報酬了。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "冒險者1",
    "words": "是啊，",
    "voice": "vo_adv_1065005_050",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "冒險者1",
    "words": "請妳一定要收下。",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "冒險者1",
    "words": "\\n多虧了妳幫了大忙。",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……",
    "voice": "vo_adv_1065005_051",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "那麼，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "多謝啦。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "冒險者2",
    "words": "那麼，",
    "voice": "vo_adv_1065005_052",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "冒險者2",
    "words": "我們還要提出討伐的報告，先回到鎮上嘍。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "冒險者2",
    "words": "\\n要小心回去唷。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……他們走掉了呢。",
    "voice": "vo_adv_1065005_053",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "啊──啊，",
    "voice": "vo_adv_1065005_054",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "有種奇妙的心情呢。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我並不是為了那些傢伙或是金錢戰鬥的……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "嗯……",
    "voice": "vo_adv_1065005_055",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我只是自己想跟魔物打架而已。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我啊，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "其實不想從那種打架中",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "得到金錢。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "但是，",
    "voice": "vo_adv_1065005_056",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "今天我能夠戰鬥，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "而且他們也很高興的話，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "算是好事一件吧……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "而且你好像也為我高興呢。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "雖然",
    "voice": "vo_adv_1065005_057",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "話也不是這麼說啦……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "作了一件好事嗎？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "因為，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "打倒魔物是我擅自想做的事，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n真的要說報酬的部分",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "應該由他們全部收下才對吧？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這樣被我中途介入，",
    "voice": "vo_adv_1065005_058",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我有一種從人家那邊奪走任務的感覺。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n覺得對他們很不好意思……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "但是，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你也為我高興，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "而且做了好事吧，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我呢。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "那就好了！",
    "voice": "vo_adv_1065005_059",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n練習也結束了，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我們拿報酬",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "待會好好玩樂去吧！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "嘉夜帶著燦爛的笑容，\\n和{0}一起朝著鎮上走去。",
    "voice": null,
    "unit_id": null
  }
]
