[
  {
    "type": "background",
    "bg_id": "501982"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "伊莉亞理解了蘊藏在自己體內的力量有多巨大。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n她展現出的力量超越了被收集起來的「傳說的吸血鬼之力」，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n粉碎了布拉德的盤算。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "……呃、",
    "voice": "vo_adv_5120007_000",
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "嗚……",
    "voice": null,
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "他變回原樣了呢。",
    "voice": "vo_adv_5120007_001",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "是魔力耗盡了嗎？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "……這是多麼、",
    "voice": "vo_adv_5120007_002",
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "強大的力量……！",
    "voice": null,
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "\\n",
    "voice": null,
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "居然超越我耗費漫長時光，",
    "voice": null,
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "收集起來的魔力……！",
    "voice": null,
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "那是當然的。",
    "voice": "vo_adv_5120007_003",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n不管是傳說之力還是什麼的，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "那些都是過去的遺物。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "現在在這裡的妾身才是統御黑夜之人。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身沒有理由會輸。",
    "voice": "vo_adv_5120007_004",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "如果有那個力量的話……",
    "voice": "vo_adv_5120007_005",
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "要征服世界是輕而易舉的吧……",
    "voice": null,
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……或許吧。",
    "voice": "vo_adv_5120007_006",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "崇拜您的部下們",
    "voice": "vo_adv_5120007_007",
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "也聚集過來了……",
    "voice": null,
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "魔物群",
    "words": "伊莉亞大人……！",
    "voice": "vo_adv_5120007_008",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……哼。",
    "voice": "vo_adv_5120007_009",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n追尋傳說而聚集起來的魔物們啊！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "看好了！",
    "voice": "vo_adv_5120007_010",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "魔物群",
    "words": "！？",
    "voice": "vo_adv_5120007_011",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這就是",
    "voice": "vo_adv_5120007_012",
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身現在的樣子。",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "身高變矮，",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "魔力變弱，",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "完全沒有威嚴！",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你們追尋的傳說",
    "voice": "vo_adv_5120007_013",
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "已經不在這裡了！",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "忘掉一切──",
    "voice": "vo_adv_5120007_014",
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "想去哪",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "就去哪吧！",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "魔物群",
    "words": "……是，",
    "voice": "vo_adv_5120007_015",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物群",
    "words": "遵命……",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "這是為什麼啊……",
    "voice": "vo_adv_5120007_016",
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "伊莉亞大人……",
    "voice": null,
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "\\n",
    "voice": null,
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "征服世界",
    "voice": null,
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "是您的宿願……！",
    "voice": null,
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……確實是那樣沒錯。",
    "voice": "vo_adv_5120007_017",
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身總有一天",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "會征服全世界。",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "但是──",
    "voice": "vo_adv_5120007_018",
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "並不是現在。",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "……是",
    "voice": "vo_adv_5120007_019",
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "布拉德",
    "words": "這樣嗎……",
    "voice": null,
    "unit_id": 9811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這樣好嗎？",
    "voice": "vo_adv_5120007_020",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n剛剛明明有那麼多粉絲在這裡。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "確實，",
    "voice": "vo_adv_5120007_021",
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "如果利用那傢伙準備的東西，",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n或許能走近路征服世界吧。",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "照著傳說的內容征服世界。",
    "voice": "vo_adv_5120007_022",
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "但那樣子──",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不能算是由妾身來征服世界吧？",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身",
    "voice": "vo_adv_5120007_023",
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n要跟自己挑選的夥伴一起，",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "靠自己獲得的力量",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "來征服世界。",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身不打算照著名為傳說的過去",
    "voice": "vo_adv_5120007_024",
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "來達成目標。",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "哦……",
    "voice": "vo_adv_5120007_025",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "怎、",
    "voice": "vo_adv_5120007_026",
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "怎樣啦。",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n妳不照平常一樣",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "說「如果是美麗的我的話就怎樣怎樣」嗎？",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我不會那麼說的。",
    "voice": "vo_adv_5120007_027",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "因為妳露出很美麗的表情啊。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "唔！？",
    "voice": "vo_adv_5120007_028",
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "當然，",
    "voice": "vo_adv_5120007_029",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "就只有一瞬間而已喔？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "能被世界第一美麗的我認可，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這可是件很光榮的事呢。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "呼……",
    "voice": "vo_adv_5120007_030",
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "哈哈哈哈！",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "那確實是很光榮的事情呢！",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "兩人",
    "words": "哈哈哈！\\n呵呵呵♪",
    "voice": "vo_adv_5120007_031",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……哎呀。",
    "voice": "vo_adv_5120007_032",
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n雪分給妾身的力量也差不多要耗盡了呢。",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "雪啊。",
    "voice": "vo_adv_5120007_033",
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n妳",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "現在也還在追求永恆之美嗎？",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "那是當然的。",
    "voice": "vo_adv_5120007_034",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "因為我的美",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "是應當永遠留存在這世界上的啊！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "那麼",
    "voice": "vo_adv_5120007_035",
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身就用最後的力量──",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n把妳變成吸血鬼吧。",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這點程度妾身應該還辦得到。",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "咦，",
    "voice": "vo_adv_5120007_036",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "可以嗎？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "呵。",
    "voice": "vo_adv_5120007_037",
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "因為要是回到城裡之後妳還天天來，",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身可受不了啊。",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "太好了♪",
    "voice": "vo_adv_5120007_038",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "{0}，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "真是太好了呢。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n你能見證永恆之美誕生的瞬間喔♪",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "說不定……",
    "voice": "vo_adv_5120007_039",
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "就是像妳這種人，",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "真的會意外地留下傳說呢。",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "那麼，",
    "voice": "vo_adv_5120007_040",
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "要先換成適合的打扮才行啊。",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "啊……！",
    "voice": "vo_adv_5120007_041",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這是很適合的裝扮吧？",
    "voice": "vo_adv_5120007_042",
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "呵呵♪",
    "voice": "vo_adv_5120007_043",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n伊莉亞，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "妳很懂呢。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "那麼，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我要做什麼才好呢？",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "喔，",
    "voice": "vo_adv_5120007_044",
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "那是這座城鎮裡的書吧。",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯嗯。",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "試著更加理解妾身是件好事。",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不過，並不是只要被吸血就會變成吸血鬼就是了。",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "那些小事情不重要啦，",
    "voice": "vo_adv_5120007_045",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "快點咬下去吧。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……妾身還是第一次遇到要被吸血還這麼隨興的人呢。",
    "voice": "vo_adv_5120007_046",
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妳站好不要動喔。",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "still",
    "still_id": "512000701"
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……嗯。",
    "voice": "vo_adv_5120007_047",
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "怎麼了嗎？",
    "voice": "vo_adv_5120007_048",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "真不愧是自稱為統御著美麗的人啊。",
    "voice": "vo_adv_5120007_049",
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "雖然不甘心，",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "但是妳有著很美麗的頸部。",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "哼哼♪",
    "voice": "vo_adv_5120007_050",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n妳現在才注意到啊？",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n我真是罪孽深重呢，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "居然魅惑了傳說的吸血鬼。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……如果沒有這個性的話就好了啊。",
    "voice": "vo_adv_5120007_051",
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "好啦，",
    "voice": "vo_adv_5120007_052",
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妳做好心理準備了嗎？",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身差不多要咬下去了喔。",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我的美",
    "voice": "vo_adv_5120007_053",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "終於要化為永恆……！",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "呵呵呵，",
    "voice": "vo_adv_5120007_054",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "要是有了永恆的時間，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n不管要照多少鏡子都可以吧♪",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "對了！",
    "voice": "vo_adv_5120007_055",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n我也像伊莉亞一樣蓋一座城堡吧。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "蓋一座貼滿鏡子，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "只屬於我的城堡……♪",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "她好像說了什麼很恐怖的事……",
    "voice": "vo_adv_5120007_056",
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯？",
    "voice": "vo_adv_5120007_057",
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n怎麼了嗎，",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "{0}啊。",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n你為什麼瞪大眼睛看著書啊……",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "still",
    "still_id": "512000702"
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "…………",
    "voice": "vo_adv_5120007_058",
    "unit_id": 126311
  },
  {
    "type": "background",
    "bg_id": "501982"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "好啦，",
    "voice": "vo_adv_5120007_059",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我們回去吧。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "喔！？",
    "voice": "vo_adv_5120007_060",
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n等等，",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身還沒吸妳的血啊！？",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n妳不要",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "永恆之美了嗎！？",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "如果永遠沒辦法看到映在鏡子裡美麗的我，",
    "voice": "vo_adv_5120007_061",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n那就沒有意義了啊。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這傢伙……",
    "voice": "vo_adv_5120007_062",
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "對吸血鬼完全沒興趣了……！",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "…",
    "voice": "vo_adv_5120007_063",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "…唉。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不僅如此，還看著妾身嘆氣！？",
    "voice": "vo_adv_5120007_064",
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "吾之眷屬啊！",
    "voice": "vo_adv_5120007_065",
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身果然不擅長跟這傢伙相處啊！",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n妾身想把之前說的，",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n她對自己有自信的這點很美的話收回啊～～～～～！",
    "voice": null,
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "呵呵，",
    "voice": "vo_adv_5120007_066",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "雖然伊莉亞也有點美，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n但似乎沒辦法理解我的美，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "那妳還差得遠呢。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "妳要不要乾脆",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "來拜我為師啊？",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "好在哪啊～～～～～！？",
    "voice": "vo_adv_5120007_067",
    "unit_id": 126212
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "伊莉亞的叫聲回響在刻劃著傳說的吸血鬼的歷史之地上。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n「統御黑夜之人」伊莉亞‧奧恩斯坦跟「統御美麗之人」雪一起",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n告別傳說，邁出了步伐。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "movie",
    "movie_id": "512000701"
  }
]
