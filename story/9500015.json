[
  {
    "type": "background",
    "bg_id": "509040"
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "哥哥，",
    "voice": "vo_adv_9500015_000",
    "unit_id": 102041
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n要和美美一起戰鬥嗎？",
    "voice": null,
    "unit_id": 102041
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102041
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "這樣啊，",
    "voice": null,
    "unit_id": 102041
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "太好了……♪",
    "voice": null,
    "unit_id": 102041
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "那個，",
    "voice": "vo_adv_9500015_001",
    "unit_id": 102041
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "美美會加油的。",
    "voice": null,
    "unit_id": 102041
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102041
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "因為美美",
    "voice": null,
    "unit_id": 102041
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "要成為優秀的姐姐嘛♪",
    "voice": null,
    "unit_id": 102041
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102041
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "所以，",
    "voice": null,
    "unit_id": 102041
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "要保護大家！",
    "voice": null,
    "unit_id": 102041
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "其實啊，",
    "voice": "vo_adv_9500015_002",
    "unit_id": 102041
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "美美有點害怕。",
    "voice": null,
    "unit_id": 102041
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102041
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "一直忍著",
    "voice": null,
    "unit_id": 102041
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "不讓自己哭出來。",
    "voice": null,
    "unit_id": 102041
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "不過，",
    "voice": "vo_adv_9500015_003",
    "unit_id": 102041
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "一想到哥哥也會陪著美美，",
    "voice": null,
    "unit_id": 102041
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n害怕就不知道飛到哪裡去了♪",
    "voice": null,
    "unit_id": 102041
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102041
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "只要是我們，",
    "voice": null,
    "unit_id": 102041
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "一定什麼都能辦到！",
    "voice": null,
    "unit_id": 102041
  },
  {
    "type": "dialogue",
    "name": "小小格里芬",
    "words": "噗噗──！",
    "voice": "vo_adv_9500015_004",
    "unit_id": 2211
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "哇！",
    "voice": "vo_adv_9500015_005",
    "unit_id": 102041
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "小小格里芬先生！？",
    "voice": null,
    "unit_id": 102041
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n不是說過很危險，讓你乖乖看家嗎？",
    "voice": null,
    "unit_id": 102041
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n怎麼還是跟過來了！？",
    "voice": null,
    "unit_id": 102041
  },
  {
    "type": "dialogue",
    "name": "小小格里芬",
    "words": "噗噗噗噗──！",
    "voice": "vo_adv_9500015_006",
    "unit_id": 2211
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "……這樣啊，",
    "voice": "vo_adv_9500015_007",
    "unit_id": 102041
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "是因為和我們一起鼓起了勇氣，",
    "voice": null,
    "unit_id": 102041
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n小小格里芬先生才學會飛翔的嘛。",
    "voice": null,
    "unit_id": 102041
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102041
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "所以這次，",
    "voice": null,
    "unit_id": 102041
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "要把勇氣分給我們呢♪",
    "voice": null,
    "unit_id": 102041
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "那個啊，",
    "voice": "vo_adv_9500015_008",
    "unit_id": 102041
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "還記得",
    "voice": null,
    "unit_id": 102041
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "飛上天空時",
    "voice": null,
    "unit_id": 102041
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "看見的美麗景色嗎？",
    "voice": null,
    "unit_id": 102041
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102041
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "那裡有著美美最喜歡的大家，",
    "voice": null,
    "unit_id": 102041
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "對美美來說是很重要的地方，",
    "voice": null,
    "unit_id": 102041
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n所以美美絕對不想失去它。",
    "voice": null,
    "unit_id": 102041
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "好～",
    "voice": "vo_adv_9500015_009",
    "unit_id": 102041
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "美美要加油！",
    "voice": null,
    "unit_id": 102041
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102041
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "和哥哥、小小格里芬先生一起，",
    "voice": null,
    "unit_id": 102041
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "竭盡全力戰鬥！",
    "voice": null,
    "unit_id": 102041
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102041
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "由我們來守護",
    "voice": null,
    "unit_id": 102041
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "世界和大家……！",
    "voice": null,
    "unit_id": 102041
  }
]
