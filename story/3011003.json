  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "怎麼可以那麼蠻橫！？",
    "voice": "vo_adv_3011003_058",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "什麼蠻橫啊？本來大家互相搶奪地圖就是不對的喔。",
    "voice": "vo_adv_3011003_059",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n我們是為了要尋找暮光之都才聚在一塊的不是嗎？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "所以重要的情報應該共享才對……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "──呱歐歐歐歐歐！",
