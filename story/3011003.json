    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "好像朝著這邊來了啊？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "是真的又怎樣？我不是說了我正在講話嗎？",
    "voice": "vo_adv_3011003_064",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "不是啦……但我們都精疲力盡、動彈不得了，",
    "voice": "vo_adv_3011003_065",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "再這樣下去大家都會被魔物擊倒啊……",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──呱歐歐歐歐歐",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "真是的……",
    "voice": "vo_adv_3011003_066",
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不要阻礙我好嗎！",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "background",
    "bg_id": "500140"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘰歐歐歐歐歐",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "喵！？",
    "voice": "vo_adv_3011003_067",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n把相隔這麼遠的魔物打倒了！？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "還只用了一擊……！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "這、這能叫做是、",
    "voice": "vo_adv_3011003_068",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "把牠砍飛了嗎！？",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "那隻魔物……相當凶猛又強壯喔！",
    "voice": "vo_adv_3011003_069",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "不費吹灰之力就把牠……",
    "voice": "vo_adv_3011003_070",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我啊～完全無法施展魔法，",
    "voice": "vo_adv_3011003_071",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "但相對地我的氣呢……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "總之我能用氣勢把遠方的東西斬斷喔。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那麼，已經沒有能阻礙我的東西了，我繼續說了喔。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "一夥",
    "words": "……是。",
    "voice": "vo_adv_3011003_072",
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500142"
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "――所以說，",
    "voice": "vo_adv_3011003_073",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n一定要珍惜自己的同伴才行。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "同伴間互相戰鬥到體力用盡，",
    "voice": "vo_adv_3011003_074",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n連魔物不能抵抗，這太不像話了。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "稍微反省一下吧！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……嗯？",
    "voice": "vo_adv_3011003_075",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n什麼呀？太陽已經下山了嗎？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不、不要叫我大姐啦！",
    "voice": "vo_adv_3011003_076",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "咦？不知不覺天都已經這麼黑了呢！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "沒辦法啦。就當給你面子，",
    "voice": "vo_adv_3011003_077",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n今天發生的事我就原諒她們吧！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "大家站起來吧！我們回去囉。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "唉呀……平時這麼溫柔的流夏，",
    "voice": "vo_adv_3011003_078",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n沒想到生氣起來這麼可怕……",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "是啊……看來只有流夏是不能惹怒的呢。",
    "voice": "vo_adv_3011003_079",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這麼長時間的說教，真不想再有第二次呢。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "雖然我不後悔與各位交手，",
    "voice": "vo_adv_3011003_080",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "但以後還是注意點吧……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "那、",
    "voice": "vo_adv_3011003_081",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "那個……對不起。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n都、都是因為我想一個人獨佔地圖才會……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "妳怎麼了啊？杏奈？",
    "voice": "vo_adv_3011003_082",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "妳會乖乖地道歉還真是少見呢。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "嗯……明白我說的話就好了喔。",
    "voice": "vo_adv_3011003_083",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n難得大家都是為了相同目的而聚在一起的夥伴，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我呢～那個……想跟大家好好地相處下去喔。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "……",
    "voice": "vo_adv_3011003_084",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "是、是的！大姐！我會一生追隨妳的！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "喂！不要叫我大姐啦！",
    "voice": "vo_adv_3011003_085",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "被這樣叫的話，身體會莫名地癢……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "喔～大姐！真好啊！",
    "voice": "vo_adv_3011003_086",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我都可以這樣叫嗎～♪",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "嗨！流夏大姐！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "好啊！那麼我也叫流夏大姐好了。",
    "voice": "vo_adv_3011003_087",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "也請讓我這麼稱呼吧！",
    "voice": "vo_adv_3011003_088",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "大姐……很適合流夏呢！呵呵……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我都說不要了！",
    "voice": "vo_adv_3011003_089",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "妳們在開我玩笑吧？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你也幫忙說兩句吧……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "連你也這樣！！",
    "voice": "vo_adv_3011003_090",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "唉～看來只能接受現實了……",
    "voice": "vo_adv_3011003_091",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你們真是令人困擾的伙伴啊！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "幾天後，由流夏送去鑑定的地圖被判定為假貨，\\n所有人都非常的失望……",
    "voice": null,
    "unit_id": null
  }
]
