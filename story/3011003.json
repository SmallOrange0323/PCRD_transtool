    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "七七香，我正在說些重要的事，",
    "voice": "vo_adv_3011003_061",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n不要想偷偷轉移話題喔！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "不是啦！你們聽、那個聲音……",
    "voice": "vo_adv_3011003_062",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──呱歐歐歐歐歐！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "果、",
    "voice": "vo_adv_3011003_063",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "果然！流夏姐有魔物啊！",
