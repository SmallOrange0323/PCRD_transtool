  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "拉菲……",
    "voice": "vo_adv_6048110_000",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "走了呢……",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "結果到最後都匆匆忙忙地，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "沒辦法和她好好地悠閒相處啊。",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "畢竟又變成天使了呢。",
    "voice": "vo_adv_6048110_001",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "雖然沒辦法使出像那孩子一樣的魔法，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "不過去試著做些",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我能做到的事或許也不錯呢。",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "……對啊，",
    "voice": "vo_adv_6048110_002",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "發生一堆事件，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "都沒怎麼和那孩子玩到呢。",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n下次要緊緊跟在她身邊陪她一起玩，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "免得她又胡亂使出魔法！",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "……除了是以朋友的身分外，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "同時也是以姐妹的身分、",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "呦。",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "別說了！",
    "voice": "vo_adv_6048110_003",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "一想到還會有那樣的遭遇就覺得很恐怖啊！",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "雖然有負責監督的弓箭待在身邊，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "應該沒問題才是……",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "真希望她能好好成長呢。",
    "voice": null,
    "unit_id": 113811
  }
]
