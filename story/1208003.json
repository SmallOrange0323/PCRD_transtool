[
  {
    "type": "background",
    "bg_id": "501470"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "參加完活動的流夏一行人",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n逛到了蘭德索爾的擺攤市集。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "啊～！",
    "voice": "vo_adv_1208003_000",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "真好吃！",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "在雪景中享用蕎麥麵真是別有韻味啊。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "因為之前一直在運動，",
    "voice": "vo_adv_1208003_001",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我的肚子早就空蕩蕩的了，",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n幸好還有攤販市集啊。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "既然已經填飽肚子，",
    "voice": "vo_adv_1208003_002",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "感覺整個人都活過來了，",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "接下來要做什麼才好呢？",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這點子不錯。",
    "voice": "vo_adv_1208003_003",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "畢竟除了食物外，\\n市集還有在賣各種東西，",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我們就隨意逛吧。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n搞不好能夠找到很棒的吉祥物。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "射擊遊戲、抽籤",
    "voice": "vo_adv_1208003_004",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "和賣玩具的，",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "有各式各樣的攤販啊。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "如果我有拿到紅包，",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "可能會不由自主拿來亂花。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我已經變成給紅包的人了。",
    "voice": "vo_adv_1208003_005",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "杏奈和七七香也都會吵著跟我要紅包，真傷腦筋。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "真希望等她們有能力自己賺錢後，",
    "voice": "vo_adv_1208003_006",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n就能從領紅包一族畢業啊。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "喔，",
    "voice": "vo_adv_1208003_007",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小哥，你看。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n這裡不是剛好有個在賣熊手的攤販嗎？",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "據說熊手是",
    "voice": "vo_adv_1208003_008",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "能夠把福氣搜刮起來的吉祥物，",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "看起來也很華麗，",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這種喜氣的感覺很不錯啊。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "難得見到，",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我們就去看一下──",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "小弟弟，你沒有要買的話就回去吧！",
    "voice": "vo_adv_1208003_009",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "……！",
    "voice": "vo_adv_1208003_010",
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "對、",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "不起。",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "喂喂，",
    "voice": "vo_adv_1208003_011",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "對方是小孩，火氣不需要這麼大吧。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "你們有什麼事？",
    "voice": "vo_adv_1208003_012",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "我很忙的，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n沒時間",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "跟窮小孩瞎耗。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "……",
    "voice": "vo_adv_1208003_013",
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "嗯……",
    "voice": "vo_adv_1208003_014",
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "我妹妹",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "最近才剛出生。",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "\\n",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "為了祈禱",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "妹妹能夠幸福，我才想買熊手，",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "\\n但我的零用錢完全不夠……",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "嗯，",
    "voice": "vo_adv_1208003_015",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "熊手對小孩子來說",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "的確是有點貴啊。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n畢竟做得越豪華，價格也就越高。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "要不要試著",
    "voice": "vo_adv_1208003_016",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "跟你爸媽商量一下？",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "嗯……",
    "voice": "vo_adv_1208003_017",
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "可是",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "我想偷偷買起來，",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "讓他們嚇一跳……",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "原來如此，",
    "voice": "vo_adv_1208003_018",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這樣會讓人很想為他想點辦法啊。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不過，",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "總不能擅自買給別人家的小孩……",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "咦？",
    "voice": "vo_adv_1208003_019",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不，這個嘛，",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我想應該不至於做不出來……",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n小哥你",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "難不成……",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "原來如此，",
    "voice": "vo_adv_1208003_020",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你這種想法很棒。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "但熊手的裝飾要怎麼辦？",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n就算想做，我們也沒有那個技術啊。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "即使真的能做出來，",
    "voice": "vo_adv_1208003_021",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "也會花費太多的勞力和時間。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你說",
    "voice": "vo_adv_1208003_022",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "身邊的東西，",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "是指花草和樹果嗎？",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "嗯",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "，",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這樣或許行得通啊。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小子，",
    "voice": "vo_adv_1208003_023",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你等一下。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我們來幫你做個熊手。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "那、",
    "voice": "vo_adv_1208003_024",
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "那我跟你們一起去。",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "因為我也可以幫忙摘花。",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "是嗎？",
    "voice": "vo_adv_1208003_025",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那我們",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這就出發吧。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "background",
    "bg_id": "500170"
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "喔，",
    "voice": "vo_adv_1208003_026",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這種花挺不錯的啊。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "在冬天也開了不少。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "大姐姐，",
    "voice": "vo_adv_1208003_027",
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "這個葉子怎麼樣？",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "哦，",
    "voice": "vo_adv_1208003_028",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "真是有趣的形狀。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那就也拿來用吧。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "太好了～！",
    "voice": "vo_adv_1208003_029",
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "不知道有沒有其他好東西掉在地上？",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "是啊。",
    "voice": "vo_adv_1208003_030",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "每種材料都很漂亮，",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "把這些組合起來後，我想成品應該很不錯，但……",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就是說啊。",
    "voice": "vo_adv_1208003_031",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "如果要找不必花錢的材料，",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n而且又要表現出裝飾品般的華麗感",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "和魄力……",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "奇怪？",
    "voice": "vo_adv_1208003_032",
