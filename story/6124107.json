[
  {
    "type": "background",
    "bg_id": "501950"
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "貴公に折り入って相談があるのだが……",
    "voice": "vo_adv_6114107_000",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "今回、",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "タマキには",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\nずいぶん世話になっただろう？　",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "特別な形でお礼がしたいのだが",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\nなにをすれば彼女は喜んでくれるだろうか？",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "それはいい。",
    "voice": "vo_adv_6114107_001",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "私は甘味には少々うるさいからな。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n選りすぐりの甘味を取り揃えて贈るとしよう……",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "いや、",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "しかし",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\nいざ選ぶとなると",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "どれも捨てがたいな。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "うーむ、",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "これは悩みどころだ……",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "うむ、",
    "voice": "vo_adv_6114107_002",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "だいぶ無理をさせてしまったからな。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "ちょうどカフェの運営も軌道に乗って、",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "余裕も出てきたことだしな。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "粉骨砕身でがんばってくれた分、",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "大いに羽を伸ばしてもらうとしよう。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "！　",
    "voice": "vo_adv_6114107_003",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "き、",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "貴公……！　",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "確かにそうだ、",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "その通りだな。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\nどんな形で礼をするにせよ、",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "まずは言葉で感謝を伝えることからだ。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "少しばかり照れくさくはあるが……",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "そうしてみる。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "ありがとう！",
    "voice": null,
    "unit_id": 125212
  }
]
