  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "目をかっぴらいて、",
    "voice": "vo_adv_5134401_000",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "よ～く見ておくです！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "【ドラゴンズネスト】大幹部、",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "イノリさまの晴れ着姿ですからね！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "この姿、",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "ご来光のごとく拝むといいですよ！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "……まぁ、",
    "voice": "vo_adv_5134401_001",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "正直に白状すると。",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "より強そうなデザインにするべく",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\nカヤぴぃにもアドバイスをもらったですよ。",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "アピールポイントは、",
    "voice": "vo_adv_5134401_002",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "もちろん",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "柄です！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "強くて渋いギャングの魅力が伝わるよう、",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "細かく指示したですから。",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "気に入ったなら、",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "有料で写真を撮らせてやってもいいですよ？",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "えっ、",
    "voice": "vo_adv_5134401_003",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "本気にするんじゃねえですよ！　",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "しかも",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "一緒に撮る！？",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "ちょっと待つです、",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "ポーズも渋い感じのを考えないと……",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "しかめっ面で",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "腕組で……",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "よし！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "とりあえず、",
    "voice": "vo_adv_5134401_004",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "このおめでたいイノリさまを",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "崇めやがれです！",
    "voice": null,
    "unit_id": 128311
  }
]
