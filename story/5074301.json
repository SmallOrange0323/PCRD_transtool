[
  {
    "type": "dialogue",
    "name": "深月",
    "words": "喔～",
    "voice": "vo_adv_5074301_000",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "巨大身軀能使出強烈攻擊，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n再加上什麼傷勢都能立刻復原的再生能力。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "還真是棘手呢。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "能這麼冷靜分析是很可靠啦，",
    "voice": "vo_adv_5074301_001",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "但這種怪物真的打得倒嗎？",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "妳知道嗎？",
    "voice": "vo_adv_5074301_002",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "醫生擅長救人的知識與技術，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "但這同時也表示，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "熟知與其相反的手段喔。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "妳好像若無其事說出了可怕的話，",
    "voice": "vo_adv_5074301_003",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "但現在聽起來十分令人安心，好神奇啊。",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "好啦，",
    "voice": "vo_adv_5074301_004",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "開始動刀吧。",
    "voice": null,
    "unit_id": 117511
  }
]
