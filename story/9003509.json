[
  {
    "type": "dialogue",
    "name": "嘉夜、祈梨",
    "words": "喝啊！\\n嘿──！",
    "voice": "vo_adv_9003509_000",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "唔……！",
    "voice": "vo_adv_9003509_001",
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "呵呵。",
    "voice": "vo_adv_9003509_002",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n你差不多沒有退路了呢～♪",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "……哎呀哎呀。",
    "voice": "vo_adv_9003509_003",
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "\\n",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "本沒打算捲入消耗戰的……",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "真無奈啊。",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "萬能人偶",
    "words": "「嗡──嗡──」",
    "voice": null,
    "unit_id": 191912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "哇哇！",
    "voice": "vo_adv_9003509_004",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n它們",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "又出現了！？",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "萬能人偶──",
    "voice": "vo_adv_9003509_005",
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "耗費了我這麼多心血，",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "應該能爭取到一些時間吧。",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "\\n且讓我重整旗鼓囉。",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "喂喂，大叔！",
    "voice": "vo_adv_9003509_006",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "明明才打到一半，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你是想逃嗎？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "剛才",
    "voice": "vo_adv_9003509_007",
    "unit_id": 100312
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "已經說了要做個了斷吧……！？",
    "voice": null,
    "unit_id": 100312
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "我當然",
    "voice": "vo_adv_9003509_008",
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "也想分出勝負。",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "\\n但戰鬥",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "比預期的延長了許多……",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "\\n",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "所以我想",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "先用餐休息片刻。",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "哇，",
    "voice": "vo_adv_9003509_009",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那很不錯呢……☆",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "純、智",
    "words": "陛下！",
    "voice": "vo_adv_9003509_010",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "開、",
    "voice": "vo_adv_9003509_011",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "開玩笑的啦～！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "呵呵。",
    "voice": "vo_adv_9003509_012",
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "容我先失陪了。",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "啊──！",
    "voice": "vo_adv_9003509_013",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "等等～！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "別追了，茉莉！",
    "voice": "vo_adv_9003509_014",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n智也是！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "純？",
    "voice": "vo_adv_9003509_015",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我想我們應該",
    "voice": "vo_adv_9003509_016",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "留最低限度的兵力在這裡……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n並派其他人趕往",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "城裡遭受攻擊的地方救援。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n您覺得好嗎？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "陛下。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "當然！",
    "voice": "vo_adv_9003509_017",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "吃飯休息的事",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我會先忍耐……",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "快去幫助大家吧！",
    "voice": null,
    "unit_id": 105811
  }
