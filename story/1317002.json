    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不，",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "如果是這傢伙，",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "就算勉強也會吃下去吧。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "呵呵♪",
    "voice": "vo_adv_1317002_037",
    "unit_id": 51311
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "\\n還真是位果敢的男朋友呢？",
    "voice": null,
    "unit_id": 51311
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "\\n",
    "voice": null,
    "unit_id": 51311
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "那就",
    "voice": null,
    "unit_id": 51311
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "所有品項來半份，",
    "voice": null,
    "unit_id": 51311
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "讓你們可以多多嘗試吧。",
