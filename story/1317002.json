    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "要是認為我很開心就大錯特錯了。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好了，",
    "voice": "vo_adv_1317002_027",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "現在",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "就讓我見識一下你的本事吧。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "呵呵，",
    "voice": "vo_adv_1317002_028",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我就知道你會這麼說。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n這是最容易預料的選擇。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不過算了，",
    "voice": "vo_adv_1317002_029",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "沒關係啦。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "雖然沒有驚喜就是了。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "background",
    "bg_id": "500690"
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "歡迎光臨～♪",
