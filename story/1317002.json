    "name": "愛梅斯",
    "words": "那樣",
    "voice": "vo_adv_1317002_046",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "確實能悠哉享受，",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "或許不錯呢。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那麼，",
    "voice": "vo_adv_1317002_047",
    "unit_id": 131711
  },
  {
