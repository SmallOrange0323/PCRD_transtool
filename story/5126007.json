    "name": "來賓",
    "words": "請你安靜！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "來賓",
    "words": "\\n你打擾到凱留同學致詞了！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "不良學生",
    "words": "大人給我閉嘴……！",
    "voice": "vo_adv_5126007_036",
    "unit_id": 814
  },
  {
    "type": "dialogue",
    "name": "不良學生",
    "words": "\\n喂！凱留！",
    "voice": null,
    "unit_id": 814
  },
  {
    "type": "dialogue",
    "name": "不良學生",
    "words": "最後就不要再裝乖了！",
    "voice": null,
    "unit_id": 814
  },
  {
    "type": "dialogue",
    "name": "不良學生",
    "words": "\\n我們想聽到的",
    "voice": null,
    "unit_id": 814
  },
  {
    "type": "dialogue",
    "name": "不良學生",
    "words": "才不是那種場面話──！",
    "voice": null,
    "unit_id": 814
  },
  {
    "type": "dialogue",
    "name": "不良學生",
    "words": "我想……",
    "voice": "vo_adv_5126007_037",
    "unit_id": 814
  },
  {
    "type": "dialogue",
    "name": "不良學生",
    "words": "我們想",
    "voice": null,
    "unit_id": 814
  },
  {
    "type": "dialogue",
    "name": "不良學生",
    "words": "聽到妳真實的心聲！",
    "voice": null,
    "unit_id": 814
  },
  {
    "type": "dialogue",
    "name": "不良學生",
    "words": "\\n",
    "voice": null,
    "unit_id": 814
  },
  {
    "type": "dialogue",
    "name": "不良學生",
    "words": "各位，你們說對吧！？",
    "voice": null,
    "unit_id": 814
  },
  {
    "type": "dialogue",
    "name": "男學生",
    "words": "對啊，",
    "voice": "vo_adv_5126007_038",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男學生",
    "words": "凱留，這很不像妳喔！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女學生",
    "words": "嗯！",
    "voice": "vo_adv_5126007_039",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女學生",
    "words": "像平常那樣就行了！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你們……",
    "voice": "vo_adv_5126007_040",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "凱留寶！",
    "voice": "vo_adv_5126007_041",
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "鈴、",
    "voice": "vo_adv_5126007_042",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "鈴奈！？",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n等等，",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "幹嘛把我的信拿走啊！？",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "啊哈哈！",
    "voice": "vo_adv_5126007_043",
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "對不起！",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "但是，",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家的意見也跟大家一樣呢♪",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "讓我們聽聽，",
    "voice": "vo_adv_5126007_044",
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "凱留寶真正的想法！",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "{0}……",
    "voice": "vo_adv_5126007_045",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……",
    "voice": "vo_adv_5126007_046",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我知道了啦！",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那你們就聽好了！！",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我就老實說了，",
    "voice": "vo_adv_5126007_047",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我超討厭學校的！！",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "來賓",
    "words": "咦……",
    "voice": "vo_adv_5126007_048",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "來賓",
    "words": "凱留同學！？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "來賓",
    "words": "\\n身為優等生的妳怎麼能這樣說！？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "班導",
    "words": "噓～！",
    "voice": "vo_adv_5126007_049",
    "unit_id": 915
  },
  {
    "type": "dialogue",
    "name": "班導",
    "words": "大人不要干擾她。",
    "voice": null,
    "unit_id": 915
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……我一直",
    "voice": "vo_adv_5126007_050",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "都這麼想。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n學校這種東西，",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "感覺就像是不自由的牢籠。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "被不講理的校規束縛，",
    "voice": "vo_adv_5126007_051",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "被奪走自由和時間，",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n拿來學習自己不想學的東西……",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這種地方",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "跟牢籠沒有兩樣。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n……",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "而你們，",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "其實也是這麼想的。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "但是你們啊，",
    "voice": "vo_adv_5126007_052",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是沒有能力獨自生活的雛鳥。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n所以要和其他弱小的人成群結隊，",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "拚命地配合步調以免自己落後。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "然而",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "對於無法配合上步調的人，",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就當作異類加以排除……",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "所以無論是學校，",
    "voice": "vo_adv_5126007_053",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "還是你們這種在學校就讀的學生，",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我都超討厭的！",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "學生們",
    "words": "…………",
    "voice": "vo_adv_5126007_054",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……我本來以為所謂的「青春」，",
    "voice": "vo_adv_5126007_055",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n根本就只是拿來美化這些死板日子的詞彙罷了。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "因為不承認自己每天都過得很無趣，",
    "voice": "vo_adv_5126007_056",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "所以就說這是青春吧！",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "像這樣",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "裝作好像過得很耀眼，",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n拚命地蒙騙自己。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……因此，",
    "voice": "vo_adv_5126007_057",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我是為了確認這點",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "才試著來這裡上學的。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "想證明學生放學後",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "看似開心的表情",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是假的，",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "證明自己",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "根本就不羨慕什麼青春……",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……但是，",
    "voice": "vo_adv_5126007_058",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我錯了。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "實際體驗過後，",
    "voice": "vo_adv_5126007_059",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我發現學校其實也沒有那麼糟。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我在這裡，",
    "voice": "vo_adv_5126007_060",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "確實",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "享受到了青春。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "雖然說我討厭成群結隊，",
    "voice": "vo_adv_5126007_061",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "但如果只有我一個人",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是絕對沒有辦法體會到的。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n所以說……",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我很感激。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "謝謝你們。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……以上。",
    "voice": "vo_adv_5126007_062",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "呃，",
    "voice": "vo_adv_5126007_063",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我好像說了些很莫名其妙的話……！",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "現在馬上給我忘了！！",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "拍手拍手拍手拍手！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……唔。",
    "voice": "vo_adv_5126007_064",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "不良學生",
    "words": "嘿嘿！",
    "voice": "vo_adv_5126007_065",
    "unit_id": 814
  },
  {
    "type": "dialogue",
    "name": "不良學生",
    "words": "妳一樣還是那個講話很惡毒的臭眼鏡女！",
    "voice": null,
    "unit_id": 814
  },
  {
    "type": "dialogue",
    "name": "不良學生",
    "words": "\\n",
    "voice": null,
    "unit_id": 814
  },
  {
    "type": "dialogue",
    "name": "不良學生",
    "words": "不過，",
    "voice": null,
    "unit_id": 814
  },
  {
    "type": "dialogue",
    "name": "不良學生",
    "words": "我就是想聽妳說這些！",
    "voice": null,
    "unit_id": 814
  },
  {
    "type": "dialogue",
    "name": "不良學生",
    "words": "\\n這真是最棒的致詞了！！",
    "voice": null,
    "unit_id": 814
  },
  {
    "type": "dialogue",
    "name": "委員長",
    "words": "呵呵，",
    "voice": "vo_adv_5126007_066",
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "委員長",
    "words": "凱留同學，",
    "voice": null,
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "委員長",
    "words": "我們才要謝謝妳。",
    "voice": null,
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "委員長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "委員長",
    "words": "然後，",
    "voice": null,
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "委員長",
    "words": "也恭喜妳畢業。",
    "voice": null,
    "unit_id": 1215
  },
  {
    "type": "dialogue",
    "name": "學生們",
    "words": "恭喜畢業！！",
    "voice": "vo_adv_5126007_067",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……謝謝。",
    "voice": "vo_adv_5126007_068",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……鈴奈！",
    "voice": "vo_adv_5126007_069",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "！",
    "voice": "vo_adv_5126007_070",
