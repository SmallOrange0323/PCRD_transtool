[
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "找到你了，",
    "voice": "vo_adv_5033302_000",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "反逆獸！",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "不論是什麼謎題都能一口氣解決！　",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "用愛的力量逮捕犯人☆",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "束手就擒吧！　",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "迷霧纏束！",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "趁著牠無法動彈時一箭射穿牠！",
    "voice": "vo_adv_5033302_001",
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "在這一箭注入愛的力量！　",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "純真之箭！",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "反逆獸",
    "words": "――嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 12811
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "打破結界了喔，",
    "voice": "vo_adv_5033302_002",
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "霞！",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "嗯！　",
    "voice": "vo_adv_5033302_003",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "但是在這隻反逆獸身上，",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "能夠感受到比之前更強的力量……",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "\\n普通的方法可能沒有用呢……！",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "沒問題的。",
    "voice": "vo_adv_5033302_004",
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "因為我們身邊，",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "還有跟我們一起戰鬥的夥伴們啊！",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "栞……",
    "voice": "vo_adv_5033302_005",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "嗯，",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "沒錯呢。",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "結合這裡所人的力量，",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "取回街道的和平吧！",
    "voice": null,
    "unit_id": 112211
  }
]
