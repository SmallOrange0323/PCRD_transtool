    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n我真開心～",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "畢竟妳雖是需要堤防的人物，",
