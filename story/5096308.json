  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "那隻魔物",
    "voice": null,
    "unit_id": 122411
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "看起來變得更厲害了……！",
    "voice": null,
    "unit_id": 122411
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n難道牠越戰鬥",
    "voice": null,
    "unit_id": 122411
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "就會變得越強嗎！？",
    "voice": null,
    "unit_id": 122411
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "原來有這樣的個體存在啊……",
    "voice": "vo_adv_5096308_001",
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "真是難纏的對手。",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "氣場不太一樣呢……",
    "voice": "vo_adv_5096308_002",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我們必須比之前更加團結戰鬥才行，",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "不然可就危險了！",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "是啊！",
    "voice": "vo_adv_5096308_003",
    "unit_id": 122411
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "對方好像也會全力以赴地攻過來！",
    "voice": null,
    "unit_id": 122411
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 122411
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我們也不能輸喔──！",
    "voice": null,
    "unit_id": 122411
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我們一定要打贏牠，",
    "voice": "vo_adv_5096308_004",
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "奪回小島和大海的和平！",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "嗯！",
    "voice": "vo_adv_5096308_005",
    "unit_id": 122611
  },
  {
