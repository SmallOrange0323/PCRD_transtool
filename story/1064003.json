  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "現在不是找回記憶的時候了，{0}。",
    "voice": "vo_adv_1064003_000",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "要去工作。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "因、",
    "voice": "vo_adv_1064003_001",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "因為……！",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我完全",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "不知情呀！",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "【美食殿堂】的家計",
    "voice": "vo_adv_1064003_002",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "居然這麼拮据……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "可可蘿小姐還去做兼職和家庭代工！",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "{0}，",
    "voice": "vo_adv_1064003_003",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n你也有在打工呀……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "就只有我一個人",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "像是白吃飯的……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "這樣不行！",
    "voice": "vo_adv_1064003_004",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n所以，我也要工作！",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "唔……",
    "voice": "vo_adv_1064003_005",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "這、",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "這個嘛……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "確實是……",
    "voice": "vo_adv_1064003_006",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "有點傷腦筋。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "起碼……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "「現在的我」是沒有工作經驗的。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "有什麼工作……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "是我也做得來的嗎？",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "……拜託你了，{0}。",
    "voice": "vo_adv_1064003_007",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n你能教我",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "怎麼找工作嗎？",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "就算沒有任何經驗，",
    "voice": "vo_adv_1064003_008",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我也會",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "好好努力的！",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n為了媽媽！",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "……啊……",
    "voice": "vo_adv_1064003_009",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "嗚……",
    "voice": "vo_adv_1064003_010",
    "unit_id": 106412
  },
  {
    "type": "background",
    "bg_id": "500390"
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "這就是",
    "voice": "vo_adv_1064003_011",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "公會的布告欄啊……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "只要從張貼的公告裡",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n找一個自己做得來的工作就行了嗎？",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "有好多種工作啊……",
    "voice": "vo_adv_1064003_012",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "你有什麼",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "推薦的嗎？",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "擊退魔物……",
    "voice": "vo_adv_1064003_013",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "如果是不怎麼強的魔物的話，",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n我應該也辦得到……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "不過……",
    "voice": "vo_adv_1064003_014",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "目前好像還沒有",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "在這座城附近的委託。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "這樣",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "就傷腦筋了……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "搬東西……",
    "voice": "vo_adv_1064003_015",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "這我應該",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "也辦得到吧？",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "唔……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "可是……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "搬東西的委託，",
    "voice": "vo_adv_1064003_016",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n好像都要離開城鎮送到遠方去。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n這樣",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "就傷腦筋了……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "這個嘛。",
    "voice": "vo_adv_1064003_017",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n我還是個新手……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "這種要離開城鎮，",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "或是得花上很多天的工作，",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n等我適應以後再來做吧。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "……況且，",
    "voice": "vo_adv_1064003_018",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我也不想",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "和大家分開太久……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "不過，",
    "voice": "vo_adv_1064003_019",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "要收人家的錢，",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n也不能這麼挑三揀四的。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "要是有覺得自己辦得到的工作，",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我會去試試看……！",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "background",
    "bg_id": "500050"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "「招募兼職服務生！誠徵活潑開朗的你！」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "顧客１",
    "words": "不好意思！",
    "voice": "vo_adv_1064003_020",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "顧客１",
    "words": "\\n再給我三杯麥酒！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "顧客２",
    "words": "服務生！",
    "voice": "vo_adv_1064003_021",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "顧客２",
    "words": "\\n這邊要麥酒",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "顧客２",
    "words": "和葡萄汽水！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "好、",
    "voice": "vo_adv_1064003_022",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "好的！",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "唔、",
    "voice": "vo_adv_1064003_023",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "好難保持平衡……！",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "把鈴莓小姐當作反面教材……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "慢慢地，",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "慢慢地！　",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "唔！",
    "voice": "vo_adv_1064003_024",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "哇啊啊～！？",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "background",
    "bg_id": "500020"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "「懇請協尋！幫我找回走失的愛貓！」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貓",
    "words": "喵！",
    "voice": null,
    "unit_id": 1711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "呼、",
    "voice": "vo_adv_1064003_025",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "呼……！",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n動作太敏捷了吧……！",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "好！",
    "voice": "vo_adv_1064003_026",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n這次",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我一定要抓住你！",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "貓",
    "words": "嘶呀──！！",
    "voice": null,
    "unit_id": 1711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "哇呀！？",
    "voice": "vo_adv_1064003_027",
    "unit_id": 106412
  },
  {
    "type": "background",
    "bg_id": "500011"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "「請求協助郵件配送！今日送達！」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我、",
    "voice": "vo_adv_1064003_028",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我迷路了……！",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n都這個時間了……！",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "既然如此，只好使出殺手鐧了。",
    "voice": "vo_adv_1064003_029",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n讓路面結冰，",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "然後一路滑過去……！",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "──「冰霜之路」！",
    "voice": "vo_adv_1064003_030",
    "unit_id": 106412
  },
  {
    "type": "still",
    "still_id": "01"
  },
  {
    "type": "still",
    "still_id": "01"
  },
  {
    "type": "dialogue",
    "name": "車夫",
    "words": "哇！",
    "voice": "vo_adv_1064003_031",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "車夫",
    "words": "\\n路面結冰了！？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "啊！",
    "voice": "vo_adv_1064003_032",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n妨礙到馬車通行了……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "對不起！",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "background",
    "bg_id": "500392"
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "……呼……",
    "voice": "vo_adv_1064003_033",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n總算是送完了……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "……工作真是件辛苦的事。",
    "voice": "vo_adv_1064003_034",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "今天我還搞砸了好多事。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "……謝謝你，{0}。",
    "voice": "vo_adv_1064003_035",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "不過……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "真的會有",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "適合我做的工作嗎……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "那怎麼行……",
    "voice": "vo_adv_1064003_036",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "可是",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "車夫",
    "words": "啊！",
    "voice": "vo_adv_1064003_037",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "車夫",
    "words": "\\n找到了！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "車夫",
    "words": "\\n剛才的小姑娘！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "你是……",
    "voice": "vo_adv_1064003_038",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "剛剛受到波及",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "停下馬車的車夫先生……？",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "剛才，",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "真的是",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "很抱歉……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "車夫",
    "words": "沒事！",
    "voice": "vo_adv_1064003_039",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "車夫",
    "words": "\\n妳不用放在心上。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "車夫",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "車夫",
    "words": "比起這個，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "車夫",
    "words": "妳是不是很擅長使用冰系魔法呀？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "咦？",
    "voice": "vo_adv_1064003_040",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n……嗯，",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "算是吧……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "車夫",
    "words": "那正好！",
    "voice": "vo_adv_1064003_041",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "車夫",
    "words": "\\n妳能幫我把這個吞拿金槍鮪肉塊",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "車夫",
    "words": "冷凍起來嗎？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "喔，",
    "voice": "vo_adv_1064003_042",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "可以啊……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "車夫",
    "words": "哇，",
    "voice": "vo_adv_1064003_043",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "車夫",
    "words": "太神奇了！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "車夫",
    "words": "\\n凍得硬邦邦的呢！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "這點小事",
    "voice": "vo_adv_1064003_044",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "沒什麼大不了的。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "車夫",
    "words": "這行得通！",
    "voice": "vo_adv_1064003_045",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "車夫",
    "words": "\\n嘿，小姑娘，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "車夫",
    "words": "妳願不願意來我們運送公會工作呀！？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "車夫",
    "words": "如果能把鮮魚和肉類冰鎮起來的話，",
    "voice": "vo_adv_1064003_046",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "車夫",
    "words": "就能維持新鮮度賣出去了！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "車夫",
    "words": "\\n報酬一分都不會少給！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "車夫",
    "words": "\\n如何？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "車夫",
    "words": "拜託啦！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "咦！？",
    "voice": "vo_adv_1064003_047",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n這個嘛……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "那麼……",
    "voice": "vo_adv_1064003_048",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "雖然無法加入你們的公會，",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n但我偶爾可以過去幫忙，",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "這樣你們願意讓我工作嗎？",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──就這樣，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n雪菲開始在運送公會工作了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "不光是冰鎮鮮魚和肉類，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n將雪菲製作的冰塊送往港口，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n食材就能在保有新鮮度的狀態下運送，評價非常好。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500366"
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "太好了……",
    "voice": "vo_adv_1064003_049",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n這麼一來，",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我也能為家計貢獻一份心力了。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "當然了，",
    "voice": "vo_adv_1064003_050",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "關於那些記憶……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n我想了解「以前的我」的心情",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "還是很強烈的……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "只不過，",
    "voice": "vo_adv_1064003_051",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n「現在的我」",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "是大家的夥伴，",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "這點更加重要。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n要能夠抬頭挺胸地",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "作為這個公會……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "【美食殿堂】的一員，",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "對吧。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "尋找記憶",
    "voice": "vo_adv_1064003_052",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "就等到一切上軌道後再說吧。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n所以",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我──",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我會",
    "voice": "vo_adv_1064003_053",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "好好努力的！",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n努力製作冷凍吞拿金槍鮪……！",
    "voice": null,
    "unit_id": 106412
  }
]
