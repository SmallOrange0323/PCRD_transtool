  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "…………",
    "voice": "vo_adv_1038001_000",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……",
    "voice": "vo_adv_1038001_001",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "嗯嗯。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "咦？那、個……？",
    "voice": "vo_adv_1038001_002",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我昏倒了嗎……？",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……呀！？",
    "voice": "vo_adv_1038001_003",
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "對、對不起，一下就弓矢相向……",
    "voice": null,
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "那個，你是？",
    "voice": null,
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你叫，{0}是嗎？\\n",
    "voice": "vo_adv_1038001_004",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你好，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "那個，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "初次見面……？",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我的名字是栞。",
    "voice": "vo_adv_1038001_005",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "是的，",
    "voice": "vo_adv_1038001_006",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "如你所見我是獸人……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我是【動物苑】旗下公會，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n 【哞哞自衛隊】的一員。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我現在算是正在休養中……",
    "voice": "vo_adv_1038001_007",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "因為各種原因，我被派到同為",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n【動物苑】旗下公會的【伊麗莎白牧場】。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "不過，現在不是該作自我介紹的時候吧……",
    "voice": "vo_adv_1038001_008",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "對不起，我剛睡醒頭腦還昏沉沉～的不太清楚。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我本身有低血壓。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "那個，我昏倒在路旁，",
    "voice": "vo_adv_1038001_009",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n是你照顧我的吧……？",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "真的是……很抱歉，給你添麻煩了吧。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "對不起，我的身體不太好。",
    "voice": "vo_adv_1038001_010",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "有時候就會頭昏……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "眼花的。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我一直都在山上的牧場靜養。",
    "voice": "vo_adv_1038001_011",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "今天因為覺得身體狀況還不錯，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n所以我久違地試著下山來城鎮看看。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "因為我有些想買的東西，像書之類的。",
    "voice": "vo_adv_1038001_012",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "平常我都是拜託牧場裡的人……",
    "voice": "vo_adv_1038001_013",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "偶爾會託來探病的姊姊",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n幫我買東西。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "但是那樣我還是會覺得很不好意思。",
    "voice": "vo_adv_1038001_014",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我不能老是就這樣依靠別人……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我應該要變得能夠照顧自己才行。",
    "voice": "vo_adv_1038001_015",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "雖然",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我是這麼覺得的。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "但是，",
    "voice": "vo_adv_1038001_016",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "光是抵達城鎮，我好像就體力透支了。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "啊，我沒事的。",
    "voice": "vo_adv_1038001_017",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n請你不用擔心。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我想我只要稍微休息一下，就會恢復了。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "嗯？",
    "voice": "vo_adv_1038001_018",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "怎麼了嗎？",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "你好像有什麼話想說呢……？",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "嗚哇……",
    "voice": "vo_adv_1038001_019",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n怎、怎麼了？",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "你為什麼要摸我的頭？",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "你覺得我的耳朵很稀奇嗎？",
    "voice": "vo_adv_1038001_020",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "啊，你是在測我的體溫呀，我不要緊的……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "雖然我還覺得有點頭暈，",
    "voice": "vo_adv_1038001_021",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "但是和你聊天後，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n我已經大致清醒了。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "啊哈哈……",
    "voice": "vo_adv_1038001_022",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n你不用這麼擔心，我不要緊的。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "雖然我明明就昏倒，說起來沒什麼說服力。",
    "voice": "vo_adv_1038001_023",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "但是再給你添麻煩的話，我會很過意不去。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "那個……",
    "voice": "vo_adv_1038001_024",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "無論如何，我已經沒事了。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n所以我就在此告退了喔。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "受你諸多照顧了。",
    "voice": "vo_adv_1038001_025",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n這份恩情，我會擇日報答的。",
    "voice": null,
    "unit_id": 103811
  }
]
