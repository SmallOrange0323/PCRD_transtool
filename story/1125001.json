    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "蒼藍……",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "果然沒錯！　",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "得快點去告訴大家才行！！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "background",
    "bg_id": "500050"
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "欸大家，",
    "voice": "vo_adv_1125001_059",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "聽我說聽我說！　",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "我今天去執行委託的時候呀！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "得到了「蒼藍劍士凜」的幫助耶！！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "男冒險者",
    "words": "咦，",
    "voice": "vo_adv_1125001_060",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男冒險者",
    "words": "真的假的！？",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男冒險者",
    "words": "\\n所以",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男冒險者",
    "words": "妳也看到真正的詠唱了！？",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "嗯，",
    "voice": "vo_adv_1125001_061",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "她在我眼前詠唱「蒼藍」的咒語，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "然後打敗了敵人！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "\\n她人不只是很帥氣，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "還非常溫柔——",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "劍術快如疾風，詠唱著莫名冗長咒語的「蒼藍劍士」凜。\\n她本人似乎還不知曉，謠傳中的自己，被一部分人這麼稱呼著——",
    "voice": null,
