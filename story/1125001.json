  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "這是{0}",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n與【new generations】的三人相遇前的故事——",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "行前準備大概這樣就沒問題了吧……",
    "voice": "vo_adv_1125001_000",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "那麼，",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "我差不多要走了。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "啊——",
    "voice": "vo_adv_1125001_001",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "對喔。",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "今天工作是由澀凜凜負責的呢。",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "是會很花時間的委託嗎？",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "不好說呢。",
    "voice": "vo_adv_1125001_002",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "委託內容是驅除魔物，",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "但聽說那附近容易發生問題，",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "視魔物的多寡，有可能會拖比較晚吧。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "但是",
    "voice": "vo_adv_1125001_003",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "我現在就要出發了，",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "就算花比較多時間，",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n大概也能在傍晚左右回來吧。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "這樣啊，",
    "voice": "vo_adv_1125001_004",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "OK！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "島村村很在意澀凜凜會不會回來吃，",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "所以我會先跟她說一聲的。",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "嗯，",
    "voice": "vo_adv_1125001_005",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "麻煩妳了。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "就算是為了卯月親手做的料理，",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "我也會早點把工作結束掉的。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "難得做好的料理要是冷掉就太可惜了，",
    "voice": "vo_adv_1125001_006",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "加油喔～！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "澀凜凜Fight！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "路上小心～☆",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "background",
    "bg_id": "500170"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "咕唔唔唔唔唔……",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "數量是",
    "voice": "vo_adv_1125001_007",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "……",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "四隻啊，",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "比想像中還少呢。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "這點程度",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "應該能一口氣解決掉……",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "好！　",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "喝！",
    "voice": "vo_adv_1125001_008",
    "unit_id": 112511
  },
  {
    "type": "background",
    "bg_id": "500170"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "――嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "喝！　",
    "voice": "vo_adv_1125001_009",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "嘿啊！　",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "呀啊～！！",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "background",
    "bg_id": "500170"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "――嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "呼……",
    "voice": "vo_adv_1125001_010",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "嗯，",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "大概就這樣吧。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "……總覺得",
    "voice": "vo_adv_1125001_011",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "好像有點太輕鬆了？",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n也沒有其他魔物，",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "容易發生問題又是怎麼回事？　",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "呀啊啊啊啊啊啊啊！！",
    "voice": "vo_adv_1125001_012",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "！？　",
    "voice": "vo_adv_1125001_013",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "剛才的聲音是……",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "從那邊傳來的！？",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "唔……",
    "voice": "vo_adv_1125001_014",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "你、",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "你不要再靠過來了！　",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "我會砍下去喔！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "妳這種嚇到都站不穩的威脅沒什麼好怕的啦。",
    "voice": "vo_adv_1125001_015",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "小姐，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "妳是新手吧？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "這樣不行啊――",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "要乖乖跟同伴組隊啊。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "找到了！",
    "voice": "vo_adv_1125001_016",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "但距離還很遠……",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "得小心接近，別被對方發現了。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "我、",
    "voice": "vo_adv_1125001_017",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "我",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "只是接了驅除魔物的委託才來的！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "我可以",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "特、",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "特別放過你們！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "噗哈哈！　",
    "voice": "vo_adv_1125001_018",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "放過我們！？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "\\n妳沒有立場說那種話吧～",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "野賊老大",
    "words": "既然是來驅除魔物的，",
    "voice": "vo_adv_1125001_019",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "野賊老大",
    "words": "那就更不能放妳回去了。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "野賊老大",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "野賊老大",
    "words": "要是沒有那些魔物，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "野賊老大",
    "words": "我們就不好工作了啊。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "原來如此……",
    "voice": "vo_adv_1125001_020",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "將自己的惡行偽裝成魔物所為啊。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "那麼，",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "不打倒這些傢伙就無法解決這件事情呢。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "……好，",
    "voice": "vo_adv_1125001_021",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "來到這裡就行了！　",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "妳就死心吧，",
    "voice": "vo_adv_1125001_022",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "乖乖被我們——",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "到此為止了！",
    "voice": "vo_adv_1125001_023",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "咦！？",
    "voice": "vo_adv_1125001_024",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "什麼！？　",
    "voice": "vo_adv_1125001_025",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "盜賊",
    "words": "妳是哪來的傢伙！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "你們這些小人物不值得我報上名。",
    "voice": "vo_adv_1125001_026",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "像你們這種專挑新手冒險者下手的傢伙",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "更不用說。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "野賊老大",
    "words": "嘿，",
    "voice": "vo_adv_1125001_027",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "野賊老大",
    "words": "挺強勢的小妹妹呢。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "野賊老大",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "野賊老大",
    "words": "對我們而言，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "野賊老大",
    "words": "增加了獵物可是幫大忙啦。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "妳、",
    "voice": "vo_adv_1125001_028",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "妳別管我了，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "快點逃！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性冒險者",
    "words": "只有妳一個人太危險了！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "別擔心，",
    "voice": "vo_adv_1125001_029",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
