[
  {
    "type": "background",
    "bg_id": "500164"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "純跟{0}走在岸邊，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n時時注意在海裡玩耍的孩子們的狀況。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "呼……",
    "voice": "vo_adv_1136003_000",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "真是和平呢。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "剛才受到少年跟小咲戀邀請時，",
    "voice": "vo_adv_1136003_001",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我原本還有些擔心。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n畢竟自從小咲戀辭去【王宮騎士團】一職後，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我們就沒見過幾次面。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "就算見到面，",
    "voice": "vo_adv_1136003_002",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "也都是基於公會長的身分，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n像這樣處於跟公會無關的立場時，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我不禁擔心起彼此",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "會不會無法好好對談。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯。",
    "voice": "vo_adv_1136003_003",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "是啊。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "小咲戀很溫柔，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我很清楚",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "她不會在意那種事。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "就曾經浮現過那樣的想法啦。",
    "voice": "vo_adv_1136003_004",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n……就算是我，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "有時也會感到膽怯。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "她會不會是因為辭去【王宮騎士團】的工作，",
    "voice": "vo_adv_1136003_005",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n不得已",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "才開辦【咲戀育幼院】……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我曾經有過這樣的疑慮。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不過，",
    "voice": "vo_adv_1136003_006",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "親眼看到小咲戀跟育幼院的孩子們後，我總算明白了。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n小咲戀",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "是有明確的目的才會獨立，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n她是為了孩子們在努力。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "而孩子們",
    "voice": "vo_adv_1136003_007",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "也都很喜歡小咲戀，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n彼此帶著笑容互相幫助……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n小咲戀當時的選擇是正確的，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "而我這時才明白這點。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "今天，",
    "voice": "vo_adv_1136003_008",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "能來這裡真是太好了。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我也要感謝【王宮騎士團】的大家才行。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "遊客",
    "words": "有魔物──！",
    "voice": "vo_adv_1136003_009",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "遊客",
    "words": "有魔物出現了──！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "少年！",
    "voice": "vo_adv_1136003_010",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n這位先生，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我想知道詳細狀況。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "遊客",
    "words": "好、",
    "voice": "vo_adv_1136003_011",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "遊客",
    "words": "好……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "遊客",
    "words": "聽說有人在水裡看見了魔物。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "遊客",
    "words": "\\n所以你們也快點去避難吧。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "純！",
    "voice": "vo_adv_1136003_012",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "大家呢？",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "小咲戀，",
    "voice": "vo_adv_1136003_013",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "妳來得正好。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n可以點名一下孩子們是否都在嗎？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "好、",
    "voice": "vo_adv_1136003_014",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "好……",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "咲戀媽媽！",
    "voice": "vo_adv_1136003_015",
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "太好了，",
    "voice": "vo_adv_1136003_016",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "原來你在那裡啊！",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "其他人呢？",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "妹妹她……",
    "voice": "vo_adv_1136003_017",
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "我妹妹她不見了！",
    "voice": null,
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "！？",
    "voice": "vo_adv_1136003_018",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "看那裡！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n那個游泳圈是",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "剛才沙灘搶旗的獎品……！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "糟糕，",
    "voice": "vo_adv_1136003_019",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "游泳圈被沖走了！",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "得快點去救她才行！",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我這就──",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "等等。",
    "voice": "vo_adv_1136003_020",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我希望小咲戀留下來陪這些孩子。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n那孩子由我來救。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "不過，",
    "voice": "vo_adv_1136003_021",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "穿著那身鎧甲……",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這確實不是",
    "voice": "vo_adv_1136003_022",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "適合游泳的打扮……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n但可以靠泳技克服！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "純……！",
    "voice": "vo_adv_1136003_023",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "她走掉了。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n不過她好厲害，",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "竟然真的穿著鎧甲在游泳……",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "純好厲害……",
    "voice": "vo_adv_1136003_024",
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "咲戀媽媽──！",
    "voice": "vo_adv_1136003_025",
    "unit_id": 213
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "已經沒事了。",
    "voice": "vo_adv_1136003_026",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n好了，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "快過去找小咲戀吧。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "嗯！",
    "voice": "vo_adv_1136003_027",
    "unit_id": 213
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "純，謝謝妳！",
    "voice": null,
    "unit_id": 213
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "謝謝妳，純……",
    "voice": "vo_adv_1136003_028",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "後面！",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "水裡面有東西！",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "少年！？",
    "voice": "vo_adv_1136003_029",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "怎麼會！{0}！",
    "voice": "vo_adv_1136003_030",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "大哥哥被抓住了！",
    "voice": "vo_adv_1136003_031",
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "好可怕……",
    "voice": "vo_adv_1136003_032",
    "unit_id": 213
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "唔……",
    "voice": "vo_adv_1136003_033",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "成功救回孩子讓我大意了……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n是我害了少年……！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "小咲戀先帶孩子們去避難！",
    "voice": "vo_adv_1136003_034",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "動作快！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我知道了。",
    "voice": "vo_adv_1136003_035",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n純……",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "這裡就交給妳囉。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n{0}就麻煩妳了。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "好……",
    "voice": "vo_adv_1136003_036",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我當然會救他回來。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這也是我一時輕忽大意所招致的狀況……",
    "voice": "vo_adv_1136003_037",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n無論如何我都會救你回來，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "少年！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "background",
    "bg_id": "500160"
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "那個像魚又像人的模樣……",
    "voice": "vo_adv_1136003_038",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "對了，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這個魔物",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n或許就是流傳在這個沙灘上的人魚傳說的起源……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "糟糕！",
    "voice": "vo_adv_1136003_039",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "牠居然抓著少年潛進海裡……！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "要穿著鎧甲跟水生魔物進行水中戰的話，",
    "voice": "vo_adv_1136003_040",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "應該不能用平時的戰鬥方式。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n可是，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "少年不會游泳……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "現在沒時間思考了！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n這麼一來，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "方法就只有一個……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "無論有多熱，",
    "voice": "vo_adv_1136003_041",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "無論有多重，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我一直堅守著家訓，不曾在人前脫下的這身鎧甲……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "如果是為了拯救少年的性命……",
    "voice": "vo_adv_1136003_042",
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "根本就……",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "無須猶豫！",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "少年，",
    "voice": "vo_adv_1136003_043",
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我現在就去救你！",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "still",
    "still_id": "113600301"
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "找到了！",
    "voice": "vo_adv_1136003_044",
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "少年！　",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "唔……",
    "voice": "vo_adv_1136003_045",
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "海中不愧是水生魔物的地盤，",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n無法用平時的戰鬥方式解決嗎。",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "但是，",
    "voice": "vo_adv_1136003_046",
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "先不說我，少年並不會游泳……",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "只能進行短期決戰了！　",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "糟糕，",
    "voice": "vo_adv_1136003_047",
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "是太過著急導致判斷力變遲鈍了嗎……",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n再這樣下去，會被魔物擊中……",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "但是，",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "即使如此！　",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我也一定",
    "voice": "vo_adv_1136003_048",
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "會拯救他……！",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n不管我會有什麼樣的下場！　",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "still",
    "still_id": "113600302"
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這股力量……",
    "voice": "vo_adv_1136003_049",
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "是少年的力量嗎！",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n在這種狀況下，",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "依然提供我助力……",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "沒有比這個更可靠的了……！　",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "身體好輕盈！",
    "voice": "vo_adv_1136003_050",
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "簡直就像是沒有水阻力一樣！",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我現在可以使出比平時更強的力量……！　",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "吃我……",
    "voice": "vo_adv_1136003_051",
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這招吧！　",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "background",
    "bg_id": "500160"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "噗哈……",
    "voice": "vo_adv_1136003_052",
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你沒事吧，",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "少年？",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "太好了……",
    "voice": "vo_adv_1136003_053",
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "要道謝的是我才對。",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n真的很謝謝你。",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "喔……",
    "voice": "vo_adv_1136003_054",
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "抱、",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "抱歉……",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "安心下來後，突然很難為情……",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "對、",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "對了！",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "鎧甲……",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我的鎧甲呢……",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "鎧甲我幫妳收起來了。",
    "voice": "vo_adv_1136003_055",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "話說回來，還真是猛烈的攻擊呢。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n我從海邊看見了",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "好高的水柱，",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "真是驚人呢。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "小咲戀！",
    "voice": "vo_adv_1136003_056",
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "辛苦了，",
    "voice": "vo_adv_1136003_057",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "純。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n大家都去避難了，",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "所以妳不用怕被誰看見。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "謝謝妳，",
    "voice": "vo_adv_1136003_058",
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "妳幫了大忙。",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n真不愧是小咲戀。",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "這點小事沒什麼的。",
    "voice": "vo_adv_1136003_059",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我們認識很久了不是？",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "啊，",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我是不是也不要看純的臉會比較好呢？",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "是我自己決定脫下鎧甲的。",
    "voice": "vo_adv_1136003_060",
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n小咲戀不需要在意。",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "而且小咲戀",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "從以前到現在也看過很多次了不是嗎。",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "呵呵，",
    "voice": "vo_adv_1136003_061",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "確實是那樣沒錯。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "對了，",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "託純的福，",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "沙灘上的人都沒有受傷。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n孩子們也都平安無事喔。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "真的很謝謝妳，",
    "voice": "vo_adv_1136003_062",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "純。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "要道謝的是我才對。",
    "voice": "vo_adv_1136003_063",
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n沙灘上的人之所以都沒有受傷，",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "是因為有小咲戀的指示。",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不過，",
    "voice": "vo_adv_1136003_064",
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "今天應該沒辦法繼續在沙灘上玩了。",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n雖然對孩子們很不好意思……",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "呵呵……",
    "voice": "vo_adv_1136003_065",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "他們",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "看到純挺身對抗魔物的模樣，",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n都說妳很帥氣喔。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n我認為，",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "今天的事肯定已經成為他們的美好回憶了。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "真是那樣就好了……",
    "voice": "vo_adv_1136003_066",
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "！",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你是怎麼了，少年？",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n看你走路搖搖晃晃的……",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "難不成你有哪裡受傷了……！？",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "沒事的，",
    "voice": "vo_adv_1136003_067",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "他沒受傷。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "肯定是累了吧。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n找個地方讓他休息就行……",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "對了，",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "去你們剛才幫忙的海之家休息如何？",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "現在應該是沒有任何客人。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "說得也是……",
    "voice": "vo_adv_1136003_068",
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "好，",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "就那麼做。",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n小咲戀去陪孩子們吧。",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "他們肯定覺得很害怕。",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "好，",
    "voice": "vo_adv_1136003_069",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我會的。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n……他",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "就交給妳囉。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "純。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "那麼，",
    "voice": "vo_adv_1136003_070",
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "小咲戀。",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "差不多可以把鎧甲還給我了吧？",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "唉喲，",
    "voice": "vo_adv_1136003_071",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "有什麼好著急的啦。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n反正妳扶著{0}",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "也沒辦法穿吧？",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "鎧甲",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我待會再送去給妳。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "妳、",
    "voice": "vo_adv_1136003_072",
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "妳是要我繼續維持這身打扮嗎？",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不，",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "可是……",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "妳放心吧。",
    "voice": "vo_adv_1136003_073",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "沙灘上的人",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "都去避難了，",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n我認為你們應該不會遇到其他人喔？",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "而且，",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "在沙灘上，",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "比起穿著鎧甲走路，",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "這樣更加自然吧？",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "好吧，",
    "voice": "vo_adv_1136003_074",
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "既然小咲戀這麼說……",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我明白了。",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我會負責帶他到海之家休息。",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "晚點見。",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "脫去了鎧甲後，肌膚相貼所傳來的體溫，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n讓純懷著成功保護好{0}的真實感，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n一步一步走向剛才的店家。",
    "voice": null,
    "unit_id": null
  }
]
