    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "試著約她來鎮上玩吧？",
    "voice": null,
    "unit_id": 113812
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
