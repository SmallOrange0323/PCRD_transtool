  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在神殿幫忙的工作也告了一段落，正打算回去的\\n{0}與鈴莓――",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不好意思，",
    "voice": "vo_adv_1121004_000",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我現在要去換衣服，",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n請在這裡等我一下。",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "天也快暗下來了，",
    "voice": "vo_adv_1121004_001",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "得快點回去育幼院……",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "呃，",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "奇怪？　",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "突然有道好亮的光……",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "呀啊！",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "background",
    "bg_id": "510390"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "春假的某一天。被咲戀找去的{0}，\\n正在前往咲戀的家。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "啊！　",
    "voice": "vo_adv_1121004_002",
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "新年快樂。",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "咲戀小姐～",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "他來囉～！",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "新年快樂，",
    "voice": "vo_adv_1121004_003",
    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "突然把你找來真是抱歉呢。",
    "voice": null,
    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "其實",
    "voice": null,
    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我有事想請你幫忙。",
    "voice": null,
    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "今天",
    "voice": "vo_adv_1121004_004",
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "佐佐木家的親戚們都會聚在一起",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "過新年。",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "但是，",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "要處理的事情很多導致人手不足……",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "所以，",
    "voice": "vo_adv_1121004_005",
    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我們在找能夠幫忙搗年糕的人。",
    "voice": null,
    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "真的非常抱歉，",
    "voice": null,
    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "可以請你幫忙嗎？",
    "voice": null,
    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "能這麼說真是幫大忙了，",
    "voice": "vo_adv_1121004_006",
    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "謝謝！",
    "voice": null,
    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "就請你",
    "voice": null,
    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "和鈴莓一起搗年糕吧，",
    "voice": null,
    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "麻煩你囉。",
    "voice": null,
    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我會用木杵",
    "voice": "vo_adv_1121004_007",
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "來敲打年糕，",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n所以翻動年糕的工作就請你幫忙了。",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "……我說，",
    "voice": "vo_adv_1121004_008",
    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "鈴莓。",
    "voice": null,
    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "雖然是我說要讓你們做做看的，",
    "voice": null,
    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "但敲木杵的工作",
    "voice": null,
    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "應該讓這傢伙來做比較好吧？",
    "voice": null,
    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不，",
    "voice": "vo_adv_1121004_009",
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我沒問題的！",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "大小姐交代的搗年糕的工作，",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我會努力去做的！",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "是、",
    "voice": "vo_adv_1121004_010",
    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "是嗎？　",
    "voice": null,
    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "唔嗯～……",
    "voice": null,
    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n妳剛才站得不是很穩，",
    "voice": null,
    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我很擔心呢……",
    "voice": null,
    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "女僕",
    "words": "咲戀小姐～！　",
    "voice": "vo_adv_1121004_011",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女僕",
    "words": "能不能請您過來一下～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "好～",
    "voice": "vo_adv_1121004_012",
    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我馬上去～！",
    "voice": null,
    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "那麼，",
    "voice": null,
    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "鈴莓就麻煩你囉。",
    "voice": null,
    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "待會見！",
    "voice": null,
    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "那麼，",
    "voice": "vo_adv_1121004_013",
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我們兩個人來練習看看吧。",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n我會用力地敲下木杵",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "哦哦哦哦哦！？",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不、",
    "voice": "vo_adv_1121004_014",
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不好意思，",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "大力揮動木杵後，就失去平衡了……",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我很高興你有這份心意，",
    "voice": "vo_adv_1121004_015",
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "但我還是希望能由我來敲木杵！",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "除了打掃之外，",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我也想在其他地方幫上咲戀小姐的忙。",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "那個，",
    "voice": "vo_adv_1121004_016",
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "或許我會笨手笨腳地出錯……",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "但感覺只要跟你在一起，",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "就不會有問題的。",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n離正式開始還有一點時間，",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "在那之前一定能夠辦到的！",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "女僕",
    "words": "――接下來",
    "voice": "vo_adv_1121004_017",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女僕",
    "words": "就請各位品嚐在大家面前",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女僕",
    "words": "\\n現場搗好的年糕吧。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女僕",
    "words": "那麼，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女僕",
    "words": "麻煩了！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "結果，",
    "voice": "vo_adv_1121004_018",
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "練習時一直失敗……",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "但、",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "但我會在",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "正式上場時努力炒熱氣氛的！　",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "要上囉，",
    "voice": "vo_adv_1121004_019",
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "一～二！　",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "敲啊！　",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "敲啊！",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "敲啊！　",
    "voice": "vo_adv_1121004_020",
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "敲啊！",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "太、",
    "voice": "vo_adv_1121004_021",
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "太好了！　",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "進行得很順利！",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "可是，",
    "voice": null,
    "unit_id": 102531
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "為了讓氣氛更熱烈，",
