  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "幫搗年糕組合",
    "voice": null,
    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "留下了不錯的紀念呢。",
    "voice": null,
    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n那接下來就三個人一起――",
    "voice": null,
    "unit_id": 102832
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好，",
    "voice": "vo_adv_1121004_050",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "辛苦了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "如何？　",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "用你原本的記憶作成的夢感覺如何？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你和鈴莓",
    "voice": "vo_adv_1121004_051",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "就算在那邊也一起做了很多事情呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你們的個性",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "或許還滿合的呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我是不清楚鈴莓對你有什麼想法，",
    "voice": "vo_adv_1121004_052",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n但她肯定很仰慕你，也很依賴你吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "所以，",
    "voice": "vo_adv_1121004_053",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你要好好回應她的信賴喔。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不過，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "如果是你的話，應該自然而然地就會做到這一點了吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500552"
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "唔～嗯……",
    "voice": "vo_adv_1121004_054",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "咦，",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我們",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "睡著了嗎……？",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n而且，",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "還夢到了奇妙的夢……",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "沒想到在夢裡也度過了快樂的新年",
    "voice": "vo_adv_1121004_055",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n這也是",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "一種啟示嗎……？",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "……啊，",
    "voice": "vo_adv_1121004_056",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "對了。",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "回育幼院後，",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n要不要做年糕給孩子們吃？",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "畢竟連夢裡都出現了，",
    "voice": "vo_adv_1121004_057",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我想一定是很值得慶祝的事。",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "兩個人一起做很多年糕，",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "讓大小姐也嚇一跳吧！",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "呵呵，",
    "voice": "vo_adv_1121004_058",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "那回去的時候",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "就去買做年糕的材料吧！",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n也得去買調味料，",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "砂糖、醬油、",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "黃豆粉、",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "海苔……",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "得準備很多種才行。",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "就像在夢裡一樣，兩人一起搗年糕，",
    "voice": "vo_adv_1121004_059",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "讓孩子們開心一下吧！",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在從神殿回去的路上，鈴莓感覺很愉快地笑著，\\n而{0}就這樣握起她的手，和她一起去購物了。",
    "voice": null,
    "unit_id": null
  }
]
