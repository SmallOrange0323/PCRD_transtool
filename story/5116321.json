[
  {
    "type": "dialogue",
    "name": "栞",
    "words": "這股壓迫感……",
    "voice": "vo_adv_5116321_000",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "大家要小心。",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "這和以往的氛圍完全不一樣。",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "牠之前應該是下意識地壓抑住自己的力量吧。",
    "voice": "vo_adv_5116321_001",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n如今似乎因為失去理智，",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "進而解放出潛能。",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "要是直接中招，勢必會受到極大的傷害。",
    "voice": "vo_adv_5116321_002",
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n以牠那股蠻力再加上靈活度，",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "我們必須想個辦法……",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "如果能降低牠的速度，",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "削弱牠的力量就好了。",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不過，",
    "voice": "vo_adv_5116321_003",
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "牠似乎是因為吃了果實才使力量提升，",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這樣一來蛀牙就變得更嚴重了。",
    "voice": null,
    "unit_id": 125311
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "是啊。",
    "voice": "vo_adv_5116321_004",
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我們趕緊阻止大猿吧。",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n這也是為了避免引起",
    "voice": null,
    "unit_id": 125411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "不必要的衝突。",
    "voice": null,
    "unit_id": 125411
  }
]
