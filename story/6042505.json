  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "她或許接受過某種",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "這方面的訓練？",
