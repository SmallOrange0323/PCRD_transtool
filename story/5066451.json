  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "呼……",
    "voice": "vo_adv_5066451_000",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "呼……",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "真是的……",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這個扭曲的時間也終於要結束了呢……",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "雖然是妳自作自受，",
    "voice": "vo_adv_5066451_001",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不過以祈梨來說很努力了呢。",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "什麼！",
    "voice": "vo_adv_5066451_002",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "歸根究柢，",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "還不是因為嘉夜夜推了我才變成這樣的！",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "打從一開始祈梨不要進去那個房間，",
    "voice": "vo_adv_5066451_003",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n不就不會惹上這種麻煩了嗎？",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "唔……！",
    "voice": "vo_adv_5066451_004",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "過、",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "過去的事就不要追究了。",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n我們現在要盡早",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "結束這個混亂的狀況啦。",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "也是。",
    "voice": "vo_adv_5066451_005",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "所以，",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n就麻煩你再稍微",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "陪我們一下囉。",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "萬事拜託囉！",
    "voice": "vo_adv_5066451_006",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "小哥！",
    "voice": null,
    "unit_id": 116511
  }
]
