    "type": "dialogue",
    "name": "媞雅",
    "words": "我說啊。",
    "voice": "vo_adv_9006722_029",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n別那麼心急嘛。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "……",
    "voice": "vo_adv_9006722_030",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "那個賦予我",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "「[rub:提示]部分權限[/rub]」的傢伙。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\nLoA原本的",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "世界管理者──",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "超AI，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "米奈娃。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n那傢伙，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "早就預見到事情會變成這樣了。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "……然後。",
    "voice": "vo_adv_9006722_031",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n按照那傢伙的說法──",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "background",
    "bg_id": "501640"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "是誰？",
    "voice": "vo_adv_9006722_032",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "──妳知道",
    "voice": "vo_adv_9006722_033",
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "\\n什麼是「世界線」",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "嗎？",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "什麼！？",
    "voice": "vo_adv_9006722_034",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n……等等，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "妳突然在說些什麼啊……",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "當發生足以撼動世界根基的",
    "voice": "vo_adv_9006722_035",
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "重大「事件」時。",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "\\n在名為時間軸的大樹上，",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "就會產生「分歧」。",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "這就稱為",
    "voice": "vo_adv_9006722_036",
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "「世界線分歧」",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "。",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "\\n就像是在玩遊戲時，",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "建立備份一樣呢。",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "……很久以前。",
    "voice": "vo_adv_9006722_037",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n當【破曉之星】",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "敗給霸瞳皇帝，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n而妳被駭入時──",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "就像是分裂成「發生了『禁錮』的世界」，",
    "voice": "vo_adv_9006722_038",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n以及「沒有發生『禁錮』的世界」嗎？",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "米奈娃。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "是的。",
    "voice": "vo_adv_9006722_039",
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "\\n",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "這就是在這個世界",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "誕生「[rub:妳]認知修正[/rub]」，",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "之前所發生的事。",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "\\n",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "……初次見面呢，",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "「媞雅」。",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "……初次見面，",
    "voice": "vo_adv_9006722_040",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "世界的管理者小姐。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "雖然妳看起來氣色不太好，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "妳真的沒問題嗎？",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "並不能",
    "voice": "vo_adv_9006722_041",
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "說是沒問題。",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "\\n畢竟被霸瞳皇帝和幻境龍后",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "反覆傷害了好幾次，",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "\\n而且一直沒能得到維護。",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "原本……",
    "voice": "vo_adv_9006722_042",
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "我也想幫助{0}",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "\\n以及諾維姆一行人的。",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "\\n",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "但現在卻必須",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "由妳代勞才行。",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "而到那時……",
    "voice": "vo_adv_9006722_043",
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "\\n世界將會再次",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "產生分歧吧。",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "什、",
    "voice": "vo_adv_9006722_044",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "什麼……？",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n不，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "妳給我等一下──",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "什麼「代勞」啊？",
    "voice": "vo_adv_9006722_045",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n妳對初次見面的人，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "到底在說些什麼啊？",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n我可是",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "保持中立、一切平等的喔？",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "……呵呵。",
    "voice": "vo_adv_9006722_046",
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "我知道的。",
    "voice": "vo_adv_9006722_047",
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "\\n妳一定",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "會答應。",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "\\n為了拯救他們──",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "為了救[rub:・]他[/rub]，",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "妳一定會出手相助。",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "唔……！？",
    "voice": "vo_adv_9006722_048",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n妳、妳這個",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "[rub:規格]性能[/rub]怪物，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "演算能力居然這麼差勁……？",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n是說，他是指誰啊他……！",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "……算、",
    "voice": "vo_adv_9006722_049",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "算了……",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "不過呢？",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "妳說的話……",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "我還是會聽的。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "至於要不要幫忙，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "等聽完再由我決定……",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "我會公正地判斷。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "好的。",
    "voice": "vo_adv_9006722_050",
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "\\n謝謝妳。",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "剛才妳所提到的，",
    "voice": "vo_adv_9006722_051",
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "與霸瞳皇帝一戰所引發的",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "「分歧」時。",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "\\n那時候的我，",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "正在準備執行某個重要的程序。",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "某個程序……？",
    "voice": "vo_adv_9006722_052",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "是的。",
    "voice": "vo_adv_9006722_053",
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "\\n為了成為「完全的存在」，",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "對抗霸瞳皇帝，",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "並實現願望。",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "\\n那個程序名為──",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "「公主連結程序」。",
    "voice": "vo_adv_9006722_054",
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "沒錯。",
    "voice": "vo_adv_9006722_055",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n當時",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "因為霸瞳皇帝的阻撓而未能順利完成的程序，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n現在就在我手上。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "……就算是米奈娃，",
    "voice": "vo_adv_9006722_056",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "把這麼重要的東西交給我保管，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n恐怕也得付出不小的代價吧。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
