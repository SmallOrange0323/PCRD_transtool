    "name": "媞雅",
    "words": "……話說。",
    "voice": "vo_adv_9006722_063",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n其實不用特地問，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "你已經有屬意的對象了吧？",
