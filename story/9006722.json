    "name": "媞雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "就是那個",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "心意已決的對象。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "那麼，",
    "voice": "vo_adv_9006722_064",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "決定是那孩子了嗎？",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
