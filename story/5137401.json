[
  {
    "type": "background",
    "bg_id": "501501"
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "やっ。",
    "voice": "vo_adv_5085401_000",
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "\\n少年、",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "調子はどうだい？",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "ん？　",
    "voice": "vo_adv_5085401_001",
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "この姿？",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "たまにはアタシもイメチェンしてみようかなと思って。",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "\\nなんて冗談冗談。",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "この力がいつか、",
    "voice": "vo_adv_5085401_002",
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "正しい時に、",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "正しい想いで使われるように。",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "アタシも手を貸そうと思ってね。",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "だから少年。",
    "voice": "vo_adv_5085401_003",
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "\\nキミも、",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "遠慮なくアタシを頼ってほしい。",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "『絆の力』に",
    "voice": "vo_adv_5085401_004",
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "アタシも加えてくれると、",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "ラビリスタ",
    "words": "うれしいな。",
    "voice": null,
    "unit_id": 121211
  }
]
