    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你喜歡怎樣的煙火？",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我懂～",
    "voice": "vo_adv_6019209_001",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我也很喜歡耶！　",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "因為有很多華麗煙火，",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "感覺太",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "適合我了。",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "在這座島上會看到怎樣的煙火，",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "真令人期待！",
