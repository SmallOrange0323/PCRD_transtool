  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你說為什麼……",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "因為說到晚上的海灘，",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "就一定會放煙火嘛！",
