  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "也快結束了呢。",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這次就連我",
    "voice": "vo_adv_5085411_001",
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "都要火力全開向前衝呢。",
    "voice": null,
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這次戰鬥結束後，",
    "voice": null,
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我要過上好一段吃飽睡、睡飽吃的日子，",
    "voice": null,
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "絕對不要來把我叫醒喔。",
    "voice": null,
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "不行啦～？",
    "voice": "vo_adv_5085411_002",
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "不能說「這次戰鬥結束後」",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這種話啦。",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "別計較這麼多啦。",
    "voice": "vo_adv_5085411_003",
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "總之我就是想休息！",
    "voice": null,
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這次戰鬥結束後，",
    "voice": null,
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我一定要吃一堆美味食物，然後睡個過癮！",
    "voice": null,
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "對了，",
    "voice": null,
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就來吃之前特地藏起來的",
    "voice": null,
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "私房甜點好了～♪",
    "voice": null,
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……啊，",
    "voice": "vo_adv_5085411_004",
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "妳說的私房甜點……",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "該不會是……",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗯？",
    "voice": "vo_adv_5085411_005",
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳怎麼了，貪吃佩可？",
    "voice": null,
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n妳為什麼把視線從我身上別開了？",
    "voice": null,
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "喂，",
    "voice": null,
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "看著我啊！？",
    "voice": null,
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "喂喂，妳們兩位。",
    "voice": "vo_adv_5085411_006",
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n不到最後一刻，可是不能鬆懈的唷～？",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "想要一起暢飲勝利美酒，",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "也是要等到全部都結束以後呀。",
    "voice": null,
    "unit_id": 121211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我、",
    "voice": "vo_adv_5085411_007",
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我知道啦……",
    "voice": null,
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那麼，",
    "voice": "vo_adv_5085411_008",
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "就火力全開地上吧～！",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n幫我們打氣吧！",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n拜託囉！",
    "voice": null,
    "unit_id": 121011
  },
  {
    "type": "dialogue",
    "name": "{0}",
    "words": "──大家，",
    "voice": "vo_adv_5085411_009",
    "unit_id": 121111
  },
  {
    "type": "dialogue",
    "name": "{0}",
    "words": "一起加油到最後吧！",
    "voice": null,
    "unit_id": null
  },
