    "name": "凜",
    "words": "的樣子吧。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "啊，",
    "voice": "vo_adv_5035003_041",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "大家。",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "真是的。",
    "voice": "vo_adv_5035003_042",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n明明練習不夠就讓她們去辦快閃演唱會的也是你，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "還說什麼很高興妳們振作起來了——",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "沒人這樣搞的吧？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "長的一臉可愛……",
    "voice": "vo_adv_5035003_043",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "也不太可愛，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "長的一臉蠢樣，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "做事卻很斯巴達呢，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這傢伙！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "皮喵太",
    "words": "皮喵～！？",
    "voice": "vo_adv_5035003_044",
    "unit_id": 4411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "凱留小姐。",
    "voice": "vo_adv_5035003_045",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n不可以使用暴力。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "那、",
    "voice": "vo_adv_5035003_046",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "那個啊！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "話說回來……",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "我們有一件事，",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "想要拜託【美食殿堂】的大家。",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好喔，",
    "voice": "vo_adv_5035003_047",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是什麼事呢？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "肚子餓了的話，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "馬上就能準備吃飯囉☆",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "不是的。",
    "voice": "vo_adv_5035003_048",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "可不可以……",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "在這個村裡多待幾天呢？",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "咦？",
    "voice": "vo_adv_5035003_049",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "皮喵太",
    "words": "皮！？",
    "voice": "vo_adv_5035003_050",
    "unit_id": 4411
  },
  {
    "type": "dialogue",
    "name": "皮喵太",
    "words": "皮、",
    "voice": "vo_adv_5035003_051",
    "unit_id": 4411
  },
  {
    "type": "dialogue",
    "name": "皮喵太",
    "words": "皮喵！",
    "voice": null,
    "unit_id": 4411
  },
  {
    "type": "dialogue",
    "name": "皮喵太",
    "words": "\\n",
    "voice": null,
    "unit_id": 4411
  },
  {
    "type": "dialogue",
    "name": "皮喵太",
    "words": "皮喵皮喵！",
    "voice": null,
    "unit_id": 4411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "真的可以嗎？",
    "voice": "vo_adv_5035003_052",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n但是皮喵太牠，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "好像很反對的樣子呢……",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "的確，",
    "voice": "vo_adv_5035003_053",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "我們也都知道距離甄選的日子已經不遠了。",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "可是，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "我們……",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "……嗯。",
    "voice": "vo_adv_5035003_054",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n若就這樣結束，",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "我們會沒辦法向前邁進。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "我們想再一次、",
    "voice": "vo_adv_5035003_055",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "再一次",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n讓村裡的人們看看",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "更好的「偶像」是什麼。",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n所以……！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "皮喵太",
    "words": "皮、",
    "voice": "vo_adv_5035003_056",
    "unit_id": 4411
  },
  {
    "type": "dialogue",
    "name": "皮喵太",
    "words": "皮喵……",
    "voice": null,
    "unit_id": 4411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "儘管皮喵太大人",
    "voice": "vo_adv_5035003_057",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "似乎相當擔心的模樣……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "既然主人都這麼說了。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我們的話，",
    "voice": "vo_adv_5035003_058",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "也OK喔～！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n而且這個村子的蜂蜜料理",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "也很好吃嘛～♪",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這個嘛，",
    "voice": "vo_adv_5035003_059",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "隨妳們高興就好？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n為了讓妳們能專心練習，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n至少會替妳們準備好食物的啦。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "確實在日程上，",
    "voice": "vo_adv_5035003_060",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "已經沒有多少的餘裕了……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "然而若能減輕馬車的重量，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "或行駛原先想避開的危險小徑，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n儘管影響甚微，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但或許能夠",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "提早一點點抵達繆思小鎮。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "哇啊，",
    "voice": "vo_adv_5035003_061",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "妳說真的嗎？",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "可可蘿雖然還這麼小，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "但是真的很可靠呢～",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "真的。",
    "voice": "vo_adv_5035003_062",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n真想讓卯月也好好跟人家學習一下呢，",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "譬如說收拾整理這方面。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "啊、",
    "voice": "vo_adv_5035003_063",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "啊哈哈哈……",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "好～！",
    "voice": "vo_adv_5035003_064",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n既然都這麼決定了……",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "那我們就趕快再繼續練習吧～！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "卯月、凜",
    "words": "嗯！",
    "voice": "vo_adv_5035003_065",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "哇，",
    "voice": "vo_adv_5035003_066",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "好大聲啊！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n剛剛的是誰？",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n島村村？",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "才、",
    "voice": "vo_adv_5035003_067",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "才不是我啦～！？",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "……抱歉。",
    "voice": "vo_adv_5035003_068",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "剛剛那個，",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "是我。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊哈哈☆",
    "voice": "vo_adv_5035003_069",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n雖然不能吃太撐，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但是也不能吃太少唷，凜。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "動作也會變得遲鈍嘛！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "嗯……",
    "voice": "vo_adv_5035003_070",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "妳說的對。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n我會注意的。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那麼還請各位",
    "voice": "vo_adv_5035003_071",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "來用餐吧。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n然後",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在用完餐後……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "皮喵太",
    "words": "皮喵！",
    "voice": "vo_adv_5035003_072",
    "unit_id": 4411
