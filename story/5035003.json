  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "該不會，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是我\\n想一笑置之造成反效果了……",
