    "words": "……嗯。",
    "voice": "vo_adv_5098005_002",
    "unit_id": 102012
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n你好好休息，",
    "voice": null,
    "unit_id": 102012
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "下次再一起玩吧。",
    "voice": null,
    "unit_id": 102012
  },
  {
    "type": "dialogue",
    "name": "小繆",
    "words": "繆。",
    "voice": "vo_adv_5098005_003",
    "unit_id": 8411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "那麼，",
    "voice": "vo_adv_5098005_004",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "鏡華。",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n昨日、",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "向栞姐姐借的那些……",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "是專業書籍",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "來著？",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n妳已經看過了嗎？",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "都看過了。",
    "voice": "vo_adv_5098005_005",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "有什麼發現嗎？",
    "voice": "vo_adv_5098005_006",
    "unit_id": 102012
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "……「喚來幸福的生物」是",
    "voice": "vo_adv_5098005_007",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "來自另一個世界的存在。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "而且",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "當牠耗盡力量之後…………",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "…………",
    "voice": "vo_adv_5098005_008",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "……據說會",
    "voice": "vo_adv_5098005_009",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "從這個世界上消失。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "禊＆美美",
    "words": "……！",
    "voice": "vo_adv_5098005_010",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "……意思是說牠會死掉？",
    "voice": "vo_adv_5098005_011",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "或許是，",
    "voice": "vo_adv_5098005_012",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "或許不是。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "不過變虛弱後",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "結果會消失，似乎是確定的。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "總之只要不使用力量，",
    "voice": "vo_adv_5098005_013",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "暫時就不要緊……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "但那樣只是應付一時，",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "並非解決的方法。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n要解決問題……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "……只能將小繆送回",
    "voice": "vo_adv_5098005_014",
    "unit_id": 102012
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "牠原本所在的世界？",
    "voice": null,
    "unit_id": 102012
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "……嗯。",
    "voice": "vo_adv_5098005_015",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n那麼一來牠應該不會消失，",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "能夠一直健健康康的。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "這是栞姐姐說過的方法呢。",
    "voice": "vo_adv_5098005_016",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "不管怎樣，",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "我們都要和小繆…………",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "…………",
    "voice": "vo_adv_5098005_017",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "小繆",
    "words": "繆？",
    "voice": "vo_adv_5098005_018",
    "unit_id": 8411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "……不過，",
    "voice": "vo_adv_5098005_019",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我們從一開始",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "就打算送牠回家。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "只是那一刻來臨了而已。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "…………只是",
    "voice": "vo_adv_5098005_020",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "這樣而已。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "小繆",
    "words": "繆～？",
    "voice": "vo_adv_5098005_021",
    "unit_id": 8411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "說、",
    "voice": "vo_adv_5098005_022",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "說得對。",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "嗯，",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "就是這樣沒錯。",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
