  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "……嗯。",
    "voice": "vo_adv_5098005_024",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n小繆也還沒恢復精神……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "而且喔？",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "回去好像要看時機。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "當我們的世界與",
    "voice": "vo_adv_5098005_025",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "小繆的世界，",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "這兩個平常各自獨立的世界相連的時機……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "書上寫到，必須看準那扇門扉打開的瞬間。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "那就是說，",
    "voice": "vo_adv_5098005_026",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "在那個恰到好處的時機來臨前，",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n我們可以在一起囉。",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "應該是這樣。",
    "voice": "vo_adv_5098005_027",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n我接下來會試著調查",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "關於時機的詳細資料。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "如果有可以幫忙的地方就告訴美美喔。",
    "voice": "vo_adv_5098005_028",
    "unit_id": 102012
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102012
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "美美也會努力的。",
    "voice": null,
    "unit_id": 102012
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "好～",
    "voice": "vo_adv_5098005_029",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊也要努力囉～！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n這是為了小繆嘛！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "……對呀。",
    "voice": "vo_adv_5098005_030",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "必須為了小繆",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "好好努力。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "鏡華……",
    "voice": "vo_adv_5098005_031",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "……大家一起",
    "voice": "vo_adv_5098005_032",
    "unit_id": 102012
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "加油吧。",
    "voice": null,
    "unit_id": 102012
  },
  {
    "type": "dialogue",
    "name": "小繆",
    "words": "繆……",
    "voice": "vo_adv_5098005_033",
    "unit_id": 8411
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "當【小小甜心】的三人在調查小繆回去的時刻之際……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}回想起拉比林斯達前幾天意味深長的態度，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n獨自前往可麗餅店……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}看著「臨時歇業」的招牌……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n發現招牌背面貼著一張紙。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達的留言",
    "words": "「致少年。",
    "voice": "vo_adv_5098005_034",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達的留言",
    "words": "\\n我突然有點私事要辦，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達的留言",
    "words": "會離開蘭德索爾幾天。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達的留言",
    "words": "\\n如果你想念我的可麗餅",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達的留言",
    "words": "而跑來見我，那抱歉喔。」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達的留言",
    "words": "「如果",
    "voice": "vo_adv_5098005_035",
    "unit_id": null
