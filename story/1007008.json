  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}在散步的時候，\\n宮子一臉驚慌地飄了過來。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "不好了──！出大事了喲──！重大事件來的──！",
    "voice": "vo_adv_1007008_000",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "不論去哪一間店，都買不到布丁了～",
    "voice": "vo_adv_1007008_001",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n布丁從城鎮上消失了喲～",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "為什麼布丁這麼受歡迎來的～",
    "voice": "vo_adv_1007008_002",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n每家店都賣光光來的～",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子超想吃布丁來的！",
    "voice": "vo_adv_1007008_003",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n你快想想辦法來的！！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "哇，好刺眼啊～",
    "voice": "vo_adv_1007008_004",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n這個光……和之前一樣來的～！？",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "嗚哇～～來的～～！",
    "voice": "vo_adv_1007008_005",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "background",
    "bg_id": "510090"
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "布丁消失了喲──！",
    "voice": "vo_adv_1007008_006",
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "現在布丁好像大流行來的～！",
    "voice": "vo_adv_1007008_007",
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "不管是超市還是便利商店，每間店都買不到布丁來的……",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "……現在流行布丁減肥法嗎？",
    "voice": "vo_adv_1007008_008",
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "吃布丁怎麼可能會瘦來的──！",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n隨著媒體起舞，簡直是笨蛋來的──！",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子無法忍耐──",
    "voice": "vo_adv_1007008_009",
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "現在趕快準備好布丁給宮子來的──！",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子等不了──！",
    "voice": "vo_adv_1007008_010",
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n現在就想吃布丁來的──！",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "這樣的話……",
    "voice": "vo_adv_1007008_011",
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "你做布丁給宮子吧～",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n買不到布丁的話，我們自己做就好了喲～♪",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "background",
    "bg_id": "510080"
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "就決定來做布丁吧～♪",
    "voice": "vo_adv_1007008_012",
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "來，這是水桶來的！",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "拜託……你用常識好好想一想吧～",
    "voice": "vo_adv_1007008_013",
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "做布丁的話，不可能會有那麼多的垃圾喲～",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "這個水桶當然是布丁的容器來的！",
    "voice": "vo_adv_1007008_014",
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "說傻話也要有個限度喲～",
    "voice": "vo_adv_1007008_015",
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n你要是在走廊上罰站的話，誰負責做布丁來的～？",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "用這個水桶的話，就能做巨無霸布丁來的～♪",
    "voice": "vo_adv_1007008_016",
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "那麼開始做布丁來的！",
    "voice": "vo_adv_1007008_017",
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "主廚是我，出雲宮子來的！嗯哼♪",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "那麼你這個助手，",
    "voice": "vo_adv_1007008_018",
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n先開始打蛋～",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "啪卡啪卡有節奏地打蛋吧～♪",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "好～接下來你在這裡面，",
    "voice": "vo_adv_1007008_019",
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "加入砂糖和牛奶，然後攪拌一下吧～♪",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "感覺很不錯來的～",
    "voice": "vo_adv_1007008_020",
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "接著要做焦糖來的！",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子負責加油來的～♪",
    "voice": "vo_adv_1007008_021",
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "你負責努力做布丁來的！",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "background",
    "bg_id": "510090"
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "水桶布丁完成了喲！",
    "voice": "vo_adv_1007008_022",
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "看起來好好吃來的～♪",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "still",
    "still_id": "100700801"
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子要開動了喲～♪",
    "voice": "vo_adv_1007008_023",
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "大口吃，嚼嚼。",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "嗯，味道普普通通來的～",
    "voice": "vo_adv_1007008_024",
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n雖然店裡賣的布丁更更更～加好吃，",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "但是呢，這個也是很不錯來的～♪",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "用湯匙吃感覺不過癮來的～",
    "voice": "vo_adv_1007008_025",
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "想用鏟子挖來吃喲～",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "大口吃～嚼嚼～",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "怎麼吃都不會變少的感覺，好幸福來的～",
    "voice": "vo_adv_1007008_026",
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n布丁果然是量重於質來的～",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n水桶布丁最棒了喲～",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "你真是做得太好了。",
    "voice": "vo_adv_1007008_027",
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "辛苦了喲～♪",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "啊！你別忘了要收拾來的～",
    "voice": "vo_adv_1007008_028",
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n還有啊～冰箱空空的了喲～",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "……該不會這些雞蛋和牛奶是晚餐的材料吧？",
    "voice": "vo_adv_1007008_029",
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "嗯，不過別在意喲。",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "多虧了你，宮子才可以吃到水桶布丁來的～嚼嚼♪",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "果然你是最棒的～♪",
    "voice": "vo_adv_1007008_030",
    "unit_id": 100731
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "宮子在「那邊」也喜歡吃布丁呢。",
    "voice": "vo_adv_1007008_031",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n一點都沒變呢……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "結果還是不知道宮子變成幽靈的理由啊。",
    "voice": "vo_adv_1007008_032",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n事情沒有那麼順利呢～",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "對我來說，",
    "voice": "vo_adv_1007008_033",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n宮子是身份不明的特殊存在呢……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那也是她可愛的地方就是了♪",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "嗯，你就耐心地好好加油吧！",
    "voice": "vo_adv_1007008_034",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n那麼，下次見囉～♪",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500020"
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "啊，你終於起來了～",
    "voice": "vo_adv_1007008_035",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子也睡到剛剛呢～",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子做了很美味的夢來的──",
    "voice": "vo_adv_1007008_036",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n在夢裡面你做了水桶布丁給宮子來的～！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "你也做了一樣的夢嗎～？",
    "voice": "vo_adv_1007008_037",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n之前也有同樣的事呢。",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "真是不可思議來的……",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "那個水桶布丁超好吃的～",
    "voice": "vo_adv_1007008_038",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n現在就想馬上吃到布丁來的～",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "可是每間店都賣光光了～",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "啊！宮子想到了～！",
    "voice": "vo_adv_1007008_039",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
