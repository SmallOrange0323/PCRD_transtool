[
  {
    "type": "background",
    "bg_id": "502000"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在海風吹拂的大間港，{0}被秋乃拉著手，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n來到了並排著漁船的一處角落。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "嗯～",
    "voice": "vo_adv_1267002_000",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "真奇怪呢。",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n剛才也見過",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "這個招牌了對吧。",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我印象中",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "是聽說在這裡的呢……",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "大間的漁夫",
    "words": "哦哦，",
    "voice": "vo_adv_1267002_001",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大間的漁夫",
    "words": "是之前的小妹妹你們啊。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大間的漁夫",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大間的漁夫",
    "words": "事情我都聽說了喔，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大間的漁夫",
    "words": "上船吧。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "謝謝。",
    "voice": "vo_adv_1267002_002",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "{0}大人，",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "往這邊走♪",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "前幾天",
    "voice": "vo_adv_1267002_003",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我們不是一起",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "逛了大間港嗎？",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n地理位置、",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "名產、",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "漁業",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "以及其他的產業基礎……",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "大致的情況我都已經掌握好了。",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "只不過，",
    "voice": "vo_adv_1267002_004",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "光是到處看看所能獲得的情報",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "也是有極限的。",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "所",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "以今天",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "就是來進一步",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "實地體驗的。",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "賣家好、",
    "voice": "vo_adv_1267002_005",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "買家好、",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "社會就好！",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我所要做的，",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "是去了解在當地生活的人們，",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n打造出讓大家能互相攜手合作的",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "嶄新事業。",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "想達成這目的，",
    "voice": "vo_adv_1267002_006",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "要做的就是這個──",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "大間金槍鮪的",
    "voice": "vo_adv_1267002_007",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "釣魚體驗喔！",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "background",
    "bg_id": "500050"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "然而就在秋乃等人搭上大間漁船的不久前──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大間的老婆婆",
    "words": "來，",
    "voice": "vo_adv_1267002_008",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "大間的老婆婆",
    "words": "久等了。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "大間的老婆婆",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "大間的老婆婆",
    "words": "所以",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "大間的老婆婆",
    "words": "今天有什麼事呢？",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "這次",
    "voice": "vo_adv_1267002_009",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "也是",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我朋友",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "的事就是了。",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "那個……",
    "voice": "vo_adv_1267002_010",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "她雖然約好了在意的對象，",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "但她似乎完全想不到方法，",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n可以跟對方",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "建構更親密的關係。",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "能想到的追求攻勢",
    "voice": "vo_adv_1267002_011",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "在第一天就已經都做過了……",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n說起來，",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "雖然說要視察大間港，",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n但是在第一天就幾乎全部繞過一遍了。",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "還能想得到的，",
    "voice": "vo_adv_1267002_012",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "頂多就只有去看看其他家餐廳而已，",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "可是這樣一來",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "就跟第一天沒什麼差別了……",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "真是的，",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "為什麼要用視察這種名義啊。",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "早知道當初",
    "voice": "vo_adv_1267002_013",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "直接說「我們一起去度假吧」",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n就好了……",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "但是要跟他兩人獨處的話，",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n那樣也挺……",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "呃，",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "挺難為情的……",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "大間的老婆婆",
    "words": "……所以小妹妹妳聽了這件事之後，",
    "voice": "vo_adv_1267002_014",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "大間的老婆婆",
    "words": "\\n為了幫妳那位「朋友」一把，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "大間的老婆婆",
    "words": "才會來我店裡對吧。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "咦……",
    "voice": "vo_adv_1267002_015",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "對！",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "就、",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "就是這麼回事！",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "大間的老婆婆",
    "words": "那樣的話",
    "voice": "vo_adv_1267002_016",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "大間的老婆婆",
    "words": "乾脆試著色誘對方如何？",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "大間的老婆婆",
    "words": "\\n像我在年輕的時候，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "大間的老婆婆",
    "words": "\\n還被人稱為皮膚水嫩水嫩的人魚公主呢。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "說、",
    "voice": "vo_adv_1267002_017",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "說說、",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "說什麼色誘，",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "那種不要臉的事……！",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "大間的老婆婆",
    "words": "嘻～嘻嘻，",
    "voice": "vo_adv_1267002_018",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "大間的老婆婆",
    "words": "開玩笑的。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "大間的老婆婆",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "大間的老婆婆",
    "words": "只不過這明明是妳朋友的事，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "大間的老婆婆",
    "words": "妳卻緊張成這樣。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "大間的老婆婆",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "大間的老婆婆",
    "words": "還真是有趣的小妹妹呀。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "真、",
    "voice": "vo_adv_1267002_019",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "真是的！",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "請不要捉弄我了！",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "大間的老婆婆",
    "words": "好吧，",
    "voice": "vo_adv_1267002_020",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "大間的老婆婆",
    "words": "既然這樣我就給妳一個折衷方案。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "大間的老婆婆",
    "words": "\\n就去邀那個誰",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "大間的老婆婆",
    "words": "到我接下來說的地方看看吧。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "大間的老婆婆",
    "words": "有個叫吊橋效應的對吧？",
    "voice": "vo_adv_1267002_021",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "大間的老婆婆",
    "words": "\\n那裡簡直是再適合不過了，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "大間的老婆婆",
    "words": "嘻～嘻嘻嘻嘻……",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "於是我就相信她的話，",
    "voice": "vo_adv_1267002_022",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "試著來到了這裡……",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "background",
    "bg_id": "501190"
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "但是這個",
    "voice": "vo_adv_1267002_023",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "與其說是吊橋效應，",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "根本就只是像吊橋一樣搖晃而已吧──",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "呀",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "啊！？",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "{0}",
    "voice": "vo_adv_1267002_024",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "大人……",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "謝謝你。",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "這就是所謂的漁船啊。",
    "voice": "vo_adv_1267002_025",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "該說它有種奔放、",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "充滿了生命力的感覺嗎……",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "和我平常搭的船相比，",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "又有種不同的風情呢。",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "大間的漁夫",
    "words": "看妳好像很享受的樣子，讓我感到很榮幸，",
    "voice": "vo_adv_1267002_026",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大間的漁夫",
    "words": "\\n但是可別隨便把身體探出船外喔。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大間的漁夫",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大間的漁夫",
    "words": "要是掉進海裡就糟糕了。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大間的漁夫",
    "words": "而且",
    "voice": "vo_adv_1267002_027",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大間的漁夫",
    "words": "既然是那個人的請託就沒辦法拒絕了。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大間的漁夫",
    "words": "\\n你們也被她捉弄得很慘吧？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "你也",
    "voice": "vo_adv_1267002_028",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "跟那位老婆婆認識……",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "對嗎？",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "大間的漁夫",
    "words": "是啊，",
    "voice": "vo_adv_1267002_029",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大間的漁夫",
    "words": "她是這裡很有名的愛管閒事婆婆。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大間的漁夫",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大間的漁夫",
    "words": "說是當地的領頭人物……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大間的漁夫",
    "words": "好像也有點不太對。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大間的漁夫",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大間的漁夫",
    "words": "算是諮詢師、",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大間的漁夫",
    "words": "顧問那類的吧～",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大間的漁夫",
    "words": "其實我當初",
    "voice": "vo_adv_1267002_030",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大間的漁夫",
    "words": "想成為漁夫而找她商量的時候，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大間的漁夫",
    "words": "\\n就有請她幫我準備這艘漁船。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大間的漁夫",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大間的漁夫",
    "words": "實在是讓我感激不盡。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "原來是這樣啊。",
    "voice": "vo_adv_1267002_031",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "是個大家都很景仰的人呢。",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "大間的漁夫",
    "words": "反正",
    "voice": "vo_adv_1267002_032",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大間的漁夫",
    "words": "就是因為這樣，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大間的漁夫",
    "words": "\\n所以我被她拜託要讓小妹妹你們來體驗捕魚了。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大間的漁夫",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大間的漁夫",
    "words": "哦，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大間的漁夫",
    "words": "魚群探測機有反應了。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "那麼，",
    "voice": "vo_adv_1267002_033",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "就要在這裡釣魚對吧。",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "甩動釣竿……",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "嘿！",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "這下就只要等魚上鉤就行了吧。",
    "voice": "vo_adv_1267002_034",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "請問……",
    "voice": "vo_adv_1267002_035",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "這個大概要",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "等多久才好呢？",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "大間的漁夫",
    "words": "妳問等多久，",
    "voice": "vo_adv_1267002_036",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大間的漁夫",
    "words": "當然是等到魚上鉤啦。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我就是在問",
    "voice": "vo_adv_1267002_037",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "等到魚上鉤為止的時間。",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "就是，",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "應該有平均要等多久",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "之類的預估時間吧？",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "要、",
    "voice": "vo_adv_1267002_038",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "要花這麼長的時間嗎！？",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n一隻都沒釣到的情況",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "也很常見嗎？",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "這工作真是超乎我想像的艱辛呢……",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "大間的漁夫",
    "words": "不過，",
    "voice": "vo_adv_1267002_039",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大間的漁夫",
    "words": "平常也會用網子來捕魚就是了。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大間的漁夫",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大間的漁夫",
    "words": "只是說到大間，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大間的漁夫",
    "words": "就會想到用釣竿來釣金槍鮪嘛。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "……",
    "voice": "vo_adv_1267002_040",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "……",
    "voice": "vo_adv_1267002_041",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "………",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "……只能等著魚上鉤，",
    "voice": "vo_adv_1267002_042",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n感覺真讓人心癢難耐呢。",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "原來如此，",
    "voice": "vo_adv_1267002_043",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "是這麼一回事啊……",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "一直待在這邊不動雖然讓人靜不下心來，",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n但是要入境隨俗……",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "對吧。",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "專心地、",
    "voice": "vo_adv_1267002_044",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "安靜地……",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "等著魚",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "過來……",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "呀啊！？",
    "voice": "vo_adv_1267002_045",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "怎怎、",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "怎麼回事！",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n釣竿突然",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "被拉住了……！",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我、",
    "voice": "vo_adv_1267002_046",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我說",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "{0}大人！",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n這樣子",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "是上鉤了嗎？",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "有魚上鉤了是嗎！？",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "大間的漁夫",
    "words": "這個獨特的背鰭跟魚身……",
    "voice": "vo_adv_1267002_047",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大間的漁夫",
    "words": "是金槍鮪！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大間的漁夫",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大間的漁夫",
    "words": "第一條就中獎啦，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大間的漁夫",
    "words": "小妹妹妳真幸運啊！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "嗯噫噫噫噫……！",
    "voice": "vo_adv_1267002_048",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n那、",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "那真是多謝了……！",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "這、",
    "voice": "vo_adv_1267002_049",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "這就是金槍鮪……",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "拉扯的力道非比尋常呢……！！",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "{0}",
    "voice": "vo_adv_1267002_050",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "大人！？",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
