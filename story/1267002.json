    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n肯定也是因為你在我的身邊呢。",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "就像我們一起",
    "voice": "vo_adv_1267002_078",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "共享了今天這個重要的瞬間……",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "今後我也想",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "跟你一起",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "累積這種瞬間呢。",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "……",
    "voice": "vo_adv_1267002_079",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "話說回來，",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "胸口的悸動",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "還沒有平靜下來呢。",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n倒不如說",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "看到他的笑臉之後，",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "就變得更強烈了……？　",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "──",
    "voice": "vo_adv_1267002_080",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "──！",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "沒、",
    "voice": "vo_adv_1267002_081",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "沒有。",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "什什什麼事都沒有。",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "呃、",
    "voice": "vo_adv_1267002_082",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "那個……",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "比起這個……",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "對",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "了！",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n要繼續釣魚囉！",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n來，",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "你也拿著釣竿。",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "原本是新手的我",
    "voice": "vo_adv_1267002_083",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "都能釣上來了。",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "你可是有經驗的人，",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n請務必",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "要讓我",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "見識一下你帥氣的一面喔♪",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "嗚嗚……",
    "voice": "vo_adv_1267002_084",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "本來應該要把吊橋效應加諸在他身上的，",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n結果卻加到自己身上",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "是要怎麼辦啦……！　",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "至少",
    "voice": "vo_adv_1267002_085",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "短時間內……",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n在發燙的臉恢復正常之前，",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n要想辦法",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "別讓人看到才行……！　",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "不曉得有沒有注意到秋乃的內心想法，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}朝著大海猛力地甩出了釣竿。",
    "voice": null,
    "unit_id": null
  }
]
