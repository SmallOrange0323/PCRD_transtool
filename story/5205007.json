  {
    "type": "dialogue",
    "name": "旁白",
    "words": "詛咒嘉年華落幕，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在這之後──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n於吉歐‧格黑納的競技場，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "兩人面對面而立。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "哦～",
    "voice": "vo_adv_5205007_000",
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "呵呵呵♪",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "我就稱讚妳依約前來，",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "沒有逃跑的勇氣吧！",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "謝謝妳的費心。",
    "voice": "vo_adv_5205007_001",
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n但我可不準備稱讚妳呢。",
    "voice": null,
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "因為遵守行程表是理所當然的事。",
    "voice": null,
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "那還用說嗎？",
    "voice": "vo_adv_5205007_002",
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n不如說，不打這一場就不會結束！",
    "voice": null,
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "嗯，",
    "voice": "vo_adv_5205007_003",
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "完全就是這麼回事。",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n我可是對這個時刻翹首以盼。",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "還有──",
    "voice": "vo_adv_5205007_004",
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "一個人──",
    "voice": "vo_adv_5205007_005",
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "紡希與華音",
    "words": "──是我必須打倒的對手！",
    "voice": "vo_adv_5205007_006",
    "unit_id": null
  },
  {
    "type": "movie",
    "movie_id": "520500701"
  },
  {
    "type": "background",
    "bg_id": "502182"
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "好、",
    "voice": "vo_adv_5205007_007",
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "痛！？",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n我說妳，",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "突然插手是在搞什麼啊……！？",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "對啊，怜大人！",
    "voice": "vo_adv_5205007_008",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "妳甚至還接受強化了！",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "真是的。",
    "voice": "vo_adv_5205007_009",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n相似的兩人，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就好好相處嘛。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "紡希與華音",
    "words": "「完全不相似！」\\n「完全不相似呀！」",
    "voice": "vo_adv_5205007_010",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "我哪裡",
    "voice": "vo_adv_5205007_011",
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "跟這種張嘴就只會噴出諷刺話的",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n毒舌系偶像女相似啊！？",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我哪裡跟這種張嘴就高傲自大高高在上",
    "voice": "vo_adv_5205007_012",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n如同壞掉笑袋的女人相似啊！",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "妳縮啥",
    "voice": "vo_adv_5205007_013",
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "麼～",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "～～～～！",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "妳～",
    "voice": "vo_adv_5205007_014",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "想～",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "怎～",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "樣～",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "啊～！",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "唉……",
    "voice": "vo_adv_5205007_015",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "兩位，",
    "voice": "vo_adv_5205007_016",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "再繼續吵的話，我來跟妳們打。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "畢竟之前一直維持同一個姿勢，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我想稍稍活動身體。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不過我可沒辦法手下留情、",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "呢。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "噫……",
    "voice": "vo_adv_5205007_017",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "這女人是怎麼回事──",
    "voice": "vo_adv_5205007_018",
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "完全沒有",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "「庶民氣場」。",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n行為舉止也是，",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "雖不到我的程度，",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "但無疑擁有高貴的身分背景……！　",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "妳們明白我的意思了吧。",
    "voice": "vo_adv_5205007_019",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那麼紡希，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "差不多該走了。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "好、",
    "voice": "vo_adv_5205007_020",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "好的，",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "怜大人♪",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……這次受妳們幫助了，",
    "voice": "vo_adv_5205007_021",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "兩位都是。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n妳是叫",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "華音對吧。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我總有一天",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "會還妳這份人情的。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "我是",
    "voice": "vo_adv_5205007_022",
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "完全",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "沒──有",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "一點要救妳的意思，",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "但既然妳說欠我人情，那就好好感謝我，",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "為我貢獻吧♪",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "哦～",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "呵呵呵♪",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……原來如此，",
    "voice": "vo_adv_5205007_023",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "難怪會跟紡希合得來。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "妳是什麼意思，怜大人！？",
    "voice": "vo_adv_5205007_024",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "沒什麼。",
    "voice": "vo_adv_5205007_025",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n來，走吧，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "畢竟探索吉歐‧格黑納這個目的還沒達成啊。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "咦，",
    "voice": "vo_adv_5205007_026",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "現在就要出發嗎？",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我有點累了……",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "怜、",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "怜大人！？",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "請別一直拉我！！",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "啊，",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "但",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "強硬的怜大人也很有魅力呢～♪",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "好好好。",
    "voice": "vo_adv_5205007_027",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "話說回來，紡希，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "妳那服裝是怎麼回事？",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n跟我一起行動的時候應該是穿平常的衣服啊……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "咦，",
    "voice": "vo_adv_5205007_028",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "現在！？",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "現在要問這個嗎！？",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "騎士先生也是，在意的話就馬上問啊！",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我以為你無視了……",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "呃，",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我也不是想要你的反應啦！",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "這是",
    "voice": "vo_adv_5205007_029",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "為了拯救怜大人的、",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "決勝服裝……",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n用的是配合吉歐‧格黑納環境的布料……",
    "voice": null,
