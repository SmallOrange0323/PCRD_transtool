[
  {
    "type": "dialogue",
    "name": "苑",
    "words": "……啊。",
    "voice": "vo_adv_5154204_000",
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n感覺氣氛明顯不一樣了。",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "是啊……",
    "voice": "vo_adv_5154204_001",
    "unit_id": 132211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n四處都潛藏著強大魔物……",
    "voice": null,
    "unit_id": 132211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "散發著一股這樣的味道。",
    "voice": null,
    "unit_id": 132211
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "小望，",
    "voice": "vo_adv_5154204_002",
    "unit_id": 132411
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "妳用聞的就知道魔物的強度了嗎！？",
    "voice": null,
    "unit_id": 132411
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n",
    "voice": null,
    "unit_id": 132411
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "好厲害！",
    "voice": null,
    "unit_id": 132411
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "好帥氣！",
    "voice": null,
    "unit_id": 132411
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n",
    "voice": null,
    "unit_id": 132411
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "露易，",
    "voice": null,
    "unit_id": 132411
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "也幫彩羽做一個能成為戀味癖的祕藥～！",
    "voice": null,
    "unit_id": 132411
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "不，",
    "voice": "vo_adv_5154204_003",
    "unit_id": 132311
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "那不是什麼能成為戀味癖的祕藥啦。",
    "voice": null,
    "unit_id": 132311
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 132311
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "而且剛剛望所說的味道，",
    "voice": null,
    "unit_id": 132311
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "並不是真的氣味。",
    "voice": null,
    "unit_id": 132311
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 132311
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "而是用來表現可疑氣息的譬喻。",
    "voice": null,
    "unit_id": 132311
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗅嗅……！",
    "voice": "vo_adv_5154204_004",
    "unit_id": 132211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 132211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "大家，",
    "voice": null,
    "unit_id": 132211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "有股猙獰野獸的氣味正在接近中！",
    "voice": null,
    "unit_id": 132211
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "啊，",
    "voice": "vo_adv_5154204_005",
    "unit_id": 132311
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "原來真的是氣味啊……",
    "voice": null,
    "unit_id": 132311
  }
]
