[
  {
    "type": "dialogue",
    "name": "華音",
    "words": "喔～",
    "voice": "vo_adv_9006705_000",
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "呵呵呵♪",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "我在和阿剌克涅決戰時，",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n我可是被拿娜唰地砍了一下就呼嚕呼嚕地睡著了喔？",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "現在就讓妳嚐嚐",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "蠍獅流毒殺劍術的恐怖吧～！",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "……該嚐到苦頭的人是妳才對。",
    "voice": "vo_adv_9006705_001",
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "──唔哇啊啊啊啊！？",
    "voice": "vo_adv_9006705_002",
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "華音小～姐！",
    "voice": "vo_adv_9006705_003",
    "unit_id": 139612
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "變成星星了。",
    "voice": "vo_adv_9006705_004",
    "unit_id": 139712
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "雖然過去曾與",
    "voice": "vo_adv_9006705_005",
    "unit_id": 139512
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "芙蕾雅小姐交手過幾次。",
    "voice": null,
    "unit_id": 139512
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 139512
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "但沒想到實力居然強到這種地步……",
    "voice": null,
    "unit_id": 139512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……",
    "voice": "vo_adv_9006705_006",
    "unit_id": 138311
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "比起上次與我交手時，",
    "voice": null,
    "unit_id": 138311
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n她似乎又變得更強大了……",
    "voice": null,
    "unit_id": 138311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "難道說……",
    "voice": "vo_adv_9006705_007",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n這是來自幻境龍后的，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "強化之力……？",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "尤絲蒂亞娜‧F‧阿斯特賴亞……",
    "voice": "vo_adv_9006705_008",
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n我早已不再執著於",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "與妳之間的因果。",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "身為幻境龍后的公主騎士，",
    "voice": "vo_adv_9006705_009",
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "我只需揮舞皇家裝備。",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "將怒火封存，",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "宛如機械一般──",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "我要將妳們，",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "連同最後一人也徹底殲滅。",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "……沒錯，",
    "voice": "vo_adv_9006705_010",
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "為了我的……",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "願望……",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "……？",
    "voice": "vo_adv_9006705_011",
    "unit_id": 139511
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n那位大人。",
    "voice": null,
    "unit_id": 139511
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "除了憤怒外，",
    "voice": null,
    "unit_id": 139511
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "似乎還有著……",
    "voice": null,
    "unit_id": 139511
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "要上了。",
    "voice": "vo_adv_9006705_012",
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n皇家裝備，",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "「憤怒」──！",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "莉莉，",
    "voice": "vo_adv_9006705_013",
    "unit_id": 138311
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "危險！",
    "voice": null,
    "unit_id": 138311
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "！",
    "voice": "vo_adv_9006705_014",
    "unit_id": 139512
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 139512
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "非常抱歉，",
    "voice": null,
    "unit_id": 139512
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "貪吃佩可小姐……！",
    "voice": null,
    "unit_id": 139512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "沒、",
    "voice": "vo_adv_9006705_015",
    "unit_id": 138311
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "沒事的！",
    "voice": null,
    "unit_id": 138311
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 138311
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "芙蕾雅小姐……",
    "voice": null,
    "unit_id": 138311
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n果然，",
    "voice": null,
    "unit_id": 138311
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "很棘手呢……！",
    "voice": null,
    "unit_id": 138311
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但是……！",
    "voice": null,
    "unit_id": 138311
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "貪吃佩可小姐，",
    "voice": "vo_adv_9006705_016",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請不要勉強自己……！",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n還有在下等人也在呢……！",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好的……！",
    "voice": "vo_adv_9006705_017",
    "unit_id": 138311
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n就拜託",
    "voice": null,
    "unit_id": 138311
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "大家了！",
    "voice": null,
    "unit_id": 138311
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "唔……！",
    "voice": "vo_adv_9006705_018",
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n……阿斯特",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "賴亞……",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "別來……",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "動搖我……！",
    "voice": null,
    "unit_id": 193713
  }
