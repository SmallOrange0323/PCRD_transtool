  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n這、",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這個荒涼的城鎮是蘭德索爾！？",
