  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不、",
    "voice": "vo_adv_5066005_010",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不，",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "沒什麼……",
