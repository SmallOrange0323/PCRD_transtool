    "type": "dialogue",
    "name": "老人",
    "words": "你們是誰……？",
    "voice": "vo_adv_5066005_002",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "\\n從沒在這一帶看過你們啊……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
