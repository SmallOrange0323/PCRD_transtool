    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "不過，我也教了他不少功課，",
    "voice": "vo_adv_1250004_045",
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "希望他能原諒我呢。",
