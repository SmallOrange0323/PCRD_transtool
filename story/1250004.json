    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這件事你還記得吧？",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "嗯，",
    "voice": "vo_adv_1250004_052",
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "當然記得。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "所以……",
    "voice": "vo_adv_1250004_053",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
