    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "什麼事，",
    "voice": "vo_adv_1250004_050",
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "諾維姆。",
