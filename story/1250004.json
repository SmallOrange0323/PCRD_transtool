    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "\\n用來當作",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "煽動諾維姆用功的手段……",
