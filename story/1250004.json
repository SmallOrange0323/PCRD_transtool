    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "……好啦，",
    "voice": "vo_adv_1250004_054",
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "既然妳都這麼說了，我會聽妳的。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "\\n",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "不過，",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "即使未來發生艱辛的事情，",
