[
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在矛依未等人的決定下，樂園的餘波終於獲得解決。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n可是，作為代價，矛依未放棄了解放之力。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "嗨，{0}。",
    "voice": "vo_adv_1250004_000",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n在樂園事件中，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "受到你不少的關照呢！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "咦，",
    "voice": "vo_adv_1250004_001",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你說什麼也沒做？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你還是沒變，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "是個謙虛的傢伙呢！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n不過，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我非常感謝你啦！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "在那之後，我花了幾天觀察城鎮的狀況，",
    "voice": "vo_adv_1250004_002",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n似乎已經沒有被囚禁於回憶中的傢伙了！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "能夠成功",
    "voice": "vo_adv_1250004_003",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "真是太好了！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "那麼，",
    "voice": "vo_adv_1250004_004",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "今天就做當作是道謝和慶祝！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我請客，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我們一起去吃頓飯吧！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n之後，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我們一起到終於恢復平靜的城鎮閒晃，如何！？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "不安？",
    "voice": "vo_adv_1250004_005",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這個嘛……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "咦，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "陽光也太強了吧？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n有點耀眼過頭了喔。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這究竟是……",
    "voice": "vo_adv_1250004_006",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "唔、",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "唔呀啊啊！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "background",
    "bg_id": "510160"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "這一天，{0}為了調查作業的資料，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n造訪了圖書館。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "救、",
    "voice": "vo_adv_1250004_007",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "救命啊！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我要被殺掉了──！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "喔喔，",
    "voice": "vo_adv_1250004_008",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你還記得我嗎？",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "沒錯，",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我是同校的矛依未！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "呃，",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這種事根本不重要，",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "快救救我！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我現在",
    "voice": "vo_adv_1250004_009",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "正被一個很不妙的傢伙追著……",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "是個既心機又喜歡挖苦人的",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "妹妹頭男……",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "再這樣下去",
    "voice": "vo_adv_1250004_010",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我會被那傢伙……",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "找～到妳了。",
    "voice": "vo_adv_1250004_011",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "唔噫噫！",
    "voice": "vo_adv_1250004_012",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "尾、",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "尾狗……",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "真是的，",
    "voice": "vo_adv_1250004_013",
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "妳開口說要我教妳念書，",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "\\n竟然還落荒而逃，這樣不行吧。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "妳不這麼認為嗎？",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "可、",
    "voice": "vo_adv_1250004_014",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "可是……",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我果然還是",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "很討厭念書什麼的……",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "沒什麼可是不可是。",
    "voice": "vo_adv_1250004_015",
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "如果只是逃跑就算了，",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "不要還給其他人添麻煩啦。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "\\n",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "對不起喔，",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "我朋友她……",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "哎呀？",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "……",
    "voice": "vo_adv_1250004_016",
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "你是",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "我們學校的學生吧。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "\\n",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "嗯",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "～",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "來寫作業啊，",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "這樣啊，",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "真了不起～",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "\\n我是她的指導者，",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "但結果如你所見。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "我也嚇了一跳呢。",
    "voice": "vo_adv_1250004_017",
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "哎呀～",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "世界",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "遠比我想像的來得小啊。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "對了，",
    "voice": "vo_adv_1250004_018",
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "這也是某種緣分，",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "你也一起來念書吧。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "放心吧，",
    "voice": "vo_adv_1250004_019",
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "我很聰明的。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "\\n除了作業以外，不擅長的科目我也能教你喔。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "喂！",
    "voice": "vo_adv_1250004_020",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你在說什麼啊，",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這種事當然不行！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "我認為有你在場，",
    "voice": "vo_adv_1250004_021",
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "她肯定也會",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "提起幹勁吧。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "再加上，她大概無法做出認識的人就在面前，",
    "voice": "vo_adv_1250004_022",
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "\\n卻還落荒而逃的丟人行為吧。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "喂、",
    "voice": "vo_adv_1250004_023",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "喂！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我都說不要了！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "有沒有在聽啊，",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "喂！？",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "是妳先向他求救的呦？",
    "voice": "vo_adv_1250004_024",
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "快認命吧？",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "still",
    "still_id": "125000401"
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "唔、",
    "voice": "vo_adv_1250004_025",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "咿咿咿……",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "光是閱讀文章，頭就痛了起來……",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n一看到數字，",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "就感覺要吐了……",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "我還是第一次見到",
    "voice": "vo_adv_1250004_026",
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "有人說出這種漫畫般的台詞。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "\\n",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "你呢？",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "有不懂的問題嗎？",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "我看看，",
    "voice": "vo_adv_1250004_027",
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "這裡啊──",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "矛依未，",
    "voice": "vo_adv_1250004_028",
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "妳那邊如何？",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "啊啊，",
    "voice": "vo_adv_1250004_029",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我懂了自己什麼都看不懂……",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "哎呀，",
    "voice": "vo_adv_1250004_030",
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "這邊完全不行呢～",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "說起來，妳為什麼會突然想要念書？",
    "voice": "vo_adv_1250004_031",
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "\\n講得婉轉一點，",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "妳的頭腦不好吧。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "喂，",
    "voice": "vo_adv_1250004_032",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "根本一點都不婉轉！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你再稍微體貼一點吧！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……其實沒什麼",
    "voice": "vo_adv_1250004_033",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "大不了的理由啦。",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我只是認為",
    "voice": "vo_adv_1250004_034",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "要達成我的目標，",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n不光是強大，",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "頭腦必須也要好才行。",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "是喔，",
    "voice": "vo_adv_1250004_035",
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "原來是這樣啊。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "了不起了不起。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我這麼說",
    "voice": "vo_adv_1250004_036",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "並非是在騙人，",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "不過終究是表面上的理由。",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "其實是，",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "萬一我和尾狗刀到了必須分離的時候，",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n我自己要能獨當一面。",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我想相信這種事不會發生……",
    "voice": "vo_adv_1250004_037",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "但是，",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我們正在做的事情",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "與危險相伴，",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n還是要以防萬一才行。",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "──諾維姆這傢伙，",
    "voice": "vo_adv_1250004_038",
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "大概是這麼想的吧。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "\\n",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "雖然諾維姆想得太多了，",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "不過很像她會考慮的事情，",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "\\n",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "我就不再追問，陪她念書吧。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "既然如此，",
    "voice": "vo_adv_1250004_039",
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "妳得盡快解決",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "這種程度的問題才行。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "\\n妳看，",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "他都已經解開不少題目了。",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "不過，",
    "voice": "vo_adv_1250004_040",
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "對矛依未來說，恐怕還是太難了吧？",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "\\n",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "抱歉～",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "妳不必勉強自己喔～",
    "voice": null,
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "什麼？",
    "voice": "vo_adv_1250004_041",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你以為我是誰啊！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n這種程度的問題，",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我會用超音速解決掉！",
