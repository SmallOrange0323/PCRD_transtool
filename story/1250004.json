    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "今天",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你的分數比我好，",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n不過下次我會贏的！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "再見了！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……",
    "voice": "vo_adv_1250004_047",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "詠斗",
    "words": "……",
    "voice": "vo_adv_1250004_048",
    "unit_id": 106231
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "喂，",
    "voice": "vo_adv_1250004_049",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "尾狗刀。",
