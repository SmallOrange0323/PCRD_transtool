    "type": "dialogue",
    "name": "珠希",
    "words": "沒錯喵。",
    "voice": "vo_adv_9007010_004",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這個是這鎮上的人改良的，",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n加了滿滿的砂糖",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "和奶油的",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "五彩繽紛鯛魚燒喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "……",
    "voice": "vo_adv_9007010_005",
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "很好吃，",
    "voice": null,
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "喔？",
    "voice": null,
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "味、",
    "voice": "vo_adv_9007010_006",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "味道好吃是很好，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "但比起那個，珠希。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n妳之前不是非常不能接受這個鯛魚燒嗎？",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "呵",
    "voice": "vo_adv_9007010_007",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "呵",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "呵……",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我一開始的確是無法接受喵。",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "但是",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "看到這個鯛魚燒在鎮上受歡迎的程度，讓我注意到了……！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "身為商人……",
    "voice": "vo_adv_9007010_008",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我必須跟上這股風潮才行喵！！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "哇、",
    "voice": "vo_adv_9007010_009",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "哇啊……",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "妳對做生意依舊充滿了熱忱呢……",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "可是",
    "voice": "vo_adv_9007010_010",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "最近生意開始沒那麼好了喵～",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "大家說不定是開始膩了喵。",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "畢竟甜點的流行過得很快啊。",
    "voice": "vo_adv_9007010_011",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n或許是時候該開發新的口味了。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "那……",
    "voice": "vo_adv_9007010_012",
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "做更大的，",
    "voice": null,
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "鯛魚燒。",
    "voice": null,
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "從加大份量下手喵～？",
    "voice": "vo_adv_9007010_013",
