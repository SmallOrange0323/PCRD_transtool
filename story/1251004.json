  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在營業時間結束後的店內，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n珠希與{0}正在進行關店的工作。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "好，",
    "voice": "vo_adv_1251004_000",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我掃完這邊了喵。",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "你東西也洗完了嗎喵？",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "明天莫妮卡也會回來，",
    "voice": "vo_adv_1251004_001",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "所以我們兩人單獨顧店在今天就暫時結束了喵……",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "…………",
    "voice": "vo_adv_1251004_002",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "你、",
    "voice": "vo_adv_1251004_003",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "你在說什麼喵！？",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我、",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我超有精神的喵……！",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n太有精神了，眼前都發光……",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "呃，",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "嗚喵啊啊～～～！？",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "background",
    "bg_id": "510360"
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "唉……",
    "voice": "vo_adv_1251004_004",
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我不小心隨口答應了喵……",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "但",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "現在才拒絕也會造成別人困擾……",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "嗯？",
    "voice": "vo_adv_1251004_005",
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "啊啊，{0}喵！",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n你路過得正好喵……！",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "其實",
    "voice": "vo_adv_1251004_006",
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我被拜託在某間咖啡店進行僅限一天的支援……",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "因為是很照顧我的店長拜託的，",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "所以我是接受了啦喵……",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "但我希望你看一下這個喵……",
    "voice": "vo_adv_1251004_007",
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "雖……",
    "voice": "vo_adv_1251004_008",
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "雖然看起來像那樣，",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "但這是一般的咖啡店制服喵！",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "那並不是有女僕服務的地方，",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "非常一般！",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "但是，",
    "voice": "vo_adv_1251004_009",
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "要用這身制服接待客人，果然還是有點羞恥喵……",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "那、",
    "voice": "vo_adv_1251004_010",
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "那是因為",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "來拜託我的店長，是我們鯛魚燒店的常客……",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n他總是稱讚我的工作認真，",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我很高興，忍不住就……",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "那、",
    "voice": "vo_adv_1251004_011",
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "那就是問題所在喵……！",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這對我來說有點太可愛了……",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "總之我會害羞喵！",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "……不論我有多害羞，",
    "voice": "vo_adv_1251004_012",
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "一旦接受就沒辦法拒絕了喵。",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "但要突然毫無準備直接出場還是……",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "嗚喵～",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "……對了喵！",
    "voice": "vo_adv_1251004_013",
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "你現在能陪我練習嗎喵？",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n因為是我要服務客人，",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "所以我希望你來扮演客人喵！",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "如果你能幫忙，",
    "voice": "vo_adv_1251004_014",
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "總覺得我就有辦法克服了喵……",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "你願意幫我的忙嗎～？",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "……可以喵！？",
    "voice": "vo_adv_1251004_015",
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "你真可靠喵♪",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n那就馬上……",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "呃，",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "在這裡的話太引人注目了喵。",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "咦？",
    "voice": "vo_adv_1251004_016",
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "{0}的家要借我？",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "那真是太感謝了喵！",
    "voice": null,
    "unit_id": 104631
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "那就麻煩你了喵！",
    "voice": null,
    "unit_id": 104631
