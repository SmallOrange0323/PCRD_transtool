  },
  {
    "type": "dialogue",
    "name": "シオリ",
    "words": "合宿もようやく最終日……",
    "voice": "vo_adv_5116411_000",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "シオリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "シオリ",
    "words": "本当に、",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "シオリ",
    "words": "色々ありましたね。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "シオリ",
    "words": "私、",
    "voice": "vo_adv_5116411_001",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "シオリ",
    "words": "この合宿にきてよかったです。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "シオリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "シオリ",
    "words": "大事にしたい人、",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "シオリ",
    "words": "大切にしたいもの……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "シオリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "シオリ",
    "words": "それが何か、",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "シオリ",
    "words": "改めてわかりました。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "シオリ",
    "words": "だから、",
    "voice": "vo_adv_5116411_002",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "シオリ",
    "words": "まずは「ただいま」って言いたいです。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "シオリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "シオリ",
    "words": "私の、",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "シオリ",
    "words": "私たちの帰りを待ってくれている人に。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "わたくしも、",
    "voice": "vo_adv_5116411_003",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "でございます。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n帰りを待っているみなさまに、",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\nたくさんのお土産話をいたしましょう。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "しかしシオリさま、",
    "voice": "vo_adv_5116411_004",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "まだ合宿は終わっておりませんよ。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "今日この日を、",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "最後まで気を緩めずに過ごしましょう。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "きっちり任務を完遂してこそ、",
    "voice": "vo_adv_5116411_005",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "一人前のレンジャーでございますから。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "シオリ",
    "words": "ふふっ……",
    "voice": "vo_adv_5116411_006",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "シオリ",
    "words": "そうですね。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "シオリ",
    "words": "\\n最後まで油断せず、",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "シオリ",
    "words": "ですね。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "シオリ",
    "words": "みんなで、",
    "voice": "vo_adv_5116411_007",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "シオリ",
    "words": "胸を張って",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "シオリ",
    "words": "「ただいま」を言うために。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "シオリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "シオリ",
    "words": "さあ、",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "シオリ",
    "words": "今日も頑張りましょうっ。",
    "voice": null,
    "unit_id": 103811
  }
]
