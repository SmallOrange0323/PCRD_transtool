[
  {
    "type": "background",
    "bg_id": "509040"
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "騎士先生……",
    "voice": "vo_adv_9500088_000",
    "unit_id": 136041
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "\\n",
    "voice": null,
    "unit_id": 136041
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "您希望",
    "voice": null,
    "unit_id": 136041
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "由我來嗎……？",
    "voice": null,
    "unit_id": 136041
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "\\n真的……？",
    "voice": null,
    "unit_id": 136041
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "當然，",
    "voice": "vo_adv_9500088_001",
    "unit_id": 136041
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "我非常……",
    "voice": null,
    "unit_id": 136041
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "非常",
    "voice": null,
    "unit_id": 136041
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "開心。",
    "voice": null,
    "unit_id": 136041
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "\\n能被騎士先生選中，",
    "voice": null,
    "unit_id": 136041
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "\\n感覺幸福到像是被溫暖的光芒圍繞。",
    "voice": null,
    "unit_id": 136041
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "但是……",
    "voice": "vo_adv_9500088_002",
    "unit_id": 136041
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "\\n我有",
    "voice": null,
    "unit_id": 136041
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "無法改變的過去。",
    "voice": null,
    "unit_id": 136041
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "\\n",
    "voice": null,
    "unit_id": 136041
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "能被騎士先生選中，",
    "voice": null,
    "unit_id": 136041
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "這怎麼可能被允許呢。",
    "voice": null,
    "unit_id": 136041
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "騎士先生……",
    "voice": "vo_adv_9500088_003",
    "unit_id": 136041
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "\\n",
    "voice": null,
    "unit_id": 136041
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "謝謝、",
    "voice": null,
    "unit_id": 136041
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "您……",
    "voice": null,
    "unit_id": 136041
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "騎士先生果然",
    "voice": "vo_adv_9500088_004",
    "unit_id": 136041
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "就是我的光。",
    "voice": null,
    "unit_id": 136041
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "\\n",
    "voice": null,
    "unit_id": 136041
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "……因為無論身處如何深沉的黑暗，",
    "voice": null,
    "unit_id": 136041
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "\\n您都會引導我。",
    "voice": null,
    "unit_id": 136041
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "……當然，",
    "voice": "vo_adv_9500088_005",
    "unit_id": 136041
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "我也理解黑暗是不會消失的。",
    "voice": null,
    "unit_id": 136041
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "\\n",
    "voice": null,
    "unit_id": 136041
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "而且我也不清楚，",
    "voice": null,
    "unit_id": 136041
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "自己今後會不會再次……",
    "voice": null,
    "unit_id": 136041
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "\\n犯下過錯。",
    "voice": null,
    "unit_id": 136041
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "但是……",
    "voice": "vo_adv_9500088_006",
    "unit_id": 136041
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "我也會",
    "voice": null,
    "unit_id": 136041
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "這麼想。",
    "voice": null,
    "unit_id": 136041
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "\\n",
    "voice": null,
    "unit_id": 136041
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "若是我被騎士先生的光芒照耀，",
    "voice": null,
    "unit_id": 136041
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "\\n是不是也能成為善良的存在？",
    "voice": null,
    "unit_id": 136041
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "只要有騎士先生在，",
    "voice": "vo_adv_9500088_007",
    "unit_id": 136041
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "\\n",
    "voice": null,
    "unit_id": 136041
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "只要",
    "voice": null,
    "unit_id": 136041
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "您看著我……",
    "voice": null,
    "unit_id": 136041
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "\\n",
    "voice": null,
    "unit_id": 136041
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "您讓我",
    "voice": null,
    "unit_id": 136041
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "能夠擁有這樣的希望……",
    "voice": null,
    "unit_id": 136041
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "還有，",
    "voice": "vo_adv_9500088_008",
    "unit_id": 136041
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "我被騎士先生拯救、",
    "voice": null,
    "unit_id": 136041
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "吸引，",
    "voice": null,
    "unit_id": 136041
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "傾慕於您，",
    "voice": null,
    "unit_id": 136041
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "\\n這個事實無論",
    "voice": null,
    "unit_id": 136041
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "發生什麼都不會改變。",
    "voice": null,
    "unit_id": 136041
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "我愛您，",
    "voice": "vo_adv_9500088_009",
    "unit_id": 136041
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "騎士先生。",
    "voice": null,
    "unit_id": 136041
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "\\n……愛到想把您吃下肚的地步……",
    "voice": null,
    "unit_id": 136041
  }
]
