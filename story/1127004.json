    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "在玩《小鎮 of The Dead》對吧？",
    "voice": null,
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "教教我們怎麼打倒黃金殭屍嘛。",
    "voice": "vo_adv_1127004_028",
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "這、",
    "voice": "vo_adv_1127004_029",
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "這些小鬼是怎麼回事啊。",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "剛才氣氛還不錯的說……",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "不要啦很麻煩耶。",
    "voice": "vo_adv_1127004_030",
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "你們別玩遊戲了，",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "回家唸書吧。",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "怎麼這樣～",
    "voice": "vo_adv_1127004_031",
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "大姐姐妳不是也在玩遊戲嗎。",
    "voice": null,
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "\\n",
    "voice": null,
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "拜託啦，",
    "voice": null,
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "來，",
    "voice": null,
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "這個閃亮亮的橡子給你們。",
    "voice": null,
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "唔，",
    "voice": "vo_adv_1127004_032",
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "花樣年華的女高中生怎麼會為了區區的橡子……",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "雖然這麼想，",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我卻莫名地會被吸引呢。",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "……知道了啦。",
    "voice": "vo_adv_1127004_033",
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我就連你們一起教吧。",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "太好了～！",
    "voice": "vo_adv_1127004_034",
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "謝謝妳大姐姐！",
    "voice": null,
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "先看我的，",
    "voice": "vo_adv_1127004_035",
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "從我的開始教！",
    "voice": null,
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "知道了知道了。",
    "voice": "vo_adv_1127004_036",
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "哦，",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "挺不錯的嘛。",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "比這邊的大哥哥還要會玩喔，",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "嘻嘻。",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好的，",
    "voice": "vo_adv_1127004_037",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "辛苦你了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我看鈴",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "似乎還是滿開心的呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不過，",
    "voice": "vo_adv_1127004_038",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "真沒想到鈴她居然會主動外出呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "因為至今為止看過太多她懶散的樣子了，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "真是讓我感慨萬千啊。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "唉，畢竟她其實只是怕麻煩，並不是真的是一個沒用的孩子，",
    "voice": "vo_adv_1127004_039",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n所以我想她總有一天能夠走到外面去的。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不過，",
    "voice": "vo_adv_1127004_040",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我想當她到了外面時，身邊有你的陪伴與否，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n會使她日後的人生產生巨大的差異。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你都一路和她一起努力到現在了，",
    "voice": "vo_adv_1127004_041",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n今後也繼續看著她吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那就這樣，",
    "voice": "vo_adv_1127004_042",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "再見囉～",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500151"
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "嗯，",
    "voice": "vo_adv_1127004_043",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "呼哇……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我好像",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "睡著了。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "居然會在外面睡著，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "再怎麼說也懶散過頭了。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "不過",
    "voice": "vo_adv_1127004_044",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "還真是奇怪的夢啊。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我夢到和你一起在外面玩遊戲。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "……夢裡的我",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "自己主動走到外面了，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "看起來好像很開心呢。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "{0}，我們先回房間一下吧。",
    "voice": "vo_adv_1127004_045",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "沒問題的，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我不會再逃跑了。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "background",
    "bg_id": "500156"
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我說，",
    "voice": "vo_adv_1127004_046",
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "委託書讓我看一下吧？",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "……嗯～",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "這份看起來最輕鬆呢。",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "然後再接下來是──",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "嗯～",
    "voice": "vo_adv_1127004_047",
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "真沒想到我會再次穿上這副鎧甲呢。",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "嗯，",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "有好好修理過了。",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "真不錯真不錯。",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "很可惜的，",
    "voice": "vo_adv_1127004_048",
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "橡子遊俠那個時候已經死了。",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "所以現在的我",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "就只是逃跑速度和偷懶習慣有經過強化的",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
