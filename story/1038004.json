[
  {
    "type": "background",
    "bg_id": "500150"
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "請別亂動。",
    "voice": "vo_adv_1038004_000",
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n你一動，我就會發射弓箭。",
    "voice": null,
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "……啊，",
    "voice": "vo_adv_1038004_001",
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "咦？",
    "voice": null,
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n{0}？",
    "voice": null,
    "unit_id": 103812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "你好。",
    "voice": "vo_adv_1038004_002",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "這樣弓矢相向，真對不起。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "最近……",
    "voice": "vo_adv_1038004_003",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n有些穿著打扮很少見的人在這附近的山林走動，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "所以我們有稍微加強戒備。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "是的。",
    "voice": "vo_adv_1038004_004",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我負責這座【伊麗莎白牧場】的警備。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "本來我是在這裡靜養的，但是沒事做也很無聊。",
    "voice": "vo_adv_1038004_005",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "受到她們諸多照顧，我也想報答這份恩惠。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "先不說這些了。\\n",
    "voice": "vo_adv_1038004_006",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "請問你來【伊麗莎白牧場】有什麼事嗎？",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "嗯。",
    "voice": "vo_adv_1038004_007",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n你是在散步，偶然地……走到這裡來的嗎？",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "是這樣呀。",
    "voice": "vo_adv_1038004_008",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "那麼",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "真是辛苦你了。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "可以的話，請你下次來時從正門進來。",
    "voice": "vo_adv_1038004_009",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "因為你跨越柵欄進來，我還以為你是魔物或山賊。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "話說回來，",
    "voice": "vo_adv_1038004_010",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n你還是走有好好鋪整過的道路比較好喔。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "這邊的路面凹凸不平，你要是跌倒了會滾到山坡下的。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "這樣你可是會受重傷喔。",
    "voice": "vo_adv_1038004_011",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "雖然牧場裡也有療養所，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "只要沒死的話還是有得救的機會。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "儘管如此，還是請你要小心點。",
    "voice": "vo_adv_1038004_012",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "啊，對不起。",
    "voice": "vo_adv_1038004_013",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我的年紀比較小，還這樣擺架子……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "但是，我很擔心你。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "啊？",
    "voice": "vo_adv_1038004_014",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "請、請你不要摸我的頭……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "雖然我是不討厭這樣，只是好癢喔。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "你是覺得我的耳朵很稀奇吧。",
    "voice": "vo_adv_1038004_015",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我姊姊也會說「我好喜歡妳這麼蓬鬆柔軟的樣子～」",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n每次見到我就會摸我的耳朵跟尾巴喔。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "是的。",
    "voice": "vo_adv_1038004_016",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "有個姊姊。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n她住在附近森林裡的",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "精靈族聚落裡。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "是的。",
    "voice": "vo_adv_1038004_017",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我的父親是獸人，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "母親是精靈族，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n因為遺傳的關係，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我們明明",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "是姊妹卻生成不同的種族。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我是獸人，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "姊姊是精靈族。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "所以我和姊姊到底有沒有血緣關係……",
    "voice": "vo_adv_1038004_018",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "之類的事。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n從我還很小的時候，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "就開始常常在意了。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "可是就算我們沒有血緣關係、種族不同……",
    "voice": "vo_adv_1038004_019",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我還是最喜歡姊姊了。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n不管發生什麼事，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "唯獨這點不會是假的。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "啊……",
    "voice": "vo_adv_1038004_020",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n你是不是在發光？",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "這是什麼，好刺眼！",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "猜猜我～是誰……？",
    "voice": "vo_adv_1038004_021",
    "unit_id": 103832
  },
  {
    "type": "background",
    "bg_id": "510260"
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "呵呵。",
    "voice": "vo_adv_1038004_022",
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n沒錯，就是我。",
    "voice": null,
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n{0}，你好。",
    "voice": null,
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "是的，我是柏崎栞。",
    "voice": "vo_adv_1038004_023",
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "你不知道嗎，我在這裡住院喔。",
    "voice": null,
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "難得會在醫院見到你呢。",
    "voice": "vo_adv_1038004_024",
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "你怎麼了，身體不舒服嗎。",
    "voice": null,
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n真令人擔心。",
    "voice": null,
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "嗯。",
    "voice": "vo_adv_1038004_025",
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "你是因為覺得好像有點感冒了，",
    "voice": null,
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n保險起見來看個醫生是吧。",
    "voice": null,
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "是的，初期治療很重要。",
    "voice": "vo_adv_1038004_026",
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n請你要保重身體喔，",
    "voice": null,
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "好乖好乖……♪",
    "voice": null,
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "咦、咦？",
    "voice": "vo_adv_1038004_027",
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n你為什麼稍微退開了……？",
    "voice": null,
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "對不起，是我表現得太親近了嗎？",
    "voice": null,
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "啊……你說要是把感冒傳染給我就糟了？",
    "voice": "vo_adv_1038004_028",
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "畢竟我的免疫力很弱呢。",
    "voice": null,
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "謝謝你的顧慮，不過這樣我會覺得有點寂寞♪",
    "voice": null,
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "呵呵。",
    "voice": "vo_adv_1038004_029",
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n你說我比平常還要亢奮？",
    "voice": null,
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "是的，你說得沒錯。",
    "voice": null,
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我今天覺得心情還不錯。",
    "voice": "vo_adv_1038004_030",
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n你覺得是為什麼呢？",
    "voice": null,
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "答～錯了。",
    "voice": "vo_adv_1038004_031",
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我的生日在十一月，還要過一陣子呢。",
    "voice": null,
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "咦，你說要辦慶生派對……？",
    "voice": "vo_adv_1038004_032",
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "不，那個，我是很開心啦。",
    "voice": null,
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "但是那時候我大概還在住院，",
    "voice": "vo_adv_1038004_033",
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n在醫院吵鬧會給院方添麻煩的。",
    "voice": null,
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "只要能像這樣，偶爾和你見面聊天……",
    "voice": "vo_adv_1038004_034",
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我就覺得很幸福了。",
    "voice": null,
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "對的，非常接近正確答案。",
    "voice": "vo_adv_1038004_035",
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "接下來會有好事發生呢。",
    "voice": null,
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "嘿嘿。",
    "voice": "vo_adv_1038004_036",
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n其實是我的姊姊等一下會來探病。",
    "voice": null,
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我記得，\\n你好像也認識姊姊吧。",
    "voice": "vo_adv_1038004_037",
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "因為我長期住院，",
    "voice": "vo_adv_1038004_038",
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n所以她偶爾會帶換洗衣物等各種必須物品來。",
    "voice": null,
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "姊姊都會趁著送東西過來的機會，",
    "voice": "vo_adv_1038004_039",
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n一直陪我聊天。",
    "voice": null,
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我非常期待這樣的時刻……♪",
    "voice": "vo_adv_1038004_040",
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我沒怎麼去上學，也沒有朋友。",
    "voice": "vo_adv_1038004_041",
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我與醫院外的聯繫，",
    "voice": null,
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n幾乎都是依靠姊姊。",
    "voice": null,
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "姊姊她替我",
    "voice": "vo_adv_1038004_042",
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n打開通往「醫院外面」這個異世界的門……",
    "voice": null,
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "對我而言，是這世界上最棒的魔法師。",
    "voice": null,
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "雖然姊姊也有自己的生活要過，",
    "voice": "vo_adv_1038004_043",
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n讓她常常來探病會讓我感到抱歉呢。",
    "voice": null,
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "但是，我果然還是覺得很開心。",
    "voice": null,
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "嘿嘿。",
    "voice": "vo_adv_1038004_044",
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n{0}如果願意的話，待會要不要加入我們？",
    "voice": null,
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "與你一起分享幸福……♪",
    "voice": null,
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "咦？你說你不想打擾我們姐妹相聚，",
    "voice": "vo_adv_1038004_045",
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n而且要是把感冒傳染給我們就糟糕了……？",
    "voice": null,
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "其實你不用這麼顧忌的。",
    "voice": null,
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "啊，姊姊來了。",
    "voice": "vo_adv_1038004_046",
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "總覺得她好像閉著眼睛在走路，",
    "voice": null,
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n她那樣子是清醒的嗎……？",
    "voice": null,
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "姊姊真是的，不論何時都讓人放不下心。",
    "voice": "vo_adv_1038004_047",
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "話說回來，",
    "voice": "vo_adv_1038004_048",
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n你如果願意的話只跟姊姊打個招呼也好。",
    "voice": null,
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "姊姊一定也會非常開心的。",
    "voice": "vo_adv_1038004_049",
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n因為她是一個能坦率地喜歡別人的人。",
    "voice": null,
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "喂～姊姊！",
    "voice": "vo_adv_1038004_050",
    "unit_id": 103832
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n這邊喔，我在這裡喔！",
    "voice": null,
    "unit_id": 103832
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "說到栞的姐姐，",
    "voice": "vo_adv_1038004_051",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n應該是指初音吧……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "雖說是將姐妹種族的不同歸因於父母種族不同，",
    "voice": "vo_adv_1038004_052",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不過這個理由總覺得是勉強編出來的。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好在唯獨她們的姐妹關係是個不變的事實。",
    "voice": "vo_adv_1038004_053",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n誰叫她們姐妹倆的感情這麼好。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "啊，抱歉。",
    "voice": "vo_adv_1038004_054",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我不小心就開始自言自語了……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "因為同樣的事情要不斷重複解釋，",
    "voice": "vo_adv_1038004_055",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n我也開始覺得麻煩了呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "但是，這是我的使命。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你剛剛看見的，是如同夢境一般的情景唷。",
    "voice": "vo_adv_1038004_056",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n所以沒關係，現在不用太在意哦，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n反正我想你醒來後就會忘得差不多的。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我想接下來我還會不斷地",
    "voice": "vo_adv_1038004_057",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n像這樣讓你做不可思議的夢……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "所以我說再多也沒用，你就做好心裡準備吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那麼，這次就先這樣，",
    "voice": "vo_adv_1038004_058",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n掰掰～♪",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "……啊，你醒來了。",
    "voice": "vo_adv_1038004_059",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "早安。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "background",
    "bg_id": "500150"
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "因為你突然就睡著了，害我嚇了一跳。",
    "voice": "vo_adv_1038004_060",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "不過我姊姊也是個在哪裡都能睡的人……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n所以我好像已經習慣這種事了。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "你一定是每天工作太疲勞了吧。",
    "voice": "vo_adv_1038004_061",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "如果沒有很要緊的事，就請你繼續休息吧。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n你就安穩地、好好地休息。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "啊，好的。",
    "voice": "vo_adv_1038004_062",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我的大腿借你躺。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我也不能讓你睡在荒郊野外，",
    "voice": "vo_adv_1038004_063",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "而且憑我的臂力也很難搬得動你。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "呵呵，覺得舒服嗎？",
    "voice": "vo_adv_1038004_064",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我的大腿也頗受姊姊好評喔。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "咦，{0}？",
    "voice": "vo_adv_1038004_065",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "難道又睡著了嗎……？",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "好乖、好乖。",
    "voice": "vo_adv_1038004_066",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n請你慢慢地休息吧，{0}。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "啊，總覺得這樣好平靜啊……",
    "voice": "vo_adv_1038004_067",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "雖然由我這樣說很不吉利，但這樣就好像在天堂呢。",
    "voice": null,
    "unit_id": 103811
  }
]
