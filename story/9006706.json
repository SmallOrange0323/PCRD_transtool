  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "要啊！！！",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n討厭章魚！！！",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "那種黏糊糊、濕漉漉的神明最討厭了～！！！！",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "他的精神完全沒平靜下來嘛！？",
    "voice": "vo_adv_9006706_021",
    "unit_id": 139811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "──無效化能力似乎產生了破綻。",
    "voice": "vo_adv_9006706_022",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
