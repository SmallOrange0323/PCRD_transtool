  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "世界將要毀滅的瞬間，",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "這個感覺──",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n還真是令人懷念啊。",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "當時雖然沒能",
    "voice": "vo_adv_9006706_001",
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "將LoA",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "燃燒殆盡。",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n但這次我將與幻境龍后一同，",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "連現實也一併──",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "徹底湮滅吧。",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "你出現了呢，",
    "voice": "vo_adv_9006706_002",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "彌勒……！",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "【幻變少女】的各位，",
    "voice": "vo_adv_9006706_003",
    "unit_id": 139811
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "請小心！",
    "voice": null,
    "unit_id": 139811
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n那傢伙是──",
    "voice": null,
    "unit_id": 139811
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "──我們知曉。",
    "voice": "vo_adv_9006706_004",
    "unit_id": 139512
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n以前我們還是「末端裝置」的時候，",
    "voice": null,
    "unit_id": 139512
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n他曾與美空小姐一起，",
    "voice": null,
    "unit_id": 139512
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "侍奉過厄莉絲小姐……",
    "voice": null,
    "unit_id": 139512
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "好久不見了呢……",
    "voice": "vo_adv_9006706_005",
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\nTYPE-R小姐。",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "P小姐。",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "Q小姐。",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n雖然妳們的模樣",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "看起來變了不少。",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "現在的我們，",
    "voice": "vo_adv_9006706_006",
    "unit_id": 139612
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "才不叫那種名字……！",
    "voice": null,
    "unit_id": 139612
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n要上了！",
    "voice": null,
    "unit_id": 139612
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "「「「光輝",
    "voice": "vo_adv_9006706_007",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "接戰！！」」」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "──「徒手祈禱」。",
    "voice": "vo_adv_9006706_008",
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "……！",
    "voice": "vo_adv_9006706_009",
    "unit_id": 139712
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n魔法，",
    "voice": null,
    "unit_id": 139712
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n被消除了。",
    "voice": null,
    "unit_id": 139712
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "還是一如既往，",
    "voice": "vo_adv_9006706_010",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "相當棘手的能力……！",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "嗯，",
    "voice": "vo_adv_9006706_011",
    "unit_id": 139811
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "而且……",
    "voice": null,
    "unit_id": 139811
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n……總覺得",
    "voice": null,
    "unit_id": 139811
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "有哪裡不太對勁。",
    "voice": null,
    "unit_id": 139811
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 139811
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "他和之前",
    "voice": null,
    "unit_id": 139811
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "相比……",
    "voice": null,
    "unit_id": 139811
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "稍微有點改變了吧？",
    "voice": null,
    "unit_id": 139811
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "咦？",
    "voice": "vo_adv_9006706_012",
    "unit_id": 139612
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n是那樣嗎？",
    "voice": null,
    "unit_id": 139612
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n雖然和我們所認識的那個人",
    "voice": null,
    "unit_id": 139612
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "沒什麼兩樣……",
    "voice": null,
    "unit_id": 139612
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "所謂滅卻心頭火自涼。",
    "voice": "vo_adv_9006706_013",
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "雪菲小姐──",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "我因為被妳和贊恩先生扔進海裡而冷靜了下來，",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n精神也就恢復平靜了。",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "是、",
    "voice": "vo_adv_9006706_014",
    "unit_id": 139811
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "是這樣嗎……？",
    "voice": null,
    "unit_id": 139811
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "──哎呀？",
    "voice": "vo_adv_9006706_015",
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "那邊那位，",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "不就是美空小姐嗎？",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n懷念的面孔齊聚一堂，",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "簡直就像是同學會呢。",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "……唉。",
    "voice": "vo_adv_9006706_016",
    "unit_id": 192012
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n老實說，我已經不想再有任何瓜葛了～",
    "voice": null,
    "unit_id": 192012
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "現在就是這種感覺。",
    "voice": null,
    "unit_id": 192012
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "順便連幻境龍后一起，",
    "voice": "vo_adv_9006706_017",
    "unit_id": 192012
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "做個大掃除吧★",
    "voice": null,
    "unit_id": 192012
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 192012
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "嘟嚕嚕嚕──",
    "voice": null,
    "unit_id": 192012
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "嗚啾！？",
    "voice": "vo_adv_9006706_018",
    "unit_id": 136911
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n叫偶嗎？",
    "voice": null,
    "unit_id": 136911
  },
  {
    "type": "dialogue",
