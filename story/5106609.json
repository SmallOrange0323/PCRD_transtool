  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在艾米的帶領下，{0}、茜里及純，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n走在充滿聖誕氛圍的蘭德索爾街道上。",
