[
  {
    "type": "background",
    "bg_id": "501470"
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "正月で賑わうランドソルの繁華街を、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "\\nモニカとメドゥーサは散策していた。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "こっちにも蛇、",
    "voice": "vo_adv_5160601_000",
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "あっちにも蛇。",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "お土産屋にも蛇。",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "\\n街中に蛇のモチーフがたくさん飾ってあるわ！",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "新年からみんなで蛇をまつるなんて、",
    "voice": "vo_adv_5160601_001",
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "\\nこの国は蛇の偉大さをちゃんと理解してるのね。",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "……感動に水を差すようで悪いのだが、",
    "voice": "vo_adv_5160601_002",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\nあくまで今年の干支が蛇だ、",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "というだけだぞ。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "来年以降はまた違う動物が飾られるのだ。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "え？　",
    "voice": "vo_adv_5160601_003",
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "それってどういうことなの？",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "──なるほど、",
    "voice": "vo_adv_5160601_004",
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "神様のレースに勝った12匹の動物を",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "\\n一年交代でまつってるのね。",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "なかなか面白い話だわ。",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "でも、",
    "voice": "vo_adv_5160601_005",
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "一つだけ納得いかないことがあるんだけど。",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "なんだ、",
    "voice": "vo_adv_5160601_006",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "なにが不満なのだ？",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "なんで蛇が一等賞じゃないのよ！",
    "voice": "vo_adv_5160601_007",
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "\\nそれも蛇を差し置いてネズミがトップ？",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "\\n",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "ネズミなんて蛇のエサじゃない！　",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "納得いかないわね。",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "いや、",
    "voice": "vo_adv_5160601_008",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "昔話に文句を言われてもな……",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "こういうのってどこに抗議すればいいのかしら？",
    "voice": "vo_adv_5160601_009",
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "\\n",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "しっかりと蛇の偉大さを伝えて、",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "毎年蛇をまつるようにすべきよ！",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "まずは落ち着くんだ。",
    "voice": "vo_adv_5160601_010",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "……いいか、",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "このレースが行われたのは寒い季節、",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "つまり蛇にとっては非常に厳しい条件だ。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "遅れるのも仕方ないだろう。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "そんなハンデをものともせず、",
    "voice": "vo_adv_5160601_011",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n並みいる動物たちを抑え十二支入りできたのだ。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "一位でなくとも蛇のすごさは十分に伝わっているはずだ。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "それに、",
    "voice": "vo_adv_5160601_012",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "毎年よりも12年に一度の方が",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\nレア度が高い。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "ありがたみも増すというものじゃないか？",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "……たしかに。",
    "voice": "vo_adv_5160601_013",
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "アンタの言うとおりね。",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "\\n",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "ふふん、",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "やっぱり蛇ってすごいじゃない！",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "ふぅ、",
    "voice": "vo_adv_5160601_014",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "どうにか納得してくれたようだな……",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "ねえ、",
    "voice": "vo_adv_5160601_015",
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "今気づいたんだけど、",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "蛇と龍って被ってない？",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "\\n",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "どっちか一方、",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "ていうか蛇だけでよくない？",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "\\nアンタはどう思うの、",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "メドゥーサ",
    "words": "モニカ？",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "あーもう！　",
    "voice": "vo_adv_5160601_016",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "困ったヤツだな！　",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "新たな火種が投げ込まれたことに頭を抱えるモニカだった。",
    "voice": null,
    "unit_id": null
  }
]
