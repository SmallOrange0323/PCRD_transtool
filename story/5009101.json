    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n和甜滋滋的蛋糕吧～♪",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "聖誕節還要再一陣子，",
    "voice": "vo_adv_5009101_001",
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "再忍耐一下吧……",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n現在要買其他的東西……",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "咦？",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "有、",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "有不認識的人倒在路上……！",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "真、",
    "voice": "vo_adv_5009101_002",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "真的耶！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n要救她才行！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "請問……！",
    "voice": "vo_adv_5009101_003",
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n妳、",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "妳沒事嗎……！？",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "……",
    "voice": "vo_adv_5009101_004",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "啊，",
    "voice": "vo_adv_5009101_005",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "她好像醒過來了！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "……",
    "voice": "vo_adv_5009101_006",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我是……",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "誰……？",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "綾音、胡桃、千歌",
    "words": "下一回，「忘却的頌歌」",
    "voice": "vo_adv_5009101_007",
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500023"
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "姊姊妳們……",
    "voice": "vo_adv_5009101_008",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是誰呢……？",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "姊姊……",
    "voice": "vo_adv_5009101_009",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "多麼美好的稱呼……！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n胡桃妳也不用害羞，就這樣子叫我喔♪",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "現、",
    "voice": "vo_adv_5009101_010",
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "現在不是說那個的時候吧……！",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n這個人",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "大概失去記憶了……",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n嗚嗚……",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "有誰快來幫忙呀……！",
    "voice": null,
    "unit_id": 108511
  }
