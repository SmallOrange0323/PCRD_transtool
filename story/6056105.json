  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "ハロウィン、",
    "voice": "vo_adv_6050105_000",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "仕立て屋の仕事が大忙しのありがたいイベント。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "でもこんな形で関わるのは初めてですね……",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "当たり前です。",
    "voice": "vo_adv_6050105_001",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "騎士さんが言い出したことですからね。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "た～っくさんコキ使いますからね。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "覚悟してください。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "なんでそんなにうれしそうなんですか？　",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "気味悪いですよ。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "ずいぶんと余裕じゃないですか。",
    "voice": "vo_adv_6050105_002",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "\\nまぁ、",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "嫌々やるものでもないですしね。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "うん、",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "楽しんでやっていきましょう。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "そもそも騎士さんが手伝うなんて言い出すからじゃないですか。",
    "voice": "vo_adv_6050105_003",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "でもまぁ",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "いいきっかけになったのも事実ですよね。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "せっかくなので",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "この機会を活かさせてもらいますよ。",
    "voice": null,
    "unit_id": 113911
  }
]
