[
  {
    "type": "background",
    "bg_id": "501031"
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "おせち料理の材料集めの旅も、",
    "voice": "vo_adv_5082451_000",
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "もう終わりね……",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "\\n",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "色々なことがあったから",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "ずいぶん長く感じたけれど、",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "\\n実際は",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "思っていたよりも短い期間だったのね。",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "一人旅ってのは",
    "voice": "vo_adv_5082451_001",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "どうしても考え事が多くなるからねえ。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "\\n長く感じちまうものさ。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "イリヤ",
    "words": "色々なことがあったのも",
    "voice": "vo_adv_5082451_002",
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "イリヤ",
    "words": "事実じゃがのう。",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "イリヤ",
    "words": "\\n",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "イリヤ",
    "words": "奪われた材料を取り返すのは",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "イリヤ",
    "words": "大変じゃったが……",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "あの時は",
    "voice": "vo_adv_5082451_003",
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "本当にありがとう。",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "\\n二人がいてくれて",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "本当に助かったわ。",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "イリヤ",
    "words": "気にするでないわ。",
    "voice": "vo_adv_5082451_004",
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "イリヤ",
    "words": "\\nわらわはいつもと違った面子での旅、",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "イリヤ",
    "words": "楽しかったぞ。",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "イリヤ",
    "words": "\\n",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "イリヤ",
    "words": "おせち料理も美味しかったしのう。",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "アタシも楽しかったよ。",
    "voice": "vo_adv_5082451_005",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "\\nこれまでしてきた一人旅とは",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "また違った風情があったしね。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "私も、",
    "voice": "vo_adv_5082451_006",
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "みんなと旅ができてよかったわ。",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "\\n",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "絶対に忘れたくない、",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "大切な思い出よ。",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "なら、",
    "voice": "vo_adv_5082451_007",
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "最後のひと踏ん張りといこうじゃないか。",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "さあ、",
    "voice": null,
    "unit_id": 120811
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "行くよ！",
    "voice": null,
    "unit_id": 120811
  }
]
