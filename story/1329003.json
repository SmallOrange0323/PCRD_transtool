    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "應、",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "應該是錯覺吧？",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n一定是這樣，",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "沒錯！",
    "voice": null,
    "unit_id": 132912
  },
