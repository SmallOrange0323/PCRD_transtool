    "unit_id": 717
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員1",
    "words": "\\n再來練腹肌！",
    "voice": null,
    "unit_id": 717
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員1",
    "words": "練背肌！",
    "voice": null,
    "unit_id": 717
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員1",
