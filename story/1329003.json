  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "聖誕節當天。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n伊緒為了表達對{0}平日的感謝之情",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n正在市集大道上尋找禮物。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "嗯……",
    "voice": "vo_adv_1329003_000",
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n一直在找禮物",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "不知不覺就到這個時間了。",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "結果，",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "{0}到底會想要什麼呢……？",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "作為教師贈送禮物的話，",
    "voice": "vo_adv_1329003_001",
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "果然還是參考書？",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "啊，不過",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "他最近正在認真研讀自己買的書呢。",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "雖然我猜不管送什麼禮物",
    "voice": "vo_adv_1329003_002",
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "他一定都會很高興，",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "但這樣反而沒辦法鎖定範圍……",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "到底該怎麼辦才好？",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "不要送物品，",
    "voice": "vo_adv_1329003_003",
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "而是送體驗呢……？",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "接下來一起去吃晚餐的話……",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "以師生關係來說也很奇怪……",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "乾脆，",
    "voice": "vo_adv_1329003_004",
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "把我自己當成禮物……？",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "不對，",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我到底在想些什麼啊。",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "真是的真是的！",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "……啊，",
    "voice": "vo_adv_1329003_005",
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "對了！",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "體驗的話，",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "不是有很適合的嗎♪",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "不知道他",
    "voice": "vo_adv_1329003_006",
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "會不會高興？",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n呵呵呵♪",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "background",
    "bg_id": "502270"
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "驚喜禮物～☆",
    "voice": "vo_adv_1329003_007",
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "呵呵，",
    "voice": "vo_adv_1329003_008",
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "有嚇到你嗎？",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "今晚呢，",
    "voice": "vo_adv_1329003_009",
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我想讓你體驗特別的校外教學，",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n所以就來夢中打擾了。",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "{0}一路上也學了很多，不停的在成長，",
    "voice": "vo_adv_1329003_010",
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n為了讓你考慮將來的事情，",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n我想讓你看看大家都是怎麼工作的。",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "首先是這裡！",
    "voice": "vo_adv_1329003_011",
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "沒錯，",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "大夢想樂園♪",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n是萊拉耶爾告訴我的。",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "怎麼樣？",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "有沒有感到很興奮？",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "呵呵，",
    "voice": "vo_adv_1329003_012",
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "太好了♪",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "那麼我們就馬上，",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "一邊遊玩，",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n一邊觀察工作人員們工作的模樣吧！",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "background",
    "bg_id": "502280"
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "其實，",
    "voice": "vo_adv_1329003_013",
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "和某人一起去遊樂園玩一直都是我的夢想！",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "在夢中實現了一個夢呢♪",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "啊啊～",
    "voice": "vo_adv_1329003_014",
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "該先從哪裡開始，真令人猶豫！",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "{0}有想要去的遊樂設施嗎？",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "推薦？",
    "voice": "vo_adv_1329003_015",
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n難道你",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "之前來過嗎？",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n……咦，",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "你之前在這裡幫忙過！？",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "哎呀，",
    "voice": "vo_adv_1329003_016",
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "原來是這樣！",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "你在這裡經歷了美好的體驗呢。",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "那麼，",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "就拜託你主導囉。",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "啊啊，",
    "voice": "vo_adv_1329003_017",
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "超開心的～♪",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n彷彿是到了阿斯特朗各地進行旅遊，",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n全程都讓人心跳加速、充滿期待！",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "當然了♪",
    "voice": "vo_adv_1329003_018",
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "跑出熟識的人型看板時候很令人驚訝，",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "而且產生了",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我也想去冒險的憧憬♪",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "……話說，",
    "voice": "vo_adv_1329003_019",
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "啊啊！？",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "對不起，我真是的，",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "完全忘記校外教學的事，",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n沉迷在遊樂設施了……",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "作為老師得認真一點才行！",
    "voice": "vo_adv_1329003_020",
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "接下來",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "就去能夠獲得珍貴體驗的地方吧！",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "background",
    "bg_id": "500790"
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "為了保護我們，",
    "voice": "vo_adv_1329003_021",
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "【王宮騎士團】的各位\\n每天都在進行訓練，",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "這我想你也知道。",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "今天就稍微",
    "voice": null,
    "unit_id": 132912
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "觀察一下訓練的模樣吧♪",
    "voice": null,
    "unit_id": 132912
  },
  {
