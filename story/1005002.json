  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "噫，",
    "voice": "vo_adv_1005002_034",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "聽到叫聲了！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n那危險的魔物，",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "就在這附近！",
