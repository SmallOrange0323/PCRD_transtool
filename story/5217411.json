  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "吃飽飽。",
    "voice": "vo_adv_5217411_000",
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n肚子脹脹。",
    "voice": null,
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n大快朵頤。",
    "voice": null,
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "小樂",
    "words": "噗嗚♪",
    "voice": "vo_adv_5217411_001",
    "unit_id": 9511
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "呵呵。",
    "voice": "vo_adv_5217411_002",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "普蕾西亞和小樂",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n都吃了很多呢♪",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "還有，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "莉莉也是……♪",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "……是呀。",
    "voice": "vo_adv_5217411_003",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n有很長一段時間……",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "沒有吃到璃亞的料理了，",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "嘴不禁停不下來。",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "仔細一想，",
    "voice": "vo_adv_5217411_004",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "畢竟來到這世界後，每天都吃妳煮的菜。",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "看來在不知不覺中，",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "身體和舌頭都習慣這味道了呢。",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "嗯。",
    "voice": "vo_adv_5217411_005",
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n媽媽的味道。",
    "voice": null,
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "咦咦！？",
    "voice": "vo_adv_5217411_006",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n媽媽",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "嗎……？",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "這、",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "這樣說或許……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "會不會有點太……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "可是。",
    "voice": "vo_adv_5217411_007",
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n習慣吃了。",
    "voice": null,
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n這點是，",
    "voice": null,
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "真的。",
    "voice": null,
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "所以。",
    "voice": "vo_adv_5217411_008",
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n到了「[rub:那邊]現實[/rub]」後，",
    "voice": null,
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "也想，",
    "voice": null,
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "再吃。",
    "voice": null,
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "可璃亞，",
    "voice": null,
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "煮的飯。",
    "voice": null,
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "普蕾西亞……",
    "voice": "vo_adv_5217411_009",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "…………",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "……好。",
    "voice": "vo_adv_5217411_010",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "即使回到「現實」──",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "也讓我們像這樣，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "大家一起吃飯吧……♪",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "璃亞……",
    "voice": "vo_adv_5217411_011",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "好的！",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n約定好了……！",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "當然。",
    "voice": "vo_adv_5217411_012",
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n哥。",
    "voice": null,
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n也一起，",
    "voice": null,
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "喔。",
    "voice": null,
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "呵呵……♪",
    "voice": "vo_adv_5217411_013",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n既然如此，我在另外一邊",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "也要用料理抓住哥哥的心囉♪",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "咦咦……！？",
    "voice": "vo_adv_5217411_014",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n璃亞……！？",
    "voice": null,
    "unit_id": 125812
  }
]
