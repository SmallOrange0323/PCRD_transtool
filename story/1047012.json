[
  {
    "type": "background",
    "bg_id": "500090"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "純在和{0}的約定時間之前，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n正進行著和前陣子相同的任務。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "因為今天會跟少年見面，",
    "voice": "vo_adv_1047012_000",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n希望可以盡可能避開工作……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "但是最近",
    "voice": "vo_adv_1047012_001",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "【王宮騎士團】整體都很忙碌，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n導致王宮的警備維持在最低限度這點很令人介意啊。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "雖然",
    "voice": "vo_adv_1047012_002",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "大家主動接手外面的任務很令人感謝，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n保險起見",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "來當作下次討論的議題吧……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "唉呀，",
    "voice": "vo_adv_1047012_003",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "光想著工作的事情，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n又差點趕不上約定的時間了。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n下次得注意不要遲到……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "團、",
    "voice": "vo_adv_1047012_004",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "團長！！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "怎麼了，",
    "voice": "vo_adv_1047012_005",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這麼慌張。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "今天沒有和新人團員在一起嗎？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "大、",
    "voice": "vo_adv_1047012_006",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "大事不妙！！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n我和新人一起",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "去森林幫忙討伐魔物，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n卻在那邊",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "遇到大量魔物……！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "大量魔物……？",
    "voice": "vo_adv_1047012_007",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "究竟為何？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "恐、",
    "voice": "vo_adv_1047012_008",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "恐怕是",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "魔物的巢穴……",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n新、",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "新人受傷了，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "正在往這裡逃跑。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n而我",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "則是為了呼叫救援",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "先一步回來。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……事情不妙啊。",
    "voice": "vo_adv_1047012_009",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "現在沒有可以馬上行動的團員。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n雖然只要發出召集，我想大家都會趕過來，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n但很花時間。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……總之，",
    "voice": "vo_adv_1047012_010",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我先過去現場。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n告訴我魔物從哪個方向過來。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n而你留在這邊",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "請求救援。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "我、",
    "voice": "vo_adv_1047012_011",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "我知道了！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "background",
    "bg_id": "500130"
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……是那邊嗎。",
    "voice": "vo_adv_1047012_012",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "魔物數量不尋常……",
    "voice": "vo_adv_1047012_013",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n該不會，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "在距離王都不遠的地方還有這樣的巢穴吧……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "團、",
    "voice": "vo_adv_1047012_014",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "團長……！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "很抱歉",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "事情變成這樣……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "快退下，",
    "voice": "vo_adv_1047012_015",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "把傷口包紮好。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n待在這裡很危險。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n在其他部隊抵達之前，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我會守在這裡。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "但、",
    "voice": "vo_adv_1047012_016",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "但是，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "這個數量……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "雖然有城門，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "\\n但還不知道會變成什麼樣……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "等待部隊過來比較好……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "沒這個時間了。",
    "voice": "vo_adv_1047012_017",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n怎麼，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你不相信\\n身為【王宮騎士團】團長的我嗎？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "唔、",
    "voice": "vo_adv_1047012_018",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "唔唔……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "\\n",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "很抱歉，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "團長……！！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "接下",
    "voice": "vo_adv_1047012_019",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "來……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "雖然虛張聲勢了，",
    "voice": "vo_adv_1047012_020",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "那個數量……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "能夠爭取多少時間呢。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n但是，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不管我會變得怎麼樣，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "都不能讓它們通過這裡。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……抱歉啊，少年。",
    "voice": "vo_adv_1047012_021",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n看來我是沒辦法前往約定的地點會合了。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n如果",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "有辦法聯繫的話，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "好想現在馬上告訴他這件事……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……呵呵。",
    "voice": "vo_adv_1047012_022",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "沒想到就算變成這種狀況，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n還會考慮這種事……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我也",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "變了啊。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "但是……",
    "voice": "vo_adv_1047012_023",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n也有不變的東西。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "身為【王宮騎士團】團長，",
    "voice": "vo_adv_1047012_024",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n在敵人面前",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "可不能退縮。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我該守護的東西就在這裡！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "喝啊！！",
    "voice": "vo_adv_1047012_025",
    "unit_id": 104711
  },
  {
    "type": "background",
    "bg_id": "500130"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "即使斬除了面前的魔物，",
    "voice": "vo_adv_1047012_026",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n馬上",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "就有其他魔物毫不畏懼地",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "衝過來……！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n沒有",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "喘息的空間……！　",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "background",
    "bg_id": "500130"
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "唔！？",
    "voice": "vo_adv_1047012_027",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這般猛烈攻擊……",
    "voice": "vo_adv_1047012_028",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "光是承受",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "就很費力了……！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n但是，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "要是不在這裡擋下，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n市民就會遭到危害……！　",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "background",
    "bg_id": "500130"
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "撐、住……！！",
    "voice": "vo_adv_1047012_029",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "還沒",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "爭取到",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "足夠的時間……！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n在大家抵達為止，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我得撐住……！　",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這股力量是……！",
    "voice": "vo_adv_1047012_030",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n為什麼",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你會在這個地方……！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "很危險，快退下！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "少年……",
    "voice": "vo_adv_1047012_031",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……堅持不做任何讓步啊。",
    "voice": "vo_adv_1047012_032",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n而且，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "雖然口頭上拒絕他的幫助，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我卻有某種安心感。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這樣的話──",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……我知道了。",
    "voice": "vo_adv_1047012_033",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我不會再勸阻了。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n希望你跟我一起",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "守護這裡！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "是啊。",
    "voice": "vo_adv_1047012_034",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n不管怎麼說，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "如果我在這裡倒下……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n不只是蘭德索爾的人們，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "少年也無法平安無事。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "在我身後",
    "voice": "vo_adv_1047012_035",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不只有蘭德索爾。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n還有少年。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "──喝啊啊啊啊啊啊啊啊！！",
    "voice": "vo_adv_1047012_036",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我……",
    "voice": "vo_adv_1047012_037",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "絕對不會在這裡倒下！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n不管是什麼邪魔歪道，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "都絕對不許通過這裡！！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這、",
    "voice": "vo_adv_1047012_038",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這是……！？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "彷彿像是和少年產生共鳴一般，",
    "voice": "vo_adv_1047012_039",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n從身體深處",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "湧上了強大力量……！　",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "好厲害……",
    "voice": "vo_adv_1047012_040",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "是至今為止都沒有過的力量……！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n這樣的話……　",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這種程度，",
    "voice": "vo_adv_1047012_041",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不管你們來幾隻都沒用……！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……不管你們怎麼攻擊，",
    "voice": "vo_adv_1047012_042",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "都不可能突破這個防禦。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n只要有我在，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "就別想通過這裡。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這也是……",
    "voice": "vo_adv_1047012_043",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "多虧有少年把力量借給我。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n謝謝你。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "然後……",
    "voice": "vo_adv_1047012_044",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "雖然不適合在這個時候說，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "今天真是抱歉。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n沒辦法去我們約定好的地方……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……這樣啊。",
    "voice": "vo_adv_1047012_045",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "下次……",
    "voice": "vo_adv_1047012_046",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗎。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n你在這個狀況下還願意相信我，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n跟我談論未來呢。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "正因為少年都會跟我說這種話……",
    "voice": "vo_adv_1047012_047",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n希望你",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "可以待在我的身邊。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n今後",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "也能待在我的身邊嗎？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……謝謝。",
    "voice": "vo_adv_1047012_048",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "多虧了你……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n絕對要",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "撐過這關的心情，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n變得更強烈了！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……來吧！",
    "voice": "vo_adv_1047012_049",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n任何攻擊都放馬過來！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n想通過這裡，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "就得先打倒我！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "魔物數量……",
    "voice": "vo_adv_1047012_050",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "在減少？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "該不會……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "團長！",
    "voice": "vo_adv_1047012_051",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "妳沒事吧！！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這樣啊。",
    "voice": "vo_adv_1047012_052",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "支援趕上了！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "接下來我們也會一起迎戰！！",
    "voice": "vo_adv_1047012_053",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "抵達現場的團員們聽好！",
    "voice": "vo_adv_1047012_054",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我們要在這裡阻止敵人，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "開闢生路！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n放心，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "由我來打頭陣！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "絕對不能退縮！",
    "voice": "vo_adv_1047012_055",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我們身後",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "有需要我們守護的人民！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n和我一起",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "展現【王宮騎士團】的力量吧！！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "background",
    "bg_id": "500130"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "純和{0}，以及援軍，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n一起成功趕跑魔物。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你還在這裡啊，",
    "voice": "vo_adv_1047012_056",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "少年。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n該不會受傷了嗎？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n……這樣啊，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "沒事就好。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯？",
    "voice": "vo_adv_1047012_057",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你問我還好嗎？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n雖然多少有受點傷，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "如你所見。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我能好端端地在這裡，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "也是多虧有少年你喔。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "但是，",
    "voice": "vo_adv_1047012_058",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "雖然我想幫忙善後，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n卻被強制要求該休息了……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n因此現在無事可做。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "話說，",
    "voice": "vo_adv_1047012_059",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "為什麼少年知道我在這裡？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n而且比救援還要早到……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "…………",
    "voice": "vo_adv_1047012_060",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "是新人團員說的嗎？",
    "voice": "vo_adv_1047012_061",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "是、",
    "voice": "vo_adv_1047012_062",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "是",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "的……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "我在公布欄前",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "碰到他的。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "\\n那個……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "真的很抱歉……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "我……",
    "voice": "vo_adv_1047012_063",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "已經",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "決定從【王宮騎士團】……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……你當初",
    "voice": "vo_adv_1047012_064",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "是為了什麼加入【王宮騎士團】的，\\n還記得嗎？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "要說為什麼……",
    "voice": "vo_adv_1047012_065",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "看到招募",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "就……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "\\n沒有什麼複雜的理由……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這樣啊。",
    "voice": "vo_adv_1047012_066",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我呢，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "是因為想成為",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "能夠守護別人的正義夥伴。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我想守護",
    "voice": "vo_adv_1047012_067",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "國家、人民，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "還有和平。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n這樣的日子如果能持續下去，我就很開心。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n你呢？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "……我",
    "voice": "vo_adv_1047012_068",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "也曾想要守護。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "\\n",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "但是……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……我只能說，",
    "voice": "vo_adv_1047012_069",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n不要想得太複雜，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "只要坦率面對就好了。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n你要更加珍惜自己真正的心情。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……抱歉。",
    "voice": "vo_adv_1047012_070",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我本來就不太會說話。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n說的這些似乎沒有什麼重點……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "不，",
    "voice": "vo_adv_1047012_071",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "沒這回事。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "\\n受到團長鼓勵，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "我……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "……那邊",
    "voice": "vo_adv_1047012_072",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "好像還需要幫忙，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "\\n我先過去了！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……好像打起精神了，太好了。",
    "voice": "vo_adv_1047012_073",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n說實話，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我還不確定是否真的有鼓勵到他。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……嗯。",
    "voice": "vo_adv_1047012_074",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "平常鼓勵了各種人的少年都這麼說，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n也許我真的做到了呢。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "珍惜自己真正的心情……",
    "voice": "vo_adv_1047012_075",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗎。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n既然都這麼說了，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我也該好好面對呢。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……呼。",
    "voice": "vo_adv_1047012_076",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "繼續戴著這個的話，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "會忍不住想蒙混過去呢……",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這個頭盔",
    "voice": "vo_adv_1047012_077",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "原本只是習慣性戴著，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "看來也變成隱藏表情、",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "隱藏心意的工具了。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "所以，",
    "voice": "vo_adv_1047012_078",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "如果要向你傳達真正的心意，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n還是把它拿下來比較好吧。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "也為了不要讓自己蒙混過去。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "少年……",
    "voice": "vo_adv_1047012_079",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "那個……",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n剛剛戰鬥時……",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你說了下次",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "再一起去玩，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "對嗎？",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……如果少年同意，",
    "voice": "vo_adv_1047012_080",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "可以現在就一起去玩嗎？",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "是認真想和你",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "一起出去玩。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "唔……",
    "voice": "vo_adv_1047012_081",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我的臉沒戴面具，如果被直直盯著看……",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不、",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "沒問題的。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我可不覺得難為情。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這次",
    "voice": "vo_adv_1047012_082",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我絕對會努力遵守約定的……",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "所以，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我希望……",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n你能看一看",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我是否能表現得像個普通女孩子。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我知道",
    "voice": "vo_adv_1047012_083",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這個要求很突然。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "所以，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "如果你有別的事",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "或是不感興趣，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n也可以拒絕──",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……謝謝你，",
    "voice": "vo_adv_1047012_084",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "少年。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n有沒有什麼想吃的……",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這種事等等再說。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我們快點",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "一起去玩吧！",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "雙頰染紅的純，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n牽起{0}的手走向街上。",
    "voice": null,
    "unit_id": null
  }
]
