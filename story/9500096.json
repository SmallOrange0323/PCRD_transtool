[
  {
    "type": "background",
    "bg_id": "509040"
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……這樣啊，",
    "voice": "vo_adv_9500096_000",
    "unit_id": 107041
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你要選我嗎。",
    "voice": null,
    "unit_id": 107041
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107041
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "嗯，",
    "voice": null,
    "unit_id": 107041
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "不出我所料呢。",
    "voice": null,
    "unit_id": 107041
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "當然啊，",
    "voice": "vo_adv_9500096_001",
    "unit_id": 107041
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你是屬於我的。",
    "voice": null,
    "unit_id": 107041
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n不可能有",
    "voice": null,
    "unit_id": 107041
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "其他選項。",
    "voice": null,
    "unit_id": 107041
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "不過，",
    "voice": "vo_adv_9500096_002",
    "unit_id": 107041
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你能自己找到答案……",
    "voice": null,
    "unit_id": 107041
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "還是值得讚許的。",
    "voice": null,
    "unit_id": 107041
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n不管是身為「親切的姐姐」，",
    "voice": null,
    "unit_id": 107041
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "還是身為「教師」。",
    "voice": null,
    "unit_id": 107041
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107041
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……只是。",
    "voice": null,
    "unit_id": 107041
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "在給出答案前，",
    "voice": "vo_adv_9500096_003",
    "unit_id": 107041
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我煩惱了約12秒。",
    "voice": null,
    "unit_id": 107041
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n所以……",
    "voice": null,
    "unit_id": 107041
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我給你打的分數是",
    "voice": null,
    "unit_id": 107041
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "65分，",
    "voice": null,
    "unit_id": 107041
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107041
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "看來有必要",
    "voice": null,
    "unit_id": 107041
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "判你進行祕密特訓作為處罰呢。",
    "voice": null,
    "unit_id": 107041
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "特訓的內容……",
    "voice": "vo_adv_9500096_004",
    "unit_id": 107041
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 107041
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "現在還是",
    "voice": null,
    "unit_id": 107041
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "祕密。",
    "voice": null,
    "unit_id": 107041
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n你有興趣嗎？",
    "voice": null,
    "unit_id": 107041
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你想知道的事，",
    "voice": "vo_adv_9500096_005",
    "unit_id": 107041
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "跟不想知道的事，",
    "voice": null,
    "unit_id": 107041
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我都會教給你。",
    "voice": null,
    "unit_id": 107041
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n由我親自教導，",
    "voice": null,
    "unit_id": 107041
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "毫無保留喔。",
    "voice": null,
    "unit_id": 107041
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "很期待……",
    "voice": "vo_adv_9500096_006",
    "unit_id": 107041
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "嗎。",
    "voice": null,
    "unit_id": 107041
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107041
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "真服了你，",
    "voice": null,
    "unit_id": 107041
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n這樣就算不上是處罰了……",
    "voice": null,
    "unit_id": 107041
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "算了，",
    "voice": "vo_adv_9500096_007",
    "unit_id": 107041
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這樣也好。",
    "voice": null,
    "unit_id": 107041
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107041
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你以後也",
    "voice": null,
    "unit_id": 107041
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "一直都是屬於我的，",
    "voice": null,
    "unit_id": 107041
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n因為你應該會展現出令人玩味的成長給我看吧──",
    "voice": null,
    "unit_id": 107041
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "今天就是開始。",
    "voice": "vo_adv_9500096_008",
    "unit_id": 107041
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107041
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "──來。",
    "voice": null,
    "unit_id": 107041
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "從第一次見面的那一天",
    "voice": "vo_adv_9500096_009",
    "unit_id": 107041
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "到今日之間，",
    "voice": null,
    "unit_id": 107041
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你成長了多少，",
    "voice": null,
    "unit_id": 107041
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107041
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "今後又會",
    "voice": null,
    "unit_id": 107041
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "如何成長。",
    "voice": null,
    "unit_id": 107041
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……展現給",
    "voice": "vo_adv_9500096_010",
    "unit_id": 107041
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "姐姐看看。",
    "voice": null,
    "unit_id": 107041
  }
]
