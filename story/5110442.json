[
  {
    "type": "background",
    "bg_id": "500013"
  },
  {
    "type": "dialogue",
    "name": "樂園守護者",
    "words": "──嘰喔喔喔喔喔！",
    "voice": null,
    "unit_id": 17111
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "打倒它了……？",
    "voice": "vo_adv_5110442_000",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "啊哈哈！",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "太好了，",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我們贏了！",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "是啊，",
    "voice": "vo_adv_5110442_001",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "辛苦了。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這是一場還算熱血沸騰的戰鬥。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n偶爾打場像這樣的架也不錯。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "哦，",
    "voice": "vo_adv_5110442_002",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "妳還這麼有幹勁啊？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n既然如此，我來當妳的對手！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我可是很強的喔！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "好啊，",
    "voice": "vo_adv_5110442_003",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "就是該這樣！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "那麼，我們再打一場吧？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "真是的，",
    "voice": "vo_adv_5110442_004",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我們好不容易打贏了，別這樣──！",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "開玩笑的啦。",
    "voice": "vo_adv_5110442_005",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "就算是打架狂的我也懂得察言觀色。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n因為戰鬥",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "還沒結束呢。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "是啊，",
    "voice": "vo_adv_5110442_006",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "引起這場騷動的傢伙還沒有被揍飛！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n我們的戰鬥",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這才剛要開始！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "矛依未，",
    "voice": "vo_adv_5110442_007",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "妳說了這句台詞就表示要結束了喔……",
    "voice": null,
    "unit_id": 102911
  }
]
