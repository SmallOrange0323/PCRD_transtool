  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n盆栽小花，",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "似乎還是沒辦法冷靜下來的樣子呢。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "這就表示",
    "voice": "vo_adv_5036322_001",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "我們身為偶像的心意，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "沒有辦法滿足盆栽小花的意思對吧……！",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "小凜、",
    "voice": "vo_adv_5036322_002",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "未央！",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "讓我們再更加更加努力吧！",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "那不是當然的嘛，島村村！",
    "voice": "vo_adv_5036322_003",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "嗯。",
    "voice": "vo_adv_5036322_004",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "畢竟還是想要",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "讓盆栽小花能夠認同我們。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "是的！",
    "voice": "vo_adv_5036322_005",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "就用【new generations】的全力，",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n好好地去面對它吧！",
    "voice": null,
    "unit_id": 112411
  }
