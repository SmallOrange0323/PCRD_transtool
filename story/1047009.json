  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "與霸瞳皇帝戰鬥而造成破壞的街頭在重建後的某日。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}正賣力做著送貨的打工。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "好了快點，",
    "voice": "vo_adv_1047009_000",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "來這邊！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "就、",
    "voice": "vo_adv_1047009_001",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "就算你這麼說……",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我只是在搬行李，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n什、",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "什麼事都沒做啊……",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "那",
    "voice": "vo_adv_1047009_002",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "你為什麼要東張西望？",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "這、",
    "voice": "vo_adv_1047009_003",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "這是、",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "因為、",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "那個……",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "幫、",
    "voice": "vo_adv_1047009_004",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "幫幫我！",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "\\n",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "我遇到了一點麻煩……",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "最近",
    "voice": "vo_adv_1047009_005",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "我剛到這附近開店，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "所以不太知道路……",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "\\n然後",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "就被說很可疑……",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "嗯、",
    "voice": "vo_adv_1047009_006",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "嗯……",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "\\n",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "話說回來，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "我好像在哪裡見過你……",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "\\n啊，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "你不就是開店時來幫忙的人嗎？",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "幫、",
    "voice": "vo_adv_1047009_007",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "幫幫我。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "\\n我、那個、很不擅長對付……",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "【王宮騎士團】，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "\\n沒辦法好好跟他們說話，所以現在很困擾。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "你們在說什麼悄悄話！",
    "voice": "vo_adv_1047009_008",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "對、",
    "voice": "vo_adv_1047009_009",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "對不起。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "\\n",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "但、",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "但是我真的沒有做什麼壞事……",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "知道了知道了。",
    "voice": "vo_adv_1047009_010",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "\\n到騎士團據點後我再問個清楚。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "\\n聽好了，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "抵抗的話我可不排除使用武力喔。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "原來你在這裡啊，",
    "voice": "vo_adv_1047009_011",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "少年。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "這次又是誰……",
    "voice": "vo_adv_1047009_012",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "團、",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "團長！？",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯，",
    "voice": "vo_adv_1047009_013",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你是……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "之前",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "剛加入我們的新人團員，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "是吧？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "是的！",
    "voice": "vo_adv_1047009_014",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "我在巡邏的時候",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "\\n看到了可疑人物，所以……！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……希望你",
    "voice": "vo_adv_1047009_015",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "稍微跟我說明一下事情經過。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……原來如此。",
    "voice": "vo_adv_1047009_016",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n這樣的話",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "就不需要特別帶回去問話了。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "但、",
    "voice": "vo_adv_1047009_017",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "但是……！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這間店的事情我聽少年說了，",
    "voice": "vo_adv_1047009_018",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n也確認過他手上的隨身物品，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "沒有什麼問題。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n真擔心的話，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "跟他一起去店裡就知道了吧。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "是、",
    "voice": "vo_adv_1047009_019",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "是……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "抱歉把你留在這裡。",
    "voice": "vo_adv_1047009_020",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "不、",
    "voice": "vo_adv_1047009_021",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "不會！",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "\\n",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "啊，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "那位幫忙的人，也謝謝你！",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "\\n",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "下次",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "再麻煩你送貨喔！",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "……真抱歉，",
    "voice": "vo_adv_1047009_022",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "團長。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "慎重行事並不是壞事。",
    "voice": "vo_adv_1047009_023",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n但是",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "採取過於壓迫的態度",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n不太好喔。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "現在",
    "voice": "vo_adv_1047009_024",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "也有些人不信任【王宮騎士團】。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n為了贏回信任，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我們每天都在努力著。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n所以，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "希望你在對市民偵訊的時候可以更慎重一些。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "是、",
    "voice": "vo_adv_1047009_025",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "是的……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "很抱歉。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "\\n保險起見，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "新人王宮騎士",
    "words": "我去看一下那名男子說的店家。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……抱歉啊，",
    "voice": "vo_adv_1047009_026",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "少年。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n沒有你的話，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n可能就會非法逮捕善良市民了。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "即使如此，受到了你的幫助也是不爭的事實。",
    "voice": "vo_adv_1047009_027",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n然後……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "其實我本來正在找少年你。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "最近，",
    "voice": "vo_adv_1047009_028",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "發生了很多事情，都沒有機會好好聊聊，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n所以想說能不能一起吃個飯。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n當然，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "也得是少年覺得沒問題的話……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "呵呵，",
    "voice": "vo_adv_1047009_029",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "看起來沒問題呢。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n今天我們都有工作……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n也是呢，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "等到下次我休假的時候比較好吧？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "由我提出邀約卻還要你配合我的時間……",
    "voice": "vo_adv_1047009_030",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n雖然很抱歉，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "但如果可以的話就太好了。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "最近",
    "voice": "vo_adv_1047009_031",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "任務本身雖然告了一段落，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n但仍是人手不足……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "哎呀，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "下次再跟你好好聊一聊吧。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n那麼，少年，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "近期見。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "幾天後。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}抵達了和純約定的地點，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n但到了約定時間，純卻還沒有出現。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "抱、",
    "voice": "vo_adv_1047009_032",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "抱歉。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n剛剛有點忙，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "就遲到了……",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯？",
    "voice": "vo_adv_1047009_033",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "噢，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你問我這身裝扮啊……",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "雖然今天是休假，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "但想說距離約定時間還有一段空檔，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我就做了些工作。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "其實",
    "voice": "vo_adv_1047009_034",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我原本是想換好衣服再過來的，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n但後來時間變得不夠充裕，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "所以就直接過來了。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "難得",
    "voice": "vo_adv_1047009_035",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "久違地和少年說話，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "本想用更普通的裝扮來的……",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "因此，拿掉頭盔",
    "voice": "vo_adv_1047009_036",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "算是我的誠意，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n你要是能這樣想，我會很開心的。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "咦？",
    "voice": "vo_adv_1047009_037",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "在那裡的是團長嗎？",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n在這個地方做什麼……",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "咦？",
    "voice": "vo_adv_1047009_038",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "團、",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "團團團團長和男人在一起！？",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n該、",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "該不會，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "是在約會……！？",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "咦？",
    "voice": "vo_adv_1047009_039",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不是……",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "也、",
    "voice": "vo_adv_1047009_040",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "也是，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "不會有這種事呢。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n應該是什麼特殊的任務吧。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n抱歉",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "打擾兩位了……",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "我先告辭！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……沒想到會被誤會在約會呢。",
    "voice": "vo_adv_1047009_041",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "少年和我……？",
    "voice": "vo_adv_1047009_042",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……不行不行，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我不可以",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "抱著奇怪的想法。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……果、",
    "voice": "vo_adv_1047009_043",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "果然穿著鎧甲太顯眼了呢。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n快點進去店裡吧，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "少年。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "background",
    "bg_id": "500050"
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "那麼，",
    "voice": "vo_adv_1047009_044",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "先讓我好好為上次那件事向你道謝。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "謝謝你，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "少年。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "那時真的幫了大忙。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "現在",
    "voice": "vo_adv_1047009_045",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "【王宮騎士團】正在重新編組，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n團內和貴族勾結的問題終於整頓好了。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "所以，",
    "voice": "vo_adv_1047009_046",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "目前就連讓還沒受到完整訓練的人才執行任務，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n都仍是人手不足。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "當然，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "大家都很努力……",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "原本團裡",
    "voice": "vo_adv_1047009_047",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "就人手不足了，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n也明白重新編組的話會變成這樣的狀況……",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n但也無法放任問題繼續拖沓。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "在這個狀況下，",
    "voice": "vo_adv_1047009_048",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "無法將每個成員訓練到位，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n也是沒辦法的事……",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "雖說如此，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這也只是藉口呢。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "讓市民感到不安，真的是萬分慚愧。",
    "voice": "vo_adv_1047009_049",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "正因如此，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我才想避免剛才那種事情發生，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n以防造成市民多餘的不安。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "騎士團好不容易能夠發揮應有的作用了，",
    "voice": "vo_adv_1047009_050",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n但現況真是令人無地自容……",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "啊，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "真抱歉，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "忍不住就發了牢騷呢。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "雖然",
    "voice": "vo_adv_1047009_051",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "還得再請人民忍耐一陣子，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n不過狀況正在一點一點改善，所以沒問題的。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "所以少年你也不需要這麼不安……",
    "voice": "vo_adv_1047009_052",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "咦？",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不是嗎？",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n那你在擔心什麼呢？",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "！！",
    "voice": "vo_adv_1047009_053",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這樣",
    "voice": "vo_adv_1047009_054",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "啊……",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "沒有事能瞞得住少年你呢。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "也並不是",
    "voice": "vo_adv_1047009_055",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "很辛苦。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "只是，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我……",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "明明是為了守護國家行動的，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "回過神來，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "卻發現自己是被利用了。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "比起後悔，",
    "voice": "vo_adv_1047009_056",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我曉得自己有更該做的事。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n即使如此，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "腦海裡偶爾還是會浮現這種想法。",
    "voice": null,
