    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "話雖這麼說，",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "因為積雪的關係這路不太好走。",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "小子，",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "你可要小心一點喔？",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "　你看起來是最有可能跌倒的人……♪",
