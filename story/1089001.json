[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在迎接新年的蘭德索爾，\\n{0}走在路上，四處張望時遇上了怜。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "嗨，",
    "voice": "vo_adv_1089001_000",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是你啊。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "雖然已經說過很多次了，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不過還是再一次。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "祝你新年快樂。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "但現在不是打招呼的時候了。",
    "voice": "vo_adv_1089001_001",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不好意思。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "因為我在趕時間，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "下次再慢慢跟你聊──",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不是，",
    "voice": "vo_adv_1089001_002",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是別人在找我。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我剛從老家的宴會裡逃出來呢。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我在各大名門貴族眼裡看起來，",
    "voice": "vo_adv_1089001_003",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是很吸引他們的招牌。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "要應付來來去去，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "還一臉假惺惺笑著的那些人，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "真的很讓人困擾。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "光是昨天就見過太多人，",
    "voice": "vo_adv_1089001_004",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "身體撐不住之前，精神方面就先投降了。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "雖然我不像日和那樣，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "但也已經精疲力盡了。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "要是換成你待在那種地方，",
    "voice": "vo_adv_1089001_005",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n肯定也會跟我一樣想逃出來的……",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "對了。",
    "voice": "vo_adv_1089001_006",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "雖然有點突然，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "但陪我躲一下吧。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n現在",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我正要去我們的公會小屋。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就這麼決定了。",
    "voice": "vo_adv_1089001_007",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "移動時盡量別引人注意吧。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "background",
    "bg_id": "500040"
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "沒有人在……",
    "voice": "vo_adv_1089001_008",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "也是呢。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "優衣回老家幫忙，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "日和在忙動物苑的事。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "來這裡沒有遇到她們兩人，真是久違了……",
    "voice": "vo_adv_1089001_009",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "平常總是很熱鬧的……",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "明明逃出了吵鬧的地方，",
    "voice": "vo_adv_1089001_010",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n來到這裡卻因為沒有人而感到寂寞……",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我也真奇怪呢。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……可以",
    "voice": "vo_adv_1089001_011",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "坐你旁邊嗎。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "呼……",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……果然這裡能讓人安心呢。",
    "voice": "vo_adv_1089001_012",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "總算能夠放鬆了。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "老家總是讓我精神緊繃，",
    "voice": "vo_adv_1089001_013",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "幾乎就要窒息了。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n什麼達官顯貴一個又一個不斷上門，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "還要聽他們長篇大論……",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "從死板的問候開場，",
    "voice": "vo_adv_1089001_014",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "披著過剩謙虛的傲慢。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "還有",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "完全沒真實感的吹捧，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我就一直被迫聽著這些交談。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "表面上裝得謙遜，",
    "voice": "vo_adv_1089001_015",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n背地裡卻計畫著如何把對方從現在的位置上扯下來……",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "貴族什麼的，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不過是遠比魔物低劣的",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "一群魑魅魍魎啊。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "而一想到我也是",
    "voice": "vo_adv_1089001_016",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那些傢伙的其中之一……",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我的話說完了。",
    "voice": "vo_adv_1089001_017",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "換我聽你說吧。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "昨天你在做些什麼？",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "跟優衣去搗麻糬嗎……",
    "voice": "vo_adv_1089001_018",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "好像很好玩。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "而且",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "一聽到食物的話題，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "肚子就餓起來了……",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "新年的料理，",
    "voice": "vo_adv_1089001_019",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "應該還有剩吧……",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我去廚房看看。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "真羨慕優衣呢。",
    "voice": "vo_adv_1089001_020",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "如果是我跟他一起，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n過著這種平穩日常的話──",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "嗯……？",
    "voice": "vo_adv_1089001_021",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "請問是哪位？",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "不好意思，",
    "voice": "vo_adv_1089001_022",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我是來委託事情的……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "正值新年的跑來委託，",
    "voice": "vo_adv_1089001_023",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "應該是有什麼大麻煩……",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "外面很冷，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "準備個紅茶招待吧。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你啊。",
    "voice": "vo_adv_1089001_024",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不好意思，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "能幫我帶委託人進來嗎？",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "background",
    "bg_id": "500040"
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "衝進去！",
    "voice": "vo_adv_1089001_025",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "什麼！？",
    "voice": "vo_adv_1089001_026",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "發現目標！",
    "voice": "vo_adv_1089001_027",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是追兵！？",
    "voice": "vo_adv_1089001_028",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那個人竟然做到這種地步！",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "太大意了──！！",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "女追兵",
    "words": "抓起來！",
    "voice": "vo_adv_1089001_029",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女追兵",
    "words": "喝！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "嗚！糟糕……！",
    "voice": "vo_adv_1089001_030",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "抓到目標。",
    "voice": "vo_adv_1089001_031",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "立刻撤離。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "怜小姐。",
    "voice": "vo_adv_1089001_032",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "請原諒我的無禮。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "\\n",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "老爺正在找您，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男追兵",
