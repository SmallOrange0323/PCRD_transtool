  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "宵の口……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "祭囃子が響くオーエド町の横丁に、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "\\n浴衣姿の一団が集まっていた。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ユイ",
    "words": "それにしても、",
    "voice": "vo_adv_0001004_000",
    "unit_id": 51812
  },
  {
    "type": "dialogue",
    "name": "ユイ",
    "words": "すごい偶然だね！",
    "voice": null,
    "unit_id": 51812
  },
  {
    "type": "dialogue",
    "name": "ミサト",
    "words": "ふふ、",
    "voice": "vo_adv_0001004_001",
    "unit_id": 51912
  },
  {
    "type": "dialogue",
    "name": "ミサト",
    "words": "それはこっちのセリフよ～",
    "voice": null,
    "unit_id": 51912
  },
  {
    "type": "dialogue",
    "name": "ミサト",
    "words": "\\n",
    "voice": null,
    "unit_id": 51912
  },
  {
    "type": "dialogue",
    "name": "ミサト",
    "words": "なんだか浴衣の似合う、",
    "voice": null,
    "unit_id": 51912
  },
  {
    "type": "dialogue",
    "name": "ミサト",
    "words": "見覚えのある子がいるな、",
    "voice": null,
    "unit_id": 51912
  },
  {
    "type": "dialogue",
    "name": "ミサト",
    "words": "\\nって思ってたんだけど、",
    "voice": null,
    "unit_id": 51912
  },
  {
    "type": "dialogue",
    "name": "ミサト",
    "words": "まさかあなたたちだったなんて。",
    "voice": null,
    "unit_id": 51912
  },
  {
    "type": "dialogue",
    "name": "ユイ",
    "words": "あ、",
    "voice": "vo_adv_0001004_002",
    "unit_id": 51812
  },
  {
    "type": "dialogue",
    "name": "ユイ",
    "words": "ありがとうございます……",
    "voice": null,
    "unit_id": 51812
  },
  {
    "type": "dialogue",
    "name": "ユイ",
    "words": "\\n",
    "voice": null,
    "unit_id": 51812
  },
  {
    "type": "dialogue",
    "name": "ユイ",
    "words": "ミサト先生も、",
    "voice": null,
    "unit_id": 51812
  },
  {
    "type": "dialogue",
    "name": "ユイ",
    "words": "すごく似合ってます！",
    "voice": null,
    "unit_id": 51812
  },
  {
    "type": "dialogue",
    "name": "ミサト",
    "words": "ふふ、",
    "voice": "vo_adv_0001004_003",
    "unit_id": 51912
  },
  {
    "type": "dialogue",
    "name": "ミサト",
    "words": "ありがとうね。",
    "voice": null,
    "unit_id": 51912
  },
  {
    "type": "dialogue",
    "name": "ミサト",
    "words": "\\n",
    "voice": null,
    "unit_id": 51912
  },
  {
    "type": "dialogue",
    "name": "ミサト",
    "words": "それで、",
    "voice": null,
    "unit_id": 51912
  },
  {
    "type": "dialogue",
    "name": "ミサト",
    "words": "ユイちゃんはどうしてこのツアーに？",
    "voice": null,
    "unit_id": 51912
  },
  {
    "type": "dialogue",
    "name": "ユイ",
    "words": "わたしは、",
    "voice": "vo_adv_0001004_004",
    "unit_id": 51812
  },
  {
    "type": "dialogue",
    "name": "ユイ",
    "words": "レイちゃんが",
    "voice": null,
    "unit_id": 51812
  },
  {
    "type": "dialogue",
    "name": "ユイ",
    "words": "オーエド町で食べたお料理が",
    "voice": null,
    "unit_id": 51812
  },
  {
    "type": "dialogue",
    "name": "ユイ",
    "words": "\\nおいしかったって聞いて……",
    "voice": null,
    "unit_id": 51812
  },
  {
    "type": "dialogue",
    "name": "ユイ",
    "words": "気になってたところに",
    "voice": "vo_adv_0001004_005",
    "unit_id": 51812
  },
  {
    "type": "dialogue",
    "name": "ユイ",
    "words": "\\nこのツアーを見つけたんです。",
    "voice": null,
    "unit_id": 51812
  },
  {
    "type": "dialogue",
    "name": "ミサト",
    "words": "そうなのね～、",
    "voice": "vo_adv_0001004_006",
    "unit_id": 51912
  },
  {
    "type": "dialogue",
    "name": "ミサト",
    "words": "私は",
    "voice": null,
    "unit_id": 51912
  },
  {
    "type": "dialogue",
    "name": "ミサト",
    "words": "近くにお世話になった温泉宿があるから",
    "voice": null,
    "unit_id": 51912
  },
  {
    "type": "dialogue",
    "name": "ミサト",
    "words": "\\nたまには挨拶でもしに行こうって思って参加したの。",
    "voice": null,
    "unit_id": 51912
  },
  {
    "type": "dialogue",
    "name": "ミサト",
    "words": "\\n",
    "voice": null,
    "unit_id": 51912
  },
  {
    "type": "dialogue",
    "name": "ミサト",
    "words": "あなたは？",
    "voice": null,
    "unit_id": 51912
  },
  {
    "type": "dialogue",
    "name": "ユカリ",
    "words": "うんうん、",
    "voice": "vo_adv_0001004_007",
    "unit_id": 51712
  },
  {
    "type": "dialogue",
    "name": "ユカリ",
    "words": "大正解。",
    "voice": null,
    "unit_id": 51712
  },
  {
    "type": "dialogue",
    "name": "ユカリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 51712
  },
  {
    "type": "dialogue",
    "name": "ユカリ",
    "words": "このオーエド夏祭りツアーに参加したあなたたち、",
    "voice": null,
    "unit_id": 51712
  },
  {
    "type": "dialogue",
    "name": "ユカリ",
    "words": "\\n本当にツイてるわよ。",
    "voice": null,
    "unit_id": 51712
  },
  {
    "type": "dialogue",
    "name": "ミサト",
    "words": "あら、",
    "voice": "vo_adv_0001004_008",
    "unit_id": 51912
  },
  {
    "type": "dialogue",
    "name": "ミサト",
    "words": "ユカリさんまで♪",
    "voice": null,
    "unit_id": 51912
  },
  {
    "type": "dialogue",
    "name": "ミサト",
    "words": "\\n",
    "voice": null,
    "unit_id": 51912
  },
  {
    "type": "dialogue",
    "name": "ミサト",
    "words": "でも、",
    "voice": null,
    "unit_id": 51912
  },
  {
    "type": "dialogue",
    "name": "ミサト",
    "words": "夏祭りなんて参加するのは初めてだから",
    "voice": null,
    "unit_id": 51912
  },
  {
    "type": "dialogue",
    "name": "ミサト",
    "words": "\\n",
    "voice": null,
    "unit_id": 51912
  },
  {
    "type": "dialogue",
    "name": "ミサト",
    "words": "どうすればいいのかわからないの。",
    "voice": null,
    "unit_id": 51912
  },
  {
    "type": "dialogue",
    "name": "ユカリ",
    "words": "だーいじょうぶ！",
    "voice": "vo_adv_0001004_009",
    "unit_id": 51712
  },
  {
    "type": "dialogue",
    "name": "ユカリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 51712
  },
  {
    "type": "dialogue",
    "name": "ユカリ",
    "words": "ここは『夏祭りマイスター』兼",
    "voice": null,
    "unit_id": 51712
  },
  {
    "type": "dialogue",
    "name": "ユカリ",
    "words": "『麦しゅわの聖騎士』の",
    "voice": null,
    "unit_id": 51712
  },
  {
    "type": "dialogue",
    "name": "ユカリ",
    "words": "\\nユカリお姉さんに",
    "voice": null,
    "unit_id": 51712
  },
  {
    "type": "dialogue",
    "name": "ユカリ",
    "words": "まっかせーなさいっ♪",
    "voice": null,
    "unit_id": 51712
  },
  {
    "type": "dialogue",
    "name": "ユイ",
    "words": "あ、",
    "voice": "vo_adv_0001004_010",
    "unit_id": 51812
  },
  {
    "type": "dialogue",
    "name": "ユイ",
    "words": "そういえば……",
    "voice": null,
    "unit_id": 51812
  },
  {
    "type": "dialogue",
    "name": "ユイ",
    "words": "このツアーって",
    "voice": null,
    "unit_id": 51812
  },
  {
    "type": "dialogue",
    "name": "ユイ",
    "words": "【メルクリウス財団】が主催だし、",
    "voice": null,
    "unit_id": 51812
  },
  {
    "type": "dialogue",
    "name": "ユイ",
    "words": "\\nマイスターってことは……",
    "voice": null,
    "unit_id": 51812
  },
  {
    "type": "dialogue",
    "name": "ユイ",
    "words": "もしかして、",
    "voice": null,
    "unit_id": 51812
  },
  {
    "type": "dialogue",
    "name": "ユイ",
    "words": "お仕事ですか？",
    "voice": null,
    "unit_id": 51812
  },
  {
    "type": "dialogue",
    "name": "ユカリ",
    "words": "いいえ！　",
    "voice": "vo_adv_0001004_011",
    "unit_id": 51712
  },
  {
    "type": "dialogue",
    "name": "ユカリ",
    "words": "完ッ",
    "voice": null,
    "unit_id": 51712
  },
  {
    "type": "dialogue",
    "name": "ユカリ",
    "words": "全にプライベートよ！",
    "voice": null,
    "unit_id": 51712
  },
  {
    "type": "dialogue",
    "name": "ユカリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 51712
  },
  {
    "type": "dialogue",
    "name": "ユカリ",
    "words": "大人には……",
    "voice": null,
    "unit_id": 51712
  },
  {
    "type": "dialogue",
    "name": "ユカリ",
    "words": "なんだかおいしいものを食べなきゃ",
    "voice": null,
    "unit_id": 51712
  },
  {
    "type": "dialogue",
    "name": "ユカリ",
    "words": "\\nやってらんないって時があるのよ……",
    "voice": null,
    "unit_id": 51712
  },
  {
    "type": "dialogue",
    "name": "ミサト",
    "words": "うんうん、",
    "voice": "vo_adv_0001004_012",
    "unit_id": 51912
  },
  {
    "type": "dialogue",
    "name": "ミサト",
    "words": "そうよねえ。",
    "voice": null,
    "unit_id": 51912
  },
  {
    "type": "dialogue",
    "name": "ミサト",
    "words": "\\nユカリさんは",
    "voice": null,
    "unit_id": 51912
  },
  {
    "type": "dialogue",
    "name": "ミサト",
    "words": "いつもお仕事を頑張ってて",
    "voice": null,
    "unit_id": 51912
  },
  {
    "type": "dialogue",
    "name": "ミサト",
    "words": "偉いわぁ。",
    "voice": null,
    "unit_id": 51912
  },
  {
    "type": "dialogue",
    "name": "ユカリ",
    "words": "う",
    "voice": "vo_adv_0001004_013",
    "unit_id": 51712
  },
  {
    "type": "dialogue",
    "name": "ユカリ",
    "words": "うっ、",
    "voice": null,
    "unit_id": 51712
  },
  {
    "type": "dialogue",
    "name": "ユカリ",
    "words": "ミサトさんの母性が染みるぅ……",
    "voice": null,
    "unit_id": 51712
  },
  {
    "type": "dialogue",
    "name": "ユカリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 51712
  },
  {
    "type": "dialogue",
    "name": "ユカリ",
    "words": "って、",
    "voice": null,
    "unit_id": 51712
  },
  {
    "type": "dialogue",
    "name": "ユカリ",
    "words": "今はそれどころじゃないわ。",
    "voice": null,
    "unit_id": 51712
  },
  {
    "type": "dialogue",
    "name": "ユカリ",
    "words": "\\n夏祭りの楽しみ方、",
    "voice": null,
    "unit_id": 51712
  },
  {
    "type": "dialogue",
    "name": "ユカリ",
    "words": "ばっちり教えてあげる♪",
    "voice": null,
    "unit_id": 51712
  },
  {
    "type": "dialogue",
    "name": "ユイ",
    "words": "は、",
    "voice": "vo_adv_0001004_014",
    "unit_id": 51812
  },
  {
    "type": "dialogue",
    "name": "ユイ",
    "words": "はい！",
    "voice": null,
    "unit_id": 51812
  },
  {
    "type": "dialogue",
    "name": "ユイ",
    "words": "\\n",
    "voice": null,
    "unit_id": 51812
  },
  {
    "type": "dialogue",
    "name": "ユイ",
    "words": "お願いします！",
    "voice": null,
    "unit_id": 51812
  },
  {
    "type": "dialogue",
    "name": "ユカリ",
    "words": "まずはこの屋台ね！　",
    "voice": "vo_adv_0001004_015",
    "unit_id": 51712
  },
  {
    "type": "dialogue",
    "name": "ユカリ",
    "words": "こちらはうちのギルドが素材を卸してる",
    "voice": null,
    "unit_id": 51712
  },
  {
    "type": "dialogue",
    "name": "ユカリ",
    "words": "\\n【シルバーオクトパス商会】さんが出店しているから、",
    "voice": null,
    "unit_id": 51712
  },
  {
    "type": "dialogue",
    "name": "ユカリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 51712
  },
  {
    "type": "dialogue",
    "name": "ユカリ",
    "words": "お値段がお手頃なうえにクオリティが高いのよ。",
    "voice": null,
    "unit_id": 51712
  },
  {
    "type": "dialogue",
    "name": "ユカリ",
    "words": "特にたこ焼と、",
    "voice": "vo_adv_0001004_016",
    "unit_id": 51712
  },
  {
    "type": "dialogue",
    "name": "ユカリ",
    "words": "鉄板を使った料理が絶品なのよね。",
    "voice": null,
    "unit_id": 51712
  },
  {
    "type": "dialogue",
    "name": "ユカリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 51712
  },
  {
    "type": "dialogue",
    "name": "ユカリ",
    "words": "ぜったい後悔させないから、",
    "voice": null,
    "unit_id": 51712
  },
  {
    "type": "dialogue",
    "name": "ユカリ",
    "words": "期待していいわよ～！",
    "voice": null,
    "unit_id": 51712
  },
  {
    "type": "dialogue",
    "name": "ユイ",
    "words": "ごくり……",
    "voice": "vo_adv_0001004_017",
    "unit_id": 51812
  },
  {
    "type": "dialogue",
    "name": "ユイ",
    "words": "とっても気になります！",
    "voice": null,
    "unit_id": 51812
  },
  {
    "type": "dialogue",
    "name": "ミサト",
    "words": "ふふっ、",
    "voice": "vo_adv_0001004_018",
    "unit_id": 51912
  },
  {
    "type": "dialogue",
    "name": "ミサト",
    "words": "素敵ね～",
    "voice": null,
    "unit_id": 51912
  },
  {
    "type": "dialogue",
    "name": "ミサト",
    "words": "\\n",
    "voice": null,
    "unit_id": 51912
  },
  {
    "type": "dialogue",
    "name": "ミサト",
    "words": "それじゃあ、",
    "voice": null,
    "unit_id": 51912
  },
  {
    "type": "dialogue",
    "name": "ミサト",
    "words": "さっそく屋台に行ってみましょうか。",
    "voice": null,
    "unit_id": 51912
  },
  {
    "type": "dialogue",
    "name": "ユカリ・ユイ",
    "words": "はーい！",
    "voice": "vo_adv_0001004_019",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "こうして、夏祭りマイスターことユカリによる",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "\\nオーエド横丁夏祭り屋台攻略戦が始まるのであった。",
    "voice": null,
    "unit_id": null
  }
]
