    "type": "dialogue",
    "name": "日和",
    "words": "騎士先生……",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這樣啊……",
    "voice": "vo_adv_1287003_085",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我們",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "因為失去意識被送到醫院。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "但多虧在那之後抵達的【王宮騎士團】，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n魔物沒有造成傷亡啊。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "太好了……！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "騎士先生好厲害喔。",
    "voice": "vo_adv_1287003_086",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n你明明應該",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "早就超過極限了。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "啊哈哈。",
    "voice": "vo_adv_1287003_087",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "因為大家遇到困難了啊！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "有困難的時候",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "就是要互相幫助幫助，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "才對嘛♪",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……咦咦！？",
    "voice": "vo_adv_1287003_088",
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n感覺熱血沸騰起來了！？",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "怎麼了？騎士先生？",
    "voice": "vo_adv_1287003_089",
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "怎麼現在變成這副模樣……？",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……唔！",
    "voice": "vo_adv_1287003_090",
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "嘿嘿……",
    "voice": "vo_adv_1287003_091",
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "嗯！",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這次絕對不會失敗──！",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "那麼，",
    "voice": "vo_adv_1287003_092",
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "就來擊掌吧──！",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n預備♪",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "日和跟{0}用嶄新的力量，以及不變的堅強意志，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n拯救了許多人。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "雖然兩人的心因為這份成就感而變得暖暖的，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n但身體卻因為強烈的肌肉酸痛而動彈不得了好幾天……",
    "voice": null,
    "unit_id": null
  }
]
