  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}一行人得知小棉花糖是超特級妖魔‧地獄犬後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n開始想辦法制止牠──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "小棉花糖",
    "words": "嘎唔唔唔……",
    "voice": "vo_adv_5076006_000",
    "unit_id": 15211
  },
  {
    "type": "dialogue",
    "name": "小棉花糖",
    "words": "汪汪！！",
    "voice": null,
    "unit_id": 15211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "哎呀～～～！！",
    "voice": "vo_adv_5076006_001",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n那隻怪物",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "是怎麼一回事！？",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "不好了！",
    "voice": "vo_adv_5076006_002",
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "牠已經在鎮上造成危害了！？",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "小棉花糖，",
    "voice": "vo_adv_5076006_003",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "等等！",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "快冷靜下來～！",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "這樣很危險喔，",
    "voice": "vo_adv_5076006_004",
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "不可以隨便出手！",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "\\n妳會被吃掉的！",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "怎麼會……！",
    "voice": "vo_adv_5076006_005",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "各位，",
    "voice": "vo_adv_5076006_006",
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "大家都沒事吧？",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n有沒有",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "受傷呢？",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我們沒有受傷，",
    "voice": "vo_adv_5076006_007",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "只是為祭典所做的準備全都泡湯了！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "不僅攤位遭到破壞，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "連食材也全被吃光了！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "就是說啊，",
    "voice": "vo_adv_5076006_008",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "我的攤位也是！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "為了這次的萬聖節，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "我還特地研發了新口味呢！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "妳說新口味……",
    "voice": "vo_adv_5076006_009",
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n難不成",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "大家都是開甜點店的？",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "是啊……",
    "voice": "vo_adv_5076006_010",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n眼看萬聖節慶典就要開始了，我們可是卯足了幹勁呢……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "在這之前，",
    "voice": "vo_adv_5076006_011",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "店面也曾被一大群小白狗給團團包圍……",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "今年實在是禍不單行哪……",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "看來小棉花糖就算生氣了，",
    "voice": "vo_adv_5076006_012",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "還是",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "很愛吃甜食呢……",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "是啊……",
    "voice": "vo_adv_5076006_013",
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "這般對吃的強烈執著，",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "不禁讓我想起某人……",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "騎士團隊長",
    "words": "咦……",
    "voice": "vo_adv_5076006_014",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團隊長",
    "words": "你們是之前的那群人！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團隊長",
    "words": "我們接獲通報，說有巨型犬在鬧事……",
    "voice": "vo_adv_5076006_015",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團隊長",
    "words": "\\n雖說其樣貌跟你們之前帶在身邊的妖魔好像不太一樣，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團隊長",
    "words": "\\n該不會有什麼關聯吧？",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "呃、",
    "voice": "vo_adv_5076006_016",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "那個……",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "因為發生了一些事，",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "牠才變成那般模樣，",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "然後就逃走了……",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "騎士團隊長",
    "words": "……",
    "voice": "vo_adv_5076006_017",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團隊長",
    "words": "這樣啊。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團隊長",
    "words": "\\n你們還記得我曾說過，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團隊長",
    "words": "要是牠實際造成損害，我就得處置牠吧？",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "可是，",
    "voice": "vo_adv_5076006_018",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "沒有人受傷啊～！",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "只、",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "只是攤位遭到破壞……",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "騎士團隊長",
    "words": "這就是所謂的實際損害。",
    "voice": "vo_adv_5076006_019",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團隊長",
    "words": "\\n就算現在沒有人受傷，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團隊長",
    "words": "要是繼續放任不管，很快就會有傷者出現……",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團隊長",
    "words": "我也不想這麼做……",
    "voice": "vo_adv_5076006_020",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團隊長",
    "words": "\\n畢竟",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團隊長",
    "words": "牠長得一副軟綿綿的可愛模樣……",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團隊長",
    "words": "咳咳。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團隊長",
    "words": "不過！",
    "voice": "vo_adv_5076006_021",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團隊長",
    "words": "\\n該優先考量的是我所身負的職責！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團隊長",
    "words": "也就是",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團隊長",
    "words": "市民的安全！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團隊長",
    "words": "向所有部隊傳達下去！",
    "voice": "vo_adv_5076006_022",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團隊長",
    "words": "無論如何都得加以討伐！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團隊長",
    "words": "\\n牠雖然逃得快，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團隊長",
    "words": "哪怕是逃到世界的盡頭，我們也得追上去！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團隊長",
    "words": "不能再讓牠",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團隊長",
    "words": "造成任何危害了！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士團士兵們",
    "words": "遵命！！！",
    "voice": "vo_adv_5076006_023",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "怎、",
    "voice": "vo_adv_5076006_024",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "怎麼這樣……",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "香織……",
    "voice": "vo_adv_5076006_025",
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我們就做我們",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "做得到的事吧？",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "沒錯！",
    "voice": "vo_adv_5076006_026",
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "首先，",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "為了減少損害，",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n必須把牠引誘到沒有人的地方去是也。",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "如此一來，",
    "voice": "vo_adv_5076006_027",
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "騎士團或許就會願意聆聽我們的想法！",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "話雖如此，",
    "voice": "vo_adv_5076006_028",
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "就算要引誘牠，",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "小棉花糖也不會留心聽我們的話吧……",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "有理也說不清是也……",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "因為牠是地獄犬啊……",
    "voice": "vo_adv_5076006_029",
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "\\n根本不會在乎",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "渺小人類所說的話……",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "可是，",
    "voice": "vo_adv_5076006_030",
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "對我們來說，",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "牠是小棉花糖啊！",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "是那隻全身雪白、",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "軟綿綿的",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "超可愛小狗狗！",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "因為平時只顧著吃甜點，",
    "voice": "vo_adv_5076006_031",
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n又長得像棉花糖，",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "所以",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "香織才會幫牠取這個名字……",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "不，",
    "voice": "vo_adv_5076006_032",
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "那才是牠原本的模樣……",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "啊，",
    "voice": "vo_adv_5076006_033",
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "對了……",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "就是這樣！",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "小棉花糖果然還是",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "小棉花糖！",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "這是什麼意思？",
    "voice": "vo_adv_5076006_034",
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "因為",
    "voice": "vo_adv_5076006_035",
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "牠只顧著吃甜點啊。",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n牠沒有傷害鎮上的人，",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "襲擊攤位",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "只是為了吃吧？",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "這也就是說，",
    "voice": "vo_adv_5076006_036",
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "即便牠生氣了，行為也沒有改變！",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n所以，",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "只要像以前一樣餵牠甜點吃的話，",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "應該就會聽我們的話吧？",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "不過，",
    "voice": "vo_adv_5076006_037",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "攤位的甜點",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "似乎都被牠",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "給吃光了……",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "傑克的臉",
    "voice": "vo_adv_5076006_038",
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "是南瓜吧？",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "不然就在他臉上塗滿奶油，",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "佯裝成南瓜蛋糕如何？",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "別開玩笑了！",
    "voice": "vo_adv_5076006_039",
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "\\n我可是",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "大有來歷的菁英精靈耶！",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "妮諾，",
    "voice": "vo_adv_5076006_040",
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "這是個好主意～！",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "所、",
    "voice": "vo_adv_5076006_041",
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "以、",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "我說……！",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "還是我們裝扮成甜點",
    "voice": "vo_adv_5076006_042",
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "來吸引牠的注意力？",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n在前陣子看到的服裝出租店裡，",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "有巨大蛋糕裝呢。",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "然後",
    "voice": "vo_adv_5076006_043",
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "再噴灑上有甜～甜味道的香水，",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "這樣，",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "移動甜點就大功告成了～！",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我覺得這點子不錯耶～！",
    "voice": "vo_adv_5076006_044",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "就跑給牠追，",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "引誘牠到蘭德索爾城外去～！",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "是吧？",
    "voice": "vo_adv_5076006_045",
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "既然牠變得那麼大隻，",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n若要吸引牠的注意力，",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我們這邊也得準備巨大甜點！",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "只要引誘牠到沒有人的平原，",
    "voice": "vo_adv_5076006_046",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "就不怕會造成損害，",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n而騎士團他們或許就會",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "願意交給",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我們來處理～！",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "唔……",
    "voice": "vo_adv_5076006_047",
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "不過，",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "問題是",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "要由誰來引誘小棉花糖是也……",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "喔喔！",
    "voice": "vo_adv_5076006_048",
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "親自接下危險的任務！",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "不愧是將軍是也！",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "如果是秀才肯定沒問題！",
    "voice": "vo_adv_5076006_049",
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "能夠帥氣地接下任務，",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家對你有信心！",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "{0}，",
    "voice": "vo_adv_5076006_050",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "那就交給你了──！",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "為了小棉花糖，",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "請好好加油──！",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "那麼，",
    "voice": "vo_adv_5076006_051",
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我們趕緊去",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "準備換裝吧！",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "background",
    "bg_id": "500370"
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "喔喔！",
    "voice": "vo_adv_5076006_052",
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "這裡有好多各式各樣的",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "租借服裝是也！",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "真是間很熱鬧的店是也！",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "咦……？",
    "voice": "vo_adv_5076006_053",
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "話說回來，",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "傑克怎麼不見蹤影呢？",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n他應該有跟我們",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "一起走進店裡是也……",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "我一直都在啊！",
    "voice": "vo_adv_5076006_054",
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "真是失禮了！",
    "voice": "vo_adv_5076006_055",
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "因為這裡有太多跟傑克的臉長得很像的",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "租借服裝，",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n讓人很難分辨出來！",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "妳該不會是……",
    "voice": "vo_adv_5076006_056",
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "\\n一點也不相信我是",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "菁英精靈吧……？",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "你們兩位～",
    "voice": "vo_adv_5076006_057",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "現在不是玩的時候～",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "快來幫鈴奈的忙～！",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "妮諾～",
    "voice": "vo_adv_5076006_058",
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "已經找到蛋糕裝了，",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "妳幫人家拿香水過來～！",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n人家正在幫秀才化妝，",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "空不出手來，拜託～！",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "知道了！",
    "voice": "vo_adv_5076006_059",
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "傑克也",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "不要打混，",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "快來幫忙吧！",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "妳果然",
    "voice": "vo_adv_5076006_060",
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "不相信我呢。",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "……嗯！",
    "voice": "vo_adv_5076006_061",
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "感覺不錯吧？",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "這妝超適合",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才的！",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "看來還真詭異是也……",
    "voice": "vo_adv_5076006_062",
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "完全沒有一絲將軍的威嚴……",
    "voice": null,
    "unit_id": 117811
