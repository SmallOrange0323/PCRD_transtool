[
  {
    "type": "background",
    "bg_id": "502223"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "位於某座被冰雪封閉的銀嶺之中，卻存在著一處四季如夏的樂園。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n由【墨丘利財團】所經營的度假設施「墨丘利度假村」。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n此刻，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "少女們火熱而激烈的戰鬥，正要在這裡揭開序幕──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "欸、",
    "voice": "vo_adv_5214000_000",
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "欸，栞小姐，",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "現在逃跑還來得及，",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "我們兩個一起逃吧？",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "要是被那些厲害的人用屁股撞上的話，",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "會被殺死的……！",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "沒問題的，",
    "voice": "vo_adv_5214000_001",
    "unit_id": 138812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "若菜小姐。",
    "voice": null,
    "unit_id": 138812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n我們",
    "voice": null,
    "unit_id": 138812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "可是撐過了美冬教練",
    "voice": null,
    "unit_id": 138812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "嚴格的特訓。",
    "voice": null,
    "unit_id": 138812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 138812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "──啊，",
    "voice": null,
    "unit_id": 138812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "好像要開始了。",
    "voice": null,
    "unit_id": 138812
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "來來來，",
    "voice": "vo_adv_5214000_002",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "各位久等啦！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n走過路過不要錯過～！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n我是負責實況講評的",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "優花梨～！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我是負責解說的怜。",
    "voice": "vo_adv_5214000_003",
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "請多指教。",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "現場的各位～",
    "voice": "vo_adv_5214000_004",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "你們喜歡",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "漂亮的屁股嗎～！？",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "觀眾們",
    "words": "喜歡──────！",
    "voice": "vo_adv_5214000_005",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "聚集在此的，",
    "voice": "vo_adv_5214000_006",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "是無論到哪裡都足以自豪，",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "無論展現何處都不失體面的",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "８位美麗的臀士！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "包含背面世界在內，全世界頂尖水準的８人──",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "等一下，工作人員。",
    "voice": "vo_adv_5214000_007",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "這個要我念嗎？",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "照腳本走？",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "如果是工作的話那也沒辦法……",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "不過之後那個說好的飲料慰勞品，",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "要麻煩你囉？",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "全體選手，",
    "voice": "vo_adv_5214000_008",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "入場──！！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "觀眾們",
    "words": "嗚喔喔喔喔喔喔喔────────！！",
    "voice": "vo_adv_5214000_009",
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "521400001"
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "好大────！",
    "voice": "vo_adv_5214000_010",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "也太大了吧！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "240公分，",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "108公斤！！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "來自煉獄之地的",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "巨臀之霸！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "阿剌克涅，",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "是不是太大了捏？",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "阿剌克涅選手────！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "still",
    "still_id": "521400002"
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "偶像來這種地方真的可以嗎？",
    "voice": "vo_adv_5214000_011",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "可以的！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n就讓你們看看頂尖偶像的搖臀吧！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "竟然是",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "來自【慈樂之音】的",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "望選手登場啦────！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "still",
    "still_id": "521400003"
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "現在的我，甚至可以用屁股進行精靈唱喚──",
    "voice": "vo_adv_5214000_012",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "她發下如此豪語！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "同樣來自【慈樂之音】！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "難道要上演意想不到的偶像同門對決了嗎！？",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "風精之臀！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "千歌選手！！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "still",
    "still_id": "521400004"
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我是為了被修理才來的！",
    "voice": "vo_adv_5214000_013",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "快點把我的屁股",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "打得滿是「紅葉」吧！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我想感受一屁塗地的滋味！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "不，是一敗塗地的滋味！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "抖Ｍ的Ｍ就是屁股的Ｍ！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "空花選手──！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "still",
    "still_id": "521400005"
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "不會飛的屁股就只是普通的屁股！？",
    "voice": "vo_adv_5214000_014",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "那當然啦──！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "來自童話世界的鋼鐵臀部！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "屁股翱翔飛向天空！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "克蘿茜選手！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "still",
    "still_id": "521400006"
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "被黑鐵覆蓋的那張臉！",
    "voice": "vo_adv_5214000_015",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "還有那個屁股！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "終於要揭開面紗了嗎！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n【王宮騎士團】的工作不管了嗎──！\\n",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "極具奪冠潛力的有屁候補！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "純選手！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "still",
    "still_id": "521400007"
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "──那麼，",
    "voice": "vo_adv_5214000_016",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "在這裡有個遺憾的消息要告訴大家。",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "上一屆冠軍的真步選手，",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "因為忙著做茶泡飯，",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n這次竟然缺席了！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是不是用好聽的藉口溜了……？",
    "voice": "vo_adv_5214000_017",
    "unit_id": 122511
  },
  {
    "type": "still",
    "still_id": "521400008"
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "另外，",
    "voice": "vo_adv_5214000_018",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "在非官方的野外對戰中，擊敗涅婭選手的「豪臀」──",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n美空選手也表示，",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "「那天預定會感冒喔～★」",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
