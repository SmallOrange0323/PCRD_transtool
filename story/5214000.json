    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "觀眾２",
    "words": "你才是在開玩笑！",
    "voice": "vo_adv_5214000_034",
    "unit_id": 1013
  },
  {
    "type": "dialogue",
    "name": "觀眾２",
    "words": "根本不可能有人贏過純團長！",
    "voice": null,
    "unit_id": 1013
  },
  {
    "type": "dialogue",
    "name": "觀眾２",
    "words": "\\n還有，",
    "voice": null,
    "unit_id": 1013
  },
  {
    "type": "dialogue",
    "name": "觀眾２",
    "words": "千歌不是你的！",
    "voice": null,
    "unit_id": 1013
  },
  {
    "type": "dialogue",
    "name": "觀眾3",
    "words": "不對啦，",
    "voice": "vo_adv_5214000_035",
    "unit_id": 1413
  },
  {
    "type": "dialogue",
    "name": "觀眾3",
    "words": "冠軍一定是阿剌克涅小姐！",
    "voice": null,
    "unit_id": 1413
  },
  {
    "type": "dialogue",
    "name": "觀眾3",
    "words": "\\n我啊，",
    "voice": null,
    "unit_id": 1413
  },
  {
    "type": "dialogue",
    "name": "觀眾3",
    "words": "早就決定了，",
    "voice": null,
    "unit_id": 1413
  },
  {
    "type": "dialogue",
    "name": "觀眾3",
    "words": "要死的話也要死在她那個屁股下面啊！",
    "voice": null,
    "unit_id": 1413
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "啊、",
    "voice": "vo_adv_5214000_036",
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "啊哇哇……！？",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n觀眾們，",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "居然開始用屁股互相撞來撞去了……！？",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "不，",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "現在開始也不遲，",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "我們兩個一起逃……",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "涼……",
    "voice": "vo_adv_5214000_037",
    "unit_id": 138812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "涼拌屁股蛋……",
    "voice": null,
    "unit_id": 138812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n呵呵……",
    "voice": null,
    "unit_id": 138812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "噗呵呵呵……！",
    "voice": null,
    "unit_id": 138812
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "那個，",
    "voice": "vo_adv_5214000_038",
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "真的有那麼好笑嗎！？",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n喂！？",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
