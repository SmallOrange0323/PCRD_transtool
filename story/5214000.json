  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "嗚嗚，",
    "voice": "vo_adv_5214000_020",
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "我開始緊張起來了……！",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "真的沒問題嗎？",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "美冬教練……！",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "嗯。",
    "voice": "vo_adv_5214000_021",
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "要有自信。",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "你們單獨一個人的話，",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "不過就是普通的屁股。",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "但是，",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "當兩個人的兩瓣屁股結合在一起──",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n就會變成「涼拌屁股蛋」！",
    "voice": null,
    "unit_id": 108013
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "……絕對不會變成那樣的吧……！？　",
    "voice": "vo_adv_5214000_022",
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "涼、",
    "voice": "vo_adv_5214000_023",
    "unit_id": 138812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "涼拌屁股蛋……",
    "voice": null,
    "unit_id": 138812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 138812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "噗、",
    "voice": null,
    "unit_id": 138812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "呵呵……",
    "voice": null,
    "unit_id": 138812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "呵呵呵呵……",
    "voice": null,
    "unit_id": 138812
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "咦？",
    "voice": "vo_adv_5214000_024",
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "有那麼好笑啊……",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "栞小姐，",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "妳的笑點是不是有點怪怪的……？",
    "voice": null,
    "unit_id": 138712
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "──因，此",
    "voice": "vo_adv_5214000_025",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "緊急登場的兩位祕密培養新人！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "現在為各位介紹兩位備受期待的新人選手！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "不會再被叫成體弱多病了！",
    "voice": "vo_adv_5214000_026",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "有時是牧場的幫手，",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "有時是獵人，",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "有時是遊俠！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "然而其真正的身分──",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "縹緲的臀士，在此誕生！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "栞選手！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "屁股不是看大小！",
    "voice": "vo_adv_5214000_027",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "而是由形狀決定的！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n那充滿肉感、悶騷的蜜桃臀，",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "此刻",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "在水面上爆發開來！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "【蠻賊三姊妹】的",
