    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "所以，",
    "voice": "vo_adv_1223011_017",
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "就算不去很多地方也沒關係。",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n班比",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "只要有這個歸宿就……",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "咦？",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "……僕從，",
    "voice": "vo_adv_1223011_018",
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "有人來了。",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "這邊，",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "快躲起來！",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "體育老師",
    "words": "……是我的錯覺嗎？",
