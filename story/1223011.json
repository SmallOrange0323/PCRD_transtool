    "name": "班比",
    "words": "\\n要是被發現的話……",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "那種事……",
    "voice": "vo_adv_1223011_024",
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "不要！",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n因為這裡是班比珍惜的歸宿嘛！",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "沒辦法了，",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "挺身而出吧！",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "僕從你躲在這裡。",
    "voice": "vo_adv_1223011_025",
    "unit_id": 122331
  },
  {
    "type": "dialogue",
