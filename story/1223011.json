    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "體育老師",
    "words": "就算有聲音，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "體育老師",
    "words": "\\n也一定是擅自溜進來玩的學生。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "體育老師",
    "words": "既然如此我就徹底檢查吧！",
