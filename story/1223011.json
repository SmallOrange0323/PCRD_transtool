    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n正在購買要帶去遺址的東西。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "呼，",
    "voice": "vo_adv_1223011_000",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "買了好多呢。",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "多虧有那兩個人在，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n現在不會有魔物和奇怪的叔叔跑來了，",
