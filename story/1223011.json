    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "不過現在吃到的",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "更加好吃。",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "聽說在外面吃泡麵",
    "voice": "vo_adv_1223011_011",
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "會覺得非常好吃，",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n原來是真的呢！",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "謝謝你，",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "僕從！",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "真是的，",
    "voice": "vo_adv_1223011_012",
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n你一點都不懂耶～",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "僕從～",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "其實班比",
    "voice": "vo_adv_1223011_013",
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "會一個人偷偷跑出去玩。",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "啊，",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "不能跟伊莉亞說喔。",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "然後，",
    "voice": "vo_adv_1223011_014",
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比雖然到處去玩玩看了……",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "但是覺得沒有和僕從見面時",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "那麼好玩。",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "然後",
    "voice": "vo_adv_1223011_015",
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比發現了哦。",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n這跟去哪裡玩",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "沒有太大的關係，",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n班比會開心是因為有僕從在身邊。",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "和僕從在一起的地方，",
    "voice": "vo_adv_1223011_016",
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "就會是班比充滿回憶的地點。",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "那裡是",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比所珍惜的",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "「歸宿」喔！",
