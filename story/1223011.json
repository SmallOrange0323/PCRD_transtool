    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "體育老師",
    "words": "該、",
    "voice": "vo_adv_1223011_020",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "體育老師",
    "words": "該不會是大家在說的女孩子幽靈……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "體育老師",
    "words": "\\n不對，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "體育老師",
    "words": "怎麼可能會有那種事！",
