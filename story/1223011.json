    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比的別墅計畫",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "充滿了希望呢！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "你看，",
    "voice": "vo_adv_1223011_001",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "閃亮的太陽也在幫班比加油喔。",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "雖然班比不太喜歡太陽……",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "貝斯",
    "words": "呀噗，",
    "voice": "vo_adv_1223011_002",
    "unit_id": 8311
  },
  {
    "type": "dialogue",
    "name": "貝斯",
    "words": "呀呀噗？",
    "voice": null,
    "unit_id": 8311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "咦？",
    "voice": "vo_adv_1223011_003",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "這麼說來，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "比起平常的太陽，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "總覺得今天的",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "特別刺眼……",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "真是的，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "這是",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "怎麼回事啦～！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "background",
    "bg_id": "510182"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "某個夜晚，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}因為班比要求，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在夜晚的學校屋頂上準備泡麵。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "僕從僕從，",
    "voice": "vo_adv_1223011_004",
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "還沒好嗎？",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "……吶，僕從，",
    "voice": "vo_adv_1223011_005",
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "已經過兩分鐘了吧？",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "真的嗎？",
    "voice": "vo_adv_1223011_006",
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "你沒有捉弄班比？",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比等不及了～！",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "……不過……",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "僕從這麼說的話，",
    "voice": "vo_adv_1223011_007",
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比會忍耐！",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "嗶嗶嗶嗶，嗶嗶嗶嗶。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "三分鐘了！",
    "voice": "vo_adv_1223011_008",
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比要開動了～！",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n呼──",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "呼──",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "吸嚕嚕嚕……",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "嗯～！",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "好好吃！",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "比班比想的",
    "voice": "vo_adv_1223011_009",
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "還要好吃好幾倍！",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比好幸福～！",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "不是，",
    "voice": "vo_adv_1223011_010",
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "之前曾經吃過喔。",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "那次也很好吃，",
