  },
  {
    "type": "dialogue",
    "name": "體育老師",
    "words": "幽、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "體育老師",
    "words": "幽靈什麼我才不怕呢！",
