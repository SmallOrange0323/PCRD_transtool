  {
    "type": "dialogue",
    "name": "雪",
    "words": "就讓你幫我慶祝吧！",
    "voice": "vo_adv_4010211_000",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n閃耀的美貌誕生於世上的",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這個日子！",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "呵呵，",
    "voice": "vo_adv_4010211_001",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "謝謝你♪",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "居然連禮物都準備好了，",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n果然你",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "最懂得欣賞我的美貌呢。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這樣",
    "voice": "vo_adv_4010211_002",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "被我迷住的你，",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "就收下我的獎勵吧。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "給你今天一整天",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "可以和我度過的權利！",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "很榮幸吧？",
    "voice": "vo_adv_4010211_003",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "畢竟可以和",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "迎接生日",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "美貌又更上一層樓的我，",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n一直在一起呢？",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "街道上行人的視線",
    "voice": "vo_adv_4010211_004",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "都會在我身上。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "一定會成為最棒的生日……♪",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "來吧，",
    "voice": "vo_adv_4010211_005",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "要去哪裡由你來決定。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n自由地帶我到",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "可以傳遞我閃耀美貌的地方吧……！",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "background",
    "bg_id": "510070"
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我都這麼充滿幹勁了，",
    "voice": "vo_adv_4010211_006",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n沒想到你會選這種人煙稀少的地方。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你不想",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "更加傳播我的美貌嗎？",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "！",
    "voice": "vo_adv_4010211_007",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "呵呵，",
    "voice": "vo_adv_4010211_008",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "原來如此。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你比",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "想像中還要貪心呢。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "竟然想將這份光芒",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "占為己有。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我當然",
    "voice": "vo_adv_4010211_009",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "沒問題。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "好好地",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "烙印在腦海裡吧……♪",
    "voice": null,
    "unit_id": 100831
  },
  {
