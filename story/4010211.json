  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "喔～",
    "voice": "vo_adv_4010211_010",
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "這裡就是騎士先生的家嗎。",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "\\n",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "到男性的住家打擾，",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "令人有點心跳加速呢。",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "\\n今天",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "是有什麼事嗎？",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "咦？",
    "voice": "vo_adv_4010211_011",
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "啊，",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "謝謝你！",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "\\n",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "沒想到是為了幫我慶祝才特地叫我來家裡……",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "咳咳。",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "\\n",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "你的精神值得嘉許！",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "我就大放送賜予你這權利吧！",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "謝謝你！",
    "voice": "vo_adv_4010211_012",
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "這是……",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "哇，",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "是蠟燭嗎！",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "\\n好多各式各樣的形狀和顏色……！",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "\\n",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "這，",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "真的有好多呢？",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "100根以上？",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "為什麼這麼多？",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "那這些",
    "voice": "vo_adv_4010211_013",
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "全都是生日蛋糕的蠟燭嗎！？",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "\\n",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "因為我之前說",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "自己重複著輪迴轉生……",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "\\n",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "哇哇，",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "蛋糕也好大～！",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "真是華麗繽紛！",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "有這麼多蠟燭的話，",
    "voice": "vo_adv_4010211_014",
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "\\n只靠我是吹不滅的。",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "\\n",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "騎士先生，",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "請跟我一起",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "「呼──呼──」",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "地吹熄喔？",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "好棒好棒！",
    "voice": "vo_adv_4010211_015",
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "\\n果然說到大餐",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "就是炸雞！",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "雞翅！",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "雞軟骨！",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "\\n",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "……那麼，",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "那個炸雞在哪裡？",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "笑咪咪～♪",
    "voice": "vo_adv_4010211_016",
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "欸……",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "咦咦！？",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "\\n是我嗎？",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "我要成為炸雞嗎？",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "\\n我要自己上去",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "自己生日派對的餐桌嗎～！？",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "送貨員",
    "words": "你好──",
    "voice": "vo_adv_4010211_017",
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "送貨員",
    "words": "美食外送──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "送貨員",
    "words": "\\n您點的",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "送貨員",
    "words": "現炸炸雞送到了──！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "咦？",
    "voice": "vo_adv_4010211_018",
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "是騎士先生訂購的嗎？",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "為了我？",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "\\n……真、",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "真是的！",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "害我誤會了！",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "\\n",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "……鬆了一口氣……",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "來吧，",
    "voice": "vo_adv_4010211_019",
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "騎士先生！",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "熱騰騰的炸雞和蠟燭，",
    "voice": null,
    "unit_id": 134731
  },
  {
    "type": "dialogue",
    "name": "鳳子",
    "words": "\\n",
