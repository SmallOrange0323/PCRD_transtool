  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "碧一行人在舊校舍的封鎖區\\n找到了巨大化的曼德拉草。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "曼德拉草",
    "words": "――咕喔喔喔喔喔！",
    "voice": "vo_adv_5023006_000",
    "unit_id": 12011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "哇、",
    "voice": "vo_adv_5023006_001",
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "哇哇……",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "竟然長得這麼大，",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "為什麼會變這樣……",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "應該是因為環境的差異吧。",
    "voice": "vo_adv_5023006_002",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "精靈之森相較於這裡",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n土壤中所含的養分，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "還有空氣中的魔力品質也不同。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n……",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "妳仔細看看頭上。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "唔哇。",
    "voice": "vo_adv_5023006_003",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "好像有一朵",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "含有劇毒的花開在上面。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n看起來一點也不可愛。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "呼……",
    "voice": "vo_adv_5023006_004",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "真糟糕。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "開花了就表示",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "它已經成長完全了。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "成長完全",
    "voice": "vo_adv_5023006_005",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "會發生什麼事？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "……德蕾女高就糟了。",
    "voice": "vo_adv_5023006_006",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "這麼嚴重！？",
    "voice": "vo_adv_5023006_007",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "嗯，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "琪愛兒最受不了這種了～",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "因為環境差異",
    "voice": "vo_adv_5023006_008",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "導致成長過程的變異。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "真是非常有意思的現象啊――",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "曼德拉草",
    "words": "――嘎哦哦哦哦哦！",
    "voice": "vo_adv_5023006_009",
    "unit_id": 12011
  },
  {
    "type": "background",
    "bg_id": "500770"
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "等等，",
    "voice": "vo_adv_5023006_010",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "它發動攻擊了耶！？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n它的那個藤蔓很不妙耶！？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "明明是一株植物",
    "voice": "vo_adv_5023006_011",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "也太調皮了吧……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊～",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "事情越來越麻煩了～",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "各位，",
    "voice": "vo_adv_5023006_012",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "就如同我之前說過的，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "那株曼德拉草有毒。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n講白一點，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "就是不要碰到它的觸手！",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "曼德拉草",
    "words": "――咕喔喔喔喔喔！",
    "voice": "vo_adv_5023006_013",
    "unit_id": 12011
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "這太強人所難了吧！",
    "voice": "vo_adv_5023006_014",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "這個太勉強了啦……",
    "voice": "vo_adv_5023006_015",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "哈、",
    "voice": "vo_adv_5023006_016",
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "噫、",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "呼！",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "喔！？　",
    "voice": "vo_adv_5023006_017",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "小碧好厲害！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "嗯，",
    "voice": "vo_adv_5023006_018",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這反應速度真了不得。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那、",
    "voice": "vo_adv_5023006_019",
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那個，",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我……",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "在邊緣人生活中不斷在鍛鍊自己，",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n所以，",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "特別擅長逃跑……",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "嘿！",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "……先不論學習的過程如何，",
    "voice": "vo_adv_5023006_020",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "做得漂亮。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "像我這種人竟然待在這種地方，真的很抱歉！",
    "voice": "vo_adv_5023006_021",
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "還用掉多餘的氧氣真的很抱歉！",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我不會再造成妳們的困擾了，真的很抱歉！",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "那個動作……！",
    "voice": "vo_adv_5023006_022",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "真不愧是碧，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "那個真的是邊緣人的極致。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "好厲害……",
    "voice": "vo_adv_5023006_023",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "那個真的好厲害喔？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n琪愛兒也可以把那個學起來嗎？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不可能的。",
    "voice": "vo_adv_5023006_024",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n所以說不可能的。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "曼德拉草",
    "words": "――咕喔喔喔喔喔！",
    "voice": "vo_adv_5023006_025",
    "unit_id": 12011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "{0}危險，那邊有攻擊……！",
    "voice": "vo_adv_5023006_026",
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "是那樣沒錯。",
    "voice": "vo_adv_5023006_027",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "雖然是沒錯啦。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "但現在是道歉的時候嗎？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "這是在告解什麼啊！？",
    "voice": "vo_adv_5023006_028",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n讓人很在意到底發生了什麼事啊！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "話說，",
    "voice": "vo_adv_5023006_029",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "原來真可以辦到。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "{0}學長，",
    "voice": "vo_adv_5023006_030",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "竟然真的能靠那樣閃過……",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "……感覺好像",
    "voice": "vo_adv_5023006_031",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我也能做得到。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "琪愛兒、優妮、克蘿依",
    "words": "雖然不是很想照做……",
    "voice": "vo_adv_5023006_032",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "曼德拉草",
    "words": "――咕喔喔喔喔喔！",
    "voice": "vo_adv_5023006_033",
    "unit_id": 12011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "嘿，",
    "voice": "vo_adv_5023006_034",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "凡事都要嘗試看看！",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "天才到老師都沒轍，真的很對不起！",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "臉長得太美，真的很對不起！",
    "voice": "vo_adv_5023006_035",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "雖然搞不清楚狀況，不過真的很抱歉～",
    "voice": "vo_adv_5023006_036",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "好、",
    "voice": "vo_adv_5023006_037",
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "好厲害喔！各位！",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "大家都學會了邊緣人的奧義呢！",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "這是讚美嗎？",
    "voice": "vo_adv_5023006_038",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n琪愛兒，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "應該很高興嗎？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "管它的，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "耶～！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "怎樣都",
    "voice": "vo_adv_5023006_039",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "無所謂啦。",
