  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人……！",
    "voice": "vo_adv_9500002_000",
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您願意",
    "voice": null,
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "選擇在下嗎？",
    "voice": null,
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……！",
    "voice": "vo_adv_9500002_001",
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "啊……",
    "voice": null,
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "謝謝您，",
    "voice": null,
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人……！",
    "voice": null,
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在拯救世界這個重要的時刻，",
    "voice": "vo_adv_9500002_002",
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "選擇了在下。",
    "voice": null,
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n作為「嚮導」，",
    "voice": null,
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這是我最大的喜悅。",
    "voice": null,
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "真的……",
    "voice": null,
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "該說什麼才好呢……！",
    "voice": null,
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "從以前開始，",
    "voice": "vo_adv_9500002_003",
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下就……",
    "voice": null,
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "暗自",
    "voice": null,
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "做好覺悟了。",
    "voice": null,
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "作為隨從，",
    "voice": null,
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "無論主人選擇誰，",
    "voice": null,
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "都要給予祝福、支持。",
    "voice": null,
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……",
    "voice": "vo_adv_9500002_004",
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "光是有這種想法，",
    "voice": null,
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "或許就已經，",
    "voice": null,
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不配再擔任嚮導了。",
    "voice": null,
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但是……",
    "voice": "vo_adv_9500002_005",
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "即使如此，",
    "voice": null,
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "和主人在這個世界度過的日子，",
    "voice": null,
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n對我來說",
    "voice": null,
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "也是珍貴的寶物。",
    "voice": null,
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這份羈絆，",
    "voice": "vo_adv_9500002_006",
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是屬於我和主人的。",
    "voice": null,
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不會讓任何人……",
    "voice": null,
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "也不會讓幻境龍后",
    "voice": null,
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "奪走。",
    "voice": null,
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "好的！",
    "voice": "vo_adv_9500002_007",
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……親愛的主人。",
    "voice": null,
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n我最珍視的",
    "voice": null,
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人。",
    "voice": null,
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "從早晨到夜晚。",
    "voice": "vo_adv_9500002_008",
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "無論生病，",
    "voice": null,
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "還是健康之時。",
    "voice": null,
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "無論遭遇什麼難關。",
    "voice": null,
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "無論何時，",
    "voice": "vo_adv_9500002_009",
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "都會在最近的地方。",
    "voice": null,
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在您的身旁",
    "voice": null,
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "支持您。",
    "voice": null,
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "作為忠誠的，",
    "voice": null,
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "只屬於您的嚮導──",
    "voice": null,
    "unit_id": 105941
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "並且，總有一天，",
    "voice": "vo_adv_9500002_010",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "會成為您一輩子的「嚮導」……♪",
    "voice": null,
    "unit_id": 137611
  }
]
