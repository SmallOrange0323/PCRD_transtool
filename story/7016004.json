    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "喝！",
    "voice": "vo_adv_7016004_002",
    "unit_id": 104211
  },
  {
    "type": "background",
    "bg_id": "500430"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "哈啊……",
    "voice": "vo_adv_7016004_003",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "哈",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "啊……",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n對不起……",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "精靈",
    "words": "──！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "不，",
    "voice": "vo_adv_7016004_004",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "不是你的問題。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "沒有抱持警戒",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是我們的過失。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是啊……",
    "voice": "vo_adv_7016004_005",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "只能撤退了……",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "明明好不容易來到這裡了……",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "危、危險……",
    "voice": "vo_adv_7016004_006",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "把你做成……",
    "voice": "vo_adv_7016004_007",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "布丁！",
    "voice": "vo_adv_7016004_008",
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500430"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "這個聲音是……",
    "voice": "vo_adv_7016004_009",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "宮子小姐？",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "真是的，看不下去了！",
    "voice": "vo_adv_7016004_010",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n其他隻也迅速解決！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我、",
    "voice": "vo_adv_7016004_011",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我知道了！",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "要上了！",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "精靈",
    "words": "──！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "總算打倒了啊……",
    "voice": "vo_adv_7016004_012",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n真是幫了大忙。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "宮子小姐，",
    "voice": "vo_adv_7016004_013",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "謝謝妳。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "剛剛說過了啊，",
    "voice": "vo_adv_7016004_014",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子很優秀來的！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "可以再多～誇獎人家一點呦！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "還有，",
    "voice": "vo_adv_7016004_015",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "剛剛我說得太過份了。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "對不起……",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "這、",
    "voice": "vo_adv_7016004_016",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "這就算了。",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子心胸很寬大的。",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n只要布丁不被搶走，是不會介意的。",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "如果真的想要道歉，",
    "voice": "vo_adv_7016004_017",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "之後再給人家布丁吧！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "這樣人家就會完全原諒妳囉～♪",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "……妳為什麼",
    "voice": "vo_adv_7016004_018",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "願意回來呢？",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "這個……",
    "voice": "vo_adv_7016004_019",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "可不是為了你們啊。",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "只是……",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "人家還想吃那個布丁嘛。",
    "voice": "vo_adv_7016004_020",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "那樣的話，",
    "voice": "vo_adv_7016004_021",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "再買不就好了……",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "不～一～樣～啦～！",
    "voice": "vo_adv_7016004_022",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n人家覺得如果就這樣回去，",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "即使吃了同樣的布丁……",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n也一定不會好吃的！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "宮子小姐……",
    "voice": "vo_adv_7016004_023",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "就算是同樣的布丁，",
    "voice": "vo_adv_7016004_024",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "也有好吃的時候和",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "不好吃的時候。",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "明明布丁應該沒變，為什麼會這樣來的？",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "是怎麼回事？",
    "voice": "vo_adv_7016004_025",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "對宮子小姐來說，",
    "voice": "vo_adv_7016004_026",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "所謂非常美味的時候，",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是什麼樣的時候呢？",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "那是……",
    "voice": "vo_adv_7016004_027",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "和大家……",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "啊！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "或許……",
    "voice": "vo_adv_7016004_028",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "【惡魔偽王國軍】的大家，",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n也想讓宮子小姐吃到很美味的布丁唷。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "大家一起享用",
    "voice": "vo_adv_7016004_029",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "一定更美味呢！",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "所以",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "和好吧？",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "你們……",
    "voice": "vo_adv_7016004_030",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "人家知道了。",
    "voice": "vo_adv_7016004_031",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "如果是為了吃好吃的布丁，那就沒辦法了……",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "所以那個布丁，",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "還要讓宮子吃呦！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "好的，",
    "voice": "vo_adv_7016004_032",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我很榮幸！",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "千歌用溫柔的目光，望著稍微有些成長的宮子。",
    "voice": null,
    "unit_id": null
  }
