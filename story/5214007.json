    "voice": "vo_adv_5214007_042",
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n因為我們",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "還沒有決出勝負啊。",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "……呵呵。",
    "voice": "vo_adv_5214007_043",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "這樣啊，",
