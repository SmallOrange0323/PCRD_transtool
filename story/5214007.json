    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "才、",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "才不是我的錯！",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "我只是因為上次從城堡裡偷的蜂蜜真的太好吃了，",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n就拿來用了而已啊～！",
    "voice": null,
    "unit_id": 130212
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "上個月，",
    "voice": "vo_adv_5214007_017",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "在王城似乎發生了某蜜蜂女大鬧一場的事件呢。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n那些蜂蜜就是她留下的麻煩吧……",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "我沒有喝是對的。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "值得信任的",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "只有八鹽折而已。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "難、",
    "voice": "vo_adv_5214007_018",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "難怪我就覺得不對勁……",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "突然都對屁股相撲那麼狂熱，",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "到處碰撞屁股。",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "現在大家",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "應該都恢復正常了……",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "background",
    "bg_id": "501240"
  },
  {
    "type": "dialogue",
    "name": "初音",
