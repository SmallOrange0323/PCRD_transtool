    "type": "dialogue",
    "name": "栞",
    "words": "那位教練",
    "voice": "vo_adv_5214007_040",
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "有話讓我轉達。",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "「在第三屆",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "蜜桃碰撞淘汰賽舉辦之前，",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n不可懈怠修練」",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "──這樣。",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "第、",
    "voice": "vo_adv_5214007_041",
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "第三屆！？",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "教練",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "還打算要辦嗎！？",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n難道不是受到蜂蜜莎影響，",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "而是發自內心的",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "充滿熱情嗎！？",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "嗚嗚…………",
    "voice": null,
    "unit_id": 130112
  },
  {
