    "name": "若菜",
    "words": "姊姊。",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "──也就是說，",
    "voice": "vo_adv_5214007_015",
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "布武機到處在賣的「蜂蜜莎」，",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n就是這場混亂鬧劇的原因嗎。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "大家是喝了那個才變得不正常的。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "是這樣對吧？",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "布武機。",
    "voice": null,
    "unit_id": 130012
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "嗚哇啊啊啊～～～！",
