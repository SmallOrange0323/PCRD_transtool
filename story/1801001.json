[
  {
    "type": "background",
    "bg_id": "500140"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "治好了幼兒化的問題，重新回歸打工的{0}，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在送完貨返家的途中，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "看到了正在修行的日和。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "唔喵喵喵──！！",
    "voice": "vo_adv_1801001_000",
    "unit_id": 100111
  },
  {
    "type": "background",
    "bg_id": "500140"
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "呼、",
    "voice": "vo_adv_1801001_001",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "呼……",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "只憑現在的我……",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "面對那些人根本……！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "啊咧？",
    "voice": "vo_adv_1801001_002",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "騎士先生……？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "你已經可以照常工作了呀！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "不過，",
    "voice": "vo_adv_1801001_003",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "也不能太勉強自己喔？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n騎士先生的病剛好……",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "嗯～",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "那種狀況能說是生病嗎？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "總之，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "突然勉強自己的話會出問題的。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "有什麼問題的話我也可以幫忙，所以要告訴我喔。",
    "voice": "vo_adv_1801001_004",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "有困難的時候，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "就要互相幫助幫助……",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "對吧。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "咦……？",
    "voice": "vo_adv_1801001_005",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我、",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我沒事呀？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我跟平常的我一樣充滿活力！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "你看你看，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "充滿活力的姿勢！！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "怎麼樣？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……",
    "voice": "vo_adv_1801001_006",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "好厲害呢。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "果然我面對騎士先生，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "就沒辦法隱瞞自己呀。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "可以換個地方說話嗎？",
    "voice": "vo_adv_1801001_007",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "剛好我也覺得想休息一下了。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "──嗯，",
    "voice": "vo_adv_1801001_008",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "就挑這裡吧。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n看出去的風景也好，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "感覺能夠放鬆下來呢♪",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "still",
    "still_id": "180100101"
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……要說到我沒有活力的原因呢。",
    "voice": "vo_adv_1801001_009",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n就是之前，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我們不是和【憤怒‧軍團】的人戰鬥過嗎？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n我也變成公主型態戰鬥的那時候……",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……其實啊，",
    "voice": "vo_adv_1801001_010",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "那時候我是有點自信的。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n只要有了公主型態的力量，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "就不會輸給卡里莎他們。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n我要用這個力量守護大家……",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "但是，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我卻守護不了。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "不只是卡里莎，",
    "voice": "vo_adv_1801001_011",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "連阿澤爾德也很厲害。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n原本以為我們是不相上下，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "結果並不是這樣……",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……那時我好不甘心。",
    "voice": "vo_adv_1801001_012",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n不對，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "直到現在，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我還是很不甘心……",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "騎士先生也……？",
    "voice": "vo_adv_1801001_013",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "放、",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "放心吧！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n我",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "可沒有就這樣放棄了喔！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這種心情揮散不去，",
    "voice": "vo_adv_1801001_014",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "也很討厭嘛……",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n所以呀，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我不想再輸了！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我會更加努力喔！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我想變得更強，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "強大到不會輸給他們！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "still",
    "still_id": "180100102"
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……所以，",
    "voice": "vo_adv_1801001_015",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "騎士先生也打起精神吧？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "把我的活力，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "傳送給騎士先生──！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n……這樣呢♪",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "欸嘿嘿，",
    "voice": "vo_adv_1801001_016",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "不客氣！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n有困難的時候就要互相幫助幫助，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "對吧♪",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "太好了，",
    "voice": "vo_adv_1801001_017",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "傳過去了！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n好～！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "收下更多活力吧──！！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n唔喵──！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這樣如何呀──！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……和騎士先生說過話後，",
    "voice": "vo_adv_1801001_018",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我就有精神了！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n騎士先生也恢復活力了，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n這個話題就到此為止！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "background",
    "bg_id": "500140"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我們一起變強吧！",
    "voice": "vo_adv_1801001_019",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "強大到不會輸給【憤怒‧軍團】的成員們！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n只要一起特訓，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "總會有辦法的！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這個嘛……",
    "voice": "vo_adv_1801001_020",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這麼說來我沒有想過這個問題──！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n總之，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "為了不忘記至今以來的努力，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n我和平常一樣在鍛鍊自己……",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "不過以過去相同的做法，",
    "voice": "vo_adv_1801001_021",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n感覺好像對變成公主型態時的能力",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "沒有什麼幫助。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "感覺需要一些",
    "voice": "vo_adv_1801001_022",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "和至今為止不同的全新練習……",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n嗯～",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "不過到底該怎麼做才好呢～",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "真的嗎？",
    "voice": "vo_adv_1801001_023",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "謝謝騎士先生！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n騎士先生也幫我一起想的話，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "一定能找到答案的！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
