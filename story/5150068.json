[
  {
    "type": "background",
    "bg_id": "502330"
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "蘭德索爾總是很熱鬧呢～",
    "voice": "vo_adv_5150068_000",
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "然後，",
    "voice": "vo_adv_5150068_001",
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "你又總是處於那個中心。",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "沒事吧？",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "不會累嗎？",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "這樣啊、這樣啊。",
    "voice": "vo_adv_5150068_002",
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n要是開心，",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "那就再好不過了吧～",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "不過啊～？",
    "voice": "vo_adv_5150068_003",
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n偶爾",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "度過什麼也",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "不做的悠哉時光",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "也是很好的喔～？",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "尤其是……",
    "voice": "vo_adv_5150068_004",
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "像這樣",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "跟成熟的大姐姐在一起的時光之類的。",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "也可以",
    "voice": "vo_adv_5150068_005",
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "什麼都不想地和我撒嬌喔～？",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "愛梅斯",
    "voice": "vo_adv_5150068_006",
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "去追涅比亞，也和你分頭行動了，",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n現在就只有我和你兩人獨處。",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "沒有任何人在看，",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "所以就稍微──",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "──放鬆一下吧？",
    "voice": "vo_adv_5150068_007",
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "呵呵，",
    "voice": "vo_adv_5150068_008",
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "懂得聽話很了不起呢～♪",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "那麼，",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我們就去搭上那邊的船，",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "隨波逐流一下吧。",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "……啊，",
    "voice": "vo_adv_5150068_009",
    "unit_id": 131813
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "不是坐那邊喔。",
    "voice": null,
    "unit_id": 131813
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 131813
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "像這樣",
    "voice": null,
    "unit_id": 131813
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "把背靠著我……",
    "voice": null,
    "unit_id": 131813
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "好嗎？",
    "voice": null,
    "unit_id": 131813
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "放鬆，",
    "voice": "vo_adv_5150068_010",
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "想像你飄浮在水面上，將自己委身於我。",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "你看～",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "開始感覺輕飄飄了吧？",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "如何？",
    "voice": "vo_adv_5150068_011",
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n有好好喘口氣……",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "了嗎？",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "啊……",
    "voice": "vo_adv_5150068_012",
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "身體的緊繃感消失了呢。",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "那麼",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "這次是",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "深呼吸～",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我的心跳聲",
    "voice": "vo_adv_5150068_013",
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "有傳過去吧？",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n配合著那個",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "慢慢地、",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "慢～慢地",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "喔。",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "很好呢～",
    "voice": "vo_adv_5150068_014",
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "很棒很棒～♪",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n我來摸摸你的頭吧～",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "咦？",
    "voice": "vo_adv_5150068_015",
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "你該不會開始睏了？",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n你的眼神變得迷離了喔～？",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "沒關係喔～",
    "voice": "vo_adv_5150068_016",
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "不要忍耐。",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n閉上眼睛，",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "只要聽著我的聲音",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "就好了哦～",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "唰啦",
    "voice": "vo_adv_5150068_017",
    "unit_id": 131813
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "唰啦，",
    "voice": null,
    "unit_id": 131813
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "波浪的搖晃真舒服呢～",
    "voice": null,
    "unit_id": 131813
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n夏天的陽光",
    "voice": null,
    "unit_id": 131813
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "暖洋洋的，",
    "voice": null,
    "unit_id": 131813
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "會讓身體溫暖起來喔。",
    "voice": null,
    "unit_id": 131813
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n我撫摸著的手",
    "voice": null,
    "unit_id": 131813
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "也很舒服吧～？",
    "voice": null,
    "unit_id": 131813
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "來，",
    "voice": "vo_adv_5150068_018",
    "unit_id": 131813
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "繼續放鬆吧。",
    "voice": null,
    "unit_id": 131813
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n把一～切都交給大姐姐。",
    "voice": null,
    "unit_id": 131813
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "呵呵呵，",
    "voice": "vo_adv_5150068_019",
    "unit_id": 131813
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "你是個好孩子呢～♪",
    "voice": null,
    "unit_id": 131813
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "呵呵♪",
    "voice": "vo_adv_5150068_020",
    "unit_id": 131813
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "呵呵呵……♪",
    "voice": null,
    "unit_id": 131813
  },
