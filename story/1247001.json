    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這才是我……",
    "voice": "vo_adv_1247001_073",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "真正的模樣喔！",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "哎呀，",
    "voice": "vo_adv_1247001_074",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "好嚴重的傷。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "什麼？",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "你揮舞那個劈柴工具與堅韌手套，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n有點玩過頭了？",
    "voice": null,
    "unit_id": 124711
  },
