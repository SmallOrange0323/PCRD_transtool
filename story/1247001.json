    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "因為我……",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "是密醫啊！",
    "voice": "vo_adv_1247001_085",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客們",
    "words": "（交頭接耳……）",
    "voice": "vo_adv_1247001_086",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "呵呵，",
    "voice": "vo_adv_1247001_087",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "對啊。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "和一般客人的距離，",
