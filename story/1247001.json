    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "醫生？",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "您不是說在支援來之前不看診的嗎──",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "你在說什麼啊？",
    "voice": "vo_adv_1247001_061",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我會一個都不剩地",
    "voice": "vo_adv_1247001_062",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "幫他們看診治療的。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "為患者看診",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "是醫生的職責，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "是使命。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "還有呃～",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我想想，那個啦，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "是存在的理由喔。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "咦……",
    "voice": "vo_adv_1247001_063",
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "可是醫生剛才──",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "真是的～",
    "voice": "vo_adv_1247001_064",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "領班先生？",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n你好歹也是有名旅館的職員吧？",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n再多學學何謂專業人員的矜持",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "會比較好喔。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "咦？",
    "voice": "vo_adv_1247001_065",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "你問那是什麼意思？",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n總之就是說……",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不准叫支援的人來的意思啦。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "所以，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "接下來就交給我吧。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "去、去♪",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "喔、",
    "voice": "vo_adv_1247001_066",
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "喔……",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "\\n",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "那、",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "那就拜託您了！",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "呵呵。",
    "voice": "vo_adv_1247001_067",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "畢竟我一直都在表裡社會往返嘛。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "轉變態度適應環境的速度之快，就是我的優點囉♪",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……話說回來，",
    "voice": "vo_adv_1247001_068",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "你聽見了嗎？",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "新年期間的溫泉旅館，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "真是個盲點。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "是超棒的營業場所呢。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "而且……",
    "voice": "vo_adv_1247001_069",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "現在這間旅館",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "聚集了來自蘭德索爾的溫泉顧客。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n要是能在這裡",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "灌輸他們「深月＝密醫」的形象，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n簡直就是最棒的宣傳呢。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "哼哼……",
