    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "患者2",
    "words": "\\n知道了啦！",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "患者2",
    "words": "錢我付就是了！",
