[
  {
    "type": "background",
    "bg_id": "500670"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "新年。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n待在溫泉旅館的{0}",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n遇見了在大廳角落嘆氣的深月。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "唉……",
    "voice": "vo_adv_1247001_000",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "真討厭。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "為什麼才剛過年就這樣。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "就算是厄年也太慘了，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不是厄年的話就更慘了……",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……啊？",
    "voice": "vo_adv_1247001_001",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "對吧？",
    "voice": "vo_adv_1247001_002",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "你",
    "voice": "vo_adv_1247001_003",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "可以聽我說嗎？",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我被人拜託了，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "要我開設「年初診所」。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "啊，",
    "voice": "vo_adv_1247001_004",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "年初診所指的是……",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n在醫院休診的新年期間，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n為這間旅館的急診患者診療的臨時診所？",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "大概是這樣。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我很困擾呢，",
    "voice": "vo_adv_1247001_005",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "莫名地這麼信任我。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "唉，",
    "voice": "vo_adv_1247001_006",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "要說是自作自受的話，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "也沒錯啦。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "畢竟我最近",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "老～是在幫助人呢……",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "救人、",
    "voice": "vo_adv_1247001_007",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "救旅館、",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "救醫院？",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "就我來說，實在是做過頭了。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "啊～找到了，",
    "voice": "vo_adv_1247001_008",
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "小深醫生！",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "\\n",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "……還真熱鬧耶。",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……什麼？",
    "voice": "vo_adv_1247001_009",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "啊，不。",
    "voice": "vo_adv_1247001_010",
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "\\n",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "別管那個了。醫生，",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "關於年初診所，",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "真是抱歉！",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "\\n這樣硬是拜託醫生。",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "但醫師肯來真的幫大忙了～",
    "voice": "vo_adv_1247001_011",
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "\\n每年都會來的醫師突然說有事不能來……",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "\\n",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "唉呀～這種事，",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "只能拜託小深醫生啊。",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "診療室在那邊，",
    "voice": "vo_adv_1247001_012",
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "我已經準備好了。",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "\\n要是有什麼不方便的，請馬上跟我說！",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "\\n",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "那麼這件事",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "就拜託了！",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "小深醫生！",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……知道了知道了。",
    "voice": "vo_adv_1247001_013",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……剛才的",
    "voice": "vo_adv_1247001_014",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "你聽到了嗎？",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "「小深醫生」是誰啊？",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n那種對善良又好親近的醫生才會用的親暱稱呼，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "希望他別再這麼叫了。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "才不是呢！！",
    "voice": "vo_adv_1247001_015",
    "unit_id": 124711
  },
  {
    "type": "still",
    "still_id": "124700101"
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……我說啊。",
    "voice": "vo_adv_1247001_016",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n大家可能都忘記了。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "但我",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "是密醫耶？",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "是祕密的",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "醫生喔。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "祕密，",
    "voice": "vo_adv_1247001_017",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "是在暗中喔？",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "是地下工作喔？",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "是非法的喔？",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n你說哪個世界的密醫會善良又好親近啊。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "說起來啊──",
    "voice": "vo_adv_1247001_018",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "欸～欸～小深醫生，",
    "voice": "vo_adv_1247001_019",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "妳戴在眼睛上的這個是什麼啊～？",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "\\n為什麼要遮住眼睛？",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "\\n",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "我可以拉拉看嗎～？",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……說、",
    "voice": "vo_adv_1247001_020",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "說起來！",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我不知道已經說過多少次了，",
    "voice": "vo_adv_1247001_021",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n我做醫生，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不過是順勢而為罷了。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n我的本行是研究者。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "開發新藥所需的費用，",
    "voice": "vo_adv_1247001_022",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "實在是太過龐大了。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n一般來說，可是需要大企業賭上公司命運才有辦法負擔的呢。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "而我一個獨行俠",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "要自己負擔起這些──",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客1",
    "words": "不過，",
    "voice": "vo_adv_1247001_023",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客1",
    "words": "我能理解孩子們為什麼會喜歡妳。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客1",
    "words": "\\n既溫柔，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客1",
    "words": "技術又高超。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客1",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客1",
    "words": "小深醫生，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客1",
    "words": "真的是個好醫生呢。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客2",
    "words": "對啊。",
    "voice": "vo_adv_1247001_024",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客2",
    "words": "\\n大人們也是，",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客2",
    "words": "即使沒有哪裡不舒服，",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客2",
    "words": "也會像這樣聚集在這裡。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客2",
    "words": "\\n小深醫生的存在本身就能讓大家放鬆呢。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客2",
    "words": "呵呵呵。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我一個獨行俠要自己負擔起這些，所以啊？",
    "voice": "vo_adv_1247001_025",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "所以，",
    "voice": "vo_adv_1247001_026",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我才選擇當「密醫」。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n因為要是不從黑社會那些不擇手段賺錢的人身上",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "榨取高額治療費，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n實在難以籌到開發費用啊。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "可是呢？",
    "voice": "vo_adv_1247001_027",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "如果善良醫生的形象就這麼定型了，",
    "voice": "vo_adv_1247001_028",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n時間安排與對外的形象，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "都會使得密醫工作難以進行，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n那麼開發新藥所需的金錢和時間",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "也都會一同失去。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "所以我",
    "voice": "vo_adv_1247001_029",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "非得維持密醫的身分不可。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n難以理解、",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "令人敬畏、",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "難以親近的──",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "啊～我知道了！",
    "voice": "vo_adv_1247001_030",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "這個，",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "是彈弓～！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "\\n",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "在這個花的位置放上珠珠～",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "\\n然後「啪」地彈出去，",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "就能飛得很遠的那個！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "嘿～",
    "voice": "vo_adv_1247001_031",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "啪啪。",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "啪啪。",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "\\n哈哈～♪",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客1",
    "words": "哈哈哈。",
    "voice": "vo_adv_1247001_032",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客1",
    "words": "\\n你們這樣做的話，小深醫生會痛痛的唷？",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客1",
    "words": "哈哈哈。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……總之。",
    "voice": "vo_adv_1247001_033",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n在其他醫生休息的新年期間幫忙看診，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n不就像是在宣傳我是個善良醫生嗎？",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "「今年請一定",
    "voice": "vo_adv_1247001_034",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "要讓我的密醫形象復活！」",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這願望，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n我才剛向溫泉之神祈求完的說……",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "唉……",
    "voice": "vo_adv_1247001_035",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "年初診所這工作，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我不該接下來的……",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "而且就連你……",
    "voice": "vo_adv_1247001_036",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "好像也完全誤會我了。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n這明明就",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不是我真正的模樣啊……",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "欸～",
    "voice": "vo_adv_1247001_037",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "欸～",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "我說小深。",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "\\n",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "小深～！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "至少要加上「醫生」的稱呼啦！",
    "voice": "vo_adv_1247001_038",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "孩子們",
    "words": "呀啊──♪",
    "voice": "vo_adv_1247001_039",
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "501890"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "但因為已經答應要做，深月也只能不情願地站起來，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n與{0}一起來到",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n作為臨時診所的房間──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "患者們",
    "words": "（人聲嘈雜……）",
    "voice": "vo_adv_1247001_040",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……這個患者數是怎麼回事？",
    "voice": "vo_adv_1247001_041",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "都已經在排隊了耶？",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "大過年的，溫泉旅館患者為什麼會這麼多？",
    "voice": "vo_adv_1247001_042",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n是把這裡誤認為大浴場了吧？",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "那個……",
    "voice": "vo_adv_1247001_043",
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "不是這樣的……",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "那些人",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "全都是患者。",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "\\n",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "而且接下來人應該會更多。",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "\\n",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "大概會比大浴場還擁擠……",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "歹勢！",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "咦咦？",
    "voice": "vo_adv_1247001_044",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "給我等一下。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n這麼多人，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我處理不完啦。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我說，",
    "voice": "vo_adv_1247001_045",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "叫支援的醫生來吧，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我自己一個是看不完的。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n努力找還是能找到的吧？",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n在支援人手來之前，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我不想開始看診。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "我想也是……",
    "voice": "vo_adv_1247001_046",
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "那個，",
    "voice": "vo_adv_1247001_047",
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "其實啊。",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "\\n我有件事，",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "非得先告訴小深醫生不可……",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "什麼？",
    "voice": "vo_adv_1247001_048",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n我不太想繼續聽下去就是了……",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "對，",
    "voice": "vo_adv_1247001_049",
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "正式名稱是",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "「地下職業夥伴新年事始會」。",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "\\n簡稱地新會，",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "我們是這麼稱呼的。",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "每年從除夕到新年結束，",
    "voice": "vo_adv_1247001_050",
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "他們會把我們頂樓的大房間，",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "\\n也就是寬敞套房一口氣包下來舉辦活動。",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "據說黑社會的各團體與個人會齊聚一堂，",
    "voice": "vo_adv_1247001_051",
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "\\n在除夕以溫泉洗去罪孽後，",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "\\n",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "整個新年期間",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "持續舉行盛大的宴會……",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "是黑社會新年的例行公事。",
    "voice": "vo_adv_1247001_052",
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "嗯，總之大家",
    "voice": "vo_adv_1247001_053",
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "都血氣方剛，",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "\\n喝酒方式不太尋常……",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "\\n",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "所以傷患、",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "以及因小紛爭而受傷的人源源不絕……",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "沒錯，",
    "voice": "vo_adv_1247001_054",
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "幾乎100%",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "都是黑社會的人。",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "\\n",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "溫泉旅館新年期間，",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "有錢但有些問題的客人會在此集會，",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "\\n成為他們的聚集地……",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "歹勢！",
    "voice": "vo_adv_1247001_055",
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "\\n若是一開始就說出來，",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "我想醫生一定會拒絕，所以……",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "我這就",
    "voice": "vo_adv_1247001_056",
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "去把支援的醫生找來！",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "\\n請稍等──",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "奇怪？",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "醫生呢？",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "咦？",
    "voice": "vo_adv_1247001_057",
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "好了，",
    "voice": "vo_adv_1247001_058",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "請多保重。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "下一位～",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "喂，我說你，",
    "voice": "vo_adv_1247001_059",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "{0}！",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n你要摸魚到什麼時候？",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n快點來幫忙。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "醫、",
