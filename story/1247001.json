    "voice": "vo_adv_1247001_075",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "別擔心。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n我不會報警。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我口風很緊的。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……好，",
    "voice": "vo_adv_1247001_076",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這樣就沒問題了。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "也不用再去其他醫院。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n那麼，來，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這是帳單。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "當然，只能一次付清喔♪",
    "voice": null,
    "unit_id": 124711
  },
  {
