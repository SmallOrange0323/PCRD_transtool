[
  {
    "type": "background",
    "bg_id": "500170"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "據說公主的城堡就在邊境地帶，而莉瑪等人正在前往那的途中。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "喂，你們看，",
    "voice": "vo_adv_5061006_000",
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "前方那個應該就是公主的城堡吧？",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "終於到了。",
    "voice": "vo_adv_5061006_001",
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不只道路沒有整修，",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "還會有魔物來襲，",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n這趟旅途還真辛苦呢。",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "何必蓋在如此偏僻",
    "voice": "vo_adv_5061006_002",
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "又荒涼的地方呢。",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "而且路上魔物這麼多，",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "這樣",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "根本沒辦法安心來玩嘛。",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "不，",
    "voice": "vo_adv_5061006_003",
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "那可不是能夠隨意去玩的地方吧。",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n妳到底打算去做什麼啊，真是的。",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "聽好了，",
    "voice": "vo_adv_5061006_004",
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "對方可是魔物的公主，",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "在她的城堡裡，",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n恐怕有陷阱和魔物在等著我們。",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "大家可要提高警覺哦。",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "background",
    "bg_id": "500260"
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "……我剛才那樣講，",
    "voice": "vo_adv_5061006_005",
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "結果什麼都沒有嘛！",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "連城堡裡",
    "voice": "vo_adv_5061006_006",
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "都非常寂寥呢。",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "乾脆把人家的玩偶",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "拿來裝飾一下吧？",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "公主，",
    "voice": "vo_adv_5061006_007",
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "請妳千萬不要那樣做……",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "那、",
    "voice": "vo_adv_5061006_008",
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "那個，",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "要是遇見了魔物的公主，",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我希望不要立刻開戰，",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n先試著跟她談談……",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "喂喂，",
    "voice": "vo_adv_5061006_009",
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "那也太樂觀了吧。",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "對不起，",
    "voice": "vo_adv_5061006_010",
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "但是……",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "從這座城堡，",
    "voice": "vo_adv_5061006_011",
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "能夠感覺到難以言喻的強烈感情……",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "雖然我完全不了解",
    "voice": "vo_adv_5061006_012",
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "魔物的公主，",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "但不知道為什麼，",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "總覺得有股",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "能夠跟她互相理解的預感。",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "真琴，",
    "voice": "vo_adv_5061006_013",
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "人家也",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "拜託妳了。",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "公主，",
    "voice": "vo_adv_5061006_014",
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "還有你也是……",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "唉，",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我也不想隨意就跟人打起來啦，",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n如果能靠溝通解決問題，",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "那就再好不過了。",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "哎呀呀，",
    "voice": "vo_adv_5061006_015",
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "真琴也",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "變得相當成熟了呢。",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "別開我玩笑了啦。",
    "voice": "vo_adv_5061006_016",
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "只不過，",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "這也要視對方態度而定了。",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n要是她不由分說地攻過來，",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我可會毫不猶豫地迎擊。",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我明白的，",
    "voice": "vo_adv_5061006_017",
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "再要求更多可就太過分了呢。",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "哦？",
    "voice": "vo_adv_5061006_018",
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "你們",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "快看那個。",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n還真是巨大的門呀，",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "讓人感覺就是這裡了呢。",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "是啊，",
    "voice": "vo_adv_5061006_019",
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "魔物的公主大概就在這裡面吧。",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n她手下的魔物或許也正嚴陣以待，",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "要做好心理準備哦。",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "background",
    "bg_id": "501230"
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "……快看，",
    "voice": "vo_adv_5061006_020",
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "深處的王座。",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "有人在那。",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "那就是公主嗎？",
    "voice": "vo_adv_5061006_021",
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "總覺得",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "這裡也很冷清呢，",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "明明是公主的房間呀。",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "別大意了，",
    "voice": "vo_adv_5061006_022",
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "這裡可是敵陣，",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n不可能發生對入侵者有利的事。",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "？？？ ",
    "words": "你們在怕什麼。",
    "voice": "vo_adv_5061006_023",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？ ",
    "words": "\\n陷阱和手下都不存在，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？ ",
    "words": "要來就快來。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "剛才的聲音是……",
    "voice": "vo_adv_5061006_024",
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "是啊，",
    "voice": "vo_adv_5061006_025",
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "肯定是那位公主沒錯。",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n竟然單槍匹馬迎接我們，",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我們還真是被小看了呢。",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "不知道",
    "voice": "vo_adv_5061006_026",
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "會發生什麼事呢。",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "來，",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "我們走吧。",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "妾身等很久了。",
    "voice": "vo_adv_5061006_027",
    "unit_id": 7012
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "妳們就是羅伊德派來的女孩們嗎？",
    "voice": null,
    "unit_id": 7012
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "那就是，",
    "voice": "vo_adv_5061006_028",
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "魔物的公主……？",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "比想像中還漂亮許多呢。",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "……原來如此，",
    "voice": "vo_adv_5061006_029",
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "不愧被稱為公主呢。",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n這傢伙強得可怕啊，",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "難怪她不需要依靠陷阱和手下。",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "哼，",
    "voice": "vo_adv_5061006_030",
    "unit_id": 7012
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "妳也是啊。",
    "voice": null,
    "unit_id": 7012
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "看來羅伊德那傢伙，",
    "voice": null,
    "unit_id": 7012
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "\\n挑了幾個相當厲害的人過來呢。",
    "voice": null,
    "unit_id": 7012
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "雖然有一個礙事的男人，",
    "voice": "vo_adv_5061006_031",
    "unit_id": 7012
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "但妾身就不計較了。",
    "voice": null,
    "unit_id": 7012
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "\\n那麼就讓妾身",
    "voice": null,
    "unit_id": 7012
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "來領教一下妳們的實力吧。",
    "voice": null,
    "unit_id": 7012
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "等、",
    "voice": "vo_adv_5061006_032",
