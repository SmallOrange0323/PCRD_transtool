    "unit_id": 7012
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "可惡，",
    "voice": "vo_adv_5061006_045",
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "這傢伙的確不是能夠手下留情的對手！",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n公主！",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真步",
