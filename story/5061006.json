    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "但是，",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "如果我沒遇見大家的話，",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n或許我也會變得跟她一樣呢。",
    "voice": null,
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "如果",
    "voice": "vo_adv_5061006_063",
    "unit_id": 115811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "是由於孤獨使她扭曲的話，",
