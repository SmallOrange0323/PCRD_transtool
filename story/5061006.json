    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "是絕對會阻止！",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "等妳冷靜一點以後，",
