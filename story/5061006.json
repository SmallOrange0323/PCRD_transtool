    "unit_id": 7012
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "\\n妾身就只能……",
    "voice": null,
    "unit_id": 7012
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "只能這麼做了啊！",
    "voice": null,
    "unit_id": 7012
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "……",
    "voice": "vo_adv_5061006_055",
    "unit_id": 7012
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
