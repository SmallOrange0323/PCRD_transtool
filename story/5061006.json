    "name": "真琴",
    "words": "喂！",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "是啊，",
    "voice": "vo_adv_5061006_068",
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "原來莉瑪小姐",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "就是莉瑪呀。",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "人家",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "驚訝得",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "連疼痛都飛走了呢。",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "妳們兩位……",
    "voice": "vo_adv_5061006_069",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "太好了，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "妳們都沒事呢。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "這點小傷可打不倒我們。",
    "voice": "vo_adv_5061006_070",
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "但是妳的",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "那副模樣……",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "果、",
    "voice": "vo_adv_5061006_071",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "果然很恐怖，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "對吧？",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "什麼？",
    "voice": "vo_adv_5061006_072",
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "妳在說什麼阿，",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "那健壯的體魄再加上凜然的相貌，",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "哪有什麼問題啊？",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "就算在【哞哞自衛隊】也能過得很好哦。",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "雖然這讚美讓我心情有些複雜，",
    "voice": "vo_adv_5061006_073",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "但我很開心哦。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "話說回來，莉瑪，",
    "voice": "vo_adv_5061006_074",
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "這邊這位公主，",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "妳打算怎麼處置呢？",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "……",
    "voice": "vo_adv_5061006_075",
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "那還用說，",
    "voice": "vo_adv_5061006_076",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "當然是跟她談談囉。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n畢竟是我們贏了呀，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "應該沒問題吧？",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "……哼，",
    "voice": "vo_adv_5061006_077",
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "真是天真透頂的傢伙。",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "\\n妳之後肯定會後悔沒有給妾身最後一擊哦？",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "天真這點是彼此彼此吧？",
    "voice": "vo_adv_5061006_078",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n因為妳剛才要是認真起來，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我可就束手無策了。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "況且",
    "voice": "vo_adv_5061006_079",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "如果要擄走羅伊德先生，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "對妳而言應該很簡單吧。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n之所以沒這麼做，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "就是因為妳很溫柔呀。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "……別說得好像妳很了解妾身，",
    "voice": "vo_adv_5061006_080",
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "真令人火大。",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "吶，",
    "voice": "vo_adv_5061006_081",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "公主殿下，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "如妳所見，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "這就是我真正的樣貌，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "跟妳是一樣的哦。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "……怎麼可能一樣。",
    "voice": "vo_adv_5061006_082",
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "明明外表同樣是野獸，",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "妳是如此美麗，",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "\\n然而，",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "妾身卻",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "不只是外貌，",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "連內心都非常醜陋。",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "因此",
    "voice": "vo_adv_5061006_083",
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "妾身就只能用如此愚蠢的方法，",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "\\n才有辦法接近羅伊德。",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "這點我也一直很在意呢。",
    "voice": "vo_adv_5061006_084",
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "明明有如此強大的力量，",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n我不懂妳為什麼要特別選擇人類的貴族。",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "真琴，",
    "voice": "vo_adv_5061006_085",
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "不是有句話說",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "「愛情是盲目的」嗎？",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n一旦喜歡上了，",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "種族的差異",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "根本無所謂，",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "對吧？",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "啊、",
    "voice": "vo_adv_5061006_086",
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "唔……",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "呃……",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "哎呀，",
    "voice": "vo_adv_5061006_087",
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "被人家說中了呀。",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "妳果然",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "是位公主呢。",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "別、",
    "voice": "vo_adv_5061006_088",
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "別戲弄妾身了……",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "其實",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "羅伊德是妾身的恩人，",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "同時也是青梅竹馬。",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "咦咦！",
    "voice": "vo_adv_5061006_089",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "那還真是個驚人的事實！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "在童年時期，",
    "voice": "vo_adv_5061006_090",
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "當妾身落入人類的陷阱時，",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "\\n為了狩獵而來訪此地的羅伊德救了妾身。",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "在那之後，",
    "voice": "vo_adv_5061006_091",
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "我們便不為人知地相見、",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "嬉戲。",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "\\n",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "因為雙方都還很幼小，",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "所以並不認為這有什麼問題。",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "但在一段時間後，",
    "voice": "vo_adv_5061006_092",
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "羅伊德離開了此地，",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "而這段關係也宣告了結束。",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "\\n",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "然而，",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "妾身始終",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "都無法忘記羅伊德。",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "妾身就在這無人的城堡中，",
    "voice": "vo_adv_5061006_093",
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "不斷地思念著那傢伙。",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "……",
    "voice": "vo_adv_5061006_094",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "然後在約一年之前，",
    "voice": "vo_adv_5061006_095",
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "羅伊德作為那間宅邸的主人回來了。",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "\\n坐立不安的妾身，",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "馬上就去見了那傢伙，但是……",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "在見到了妾身的瞬間，",
    "voice": "vo_adv_5061006_096",
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "那傢伙露出了恐懼的眼神。",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "\\n於是妾身明白了，我們已經無法回到像那時候的關係了……",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "……或許吧。",
    "voice": "vo_adv_5061006_097",
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "但是，",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "如果那樣做以後他還是想不起妾身呢？",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "\\n妾身實在害怕得不得了。",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "於是妾身決定了，",
    "voice": "vo_adv_5061006_098",
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "既然如此，",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "乾脆就表現得像個魔物吧。",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "\\n",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "因為以如此醜陋的樣貌，",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "不可能有辦法",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "和那傢伙正常地來往啊。",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "那麼，",
    "voice": "vo_adv_5061006_099",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "妳之所以會要他帶美麗而強大的女孩子來……",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "若是",
    "voice": "vo_adv_5061006_100",
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "比妾身還更強而美的女性，",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "那妾身也能死心了，",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "\\n最重要的是，",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "那樣就能安心地把羅伊德交給她了。",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "好，",
    "voice": "vo_adv_5061006_101",
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "話都說完了。",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "是妾身輸了，",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "\\n想怎麼處置妾身都悉聽尊便。",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "這樣啊。",
    "voice": "vo_adv_5061006_102",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "那麼……",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "去見羅伊德先生一面，好好地跟他說清楚！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "……什麼！？",
    "voice": "vo_adv_5061006_103",
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "為、",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "為什麼會變成那樣啊！",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "\\n妳這傢伙，",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "到底有沒有在聽妾身說話！",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "妳才不醜陋呢。",
    "voice": "vo_adv_5061006_104",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "妳只是",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "稍微搞錯了使用勇氣的方式而已。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n畢竟是女孩子嘛，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "當然也可能會發生這種事呀。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "只要內心還是美麗的，",
    "voice": "vo_adv_5061006_105",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "就還有機會改變。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n所以再一次地",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "去向他傳達妳的心意吧！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "不、",
    "voice": "vo_adv_5061006_106",
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "不是啦，",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "那個……",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "同為公主的人家",
    "voice": "vo_adv_5061006_107",
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "給妳一個忠告，",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "戀愛中的少女",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "全都是公主哦，",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "每個女孩肯定都是美麗的。",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "無法坦率的心情，",
    "voice": "vo_adv_5061006_108",
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我也非常明白……",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "啊，",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "沒、",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "沒什麼啦！",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "你們幾個……",
    "voice": "vo_adv_5061006_109",
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "好吧，",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "反正妾身也沒有拒絕的權利。",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "\\n既然都是被討厭的話，",
    "voice": null,
    "unit_id": 7011
  },
  {
    "type": "dialogue",
    "name": "魔物的公主",
    "words": "還不如堂堂正正地告白後再被討厭！",
    "voice": null,
    "unit_id": 7011
  }
]
