  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "你有兄弟姊妹嗎？",
    "voice": "vo_adv_6017302_000",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "啊，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "這麼說來，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "你好像是失去記憶了呢。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "那",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "你會想要兄弟姊妹嗎？",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "這種時候就算說謊也應該要說想要才對吧。",
    "voice": "vo_adv_6017302_001",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "說得也是，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "那麼",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "我就告訴你我妹妹的一些優點吧。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "給我在那裡坐好。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "坐直，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "正座坐好。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "雖然想說",
    "voice": "vo_adv_6017302_002",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "你眼光真的很不錯，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "不過很遺憾。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "雷姆是拉姆的妹妹唷。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "我是不會讓給你的。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "哼，那當然。",
    "voice": "vo_adv_6017302_003",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "不過，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "你還早一百年呢。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n如果你願意代替拉姆",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "煮飯掃地洗衣的話，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n倒是可以考慮看看喔？",
    "voice": null,
    "unit_id": 109811
  }
]
