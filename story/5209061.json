  {
    "type": "dialogue",
    "name": "旁白",
    "words": "復活祭之後。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n剎鬼在整理棺材裡的陪葬品時──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "……？",
    "voice": "vo_adv_5209061_000",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "為什麼，",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "會有這個……？",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "是雪野寫的信啊。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "我來看看……",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "still",
    "still_id": "520906101"
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "致",
    "voice": "vo_adv_5209061_001",
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "儂最喜歡的剎鬼：",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "\\n",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "坦白說，",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "由於事出突然，",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "至今儂仍沒有什麼實感。",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "\\n到了明天，",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "妳",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "是不是會像平常一樣，",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "出現跟儂",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "打招呼呢。",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "儂心裡",
    "voice": "vo_adv_5209061_002",
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "一直有這樣的感覺。",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "要真是如此就好了。",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "\\n",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "剎鬼妳還記得嗎。",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "埋在久遠冰河裡的時間膠囊。",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "\\n",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "妳和儂",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "在小時候約好了，",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "長大後要一起",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "打開呢。",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "儂放的",
    "voice": "vo_adv_5209061_003",
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "是信和玩具，要給將來的自己。",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "\\n",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "記得剎鬼放的",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "是信和短刀吧。",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "妳在那時候就很帥氣了。",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "\\n",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "從那麼小的時候",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "到現在，",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "剎鬼",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "都是儂",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "崇拜的對象。",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "並且，",
    "voice": "vo_adv_5209061_004",
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "在往後，",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "妳永遠都會是儂最喜歡的朋友。",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "\\n",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "雖然想到長大後，",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "只有儂一個人打開時間膠囊，",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "就覺得很寂寞，",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "\\n",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "但",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "這是儂家兩人的約定呢。",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "儂也很好奇剎鬼在信裡寫了什麼。",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "所以就算儂感到寂寞，",
    "voice": "vo_adv_5209061_005",
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "也會期盼未來，",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "像剎鬼一樣堅強地活下去。",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "\\n",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "真的很謝謝妳。",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "儂絕對不會",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "忘記剎鬼的。",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "\\n雪野敬啟　",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "　",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "　",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "　",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "　",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "　接續其二",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "（",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "果然還是寫不夠",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "）",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "「其二」……",
    "voice": "vo_adv_5209061_006",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "怎麼會有一整捆。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "喂，",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "竟然到「一百」啊……",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "呵。",
    "voice": "vo_adv_5209061_007",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "真是的……",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "機會難得，",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "就全部讀過吧。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "咦，",
    "voice": "vo_adv_5209061_008",
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "剎鬼……！？",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "\\n那、",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "那個是……",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "喔、",
    "voice": "vo_adv_5209061_009",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "喔，",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "雪野。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "謝謝",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "妳的信……",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "呀啊啊～",
    "voice": "vo_adv_5209061_010",
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "\\n感、",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "感覺好害羞，",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "妳不要再讀了～！",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在那之後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "「給剎鬼的信，其一到一百 by 雪野」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n就這麼被雪野",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "封印在久遠冰河的深處。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在意後續內容的剎鬼，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "似乎露出了感到可惜的表情。",
    "voice": null,
    "unit_id": null
  }
]
