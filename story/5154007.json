    "name": "旁白",
    "words": "已經一個月了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在阿爾克絲鍊金堂的工作室內，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n露易絲瑪莉如往常一樣站在鍊金釜前。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "「基創鍊成」！",
    "voice": "vo_adv_5154007_000",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "露易，",
    "voice": "vo_adv_5154007_001",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "完成了嗎──？",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "嗯，",
    "voice": "vo_adv_5154007_002",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "那邊有十個。",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n彩羽在貼標籤。",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "不，",
    "voice": "vo_adv_5154007_003",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "十個不夠。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n按這勢頭，",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "今天還可以再賣五十個……",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "真的假的？",
    "voice": "vo_adv_5154007_004",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "……真是賣得太好了啦。",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "唉……",
    "voice": "vo_adv_5154007_005",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "都是因為望那傢伙",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n在雜誌上說了那種話……！",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "嘿嘿，",
    "voice": "vo_adv_5154007_006",
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "是在說偶像雜誌的",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "慈樂之音特集吧～♪",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "彩羽",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "把小望的訪談報導",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "全都默背下來了！",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "欸，露易！",
    "voice": "vo_adv_5154007_007",
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "來玩重現訪談的遊戲吧！",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n彩羽來扮演",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "小望！",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "露易來扮",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "採訪員！",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "呃，",
    "voice": "vo_adv_5154007_008",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "那個新型遊戲是什麼啊。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "是說，",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "露易又沒有背下採訪，怎麼當採訪員。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "「作為偶像無敵的望小姐，",
    "voice": "vo_adv_5154007_009",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n認為自己的缺點是什麼？」",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "居然記得喔。",
    "voice": "vo_adv_5154007_010",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "「嘿嘿，",
    "voice": "vo_adv_5154007_011",
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "說我是無敵的偶像，",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "真是不敢當！（笑）",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n我還是",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "有很多缺點的。」",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "不是，",
    "voice": "vo_adv_5154007_012",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "這聲音好帥啊。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "「咦咦，",
    "voice": "vo_adv_5154007_013",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "真的嗎！？",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n那能不能",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "特別告訴我們一個缺點！？（懇求）」",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "「這個啊，",
    "voice": "vo_adv_5154007_014",
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "那",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "就來公開一個祕藏的情報。",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "……",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "我過去一直瞞著，",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "其實我啊，",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n是個超級重度的",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "戀味癖……！」",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "「戀味癖……！",
    "voice": "vo_adv_5154007_015",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "這、",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "這真是令人意外……」",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "「對吧～",
    "voice": "vo_adv_5154007_016",
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "不過總之，",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "我一聞到喜歡的味道就難以忍受。",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "雖然我有很多喜歡的氣味……」",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "「比如說，",
    "voice": "vo_adv_5154007_017",
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "聞著以前養的小狗肉球聞了二十小時左右。",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "還因為喜歡混了汗味的皮革氣味，",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "常常待在防具店裡……」",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "「可是……",
    "voice": "vo_adv_5154007_018",
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "當上偶像以後，",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "我就一直瞞著這件事。",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "要是這種事情曝光，",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "感覺大家會退避三舍，",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "誰都不會為我加油。",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "所以，",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "我就把這當作",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "絕對絕對",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "絕對的秘密。」",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "「這樣啊……？",
    "voice": "vo_adv_5154007_019",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "可是，",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "為什麼現在要說？",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n是有什麼能夠坦白的契機嗎？」",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "「是的。",
    "voice": "vo_adv_5154007_020",
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "是因為……",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "我有了一場非常美好的相遇。」",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "「我遇見了【阿爾克絲鍊金堂】裡，",
    "voice": "vo_adv_5154007_021",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "很棒的三個人。」",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "兩人",
    "words": "等等為什麼是妳來講啊──！！",
    "voice": "vo_adv_5154007_022",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "又沒關係。",
    "voice": "vo_adv_5154007_023",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "平常都是妳們在耍笨，",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n偶爾也讓我耍笨一下嘛。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "……咦，",
    "voice": "vo_adv_5154007_024",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "苑？",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n我",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "沒有覺得自己在耍笨啊。",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "因為露易是天生耍笨嘛。",
    "voice": "vo_adv_5154007_025",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "是這樣嗎！？",
    "voice": "vo_adv_5154007_026",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "總之，",
    "voice": "vo_adv_5154007_027",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "這本雜誌出版後，",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "店的生意連日來都很好。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "大家都要買這款香水。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "嘿嘿，",
    "voice": "vo_adv_5154007_028",
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "商品名字真帥呢！",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n是小望取的名字。",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "呵呵，",
    "voice": "vo_adv_5154007_029",
