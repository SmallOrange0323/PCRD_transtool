  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "唔……",
    "voice": "vo_adv_5213402_000",
    "unit_id": 20013
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "有點太強了吧……！",
    "voice": null,
    "unit_id": 20013
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 20013
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "太作弊了啦、太作弊了啦～！",
    "voice": null,
    "unit_id": 20013
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "梅莉莎太可憐了啦～！",
    "voice": null,
    "unit_id": 20013
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "才不是作弊。",
    "voice": "vo_adv_5213402_001",
    "unit_id": 138312
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n而且……",
    "voice": null,
    "unit_id": 138312
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "梅莉莎小姐，",
    "voice": null,
    "unit_id": 138312
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "對這個國家出手的人，是妳。",
    "voice": null,
    "unit_id": 138312
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n所以──",
    "voice": null,
    "unit_id": 138312
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "將我的信念寄託於這把劍上。",
    "voice": "vo_adv_5213402_002",
    "unit_id": 138312
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我會粉碎妳的野心。",
    "voice": null,
    "unit_id": 138312
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "哼……",
    "voice": "vo_adv_5213402_003",
    "unit_id": 20013
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "妳的天真，",
    "voice": null,
    "unit_id": 20013
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "已經不見了嘛。",
    "voice": null,
    "unit_id": 20013
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 20013
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "真是的，",
    "voice": null,
    "unit_id": 20013
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "煩死了。",
    "voice": null,
    "unit_id": 20013
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "好",
    "voice": "vo_adv_5213402_004",
    "unit_id": 20013
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "啦好啦，",
    "voice": null,
    "unit_id": 20013
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "是我輸了。",
    "voice": null,
    "unit_id": 20013
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "\\n尤絲──",
    "voice": null,
    "unit_id": 20013
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 20013
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "不對。",
    "voice": null,
    "unit_id": 20013
  },
  {
    "type": "dialogue",
    "name": "梅莉莎",
    "words": "……貪吃佩可。",
    "voice": "vo_adv_5213402_005",
    "unit_id": 20013
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "再見了……",
    "voice": "vo_adv_5213402_006",
    "unit_id": 138312
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "梅莉莎小姐。",
    "voice": null,
    "unit_id": 138312
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n如果哪天還能再相見，",
    "voice": null,
    "unit_id": 138312
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "到那時，我相信。",
    "voice": null,
    "unit_id": 138312
  },
  {
    "type": "background",
    "bg_id": "500090"
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "相信有能和妳一起，",
    "voice": "vo_adv_5213402_007",
    "unit_id": 138312
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "圍坐在餐桌前的未來。",
