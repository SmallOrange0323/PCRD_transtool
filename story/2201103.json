    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "犬、",
    "voice": "vo_adv_2201103_018",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "犬妖精族……？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n這種種族，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我沒聽過耶……？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "嚮導",
    "words": "是嗎？",
    "voice": "vo_adv_2201103_019",
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "嚮導",
    "words": "姑娘妳的世界裡沒有啊。",
    "voice": null,
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "嚮導",
    "words": "\\n那裡是不是只有魔族？",
    "voice": null,
    "unit_id": 9111
