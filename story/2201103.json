    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "呵呵呵，",
    "voice": "vo_adv_2201103_003",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "妳們興致很高昂呢。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "接觸新的文化是非常好的一件事，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n但也不能忘記",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我們是受託來調查魔物的喔？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "鈴奈＆美咲",
    "words": "好──！",
    "voice": "vo_adv_2201103_004",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "嚮導",
    "words": "不好意思……",
    "voice": "vo_adv_2201103_005",
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "嚮導",
    "words": "\\n各位是來自【月光學院】的冒險者嗎？",
    "voice": null,
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "是的。",
    "voice": "vo_adv_2201103_006",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "莫非您是",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n這次帶領我們進行這次調查的人嗎？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "嚮導",
    "words": "正是如此。",
    "voice": "vo_adv_2201103_007",
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "嚮導",
    "words": "我們世界裡的魔物",
    "voice": null,
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "嚮導",
    "words": "原本很少……",
    "voice": null,
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "嚮導",
    "words": "\\n所以大家",
    "voice": null,
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "嚮導",
    "words": "對魔物都不太瞭解。",
    "voice": null,
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "嚮導",
    "words": "\\n",
    "voice": null,
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "嚮導",
    "words": "這一次，",
    "voice": null,
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "嚮導",
    "words": "非常感謝各位前來幫忙。",
    "voice": null,
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "別這麼說。",
    "voice": "vo_adv_2201103_008",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "倒不如說是阿斯特朗世界的魔物",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "給你們添麻煩了。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我們會好好調查的，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "再妳多多指教了喔♪",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "……那個那個。",
    "voice": "vo_adv_2201103_009",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n小伊緒",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "雖然很平常地在和她對話……",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n但那是",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "狗對吧？",
