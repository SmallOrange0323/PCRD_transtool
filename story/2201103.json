  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "不是的。",
    "voice": "vo_adv_2201103_020",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我們有數種種族。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n除了我們魔族以外，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "還有精靈族跟人類……",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "還有少數",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "龍人族呢。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "嚮導",
    "words": "呵呵……",
    "voice": "vo_adv_2201103_021",
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "嚮導",
    "words": "數種種族嗎。",
    "voice": null,
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "嚮導",
    "words": "這樣的話妳們在「吉歐‧提格尼亞」",
    "voice": null,
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "嚮導",
    "words": "\\n會一直感到驚訝喔。",
    "voice": null,
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "嚮導",
    "words": "畢竟這個世界的種族",
    "voice": null,
    "unit_id": 9111
  },
  {
    "type": "dialogue",
    "name": "嚮導",
    "words": "\\n可是超過了100種呢～",
    "voice": null,
    "unit_id": 9111
