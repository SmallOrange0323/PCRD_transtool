  {
    "type": "dialogue",
    "name": "旁白",
    "words": "因魔物從阿斯特朗入侵而導致混亂的「吉歐‧提格尼亞」。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n接到{0}的委託，【月光學院】",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n前來調查入侵的魔物，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "順便進行校外教學。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "好的，",
    "voice": "vo_adv_2201103_000",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "各位，我們到了唷～",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "這裡據說就是",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "「吉歐‧提格尼亞」的王城，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n「帕菲之城」的城鎮。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "嗚哇～！",
    "voice": "vo_adv_2201103_001",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "就跟秀才說的一樣！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "房子之類的真的都是用點心蓋成的～！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "超級可愛～♪",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "鈴奈，",
    "voice": "vo_adv_2201103_002",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "這麼興奮的話就會顯得自己是個鄉巴佬了喔？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n真是的～",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "……這個真的可以吃嗎？",
