    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "詛咒……？",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "不好處理……？",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n我相信珠希一定會設法解決的♪",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "background",
    "bg_id": "501950"
  },
  {
