  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "那麼",
    "voice": "vo_adv_5114003_070",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我就先告辭了。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "下個生意的洽談迫在眉睫，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "失陪了！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "啊……",
    "voice": "vo_adv_5114003_071",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n這麼說來，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我好像忘了提醒，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我買下那個擺設的時候，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n骨董店的老闆說了",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "要多加注意什麼東西……",
