    "name": "莫妮卡",
    "words": "好了，",
    "voice": "vo_adv_5114003_076",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "要把這個擺設",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "放在哪裡呢？",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n說到吉祥物就是放在高處……",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "要是被貓弄掉下來會很危險的喵！",
