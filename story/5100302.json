[
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "牠還是不肯安分下來耶，",
    "voice": "vo_adv_5100302_000",
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "真步小姐，",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "怎麼辦！？",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "雖然咱們",
    "voice": "vo_adv_5100302_001",
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "也逐漸覺得疲勞了……",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "但是",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "還不到放棄的時候。",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n現在",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "該重整呼吸，",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "優雅地繼續戰鬥。",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "優、",
    "voice": "vo_adv_5100302_002",
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "優雅，",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "是要怎麼優雅啊──！？",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "首先",
    "voice": "vo_adv_5100302_003",
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "喝杯茶，",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "讓內心冷靜下來……",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "……好了，",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "植物羊先生！",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "這次",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "一定要讓你",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "聽咱們說話！",
