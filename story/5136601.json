[
  {
    "type": "background",
    "bg_id": "501322"
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "ある異変が静かに進行するランドソル。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "\\nムイミは謎の少女との接触のあと、異様な感覚に襲われていた。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "う～ん……",
    "voice": "vo_adv_5110601_000",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "さっきからなんか頭がぼうっとする……",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "街で起きてる異変と関係あるのか？",
    "voice": "vo_adv_5110601_001",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "だとしたら、",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "ちょっとマズいかもしれないな……",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "\\nアタシまであんなふうになるっていうのか……？",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "にしてもなんなんだ、",
    "voice": "vo_adv_5110601_002",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "この感覚……",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "どこか温かくて、",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "切なくて……",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "……なつかしい？",
    "voice": "vo_adv_5110601_003",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "あれ……？",
    "voice": "vo_adv_5110601_004",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "\\nなんか、",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "目の前が",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "真っ白に……？　",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "……オク、",
    "voice": "vo_adv_5110601_005",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "トー……",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "──っ！？",
    "voice": "vo_adv_5110601_006",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "\\n危ない危ない、",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "いまアタシ一瞬、",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "寝てたか！？",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "ん～、",
    "voice": "vo_adv_5110601_007",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "なんだ……",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "アタシ、",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "いつの間に外に……？",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "しかもなんか、",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "周りがぼやけてる？",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "これってやっぱ、",
    "voice": "vo_adv_5110601_008",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "夢……？",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "\\nそれにしては、",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "意識がちゃんとあるんだよな。",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "まぁ",
    "voice": "vo_adv_5110601_009",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "なんでもいいか！",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "\\n無理に考えるのはアタシのガラじゃないし、",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "\\nとりあえず元の場所に戻る方法を探すとするか！",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "……とはいえ",
    "voice": "vo_adv_5110601_010",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "目につくものといえば、",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "『アレ』くらいなんだよな。",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "うん。",
    "voice": "vo_adv_5110601_011",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "\\nやっぱり、",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "よく分からない不思議な結晶がいっぱい浮いてる。",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "明らかに普通じゃないよな、",
    "voice": "vo_adv_5110601_012",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "この結晶。",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "妙な力を感じる気はするけど……",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "それよりも不思議なのは……",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "……やっぱり、",
    "voice": "vo_adv_5110601_013",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "なつかしい気がする。",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "でも",
    "voice": "vo_adv_5110601_014",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "こんなものを見たことはないし、",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "これ自体がなつかしいというよりも……",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "\\nアタシの心に、",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "直接……",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "話しかけてきてるような？",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "……",
    "voice": "vo_adv_5110601_015",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "触ってみるか。",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "大丈夫だよな？",
    "voice": "vo_adv_5110601_016",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "\\n触った瞬間",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "ドカーン、",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "といったりしないよな？",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "オクトーがいたら",
    "voice": "vo_adv_5110601_017",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "「もっと慎重にいこうよ～」",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "とか言ってたんだろうな。",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "いや、",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "「面倒だから無視しない？」",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "かもしれないな。",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "……",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "ははっ。",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "でも",
    "voice": "vo_adv_5110601_018",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "ここにはアイツはいない。",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "\\nだったらアタシは、",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "アタシを信じるしかないもんな。",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "じゃあ、",
    "voice": "vo_adv_5110601_019",
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "いくぞ……！",
    "voice": null,
    "unit_id": 106116
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "触れた瞬間、結晶は光り輝き、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "\\nムイミの心に懐かしい光景をよみがえらせる──",
    "voice": null,
    "unit_id": null
  }
]
