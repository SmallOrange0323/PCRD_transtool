  {
    "type": "dialogue",
    "name": "菫",
    "words": "「那個，",
    "voice": "vo_adv_4010250_000",
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "騎士先生？",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "\\n您從方才",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "就一直站在",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "『冰箱』",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "前面做什麼呢？」",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "是在準備晚餐嗎……",
    "voice": "vo_adv_4010250_001",
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "看上去倒也不像。",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "\\n他叫我",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "待在「客廳」就好……",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "\\n",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "但我是不是",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "該過去幫忙比較好呢……？",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "「哇……！",
    "voice": "vo_adv_4010250_002",
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "\\n這個",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "『蛋糕』",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "是為我而準備的……？",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "\\n",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "謝謝您，",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "騎士先生！」",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "「不僅為無處可去的我",
    "voice": "vo_adv_4010250_003",
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "提供了棲身之所，",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "\\n甚至還如此大費周章地幫我慶祝生日。",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "\\n",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "我都不知道",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "該說什麼來表達心中感激了……！」",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "「說來慚愧，",
    "voice": "vo_adv_4010250_004",
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "我就連『生日』",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "都忘得一乾二淨了。",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "\\n雖然今天是『那邊的我』甦醒的日子，",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "但『這邊的我』",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "\\n至今仍不知自己的生日是何時，",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "怎麼好意思接受祝賀……」",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "「真的很感謝您",
    "voice": "vo_adv_4010250_005",
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "願意如此貼心相待。",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "\\n",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "不過……",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "那個，",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "騎士先生",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "若不嫌棄，",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "\\n不如與我一同享用這個",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "『蛋糕』",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "如何？」",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "「我曾聽人說過，",
    "voice": "vo_adv_4010250_006",
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "所謂生日，",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "並非只是誕生在這世上的日子，",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "\\n也是慶祝自己",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "平安度過了一整年",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "的日子。」",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "「我之所以能夠",
    "voice": "vo_adv_4010250_007",
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "在這片陌生土地上",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "平安度日，",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "\\n",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "都是多虧了",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "騎士先生的大力相助。",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "\\n",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "這只是聊表",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "我對您的",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "一絲",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "感激之情。」",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "而且，",
    "voice": "vo_adv_4010250_008",
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "之所以",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "會忘記如此重要的日子……",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "\\n",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "正代表了",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "如今我與騎士先生",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "相處的每一天",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "\\n是多麼歡喜、多麼充實。",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "「謝謝……！",
    "voice": "vo_adv_4010250_009",
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "\\n",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "那我這就去拿",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "『刀子』過來。」",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "「兩人共享一個",
    "voice": "vo_adv_4010250_010",
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "『蛋糕』，",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "\\n感覺",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "就像故事中的一幕似的。",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "\\n",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "感謝您安排了",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "如此美妙的生日祝賀，",
    "voice": null,
    "unit_id": 133131
  },
  {
    "type": "dialogue",
    "name": "菫",
    "words": "騎士先生……♪」",
    "voice": null,
    "unit_id": 133131
  }
]
