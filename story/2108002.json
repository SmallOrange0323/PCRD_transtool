    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我覺得",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "這果然還是太奇怪了。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "話雖如此……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "倘若不論我再怎麼上諫，",
    "voice": "vo_adv_2108002_049",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "都無法改變主君的決心，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "之後",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "就讓我壓抑自己的不滿，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "為了實現主君的目標盡心盡力……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我想這一定才是",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "優秀的臣子該有的表現吧。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "克蕾琪塔小姐……",
    "voice": "vo_adv_2108002_050",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……好像來了喔。",
    "voice": "vo_adv_2108002_051",
    "unit_id": 118011
  },
  {
    "type": "still",
    "still_id": "210800201"
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "哦～呵呵呵♪",
    "voice": "vo_adv_2108002_052",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n讓各位久等了！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n【墨丘利財團】",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "的改裝型飛空艇",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "前來報到了♪",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "非常感謝你們",
    "voice": "vo_adv_2108002_053",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "應緊急召集而來。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n【墨丘利財團】。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "哎呀哎呀，",
    "voice": "vo_adv_2108002_054",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "克蕾琪塔小姐！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n聽說妳解散了【里士滿工商會】，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "讓我很擔心妳……",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "但看到妳這麼有精神，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "這真是太好了♪",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……唉。",
    "voice": "vo_adv_2108002_055",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n如果只照著字面來解讀，這番話分明就是一套諷刺。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n但就因為妳百分之百是真的在擔心我，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "這反而令人佩服啊……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "background",
    "bg_id": "500090"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "秋乃小姐。",
    "voice": "vo_adv_2108002_056",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n非常感謝妳。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n謝謝妳願意接受",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這麼胡來的要求……",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "不客氣，",
    "voice": "vo_adv_2108002_057",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "公主殿下。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "畢竟【憤怒‧軍團】",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "也對我們",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "以及蘭德索爾的市場",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n造成了龐大的損害。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我非常樂意",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "幫忙喔♪",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "真的",
    "voice": "vo_adv_2108002_058",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "非",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "常感謝妳。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不過",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "只要妳能把移動的方法借給我們，",
