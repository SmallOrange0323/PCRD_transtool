[
  {
    "type": "background",
    "bg_id": "509040"
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……選了我，",
    "voice": "vo_adv_9500048_000",
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "是嗎？",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "做出令人意外的選擇，",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "本就是你的拿手好戲。",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "事到如今，我也不會再感到驚訝了。",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……才怪。",
    "voice": "vo_adv_9500048_001",
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "對不起，",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我是騙你的。",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "其實我相當慌張，",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "心跳也變快了。",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "真是有損[rub:One Eye Devil]獨眼惡魔[/rub]之名啊。",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我，",
    "voice": "vo_adv_9500048_002",
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "一直很隨心所欲地對待你呢。",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "把你當成實驗對象、",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "當成助手，",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "甚至當成小睡時的枕頭。",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "即使如此，",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "你卻沒有露過一絲不情願的表情。",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我就覺得你真是個有趣的孩子。",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "漸漸地，",
    "voice": "vo_adv_9500048_003",
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "只有在你面前，",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我開始無法保持冷靜。",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我很清楚，",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "那就是",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "危險的初期症狀。",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n……身為一個大人，",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我也很清楚，",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "自己應該要抽身。",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我不斷思考，",
    "voice": "vo_adv_9500048_004",
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "卻總得出相同的結論，",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "那就是不能再繼續和你待在一起了。",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n可是，",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我卻以助手為藉口，",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "始終沒能放開你。",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "連合理的決定都做不出來，",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我根本不配當科學家。",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "「好醫生」什麼的……",
    "voice": "vo_adv_9500048_005",
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這可是密醫",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "最不想聽到的稱讚呢。",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不過，",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "如果是你來說的話──",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我倒是不討厭。",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "因為自己是密醫、",
    "voice": "vo_adv_9500048_006",
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "因為年齡，",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "又或是出於算計，",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "明明我找了一堆藉口，",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n可是在你面前，",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "那些早已失去了意義。",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……體溫……",
    "voice": "vo_adv_9500048_007",
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "比正常體溫",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "略高了一點。",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "也有出汗的現象。",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "和我",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "一樣呢。",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "那我就相信……",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "你也是認真的吧。",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "既然如此──",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "既然選擇了我，",
    "voice": "vo_adv_9500048_008",
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "你應該做好覺悟了吧？",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n當了密醫的助手，",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "就得當一輩子喔，我可不會解雇你。",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n因為我需要",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "你這瓶萬靈藥。",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……呵呵。",
    "voice": "vo_adv_9500048_009",
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "你錄取了。",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "今後也要",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "陪我做",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "很～多實驗喔。",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n……",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "放心吧，",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我不會讓你痛的。",
    "voice": null,
    "unit_id": 105141
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "應該吧♪",
    "voice": null,
    "unit_id": 105141
  }
]
