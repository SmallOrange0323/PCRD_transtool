    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "但在炒過後就會變好吃……",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "呃，{0}！",
    "voice": "vo_adv_1017009_051",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n你還在喔～！？",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
