  {
    "type": "dialogue",
    "name": "mimi",
    "words": "今天是和優衣在阿斯特朗傳奇相遇的日子。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "510220"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "放學後，{0}留在教室裡，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n他的mimi收到了這樣的訊息。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "好……",
    "voice": "vo_adv_9006006_000",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "是今天",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "沒有錯吧？",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "嗯，",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "沒問題……",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "從早上到現在我已經確認過很多次了。",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "雖然",
    "voice": "vo_adv_9006006_001",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "真琴要我",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "把這個當作一個契機……",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n但",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "要自己主動搭話好難啊……",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "哇啊啊！？",
    "voice": "vo_adv_9006006_002",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n{0}？",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "那個……",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我的mimi收到了通知……",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "啊，",
    "voice": "vo_adv_9006006_003",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "這樣啊……",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "你也有收到呀。",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n說得也是，",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "系統統一發送的嘛。",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "自從在阿斯特朗傳奇裡遇見你到現在，",
    "voice": "vo_adv_9006006_004",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n已經過了那麼長時間了呀……",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我們明明早就認識了呢。",
    "voice": "vo_adv_9006006_005",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "有種",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "不可思議的",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "感覺～",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "啊，",
    "voice": "vo_adv_9006006_006",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "你不用道歉啦！",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n這一點我們都一樣……",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "在這麼多玩家裡，",
    "voice": "vo_adv_9006006_007",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n我們真的是碰巧遇見的。",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n沒認出來是很正常的。",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "不過，",
    "voice": "vo_adv_9006006_008",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "或許也是因為這樣。",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n我總覺得",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "這就像是命運一樣……",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n啊，",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我在說什麼呢！",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "對不起，",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "說了奇怪的話！",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "這、",
    "voice": "vo_adv_9006006_009",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "這個話題可以不用接下去了啦……",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n不過，",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "如果我沒有玩阿斯特朗傳奇的話，",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n或許就沒有機會",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "可以這樣好好聊天了呢。",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "託這個遊戲的福，",
    "voice": "vo_adv_9006006_010",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "和你……",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "當、",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "當然還有其他人",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "都變得更加親近了呢。",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "從這個意義上來說，",
    "voice": "vo_adv_9006006_011",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "也許今天是我們的紀念日……",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "也得好好感謝",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "阿斯特朗傳奇才行呢。",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "那個，",
    "voice": "vo_adv_9006006_012",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "所以……",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n這麼一個難得的紀念日，",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "如果你願意的話……",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "等一下",
    "voice": "vo_adv_9006006_013",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "要不要找個地方慶祝一下呀？",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "如果你有想去的地方的話，",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "去那裡就好了……",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "咦，",
    "voice": "vo_adv_9006006_014",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "你願意嗎……？",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n地點也是",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "挑我喜歡的地方就好……？",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "那……",
    "voice": "vo_adv_9006006_015",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "那我知道",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "一間好吃的咖啡廳！",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我再把地點告訴你，",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我們先回家一趟再會合……",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "咦咦咦！？",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "現、",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "現在就去嗎……",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "可是，",
    "voice": "vo_adv_9006006_016",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "那樣的話，",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n學校的人都會看到我們一起回家哦？",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n你不介意嗎？",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "不會，",
    "voice": "vo_adv_9006006_017",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我不介意。",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "一點都不介意！",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "那我們",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "一起走吧！",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "只要和你在一起，",
    "voice": "vo_adv_9006006_018",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我就能得到勇氣，",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n無論是在這裡",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "還是阿斯特朗傳奇裡……",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "和你在一起，",
    "voice": "vo_adv_9006006_019",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我就什麼都不怕。",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n所以，",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "以後也多多關照囉。",
    "voice": null,
    "unit_id": 100231
  }
]
