  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "你……",
    "voice": "vo_adv_9500032_000",
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "這樣啊，",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "你選擇了",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我啊。",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "嘛，",
    "voice": "vo_adv_9500032_001",
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "畢竟",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我跟你交情這麼好呢。",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "不管怎麼說，",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我們都認識那麼久了，",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "相處起來也很輕鬆嘛。",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n就算是我，",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "應該也會做出一樣的選擇吧。",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "所以…………",
    "voice": "vo_adv_9500032_002",
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n…………",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "真的是",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "太好了……",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我",
    "voice": "vo_adv_9500032_003",
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "說啊，",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "遇到這種情況",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "怎麼可能保持冷靜啊！",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n我先說好，",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我可是緊張得不得了。",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n因為",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "選擇一個人，",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "就代表……",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "「特別」",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "的意思，對吧？",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "你的「特別」，",
    "voice": "vo_adv_9500032_004",
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "就在今天這一天確定下來了。",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n或許我們之間的關係",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "會因此改變……",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "之類的。",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n想到這些，",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我怎麼可能冷靜得下來。",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "唉……",
    "voice": "vo_adv_9500032_005",
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "還真是不爭氣。",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n只要跟你獨處，",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "就什麼都",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "掩飾不了。",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "不過嘛，",
    "voice": "vo_adv_9500032_006",
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "事到如今，",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "也沒什麼好糾結的了。",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "雖然是假扮的，",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "但也和你",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "當過夫妻了。",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "正因如此……",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "才必須好好說清楚。",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "──我，",
    "voice": "vo_adv_9500032_007",
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "喜歡你喔，",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "{0}。",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "而且，",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "比你所想的",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "還要、還要",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "喜歡你呢。",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "今後，",
    "voice": "vo_adv_9500032_008",
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "也希望你",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "能在我身邊。",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "不是在其他人身邊，",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "而是在我的身邊……",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n希望你能比任何人都還要靠近我，",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "只看著",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我一個人。",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "雖然以前我還會害羞，",
    "voice": "vo_adv_9500032_009",
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "但現在我可以",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "大大方方地說出來了。",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "這份心意",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "今後也永遠不會改變。",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "對我來說，",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "就只有你一個人喔。",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "這樣",
    "voice": "vo_adv_9500032_010",
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "你明白了嗎？",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "如果明白的話……",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "就緊緊抱住我，",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "作為證明吧。",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "現在，",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我只想",
    "voice": null,
    "unit_id": 102841
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "感受你。",
    "voice": null,
    "unit_id": 102841
  }
]
