[
  {
    "type": "background",
    "bg_id": "500420"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "通往露娜之塔的入口。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n那裡有位夢想一獲千金的龍人族少女充滿了幹勁。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "感覺到了，",
    "voice": "vo_adv_7027000_000",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我感覺到了……！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那座塔",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "散發著有大賺頭的氣味！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我不是那個意思啦！",
    "voice": "vo_adv_7027000_001",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n小哥你之前不是有說過嗎！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "你曾經在露娜之塔內，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "找到寶石和稀有魔導具之類的寶物！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那些東西肯定能賣很多錢！",
    "voice": "vo_adv_7027000_002",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "你懂嗎，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "小哥！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這可是",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "成為億萬富翁的大好機會！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "只要有錢，",
    "voice": "vo_adv_7027000_003",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "就無所不能！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n連要收買蘭德索爾中的幫派成員，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "也都能靠錢來搞定！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "裝備準備萬全！",
    "voice": "vo_adv_7027000_004",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我一定要在露娜之塔內得到寶物！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n然後一口氣",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "登上黑社會的頂點！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "啊啊，",
    "voice": "vo_adv_7027000_005",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "對了對了。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我記得塔內好像也有小哥的記憶線索吧？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我會在尋寶時順便幫你找的，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "誰叫我這麼溫柔呢！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "呵呵呵……",
    "voice": "vo_adv_7027000_006",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我的計畫真是太完美了！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……只不過",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "有一點除外。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……這是我聽嘉夜夜說的。",
    "voice": "vo_adv_7027000_007",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "聽說露娜之塔中會出現各種危險的魔物。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "所以我本來也希望嘉夜夜能來的……",
    "voice": "vo_adv_7027000_008",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n但她今天卻偏偏有生意要忙，不能來！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "唉……",
    "voice": "vo_adv_7027000_009",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "只靠我和小哥，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n真的有辦法爬這座巨塔嗎……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不、",
    "voice": "vo_adv_7027000_010",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不對！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "都走到這一步了，事到如今還在怕什麼啊！？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "只是，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "沒錯……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我們應該要做好萬全的準備對吧？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "很、",
    "voice": "vo_adv_7027000_011",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "很遺憾，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這次或許放棄探索露娜之塔比較好……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這就是所謂有勇氣的撤退！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "好了，",
    "voice": "vo_adv_7027000_012",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "雖然麻煩，但我們回去吧！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "──呀哇～！",
    "voice": "vo_adv_7027000_013",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "噫！？",
    "voice": "vo_adv_7027000_014",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "哀號聲！？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "聲、",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "聲音從哪傳來的……！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "background",
    "bg_id": "500520"
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "啊、",
    "voice": "vo_adv_7027000_015",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "啊哇哇哇哇……！？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n有人掉下來了！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這到底是怎麼回事～！？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "background",
    "bg_id": "500420"
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "痛痛痛痛痛……",
    "voice": "vo_adv_7027000_016",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "真是的，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "那傢伙",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "還真是粗暴耶……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "話說，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "之前好像也發生過這種事……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "算了，",
    "voice": "vo_adv_7027000_017",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "無所謂。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "喂，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "壞蛋在哪裡！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n由我來打倒你們！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "嗯……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "奇怪？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "哦～",
    "voice": "vo_adv_7027000_018",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "{0}！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "還有祈梨！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n你們過得好嗎？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "妳在那裡",
    "voice": "vo_adv_7027000_019",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "悠哉地問候什麼啦！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "到底是發生了什麼事，才會讓妳突然從天而降啊！？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "嗯？",
    "voice": "vo_adv_7027000_020",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這也沒有那麼稀奇吧？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "被人打飛到天上，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這種事滿常發生的啊。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "怎麼可能會有",
    "voice": "vo_adv_7027000_021",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那種事啊！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n夠了，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "快點說妳為什麼會來這裡！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "沒什麼，",
    "voice": "vo_adv_7027000_022",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "原因很簡單！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我在旅途中請認識的人",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n幫我施加了魔法。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "就是「轉移到壞蛋所在之處的魔法」！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "居然特地請人對自己施加那種奇怪魔法……",
    "voice": "vo_adv_7027000_023",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "矛依未真是",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "相當危險的傢伙呢……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "妳說的",
    "voice": "vo_adv_7027000_024",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "「危險」",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "是在誇獎我吧？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "哼哼，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "可以再多誇獎我喔！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
