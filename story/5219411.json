    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n禁止獨佔雜碎哥哥！",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n雖然我也會去發明，",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
