  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "帳號凍結解除了！",
    "voice": "vo_adv_5219411_000",
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n又能爆紅並拿到獎金了！",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n……",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "應該是這樣的才對，",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "但都已經結束了吧～！",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "快樂的時間總是過得特別快呢～♪",
    "voice": "vo_adv_5219411_001",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "我完全不快樂～！",
    "voice": "vo_adv_5219411_002",
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "雖然隱身號的設計圖被收購了，",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n但獎金也沒能拿回來啊～！",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "我之前就在想了……",
    "voice": "vo_adv_5219411_003",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n布武機",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "光是拿到零用錢就滿足了嗎？",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "咦？",
    "voice": "vo_adv_5219411_004",
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n妳在說什麼……？",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "這個夏天",
    "voice": "vo_adv_5219411_005",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "我有很多跟布武機在一起的時間吧？",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "所以我就想啊，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "能製作出隱身號的布武機，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n會因為一點小獎勵",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "就滿足了",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "嗎～",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "能拿到的錢我就會想拿！",
    "voice": "vo_adv_5219411_006",
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "那就是我！",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "話說，",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "受人吹捧得到的錢",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "很特別啊～♡",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "但要問我滿不滿足，",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "我是不滿足啦……",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "既然如此，",
    "voice": "vo_adv_5219411_007",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "妳就忘了獎金，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n努力發明吧？",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "如果是身為天才的布武機，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "應該輕輕鬆鬆吧♪",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "唔……",
    "voice": "vo_adv_5219411_008",
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "哼！",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "那是理所當然的吧──？",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "畢竟我可是天才！",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "確實？",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "就像班比說的那樣，",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "比起執著於獎金，",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n講究發明可能更有建設性♪",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "好──",
    "voice": "vo_adv_5219411_009",
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "那我就來發明新東西，",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n這次一定要大賺特賺♡",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "哼哼──！",
    "voice": "vo_adv_5219411_010",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "畢竟班比",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "也會成長啊！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "那麼，僕從♪",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "跟班比一起度過，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "再一下下就要結束的夏天吧♪",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "……呃，",
    "voice": "vo_adv_5219411_011",
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "喂──！",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "班比──！",
