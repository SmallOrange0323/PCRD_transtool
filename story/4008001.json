    "type": "dialogue",
    "name": "花凜",
    "words": "各公會可當作獎勵拿回去喔♪",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "真的嗎！？",
