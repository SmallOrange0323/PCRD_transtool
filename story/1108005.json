    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我叫克蘿依……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "克蘿依。",
    "voice": "vo_adv_1108005_064",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "今後也請多多指教呢。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "謝、",
