    "type": "dialogue",
    "name": "店長",
    "words": "克蘿依。",
    "voice": "vo_adv_1108005_068",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "我都看到了唷。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊，店長……",
    "voice": "vo_adv_1108005_069",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "這次沒關係的。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n我下次會謹言慎行的。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "是啊。",
    "voice": "vo_adv_1108005_070",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n不過",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "如果能優先為店裡的業績考量的話",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "就太好了。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "不過，",
    "voice": "vo_adv_1108005_071",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "我要修正一句話。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "抱歉。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "妳好像很適合",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "這份工作呢。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "接下來也請妳多指教囉，",
    "voice": "vo_adv_1108005_072",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "克蘿依。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊？",
    "voice": "vo_adv_1108005_073",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "喂，快一點！",
    "voice": "vo_adv_1108005_074",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n不能讓",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "客人等唷！",
