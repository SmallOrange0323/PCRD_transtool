[
  {
    "type": "background",
    "bg_id": "500370"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "克蘿依尋找著新的工作地點，\\n雖然有幾份工作面試沒通過，\\n不過被以年輕人為客群的二手衣店錄取，站在賣場裡。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "歡迎光臨",
    "voice": "vo_adv_1108005_000",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n妳在找什麼衣服嗎――",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "吶，",
    "voice": "vo_adv_1108005_001",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "店員。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "\\n我想買這件衣服，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "有沒有大一號的尺寸？",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊，",
    "voice": "vo_adv_1108005_002",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "抱歉，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "如果架上沒有的話就沒有了呢――",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "這樣啊……",
    "voice": "vo_adv_1108005_003",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "我很喜歡這個設計，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "\\n但這個尺寸對我來說有點太小了，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "怎麼辦……",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "吶，",
    "voice": "vo_adv_1108005_004",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "店員？",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "\\n妳覺得",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "如果是這種比較合身的穿法，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "還適合嗎？",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊……",
    "voice": "vo_adv_1108005_005",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "怎麼說好呢。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "是不錯啦，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不過以姐姐來說，比起緊繃感，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n寬鬆的感覺可能會比較適合妳。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "咦？",
    "voice": "vo_adv_1108005_006",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "還有說真的那個設計，",
    "voice": "vo_adv_1108005_007",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n很難搭配下身，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "那樣子沒問題嗎？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "咦……",
    "voice": "vo_adv_1108005_008",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "那個……",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "沒，",
    "voice": "vo_adv_1108005_009",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "沒問題的唷！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "因為客人很可愛",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "所以穿什麼都很完美唷！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "呵呵呵，",
    "voice": "vo_adv_1108005_010",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "那麼",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "請慢慢看～！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "……",
    "voice": "vo_adv_1108005_011",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "克蘿依。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n可以來這邊一下嗎？",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "好。",
    "voice": "vo_adv_1108005_012",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "我說克蘿依～妳啊！",
    "voice": "vo_adv_1108005_013",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "什麼事店長。",
    "voice": "vo_adv_1108005_014",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "欸！",
    "voice": "vo_adv_1108005_015",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n不是還有",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "更圓滑點的說法嗎！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n妳這樣還算是貼近顧客的接待態度嗎！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊……",
    "voice": "vo_adv_1108005_016",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "要巴結客人的意思嗎。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "我可沒這麼說。",
    "voice": "vo_adv_1108005_017",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "反正妳，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n也不適合笑咪咪地表現親切，對吧。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "雖然馬上就被否定的感覺很微妙，",
    "voice": "vo_adv_1108005_018",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不過的確是這樣呢。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "那個呀？",
    "voice": "vo_adv_1108005_019",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n妳那種，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n很沒勁，和人疏離的個性，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "我是不介意啦。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "原來不介意啊。",
    "voice": "vo_adv_1108005_020",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "嗯，",
    "voice": "vo_adv_1108005_021",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "像我們這種主打年輕人客群的店，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n有個性的人才",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "也會比較受歡迎？",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊，",
    "voice": "vo_adv_1108005_022",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "從店長的角度來看是指那個嘛。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "THE‧個性。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "對我自己來說，",
    "voice": "vo_adv_1108005_023",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n我想要讓客人有一種",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "來見朋友的感覺",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n也比較會",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "讓人想進來呢。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "但再怎麼說，",
    "voice": "vo_adv_1108005_024",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "我們是服務業。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "得讓客人心情變好，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n卯起來購買商品才行。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "因為客人身材不好，",
    "voice": "vo_adv_1108005_025",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "所以應該要把身體的線條藏起來之類的，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n那種多餘的話不需要特別說出來唷。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "哎呀，我，沒有說的那麼直接啦。",
    "voice": "vo_adv_1108005_026",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "聽起來也差不多唷。",
    "voice": "vo_adv_1108005_027",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "不行唷，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "這種年紀的女孩子",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "對那方面很敏感的。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊，",
    "voice": "vo_adv_1108005_028",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "嗯，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "對――",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "的確呢。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "抱歉，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我會注意的。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "……什麼嘛，",
    "voice": "vo_adv_1108005_029",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "妳那個。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "在鬧彆扭嗎？",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不，完全沒有。",
    "voice": "vo_adv_1108005_030",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n你說得很有道理，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我也很認真的在反省。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n我的表情天生就長這樣。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "嗯……",
    "voice": "vo_adv_1108005_031",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "像這種類型的孩子",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n原本想說有一個的話應該會很有趣，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "就錄用了――",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "但該不會是我看走眼了呢。",
    "voice": "vo_adv_1108005_032",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n妳還是……",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "不適合、",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "這份工作吧？",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊，",
    "voice": "vo_adv_1108005_033",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我真的有在反省啦。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n啊不是，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我正在反省了。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "請讓我繼續在這裡上班。",
    "voice": "vo_adv_1108005_034",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "是嗎？",
    "voice": "vo_adv_1108005_035",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "既然這樣",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "就讓我再多觀察一下吧……",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "哎呀，",
    "voice": "vo_adv_1108005_036",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "有新的客人來了喔。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "那麼克蘿依，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "交給妳囉。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "遵命。",
    "voice": "vo_adv_1108005_037",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n歡迎光臨～",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "出現了。",
    "voice": "vo_adv_1108005_038",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n又來了啊。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n已經變成習慣了啊。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "咦，你來幹嘛。",
    "voice": "vo_adv_1108005_039",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n這裡是賣女裝的服飾店，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "{0}，我應該把你當作是有那方面興趣的朋友嗎。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊，",
    "voice": "vo_adv_1108005_040",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "如果你是認真的話，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "那也完全沒問題啦。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n男裝女裝之類的，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "只是為了方便而區分的，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "只要不是可疑的變態之類的話，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我甚至願意幫你加油。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "所以，我再問你一次。",
    "voice": "vo_adv_1108005_041",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n你來幹嘛的。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "想也是如此。",
    "voice": "vo_adv_1108005_042",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n嗯，大概懂了。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "對。",
    "voice": "vo_adv_1108005_043",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不過，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "今天也許是最後一天。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "雖然，我是無所謂啦。",
    "voice": "vo_adv_1108005_044",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n反正本來就打算兼職嘗試不同的工作，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "只要再找其他地方……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "嗯，",
    "voice": "vo_adv_1108005_045",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "有一點？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "因為剛剛，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n被罵不適合",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "這份工作。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "唉，",
    "voice": "vo_adv_1108005_046",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我的頭要痛了。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "再怎麼說，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n我都秉持著以客為尊的態度啊……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "你看，因為、",
    "voice": "vo_adv_1108005_047",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "從客人角度來看啊？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n客人都是拿著揮汗賺取的錢，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "或努力存下的零用錢，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n為了尋找自己喜歡的衣服而來到這裡的吧。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "但是這時候隨便地就被釣上鉤，",
    "voice": "vo_adv_1108005_048",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n最後買了不適合的衣服的話，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n仔細想想不是有點悲慘。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我不禁就會那麼想……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "是嗎。",
    "voice": "vo_adv_1108005_049",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "真的很溫柔的話，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n就不會",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "被說不適合了吧。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "嗯，但是，",
    "voice": "vo_adv_1108005_050",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "謝謝你。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n能夠對我這麼說，感覺稍微被安慰到了唷。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "噗……",
    "voice": "vo_adv_1108005_051",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "好，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "反省，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "轉換心情吧。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不過，話說回來，",
    "voice": "vo_adv_1108005_052",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n要判斷適不適合的還是當事人呢。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "即便被問了，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "別人也無從置喙呢。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊",
    "voice": "vo_adv_1108005_053",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "對了，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "你剛剛迷路了吧。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我差不多可以休息了，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "你等一下。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n讓我送你到容易找路的地方――",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "店員，",
    "voice": "vo_adv_1108005_054",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "可以打擾一下嗎？",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊啊，",
    "voice": "vo_adv_1108005_055",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "妳是剛剛的。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "怎麼了。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "那個？　",
    "voice": "vo_adv_1108005_056",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "我自己也不是很懂，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "我想說",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "可不可以請店員",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "一起陪我選呢。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊？　",
    "voice": "vo_adv_1108005_057",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "……是沒問題啦，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不過為什麼？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "因為妳，",
    "voice": "vo_adv_1108005_058",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "是可以信任的。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "而且看到覺得奇怪",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "也會和我說。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊――",
    "voice": "vo_adv_1108005_059",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "那件事……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "很抱歉。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "嗯嗯，",
    "voice": "vo_adv_1108005_060",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "沒事啦沒事啦。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "雖然剛剛一瞬間嚇了一跳，",
    "voice": "vo_adv_1108005_061",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "\\n不過比起",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "買了後悔，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "這樣好得多！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "妳能誠實的告訴我是幫了我大忙――！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "啊對了，",
    "voice": "vo_adv_1108005_062",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "能夠告訴我",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "妳的名字嗎？",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊，",
