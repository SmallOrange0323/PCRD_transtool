[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "為了陪伴千歌進行現場演唱的練習，\\n{0}正在等著跟千歌碰面。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "你好。",
    "voice": "vo_adv_1042003_000",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n時間剛剛好呢。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "那麼，我們出發吧。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "果然在有人煙的地方練習，我還是會覺得害羞……",
    "voice": "vo_adv_1042003_001",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我們去平常去的森林吧。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "雖然可能會出現魔物，",
    "voice": "vo_adv_1042003_002",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "但跟你在一起的話，我一定能好好對付牠們的。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "只要跟你在一起，",
    "voice": "vo_adv_1042003_003",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n令人恐懼的事物就會消失無蹤……",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "……",
    "voice": "vo_adv_1042003_004",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "啊，沒什麼，什麼事都沒有。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "那麼，我們趕快去練習吧。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "background",
    "bg_id": "500170"
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "……你、",
    "voice": "vo_adv_1042003_005",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "你覺得如何呢？",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "嗯……我自己也覺得唱得不太好。",
    "voice": "vo_adv_1042003_006",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n不知道為什麼，我覺得自己好像被很多人看著……",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "很奇怪對吧？",
    "voice": "vo_adv_1042003_007",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "這裡應該只有你在而已啊……",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "儘管如此，我卻感受到像是他人視線般的氣息……",
    "voice": "vo_adv_1042003_008",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "有如在大家面前唱歌時一樣……",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──呱歐歐歐歐歐",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "呀啊啊啊啊啊！",
    "voice": "vo_adv_1042003_009",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n是、是魔、魔物啊──！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "不是只有……魔物的聲音……！？",
    "voice": "vo_adv_1042003_010",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "剛剛我們確實聽到了慘叫聲吧！？",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我們趕快去救他們吧！",
    "voice": "vo_adv_1042003_011",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n聲音是從那邊傳來的！",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "你們還好嗎――！？",
    "voice": "vo_adv_1042003_012",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "親衛隊長",
    "words": "──千、",
    "voice": "vo_adv_1042003_013",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "親衛隊長",
    "words": "千歌……！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "親衛隊長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "親衛隊長",
    "words": "那個，我、我們是千歌的粉絲……！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "親衛隊長",
    "words": "\\n因為聽說了妳似乎在森林中練習的傳聞……所以就……！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我的粉絲……？",
    "voice": "vo_adv_1042003_014",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "你們是為了我，所以才來到這樣的森林深處……？",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "親衛隊員",
    "words": "對、對不起！",
    "voice": "vo_adv_1042003_015",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "親衛隊員",
    "words": "\\n我們雖然知道會很危險，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "親衛隊員",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "親衛隊員",
    "words": "但沒想到真的有魔物出現……！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──呱歐歐歐歐歐",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "親衛隊長",
    "words": "咿咿咿咿咿咿！",
    "voice": "vo_adv_1042003_016",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "親衛隊長",
    "words": "！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "有話等等再說吧。請大家退到後面去！",
    "voice": "vo_adv_1042003_017",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n首要之務是先把魔物給打倒！",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "still",
    "still_id": "104200101"
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "{0}，我現在要來唱喚精靈，",
    "voice": "vo_adv_1042003_018",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "請你幫忙轉移魔物的注意。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n拜託你了！",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "精靈",
    "words": "──！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘰歐歐歐歐歐",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "呼……",
    "voice": "vo_adv_1042003_019",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "總算是打敗牠們了呢。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "親衛隊員",
    "words": "我、",
    "voice": "vo_adv_1042003_020",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "親衛隊員",
    "words": "我們得救了。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "親衛隊員",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "親衛隊員",
    "words": "千歌，謝謝妳！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "親衛隊員",
    "words": "\\n妳戰鬥的樣子也非常帥氣喔！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "…………",
    "voice": "vo_adv_1042003_021",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "親衛隊長",
    "words": "咦、咦？千歌……？",
    "voice": "vo_adv_1042003_022",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "請你們不要做出這麼危險的事情……！",
    "voice": "vo_adv_1042003_023",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "在這附近，真的經常有魔物出現。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n而你們卻什麼武器都沒帶就跑進森林裡……！",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "如果大家發生了什麼事情的話，",
    "voice": "vo_adv_1042003_024",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我……！",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "親衛隊長",
    "words": "千、千歌……對不起啊。",
    "voice": "vo_adv_1042003_025",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "親衛隊長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "親衛隊長",
    "words": "我們太不小心了……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "……你們有在反省的話，那就好了。",
    "voice": "vo_adv_1042003_026",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "而且……",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "你們說你們是我的粉絲，",
    "voice": "vo_adv_1042003_027",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n而且還說想聽我唱歌，",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n這讓我非常的高興。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "謝謝你們。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "……剛剛我一時慌了手腳，真是不好意思。",
    "voice": "vo_adv_1042003_028",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n不過，真的發生了什麼事的話就太遲了……",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "就請你們今後不要再做出這麼危險的事情囉。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "親衛隊長",
    "words": "……當、",
    "voice": "vo_adv_1042003_029",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "親衛隊長",
    "words": "當然啊！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "親衛隊長",
    "words": "\\n我們跟妳約定好！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "親衛隊員",
    "words": "妳竟然會這麼擔心我們……！",
    "voice": "vo_adv_1042003_030",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "親衛隊員",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "親衛隊員",
    "words": "果然千歌最棒了！！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "親衛隊員",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "親衛隊員",
    "words": "我們會一直支持千歌的喔……！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "謝謝你們。",
    "voice": "vo_adv_1042003_031",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n……",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "這裡可能還會有魔物出現，",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我們回去城鎮上吧。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "親衛隊長",
    "words": "那個……話說，那邊那位像騎士的人是誰？",
    "voice": "vo_adv_1042003_032",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "親衛隊長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "親衛隊長",
    "words": "該、",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "親衛隊長",
    "words": "該不會……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "對、對！他是我們的經紀人！",
    "voice": "vo_adv_1042003_033",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "像今天這樣去城鎮外練習時，",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n我也會請他做我的護衛喔？",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "嗯、",
    "voice": "vo_adv_1042003_034",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "嗯嗯！就是這樣！",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我有請護衛好好地跟著我並保護我。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "親衛隊員",
    "words": "原來是這樣啊……",
    "voice": "vo_adv_1042003_035",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "親衛隊員",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "親衛隊員",
    "words": "下次我們再來看妳練習時，也會請人當我們的護衛喔！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "那個……可以的話，請你們不要公開我在練習的事情……",
    "voice": "vo_adv_1042003_036",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "總之今天就告一段落，我們回城鎮去吧。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "background",
    "bg_id": "500011"
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "今天真是謝謝你了。 ",
    "voice": "vo_adv_1042003_037",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n沒有人受傷，",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "真是太好了……",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "可是，這也只是結果論呀。",
    "voice": "vo_adv_1042003_038",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n實際上因為我，害我的粉絲們陷入危險了……",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我明明是身處要保護大家的立場……",
    "voice": "vo_adv_1042003_039",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "發生這種事情可是不行的呢。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "可是，要我在城鎮內練習……",
    "voice": "vo_adv_1042003_040",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我還不太習慣在別人面前唱歌。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "……你說自信嗎？",
    "voice": "vo_adv_1042003_041",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "的確，要在粉絲們面前唱歌的話，",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n必須要相信自己跟自己的歌聲呢。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "……說的也是呢。",
    "voice": "vo_adv_1042003_042",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "今後，我的歌聲會傳達給更多的人。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "如果總是這樣自己一個人獨唱的話，是改變不了什麼的呢。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "……在森林裡的練習，就這樣結束吧。",
    "voice": "vo_adv_1042003_043",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "如果像今天這樣，粉絲也跟過來的話就危險了。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "為了讓自己更有自信，我得習慣在大眾面前唱歌才行。",
    "voice": "vo_adv_1042003_044",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "今後，我想開始進行為達成此目標的練習。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "只要這世上，有任何一個人喜歡我的歌聲……",
    "voice": "vo_adv_1042003_045",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "……為了報答像這樣的人，今後我也會繼續唱下去。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "咦……咦咦！？",
    "voice": "vo_adv_1042003_046",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "喜、喜喜、喜歡……！？",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "……是指我唱的歌嗎？",
    "voice": "vo_adv_1042003_047",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "說、說的也是呢！你是在說唱歌的事情吧！",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "……嚇我一跳……",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "謝謝你喜歡聽我唱歌。",
    "voice": "vo_adv_1042003_048",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "……可是，為什麼呢？",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我覺得有一點遺憾呢……",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "千歌不曉得理由，\\n但心中感到莫名的失落。",
    "voice": null,
    "unit_id": null
  }
]
