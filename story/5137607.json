[
  {
    "type": "background",
    "bg_id": "500031"
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "その日、一仕事を終えたノウェムとオクトーは、帰路についていた。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "んー、",
    "voice": "vo_adv_5111607_000",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "今日はサクッと終わったね。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "とりあえず",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "ご飯でも行こうか。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "……なあオクトー、",
    "voice": "vo_adv_5111607_001",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "前から気になってたんだけど、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\nオマエのモンスターを操る能力、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "あれって楽しいのか？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "なんだい、",
    "voice": "vo_adv_5111607_002",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "藪から棒に。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "だって戦闘って、",
    "voice": "vo_adv_5111607_003",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "自分の手でぶっ飛ばしてこそだろ？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\nそれが楽しいとこじゃないのか？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "なのに",
    "voice": "vo_adv_5111607_004",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "モンスターにやらせて",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "自分は見てるだけなんて、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "アタシには全然分からないぞ！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "うーん、",
    "voice": "vo_adv_5111607_005",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "これは一生埋まらない見解の相違だね。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "まずボクは",
    "voice": "vo_adv_5111607_006",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "戦闘が好きなわけではないし、",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "痛いのとか本当に勘弁してほしいよね。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "そんなボクみたいな人間にとって",
    "voice": "vo_adv_5111607_007",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "モンスターを操る能力は、",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "\\n楽できて最高なんだよね。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "……そっかぁ。",
    "voice": "vo_adv_5111607_008",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "あれ、",
    "voice": "vo_adv_5111607_009",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "今なんか",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "かわいそうな目で見なかった？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "そんなことはないぞ！",
    "voice": "vo_adv_5111607_010",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "じゃあ",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "お気に入りのモンスターとかっているのか？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "そうだね、",
    "voice": "vo_adv_5111607_011",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "単純に火力の高いのはいいよね。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "\\n戦闘がすぐに終わるから",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "すごくありがたいよ。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "逆に長期戦狙いなら",
    "voice": "vo_adv_5111607_012",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "デバフ要員が輝くね。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "じっくりと攻め落とすのも",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "乙なもんさ。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "あとは",
    "voice": "vo_adv_5111607_013",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "弱めのモンスターでも",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "使い方次第で",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "相手の虚をつけるから、",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "\\nそこはボクの",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "腕の見せ所だね。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "へぇ、",
    "voice": "vo_adv_5111607_014",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "色々考えて戦ってたんだな？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "やっと分かってくれた？　",
    "voice": "vo_adv_5111607_015",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "結構苦労してるんだからさぁ。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "ああ",
    "voice": "vo_adv_5111607_016",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "そういえば、",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "最近扱いの難しいじゃじゃ馬がいてね。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "\\n強さはピカイチなんだけど、",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "ここがちょっとね。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "まあ、",
    "voice": "vo_adv_5111607_017",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "モンスターだもんな。",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "仕方ないだろ。",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "それだけならまだしも、",
    "voice": "vo_adv_5111607_018",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "ちっこくてうるさくて、",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "さすがのボクも手を焼いてるよ。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "おい待てオクトー、",
    "voice": "vo_adv_5111607_019",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "そのじゃじゃ馬ってもしかして──",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "は～、",
    "voice": "vo_adv_5111607_020",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "お腹空いたね。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "早くお店に行こうか、",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "ノウェム♪",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "おいコラ！　",
    "voice": "vo_adv_5111607_021",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "ちゃんと答えろ",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "この野郎ー！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "そそくさと逃げ出すオクトーの背を追いかけるノウェムだった。",
    "voice": null,
    "unit_id": null
  }
]
