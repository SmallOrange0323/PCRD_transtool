    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "だからなんだってわけでもないけど……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "力になってやれよな！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "おう！",
    "voice": "vo_adv_6056403_001",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "でもオマエ、",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "アタシと違って危なっかしいところあるからなー。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "張り切りすぎて、",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "海に落ちないように気をつけろよ！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "へっ？　",
    "voice": "vo_adv_6056403_002",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "アタシか？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "アタシはべつに、",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "あのおっちゃんの仲間とかじゃないけど……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "へへっ、",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "助けてほしいなら仕方ないな！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "　ノウェム様に任せとけ！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "……そうだよな。",
    "voice": "vo_adv_6056403_003",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "オマエらが一緒なら、",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "おっちゃんもヨユーだろ！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "さっさと片づけて帰ってこいよな！　",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "そんでうまいもん食うぞ！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "海は寒いから風邪ひくなよ！　",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "暖かいカッコしろよ！　",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "いいな！",
    "voice": null,
    "unit_id": 106113
  }
]
