  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "其實，",
    "voice": "vo_adv_5031000_000",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "因為今天想向各位做歲末問候，",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "正在\\n前往大家的公會小屋途中呢，",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "能遇到你們真是太好了。",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "這一年來，",
    "voice": "vo_adv_5031000_001",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "真是承蒙",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "大家的照顧。",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我代替咲戀大小姐，",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "在此向各位致上深厚的謝意。",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不敢當不敢當～",
    "voice": "vo_adv_5031000_002",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我們才一直受她關照呢！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n今年",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "真的非常感謝你們！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "大家都穿著和服呢，",
    "voice": "vo_adv_5031000_003",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "是等一下要去參拜嗎？",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是的。",
    "voice": "vo_adv_5031000_004",
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "機會難得，",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "我們想在神殿迎接新年以後，",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n就這樣直接去參拜。",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "如果鈴莓小姐方便的話，",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "要不要也一起來呢？",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "好的，",
    "voice": "vo_adv_5031000_005",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "請務必讓我參加！",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "話說回來，",
    "voice": "vo_adv_5031000_006",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "還真難得妳會落單。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n平常總是一直叫著大小姐大小姐～",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "的嘛。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "因為大小姐她",
    "voice": "vo_adv_5031000_007",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "最近十分忙碌……",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "唉。",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "唔唔，",
    "voice": "vo_adv_5031000_008",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "妳的嘆氣感覺別有深意呢。",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n是和咲戀吵架了嗎？",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我怎麼膽敢跟大小姐吵架！",
    "voice": "vo_adv_5031000_009",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "是我一直給大小姐添麻煩……",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "難得的除夕",
    "voice": "vo_adv_5031000_010",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "也太鬱悶了吧～",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳冒冒失失又不是一天兩天的事了？",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n有必要這麼沮喪嗎？",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "……其實是，",
    "voice": "vo_adv_5031000_011",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "前幾天大小姐和",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "談生意的對象有個晚宴，",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n而我",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "擔任了晚宴的服務員。",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "然後，",
    "voice": "vo_adv_5031000_012",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我一緊張就打翻了湯品……",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n把、",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "把湯",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "灑在生意對象身上了！",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "就算我想挽回名譽，",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "最近也沒什麼",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "能和大小姐說話的時間……",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "說不定，",
    "voice": "vo_adv_5031000_013",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "大小姐會如此忙碌",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "也是我造成的，",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n我一直在想她是不是",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "在忙著幫我善後。",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "還是說，",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "她已經對我厭煩了，",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "正在找其他的女僕呢……",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "鈴莓小姐，",
    "voice": "vo_adv_5031000_014",
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "妳想多了。",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n無法與",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "自己侍奉的人交談，",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "的確會很難受。",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但是，",
    "voice": "vo_adv_5031000_015",
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "咲戀小姐",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "並不是會因為那種事就對鈴莓小姐",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n做出刻薄舉動的人。",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "還請妳",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "千萬不要迷失了自我……",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "說、",
    "voice": "vo_adv_5031000_016",
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "說的也是呢。",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "難、",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "難得的除夕，",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "還跟你們說這些，",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "真是抱歉。",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不過，",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "多虧了你們，我稍微安心一點了。",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "謝謝你們。",
    "voice": null,
    "unit_id": 112111
  },
  {
    "type": "background",
    "bg_id": "500910"
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "咦？",
    "voice": "vo_adv_5031000_017",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "　那裡好像人山人海的耶――",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "一定要獲勝喔喔喔喔喔喔喔喔！",
    "voice": "vo_adv_5031000_018",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "根據這個算式，",
    "voice": "vo_adv_5031000_019",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "我們一定會獲勝的。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "我會……",
    "voice": "vo_adv_5031000_020",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "打倒……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "敵人……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "什、",
    "voice": "vo_adv_5031000_021",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "什麼啊，怎麼這麼吵！",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是有什麼活動嗎？",
    "voice": "vo_adv_5031000_022",
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "要在這個人潮中前進",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "似乎很困難呢。",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "今天！",
    "voice": "vo_adv_5031000_023",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "也就是在這個除夕……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "將會確定即將到來的新年福氣要落在誰家！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "\\n讓各位久等了！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "\\n「蘭德索爾的新春公會競速賽」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "馬上就要開始了！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "競速賽？",
    "voice": "vo_adv_5031000_024",
    "unit_id": null
  }
]
