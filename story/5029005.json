  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "3位候補聖誕老人回到了蘭德索爾的城鎮上。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n時間已近日暮時分，一天即將要結束了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "呵呵呵！",
    "voice": "vo_adv_5029005_000",
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "\\n辛苦囉！",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "小姐們。",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "聖誕老人！？",
    "voice": "vo_adv_5029005_001",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "你這人是怎樣啊。",
    "voice": "vo_adv_5029005_002",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "途中完全都沒有露臉，",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n你真的有見證了我們精采的表現嗎？",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "那當然。",
    "voice": "vo_adv_5029005_003",
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "\\n",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "老夫可是",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "看得很仔細呢。",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "那就好……",
    "voice": "vo_adv_5029005_004",
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你現身在我們面前，",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n就表示你已經有結論囉？",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "嗯。",
    "voice": "vo_adv_5029005_005",
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "老夫一路看到現在，",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "\\n妳們3位，",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "真的都非常努力。",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "察覺人們的願望，",
    "voice": "vo_adv_5029005_006",
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "\\n",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "並且努力幫他們實現的那副模樣，",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "\\n",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "只有一句話可以形容，那就是做得太棒了！",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "雖然有些地方做得有點過火，",
    "voice": "vo_adv_5029005_007",
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "\\n",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "不過這全都是因為",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "妳們想要帶給所有人快樂的緣故。",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "\\n",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "要當聖誕老人",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "沒有這種拚勁可是不行的。",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "哼，",
    "voice": "vo_adv_5029005_008",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "那是當然的☆",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "畢竟妾身是遲早會統領整個世界的支配者啊。",
    "voice": "vo_adv_5029005_009",
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "傾聽人民的願望",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "也是妾身的工作。",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "整個過程都很開心。",
    "voice": "vo_adv_5029005_010",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "當聖誕老人",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "原來是這麼棒的工作啊！",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "所以，",
    "voice": "vo_adv_5029005_011",
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "這個袋子的繼承人……",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "\\n老實說，",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "妳們3位真的難分軒輊。",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "喂喂。",
    "voice": "vo_adv_5029005_012",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "你該不會要給我說什麼3個人一起",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "當聖誕老人，這種多方討好的話吧？",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這妾身可沒辦法接受。",
    "voice": "vo_adv_5029005_013",
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n若是這樣的話，目前為止的努力到底算什麼。",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯。",
    "voice": "vo_adv_5029005_014",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "正因為我們很努力，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n所以才需要一個明確的答案。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "呵呵。",
    "voice": "vo_adv_5029005_015",
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "我知道！我知道！",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "\\n",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "所以，我認為就",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "由他來代替老夫做決定吧。",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "在整個過程中，",
    "voice": "vo_adv_5029005_016",
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "他在妳們身旁看著的時間比誰都久，",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "\\n就由他來選出最適合當聖誕老人的人選吧。",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "這樣的話，",
    "voice": "vo_adv_5029005_017",
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "小姐",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "妳們也沒有意見吧？",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯！　",
    "voice": "vo_adv_5029005_018",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "如果是{0}的判斷，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n不管是什麼結果，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我都會接受的！",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "確實，比起今天才遇到的聖誕老人，",
    "voice": "vo_adv_5029005_019",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n他的可信度更高。",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯。",
    "voice": "vo_adv_5029005_020",
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "那麼，",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "就由{0}來決定是誰吧。",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "來吧！",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "說出你的答案吧！",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "呵。",
    "voice": "vo_adv_5029005_021",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我就知道小子一定會選我的。",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n晚一點",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我再好好的獎勵你……♪",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "唔唔。",
    "voice": "vo_adv_5029005_022",
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "沒想到妾身竟然會輸給這傢伙……！",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不過，",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "結果就是結果，",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "沒辦法。",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯。",
    "voice": "vo_adv_5029005_023",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我也是，我相信製作人",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "一定會準備",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n能帶給大家歡樂的禮物！",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "真不愧是{0}，",
    "voice": "vo_adv_5029005_024",
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你判斷的很好！",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n早晚妾身和你",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "是不是能成為像那個、",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "聖誕老人夫婦一樣呢……？",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "恭喜妳！伊莉亞！",
    "voice": "vo_adv_5029005_025",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我很期待",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "妳的禮物喔！",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "嗯。",
    "voice": "vo_adv_5029005_026",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "雖然很不甘心，",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "但就讓給妳吧！",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "伊莉亞‧奧恩斯坦。",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我想妳應該能帶給我一個合我胃口的刺激聖誕節吧……♪",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "真的嗎！？　",
    "voice": "vo_adv_5029005_027",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "謝謝！",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嘿嘿嘿～",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "感覺好像在作夢……",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "【慈樂之音】的偶像也不是虛有其表呢。",
    "voice": "vo_adv_5029005_028",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "聖誕老人兼偶像啊，",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n這樣我做製作人也值得了呢♪",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妳只要送妾身下一場演唱會的門票",
    "voice": "vo_adv_5029005_029",
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "當作聖誕禮物就可以了。",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "因為妾身很期待！",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "呵呵。",
    "voice": "vo_adv_5029005_030",
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "原來如此。",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "\\n我相信",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "你的選擇。",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "那麼，",
    "voice": "vo_adv_5029005_031",
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "被選中的幸運兒啊，",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "我就將這個袋子賜與妳――",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "精英馴鹿1",
    "words": "噗喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔！\\n（我是不會讓你得逞的啊啊啊啊啊啊啊！）",
    "voice": "vo_adv_5029005_032",
    "unit_id": 4011
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "唔哇！？",
    "voice": "vo_adv_5029005_033",
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "\\n怎、",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "怎麼回事？",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "馴鹿先生！？",
    "voice": "vo_adv_5029005_034",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "啊！",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "聖誕老人的袋子被搶走了……",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "唔！？",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "等一下！",
    "voice": "vo_adv_5029005_035",
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "快還來！",
    "voice": "vo_adv_5029005_036",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "精英馴鹿2",
    "words": "噗喔喔喔！\\n（別妨礙我！）",
    "voice": "vo_adv_5029005_037",
    "unit_id": 4011
  },
  {
    "type": "background",
    "bg_id": "500037"
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯！？　",
    "voice": "vo_adv_5029005_038",
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你……",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "到底想做什麼？",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n突然攻擊過來……！",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "剛剛那可是漂亮的一擊。",
    "voice": "vo_adv_5029005_039",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "要是被打中可就精彩了？",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "精英馴鹿3",
    "words": "噗喔喔喔！　",
    "voice": "vo_adv_5029005_040",
    "unit_id": 4011
  },
  {
    "type": "dialogue",
    "name": "精英馴鹿3",
    "words": "噗喔喔喔喔喔！\\n（我受夠了！　我沒辦法再跟著你們了！）",
    "voice": null,
    "unit_id": 4011
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "馴鹿先生，",
    "voice": "vo_adv_5029005_041",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你怎麼了！？",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "好像很生氣耶……！",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不是怎麼了，",
    "voice": "vo_adv_5029005_042",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "牠們就是打算要造反了。",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我有經驗，所以很清楚……♪",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "克莉絲提娜，",
    "voice": "vo_adv_5029005_043",
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妳真的有過很多很糟糕的經驗啊。",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "可是，",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "該怎麼辦呢……",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "你們幾個，",
    "voice": "vo_adv_5029005_044",
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "冷靜一點！",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "\\n身為菁英馴鹿的你們，",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "為什麼要做這種事？",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "精英馴鹿們",
    "words": "噗喔喔喔喔喔喔喔喔喔喔喔喔！\\n（因為我們要――自己當聖誕老人！）",
    "voice": "vo_adv_5029005_045",
    "unit_id": 4011
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "等一下！聖誕老人！",
    "voice": "vo_adv_5029005_046",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n馴鹿先生牠們看起來怪怪的……！",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "什麼……？",
    "voice": "vo_adv_5029005_047",
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n馴鹿牠們，",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "跑進聖誕老人的禮物袋裡了！？",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這令人背脊發涼的殺氣……",
    "voice": "vo_adv_5029005_048",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "亂數聖域……",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不對，",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我的本能正在警告著我……？　",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "大家可別大意了喔？",
    "voice": "vo_adv_5029005_049",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n但如果想讓聖誕節變成你的忌日的話，就另當別論了。",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "那個袋子裡有一股非常強大的力量……！",
    "voice": "vo_adv_5029005_050",
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "到底發生了什麼事？……！",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "快看！",
    "voice": "vo_adv_5029005_051",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n有什麼東西從袋子裡出來了！？",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "馴鹿頭目",
    "words": "噗、",
    "voice": "vo_adv_5029005_052",
    "unit_id": 12511
  },
  {
    "type": "dialogue",
    "name": "馴鹿頭目",
    "words": "喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔！",
    "voice": null,
    "unit_id": 12511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "喂！",
    "voice": "vo_adv_5029005_053",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這是什麼……",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "惡質的玩笑嗎？",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這，",
    "voice": "vo_adv_5029005_054",
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "還變得真大啊……",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "而且還用兩隻腳站著……",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "馴鹿先生牠們",
    "voice": "vo_adv_5029005_055",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "合體了嗎……！？",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "馴鹿頭目",
    "words": "噗喔喔喔喔！\\n（力量湧現出來了……！）",
    "voice": "vo_adv_5029005_056",
    "unit_id": 12511
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "竟然把聖誕老人的袋子拿來這樣用……！",
    "voice": "vo_adv_5029005_057",
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "\\n",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "馴鹿們！",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "做這種事可不行！",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "\\n馬上",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "把那個袋子還來！",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "聖誕老人，",
    "voice": "vo_adv_5029005_058",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "危險！",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "馴鹿頭目",
    "words": "噗喔喔喔喔！\\n（首先是聖誕老人，我要讓你知道我們的感受）",
    "voice": "vo_adv_5029005_059",
    "unit_id": 12511
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "什、",
    "voice": "vo_adv_5029005_060",
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "什麼……",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "！？",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "馴鹿",
    "words": "……噗喔！？\\n（這、這是怎麼回事！？）",
    "voice": "vo_adv_5029005_061",
    "unit_id": 4111
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "聖誕老人他……",
    "voice": "vo_adv_5029005_062",
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "竟然變成了馴鹿！？",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這跟瞬間把我們的衣服變成聖誕裝是一樣的道裡。",
    "voice": "vo_adv_5029005_063",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n沒什麼好訝異的。",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "比起這個，",
    "voice": "vo_adv_5029005_064",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n先擔心我們自己比較好吧？",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "如果他的目的是造反的話，",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "他的目標自然是……",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "哎呀？",
    "voice": "vo_adv_5029005_065",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n喂喂，",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "牠怎麼轉身就走了？",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "逃跑也太掃興了吧。",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
