[
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "聽說鈴",
    "voice": "vo_adv_6048104_000",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "是個家裡蹲，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n不過很風趣，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "意外的是個很正經的人呢！",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "平常的她",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "是什麼樣子呢？",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "的確",
    "voice": "vo_adv_6048104_001",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "有聽到她說",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "歡迎隨時去牧場玩，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "也就是",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "她隨時都沒在工作所以隨時都能一起玩的意思吧？",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n這樣不會惹牧場的人生氣嗎……",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "這種說法是",
    "voice": "vo_adv_6048104_002",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "她平常都不肯好好工作的意思吧……",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "不，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "還是這是",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "某種從容？",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n鈴認真起來是什麼感覺呢？",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "好在意啊！",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "真、",
    "voice": "vo_adv_6048104_003",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "真好懂啊。",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "不過",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "遇到關乎輸贏的事，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n我也會整個人變得滿認真的，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "說不定",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我們是很像的同伴呢。",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n稍微有一點親切感了呢。",
    "voice": null,
    "unit_id": 113811
  }
]
