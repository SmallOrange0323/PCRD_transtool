  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "隔著料理台互相對峙的靜流與惠理子。\\n兩人之間飄散著緊張的空氣。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "這個時刻……",
    "voice": "vo_adv_5011002_000",
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "終於來臨了呢。",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "妳看起來挺從容的嘛，",
    "voice": "vo_adv_5011002_001",
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "惠理子。",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "那當然了……",
    "voice": "vo_adv_5011002_002",
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "因為……",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我今天就可以",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n擊潰纏在{0}大人身邊的煩人蒼蠅了呀！",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "呵呵～",
    "voice": "vo_adv_5011002_003",
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "看來妳",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n還沒有明白今天會和{0}分別的人",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "就是妳自己呢？",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "哦哦，",
    "voice": "vo_adv_5011002_004",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "在對決開始前雙方就已經展現出驚人的魄力！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "互相瞪視的兩人，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "要擲骰了！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "話說回來，",
    "voice": "vo_adv_5011002_005",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "能投飛犀牛的人",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "不就是超級大力士嘛？",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n真的有那種人嗎？",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "嗯，",
    "voice": "vo_adv_5011002_006",
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "可以投犀牛的人是大力士呢！",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "不過這裡說的骰是指骰子，",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "請別誤會了。",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "啊，",
    "voice": "vo_adv_5011002_007",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "是這樣啊！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "……璃乃當主持人真的可以嗎？",
    "voice": "vo_adv_5011002_008",
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "欸？　",
    "voice": "vo_adv_5011002_009",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "為什麼這麼問？",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "妳",
    "voice": "vo_adv_5011002_010",
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "和靜流是熟人吧？",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n就算兩個人一起上，",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我也沒問題。",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "反正今天會獲勝的人是我呀……",
    "voice": "vo_adv_5011002_011",
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "嘻嘻嘻。",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我",
    "voice": "vo_adv_5011002_012",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "今天是主持人啊。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "所以比賽的立場是中立喔。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "啊，是喔……",
    "voice": "vo_adv_5011002_013",
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "話說回來，妳……",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "似乎",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "稱呼自己",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n為{0}大人的妹妹呢？",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "啊，",
    "voice": "vo_adv_5011002_014",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "是的。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "的確是這樣沒錯啦？",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "不　可　饒　恕　！",
    "voice": "vo_adv_5011002_015",
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "欸欸……",
    "voice": "vo_adv_5011002_016",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "不僅有個自稱姐姐的臭蟲在，",
    "voice": "vo_adv_5011002_017",
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n居然還有個自稱妹妹的渣蟲！",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "為什麼",
    "voice": "vo_adv_5011002_018",
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "{0}大人的周圍",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n總是會聚集些奇怪的女人呢……",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "啊啊，",
    "voice": "vo_adv_5011002_019",
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "可憐的{0}大人……",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n惠理子馬上就會替您剷除壞蟲的。",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n……請您稍等一會喔。",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "妳好像",
    "voice": "vo_adv_5011002_020",
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "很小看我的樣子，但我不會讓妳得逞的！",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我是{0}的姐姐，",
    "voice": "vo_adv_5011002_021",
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n所以讓重要的弟弟開心那是當然的吧？",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "那就是",
    "voice": "vo_adv_5011002_022",
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "身為家人的姐姐身負的使命啊。",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "這是我的戰鬥，",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "所以我會一對一打敗妳的！",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "沒錯沒錯！",
    "voice": "vo_adv_5011002_023",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n我也一樣，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "身為一個妹妹，讓哥哥開心是理所當然的。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "就算是姊妹也同樣是情敵！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "妳、",
    "voice": "vo_adv_5011002_024",
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "妳說家人！？",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "妳們明明沒有血緣關係，",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "真是莫名其妙……",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "妳們利用那位大人的溫柔，",
    "voice": "vo_adv_5011002_025",
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "擅自自稱為那位大人的姐妹，",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "藉此接近他……",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "真是厚臉皮！",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "嗚嗚……",
    "voice": "vo_adv_5011002_026",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n惠理子選手的視線真刺人，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "但是時間已經遲了，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "趕快開始比賽吧！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "規則很簡單！",
    "voice": "vo_adv_5011002_027",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "只要在限制時間內做出巧克力",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n讓哥哥吃就行了。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "讓哥哥覺得好吃的那一方",
    "voice": "vo_adv_5011002_028",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "就是勝利者～！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "啊，忘了說……",
    "voice": "vo_adv_5011002_029",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "等比賽結束後，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "觀眾們",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n也能夠試吃喔〜",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "那麼，",
    "voice": "vo_adv_5011002_030",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "卯足勁上吧！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "開始料理！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "……",
    "voice": "vo_adv_5011002_031",
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "……",
    "voice": "vo_adv_5011002_032",
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "好，",
    "voice": "vo_adv_5011002_033",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "兩人都在料理台上擺放了材料，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n順利地著手進行作業！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "這是否成為名留青史的一戰，",
    "voice": "vo_adv_5011002_034",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "為人熱議的知名勝負之序章呢！？",
    "voice": null,
    "unit_id": 101112
  },
