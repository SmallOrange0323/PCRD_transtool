[
  {
    "type": "background",
    "bg_id": "500020"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}發現了",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "邊哼歌邊小跳步的嬌小軍人背影。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "哼",
    "voice": "vo_adv_1053009_000",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "哼",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "哼──♪",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "嗚哇！？",
    "voice": "vo_adv_1053009_001",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "閣下你在啊！？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "該不會剛才的",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "樣子被你看到了……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n你說看到什麼……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "好、",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "好意思讓我說出口啊！？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "是什麼人！",
    "voice": "vo_adv_1053009_002",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……原來",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "是閣下啊。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "呼──",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "幸好沒有把你丟飛出去。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "你不想受傷的話，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "就不應該隨意觸碰軍人的後背。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "啊哈哈哈！？",
    "voice": "vo_adv_1053009_003",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……你，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這個大笨蛋！！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "在碰哪裡啊！？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n搔軍人癢這種事，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "不是閣下的話我差點就砍下去了！！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "嗯？",
    "voice": "vo_adv_1053009_004",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "你問我為什麼看起來那麼開心……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "嗎？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……別笑我喔？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "今天早上，",
    "voice": "vo_adv_1053009_005",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我自主量了身高……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "結果長高了！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我的長高了！！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……喂！",
    "voice": "vo_adv_1053009_006",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "幹嘛那樣盯著我！？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n是覺得很難以置信嗎！？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "先聲明，",
    "voice": "vo_adv_1053009_007",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我沒有騙人喔！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我確實",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "長了那麼一點點……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "嗯，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "長了跟豆子大小差不多的高度！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……不對，",
    "voice": "vo_adv_1053009_008",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "說豆子太過頭了嗎。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n大概是米粒大小……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "咦！？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "要我再測量一次看看！？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我、",
    "voice": "vo_adv_1053009_009",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我拒絕！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "如果只是我多心，那不是很讓人洩氣嗎！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "小孩１",
    "words": "喂──！",
    "voice": "vo_adv_1053009_010",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩２",
    "words": "莫妮卡隊長──！",
    "voice": "vo_adv_1053009_011",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……唔？",
    "voice": "vo_adv_1053009_012",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "喔，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "是你們啊！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "向閣下介紹一下兩位。",
    "voice": "vo_adv_1053009_013",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n我和他們",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "是在森林裡認識的，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n那之後，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我便以朋友的身分",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "和他們交往甚密。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "小孩２",
    "words": "我跟你說、",
    "voice": "vo_adv_1053009_014",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "小孩２",
    "words": "我跟你說，",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "小孩２",
    "words": "\\n我們在逃離魔物的時候，",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "小孩２",
    "words": "是莫妮卡隊長救了我們的！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "小孩２",
    "words": "\\n",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "小孩２",
    "words": "她用好大一把劍",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "小孩２",
    "words": "一瞬間把魔物給打倒了哦！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "小孩１",
    "words": "莫妮卡隊長",
    "voice": "vo_adv_1053009_015",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩１",
    "words": "她很帥氣吧～！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩１",
    "words": "\\n",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩１",
    "words": "雖然看起來這～麼小！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩２",
    "words": "嗯，",
    "voice": "vo_adv_1053009_016",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "小孩２",
    "words": "她超級強的！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "小孩２",
    "words": "\\n",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "小孩２",
    "words": "雖然看起來這～麼小！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "別說我小啦！！",
    "voice": "vo_adv_1053009_017",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "真是的，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "該說小孩子是天真呢，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "還是老實呢……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "所以",
    "voice": "vo_adv_1053009_018",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "你們今天",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "有什麼事情嗎？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n想要我再指導練劍嗎？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "小孩１",
    "words": "嘿嘿！",
    "voice": "vo_adv_1053009_019",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩１",
    "words": "今天要向莫妮卡隊長",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩１",
    "words": "「報告」",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩１",
    "words": "一件事。",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩１",
    "words": "\\n其實我們，",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩１",
    "words": "長高了喔！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "什麼！？",
    "voice": "vo_adv_1053009_020",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n前陣子不是才報告過一樣的事嗎！？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "小孩１",
    "words": "嗯，",
    "voice": "vo_adv_1053009_021",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩１",
    "words": "前陣子也有長高，",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩１",
    "words": "但這次好像又長了。",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩２",
    "words": "伊緒老師說過",
    "voice": "vo_adv_1053009_022",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "小孩２",
    "words": "「小孩子都",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "小孩２",
    "words": "成長得好快呢──♪」。",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "小孩２",
    "words": "\\n",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "小孩２",
    "words": "更重要的是，",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "小孩２",
    "words": "我們長大了的話，妳會答應讓我們當妳的部下對吧！？",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "不，",
    "voice": "vo_adv_1053009_023",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我說的「長大」的意思",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "不是指身體，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n是指年齡方面才對……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "可是，",
    "voice": "vo_adv_1053009_024",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "真是羨慕到不行啊。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "不管什麼豆子還米粒的，",
