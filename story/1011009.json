  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "某日，璃乃獨自從蘭德索爾來到附近的綠地公園。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "嗯～……",
    "voice": "vo_adv_1011009_000",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "呼～！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n呼～",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "空氣真清新！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n這座公園跟以前都沒變呢。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "最近這陣子",
    "voice": "vo_adv_1011009_001",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "發生了太多事情，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "讓人有點疲累了……",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "會長的圍裙也做好了，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n今天就拋開各種煩心的事情，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "好好放鬆一下吧。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "考試的準備……",
    "voice": "vo_adv_1011009_002",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "嗯！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n就明天開始加油吧！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "話說回來，",
    "voice": "vo_adv_1011009_003",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "今天有很多家庭和小孩來這裡呢。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我也經常",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "像那個樣子和哥哥一起來玩呢。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "哇――！",
    "voice": "vo_adv_1011009_004",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "啊～",
    "voice": "vo_adv_1011009_005",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "等等我嘛～！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "　哥哥～！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "嗯嗯，",
    "voice": "vo_adv_1011009_006",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "就像那個樣子跑來跑去的……",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "探險隊出發～！",
    "voice": "vo_adv_1011009_007",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "　跟著我來～！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "好～！",
    "voice": "vo_adv_1011009_008",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "咦，",
    "voice": "vo_adv_1011009_009",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "奇怪？",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n和那孩子們一起玩的人，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "該不會是……",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "哥哥！？",
    "voice": "vo_adv_1011009_010",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "你跟小孩子玩在一起做些什麼啊……",
    "voice": "vo_adv_1011009_011",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "咦？",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "　是他們的父母",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "拜託你帶小孩子來公園的？",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "哥哥你還是一樣這麼爛好人呢。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我嗎？",
    "voice": "vo_adv_1011009_012",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n我並不是有什麼事才來這裡的……",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我知道了！",
    "voice": "vo_adv_1011009_013",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "　我也來幫忙",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "陪小孩子一起玩吧！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "幫助哥哥",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "也是妹妹的職責啊。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "咦――？",
    "voice": "vo_adv_1011009_014",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "　如果是最小的小弟就可以。",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "可以喔～",
    "voice": "vo_adv_1011009_015",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "唔……",
    "voice": "vo_adv_1011009_016",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "小弟是嗎……",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "不過，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我在公會已經習慣了，沒關係！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "那就出發～！",
    "voice": "vo_adv_1011009_017",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "出發～！",
    "voice": "vo_adv_1011009_018",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "呵呵，",
    "voice": "vo_adv_1011009_019",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "總覺得這種事很令人懷念呢。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "啊，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "不可以！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "　要是跑那麼快的話……",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "呀！",
    "voice": "vo_adv_1011009_020",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "啊！",
    "voice": "vo_adv_1011009_021",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "　果然跌倒了！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n還、",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "還好嗎？",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "嗚……",
    "voice": "vo_adv_1011009_022",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "嗚嗚……",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "嗚哇――！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "　好痛喔――！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "什麼啊――",
    "voice": "vo_adv_1011009_023",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "妳是在做些什麼啊――",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "嗚嗚……",
    "voice": "vo_adv_1011009_024",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "嗚嗚……",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "對不起……",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "等一下喔，",
    "voice": "vo_adv_1011009_025",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我現在替妳處理傷口。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "好～",
    "voice": "vo_adv_1011009_026",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "痛痛、痛痛",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "飛走吧～！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "好了，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "已經沒事囉。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "嗚……",
    "voice": "vo_adv_1011009_027",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "嗚嗚……",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "妳很遲鈍耶，",
    "voice": "vo_adv_1011009_028",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "\\n所以我才說不想和妳一起來啊！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "真是的，",
    "voice": "vo_adv_1011009_029",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "怎麼可以那樣說呢！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "哥哥……！",
    "voice": "vo_adv_1011009_030",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "那什麼嘛……",
    "voice": "vo_adv_1011009_031",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "\\n",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "不、",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "不過我",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "一點也不遜喔。",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "還好嗎？",
    "voice": "vo_adv_1011009_032",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "　",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "來，",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "我來背妳吧。",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "嗯……",
    "voice": "vo_adv_1011009_033",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "謝謝你，",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "哥哥……",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "嘿嘿，",
    "voice": "vo_adv_1011009_034",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "事情告一段落了呢。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "真不愧是哥哥！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "掰掰～！",
    "voice": "vo_adv_1011009_035",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "再見～！",
    "voice": "vo_adv_1011009_036",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "掰掰～！",
    "voice": "vo_adv_1011009_037",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "要小心點喔！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "和他們父母",
    "voice": "vo_adv_1011009_038",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "是約定好要在這碰面啊。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n幸好",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "只是個小輕傷，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "那個也不會留下疤痕。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "那麼，",
    "voice": "vo_adv_1011009_039",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "哥哥接下來打算做什麼？",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我……",
    "voice": "vo_adv_1011009_040",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "要繼續待在這裡一下子。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我姑且也把參考書帶來了，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "想說念個書之後再回家。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "可以嗎？",
    "voice": "vo_adv_1011009_041",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "那、",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "那就",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "一起來念書吧！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "雖是這麼說，",
    "voice": "vo_adv_1011009_042",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "但我也好久沒接觸了，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "先從初級篇開始喔。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我看看，",
    "voice": "vo_adv_1011009_043",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "什麼什麼……？",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n『刻瑞斯森林的植物中，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "其中擁有最強韌之纖維的植物，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n是下列何者？』",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "就這樣！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "答對了！",
    "voice": "vo_adv_1011009_044",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "　",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "哦哦！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "　好厲害喔，哥哥！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n原來如此，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "哥哥是在打工和公會活動中，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "親身體驗學會的吧。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "對了，",
    "voice": "vo_adv_1011009_045",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "下次也請帶我一起去！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我要透過親身體驗來學習！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "唔唔，",
    "voice": "vo_adv_1011009_046",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "答錯了……",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n才初級篇就這樣，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "後面可要擔心了呢……",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "那麼，",
    "voice": "vo_adv_1011009_047",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "來看下一個問題吧！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n這次",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "來答答看中級的問題。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "『希德雷克的鱗片",
    "voice": "vo_adv_1011009_048",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "因可作為飾品",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "與閃光飾片而受到重視，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n　請問曾經目擊過其蹤影的地方",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "為以下何者？』",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "這題，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "感覺就像是超容易出錯的問題耶……",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "答錯了……",
    "voice": "vo_adv_1011009_049",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "嗚嗚，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "這問題太難了啦……",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n想得太深反而被騙了。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n完全開始在疑神惡鬼了啦……",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "……答對了！",
    "voice": "vo_adv_1011009_050",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "好厲害好厲害！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "　",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "你怎麼會知道？",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "真不愧是哥哥！",
    "voice": "vo_adv_1011009_051",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n這就是有本領的章魚會隱藏利爪！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "咦？",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "　……章魚是有爪子的嗎？",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "background",
    "bg_id": "500141"
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "咦咦？",
    "voice": "vo_adv_1011009_052",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "　不知不覺已經傍晚了？",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "感覺時間轉眼間就過了。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n天色也差不多要暗下來了呢～",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "雖然有很多事情要煩惱，",
    "voice": "vo_adv_1011009_053",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "但和哥哥一起度過後，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "感覺輕鬆多了。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "今天非常謝謝你，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "哥哥。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "欸？",
    "voice": "vo_adv_1011009_054",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "哥哥要送我回家嗎？",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "嘿嘿，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "那就能再多和哥哥在一起了呢。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "那～",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我們回去吧，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "回到蘭德索爾！",
    "voice": null,
    "unit_id": 101112
  }
