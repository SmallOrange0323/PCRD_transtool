    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……和各式各樣的人交談",
    "voice": "vo_adv_1140004_049",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "也不錯呢。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n你說得沒錯，",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "很開心。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……這麼說來，",
    "voice": "vo_adv_1140004_050",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我都忙著在應付小孩子，",
