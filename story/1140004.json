  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在熱鬧的氛圍也已然沉寂下來的萬聖節樂園中，\\n怜與{0}遠遠地望著那些正在收攤的攤販。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "真讓人有點捨不得呢，",
    "voice": "vo_adv_1140004_000",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "哪怕有聽說過，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "慶典的結束總是會讓人感到寂寞。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "但是……",
    "voice": "vo_adv_1140004_001",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "嗯，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "玩得很開心。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我有多久沒這麼樂在其中了呢，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這疲勞令人覺得心情暢快。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "夜也開始深了，",
    "voice": "vo_adv_1140004_002",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "慶典也差不多要結束了吧。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這股捨不得的感覺，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "應該暫時不會消失吧。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你看，",
    "voice": "vo_adv_1140004_003",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "月亮也高高掛起了。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n月光是這麼地明亮──",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "怎麼回事？",
    "voice": "vo_adv_1140004_004",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "怎麼覺得月亮特別地亮……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不行，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "好睏……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "still",
    "still_id": "114000401"
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "姐姐，",
    "voice": "vo_adv_1140004_005",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "不給糖就搗蛋！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "呃……",
    "voice": "vo_adv_1140004_006",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這是要給糖果對吧？",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "來，",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "給你。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "哇啊～",
    "voice": "vo_adv_1140004_007",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "謝謝～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "萬聖節快樂！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "啊、",
    "voice": "vo_adv_1140004_008",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "嗯……",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "萬聖節快樂。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n去好好享受萬聖節吧。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……你覺得怎麼樣？",
    "voice": "vo_adv_1140004_009",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n就你來看，",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我的表現還算好嗎？",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你、",
    "voice": "vo_adv_1140004_010",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你這要求",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "還真難呢……",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我可是第一次參加萬聖節啊。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "妳好！",
    "voice": "vo_adv_1140004_011",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "不給糖就搗蛋！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男孩 2",
    "words": "不給糖就搗蛋！",
    "voice": "vo_adv_1140004_012",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "如果不給糖，就要搗蛋囉！",
    "voice": "vo_adv_1140004_013",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男孩 2",
    "words": "要搗蛋囉～！",
    "voice": "vo_adv_1140004_014",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "下、",
    "voice": "vo_adv_1140004_015",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "下一批小孩子已經來了……",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "更投入，",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是嗎。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "好──",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "哦、",
    "voice": "vo_adv_1140004_016",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "哦哦，",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "真是可怕的小鬼怪。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我給你們糖果，",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "請放過我吧。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "嘿嘿，",
    "voice": "vo_adv_1140004_017",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "太好了！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "姐姐也萬聖節快樂！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男孩 2",
    "words": "萬聖節快樂～！",
    "voice": "vo_adv_1140004_018",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "剛、",
    "voice": "vo_adv_1140004_019",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "剛才那樣",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你覺得怎麼樣？",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這樣啊，",
    "voice": "vo_adv_1140004_020",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "太好了……",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "啊，",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n越來越多小孩子往這邊靠過來了！",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n雖然這樣我準備也是值得了，",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "但、",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "但要應付不來了……",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "既然有空在那悠哉地發表感想，",
    "voice": "vo_adv_1140004_021",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那你也來幫忙。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "啊啊，真是的。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "沒想到居然會這麼忙碌……！",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "background",
    "bg_id": "510300"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──數小時前，\\n熙來攘往的萬聖節鬧區。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "真是的，",
    "voice": "vo_adv_1140004_022",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "早知道是這樣就不來了。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "之後的對應也很麻煩……",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "該怎麼辦才好。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不好意思，",
    "voice": "vo_adv_1140004_023",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我的話剛才就說完了。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我和你們已經沒有什麼話好──",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "哇！",
    "voice": "vo_adv_1140004_024",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……怎、",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "怎麼，是你啊。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "抱歉，",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我誤以為是他們追上來了。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……嗯，",
    "voice": "vo_adv_1140004_025",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我到剛才",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "都還在參加同學邀請我的派對。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n平時我的行程對不上，",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "因此我都只能拒絕他們。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你說是什麼派對？",
    "voice": "vo_adv_1140004_026",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n是萬聖節派對……",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "表面上。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我對萬聖節也有興趣，",
    "voice": "vo_adv_1140004_027",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "想說去增加見識也不錯，",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "所以才參加了，但是……",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那個似乎只是他們自認為的萬聖節派對。",
    "voice": "vo_adv_1140004_028",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n徒有無聊的裝飾，",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "沒有任何玩樂和慶典的氛圍，",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "只是將為了擴展自身人脈而算計、交涉的場合，",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "套上那名稱罷了。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "只有表面的客套話，",
    "voice": "vo_adv_1140004_029",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "及以狡詐眼神打量他人的應酬。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "他們希望親近的不是我，",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "而是要與我父親套關係。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這是我",
    "voice": "vo_adv_1140004_030",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "至今已經看到厭煩的場景，",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我一秒也不想多留在那種地方。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……更別說，",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "他們不顧我的意願硬是想打聽我父親的事。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……只是想起來就讓人很不愉快，",
    "voice": "vo_adv_1140004_031",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我受夠什麼萬聖節了。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "享受萬聖節……",
    "voice": "vo_adv_1140004_032",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n那提議是不錯，不過……",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "要做什麼？",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "雖然你看起來異常的有自信，",
    "voice": "vo_adv_1140004_033",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "讓我覺得有點不安……",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不過我知道了，",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "現在就相信你，",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不管有什麼事都交給你吧。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "still",
    "still_id": "114000401"
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……不對，",
    "voice": "vo_adv_1140004_034",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "雖然我是說交給你，",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n但、",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "但沒想到連我都要變裝……",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你、",
    "voice": "vo_adv_1140004_035",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你說得沒錯，",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "萬聖節就是享受變裝的慶典。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n既然要認真享受，",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那按照傳統來才是對的呢。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "而且仔細一看，小孩子自然不用說，",
    "voice": "vo_adv_1140004_036",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "連大人也都有變裝。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "尤其是大人的變裝更是不簡單，",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "做得非常精細。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "怪物、木乃伊男，",
    "voice": "vo_adv_1140004_037",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那邊是朋友們一起扮殭屍。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "嗯？",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那個是在電影中登場的外星人？",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "連那種的也可以呀。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "高品質的變裝，",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "只是看看就很開心了呢。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "參加者１",
    "words": "萬聖節快樂～！",
    "voice": "vo_adv_1140004_038",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "剛、",
    "voice": "vo_adv_1140004_039",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "剛才的人你認識嗎？",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n不認識？",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "原來如此，",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這就像打招呼一樣呢。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "參加者２",
    "words": "萬聖節快樂！",
    "voice": "vo_adv_1140004_040",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "萬、",
    "voice": "vo_adv_1140004_041",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "萬聖節",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "快樂……！",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "呼，",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "雖然有點緊張，",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "但還是勉強說出口了呢。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n萬聖節快樂……",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "嗯，",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "感覺好像變得有趣起來了。",
