  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "結果還沒有和你說過呢。",
