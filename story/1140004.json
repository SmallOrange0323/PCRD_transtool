    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "所有人都發過了吧？",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n他們應該都跑到其他會場中針對兒童舉辦的活動了吧。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你也辛苦了。",
    "voice": "vo_adv_1140004_047",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "真是的，",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
