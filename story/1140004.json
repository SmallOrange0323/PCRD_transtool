  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "要求你和我一起再多享受一下萬聖節。",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "呃……",
    "voice": "vo_adv_1140004_059",
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就是這樣……",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你應該不會拒絕我",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "對吧？",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你、",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你會負起教會我什麼是萬聖節的",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "責任對吧？",
    "voice": null,
    "unit_id": 100331
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好，",
    "voice": "vo_adv_1140004_060",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "辛苦了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "哎呀～",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "肚子都飽了，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "感覺都快被甜死了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "咦？",
    "voice": "vo_adv_1140004_061",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你說我又沒吃糖果為什麼會覺得甜？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我不是那個意思……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "算了，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你就那樣或許比較好，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你就維持那樣吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "話又說回來，",
    "voice": "vo_adv_1140004_062",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "怜真是努力了呢……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n看來和你過萬聖節讓她相當開心呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n沒想到會這麼大膽出擊……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "很好，做得好！",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "怜也是一個女孩子，",
    "voice": "vo_adv_1140004_063",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n別因為她是大小姐就疏遠她對她有偏見，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n帶她到各種地方去也不錯啊。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我相信你就算不用人說出口也沒問題。",
    "voice": "vo_adv_1140004_064",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n那孩子身上背負了很多，你要幫她讓自己放輕鬆喔，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那就再見囉。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "501132"
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我睡著了啊……",
    "voice": "vo_adv_1140004_065",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "他……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "似乎還在睡夢中呢。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "他為我",
    "voice": "vo_adv_1140004_066",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "顧慮了不少事情呢，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "再讓他稍微睡一下吧。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……謝謝。",
    "voice": "vo_adv_1140004_067",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "今年的萬聖節",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n多虧你，讓我有了寶貴的體驗。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你讓我",
    "voice": "vo_adv_1140004_068",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "看見了新的世界呢。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不過，都是因為那樣……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不對，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "應該說多虧如此、",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "吧。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n似乎讓我變得有點貪心了。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我想再發現更多未知的事物，",
    "voice": "vo_adv_1140004_069",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我相信如果是和你一起",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就能做得到。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你、",
    "voice": "vo_adv_1140004_070",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "居然醒著嗎！？",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "到底什麼時候醒的……",
    "voice": "vo_adv_1140004_071",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "真是的，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "剛才那就是我今天最驚訝的事了。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那句話可是要在惡作劇之前",
    "voice": "vo_adv_1140004_072",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "先說出來才對啊。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n真是的……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "呵呵呵，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "真拿你",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "沒辦法。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "雖然我現在只有這種東西，但是……",
    "voice": "vo_adv_1140004_073",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "萬聖節快樂，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "今天很謝謝你。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "兩人一起眺望著明月，\\n並充分地享受了萬聖節的夜晚。",
    "voice": null,
    "unit_id": null
  }
]
