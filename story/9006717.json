    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "[rub:・]我[/rub][rub:・]看[/rub][rub:・]不[/rub][rub:・]見[/rub][rub:・]你[/rub][rub:・]們[/rub][rub:・]能[/rub][rub:・]獲[/rub][rub:・]勝[/rub][rub:・]的[/rub][rub:・]未[/rub][rub:・]來[/rub]。",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "妳也是吧？",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "凱留。",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "唔……",
    "voice": "vo_adv_9006717_035",
    "unit_id": 139111
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "那麼再會了。",
    "voice": "vo_adv_9006717_036",
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n希望你們能像過去那樣，",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "再次超越我的預測──",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n並成功翻轉",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "這個預知。",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……她走了。",
    "voice": "vo_adv_9006717_037",
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "她說「有事要做」",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "是指什麼呢……？",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "雖然很在意，",
    "voice": "vo_adv_9006717_038",
    "unit_id": 128911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "但是……",
    "voice": null,
    "unit_id": 128911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "──現在，",
    "voice": "vo_adv_9006717_039",
    "unit_id": 128811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我們沒有餘力追上她。",
    "voice": null,
    "unit_id": 128811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 128811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我們繼續前進吧。",
    "voice": null,
    "unit_id": 128811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……嗯。",
    "voice": "vo_adv_9006717_040",
    "unit_id": 139111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 139111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是啊……",
    "voice": null,
    "unit_id": 139111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "為了用這雙──",
    "voice": null,
    "unit_id": 139111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 139111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "或許已經得到陛下認可的「眼睛」，",
    "voice": null,
    "unit_id": 139111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "去窺見未來……",
    "voice": null,
    "unit_id": 139111
  }
]
