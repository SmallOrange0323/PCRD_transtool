  {
    "type": "dialogue",
    "name": "米亞",
    "words": "──咕～",
    "voice": "vo_adv_1297004_000",
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "呼嚕～",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "涅妃‧涅羅等人在大江戶觀光的最後一天深夜。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在女生房間裡，是蜷曲起來熟睡的米亞",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n與空蕩蕩的被窩。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "……躡",
    "voice": "vo_adv_1297004_001",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "手、",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "躡腳",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "……",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "background",
    "bg_id": "501892"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "另一方面，男生房間──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "……呵呵。",
    "voice": "vo_adv_1297004_002",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "打擾了。",
    "voice": "vo_adv_1297004_003",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n騎士閣下呀。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "……嗯。",
    "voice": "vo_adv_1297004_004",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n嗯、",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "嗯……",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "……呵呵。",
    "voice": "vo_adv_1297004_005",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "此般熟睡程度，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n看來即便碰觸臉頰亦不至轉醒。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "何等地",
    "voice": "vo_adv_1297004_006",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "毫無防備……",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "惹人憐愛的睡姿啊。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "曝露出此般天真無邪的模樣，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n可會被壞心史萊姆吞噬喔？",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "呵呵呵……",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "……原來如此、",
    "voice": "vo_adv_1297004_007",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "原來如此。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "此溫度……",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "簡直令奴家想起幼時的默涅啊。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "啊啊──",
    "voice": "vo_adv_1297004_008",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "非也。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n此般結實肉體……",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "果真",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "乃男子也。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n善哉、",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "善哉……♪",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "……",
    "voice": "vo_adv_1297004_009",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "甚是危險。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n連奴家都險些失態，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "一時間",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "竟忘了本意。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "好了，騎士閣下呀，",
    "voice": "vo_adv_1297004_010",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "失禮了。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n奴家要進入沉睡的恁",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "心思動盪的夢境之中──",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "…………\\n……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "510082"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──某天夜晚。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "晚安，",
    "voice": "vo_adv_1297004_011",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "騎士閣下呀。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n失禮了。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "──呵呵喝。",
    "voice": "vo_adv_1297004_012",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n問奴家是誰可真是冷淡。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n奴家與恁",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "可是親密無間的呢？",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "──嗯。",
    "voice": "vo_adv_1297004_013",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n此般模樣有如為狐狸所迷惑一般啊。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n竟對此面容",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "與遣辭用句",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "毫無印象……",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "稍待片刻。",
    "voice": "vo_adv_1297004_014",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "奴家對此技巧不甚嫻熟──",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……呵呵。",
    "voice": "vo_adv_1297004_015",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n恁似是回憶起了，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "奴家甚感欣喜。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "此次終歸只是",
    "voice": "vo_adv_1297004_016",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "一夜夢中的親密交談。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "雖說扮演初次相遇作為嬉戲",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "亦頗為愉快，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "然而此事便暫且留待下回吧。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "容奴家重新介紹，",
    "voice": "vo_adv_1297004_017",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "奴家亦名為禰羅。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "今夜在無須顧忌",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "偷窺狂──",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "非也，偷窺蛇的場合，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n奴家會為騎士閣下解答疑問。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "亦即。",
    "voice": "vo_adv_1297004_018",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "奴家將揭示",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "奴家個人──",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "所隱瞞之",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "部分事宜。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "still",
    "still_id": "129700401"
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "好了，",
    "voice": "vo_adv_1297004_019",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "騎士閣下呀。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n為了潤喉，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "奴家先敬恁一杯。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n其中並未摻有酒精，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "還請安心享用。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "……呵呵。",
    "voice": "vo_adv_1297004_020",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n真是爽快的暢飲之姿呢。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "話說──",
    "voice": "vo_adv_1297004_021",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "嗯。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "奴家猜想，騎士閣下",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "似是十分在意奴家之樣貌。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "無甚大事。",
    "voice": "vo_adv_1297004_022",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "此身乃鐵之史萊姆，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "未曾有固定形態。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n千變萬化、",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "自由自在。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "……更何況。",
    "voice": "vo_adv_1297004_023",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n奴家本體",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "之巨大，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "遠勝於此。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "因而此樣貌",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "與至今之樣貌，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "僅是五十步與百步之差。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "…",
    "voice": "vo_adv_1297004_024",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "…正是如此。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n恁的慧眼",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "令奴家深受感動。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "無事，",
    "voice": "vo_adv_1297004_025",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "「非人」一類",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "並非稀奇之物，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n扎根於現世的",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "並非僅有人類。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "然而……",
    "voice": "vo_adv_1297004_026",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "且不論天使或惡魔，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n於奴家這般古老且不解人情之存在，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n要理解恁們纖細至極、不言而喻的細微情感，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "著實困難。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "──「皇家裝備」",
    "voice": "vo_adv_1297004_027",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "會協助這般拙笨的奴家，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n作為與恁們之間溝通橋梁般的道具。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "雖說這已偏離了",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "其原先的用途便是。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "……呵呵。",
    "voice": "vo_adv_1297004_028",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n萬分抱歉，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "奴家太拐彎抹角了。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "簡而言之，",
    "voice": "vo_adv_1297004_029",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "奴家認為皇家裝備",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n乃與人之根源、",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "本能、",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "本性有關的道具。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "因而若接觸此道具，",
    "voice": "vo_adv_1297004_030",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n便是「非人」的奴家，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "亦能理解恁們的內心。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n並得以模仿",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "恁們之行為舉止。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "……然而……",
    "voice": "vo_adv_1297004_031",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n「嫉妒」之心境",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "於奴家而言極其難以理解。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n乃因人類所有之優點，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "奴家能感受到的唯有可愛……",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "雖非同母所生之幼兒，",
    "voice": "vo_adv_1297004_032",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n但既說",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "「血濃於水」，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n奴家與其",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "確為姊妹",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "……不僅如此……",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "奴家模仿人形時之樣貌，",
    "voice": "vo_adv_1297004_033",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n便是基於其血親之枯骨而成。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "……從前、",
    "voice": "vo_adv_1297004_034",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "從前，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "某座南方島嶼上，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "有一安穩小國。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n長時持續著",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "日出而作、",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "日落而息的",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "簡樸生活。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "長久以來，",
    "voice": "vo_adv_1297004_035",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "奴家之碎片",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n深埋於大地，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "幾經流轉，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "傳至該島國的貴族手中。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n因此，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "奴家現在的面貌，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "乃因緣際會下",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "向已故女子借來的。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "時光飛逝。",
    "voice": "vo_adv_1297004_036",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n此事距寢亞誕生",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "近一世紀以前。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n高舉旭日旗的",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "士兵及其同夥，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "來到了該地。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "雖歷盡曲折，",
    "voice": "vo_adv_1297004_037",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "然而他們與島主等人建立情誼。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n於短暫逗留中，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "留下無數有形與無形之物。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n文字、",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "技術、",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "習俗……",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "而語言，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "亦然……",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "……正是。",
    "voice": "vo_adv_1297004_038",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "昔日的奴家",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "尚如同路旁之石，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n僅能透過所見來模效，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n卻全然無有時間深入理解……",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "……呵呵。",
    "voice": "vo_adv_1297004_039",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n可真是",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "說了些無益的往事呢……",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "哎呀，",
    "voice": "vo_adv_1297004_040",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "騎士閣下。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n恁的杯子空了呢。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "這可真是失禮了──",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "那麼，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "奴家再敬恁一杯。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "…………",
    "voice": "vo_adv_1297004_041",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "……請儘管問。",
    "voice": "vo_adv_1297004_042",
    "unit_id": 129731
  },
  {
    "type": "still",
    "still_id": "129700402"
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "──呵呵呵……",
    "voice": "vo_adv_1297004_043",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "此等瑣事，",
    "voice": "vo_adv_1297004_044",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n騎士閣下",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "亦是已知曉了吧……",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "奴家",
    "voice": "vo_adv_1297004_045",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "乃「鐵之史萊姆」。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "──嗯。",
    "voice": "vo_adv_1297004_046",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n儘管宴會正酣……",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n然而看來",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "亦到了……",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "該結束之時了。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "那麼，",
    "voice": "vo_adv_1297004_047",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "騎士閣下呀。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n奴家與恁很快",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "便會在那邊的世界再相見──",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "background",
    "bg_id": "510082"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "…………",
    "voice": "vo_adv_1297004_048",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "…………",
    "voice": "vo_adv_1297004_049",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "唉呀。",
    "voice": "vo_adv_1297004_050",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n請稍待。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n再一次──",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "──這可真是。",
    "voice": "vo_adv_1297004_051",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "夢境收尾的安排，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n貌似出了點差錯呢……",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "真教人",
    "voice": "vo_adv_1297004_052",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "發怵。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "正因如此，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "新穎的機關才令人頭疼。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "……呵呵。",
    "voice": "vo_adv_1297004_053",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "如此一來，奴家與騎士閣下",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n將就此於夢境與現實之交錯中迎來終結。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "……或許",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "亦不失為一不錯之睡前故事……",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "唉呀，然而實在駭人。",
    "voice": "vo_adv_1297004_054",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "若真如此，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "奴家便必定會遭受到",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n仰慕騎士閣下的女子們那遠比岩漿之火更為炙熱的嫉妒。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "既",
    "voice": "vo_adv_1297004_055",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "然如此──",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "─",
    "voice": "vo_adv_1297004_056",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "─吶。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "汝在的吧？",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n汝正於某處竊聽著吧？",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "並非窺伺之人，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "而是窺伺妖精啊。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "便交由汝負責",
    "voice": "vo_adv_1297004_057",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "引導騎士閣下甦醒吧。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n還望汝",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "鄭重、規矩地目送，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "否則──",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "奴家便將汝之居所，",
    "voice": "vo_adv_1297004_058",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "自咱們頭上敲落吧──",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "…………\\n……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "501640"
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "…………",
    "voice": "vo_adv_1297004_059",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "……不。",
    "voice": "vo_adv_1297004_060",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "……不──────",
    "voice": "vo_adv_1297004_061",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "不妙。",
    "voice": "vo_adv_1297004_062",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n這下……",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "真的不妙啊，",
    "voice": "vo_adv_1297004_063",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "那個。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n太不妙了。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "事到如今，",
    "voice": "vo_adv_1297004_064",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "我也還是不知道她的真實身分。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n太不妙了之乎者也……",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "啊。",
    "voice": "vo_adv_1297004_065",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n因為太不妙了，連語言程序都變得奇怪了。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "真是的～",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "……",
    "voice": "vo_adv_1297004_066",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "是啊。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "雖然是那樣，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "但那種東西是存在於現實中",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "的嗎。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n雖然我認為她的個性並不會在重要的事情上說謊……",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "嗯～",
    "voice": "vo_adv_1297004_067",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "……就我而言，",
    "voice": "vo_adv_1297004_068",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n我的主張是有些事如果不知道，那維持現狀就好。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n而且，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "我又是不冒險主義……",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "不過該說總覺得",
    "voice": "vo_adv_1297004_069",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "很在意嗎？",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n那種裝作猜謎出題般的感覺……",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "被那樣一說，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "就想去稍微調查看看啊。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "喜歡謎題的話就會這樣呢，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "對吧？",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "那麼……",
    "voice": "vo_adv_1297004_070",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "此次便先就此別過了。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "……我要順便",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "去找一下",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "我的詞彙量啦──",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "啊。",
    "voice": "vo_adv_1297004_071",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n要是她有問起的話，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "還請你說我有誠懇細心地",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n款待你喔──",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "background",
    "bg_id": "501891"
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "──恁啊，",
    "voice": "vo_adv_1297004_072",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "恁早。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "──呵呵呵。",
    "voice": "vo_adv_1297004_073",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "沒想到。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n恁問「為什麼」，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "可真是冷淡。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "莫非",
    "voice": "vo_adv_1297004_074",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "騎士閣下忘了？",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "忘記恁昨夜",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "與奴家交換的枕邊密語。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "……嗯……",
    "voice": "vo_adv_1297004_075",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "原來如此，",
    "voice": "vo_adv_1297004_076",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "這便是「妨礙認知」之結果呀。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "雖稍感寂寥……",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "但給予騎士閣下力量之人",
    "voice": "vo_adv_1297004_077",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "與「妨礙認知」並無直接關聯。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n看來",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "似乎也並無惡意……",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "此次單單知曉此事，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "便足矣了吧──",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "不成不成。",
    "voice": "vo_adv_1297004_078",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n恁",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "可沒道理低頭。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n因奴家",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "似是亦稍有些得意忘形了──",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "咦～！",
    "voice": "vo_adv_1297004_079",
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n我才想說皇女殿下不在，",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "結果您為什麼會在這邊！",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "……真傷腦筋。",
    "voice": "vo_adv_1297004_080",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n一大早",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "便如此吵鬧啊。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "區區小事。",
    "voice": "vo_adv_1297004_081",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n僅僅是",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "早起之鳥兒有蟲吃罷了。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "咦～？",
    "voice": "vo_adv_1297004_082",
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n有蟲吃是什麼？",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "就只有您自己有，",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "好狡猾喔～",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "呵呵。",
    "voice": "vo_adv_1297004_083",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n若能獨占",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "騎士閣下惹人憐愛的睡顏……",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n早起豈止有蟲吃，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "簡直如",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "美饌佳餚。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "真是的～",
    "voice": "vo_adv_1297004_084",
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "您就是喜歡小孩子～",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "……不，",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "感覺騎士閣下先生",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "也不是那樣啊……？",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "……呵呵呵。",
    "voice": "vo_adv_1297004_085",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "儘管奴家難以理解嫉妒之情，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n然若有人能獨占恁──",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "那或許",
    "voice": "vo_adv_1297004_086",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "便足以令奴家感到嫉妒呢……♪",
    "voice": null,
    "unit_id": 129711
  }
]
