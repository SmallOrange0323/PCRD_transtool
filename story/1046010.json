[
  {
    "type": "background",
    "bg_id": "500012"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──新的壞蛋出現了。珠希獲得情報，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n得知哄抬價格的商人將在街上談生意，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n於是她帶著{0}，出發前去進行調查。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我還想說會是在哪家店，",
    "voice": "vo_adv_1046010_000",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "沒想到他們會在這樣的大街上談生意喵……",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "算了，",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "反正不用潛入輕鬆多了喵♪",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "……不過話又說回來，",
    "voice": "vo_adv_1046010_001",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n查出哄抬價格的商人的身分，意外地簡單呢喵～",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "真沒想到",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "光是四處問人這種程度的調查，就可以掌握到情報了喵。",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "……難不成是陷阱喵？",
    "voice": "vo_adv_1046010_002",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "看來似乎注意一下會比較好喵……",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "啊～",
    "voice": "vo_adv_1046010_003",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "真是的！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n這裡的巷子很窄，",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "給我安靜一點喵～～！！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這種大街上",
    "voice": "vo_adv_1046010_004",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "能躲的地方很有限喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n我也有想過躲在長椅下面之類的地方，",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "但還是非這裡莫屬喵！！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "總之，",
    "voice": "vo_adv_1046010_005",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這次就先……",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "不、",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "不用在意我喵，",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n避免被發現，你再過來一點喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "……不對，",
    "voice": "vo_adv_1046010_006",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "你、",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "你你、",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "你臉在往哪裡塞喵！！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "那、",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "那裡太超過了喵……！！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "對欸～",
    "voice": "vo_adv_1046010_007",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "確實那副面具",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "從以前就有點太小了喵～",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n所以我才會買新的嘛……",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "唉，",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "雖然讓你用舊的不太好意思，",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n但幻影貓的面具就只有那副了，",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "忍耐一下喵。",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "……咦，",
    "voice": "vo_adv_1046010_008",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "舊的喵？",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n仔細想想，",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "曾經戴在我臉上的東西，",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n現在戴在{0}的臉上呢……",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "總、",
    "voice": "vo_adv_1046010_009",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "總感覺突然害羞起來了喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "{0}！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n快把那個面具還給我喵～～！！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "喔喔，",
    "voice": "vo_adv_1046010_010",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "真準時呢。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "得在這種地方討論，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "真是萬分抱歉。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "\\n原本，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "是想找間店一邊用餐的……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "呵呵呵，",
    "voice": "vo_adv_1046010_011",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "你辛苦了，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "\\n我們也明白最近不太寬裕，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "不需要在意的。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "那麼，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "讓我們開始談吧。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "……啊，",
    "voice": "vo_adv_1046010_012",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "商人們來了喵！！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "哎喲～",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "真是的！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "{0}你保持那樣就好了，",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "安靜一點喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "這是",
    "voice": "vo_adv_1046010_013",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "這次交易的合約書。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "\\n沒有問題的話請簽名吧。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "光是這些",
    "voice": "vo_adv_1046010_014",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "就要這個價格啊……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "這樣又",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "不漲成兩倍來賣的話，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "做不下去啊……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "這次也是因為，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "惡心疵聯合商會的傢伙們嗎？",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "是的……",
    "voice": "vo_adv_1046010_015",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "執掌了所有貨物的流通，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "\\n不但制定不合理的價格，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "更限制了物流量……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "\\n都是因為他們，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "根本沒辦法好好做生意。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "……惡心疵聯合商會？",
    "voice": "vo_adv_1046010_016",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "還以為這些傢伙就是幕後黑手，",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n難道，",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "那個什麼惡心疵聯合商會的才是真的黑幕嗎？　",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "惡心疵……",
    "voice": "vo_adv_1046010_017",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "真像惡德伊的名字呢。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "難道說，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "是惡德伊化名，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "\\n做出這種事的嗎？",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "不對，",
    "voice": "vo_adv_1046010_018",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "惡德伊的勢力直到現在，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "\\n還因為幻影貓的緣故很衰退呢。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "\\n雖然可能有些掛勾，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "但應該是別的組織吧。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "幻影貓……",
    "voice": "vo_adv_1046010_019",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "\\n把惡德伊給驅逐，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "奪回經商自由的英雄嗎。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "哦，",
    "voice": "vo_adv_1046010_020",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "他們在稱讚幻影貓喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "再多稱讚一點喵～♪　",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "——這可真是，",
    "voice": "vo_adv_1046010_021",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "商人１",
