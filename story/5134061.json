    "words": "雖、",
    "voice": "vo_adv_5134061_001",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "雖然自己說這些讓人開始害羞起來，",
    "voice": null,
