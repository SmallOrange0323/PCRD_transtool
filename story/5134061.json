    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "這個夢應該沒辦法跟小栞說吧。",
