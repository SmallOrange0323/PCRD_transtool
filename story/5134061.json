    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我卻被那帥氣的聲音吸引，",
    "voice": null,
    "unit_id": 128411
  },
