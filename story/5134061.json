    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "為了做個美好的初夢，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "馬上來睡覺吧～☆",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "呼嚕……",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "still",
    "still_id": "513406101"
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "……奇怪？",
    "voice": "vo_adv_5134061_005",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n我",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "為什麼會在這種地方？",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "咦！？",
    "voice": "vo_adv_5134061_006",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "那個，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "呃，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n新年快樂……",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "話說你平常是這樣講話的嗎？",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "跟平常一樣！？",
    "voice": "vo_adv_5134061_007",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "是哪個平常！？",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "有跟你做過那種事嗎！？",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "still",
    "still_id": "513406102"
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "如果我們",
    "voice": "vo_adv_5134061_008",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "有那樣做過，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n那我絕對會記得吧～！？",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "等等，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "太近！",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "太近了！",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "雖然我不討厭，",
    "voice": "vo_adv_5134061_009",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n但是突然被這麼做的話……！",
    "voice": null,
