  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "卻又好像很遺憾……",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "夢境太過刺激，",
    "voice": "vo_adv_5134061_022",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "害我的心臟還在蹦蹦跳……",
    "voice": null,
    "unit_id": 128411
  },
