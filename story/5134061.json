  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "唉……",
    "voice": "vo_adv_5134061_021",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "不管怎麼想，他都不會說那種話嘛。",
