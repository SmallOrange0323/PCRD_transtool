[
  {
    "type": "background",
    "bg_id": "501890"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "年初診所擠滿參加地新會的人，十分熱鬧。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "患者1",
    "words": "我有長期在吃的藥。",
    "voice": "vo_adv_1247002_000",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "患者1",
    "words": "\\n但感覺效果不怎麼樣……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "患者1",
    "words": "我不太想再繼續吃了。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "患者1",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "患者1",
    "words": "醫生，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "患者1",
    "words": "有適合的中藥能代替嗎？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "當然有囉。",
    "voice": "vo_adv_1247002_001",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "深月出品的中藥令人放心又安全。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "可以照顧你一輩子喔。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "患者2",
    "words": "這是舊傷。",
    "voice": "vo_adv_1247002_002",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "患者2",
    "words": "\\n沒辦法給正經醫生看……",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "患者2",
    "words": "\\n",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "患者2",
    "words": "醫生，",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "患者2",
    "words": "妳口風緊，技術又高超吧？",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "患者2",
    "words": "能幫我看看嗎？",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "當然可以。",
    "voice": "vo_adv_1247002_003",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n舊傷新傷未來的傷，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "全部都來給我看吧。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "高價安心的",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "祕密治療定額契約，我也受理喔～！",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "患者們",
    "words": "唔喔喔喔喔喔！",
    "voice": "vo_adv_1247002_004",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "「技術高超、口風緊」引起了話題，患者不斷增加。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n深月與{0}忙到連喘口氣的時間都沒有──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "501892"
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "呼，",
    "voice": "vo_adv_1247002_005",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "終於把第一天的患者都看完了呢。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "你也辛苦了。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "之後就剩晚上的急診患者而已，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我們趁現在休息一下吧。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "background",
    "bg_id": "500653"
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我記得是在這附近……",
    "voice": "vo_adv_1247002_006",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "找到了，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "足浴！",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "在這裡",
    "voice": "vo_adv_1247002_007",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "就能跟你一起泡了。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "來，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "脫掉吧脫掉吧……♪",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "呼……",
    "voice": "vo_adv_1247002_008",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n真溫暖……",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "還以為外面的公共浴池會很冰，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "竟然還滿燙的呢……",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "是啊……",
    "voice": "vo_adv_1247002_009",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "但即使如此，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "若要開發新藥，這些還是完全不夠……",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……咦？",
    "voice": "vo_adv_1247002_010",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "「明明都這麼已經不擇手段賺錢了」",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這樣？",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "嗯，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "你會這麼想也不奇怪……",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "…………\\n開發新藥，",
    "voice": "vo_adv_1247002_011",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "大多都會失敗。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不斷地反覆試驗，",
    "voice": "vo_adv_1247002_012",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n就像在失敗的沙漠中，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "尋找那唯一一粒的成功……",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n即使是我也是如此。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "所以",
    "voice": "vo_adv_1247002_013",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "錢",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "無論再多，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "都還是完全不夠。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n就像是朝熊熊燃燒的火焰車，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不斷投進香油錢一樣……",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……啊。",
    "voice": "vo_adv_1247002_014",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "討厭，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我怎麼說這種事……",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "可不是喪氣話喔？",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……不過，",
    "voice": "vo_adv_1247002_015",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "要對惠理子她們保密哦，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "知道嗎……？",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "──咦？",
    "voice": "vo_adv_1247002_016",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "「不再多收點費用嗎？」",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這樣？",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這麼單純的問題，真有你的風格。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "是啊……",
    "voice": "vo_adv_1247002_017",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n反正都不合法，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n把價格再哄抬得更高也行……",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……不過啊。",
    "voice": "vo_adv_1247002_018",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n可惜的是，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "密醫也是在做生意啊。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n得讓地下社會的人成為常客，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "才經營得下去。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "所以，",
    "voice": "vo_adv_1247002_019",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "雖然這麼說很奇怪……",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n即使索求高額治療費，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "把握「分寸」也是很重要的。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "沒錯。",
    "voice": "vo_adv_1247002_020",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n……而且。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我也是生活於黑社會的人啊。",
    "voice": "vo_adv_1247002_021",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n和患者是一丘之貉。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n沒辦法做出那麼殘忍的事情啦。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……是密醫。",
    "voice": "vo_adv_1247002_022",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……你、",
    "voice": "vo_adv_1247002_023",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "你啊……",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "討、",
    "voice": "vo_adv_1247002_024",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "討厭……！",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n我先說清楚，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我會臉紅是因為溫泉很燙。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n這裡的溫泉，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "是不是太燙了啊……",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我說，領班～！？",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "──啊，",
    "voice": "vo_adv_1247002_025",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "足浴根本就沒有領班嘛！",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "………………",
    "voice": "vo_adv_1247002_026",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "真是的，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不要捉弄大人。",
    "voice": null,
    "unit_id": 124711
