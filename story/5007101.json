    "name": "宮子",
    "words": "萬聖節，",
    "voice": "vo_adv_5007101_000",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "萬聖～節♪",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "人家要去要很多～布丁來的～♪",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "宮子，",
    "voice": "vo_adv_5007101_001",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "現在有空嗎？",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "啊，",
    "voice": "vo_adv_5007101_002",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "是忍啊～！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "妳來得正好！　",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "不給人家布丁的話就搗蛋來的～！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "呵呵，",
    "voice": "vo_adv_5007101_003",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我就知道妳會說這個。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "給妳吧，",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這是布丁。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "太棒了～",
    "voice": "vo_adv_5007101_004",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "是布丁來的～！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "然後啊宮子，",
    "voice": "vo_adv_5007101_005",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n其實我現在正要去調查一件事……",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "調查～？　",
    "voice": "vo_adv_5007101_006",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "忍好認真工作喔。",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "路上小心來的～",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不是的，",
    "voice": "vo_adv_5007101_007",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n我希望宮子可以陪我一同去調查……",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "咦～",
    "voice": "vo_adv_5007101_008",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "好麻煩喔～",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子現在要到街上慶祝萬聖節來的～",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這樣啊，",
    "voice": "vo_adv_5007101_009",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那真是可惜呢……",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "想說如果妳願意幫忙的話，",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n就有個非～常好玩的萬聖節派對",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n可以邀請妳來參加呢。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "萬聖節派對！？",
    "voice": "vo_adv_5007101_010",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "這種事要早點講嘛～♪　",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "真拿妳沒辦法，我就來幫妳吧～♪",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "謝謝妳。",
    "voice": "vo_adv_5007101_011",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那我們就出發吧。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "根據我的占卜，",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "今晚可能",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n會發生很不可思議的事……",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍・宮子",
    "words": "下回，",
    "voice": "vo_adv_5007101_012",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "忍・宮子",
    "words": "「不給布丁就搗蛋！　",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "忍・宮子",
    "words": "約定的萬聖節派對」",
    "voice": null,
    "unit_id": null
  }
]
