    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "啊哈哈哈……",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "唉。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "沒事，",
    "voice": "vo_adv_5027002_089",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "雖然我很想這麼回答……",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "唔～",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "可能是",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "因為茉莉被嘉夜搶走了",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "所以我有點忌妒吧。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "總之，現在",
    "voice": "vo_adv_5027002_090",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "只能先蒐集情報了。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n我不能把茉莉和這個人拖下水……",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我",
    "voice": "vo_adv_5027002_091",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "沒辦法做到像純那樣，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "雖然心裡很清楚，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "但還是有點焦急呢。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……",
    "voice": "vo_adv_5027002_092",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "開玩笑的。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "啊哈哈，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "忘了我剛剛說的話吧。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "只是說個笑而已。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我也得回到工作崗位上了。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "究竟，【龍族巢穴】的目的是什麼呢……",
