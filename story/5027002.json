  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "眾人登陸艾爾皮斯島後，在島的南方密林地帶",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n紮好了營地。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "呼……",
    "voice": "vo_adv_5027002_000",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "這一路也是相當驚險呢。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n這裡的魔物數量還有強度，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "阿斯特賴亞大陸的根本比不上。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "不過，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "也差不多該開始偵查了。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "目前已確認的龍人族",
    "voice": "vo_adv_5027002_001",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "有兩位。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "最後一位，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "應該",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "是在船載來的那輛馬車裡吧？",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "background",
    "bg_id": "500320"
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "好了～",
    "voice": "vo_adv_5027002_002",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "各位聽我說～！",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我們總算平安登陸了。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "大家辛苦了～♪",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n今天就好好休息一下吧～",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "唔……",
    "voice": "vo_adv_5027002_003",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "今天也被任意使喚了一天……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n為什麼我這麼悲慘，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "得來這個到處都是魔物的島啊？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "嘉夜夜妳也說說老大嘛！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "雖然妳這麼說，",
    "voice": "vo_adv_5027002_004",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不過這次好像沒什麼厲害的傢伙呢。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "真希望來個能讓我大展身手的。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "啊嗚嗚嗚～……",
    "voice": "vo_adv_5027002_005",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "都忘了嘉夜夜",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "是個笨蛋打架狂……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "關於這件事應該沒問題唷～♪",
    "voice": "vo_adv_5027002_006",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "妳們兩位",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "沒有注意到嗎？",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "注意到……",
    "voice": "vo_adv_5027002_007",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "什麼？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "妳、",
    "voice": "vo_adv_5027002_008",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "妳那個笑容是怎麼回事！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "只、",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "只讓我有種不好的預感耶？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "呵呵呵……",
    "voice": "vo_adv_5027002_009",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "岩石上有不尋常的刻痕，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "樹木也有被燒過的痕跡。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "\\n還有就是",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "地面上這個有些風化的",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "巨大足跡。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "\\n我想以間接證據來說",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "算是及格了～♪",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "那麼，",
    "voice": "vo_adv_5027002_010",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這附近真的有囉？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "應該說，",
    "voice": "vo_adv_5027002_011",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "有這個可能性吧～♪",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "喔……？",
    "voice": "vo_adv_5027002_012",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "還真令人期待呢。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "background",
    "bg_id": "500833"
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "果然，",
    "voice": "vo_adv_5027002_013",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "她們是為了找些什麼才來這裡的……？",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "不過，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "到底是在找什麼呢……？　",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "background",
    "bg_id": "500320"
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "一點都不期待啦！",
    "voice": "vo_adv_5027002_014",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n妳們兩個為什麼笑得像反派角色一樣啊！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "好啦好啦，",
    "voice": "vo_adv_5027002_015",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "都特地來這裡了，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "就好好享受吧～",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "嘿嘿，",
    "voice": "vo_adv_5027002_016",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "手開始癢了。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "對吧？祈梨！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "妳是笨蛋嗎，笨嘉夜夜！",
    "voice": "vo_adv_5027002_017",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n那是在未來會骨折的聲音才對吧！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "唔唔唔～",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我不想繼續待在這種公會了啦～！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "別這麼說嘛！",
    "voice": "vo_adv_5027002_018",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "我們一起加油吧～？",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "\\n為了要導正",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "這個錯誤的世界……",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "好嗎？",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "background",
    "bg_id": "500833"
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "錯誤的",
    "voice": "vo_adv_5027002_019",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "世界……？　",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "這話是什麼意思……？　",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "background",
    "bg_id": "500833"
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "傷腦筋……",
    "voice": "vo_adv_5027002_020",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "會說出『錯誤的世界』這種話的人，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n大多數都是",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "想推翻政權的",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "危險人物。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "搞不好",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "這個公會",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "比我們想像中的還要危險……",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "得想辦法",
    "voice": "vo_adv_5027002_021",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "調查她們的目的，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "如果有危險就得阻止她們才行。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "現在，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "可能要先把我、茉莉跟那個人以外的人",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "都當成敵人比較好。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "也不能讓茉莉太過勉強，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "只好靠我自己來想點辦法了……",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "小祈梨，",
    "voice": "vo_adv_5027002_022",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "這個拜託妳啦。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "唉～",
    "voice": "vo_adv_5027002_023",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "真拿你沒辦法。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "好，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "快讓開點。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "吸～……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "這聲音是……？",
    "voice": "vo_adv_5027002_024",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "喔！",
    "voice": "vo_adv_5027002_025",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "謝啦。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "火堆應該這樣就行了吧。",
