  },
  {
    "type": "dialogue",
    "name": "流氓2",
    "words": "是妳火力沒有調整好吧？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流氓2",
    "words": "\\n差點就要釀成火災了。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "怎麼了、怎麼了？　",
    "voice": "vo_adv_5027002_034",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "小祈梨，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "妳又搞砸了嗎？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那、",
    "voice": "vo_adv_5027002_035",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那不是我的錯喔！？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n如果你們要怪我的話，就自己來啊！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "沒有啦，",
    "voice": "vo_adv_5027002_036",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "抱歉抱歉。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "人多少會有失敗嘛！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "\\n妳別鬧彆扭啦。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流氓2",
    "words": "就是說啊！",
    "voice": "vo_adv_5027002_037",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流氓2",
    "words": "我們不會告訴老大的啦。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那、",
    "voice": "vo_adv_5027002_038",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那就算了！　",
