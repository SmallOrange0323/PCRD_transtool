  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我說你呀，",
    "voice": "vo_adv_4010186_000",
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不用那麼勉強哦？",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n雖然說今天是我的生日。",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你的心意我很高興，",
    "voice": "vo_adv_4010186_001",
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "但是沒必要",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "為了選禮物",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "而連續跑了這麼多家店吧……",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n簡單一點的也沒關係哦？",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……真是的，",
    "voice": "vo_adv_4010186_002",
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這種時候你會變得很頑固呢。",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我知道了，",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我也會認真考慮的。",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "要是顧慮太多而選了便宜的東西，",
    "voice": "vo_adv_4010186_003",
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "他大概也不會接受吧。",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "既然如此，",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我也",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "試著跟這孩子撒嬌一下吧。",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我想想……",
    "voice": "vo_adv_4010186_004",
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "衣服之類的？",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不，",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "以福袋那時候的情況來看，",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n你的衣服品味",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "稍微有點脫線。",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那麼",
    "voice": "vo_adv_4010186_005",
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "飾品",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "類的……？",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "嗯──",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "可是我",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "對那種東西有點……",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "啊！？",
    "voice": "vo_adv_4010186_006",
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n你、",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你……",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "認真的！？",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不，",
    "voice": "vo_adv_4010186_007",
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我想你沒有",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "別的意思……",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n害我",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "剛剛慌了一下。",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你這男人，",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "真是對心臟很不好呢。",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……戒指，",
    "voice": "vo_adv_4010186_008",
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "是嗎。",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你、",
    "voice": "vo_adv_4010186_009",
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你那是",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "什麼表情！",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "戒、",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "戒指",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "還",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不行買啦！",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "好了，",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "下一間下一間！",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不會再客氣了！",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n要來把你的錢包",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "花光光，",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "做好覺悟吧！",
    "voice": null,
    "unit_id": 105631
  }
]
