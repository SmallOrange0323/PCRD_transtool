  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "熱氣奔騰的被虐狂夏日慶典終於來到了最後高潮。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n一路贏到這裡的空花，正準備挑戰決賽。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "以強烈自尊彼此碰撞，",
    "voice": "vo_adv_1270003_000",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "\\n勝出至此的各位被虐狂！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "歡迎來到被虐狂夏日慶典的最後舞台！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "虐待狂先生～♪",
    "voice": "vo_adv_1270003_001",
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n你有看到嗎～？",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "啊！",
    "voice": "vo_adv_1270003_002",
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n虐待狂先生",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "在對空花打暗號……！",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n那是……",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "要空花坐下嗎？",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "怎、",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "怎麼這樣，",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "好害羞……！",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "參加者１",
    "words": "最後舞台嗎……",
    "voice": "vo_adv_1270003_003",
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "參加者１",
    "words": "\\n",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "參加者１",
    "words": "我為什麼勝出了呢……",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "參加者２",
    "words": "我接下來",
    "voice": "vo_adv_1270003_004",
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "參加者２",
    "words": "會遭受什麼樣的摧殘……？",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "男被虐狂",
    "words": "咕，",
    "voice": "vo_adv_1270003_005",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "男被虐狂",
    "words": "雖然我一度",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "男被虐狂",
    "words": "因為那個叫空花的被虐狂",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "男被虐狂",
    "words": "而失去信心，",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "男被虐狂",
    "words": "\\n但被虐狂夏日慶典冠軍寶座，我是不會讓出的……！",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "女被虐狂",
    "words": "嗯，",
    "voice": "vo_adv_1270003_006",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女被虐狂",
    "words": "是啊……！",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女被虐狂",
    "words": "\\n我可是為了參加這場慶典，",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女被虐狂",
    "words": "\\n而走出了精靈之森……！",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "各位真不愧是眾多被虐狂當中",
    "voice": "vo_adv_1270003_007",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "出類拔萃的被虐狂！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "\\n大家對於最後舞台的鬥志",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "也非比尋常！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "那麼接下來",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "我要開始進行最後舞台的說明了！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "最終決戰",
    "voice": "vo_adv_1270003_008",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "是以這片大海為舞台的競賽！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "\\n海的對面可以看見終點，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "最先抵達的人，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "\\n將成為這場被虐狂夏日慶典的",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "稱霸者！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "咦？",
    "voice": "vo_adv_1270003_009",
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n是要比",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "游泳的速度嗎？",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "哎呀，",
    "voice": "vo_adv_1270003_010",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "無須擔心。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "畢竟這個活動是",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "被虐狂夏日慶典！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "游泳速度快不快並不重要！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "對於不會游泳的人，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "我們將出借泳圈！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "參加者１",
    "words": "可以用泳圈",
    "voice": "vo_adv_1270003_011",
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "參加者１",
    "words": "也沒關係",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "參加者１",
    "words": "嗎……？",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "參加者１",
    "words": "\\n",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "參加者１",
    "words": "話說回來，",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "參加者１",
    "words": "游泳並不重要的意思是……",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "參加者２",
    "words": "該不會……",
    "voice": "vo_adv_1270003_012",
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "沒錯！",
    "voice": "vo_adv_1270003_013",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "\\n等待著各位的",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "當然會是",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "被虐狂夏日慶典最艱難困苦的關卡！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "這附近的海域目前",
    "voice": "vo_adv_1270003_014",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "經由主辦單位之手！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "──聚集了大量的魔物！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "參加者們",
    "words": "你們是笨蛋嗎！？",
    "voice": "vo_adv_1270003_015",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "敬請放心！",
    "voice": "vo_adv_1270003_016",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "\\n再次強調",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "被虐狂夏日慶典",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "\\n是安心又安全、",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "為被虐狂所舉辦的慶典！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "雖說是魔物，",
    "voice": "vo_adv_1270003_017",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "但並非是兇惡的類型，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "\\n牠們不會危害人類，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "僅僅是",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "有點刺激性的魔物！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "參加者２",
    "words": "真想立刻去暴打那個主持人……！",
    "voice": "vo_adv_1270003_018",
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "嘻嘻嘻……",
    "voice": "vo_adv_1270003_019",
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n有刺激性的魔物，",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "到底",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "會是什麼樣的刺激呢～？",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n真令人期待～♪",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "為了能夠慢慢享受，",
    "voice": "vo_adv_1270003_020",
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n空花",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "要用泳圈來游泳～♪",
    "voice": null,
    "unit_id": 127011
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "那麼，",
    "voice": "vo_adv_1270003_021",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "\\n被虐狂夏日慶典最後舞台！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "請負責解說的虐待狂先生",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "跟我一起喊！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "參加者１",
    "words": "可惡，",
    "voice": "vo_adv_1270003_022",
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "參加者１",
    "words": "只能上了！",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "參加者１",
    "words": "\\n唔喔喔……",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "參加者１",
    "words": "喔！？",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "參加者１",
    "words": "\\n什、",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "參加者１",
    "words": "什麼東西！？",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "參加者２",
    "words": "有東西，",
    "voice": "vo_adv_1270003_023",
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "參加者２",
    "words": "纏到我身上……！？",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "參加者２",
    "words": "\\n",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "參加者２",
    "words": "這是",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "參加者２",
    "words": "章魚的腳……！？",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "那是",
    "voice": "vo_adv_1270003_024",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "附近經營章魚燒店的老闆",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "\\n借給我們的",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "巨大章魚──章魚仔先生！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "兩人",
    "words": "啊啊～～",
    "voice": "vo_adv_1270003_025",
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "兩人",
    "words": "～～～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男被虐狂",
    "words": "真是太亂來了……！",
    "voice": "vo_adv_1270003_026",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "男被虐狂",
    "words": "\\n",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "男被虐狂",
    "words": "但是，",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "男被虐狂",
    "words": "因為區區觸手就停下腳步，太愧對被虐狂之名了！",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "男被虐狂",
    "words": "\\n我可不會因為這種程度──",
    "voice": null,
    "unit_id": 6311
