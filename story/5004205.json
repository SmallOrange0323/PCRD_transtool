  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "總算找到你了，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
