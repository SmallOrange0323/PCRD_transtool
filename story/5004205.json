  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不知道為什麼，",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "似乎跟剛才的感覺不太一樣呢。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n說不定這隻的個性比較兇暴。",
    "voice": null,
    "unit_id": 107611
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "也就是說，",
