    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "雖然同時對付反逆獸跟魔物很累人……",
    "voice": "vo_adv_9076155_007",
    "unit_id": 105311
  },
