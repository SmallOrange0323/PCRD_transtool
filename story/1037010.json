[
  {
    "type": "background",
    "bg_id": "500140"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "蘭德索爾郊外。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}受到智的邀請，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n和她一起進行劍術修練。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500140"
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "──呼！",
    "voice": "vo_adv_1037010_000",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "好可惜，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "剛剛的突擊太淺了呢。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "不過，",
    "voice": "vo_adv_1037010_001",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "劍法不錯喔。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "你來作為對手的話，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "感覺會是個不錯的修練。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "這是……",
    "voice": "vo_adv_1037010_002",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "你看，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "就像我常說的，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n因為我是御久間流繼承人。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "既然被爺爺如此激勵了，",
    "voice": "vo_adv_1037010_003",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n往後",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "就得比平時更加",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "提起幹勁鑽研劍術。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "特別是御久間流的奧義……",
    "voice": "vo_adv_1037010_004",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "如果無法習得，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n在找夫婿之前，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "首先無法自稱為流派繼承人呢。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "呵呵，",
    "voice": "vo_adv_1037010_005",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "果然很好奇吧？",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "御久間流的奧義",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "──又稱為",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "「開光的架勢」。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "在一瞬間由守轉攻……",
    "voice": "vo_adv_1037010_006",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n如閃光一般發動攻擊，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "也就是",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "進行所謂「防守反擊」的劍技喔。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "劍的速度、",
    "voice": "vo_adv_1037010_007",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "動作身手、",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "判斷情況的眼力……",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "凡是劍士所需要的資質，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "全都會備受考驗。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "習得的難度並不一般。",
    "voice": "vo_adv_1037010_008",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……正因如此，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "才會希望你認真出擊。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "可別手下留情喔。",
    "voice": "vo_adv_1037010_009",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n想著你要",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "連同這把劍將我擊倒，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "試著使出全力。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "嗯，",
    "voice": "vo_adv_1037010_010",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "就是這股氣勢。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "那麼，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "隨意攻過來吧！",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "background",
    "bg_id": "500140"
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……等等。",
    "voice": "vo_adv_1037010_011",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n我不是說了要你認真出擊嗎？",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "比剛才更沒有氣勢了耶？",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我可是使出全力了喔。",
    "voice": "vo_adv_1037010_012",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "你如果特別放水的話，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n可是會受傷的喔？",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "──嗯",
    "voice": "vo_adv_1037010_013",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "也不怪你。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "你啊，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "實在太溫柔了，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n偶爾會讓我感到抱歉呢。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "暫時就先",
    "voice": "vo_adv_1037010_014",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "習慣和我一起修練吧。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "像這樣緊張得全身僵硬的話，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我也很難出擊。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我有個提議……",
    "voice": "vo_adv_1037010_015",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n要不要跟我玩個遊戲？",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "不需要認真出擊。",
    "voice": "vo_adv_1037010_016",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n任何形式都可以，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "只要擊中對方一劍就獲勝。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "只是輸的那一方",
    "voice": "vo_adv_1037010_017",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "要聽對方的",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "任何要求。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n……算是個打賭比賽吧。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "不過，",
    "voice": "vo_adv_1037010_018",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我也不覺得可以透過這個小遊戲",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "習得奧義就是了。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "今天的話",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "就當作互相緩解緊張吧。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "如何？",
    "voice": "vo_adv_1037010_019",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "要試試看嗎？",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "那我們就馬上",
    "voice": "vo_adv_1037010_020",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "開始第一回合吧。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "好了，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "來吧來吧……",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……呵呵，",
    "voice": "vo_adv_1037010_021",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "像這樣觀望沒關係嗎？",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "再繼續磨磨蹭蹭的話，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我要出手了──",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "嘿！",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "background",
    "bg_id": "500140"
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "啊哈哈哈，",
    "voice": "vo_adv_1037010_022",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "抱歉抱歉。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n雖說只是玩個遊戲，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "和我正面對決的話，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "就會變成這樣呢。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "剛才的就當作練習吧。",
    "voice": "vo_adv_1037010_023",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "接下來",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我會放水的。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "首先，",
    "voice": "vo_adv_1037010_024",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我想想……",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我只用一隻手跟你打。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n然後",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "如果我的劍掉落了也視為落敗。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "要不然，",
    "voice": "vo_adv_1037010_025",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我連續取勝的時候，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "再補上其他的放水條件也可以喔。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n如此一來",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "你也會有勝算，對吧？",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……呵呵，",
    "voice": "vo_adv_1037010_026",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "如何？",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
