[
  {
    "type": "dialogue",
    "name": "啾二",
    "words": "妳們，",
    "voice": "vo_adv_5088323_000",
    "unit_id": 15911
  },
  {
    "type": "dialogue",
    "name": "啾二",
    "words": "蠻有能耐的嘛……",
    "voice": null,
    "unit_id": 15911
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你、",
    "voice": "vo_adv_5088323_001",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你才是呢！",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "快點投降怎麼樣啊！？",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "啾二",
    "words": "要是能那麼做就好了。",
    "voice": "vo_adv_5088323_002",
    "unit_id": 15911
  },
  {
    "type": "dialogue",
    "name": "啾二",
    "words": "\\n可惜……",
    "voice": null,
    "unit_id": 15911
  },
  {
    "type": "dialogue",
    "name": "啾二",
    "words": "我已經停不下來了。",
    "voice": null,
    "unit_id": 15911
  },
  {
    "type": "dialogue",
    "name": "啾二",
    "words": "\\n我們……",
    "voice": null,
    "unit_id": 15911
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "……那是什麼意思？",
    "voice": "vo_adv_5088323_003",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "啾二",
    "words": "我們也不是自願變成這樣的。",
    "voice": "vo_adv_5088323_004",
    "unit_id": 15911
  },
  {
    "type": "dialogue",
    "name": "啾二",
    "words": "\\n只不過誕生在這個世上……",
    "voice": null,
    "unit_id": 15911
  },
  {
    "type": "dialogue",
    "name": "啾二",
    "words": "我們已別無選擇了。",
    "voice": null,
    "unit_id": 15911
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "……那還真是",
    "voice": "vo_adv_5088323_005",
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "令人痛心……",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n真的沒辦法停手嗎？",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "啾三",
    "words": "沒錯……",
    "voice": "vo_adv_5088323_006",
    "unit_id": 15912
  },
  {
    "type": "dialogue",
    "name": "啾三",
    "words": "我們別無選擇了！",
    "voice": null,
    "unit_id": 15912
  },
  {
    "type": "dialogue",
    "name": "啾三",
    "words": "\\n妳們可別怪我啊……！",
    "voice": null,
    "unit_id": 15912
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "看來我們",
    "voice": "vo_adv_5088323_007",
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "想阻止老鼠先生牠們，",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n就只有贏過牠們這個方法了……",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "感覺這是牠們的最後手段了吧。",
    "voice": "vo_adv_5088323_008",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n因此",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我們絕對不能輸！",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "讓牠們瞧瞧",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我們的潛力吧！",
    "voice": null,
    "unit_id": 121411
  }
]
