  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}跟鏡華兩人繼續的\\n在蘭德索爾開心地逛著街。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "啊，",
    "voice": "vo_adv_1111003_000",
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "已經這麼晚了……！",
    "voice": null,
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "人變多了呢。",
    "voice": null,
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "……你露出很不可思議的表情呢。",
    "voice": "vo_adv_1111003_001",
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n也就是說，",
    "voice": null,
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "你不知道接下來有什麼事情對吧？",
    "voice": null,
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "那麼",
    "voice": null,
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "就讓我告訴你吧。",
    "voice": null,
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "到了晚上，",
    "voice": "vo_adv_1111003_002",
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "會有萬聖節遊行喔。",
    "voice": null,
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n因為想要靠近一點看，",
    "voice": null,
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "所以人們現在就開始聚集了。",
    "voice": null,
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "那麼，我們出發吧。",
    "voice": "vo_adv_1111003_003",
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "那還用說嗎。",
    "voice": "vo_adv_1111003_004",
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n遊行會經過的地方啊！",
    "voice": null,
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "會有很多孩子們聚集，",
    "voice": "vo_adv_1111003_005",
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n是發糖果最好的機會呢。",
    "voice": null,
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "才不是！",
    "voice": "vo_adv_1111003_006",
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我今天是要來做什麼的，",
    "voice": null,
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "你忘記了嗎？",
    "voice": null,
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "是要發糖果",
    "voice": "vo_adv_1111003_007",
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "給孩子們啊！",
    "voice": null,
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "還記得嗎？　",
    "voice": null,
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "……那是真的嗎～？",
    "voice": null,
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "這附近好像不錯呢。",
    "voice": "vo_adv_1111003_008",
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n能夠看到遊行，",
    "voice": null,
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "也很寬敞，",
    "voice": null,
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "感覺會聚集很多人呢。",
    "voice": null,
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "那麼，",
    "voice": "vo_adv_1111003_009",
    "unit_id": 111111
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "把糖果拿出來",
