[
  {
    "type": "background",
    "bg_id": "501220"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在{0}等人要離開村子的當天早上──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n可可蘿正在幫忙{0}收拾行李。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人，",
    "voice": "vo_adv_1155004_000",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您有沒有遺忘了什麼東西呢？",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這裡距離蘭德索爾非常遠，",
    "voice": "vo_adv_1155004_001",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "要是留在這裡忘了帶走，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "可是一件大事。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "昨晚",
    "voice": "vo_adv_1155004_002",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在主人安睡時，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下擅自製作了",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "攜帶物品的檢查表。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請看，",
    "voice": "vo_adv_1155004_003",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "還請您對照這張表，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n確認所有東西",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是否都有帶上。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "咦……？",
    "voice": "vo_adv_1155004_004",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n主人，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那道光是……！",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "background",
    "bg_id": "510240"
  },
  {
    "type": "dialogue",
    "name": "學生1",
    "words": "啊──累死了──！",
    "voice": "vo_adv_1155004_005",
    "unit_id": 6632
  },
  {
    "type": "dialogue",
    "name": "學生1",
    "words": "我們去家庭餐廳吧！",
    "voice": null,
    "unit_id": 6632
  },
  {
    "type": "dialogue",
    "name": "學生2",
    "words": "好主意耶，",
    "voice": "vo_adv_1155004_006",
    "unit_id": 6732
  },
  {
    "type": "dialogue",
    "name": "學生2",
    "words": "我想吃聖代～！",
    "voice": null,
    "unit_id": 6732
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "……",
    "voice": "vo_adv_1155004_007",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "……啊，",
    "voice": "vo_adv_1155004_008",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "{0}先生！",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "不好意思，",
    "voice": "vo_adv_1155004_009",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "還請您原諒在下突然來訪。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "那個……",
    "voice": "vo_adv_1155004_010",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "其實",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "在下有事想找您商量，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "才會像這樣",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "在校門前",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "等待。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "……還請您",
    "voice": "vo_adv_1155004_011",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "以嚴肅的心態來聽這件事。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "在下所說的商量，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "是……",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "關於交朋友",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "這件事。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "明明都已是小學五年級生了，",
    "voice": "vo_adv_1155004_012",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "卻還抱著這種困擾，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "著實感到羞愧……",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "但在下能商量這件事的，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "就只有",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "您而已了。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "如同您所知道的，",
    "voice": "vo_adv_1155004_013",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n在下是與",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "父親一起生活在封閉的研究所中。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "或許因為如此，",
    "voice": "vo_adv_1155004_014",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "在下對於現在當紅的藝人",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "或流行的事物都很生疏，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n也沒有什麼共通的話題。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "更別說是",
    "voice": "vo_adv_1155004_015",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "在下的用字遣詞總是冒失突兀……",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "所以，",
    "voice": "vo_adv_1155004_016",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "與同年紀的同學之間，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "在下總是不由自主地感受到距離，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "無法掌握互動方法，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "也找不到加入話題的契機……",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "為了能與父親並駕齊驅……",
    "voice": "vo_adv_1155004_017",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n為了更加了解這世界，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "就算會勉強自己，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "是否也該加入同學們的圈子呢……",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "但是，",
    "voice": "vo_adv_1155004_018",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "那不會變成在偽裝自己嗎？",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "如此這般，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "在下總是會",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "獨自為此問題陷入兩難。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "勉強自己偽裝所建立的關係，",
    "voice": "vo_adv_1155004_019",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "是否",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "能稱得上是真正的友情呢……？",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "懇請您給在下",
    "voice": "vo_adv_1155004_020",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "一些建議。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "請務必讓在下聽聽",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "交友廣泛的您有何看法。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "啊，",
    "voice": "vo_adv_1155004_021",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "{0}先生？",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n請問是要去哪裡呢？",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "background",
    "bg_id": "510201"
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "這裡是……？",
    "voice": "vo_adv_1155004_022",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n您認為在下所問之事的答案，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "就在這裡嗎？",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "好、",
    "voice": "vo_adv_1155004_023",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "好的……",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "still",
    "still_id": "115500401"
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "是的。",
    "voice": "vo_adv_1155004_024",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n與主人相遇時的事，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "就如同昨天的記憶般清晰。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "在下",
    "voice": "vo_adv_1155004_025",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "於車站前因不曉得回家的路",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "而不知所措時，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "是主人拯救了在下。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "在下",
    "voice": "vo_adv_1155004_026",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "做夢也想不到，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "竟然會在那種場合",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n遇見",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "在下的主人。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "您的意思是，",
    "voice": "vo_adv_1155004_027",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "現在不需要",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "勉強自己去迎合周遭……",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "這樣嗎？",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "確實",
    "voice": "vo_adv_1155004_028",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "如您所說呢。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n在下所認識的世界，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "幾乎只有小學與動物園。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "這個世界上",
    "voice": "vo_adv_1155004_029",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "肯定居住著",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "比這個城鎮還要多好幾千……",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n還要多好幾萬倍的人們。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "那麼，",
    "voice": "vo_adv_1155004_030",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "在某處肯定也有人",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "願意接受",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "這樣的在下……",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "相遇",
    "voice": "vo_adv_1155004_031",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "就如同被命運絲線所牽引一般，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n相互對話、",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "分享心情，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n肯定也存在能像這樣深交，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "而在下尚未認識的友人……",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "也就是說，",
    "voice": "vo_adv_1155004_032",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "就算現在是毫不相干的人，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "只要有那麼一點契機，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n也能夠與其交心。您是想這樣告訴在下嗎？",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "still",
    "still_id": "115500402"
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "就像在下和主人這樣……♪",
    "voice": "vo_adv_1155004_033",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "呵呵……",
    "voice": "vo_adv_1155004_034",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "在下",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "總是被主人",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "拯救呢。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "在下迷失於人生之路時，",
    "voice": "vo_adv_1155004_035",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n是走在前方的主人成為指標，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "替在下照亮了應進之路。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "雖然",
    "voice": "vo_adv_1155004_036",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "往後或許仍會如此……",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "但是，",
    "voice": "vo_adv_1155004_037",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "為了能夠追上主人，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "在下也會更加精進。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n這也是……",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "為了在下",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "未來將要遇見的，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "仍未謀面的朋友。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "為了將來",
    "voice": "vo_adv_1155004_038",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "主人與各位迷失目標時，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n在下",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "能夠做為指標引導方向……",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "非常抱歉。",
    "voice": "vo_adv_1155004_039",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n在下是否說得太超過了……",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "好、",
    "voice": "vo_adv_1155004_040",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "好的！",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "被主人這樣期待，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "讓在下的心底有股力量",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "伴隨責任感湧上來了。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "在下",
    "voice": "vo_adv_1155004_041",
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "想要更加更加地成長。",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n以後還要請您多多指教囉，",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "主人♪",
    "voice": null,
    "unit_id": 105931
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "啊啊啊啊～～～～～",
    "voice": "vo_adv_1155004_042",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "小可可蘿她呀，",
    "voice": "vo_adv_1155004_043",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n不管什麼時候看……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不管看幾次都真讓人受不了呢……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那楚楚可憐的大眼睛……！",
    "voice": "vo_adv_1155004_044",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n緊緊噘起的嘴角……！！",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "清秀長髮間微微露出的小巧耳朵……！！",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "……呼～",
    "voice": "vo_adv_1155004_045",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n你等我一下喔。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我先冷靜一下……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "………………",
    "voice": "vo_adv_1155004_046",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好啦，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "久等了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "接下來……",
    "voice": "vo_adv_1155004_047",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你也看到了，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "「那邊」的小可可蘿啊，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n跟你以外的人還是沒有任何交集。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "如果沒發生什麼意外，",
    "voice": "vo_adv_1155004_048",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你肯定會帶她與其他人建立友誼吧，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n但很可惜的，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "現實並非如此。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你們四個人",
    "voice": "vo_adv_1155004_049",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "要在「那邊」相遇，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n肯定會是稍遠的未來。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "沒錯……",
    "voice": "vo_adv_1155004_050",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "於我們所努力的目標，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "在那個幸福結局之後呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "為了能讓小可可蘿在「那邊」",
    "voice": "vo_adv_1155004_051",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "也能與無可取代的夥伴們",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "建立羈絆，\\n你可要好好努力才行啊。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這件事是除了你之外誰也辦不到的……",
    "voice": "vo_adv_1155004_052",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "拜託你囉。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "501220"
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "唔、",
    "voice": "vo_adv_1155004_053",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "唔唔……",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "沒想到會在這個地方",
    "voice": "vo_adv_1155004_054",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "與主人一起",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "接受來自愛梅斯大人神諭……",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不過",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這肯定是某種吉兆的象徵呢。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呵呵……♪",
    "voice": "vo_adv_1155004_055",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "啊，",
    "voice": "vo_adv_1155004_056",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "沒事的。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "並不是什麼大事……",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "只是覺得",
    "voice": "vo_adv_1155004_057",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這次好像是第一次",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "返鄉停留這麼長一段時間……",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "若是平常，",
    "voice": "vo_adv_1155004_058",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "想盡早",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "回到主人身邊，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n又想要在這",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "令人懷念的故鄉",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "停留得再久一點點……",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "總會有著",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這兩種心情。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但是……",
    "voice": "vo_adv_1155004_059",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "總覺得這次",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下能以開朗的心情，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n向故鄉的同胞們",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "好好地道別。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這肯定是因為",
    "voice": "vo_adv_1155004_060",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "與主人和貪吃佩可小姐她們……",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下能與珍重的夥伴在一起的關係。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下",
    "voice": "vo_adv_1155004_061",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "對於能與主人相遇這件事，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n打從心底由衷地感到幸福。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "若願望能夠成真，在下希望……",
    "voice": "vo_adv_1155004_062",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "與主人等人",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "無可取代的幸福瞬間，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "能夠永生永世持續下去……♪",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "好的，",
    "voice": "vo_adv_1155004_063",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "確認表上的東西",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "也都沒有遺漏呢。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n收拾行李",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "辛苦您了。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那麼，",
    "voice": "vo_adv_1155004_064",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "能請您",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "先過去村子的出口嗎？",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下",
    "voice": "vo_adv_1155004_065",
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "最後也想再次確認",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "有無遺忘的物品，",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……以及",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "有另外一件必須做的事。",
    "voice": null,
    "unit_id": 115511
  },
  {
    "type": "background",
    "bg_id": "501200"
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "讓您久等了，",
    "voice": "vo_adv_1155004_066",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不，",
    "voice": "vo_adv_1155004_067",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "並不是遺忘了，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "而是在下決定將其留在此處。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那件服裝將成為指標，",
    "voice": "vo_adv_1155004_068",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "做為在下的一部分",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "留在故鄉。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "如此一來，",
    "voice": "vo_adv_1155004_069",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這個村子的存在，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "往後也將持續賦予在下力量……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下是這麼認為的。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下想要",
    "voice": "vo_adv_1155004_070",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "使用那份力量",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "為主人與重要的夥伴努力。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n替各位進行支援，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "便是在下的職責。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下",
    "voice": "vo_adv_1155004_071",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "將不會再次放開",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "與主人牽起的手。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "因為……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "咳。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……請讓在下重述一遍。",
    "voice": "vo_adv_1155004_072",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下，",
    "voice": "vo_adv_1155004_073",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n是受到偉大的愛梅斯大人差遣而前來的",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "「嚮導」……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "名叫",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "可可蘿。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "保護主人的安危，",
    "voice": "vo_adv_1155004_074",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n從早晨到夜晚……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "從出生到死亡，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "誠心誠意地照顧主人，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "便是在下的職責。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "所以說……",
    "voice": "vo_adv_1155004_075",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "今後也請與在下繼續一同編織",
    "voice": "vo_adv_1155004_076",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "屬於咱們的故事吧……♪",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "為了不再次分開而牽起手的兩人，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n他們邁出步伐的腳印，刻畫起全新的一頁。",
    "voice": null,
    "unit_id": null
  }
]
