[
  {
    "type": "background",
    "bg_id": "500890"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "這一天深月依舊在蘭德索爾的小巷內替人們看診。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我要打針囉。",
    "voice": "vo_adv_5074000_000",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "可能會有一點刺刺的，要忍耐喔。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "暴徒",
    "words": "痛死啦──！",
    "voice": "vo_adv_5074000_001",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒",
    "words": "可惡，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒",
    "words": "這哪是一點刺刺的！？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒",
    "words": "我還以為手臂炸掉啦。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "哎呀，",
    "voice": "vo_adv_5074000_002",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這樣才能趕快痊癒呀，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這可是",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我給你的溫柔呢。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "你想要的話，我也可以給你更硬派點的溫柔喔？",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "暴徒",
    "words": "還是算了吧。",
    "voice": "vo_adv_5074000_003",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒",
    "words": "真是的，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒",
    "words": "妳的溫柔太可怕啦……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "有時間抱怨，",
    "voice": "vo_adv_5074000_004",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不如快點回去好好養傷吧。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "就算是你這種人，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這個城鎮依舊需要你喔。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "暴徒",
    "words": "不用說我也明白啦。",
    "voice": "vo_adv_5074000_005",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒",
    "words": "再見啦，醫生。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "好啦，{0}，",
    "voice": "vo_adv_5074000_006",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "可以幫我叫下一位患者嗎？",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這樣啊。",
    "voice": "vo_adv_5074000_007",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "話說回來，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "最近這陣子病患還真多呢。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不然平常我一個人就應付得來了，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n現在卻還要請你來充當護理師。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "蘭德索爾也真是一波未平一波又起，",
    "voice": "vo_adv_5074000_008",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "和平還遙不可及，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "看來你還得忙上好一陣子吧。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "你覺得開心就好。",
    "voice": "vo_adv_5074000_009",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "真是的，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "讓我這種密醫生意興隆，這世界沒救了呢。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "關於這件事，",
    "voice": "vo_adv_5074000_010",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "公會夥伴也問過也一樣的問題，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n但說起來我其實是科學家，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "研究與實驗才是我的本分。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "雖然我順勢而為，看起來像是在助人為善，",
    "voice": "vo_adv_5074000_011",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n但我跟社會一般認知的醫生不同，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "並不全然是出於善意才幫助人的。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "況且像我這樣的人",
    "voice": "vo_adv_5074000_012",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "保持地下活動才比較方便。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "非法研究只能暗中進行啊。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "就算真的出了差錯，",
    "voice": "vo_adv_5074000_013",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "也可以在暗中輕易處理掉。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "舉個例子，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "就算我現在對你做了什麼，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "也能輕鬆消滅痕跡喔。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……我開玩笑的。",
    "voice": "vo_adv_5074000_014",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "當我沒說吧。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "真是的，",
    "voice": "vo_adv_5074000_015",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "你總是會讓我不知所措。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "你應該只是個方便的實驗品才對啊，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "真傷腦筋。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "現在被你害得我為了這些不習慣的助人活動而忙碌，",
    "voice": "vo_adv_5074000_016",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n本業都被耽誤了，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "以前的我根本不可能這樣。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不過相對地，",
    "voice": "vo_adv_5074000_017",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "你也讓我看到了很多有趣的事，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n所以我其實也挺感謝你的啦。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "好啦，今天就到這邊吧。",
    "voice": "vo_adv_5074000_018",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n想休息就休息，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這也是密醫的特權喔。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "打擾啦。",
    "voice": "vo_adv_5074000_019",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "就是妳沒錯吧？",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "妳就是那個叫做深月的醫生？",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……沒錯。",
    "voice": "vo_adv_5074000_020",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "但我是個密醫喔。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n如果你為人正派、不做虧心事，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "最好還是去找有執照的醫生吧。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "不必，",
    "voice": "vo_adv_5074000_021",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "聽到妳這麼說我就放心了。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我就是有事要來拜託妳這位密醫的。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "拜託妳！",
    "voice": "vo_adv_5074000_022",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "請妳",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "救救我們頭目吧！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……你先抬起頭吧。",
    "voice": "vo_adv_5074000_023",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不然我們要怎麼繼續談呢？",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n更何況，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我都還不知道你是什麼人呢。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "的、",
    "voice": "vo_adv_5074000_024",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "的確。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我是大江戶町，來道一家的人。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "來道、",
    "voice": "vo_adv_5074000_025",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "一家……",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "喔喔，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "黑道是吧。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "簡單說，",
    "voice": "vo_adv_5074000_026",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "就是東國的幫派吧。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "別把我們跟其他地方的幫派混為一談！",
    "voice": "vo_adv_5074000_027",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n我們可是重情重義的俠客集團。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "所以，",
    "voice": "vo_adv_5074000_028",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "你是要來拜託我替你們頭目動手術嗎？",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "可以是可以，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "但我價格不菲喔。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "不是的，",
    "voice": "vo_adv_5074000_029",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我們頭目被帶走了，我是來拜託妳去救他的。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "被帶走了？",
    "voice": "vo_adv_5074000_030",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我可不要捲入你們黑幫之間的鬥爭。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n抱歉，你另請高明吧。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "不是那樣的。",
    "voice": "vo_adv_5074000_031",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我們頭目被帶去的地方是……",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "醫院。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……這是怎麼回事？",
    "voice": "vo_adv_5074000_032",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "頭目他最近身體狀況欠佳，",
    "voice": "vo_adv_5074000_033",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "但他原本是很硬朗的，所以我們也不怎麼擔心。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "可是，",
    "voice": "vo_adv_5074000_034",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "某一天有間醫院的院長突然過來，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n幾乎用押送的方式把頭目給帶走了。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我們想去探病，結果那個混帳院長居然說頭目謝絕會客，把我們趕了回來。",
    "voice": "vo_adv_5074000_035",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我拜託妳了，醫生！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "幫我們把頭目帶回來吧！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "但是就我聽來，",
    "voice": "vo_adv_5074000_036",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "感覺不出有什麼異狀。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "之所以強行帶走頭目，也許是因為有緊急狀況需要處理，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "住院後謝絕會客，也可能是因為狀況突然惡化了。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "不可能，",
    "voice": "vo_adv_5074000_037",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "那是絕對不可能的！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "肯定是那間醫院有問題！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "你對我說這些也沒用啊……",
    "voice": "vo_adv_5074000_038",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "話說那是哪間醫院呢？",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "叫做聖阿弗萊特醫院，",
    "voice": "vo_adv_5074000_039",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "看上去很氣派、房子又大。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n妳有聽過嗎？",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "聖阿弗萊特醫院……",
    "voice": "vo_adv_5074000_040",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我是有聽過……",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "想起來了，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我記得是間經營困難險些倒閉的醫院。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "可是，",
    "voice": "vo_adv_5074000_041",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我不覺得他們有那閒工夫，\\n可以跟黑社會的人起爭端呢。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "其實那間病院",
    "voice": "vo_adv_5074000_042",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "一年前才換成現在這個院長，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n之後就一口氣重振了經營。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "只花了一年？",
    "voice": "vo_adv_5074000_043",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "真是驚人。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "看來那位院長是個優秀的人才呢？",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我想是吧。",
    "voice": "vo_adv_5074000_044",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "實際上那家醫院現在的風評非常好。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "可是，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "那個院長實在",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "太可疑了。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "那只是你個人的印象吧？",
    "voice": "vo_adv_5074000_045",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "再說了，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "你不該找我這密醫處理這種事情的。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "前提是妳只是個普通的密醫，",
    "voice": "vo_adv_5074000_046",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n我知道妳是什麼人才來拜託妳的，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "「單眼惡魔」。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……這樣啊，",
    "voice": "vo_adv_5074000_047",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "所以你知道我是誰。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "太出名也挺傷腦筋的呢。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "也就是說，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "你想要找個同時是醫生",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "又深諳黑社會的人物，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n於是就挑中了我，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "沒錯吧？",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "沒錯，",
    "voice": "vo_adv_5074000_048",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "就是那樣。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "若要潛入黑暗之中，",
    "voice": "vo_adv_5074000_049",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "了解黑暗的人自然是不二人選。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "你的選擇，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "是正確的。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "這、",
    "voice": "vo_adv_5074000_050",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "這麼說……",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "但是，",
    "voice": "vo_adv_5074000_051",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "就算我是不二人選，\\n但蹚這渾水對我真的有好處嗎？",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "你自己就是黑社會的人，",
    "voice": "vo_adv_5074000_052",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "難道不知道接觸黑暗會有危險？",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "正因為理解其中風險，",
    "voice": "vo_adv_5074000_053",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "所以才更需要深思熟慮。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n我可不能輕言答應這種事情。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……我說你啊，",
    "voice": "vo_adv_5074000_054",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "可以別說得一派輕鬆嗎？",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n若是落到最糟的情況，我可能會被捲入有致命風險的麻煩裡面喔？",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "重點不是你幫不幫……",
    "voice": "vo_adv_5074000_055",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不對，",
    "voice": "vo_adv_5074000_056",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "已經來不及了。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "無論對象或風險如何，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這個人只要路見不平就會一視同仁地拔刀相助。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "他聽完對方原委之後就已經不可能拒絕了。",
    "voice": "vo_adv_5074000_057",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "拜託了！",
    "voice": "vo_adv_5074000_058",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "不只我們來道一家，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n這是攸關大江戶町的大事。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n請妳助町上一臂之力吧！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……剛剛也說過了，",
    "voice": "vo_adv_5074000_059",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我價格不菲喔。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "出差費用，以及出了什麼事的危險津貼等等，金額上你們要有心理準備。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "沒、",
    "voice": "vo_adv_5074000_060",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "沒問題！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "謝謝妳，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "這份恩情我沒齒難忘！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "話說得太早了喔。",
    "voice": "vo_adv_5074000_061",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "要道謝，等我把你們頭目帶回來再說吧。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就這樣，\\n深月與{0}",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "動身前往大江戶町。",
    "voice": null,
    "unit_id": null
  }
]
