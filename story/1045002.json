[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "空花在路上走著走著就遇到了{0}。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "空、",
    "voice": "vo_adv_1045002_000",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "空花到底應該怎麼做……",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "啊！",
    "voice": "vo_adv_1045002_001",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "虐、",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "虐待狂先生，",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n在這種地方相遇",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "真是巧耶。",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "空花看起來心情不好的樣子？",
    "voice": "vo_adv_1045002_002",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "欸！",
    "voice": "vo_adv_1045002_003",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "看得出來！？",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "該不會虐、虐待狂先生，",
    "voice": "vo_adv_1045002_004",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "還有隱藏的特殊能力吧……！",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "……他、他要是使用這股力量，",
    "voice": "vo_adv_1045002_005",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n整個世界不管是誰，",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "瞬間都會變成剛誕生的赤裸模樣！",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "嘻嘻、",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "嘻嘻嘻……",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "……欸？空花好像很有精神所以你就要回去了？",
    "voice": "vo_adv_1045002_006",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "請、",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "請等一下。",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "到剛剛為止空花確實都很沒有精神。",
    "voice": "vo_adv_1045002_007",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n多虧了虐待狂先生才打起一點精神的。",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "該、該不會，",
    "voice": "vo_adv_1045002_008",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n你想說要用空花的身體做交換吧……流口水。",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "虐待狂先生，你、你要去哪裡？",
    "voice": "vo_adv_1045002_009",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "空花說。",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "空花說就是了。",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "……其實，空、空花",
    "voice": "vo_adv_1045002_010",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "是以過度操勞自己的身體，",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "在賺取酬金的。",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "簡單來說……",
    "voice": "vo_adv_1045002_011",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n就是在那邊的酒吧，",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n擔任舞孃……",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "但是空花是新人……",
    "voice": "vo_adv_1045002_012",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n而且沒想到",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "舞技比別人落後很多……",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "欸，比別人落後的原因嗎？",
    "voice": "vo_adv_1045002_013",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "對、對自己的舞蹈還沒有自信……",
    "voice": "vo_adv_1045002_014",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n再加上……被這麼多人的眼睛盯著看，",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "空花覺得很難為情……",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "所、所以，空花想多少做一些努力也好，",
    "voice": "vo_adv_1045002_015",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "剛剛正在這裡練習。",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "欸欸！陪、陪空花做嗎！？",
    "voice": "vo_adv_1045002_016",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "就在光天化日之下……嗎？",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "真、真不愧是虐待狂先生……流口水。",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "空花……這、這種事情，",
    "voice": "vo_adv_1045002_017",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n雖然是第一次做，",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n但既然虐待狂先生這麼說了……",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "欸？",
    "voice": "vo_adv_1045002_018",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n你說大概跟空花想的不一樣……",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n是陪空花做……練習？",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "……",
    "voice": "vo_adv_1045002_019",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "呀、呀啊！",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n空空空、空花又，",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n異想天開地誤會了……！",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "這、這是第二次，",
    "voice": "vo_adv_1045002_020",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n被虐待狂先生看到",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "這麼丟臉的樣子呢……",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "……真不是涉世未深的少女該有的失態。",
    "voice": "vo_adv_1045002_021",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "空花已經嫁不出去了。",
    "voice": "vo_adv_1045002_022",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n因為已經被虐待狂先生玷汙了。",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "……乾、",
    "voice": "vo_adv_1045002_023",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "乾脆，",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "一鼓作氣，",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "把空花弄得更亂七八糟吧！",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "嘻嘻、",
    "voice": "vo_adv_1045002_024",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "嘻嘻嘻……流口水。",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}無意間理解了空花的舞技無法進步的原因。",
    "voice": null,
    "unit_id": null
  }
]
