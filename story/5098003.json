    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "儘管我明白他很焦慮。",
    "voice": "vo_adv_5098003_076",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n雖然盜用組織的資金拿去賭博，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "他與其說是賭徒，更像個膽小鬼。",
