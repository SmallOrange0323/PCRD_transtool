    "unit_id": 105432
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "就算是臨時要躲，",
    "voice": null,
    "unit_id": 105432
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "怎麼會選在拍貼機裡啊！",
    "voice": null,
    "unit_id": 105432
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n這裡是密室啊～～～！！",
