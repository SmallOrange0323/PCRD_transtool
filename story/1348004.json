    "type": "dialogue",
    "name": "紡希",
    "words": "不行！",
    "voice": null,
    "unit_id": 105432
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n有什麼可以躲的地方嗎──",
    "voice": null,
    "unit_id": 105432
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "不管了，",
    "voice": null,
    "unit_id": 105432
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "就選這裡！",
    "voice": null,
    "unit_id": 105432
  },
  {
    "type": "still",
    "still_id": "134800401"
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "這、",
    "voice": "vo_adv_1348004_032",
    "unit_id": 105432
  },
  {
    "type": "dialogue",
    "name": "紡希",
