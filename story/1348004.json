    "voice": "vo_adv_1348004_028",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同班同學1",
    "words": "我是第一次",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同班同學1",
    "words": "來到遊戲中心呢！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同班同學1",
    "words": "\\n真是熱鬧的場所！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同班同學1",
    "words": "閃閃發光的很刺眼",
