    "unit_id": 105432
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "要是被發現就糟糕了。",
    "voice": null,
    "unit_id": 105432
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "什、什麼時候投的！？",
    "voice": "vo_adv_1348004_036",
    "unit_id": 105432
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "行動太迅速了吧！？",
    "voice": null,
    "unit_id": 105432
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105432
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我、",
    "voice": null,
    "unit_id": 105432
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我沒有要拍喔？",
    "voice": null,
    "unit_id": 105432
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我才不拍！",
    "voice": null,
    "unit_id": 105432
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "啊啊啊，",
