    "unit_id": 105432
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "這、",
    "voice": "vo_adv_1348004_034",
    "unit_id": 105432
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "這類意外，",
    "voice": null,
    "unit_id": 105432
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "或者說是事故，",
    "voice": null,
    "unit_id": 105432
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n明明平時都是騎士先生會引發的，",
    "voice": null,
    "unit_id": 105432
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我真是太不小心了！",
    "voice": null,
    "unit_id": 105432
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n怜大人對不起！",
    "voice": null,
    "unit_id": 105432
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "這是事故！",
    "voice": null,
    "unit_id": 105432
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "是事故啊～～～！！　",
