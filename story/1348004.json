  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "是怎樣！？",
    "voice": null,
    "unit_id": 105432
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n滿臉通紅的，",
    "voice": null,
    "unit_id": 105432
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我我我我露出了這種表情嗎！？　",
