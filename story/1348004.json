    "unit_id": 105432
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "就是啊！",
    "voice": "vo_adv_1348004_021",
    "unit_id": 105432
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "所以才令人煩惱！",
    "voice": null,
    "unit_id": 105432
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105432
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "同時有兩種同樣重要的感情，",
    "voice": null,
    "unit_id": 105432
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n令人難以招架，真的很辛苦，",
    "voice": null,
    "unit_id": 105432
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "明明就連其中一種應付不來了。",
    "voice": null,
    "unit_id": 105432
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "啊，",
    "voice": "vo_adv_1348004_022",
    "unit_id": 105432
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "當然這是朋友的故事喔，",
    "voice": null,
    "unit_id": 105432
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "是在說朋友！",
    "voice": null,
    "unit_id": 105432
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "要兼顧",
    "voice": "vo_adv_1348004_023",
    "unit_id": 105432
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "真的很困難呢。",
    "voice": null,
    "unit_id": 105432
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105432
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "學業和社團活動、",
    "voice": null,
    "unit_id": 105432
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "工作和興趣、",
    "voice": null,
    "unit_id": 105432
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "友情和愛情……",
    "voice": null,
    "unit_id": 105432
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "類似這些？",
    "voice": null,
    "unit_id": 105432
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n懷抱著兩種無解的感情，令人不知該如何是好",
    "voice": null,
    "unit_id": 105432
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "……",
    "voice": null,
    "unit_id": 105432
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我是說那位朋友啦。",
    "voice": null,
    "unit_id": 105432
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "不、",
    "voice": "vo_adv_1348004_024",
    "unit_id": 105432
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "不過，",
    "voice": null,
    "unit_id": 105432
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "只是這樣說出來也解決不了問題呢！",
    "voice": null,
    "unit_id": 105432
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n我那位朋友大概也是這麼覺得的！",
    "voice": null,
    "unit_id": 105432
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105432
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "啊──真是的！",
    "voice": null,
    "unit_id": 105432
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "既然這樣，",
    "voice": null,
    "unit_id": 105432
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "就盡情玩樂轉換心情吧！",
    "voice": null,
    "unit_id": 105432
  },
