    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "……至今為止重置前的記憶，",
    "voice": "vo_adv_5208002_056",
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n都只保存在我們管理者的記憶領域裡。",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "但是伴隨著這個世界的資源被削減，",
