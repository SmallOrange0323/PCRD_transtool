    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "這就是「惡夢症」的原因。",
    "voice": "vo_adv_5208002_058",
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n管理者所保存的重置前記憶",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "流入了大家的意識裡……",
    "voice": null,
    "unit_id": 135511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "……因為我的關係，",
