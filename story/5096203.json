[
  {
    "type": "dialogue",
    "name": "日和",
    "words": "太好了──！",
    "voice": "vo_adv_5096203_000",
    "unit_id": 122411
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n魔物回去海裡了喔──！",
    "voice": null,
    "unit_id": 122411
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "太好了……！",
    "voice": "vo_adv_5096203_001",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n妳們兩個有沒有受傷呀？",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "嗯，",
    "voice": "vo_adv_5096203_002",
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "優衣，沒事的。",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n只是多了些擦傷而已……",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "糟糕了！",
    "voice": "vo_adv_5096203_003",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "怜，",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "妳別動喔。",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n我馬上幫妳治療！",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "呃、",
    "voice": "vo_adv_5096203_004",
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不，",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不是那麼需要人擔心的傷……",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "無論之後的對決項目如何，",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這點傷勢都不會造成太大的影響的。",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "真是的，",
    "voice": "vo_adv_5096203_005",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我不是那個意思……",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n夥伴受傷的話，",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "當然會擔心呀。",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "沒錯沒錯！",
    "voice": "vo_adv_5096203_006",
    "unit_id": 122411
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "而且大家健健康康的，",
    "voice": null,
    "unit_id": 122411
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n拿出真本事來互相競爭會比較有趣呢！",
    "voice": null,
    "unit_id": 122411
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "妳們說得沒錯。",
    "voice": "vo_adv_5096203_007",
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n那這次",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就大家一起過去那邊吧。",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n因為那裡好像還殘留著魔物的氣息呢。",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "兩人",
    "words": "嗯！",
    "voice": "vo_adv_5096203_008",
    "unit_id": null
  }
]
