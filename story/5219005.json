  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}新想到的下一個企劃。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n那就是──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "「緊急挑戰！",
    "voice": "vo_adv_5219005_000",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "魔物們瘋狂湧上陸地！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "守護度假村的大家吧！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n只要成功討伐魔物，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "便能馬上獲得●●！！」",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "「●●」是什麼呀──？",
    "voice": "vo_adv_5219005_001",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "就是會給各式各樣獎勵的意思吧。",
    "voice": "vo_adv_5219005_002",
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "而且這企劃內容只是普通的冒險嘛ｗ",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "話說回來，",
    "voice": "vo_adv_5219005_003",
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "這裡的營運怎麼回事？",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "根本是想利用遊客來圖個方便，如意算盤打得太明顯真讓人火大啊ｗ",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "但算了，",
    "voice": "vo_adv_5219005_004",
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "畢竟獎勵看起來挺豐盛的。",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "哥哥，",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "下次主題就用這個吧♡",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n反正都要參加，",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "乾脆我和班比開著直播進行討伐好了──♡",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "之前牙之丞那個影片不是爆紅了嗎？",
    "voice": "vo_adv_5219005_005",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n聽布武機她說，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "似乎能因此得到不少獎金喔。",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "……班比看看，",
    "voice": "vo_adv_5219005_006",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "想開始直播的話……",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "之前是點擊選單哪裡呀～？",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n這個？",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "還是",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "這一個……？",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "沒關係──！",
    "voice": "vo_adv_5219005_007",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n外面很危險的，與其那樣做，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "僕從還是和貝斯一起留守在這邊吧！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "要當個乖孩子等著喔？",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "好棒好棒♪",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "啊～班比！",
    "voice": "vo_adv_5219005_008",
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "妳不要偷跑好嗎～！",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n過來這邊！",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "我要開始宣傳用的直播了！！",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "咦？",
    "voice": "vo_adv_5219005_009",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "明明是布武機的直播，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "卻要班比過去呀？",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "雖然不太懂，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "但班比知道了！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "隱身號",
    "words": "直播開始～♡",
    "voice": "vo_adv_5219005_010",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "各位雜碎，",
    "voice": "vo_adv_5219005_011",
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "有在看嗎──♡",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "哇，",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "不是吧。",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "竟已經聚集一堆觀眾了ｗ",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n你們是不是都乖乖跪坐著",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "在等人家開台呀？ｗ",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "聽眾的評語",
    "words": "「沒錯，一直都在等！」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "聽眾的評語",
    "words": "「布武機──！」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "聽眾的評語",
    "words": "\\n",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "聽眾的評語",
    "words": "「小的是您的奴隸。」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "聽眾的評語",
    "words": "「哈啊……哈啊……哈啊……」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "聽眾的評語",
    "words": "\\n",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "聽眾的評語",
    "words": "「今天您的聲音仍如此動聽！」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "聽眾的評語",
    "words": "「布武機，超可愛，布武機。」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "嗚哇～ｗ",
    "voice": "vo_adv_5219005_012",
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "很多忠實粉絲留言嘛，謝囉～♡",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n怎麼看來看去全是些眼熟的名字啊～♡",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "我可是都有",
    "voice": "vo_adv_5219005_013",
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "好～好記住的喔？",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "竟然又跑來看我的台",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "──真的是群被虐狂耶♡",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "總之先來宣傳，",
    "voice": "vo_adv_5219005_014",
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n聽說這座島上有魔物大量出現，",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "所以我準備去討伐一下──♡",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "到時會直播",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "布武機大顯身手的模樣，",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "可要心懷感激地看唷♡",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "而且今天的企劃",
    "voice": "vo_adv_5219005_015",
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "其實我會和超級死黨的班比合作♡",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "不過即使宣布要合作，",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "畢竟也搭檔過不少次了……",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "是不是開始覺得",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "有點不夠新鮮啦？♡",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "所以呢，今天一整天，",
    "voice": "vo_adv_5219005_016",
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n我都會模仿最喜歡的班比來直播喔～♡",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "咦，",
    "voice": "vo_adv_5219005_017",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "布武機，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "妳要模仿班比？",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "而相對地，班比她也會模仿我唷～ｗ",
    "voice": "vo_adv_5219005_018",
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n敬請期待囉～ｗ",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "……咦！？",
    "voice": "vo_adv_5219005_019",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "好，",
    "voice": "vo_adv_5219005_020",
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "結束直播～♪",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "等等，",
    "voice": "vo_adv_5219005_021",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "布武機！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n班比可沒有打算",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n要模仿布武機呀！？",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "我說啊，",
    "voice": "vo_adv_5219005_022",
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "親愛的班比♡",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n妳應該沒忘吧？",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n我們可是",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "正在進行賭上哥哥的對決喔？ｗ",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "雖然現在是我稍微領先了，",
    "voice": "vo_adv_5219005_023",
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "但既然都要比，",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "果然還是把對手",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n徹底打個稀巴爛比較爽呀──？ｗ",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "也就是說，",
    "voice": "vo_adv_5219005_024",
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "我要來表演一下「可愛系的我♡」，",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n藉此把班比的粉絲通通搶過來囉──♡",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n……",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "不過這個點子，",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "其實對班比來說也是有好處的呀？",
    "voice": null,
