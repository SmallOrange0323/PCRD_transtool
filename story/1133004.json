  {
    "type": "dialogue",
    "name": "旁白",
    "words": "和七七香持續進行的美少女遊戲模擬約會\\n過了一陣子後──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "呼……",
    "voice": "vo_adv_1133004_000",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "總覺得",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "今天好累啊……",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "真想快點回到旅館打滾耍廢……",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "說的也是。",
    "voice": "vo_adv_1133004_001",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n早上去了活動，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "中午開始就一直在模擬美少女遊戲約會呢。",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "這樣玩一整天",
    "voice": "vo_adv_1133004_002",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "對七七香來說也是很吃力的……",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "行程再緊湊也該有個限度……",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "而且中途開始",
    "voice": "vo_adv_1133004_003",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我就太過在意你，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n到頭來",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "感覺是我被耍得團團轉……",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "真是的。",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "今天已經充分享受過假期了，",
    "voice": "vo_adv_1133004_004",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "往後幾天，我只要一直窩在房間裡",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "看看書",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "就能心滿意足了吧……",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "嗯，",
    "voice": "vo_adv_1133004_005",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "明天開始你也好好放鬆……",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "咦？",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "你怎麼突然在發光呀！？",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n模擬美少女遊戲約會也不會有這種事件呀！？",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "搞錯類型了吧！？",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "嗚呀──！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "background",
    "bg_id": "510350"
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "……………",
    "voice": "vo_adv_1133004_006",
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "沒有，",
    "voice": "vo_adv_1133004_007",
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我也才剛到☆",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "……你以為我會這樣回答你嗎？",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "這個愚昧之徒──！！",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "居然在活動當天遲到，",
    "voice": "vo_adv_1133004_008",
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "你在搞什麼呀！？",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n今天可是關鍵的決戰時刻耶，",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "太輕敵了吧！",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "沒有把Cosplay的服裝交給你",
    "voice": "vo_adv_1133004_009",
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "是明智的選擇。",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n遲到還忘記帶道具的話，",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "可不是鬧著玩的啊。",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "……啊，",
    "voice": "vo_adv_1133004_010",
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "都到最後入場時間了！",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n快快快，動作快點！",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "不快點的話，我們就只能排隊一般入場了～！",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "background",
    "bg_id": "510270"
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "呼，",
    "voice": "vo_adv_1133004_011",
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "總算是趕上了……",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "安全上壘。",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "沒什麼時間了，",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "快點換衣服吧。",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "來，",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "你的服裝！",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "咦？",
    "voice": "vo_adv_1133004_012",
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我沒跟你說嗎？",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "鏘鏘鏘～！",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "神滅的巴哈姆提亞☆",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "如果是你也熟悉的作品，",
    "voice": "vo_adv_1133004_013",
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "Cosplay起來會更開心吧？",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "唔，",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "雖然和我們在「那邊」見面時",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "穿的服裝差不多啦。",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "啊，",
    "voice": "vo_adv_1133004_014",
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我可是精心挑選過布料，",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "夏天穿起來也是很涼快的！",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n就算披著斗篷也不會熱，",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "透氣度超群呦☆",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "衣服換好以後",
    "voice": "vo_adv_1133004_015",
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "就在這裡集合喔。",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n然後",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我們再一起出發",
