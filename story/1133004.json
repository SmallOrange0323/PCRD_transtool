    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "不過，",
    "voice": "vo_adv_1133004_028",
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我更想和你經歷各式各樣的體驗。",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n所以",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "根本沒有心思去想害不害羞的事！",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "透過這次活動，",
    "voice": "vo_adv_1133004_029",
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "你也能夠理解Cosplay的魅力了吧？",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n下次我會準備別套服裝的，",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我們再一起Cosplay吧！",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "作為重要的夥伴，",
    "voice": "vo_adv_1133004_030",
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "今天也要請你多多關照啦～！",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "background",
    "bg_id": "500890"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好，",
    "voice": "vo_adv_1133004_031",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "辛苦囉。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "是一場快樂的美夢吧？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n雖然不曉得你們醒來以後，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "還會記得多少。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "雖然七七香是個宅到骨子裡的女孩子，",
    "voice": "vo_adv_1133004_032",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n但卻不是那種以自我為中心",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "自顧自地滿足的人。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "因為你願意理解她的興趣，",
    "voice": "vo_adv_1133004_033",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "所以她想和你共享她喜愛的事物。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n不是單方面的灌輸，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "而是兩個人一起享受樂趣，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "或許這就是關鍵？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "行動時也會想著要和你分享喜悅，",
    "voice": "vo_adv_1133004_034",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這就是她可愛的地方呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n今後你也繼續和七七香一起",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "體驗更多有趣的事吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "501030"
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "呼啊……",
    "voice": "vo_adv_1133004_035",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "奇怪，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我睡著了！？",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n我只是玩了一整天，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "有累到這種程度嗎……",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "睡著的時候，",
    "voice": "vo_adv_1133004_036",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我好像作了個",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "奇怪的夢。",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n我夢到自己和你",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "去參加蘭德索爾的活動。",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "……咦？",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "你也做了同樣的夢？",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "對呀。",
    "voice": "vo_adv_1133004_037",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "感覺",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "作完那種夢之後，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "不趁現在多享受一點好像就虧大了！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "雖然",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我剛剛才說了",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "想好好放鬆一下……",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "不過，",
    "voice": "vo_adv_1133004_038",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我們還是去四處晃晃吧。",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "難得來度假，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我想和你",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "一起玩個痛快！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "七七香帶著和夢裡同樣的表情，\\n朝{0}露出了笑容──",
