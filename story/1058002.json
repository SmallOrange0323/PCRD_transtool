    "name": "貪吃佩可",
    "words": "料理的入門，",
    "voice": "vo_adv_1058002_053",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n就讓我來教{0}吧～♪",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嘻嘻。",
    "voice": "vo_adv_1058002_054",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n像這樣並肩做料理，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好像新婚夫婦喔♪",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嗚哇？",
    "voice": "vo_adv_1058002_055",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n{0}，停下來！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
