  {
    "type": "dialogue",
    "name": "旁白",
    "words": "史上最大規模的團體露營結束後數日──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n碧和{0}再次來到了露營區。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "果然…………",
    "voice": "vo_adv_1221004_000",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "營火……",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "真的很棒呢。",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "……呵呵。",
    "voice": "vo_adv_1221004_001",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "啊，",
    "voice": "vo_adv_1221004_002",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "不好意思。",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "因為很久沒有機會",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這麼悠閒了……",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "應該說……",
    "voice": "vo_adv_1221004_003",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "仔細想起來，",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這還是第一次呢。",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n和你就兩個人一起露營。",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "畢竟上次",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "一個不小心就變成多人露營了。",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "不知道為什麼，這反倒讓我嚇了一跳。",
    "voice": "vo_adv_1221004_004",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "因為有BB團活動的關係，",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "該說是沒有那種陌生的感覺嗎。",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "…………",
    "voice": "vo_adv_1221004_005",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "一旦在意起來",
    "voice": "vo_adv_1221004_006",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "就有種難以言喻的心情呢，",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "啊哈哈。",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那、",
    "voice": "vo_adv_1221004_007",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那個……",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "牛奶怎麼還不快點變熱呀～？",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "好想在氣溫變冷前喝到熱巧克力哦～",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "……呃，",
    "voice": "vo_adv_1221004_008",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "怪了？",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n感覺營火突然變旺了……",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "哇哇哇，",
    "voice": "vo_adv_1221004_009",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "眼睛都睜不開啦～！！",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "background",
    "bg_id": "510390"
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我跟你說哦，{0}。",
    "voice": "vo_adv_1221004_010",
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "察覺到了一件非常驚人的事……！",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這在BB團的活動中",
    "voice": "vo_adv_1221004_011",
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "也稱得上是最大發現！",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n以哥白尼般的想像力來形容也不為過……",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我是這麼覺得的！",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "聽我說明一下！",
    "voice": "vo_adv_1221004_012",
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我們一直以來，",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n都是自己主動出擊交朋友的。",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "也就是",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "地動說。",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "然後這次呢！",
    "voice": "vo_adv_1221004_013",
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我想提議的",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "和之前完全相反……",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "沒錯！",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "是讓朋友預備軍主動到來的想法！",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "提供待起來身心舒暢的地方，",
    "voice": "vo_adv_1221004_014",
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n讓對方滋生出想交朋友的情緒……",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n也就是",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "天動說。",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "哎呀，",
    "voice": "vo_adv_1221004_015",
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "可別吐槽我搞錯了學說之類的哦！",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這是心態問題！",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "以逆向思考來說，",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我想哥白尼也會不得不同意的！",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "所以說……",
    "voice": "vo_adv_1221004_016",
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "讓我們來建設吧！",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那還用說嗎！",
    "voice": "vo_adv_1221004_017",
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "由邊緣的",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "邊緣人",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "為邊緣人而建設的樂園……！",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "歡迎朋友預備軍到來的場所！",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "就是這樣！",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我就知道",
    "voice": "vo_adv_1221004_018",
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "你一定會這麼說！",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那麼就馬上來",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "建設樂園……",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "是很想這麼做沒錯，",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "不過現在不只沒道具，什麼都沒準備呢。",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "總之",
    "voice": "vo_adv_1221004_019",
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "今天就先整理構想吧。",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那麼明天",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "再集合！",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "background",
    "bg_id": "510390"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "隔天──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "啦啦嚕啦～♪",
    "voice": "vo_adv_1221004_020",
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n很好，",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "看板完工了！",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "啊，{0}！",
    "voice": "vo_adv_1221004_021",
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "早安！",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "因為要建造邊緣人的樂園嘛！",
    "voice": "vo_adv_1221004_022",
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "當然要卯足全力啊！",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "有帳篷和桌子，",
    "voice": "vo_adv_1221004_023",
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "座椅……",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "再加上吊床！",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n為了方便隨地躺下休息我還帶了墊子來！",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "另外還有些",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "能拿來加工用的材料！",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "順帶一提，",
    "voice": "vo_adv_1221004_024",
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "露營道具是爸爸借給我的。",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我爸爸的",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "興趣是露營……",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n拜他之賜讓我對戶外活動多少有些了解。",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "呃，",
    "voice": "vo_adv_1221004_025",
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這些事一點都不重要對吧。",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "現在得盡快建設起「邊緣人王國」才行！",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "沒錯！",
    "voice": "vo_adv_1221004_026",
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n這樣的話第一次到來的人也能一眼就理解！",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "昨天",
    "voice": null,
    "unit_id": 104032
  },
  {
    "type": "dialogue",
