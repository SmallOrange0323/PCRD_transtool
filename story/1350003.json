    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "對吧？",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "嗯……",
    "voice": "vo_adv_1350003_018",
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "因為我在過去的「紀錄」裡看了好幾次。",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "但是，",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我還是第一次像這樣親眼看到。",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "still",
    "still_id": "135000302"
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "那個，",
    "voice": "vo_adv_1350003_019",
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "騎士先生。",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n這些光呀，",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "每一顆",
