    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "都是一隻微小的生物喔。",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n牠們是受到刺激就會發光，",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "非常微小的存在。",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "你看……",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "騎士先生，",
    "voice": "vo_adv_1350003_020",
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "來摸摸看吧？",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n閃閃發光著……",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "很漂亮喔。",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "呵呵……",
    "voice": "vo_adv_1350003_021",
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n波浪很癢呢……",
