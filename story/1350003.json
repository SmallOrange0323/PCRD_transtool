  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "從打西瓜開始，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n厄莉絲跟{0}盡情享受了夏天的海邊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "結果，",
    "voice": "vo_adv_1350003_000",
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "美空在那之後都沒有現身──",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……她",
    "voice": "vo_adv_1350003_001",
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "可能會裝作如此。",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "之後出乎意料地來嚇我們。",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n畢竟美空似乎偏好採取那種行動。",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……如果突然被嚇到，",
    "voice": "vo_adv_1350003_002",
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "露出了奇怪的表情……",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "唯獨被騎士先生",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "看到奇怪表情的這種情況，",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "絕對要避免。",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "沒",
    "voice": "vo_adv_1350003_003",
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "有，",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "什麼都沒有喔。",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n雖然有稍微在意的事，",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "但是已經沒關係了。",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……現在就別想了。",
    "voice": "vo_adv_1350003_004",
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "這個地方，",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "有騎士先生在。",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我正跟騎士先生",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "一起度過夏天。",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "應該專注於這件事上。",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "已經",
    "voice": "vo_adv_1350003_005",
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "要日落了呢。",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n被騎士先生邀請來到海邊……",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "真的很開心。",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "開心的時間，",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "過得很快呢。",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "在看著輪迴的時間，",
    "voice": "vo_adv_1350003_006",
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "明明讓我感到那麼漫長。",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n……",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "真不可思議。",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n這就是",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "所謂的忘了時間嗎……？　",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "要是今天，",
    "voice": "vo_adv_1350003_007",
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "還不要結束就好了。",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "那樣的話，",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "就還能──",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "你說走，",
    "voice": "vo_adv_1350003_008",
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "是要去哪……？",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "background",
    "bg_id": "501033"
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "…………\\n……………………",
    "voice": "vo_adv_1350003_009",
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "騎士先生的手。",
    "voice": "vo_adv_1350003_010",
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "好大……",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n沒想到能像這樣",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "跟他牽手。",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "明明已經日落，",
    "voice": "vo_adv_1350003_011",
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "沒有了白天的艷陽照射，",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n跟騎士先生牽在一起的手，",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "卻熱得像是要被燙傷了。",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "明明很溫柔卻有力，",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "騎士先生的手。",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "永遠都不想放開……",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "沒有交談，",
    "voice": "vo_adv_1350003_012",
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "只是一起行走而已。",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n就感覺胸口深處像是被緊緊抓住一般。",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……這就是",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "美空所說的，",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "「心動★」",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "是嗎……？　",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "要是我能夠回握",
    "voice": "vo_adv_1350003_013",
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "這隻手就好了。",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "那樣的話，",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我就不會害怕。",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "就算不進行那樣丟臉的彩排，",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n也能傳達這份心意了。",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……如果能被允許，",
    "voice": "vo_adv_1350003_014",
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我想抱住這隻手。",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n抱住騎士先生、",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "抱住騎士先生的一切。",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "………………\\n………………………………",
    "voice": "vo_adv_1350003_015",
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "騎士先生，",
    "voice": "vo_adv_1350003_016",
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "你想讓我看的東西，",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "到底是什麼？",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "啊……",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "海岸邊在發光……",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "still",
    "still_id": "135000301"
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "發光的",
    "voice": "vo_adv_1350003_017",
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "海。",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "能在這個時期，",
    "voice": null,
    "unit_id": 135012
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "特定的潮汐條件下觀測到的現象……",
