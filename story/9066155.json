[
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "嗯，",
    "voice": "vo_adv_9066155_000",
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "野營跟",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "小飯糰的飯都準備好了♪",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "接下來我們",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "就在【美食殿堂】的大家回來之前",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "看好行李吧。",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "……",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "話雖這麼說。",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "嗯……",
    "voice": "vo_adv_9066155_001",
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "莉莉。",
    "voice": "vo_adv_9066155_002",
    "unit_id": 126113
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n在想事情。",
    "voice": null,
    "unit_id": 126113
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126113
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "哥的事。",
    "voice": null,
    "unit_id": 126113
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "啊……",
    "voice": "vo_adv_9066155_003",
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "妳、",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "妳怎麼知道的？",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "呵呵。",
    "voice": "vo_adv_9066155_004",
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n因為莉莉",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "今天也是一樣，",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n一直盯著哥哥看啊♪",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "那、",
    "voice": "vo_adv_9066155_005",
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "那種事……",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "雖然確實如此……",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "但我是……",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "在想如果要成為像兄長大人他們一樣的一流冒險者，",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n該做些什麼。",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "只是在重新思考這件事而已。",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "是這樣嗎？",
    "voice": "vo_adv_9066155_006",
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "那",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "也跟我們談談吧♪",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n畢竟集思廣益總是比較好嘛，",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "對吧？",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "要，",
    "voice": "vo_adv_9066155_007",
    "unit_id": 126113
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n怎麼做？",
    "voice": null,
    "unit_id": 126113
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "嗯……",
    "voice": "vo_adv_9066155_008",
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "經驗不足當然也是原因……",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我們轉換觀點來看好了。",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n例如",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "不是看我們【幻變少女】，",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n而是聚焦在【美食殿堂】的「特徵」如何？",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "兄長大人他們的",
    "voice": "vo_adv_9066155_009",
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "特徵……？",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "例如說",
    "voice": "vo_adv_9066155_010",
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "哥哥的「寬宏大量」之類的。",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "那應該是",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "對公會的氣氛造成巨大影響的原因……",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "對吧？",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n像這樣子把要素列出來，",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "搞不好就能發現什麼事。",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "原來如此……",
    "voice": "vo_adv_9066155_011",
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "說起來，",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "跟我們比起來，",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n【美食殿堂】的各位好像有更多的",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "「積極互動」。",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "那就是",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "他們能夠「泰然自若」的原因嗎？",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "「熱鬧」。",
    "voice": "vo_adv_9066155_012",
    "unit_id": 126113
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n「搞笑」。",
    "voice": null,
    "unit_id": 126113
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "「包容一切的母性」。",
    "voice": "vo_adv_9066155_013",
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n「蘭德索爾第一的權力」。",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n然後是，",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "呃……",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "「會突然失控」……？",
    "voice": null,
    "unit_id": 125813
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "「貓」。",
    "voice": "vo_adv_9066155_014",
    "unit_id": 126113
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n「傲嬌」。",
    "voice": null,
    "unit_id": 126113
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "呃，",
    "voice": "vo_adv_9066155_015",
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "雖然我覺得妳說的沒錯……",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "但要是被凱留小姐聽到的話，",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "她應該會生氣吧。",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n話說回來，",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "感覺內容好像越來越偏了……？",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "兔子。",
    "voice": "vo_adv_9066155_016",
    "unit_id": 126113
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "兔子……",
    "voice": "vo_adv_9066155_017",
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "有嗎？",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n【美食殿堂】有代表兔子的人嗎？",
    "voice": null,
    "unit_id": 126013
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "魔物。",
    "voice": "vo_adv_9066155_018",
    "unit_id": 126113
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n兔子的。",
    "voice": null,
    "unit_id": 126113
  },
  {
    "type": "dialogue",
    "name": "兩人",
    "words": "咦……？",
    "voice": "vo_adv_9066155_019",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "……………………",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "兩人",
    "words": "………………吞口水。",
    "voice": "vo_adv_9066155_020",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──吼喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "兩人",
    "words": "呀啊啊啊啊啊啊！？",
    "voice": "vo_adv_9066155_021",
    "unit_id": null
  }
]
