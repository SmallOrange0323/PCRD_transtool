    "type": "dialogue",
    "name": "３人",
    "words": "下一回，",
    "voice": "vo_adv_5015101_004",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "「將軍道中記　",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
