  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "憧憬的女忍者衣服……！",
    "voice": "vo_adv_5015101_000",
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n今天我的手裏劍",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "可是更上一層樓了喔！",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n……咻咻咻咻！！",
