    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "噗吉［千歌］",
    "words": "\\n",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "噗吉［千歌］",
    "words": "這種感覺，還真讓人開心。",
