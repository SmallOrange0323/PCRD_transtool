  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "對對對、對不起……",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n小千歌……小姐也是偶像呢，",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n我不能這樣隨便摸她對吧……？",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不是啦，",
    "voice": "vo_adv_5009005_038",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "沒關係沒關係，真的不要緊。",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "如果是{0}對千歌\\n那樣摸來摸去的話，我會採取應有的處置。",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不過對象是小胡桃嘛。",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "欸、欸嘿。",
    "voice": "vo_adv_5009005_039",
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "說到{0}哥哥……",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n感覺現在的千歌小姐",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n跟哥哥第一次到育幼院來時很像……",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "像個小孩子，",
    "voice": "vo_adv_5009005_040",
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "或者說像個嬰兒一樣……",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "對當時那樣子的{0}哥哥，",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n我和綾音總是一直照顧著，",
