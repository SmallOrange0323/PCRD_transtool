    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "噗吉［千歌］",
    "words": "\\n",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "噗吉［千歌］",
    "words": "我會在這裡，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "噗吉［千歌］",
    "words": "永遠陪著綾音喔。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "噗吉［千歌］",
    "words": "只要妳",
    "voice": "vo_adv_5009005_054",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "噗吉［千歌］",
    "words": "這樣希望的話。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "嗯！",
    "voice": "vo_adv_5009005_055",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我相信你，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我要永遠和噗吉在一起……☆",
