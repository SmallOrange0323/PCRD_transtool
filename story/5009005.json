    "voice": "vo_adv_5009005_032",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n育幼院除了我們以外還有很多小小孩，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n都是胡桃在照顧的喔。",
