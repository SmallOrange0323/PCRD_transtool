    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯……",
    "voice": "vo_adv_5009005_041",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "　這樣一說，還真的覺得",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n以前的{0}和現在的千歌很相似。",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "當時{0}失憶了，",
