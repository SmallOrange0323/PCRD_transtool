  },
  {
    "type": "dialogue",
    "name": "千歌［噗吉］",
    "words": "\\n",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌［噗吉］",
    "words": "本大爺也不想",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌［噗吉］",
    "words": "用這麼好聽的聲音說粗鄙的話啊。",
