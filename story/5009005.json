    "voice": "vo_adv_5009005_059",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "噗吉［千歌］",
    "words": "與其讓我講，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "噗吉［千歌］",
    "words": "不如讓她本人來說明比較快。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "噗吉［千歌］",
    "words": "\\n稍微交換一下喔。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "噗吉［千歌］",
    "words": "\\n",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "噗吉［千歌］",
    "words": "喂，千歌小姐，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "噗吉［千歌］",
    "words": "別害羞了，快點出來啊。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "噗吉［千歌］",
    "words": "妳讓人那麼擔心，",
    "voice": "vo_adv_5009005_060",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "噗吉［千歌］",
    "words": "快讓大家聽一下妳說話啊。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "對呀……",
    "voice": "vo_adv_5009005_061",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "說的沒錯，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "那個，噗吉先生。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "千歌？",
    "voice": "vo_adv_5009005_062",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "　是千歌嗎？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "太好了，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "妳恢復正常了嗎？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "唉……",
    "voice": "vo_adv_5009005_063",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "對不起，望，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "讓妳看到那麼丟臉的模樣……",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "啊啊，",
    "voice": "vo_adv_5009005_064",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我要怎麼辦啊？",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我竟然喊望媽媽，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "像剛那樣子……？",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯。",
    "voice": "vo_adv_5009005_065",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那不要緊的……",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "害羞什麼的先不管了，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n妳能說明一下事情的來龍去脈嗎？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我沒辦法不管！　",
    "voice": "vo_adv_5009005_066",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "啊啊，真是的，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我怎麼會做那種事……？",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "實在是害羞得沒辦法正眼看望了，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "從今以後還有什麼臉活下去……？",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嘿，",
    "voice": "vo_adv_5009005_067",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "偶像手刀☆",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "好痛！？",
    "voice": "vo_adv_5009005_068",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "望妳好過分，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "也用不著打人吧！",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "哎呀，抱歉。",
    "voice": "vo_adv_5009005_069",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "千歌雖然優點就是謹慎認真，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n不過一沮喪起來老是拖很久就是妳的缺點了。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "現在沒時間拖拖拉拉了，對吧？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "嗯……",
    "voice": "vo_adv_5009005_070",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n就是啊，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "望永遠是對的。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "才不是呢。",
    "voice": "vo_adv_5009005_071",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……總之千歌妳恢復正常實在太好了，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "真的。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "還不能放心。",
    "voice": "vo_adv_5009005_072",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "這只是暫時的，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n我只是藉由噗吉的力量暫時回復原狀而已。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "而且這很勉強，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "應該無法維持太久。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "在我還保持正常時，",
    "voice": "vo_adv_5009005_073",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "先把事情全部說明清楚……",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "說來慚愧，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "希望各位能幫我處理這個異狀。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "一切都起因於",
    "voice": "vo_adv_5009005_074",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "「記憶的大精靈霧奇」……",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n它是非常強又偉大，在眾多傳說中留下名號的知名精靈。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "各位知道嗎？",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不，",
    "voice": "vo_adv_5009005_075",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "名字是有聽過……",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "但我對精靈不太了解。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "這樣啊……",
    "voice": "vo_adv_5009005_076",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "　",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "嗯，說的也是。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n雖然它也是繪本上會有的題材。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "總之，",
    "voice": "vo_adv_5009005_077",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "「記憶的大精靈霧奇」",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n就跟他名字一樣，他擁有操控記憶的能力。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "可以讓人忘卻過去，",
    "voice": "vo_adv_5009005_078",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "或是植入新的記憶。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我聽說了那個消息後……",
    "voice": "vo_adv_5009005_079",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "實在很不好意思，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我本來是想說\\n希望能幫忙取回{0}喪失的記憶，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n所以去尋找「記憶的大精靈霧奇」。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "因為我是唱喚士。",
    "voice": "vo_adv_5009005_080",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "可以和精靈締結契約，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "借用它們的力量。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "或許能使喚「記憶的大精靈霧奇」，或是拜託它，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n讓{0}取回記憶之類的。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "千歌……",
    "voice": "vo_adv_5009005_081",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "原來是這樣，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "總算明白了。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n就是嘛，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "無論何時千歌都是為了他人盡心盡力的孩子啊。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "簡直是偶像的模範，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我以千歌為傲。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "才沒有，我才沒有那麼了不起……",
    "voice": "vo_adv_5009005_082",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n因為{0}對我很照顧，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n所以想要報恩罷了。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "而且，",
    "voice": "vo_adv_5009005_083",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "「記憶的大精靈霧奇」",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n其實比我想的還要危險，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "簡直就像是魔物一樣。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是個無法交涉",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "也無法用言語溝通的可怕怪物。",
    "voice": null,
    "unit_id": 108411
  }
]
