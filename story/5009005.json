[
  {
    "type": "background",
    "bg_id": "500115"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在那之後……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n大概唱了一小時後，望他們才稍作休息。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "哈啊，",
    "voice": "vo_adv_5009005_000",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "突然覺得累了。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "辛、辛苦了～",
    "voice": "vo_adv_5009005_001",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "不介意的話，請喝茶吧？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "謝謝妳～♪",
    "voice": "vo_adv_5009005_002",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n天氣一冷，喉嚨就很容易痛呢，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "正好想攝取水分真是幫了大忙！",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯，奇怪？",
    "voice": "vo_adv_5009005_003",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "綾音，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "妳打扮得好可愛呢？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "欸嘿嘿，",
    "voice": "vo_adv_5009005_004",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "可愛吧？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我想說要是聖誕節過了，這衣服就不能穿了，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n在育幼院時，就儘量穿著這件吧～！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "剛好有點時間，就去換上了。",
    "voice": "vo_adv_5009005_005",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "因為只有我一個人穿會很怪，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n就讓胡桃也一起穿上了。",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "很適合吧～？",
    "voice": "vo_adv_5009005_006",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n這衣服是鈴莓為了聖誕派對而製作的！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "鈴莓雖然冒冒失失的，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "但除了煮飯以外都很厲害喔！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "噗吉要是破掉了，",
    "voice": "vo_adv_5009005_007",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "還會幫我縫好♪",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這樣啊～",
    "voice": "vo_adv_5009005_008",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "【慈樂之音】裡也有很會縫紉的夥伴喔，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n她叫做紡希。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n老是在縫衣服或是別的東西。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "紡希？　",
    "voice": "vo_adv_5009005_009",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "那個名字，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n是不是就是剛才寄東西來育幼院的人呢？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "裡面放著那位叫千歌的人的換洗衣物！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "那位叫千歌的人的衣服都又髒又破了呢……",
    "voice": "vo_adv_5009005_010",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "剛才胡桃很高興的讓她換上了，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "那個也是聖誕節的衣服吧？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嘿……",
    "voice": "vo_adv_5009005_011",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不愧是紡希，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "還真是細心呢。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "工作都交給她一個人應付，明明很辛苦，",
    "voice": "vo_adv_5009005_012",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "一有空閒時間，還能照顧到我們啊？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "連我都慌慌張張地，",
    "voice": "vo_adv_5009005_013",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n沒辦法用通訊魔法好好說明事情經過……",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "真厲害啊，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "就算不當偶像，改做經紀人也能有一番成就也說不定。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "欸嘿嘿。",
    "voice": "vo_adv_5009005_014",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n小望……姐姐，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "好像很開心。",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "妳很珍惜夥伴呢。",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那當然。",
    "voice": "vo_adv_5009005_015",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "因為我們是同一個團體啊",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "是命運共同體呢。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n是重要的夥伴，也是家人。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "大概就像綾音的噗吉一樣吧……",
    "voice": "vo_adv_5009005_016",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "剛才對妳說了很過分的話，對不起喔，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我說它是玩偶什麼的。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "沒關係。",
    "voice": "vo_adv_5009005_017",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "妳會那樣想也是正常的，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n我也不是小孩子了，可以了解。",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "大概，奇怪的人是我才對。",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "會和玩偶說話的我才是怪人……",
    "voice": "vo_adv_5009005_018",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "可是我可以聽到噗吉的聲音，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "是真的喔。",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "雖然現在",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "變得無法和噗吉說話了。",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "究竟是為什麼呢……",
    "voice": "vo_adv_5009005_019",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n這個時間點也不能說完全沒關聯，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "還是說那也是「記憶的大精靈霧奇」搞的鬼？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "到底是何方神聖呢，",
    "voice": "vo_adv_5009005_020",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "那個叫霧奇的？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我不知道……",
    "voice": "vo_adv_5009005_021",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n如果千歌精神狀態正常的話應該能說明，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "可是她現在退化成幼兒了。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "好，",
    "voice": "vo_adv_5009005_022",
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "接下來輪到千歌了……♪",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "嗯，",
    "voice": "vo_adv_5009005_023",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "嗯嗯～？",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是哪一張呢？",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "哪一張不是鬼牌呢～？",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "欸嘿，",
    "voice": "vo_adv_5009005_024",
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "是哪一張啊？",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "這張！",
    "voice": "vo_adv_5009005_025",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "哇，",
    "voice": "vo_adv_5009005_026",
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "千歌妳好厲害！",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "好會玩抽鬼牌，",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "漂亮地避開了鬼牌……！",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "欸嘿嘿♪",
    "voice": "vo_adv_5009005_027",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "很厲害吧～？",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "嗯♪",
    "voice": "vo_adv_5009005_028",
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n那接下來，",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "用接龍決勝負吧……！",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "千歌才不會輸呢……",
    "voice": "vo_adv_5009005_029",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "欸嘿嘿♪",
    "voice": null,
    "unit_id": 108411
  },
  {
