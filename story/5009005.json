  },
  {
    "type": "dialogue",
    "name": "噗吉［千歌］",
    "words": "\\n",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "噗吉［千歌］",
    "words": "不過老實說連我自己",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "噗吉［千歌］",
    "words": "\\n也不知道為什麼事情會變成這樣。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "噗吉［千歌］",
    "words": "在這個身體裡，",
