    "bg_id": "500115"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "千歌［噗吉］",
    "words": "……不需要思考喔，",
    "voice": "vo_adv_5009005_043",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌［噗吉］",
    "words": "偶像小姐。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "噫呀？",
    "voice": "vo_adv_5009005_044",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "　咦，剛才那是千歌？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "為什麼用那種粗魯的語氣說話，",
