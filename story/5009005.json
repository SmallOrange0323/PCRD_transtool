    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌［噗吉］",
    "words": "就饒了我吧。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "咦？",
    "voice": "vo_adv_5009005_047",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n那……那個，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "難道說你是……",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "噗吉？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "你是噗吉吧？",
    "voice": "vo_adv_5009005_048",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n我常常跟你說話，所以聽得出來！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "那個說話方式，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "絕對是噗吉！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "噗吉［千歌］",
    "words": "喔，果然綾音就是懂我啊。",
