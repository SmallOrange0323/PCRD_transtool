  },
  {
    "type": "dialogue",
    "name": "噗吉［千歌］",
    "words": "有著那個叫千歌的小姐的心。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "噗吉［千歌］",
    "words": "\\n我和那傢伙聊了一會，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "噗吉［千歌］",
    "words": "大致掌握了情況。",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "噗吉［千歌］",
