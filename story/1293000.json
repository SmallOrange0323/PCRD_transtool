[
  {
    "type": "background",
    "bg_id": "500520"
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "続・",
    "voice": "vo_adv_1164001_000",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "研究レポート",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "『世界に連なる高次よりの耳目』。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "あるいは",
    "voice": "vo_adv_1164001_001",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "『決してサボってたわけではないユニちゃんの言い分』。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "前略、",
    "voice": "vo_adv_1164001_002",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "聖テレサ女学院学生課担当者殿。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n筆者は先般、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "教務主任マザー・ヒルダを通じて、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n学院より以下の旨を要請された。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "background",
    "bg_id": "500750"
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "数日後に開催を控えた文武の祭典",
    "voice": "vo_adv_1164001_003",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "『聖学祭』において、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\nユニ博士は日頃の学習成果を発表されたし──",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "との由。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "言うまでもなく、",
    "voice": "vo_adv_1164001_004",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "当学最大の年間行事『聖学祭』には、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n生徒の父兄や地域住民のみならず",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n多数の教育関係者や出資者・",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "後援者も列席する。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "それら権力者たちに対し、",
    "voice": "vo_adv_1164001_005",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\nこの聖テレサ女学院が",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\nいかに優秀な生徒を輩出する教育機関であるか示せということだろう。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "端的に換言すれば、",
    "voice": "vo_adv_1164001_006",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "当学は見栄っ張りなのである。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n筆者を見下ろす教務主任マザー・ヒルダの眼鏡の奥の眼光が、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n「たまには役に立て、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "穀潰しの不良優等生が」",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "と暗に告げていた。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "これに対し、",
    "voice": "vo_adv_1164001_007",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n筆者の口をついて出た咄嗟の回答は",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "「え無理」の三文字だったが、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\nマザーはそれを容易に諒としなかった。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "貴様は授業にも出ず",
    "voice": "vo_adv_1164001_008",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "図書館棟に籠って今日まで何をしてきた？",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\nよもや日がな一日",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ぐうぐう眠り散らかしていたわけではあるまいな？",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n──彼女のランドソルスナギツネのごとき目がそう告げていた。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "よって以下は、",
    "voice": "vo_adv_1164001_009",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "筆者にかけられた嫌疑を晴らすべく、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\nこれまでの活動経過および付随する陳情を",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ここに記すものである。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "background",
    "bg_id": "500520"
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "『世界にわだかまる根源的な虚構』。",
    "voice": "vo_adv_1164001_010",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "かつて筆者が取り組んだとされるその研究課題は、",
    "voice": "vo_adv_1164001_011",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n学会に提出するやたちまち大いに嘲笑された。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "そして筆者自身は",
    "voice": "vo_adv_1164001_012",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n学術的仮説と誇大妄想を履きちがえた莫迦者との誹りを受け、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n当該研究は綺麗さっぱり「なかったこと」にされた──。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "──らしい。",
    "voice": "vo_adv_1164001_013",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "正直よく覚えてない。",
    "voice": "vo_adv_1164001_014",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "我々の脳には、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "精神的外傷となり得る忌まわしい記憶を",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n都合よく忘れる",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "防衛機能が備わっているらしいので、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "たぶんそれ。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "というか、",
    "voice": "vo_adv_1164001_015",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "まあ、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "正直なんでもいい。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "とにかく筆者の身にかかる事情は、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "容易に言語化できるものではない。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "瞼を撫でる朝の陽光が。",
    "voice": "vo_adv_1164001_016",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n血を躍らせる夜の高揚が。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n世界のあらゆる事物事象が、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "筆者の思考を穏やかに妨害するのである。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "端的に換言すれば、",
    "voice": "vo_adv_1164001_017",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "考えるのめんどくさくなる。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "それが筆者生来の気質に由来するものじゃねえのと言われれば、",
    "voice": "vo_adv_1164001_018",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\nああ、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "うん、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "もともと筆者そういうとこあるしね？",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\nと曖昧に濁さなければならないのが",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "我ながら遺憾ではある。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "本来ならば、",
    "voice": "vo_adv_1164001_019",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\nこれは筆者が何らかの認識阻害を被ったとも考えられるわけだが、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n案の定というか、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "本邦の有識者たちはその説に耳すら貸さなかった。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "思考停止の誘惑に囚われない真なる識者の一人もいれば、",
    "voice": "vo_adv_1164001_020",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\nあるいは筆者の研究も今とは異なる結果を招いたかもしれない。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "だが、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "しかし、そうはならなかった。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "どうでもいい。",
    "voice": "vo_adv_1164001_021",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\nぼくの話なんて、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "どうせ誰もまともに聞きやしないんだ。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "background",
    "bg_id": "500960"
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "当学院の図書館棟──",
    "voice": "vo_adv_1164001_022",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "通称『象牙の塔』には、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\nきわめて歴史的資料価値の高い文献や古文書が数多ある。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n端的に換言すれば、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "宝の山だ。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "だが不思議なことに、",
    "voice": "vo_adv_1164001_023",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "いかなる学者も識者もそれらに興味を示さない。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\nあたかも興味を示すこと自体が禁じられているかのように。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "閑話休題。",
    "voice": "vo_adv_1164001_024",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\nそれらの書の中には、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n神話とも御伽噺ともつかない荒唐無稽な物語もあった。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "例えるならそれは、",
    "voice": "vo_adv_1164001_025",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n別なる地平より訪れし異界人たちの活動記録であった。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\nあるいは、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "そうした異界人同士の交信記録であった。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ここで筆者は、",
    "voice": "vo_adv_1164001_026",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "莫迦者らしく一つの馬鹿げた仮説を立ててみる。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\nもしもそれらの荒唐無稽な冒険譚が『真理』だとした場合──。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "この世界は、",
    "voice": "vo_adv_1164001_027",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n我々と地平を異にする高次な存在が創造したある種の箱庭であり──。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "そしてここに息吹く我々もまた、",
    "voice": "vo_adv_1164001_028",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\nそうした高次存在に連なる系譜であり──。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "つまり、",
    "voice": "vo_adv_1164001_029",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ぶっちゃけ換言すれば、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "我々は──。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "我々は──",
    "voice": "vo_adv_1164001_030",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "あれ、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "なんだっけ？",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "まあいいや。",
    "voice": "vo_adv_1164001_031",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "めんどくさい。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "background",
    "bg_id": "500520"
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "筆者はいわゆるところのメモ魔だ。",
    "voice": "vo_adv_1164001_032",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n日常の中に得た学びや気付きを、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n大なり小なり徒然なるままに記録している。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "そして我が外部記憶たりうるメモ帳の、",
    "voice": "vo_adv_1164001_033",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n幾ばくか破り捨てられた項の下にはこう記してある。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "『惰眠を貪れ　",
    "voice": "vo_adv_1164001_034",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "余生を愉しめ』",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "『示談は成立せり　",
    "voice": "vo_adv_1164001_035",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "我こそは勝者』",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "その筆跡は、",
    "voice": "vo_adv_1164001_036",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "疑いなく筆者自身のものである。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n要領を得ない筆致は、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "さながら検閲逃れの暗号のようだ。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "それはきっと、",
    "voice": "vo_adv_1164001_037",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "いつかのぼくがぼくへ遺した、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n賢明なる脅し──",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "あるいは懸命なる祈りだ。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "是非もなし。",
    "voice": "vo_adv_1164001_038",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\nすでに勝利しているなら、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "残りの日々は消化試合だ。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "遺言に従い、",
    "voice": "vo_adv_1164001_039",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "衆愚に倣い、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n欺瞞を孕んだ世界で",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "せいぜいお気楽な余生を愉しもう。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "この閉じられた箱庭の中で、",
    "voice": "vo_adv_1164001_040",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\nいち早く自身の頬を抓ったぼくは幸いだ。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n夢にあって夢が夢だと気付けたのだから。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "いいとも世界、",
    "voice": "vo_adv_1164001_041",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "折り合いをつけてやる。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\nぼくの学びは他へ向けよう。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "この長閑な明晰夢を",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "せいぜい愉快に泳がせてもらう。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "だからおまえは勝手に閉じてろ。",
    "voice": "vo_adv_1164001_042",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\nぼくはおまえの掌の上で、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "いつか夢見た青春活劇を勝手に続ける。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\nそれで文句はないんだろう？",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "くそったれが。",
    "voice": "vo_adv_1164001_043",
    "unit_id": 116411
  },
  {
    "type": "background",
    "bg_id": "500730"
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "──前略、",
    "voice": "vo_adv_1164001_044",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "学院どの。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n以上の理由を以って、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "筆者は『聖学祭』",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "学芸展示への論文提出を",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n全面的に見送らせていただくものとする。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "叫んだところで、",
    "voice": "vo_adv_1164001_045",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "どうせ誰にも届かないんだ。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "still",
    "still_id": "506400201"
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "追伸。",
    "voice": "vo_adv_1164001_046",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\nむろん学院に籍を置く者の義務として、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n当該展示には別の形で参加させていただくので",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "どうか安心されたし。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "新進気鋭の芸術家",
    "voice": "vo_adv_1164001_047",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "・ユニ博士の意欲作にご期待ください。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "かしこ。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ＯＫロゼッタ、",
    "voice": "vo_adv_1164001_048",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "世界は今日も閉じているかい？",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "この空のずっと向こうには",
    "voice": "vo_adv_1164001_049",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "何があるのだろうな？",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ぼくの得た学びに、",
    "voice": "vo_adv_1164001_050",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "果たして意味はあったのだろうか？",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "なあロゼッタ、",
    "voice": "vo_adv_1164001_051",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ぼくの声は届いているか？",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ロゼッタ",
    "words": "ぽーん！",
    "voice": "vo_adv_1164001_052",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ロゼッタ",
    "words": "\\nお探しの回答が見つかりません！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ロゼッタ",
    "words": "\\n仮想自我に対するコマンドは明瞭にお願いいたします！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ふむ、",
    "voice": "vo_adv_1164001_053",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "少々ポエムが過ぎたか……",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "よかろう、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "では質問を変える。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\nＯＫロゼッタ、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ぼくはまだ馬鹿と呼ばれているか？",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ロゼッタ",
    "words": "エゴサーチは",
    "voice": "vo_adv_1164001_054",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ロゼッタ",
    "words": "精神の健康を損なう恐れがあります！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ロゼッタ",
    "words": "\\n世論の吸い過ぎにご注意ください！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "真実は必ずしも幸福を担保しない──",
    "voice": "vo_adv_1164001_055",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "なるほど、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "知らぬが華ということか。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "しかし君、",
    "voice": "vo_adv_1164001_056",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "もっと主人に対する言葉を選びたまえよ。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "知りたいのは要するに、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\nぼくの選択は正しかったのかということだ。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ロゼッタ",
    "words": "ぽーん！",
    "voice": "vo_adv_1164001_057",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ロゼッタ",
    "words": "\\n「正しい」の定義が曖昧です！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ロゼッタ",
    "words": "\\n正義も正当も主観次第と、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ロゼッタ",
    "words": "以前ドクター・ユニが言っていました！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ああ言えばこう言う。",
    "voice": "vo_adv_1164001_058",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "反抗的な飼い石だ。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\nやれやれ、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "いったい誰に似たのやら。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ＯＫロゼッタ、",
    "voice": "vo_adv_1164001_059",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "すべてを白か黒かに区分しようなどとは考えるな。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\nそんな二元論は、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "魂が理系に堕ちるぞ。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "肝要なるはグラデーションだ。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "行間を愛せ、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "世界は曖昧でいいんだ。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "端的に換言すれば、",
    "voice": "vo_adv_1164001_060",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "もっとぼくを甘やかそう。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ロゼッタ",
    "words": "では、",
    "voice": "vo_adv_1164001_061",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ロゼッタ",
    "words": "曖昧機能ＯＮで回答します！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ロゼッタ",
    "words": "\\n近ごろのドクター・ユニは",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ロゼッタ",
    "words": "毎日楽しそうなので、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ロゼッタ",
    "words": "たぶん大丈夫です！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "いい子だ、",
    "voice": "vo_adv_1164001_062",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "そういう言葉を待っていた。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ＯＫロゼッタ。",
    "voice": "vo_adv_1164001_063",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n先ほどの戯れ言は、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "むろん学院に提出するべくもない。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n跡形もなく破棄しておいてくれたまえ。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "……えっ？",
    "voice": "vo_adv_1164001_064",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\nところで大丈夫って何？",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\nユニちゃん世間にどう言われてるの？",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "おや、",
    "voice": "vo_adv_1164001_065",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "誰か来たようだよロゼッタ。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ロゼッタ",
    "words": "ぽーん！",
    "voice": "vo_adv_1164001_066",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ロゼッタ",
    "words": "\\nごきげんよう、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ロゼッタ",
    "words": "ミスター「同志」！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ああ、",
    "voice": "vo_adv_1164001_067",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "{0}君か。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n憩いの仮眠所へようこそ、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "驚かせて済まないね。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ぼくはご存知、",
    "voice": "vo_adv_1164001_068",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "象牙の塔のユニ。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\nこっちは喋る石のロゼッタを",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "人型の素体に乗せてみたものだ。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "いまだ試験段階ゆえ",
    "voice": "vo_adv_1164001_069",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "複雑な動作はさせられないが、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n素体にはぼくに似せた幻影テクスチャーを貼ってある。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "どうだ、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "傍目にはまるで双子の美人姉妹だろう。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "そ、",
    "voice": "vo_adv_1164001_070",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "そうか……",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "まったくか……",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "いや、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "自分で言っておいて何だが、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n君の目",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ちょっと節穴が過ぎないかね……",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ロゼッタ",
    "words": "「似てる」の定義は主観次第です！",
    "voice": "vo_adv_1164001_071",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ロゼッタ",
    "words": "\\n個人の感想につき、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ロゼッタ",
    "words": "真に受けなくて大丈夫です！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "まあ、",
    "voice": "vo_adv_1164001_072",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "人型ロゼッタの本運用は数年先になるゆえ、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n擬体には多少の成長見込みを加味してある。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "身内にも区別がつかないほど酷似させてしまうと、",
    "voice": "vo_adv_1164001_073",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\nクロエ君やチエル君あたりに色々悪用されかねんしな。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "似てそうで似てない、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "でもちょっと似てる絶妙なラインを狙った。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ロゼッタ",
    "words": "「絶妙」の定義は主観次第です！　",
    "voice": "vo_adv_1164001_074",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ロゼッタ",
    "words": "言ったもん勝ちです！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500970"
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "……さて、",
    "voice": "vo_adv_1164001_075",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "休憩という名の現実逃避は終わりだ。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\nロゼッタ、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ぼちぼち自律運動回路の調整を始めるとしよう。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "うん？　",
    "voice": "vo_adv_1164001_076",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "なんだね同志、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "その意外そうな顔は。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\nよもやぼくがクロエ君の猛特訓から逃げて、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\nただ飼い石を膝枕に惰眠を貪っていたとでも？",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ロゼッタ",
    "words": "正解です！　",
    "voice": "vo_adv_1164001_077",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ロゼッタ",
    "words": "逃れようもない真実です！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "馬鹿を言うんじゃあない。",
    "voice": "vo_adv_1164001_078",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n外側からはそう見えたかもしれんが、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n内実ぼくは回路調整のための思考実験に耽っていたのだ。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ふむ、",
    "voice": "vo_adv_1164001_079",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "分からんかね。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\nロゼッタには聖学祭でぼくの影武者をさせるつもりなのさ。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "何故だと？",
    "voice": "vo_adv_1164001_080",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "君とて生徒会長の話は聞いていただろう、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n来たる『聖学祭』には",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "我々ユニちゃんズの命運がかかっているのだ。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ロゼッタ",
    "words": "そうですね！",
    "voice": "vo_adv_1164001_081",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ロゼッタ",
    "words": "\\n我々なかよし部の命運がかかっていますね！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ゆえに、",
    "voice": "vo_adv_1164001_082",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "負けられない戦いがそこにはある。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "陸に上がったイルカよりも遅いと評判のユニ博士が、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "熾烈な運動競技にしゃしゃり出るわけにはゆかんのだ。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ユニちゃんズはぼくが守る！",
    "voice": "vo_adv_1164001_083",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\nこの夢のような青春活劇は、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\nたとえどんな手を使ってでも終わらせないぞ！",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ロゼッタ",
    "words": "後ろ向きに前向き！",
    "voice": "vo_adv_1164001_084",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ロゼッタ",
    "words": "\\nドクター",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ロゼッタ",
    "words": "かっこいい！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "よせやい、",
    "voice": "vo_adv_1164001_085",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "照れるぜ。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "さあ、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "君にも手伝ってもらうぞ",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "共同研究者。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ん？　",
    "voice": "vo_adv_1164001_086",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "おい、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "どうした{0}後輩。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n何をきょろきょろと左右を見回している。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n他の誰でもない、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "君に協力を仰いでいるのだ",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "共同研究者。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "承知している。",
    "voice": "vo_adv_1164001_087",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\nだから何だね。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n君に求めるのは知識でも技術でもない。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "以前、",
    "voice": "vo_adv_1164001_088",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "言ったはずだぞ。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n君はただ傍にいて",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ぼくの話を聞いてくれるだけでいいんだ。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ぼくの学びは、",
    "voice": "vo_adv_1164001_089",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ぼくの為のものだ。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n元より誰かに伝える意図も野心もありはしない。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "……だけどね？",
    "voice": "vo_adv_1164001_090",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "もし誰か",
    "voice": "vo_adv_1164001_091",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "一人でも耳を傾けてくれる味方がいてくれるなら──。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ただそれだけで、",
    "voice": "vo_adv_1164001_092",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ぼくの学びも報われる気がするんだよ。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "感謝してる。",
    "voice": "vo_adv_1164001_093",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\nいつもありがとう。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "{0}には",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "\\nユニが何を言っているのかよく分からなかったが、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "\\nそれでもユニがうれしそうなのは分かったので共に微笑むのだった。",
    "voice": null,
    "unit_id": null
  }
]
