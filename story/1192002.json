    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "但我",
    "voice": null,
    "unit_id": 119211
  },
