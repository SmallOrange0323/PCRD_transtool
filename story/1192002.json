  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在聖誕節即將來臨的牧場裡，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n真陽興致勃勃地檢查隨身行李。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "沒有東西忘了吧。",
    "voice": "vo_adv_1192002_000",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n文件也拿了，",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "裝扮也很完美。",
