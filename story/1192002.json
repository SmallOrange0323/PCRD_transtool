    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "哎呀，",
    "voice": "vo_adv_1192002_006",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "沒空跟你聊了。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我得趕緊出發，",
