    "type": "dialogue",
    "name": "真陽",
    "words": "……",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "那還用說，",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n能讓我這麼積極面對的",
