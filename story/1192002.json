  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "渾身都是泥巴，",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "這個狀態下",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "比賽沒辦法繼續進行了──",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "審查員",
    "words": "今年的大賽會如何進行呢……？",
    "voice": "vo_adv_1192002_058",
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "審查員",
    "words": "\\n",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "審查員",
    "words": "居然這麼精彩",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "審查員",
    "words": "又充滿野性的力量……！",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "……咦？",
    "voice": "vo_adv_1192002_059",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "審查員",
    "words": "本來應該是不可能發生的，",
    "voice": "vo_adv_1192002_060",
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "審查員",
    "words": "\\n但居然能看見乳牛們",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "審查員",
    "words": "迎擊魔物的身姿……",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "審查員",
    "words": "\\n",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "審查員",
    "words": "還有那讓人幾乎要退卻的，",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "審查員",
    "words": "生機蓬勃的動作……！",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "審查員",
    "words": "都如此呈現給我們看了，",
    "voice": "vo_adv_1192002_061",
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "審查員",
    "words": "這下不認同不行了呢。",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "審查員",
    "words": "\\n",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "審查員",
    "words": "超越乳牛的美，",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "審查員",
    "words": "就是萬物的美啊！",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "那是……",
    "voice": "vo_adv_1192002_062",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "呃，",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "什麼意思啊？",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "審查員",
    "words": "這場乳牛比賽",
    "voice": "vo_adv_1192002_063",
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "審查員",
    "words": "比的不只是美貌，",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "審查員",
    "words": "\\n而是牛隻們的健康美啊。",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "審查員",
    "words": "牛群團結一致對抗魔物……",
    "voice": "vo_adv_1192002_064",
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "審查員",
    "words": "\\n",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "審查員",
    "words": "她們讓我們看到",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "審查員",
    "words": "粗暴的生命力裡充滿了美。",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "審查員",
    "words": "\\n確實值得頒獎。",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "審查員",
    "words": "因此……",
    "voice": "vo_adv_1192002_065",
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "審查員",
    "words": "特別追加今年的大賽獲獎資格。",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "審查員",
    "words": "\\n只要是參賽牛隻，",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "審查員",
    "words": "都可以獲得獎品。",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "審查員",
    "words": "\\n各位參加者，",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "審查員",
    "words": "恭喜妳們獲獎！",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "background",
    "bg_id": "500865"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "大賽在盛大的歡呼聲下落幕後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n真陽回到了牧場。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n她帶著有點驕傲的神情，在餵動物們吃飼料。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "好乖好乖……♪",
    "voice": "vo_adv_1192002_066",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n多吃一點喔……♪",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "牛群",
    "words": "哞──────♪",
    "voice": "vo_adv_1192002_067",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "因為拿了大賽獎金而豁出去買了高級飼料，",
    "voice": "vo_adv_1192002_068",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n大家都很開心呢。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "大口大口吃不停♪",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "家人被稱讚真的很令人開心呢。",
    "voice": "vo_adv_1192002_069",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "親手栽培，",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "付出關愛拉拔牠們長大。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n認同我的做法的人還是存在的啦。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "只是",
    "voice": "vo_adv_1192002_070",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "接下來又要開始忙碌啦。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n因為聖誕季的時候",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "牛奶跟奶油的銷量都會飛耀式成長嘛。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "老哥，",
    "voice": "vo_adv_1192002_071",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "謝謝你幫我到這麼晚。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "比賽的時候也是，",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "是你在我們戰鬥的後方，",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n保護評審和其他沒有戰力的人吧？",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "多虧有你，",
    "voice": "vo_adv_1192002_072",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "會場的人，",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n和牛孩子都很平安。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我總是受你幫助呢。",
    "voice": "vo_adv_1192002_073",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n說再多的感謝",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "也不夠啦。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "因此",
    "voice": "vo_adv_1192002_074",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我有準備頒獎給你喔。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n就叫做：",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "謝謝你總是陪我一直「講」……",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "開玩笑的啦。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "只要和老哥在一起",
    "voice": "vo_adv_1192002_075",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "就會很放鬆，",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n感覺就像真的家人一樣。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我",
    "voice": "vo_adv_1192002_076",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "如果要找老公，",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n就要選老哥你這種的啦。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "嗯？",
    "voice": "vo_adv_1192002_077",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "啊……",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "咦？",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "剛剛說了什麼？",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "不不、",
    "voice": "vo_adv_1192002_078",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "不是你想的那樣喔！？",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n我",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "剛剛的意思是，",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n如果有人可以",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "像老哥一樣陪我",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "就好了啦！",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "像這樣一起工作、",
    "voice": "vo_adv_1192002_079",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "一起吃同鍋飯。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n如果有這麼一個人陪我就好了的意思啦……！",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "雖、",
    "voice": "vo_adv_1192002_080",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "雖然",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我說要像老哥一樣的人，",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "但可以的話，還是老哥比較好啦。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "因為如果是你，",
    "voice": "vo_adv_1192002_081",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n好像可以把我做的飯吃得津津有味，",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n然後我也會覺得很有成就感……",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "啊啊，",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "不是啦！",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "對、",
    "voice": "vo_adv_1192002_082",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "對了！",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "吃飯！",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "你今天也陪我到這麼晚，",
    "voice": "vo_adv_1192002_083",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n我也總是在依賴你對吧？",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "所以",
    "voice": "vo_adv_1192002_084",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "為了感謝你，",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我想親自下廚請你吃飯啦。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "順便舉辦",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "聖誕派對之類的……",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "那個，",
    "voice": "vo_adv_1192002_085",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "希望老哥能",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "賞個臉……",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "真、",
    "voice": "vo_adv_1192002_086",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "真的嗎？",
    "voice": null,
    "unit_id": 119211
