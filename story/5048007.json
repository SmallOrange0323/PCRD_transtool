    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "哦、",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "哦唔！？",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "依里和茜里都沒事，",
    "voice": "vo_adv_5048007_013",
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "真是……",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "真是太好了",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "的說……",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "嗚哇啊──！",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "知道了，",
    "voice": "vo_adv_5048007_014",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我知道了啦，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "妳、",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "妳稍微冷靜一點！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "嗚嗚，",
    "voice": "vo_adv_5048007_015",
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "那個……",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "依里、",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "茜里，",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "真的、",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "真的",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "非常對不起！",
