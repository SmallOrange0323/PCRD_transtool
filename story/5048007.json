    "name": "茜里",
    "words": "咦？",
    "voice": "vo_adv_5048007_027",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "拉菲……",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "妳在跟誰說話？",
