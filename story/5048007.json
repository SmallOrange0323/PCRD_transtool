    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "沒關係的，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我很能體會拉菲的心情。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n妳只是想讓大家、",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "想讓自己幸福起來而已",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "對吧。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "就是說呀。",
    "voice": "vo_adv_5048007_017",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "雖然街上陷入了一片混亂，",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "但說不定有人覺得這是個珍貴的體驗",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "而因此感到開心呢！",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "才不咧，",
    "voice": "vo_adv_5048007_018",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "是會留下陰影的糟糕體驗吧，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "這件事。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "所以妳要記取教訓，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "不要再突然對人射箭了，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "知道了嗎？",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "是的！",
    "voice": "vo_adv_5048007_019",
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "我今後會",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "更為大家著想，",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n努力成為像妳們兩位",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "一樣棒的天使！",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "不不，",
    "voice": "vo_adv_5048007_020",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我們都",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "已經變回原樣了，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "把我們當成榜樣也沒用吧……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "不過，",
    "voice": "vo_adv_5048007_021",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "仔細想想，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "這種體驗好像也不壞。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n雖然碰上了不少麻煩，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "但也讓我察覺到了某些事物，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "不算一無所獲呢。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "嗯嗯！",
    "voice": "vo_adv_5048007_022",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "我們也因此發現了姊妹彼此的好♪",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n很開心呢～",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "啊，",
    "voice": "vo_adv_5048007_023",
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "那麼要再",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "互換一次身體嗎？",
    "voice": null,
    "unit_id": 5511
  },
