  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在依里和茜里的活躍表現下，弓箭所引發的各種亂象",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n迅速地得到了控制。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "王宮騎士隊長",
    "words": "那道閃光",
    "voice": "vo_adv_5048007_000",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士隊長",
    "words": "是怎麼回事……",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士隊長",
    "words": "到底",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士隊長",
    "words": "發生了什麼？",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士1",
    "words": "隊長！ ",
    "voice": "vo_adv_5048007_001",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士1",
    "words": "包含我們在內，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士1",
    "words": "所有身體被互換的人都恢復原狀了！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士2",
    "words": "而且，",
    "voice": "vo_adv_5048007_002",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "王宮騎士2",
    "words": "與此同時發生的各種怪異現象，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "王宮騎士2",
    "words": "似乎也都消失了！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "王宮騎士隊長",
    "words": "這樣啊！",
    "voice": "vo_adv_5048007_003",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士隊長",
    "words": "是那些孩子們的功勞吧……！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "太好了……",
    "voice": "vo_adv_5048007_004",
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "姊姊，我們辦到了哦！",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "嗯……",
    "voice": "vo_adv_5048007_005",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "太好了……",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "啊，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "哈哈，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "一安心下來，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "就變得全身無力了……",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "真是的，",
    "voice": "vo_adv_5048007_006",
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "本來覺得姊姊有所改變了，",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "看來還差得遠呢。",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "這是當然的嘛。",
    "voice": "vo_adv_5048007_007",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "要是這麼容易就能改變，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n我早就改變了。",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "不過，",
    "voice": "vo_adv_5048007_008",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "這次事件也讓我明白了……",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n重要的是要「嘗試去改變」。",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "嗯，",
    "voice": "vo_adv_5048007_009",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "沒錯呢……",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "啊，",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "咦，",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "我們的衣服……！",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "變回來了……",
    "voice": "vo_adv_5048007_010",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "因為我們制止了弓箭，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "魔法也隨之解除了吧。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n這下終於有一切都結束的實感了呢。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "依里──！",
    "voice": "vo_adv_5048007_011",
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "茜里──！",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "拉菲！",
    "voice": "vo_adv_5048007_012",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n太好了，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "妳平安無事──",
