    "name": "依里",
    "words": "是在剛剛的戰鬥中撞到頭了……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "啊不過，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "這孩子本來就有點……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "不、",
    "voice": "vo_adv_5048007_029",
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "不是的！",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "不知道是不是因為剛才魔法的影響，",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "我變得能理解這孩子的心情了！",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "應該說，",
    "voice": "vo_adv_5048007_030",
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "我不能直接跟它對話，",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "它卻能",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "將情感",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "和心聲傳達給我。",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "哦～",
    "voice": "vo_adv_5048007_031",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "有人能監督妳了呢。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n這樣一來，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "妳就無法隨便亂用魔法囉。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "是的，",
    "voice": "vo_adv_5048007_032",
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "我會在這孩子的協助下，",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n學會掌控我的力量！",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "所以首先，",
    "voice": "vo_adv_5048007_033",
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "要把我們感謝的心情",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "傳達給妳們兩位。",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "咦，",
    "voice": "vo_adv_5048007_034",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "給我等等，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "說是感謝，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "為什麼要把弓箭對準我們？",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "話說這個橋段，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "之前也發生過吧！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "現在的我已經和當時不一樣了……",
    "voice": "vo_adv_5048007_035",
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "大概！",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "這不是完全一樣嗎！",
    "voice": "vo_adv_5048007_036",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "兩人",
    "words": "呀啊啊──！",
    "voice": "vo_adv_5048007_037",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "嗚嗚，",
    "voice": "vo_adv_5048007_038",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "這個循環要重複多少次啦……",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "啊，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "又變成這副模樣了！",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "請放心，",
    "voice": "vo_adv_5048007_039",
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "我只是改變了衣服外觀而已。",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n這孩子也說，",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "魔法施展得很順利而感到開心呢。",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "姑且算是能好好和它溝通了呢。",
    "voice": "vo_adv_5048007_040",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "不說這個了，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "妳那突然對別人施魔法的壞習慣",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "就不能改改嘛。",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "欸嘿嘿，",
    "voice": "vo_adv_5048007_041",
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "我倒是覺得有點高興呢。",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "因為這套衣服",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "超級可愛呀♪",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "依里和茜里，",
    "voice": "vo_adv_5048007_042",
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n妳們擁有著",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "不輸天使魔法的美好心靈。",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "請兩位運用這份力量，",
    "voice": "vo_adv_5048007_043",
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n讓蘭德索爾的大家",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "變得幸福起來吧！",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "那麼，",
    "voice": "vo_adv_5048007_044",
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "我就先告辭了。",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n真的很感謝",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "妳們的照顧。",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "咦，",
    "voice": "vo_adv_5048007_045",
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "妳要走了嗎？",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "騷動也解決了，",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n不必這麼急著走吧……",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "雖然我也很想和兩位多說些話，",
    "voice": "vo_adv_5048007_046",
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "但我不是來玩的，",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "沒有時間慢慢來。",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "這樣啊……",
    "voice": "vo_adv_5048007_047",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我們，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "還會再見面吧？",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "是的！",
    "voice": "vo_adv_5048007_048",
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "我從兩位出色的表現中，",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "得到了滿滿的勇氣。",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n下次見面時，",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "我一定會讓兩位",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "見識到有所改變的我～！",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "……走遠了呢。",
    "voice": "vo_adv_5048007_049",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "她出現得很突然，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n走得也很倉促耶。",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "妳覺得呢？",
    "voice": "vo_adv_5048007_050",
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "姊姊？",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "……這個嘛，",
    "voice": "vo_adv_5048007_051",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我已經受夠",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "那種騷動了。",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "但我姑且還欠了",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "替我實現心願的拉菲一份人情呢。",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "心願，",
    "voice": "vo_adv_5048007_052",
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "是指互換身體的事嗎？",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "與其說是互換身體，",
    "voice": "vo_adv_5048007_053",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n倒不如說是因為遇見了她，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我才能體驗許多事。",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "在線下聚中說出自己真實的想法，",
    "voice": "vo_adv_5048007_054",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "或是享受音樂節，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "以及為了解決街上的混亂，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "積極行動起來。",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "這些事情，",
    "voice": "vo_adv_5048007_055",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "若換作是以往的我，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "肯定辦不到呢。",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "才沒有那回事呢。",
    "voice": "vo_adv_5048007_056",
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "姊姊就算現在無法辦到，",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n但未來某一天",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "也一定能夠成功的！",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "謝謝妳。",
    "voice": "vo_adv_5048007_057",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "或許茜里說的沒錯，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n但是拉菲她，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "確實給了我",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "踏出那一步的勇氣呢。",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "還有啊，茜里，",
    "voice": "vo_adv_5048007_058",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我之所以能這麼努力，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n也是多虧了有茜里在身旁支持著我喔……",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "謝謝妳。",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "姊姊……",
    "voice": "vo_adv_5048007_059",
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "我也是這麼想的。",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "這次事件也是，",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n我又再次了解到，",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n我之所以能是現在的我，",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "都是因為有姊姊在身邊。",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "所以，",
    "voice": "vo_adv_5048007_060",
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "姊姊可以更有自信一點哦。",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n然後在感到迷惘時，",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "可以多依靠我……",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "還有哥哥一點♪",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "茜里就算了，",
    "voice": "vo_adv_5048007_061",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "還要依靠你？",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "……",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "不過，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "能解決這次的騷動",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n也有你的功勞啦，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "所以……",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "就一點點，",
    "voice": "vo_adv_5048007_062",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "就多依賴你",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "那麼一點點",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "好了。",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "哼、",
    "voice": "vo_adv_5048007_063",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "哼……",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "隨你高興。",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "比起這個，",
    "voice": "vo_adv_5048007_064",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我現在已經踏出一步了，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n還想要",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "再往前",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "踏出一步。",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n成為天使的話，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "或許就能辦到了吧。",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "……當然，",
    "voice": "vo_adv_5048007_065",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "也是有可能",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "辦不到就是了。",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "姊姊……",
    "voice": "vo_adv_5048007_066",
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "嗯，",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "我知道了。",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "姊姊要成為天使的話，",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "那茜里也要成為天使！",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "茜、",
    "voice": "vo_adv_5048007_067",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "茜里？",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n為什麼",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "連妳也……",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "因為，",
    "voice": "vo_adv_5048007_068",
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "姊姊自己一個人變得更好，",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n我就會被丟下了嘛！",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "我也要成為",
    "voice": "vo_adv_5048007_069",
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "不讓姊姊蒙羞的，",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "最棒的妹妹！",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "……是呢，",
    "voice": "vo_adv_5048007_070",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我們兩個一起努力吧。",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n因為，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我們是──",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "最棒的",
    "voice": "vo_adv_5048007_071",
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "雙胞胎呀♪",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "依里和茜里手牽著手望著向晚的天空，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n回味這漫長的一天。",
    "voice": null,
    "unit_id": null
  },
