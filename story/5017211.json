[
  {
    "type": "dialogue",
    "name": "貝特魯吉烏斯",
    "words": "魔女啊……",
    "voice": "vo_adv_5017211_000",
    "unit_id": 11511
  },
  {
    "type": "dialogue",
    "name": "貝特魯吉烏斯",
    "words": "魔女啊！",
    "voice": null,
    "unit_id": 11511
  },
  {
    "type": "dialogue",
    "name": "貝特魯吉烏斯",
    "words": "魔女啊！",
    "voice": null,
    "unit_id": 11511
  },
  {
    "type": "dialogue",
    "name": "貝特魯吉烏斯",
    "words": "魔女啊啊啊！",
    "voice": null,
    "unit_id": 11511
  },
  {
    "type": "dialogue",
    "name": "貝特魯吉烏斯",
    "words": "\\n請給我愛……",
    "voice": null,
    "unit_id": 11511
  },
  {
    "type": "dialogue",
    "name": "貝特魯吉烏斯",
    "words": "給我寵愛……！",
    "voice": null,
    "unit_id": 11511
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "……他已經完全",
    "voice": "vo_adv_5017211_001",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "被瘋狂吞沒了。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "雖然我很想說要發瘋就儘管發瘋吧，",
    "voice": "vo_adv_5017211_002",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n但現在似乎也不能這麼說。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "是啊。",
    "voice": "vo_adv_5017211_003",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "簡直就像是被那瘋狂所牽引，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n魔女教徒們也",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "明顯地變強了。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "兩位，",
    "voice": "vo_adv_5017211_004",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "妳們看那個！",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "那、",
    "voice": "vo_adv_5017211_005",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "那個是……",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "難不成，",
    "voice": "vo_adv_5017211_006",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "那個就是闇影嗎……！",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "貪吃佩可曾說過。",
    "voice": "vo_adv_5017211_007",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n有一種擁有人類姿態",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "的特殊魔物。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "但沒想到，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "竟然會和雷姆及拉姆長得一模一樣……",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "而且，",
    "voice": "vo_adv_5017211_008",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "似乎和魔女教徒們一樣，",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n受到大罪司教的掌控！",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "就算是魔物，",
    "voice": "vo_adv_5017211_009",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "對那種化身為我們姿態",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n還成為魔女教徒的東西……",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "絕對無法原諒！！",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "……看來似乎連拉姆都",
    "voice": "vo_adv_5017211_010",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n都無法繼續保持冷靜了！",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "兩位！",
    "voice": "vo_adv_5017211_011",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n我會掩護妳們，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "讓妳們盡情地攻擊對方！",
    "voice": null,
    "unit_id": 109911
  }
]
