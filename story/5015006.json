  {
    "type": "dialogue",
    "name": "步未",
    "words": "原來妮諾",
    "voice": "vo_adv_5015006_029",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "這麼聰明……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "惡代官",
    "words": "腰帶……",
    "voice": "vo_adv_5015006_030",
    "unit_id": 11411
  },
  {
    "type": "dialogue",
    "name": "惡代官",
    "words": "把腰帶給我……",
    "voice": null,
    "unit_id": 11411
  },
  {
    "type": "dialogue",
    "name": "惡代官",
    "words": "\\n讓我拉……",
    "voice": null,
    "unit_id": 11411
  },
  {
    "type": "dialogue",
    "name": "惡代官",
    "words": "讓我拉它……",
    "voice": null,
    "unit_id": 11411
  },
  {
    "type": "dialogue",
    "name": "惡代官",
    "words": "\\n這樣……",
    "voice": null,
    "unit_id": 11411
  },
  {
    "type": "dialogue",
    "name": "惡代官",
    "words": "不是……",
    "voice": null,
    "unit_id": 11411
  },
  {
    "type": "dialogue",
    "name": "惡代官",
    "words": "很好嗎……",
    "voice": null,
    "unit_id": 11411
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "怎、",
    "voice": "vo_adv_5015006_031",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "怎麼了？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n惡代官它……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "惡代官",
    "words": "惡代官……",
    "voice": "vo_adv_5015006_032",
    "unit_id": 11411
  },
  {
    "type": "dialogue",
    "name": "惡代官",
    "words": "\\n",
    "voice": null,
    "unit_id": 11411
  },
  {
    "type": "dialogue",
    "name": "惡代官",
    "words": "要拉腰帶……",
    "voice": null,
    "unit_id": 11411
  },
  {
    "type": "dialogue",
    "name": "惡代官",
    "words": "\\n腰帶……",
    "voice": null,
    "unit_id": 11411
  },
  {
    "type": "dialogue",
    "name": "惡代官",
    "words": "腰……",
    "voice": null,
    "unit_id": 11411
  },
  {
    "type": "dialogue",
    "name": "惡代官",
    "words": "帶…………",
    "voice": null,
    "unit_id": 11411
  },
  {
    "type": "dialogue",
    "name": "惡代官",
    "words": "吼喔喔喔喔喔喔喔喔！！！",
    "voice": "vo_adv_5015006_033",
    "unit_id": 11412
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "惡、",
    "voice": "vo_adv_5015006_034",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "惡代官的身體",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "產生變化了！",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n那個身體是……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "在土產店看過的",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "機關人偶！？",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……身體強韌到用刀鞘攻擊無效，",
    "voice": "vo_adv_5015006_035",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "連劍都沒用的",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "原因是這個啊。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "原來是仿造惡代官做出的機關人偶幻化成了魔物，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n模仿了惡代官的行動……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "所以才模仿惡代官的特技，",
    "voice": "vo_adv_5015006_036",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "要讓它行動變得緩慢……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "真不愧是妮諾！　",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "聽妳說要拿腰帶當誘餌時，我還懷疑是不是聽錯了，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n原來這是妳看穿了一切所想出來的作戰呢！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "…………正、",
    "voice": "vo_adv_5015006_037",
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "正正正、",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "正是如此！！",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n因為他想要搶空花的腰帶，",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "所以想說看到",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n很大的腰帶或許會讓他失去戒心……",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我才不是只想到這個而已！！",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "……她一臉",
    "voice": "vo_adv_5015006_038",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "只想到要準備大型腰帶而已的樣子。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "就、",
    "voice": "vo_adv_5015006_039",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "就算是空花，",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "也看得出她在說謊……",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "妮諾真厲害呢……",
    "voice": "vo_adv_5015006_040",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我也要",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "加油才行。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "好、",
    "voice": "vo_adv_5015006_041",
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "好了！！",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "只要把這個腰帶",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "綁到穿著和服的空花身上，",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "就完成了惡代官專用的",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "完美誘餌了！",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "那、",
    "voice": "vo_adv_5015006_042",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "那個……",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "關於那件事，",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "就算是空花，",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "在魔物面前",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n被緊綁住當誘餌……",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "雖然是很令人興奮，",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "可是還是……",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "會覺得很可怕啊……",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "……",
    "voice": "vo_adv_5015006_043",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "這、",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "這種時候竟然",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "故意對空花說那麼溫柔的話！",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "還真是天生的，",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "究極虐待狂啊！",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n那個……",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "雖、",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "雖、",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "雖然是這樣的我，",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "還請多多指教了！",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "竟、",
    "voice": "vo_adv_5015006_044",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "竟然在這裡正大光明的發出綑綁宣言！？",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "虐待狂終於要認真了……",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "可、",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "可是，",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n那麼強勢的逼人家的話……",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "空花沒辦法拒絕……！",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "不愧是將軍！　",
    "voice": "vo_adv_5015006_045",
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "交涉技巧太高明了！",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n那就馬上",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "用分身術一口氣綁起來……",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "咻啪啪啪！",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "這、",
    "voice": "vo_adv_5015006_046",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "這樣子",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "應該要扶住空花",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "比較好吧……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我來",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "幫忙……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "呀啊！？",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "真是的……",
    "voice": "vo_adv_5015006_047",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "讓人看不下去呢。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我也一起幫忙。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "雪……",
    "voice": "vo_adv_5015006_048",
    "unit_id": 105511
  },
  {
