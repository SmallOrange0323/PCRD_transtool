[
  {
    "type": "background",
    "bg_id": "500430"
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "話說回來，",
    "voice": "vo_adv_7008001_000",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n小栞之前",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "是不是說過",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "自己有一個姐姐？",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "是的。",
    "voice": "vo_adv_7008001_001",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "姊姊名叫初音，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n隸屬於【森林守衛】。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "你姐姐是什麼樣的人呢？",
    "voice": "vo_adv_7008001_002",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n應該和",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "小栞很像吧？",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "這個嘛……",
    "voice": "vo_adv_7008001_003",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "姊姊",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "很溫柔，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "有點愛操心……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "和我不一樣，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "是個活力十足的人。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "是……",
    "voice": "vo_adv_7008001_004",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "是的。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "活力十足……",
    "voice": "vo_adv_7008001_005",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "睡得很好？",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "而且不管到什麼地方都能睡得很好？",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "姊姊",
    "voice": "vo_adv_7008001_006",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "不管在哪裡都睡得著。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "雖然我提醒過她，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "這樣很危險……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "聽起來真是狂野奔放呢～？",
    "voice": "vo_adv_7008001_007",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我原本以為",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "她和小栞一樣，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "是個端莊賢淑的人呢。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "狂野奔放……",
    "voice": "vo_adv_7008001_008",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "雖然有點",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "不太一樣，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "不過她是很堅強的人。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我希望",
    "voice": "vo_adv_7008001_009",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "自己有一天能變強到",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n足以保護姊姊。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "小栞……",
    "voice": "vo_adv_7008001_010",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "妳好了不起……！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "這麼說來，璃乃",
    "voice": "vo_adv_7008001_011",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n偶爾也會提到關於姊姊的事吧？",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "她是個什麼樣的人呢？",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "唔。",
    "voice": "vo_adv_7008001_012",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "妳說的……",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "姐姐、",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n指的應該是靜流姐吧……",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "嗯～",
    "voice": "vo_adv_7008001_013",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "雖說是姐姐，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n但是跟妳們姊妹的感覺有點不一樣～",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "不過啊，我們之間確實存在著強烈的羈絆。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "哎呀，",
    "voice": "vo_adv_7008001_014",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "簡單來說……",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "她是個",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "古怪偏執的人。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "古怪偏執？",
    "voice": "vo_adv_7008001_015",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "她是個堅強",
    "voice": "vo_adv_7008001_016",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "且值得信賴的人……",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "不過只要遇到關於哥哥的事，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "就變得",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "有點恐怖……？",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "不過不過，",
    "voice": "vo_adv_7008001_017",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "她平常其實很溫柔喔？",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "啊～",
    "voice": "vo_adv_7008001_018",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "那個、",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "真的滿痛的……",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "呵呵……",
    "voice": "vo_adv_7008001_019",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "她一定",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "是個很有趣的人。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "對了對了，",
    "voice": "vo_adv_7008001_020",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "說到姐姐，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "前陣子啊――",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "姊姊",
    "voice": "vo_adv_7008001_021",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "也為了我――",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在攀登高塔的過程中，\\n兩位妹妹興高采烈地聊著關於姐姐的話題。",
    "voice": null,
    "unit_id": null
  }
]
