  {
    "type": "dialogue",
    "name": "紡希",
    "words": "先生……",
    "voice": null,
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "黑暗精靈",
    "words": "這位還真是相當有趣的人呢。",
    "voice": "vo_adv_5205002_060",
    "unit_id": 3312
  },
  {
    "type": "dialogue",
    "name": "黑暗精靈",
    "words": "\\n",
    "voice": null,
    "unit_id": 3312
  },
  {
    "type": "dialogue",
    "name": "黑暗精靈",
    "words": "嗯？",
    "voice": null,
    "unit_id": 3312
  },
  {
    "type": "dialogue",
    "name": "黑暗精靈",
    "words": "我記得妳是",
    "voice": null,
    "unit_id": 3312
  },
  {
    "type": "dialogue",
    "name": "黑暗精靈",
    "words": "這個世界的公主",
    "voice": null,
    "unit_id": 3312
  },
  {
    "type": "dialogue",
    "name": "黑暗精靈",
    "words": "涅妃‧涅羅的……",
    "voice": null,
    "unit_id": 3312
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "可以不要才剛見到我就說出涅妃的名字嗎！？",
    "voice": "vo_adv_5205002_061",
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n這可是超級嚴重的侮辱行為啊，",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "陰沉的黑暗精靈！",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "哥布林女士",
    "words": "嘿，",
    "voice": "vo_adv_5205002_062",
    "unit_id": 19411
  },
  {
    "type": "dialogue",
    "name": "哥布林女士",
    "words": "來了個相當不會看場合的人呢！",
    "voice": null,
    "unit_id": 19411
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "這可真是",
    "voice": "vo_adv_5205002_063",
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "無比的",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "無知！",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "在高貴的大小姐面前，",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "連場合都會自動配合我的～♪",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "所以說，",
    "voice": "vo_adv_5205002_064",
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "趕緊給我退場吧！",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n只要打倒你們，",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "我就正式成為自由之身了！",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "那些為了陷害我而編造的罪狀也會全被洗刷掉，",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "我會被無罪釋放了～♪",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "她確實說了！",
    "voice": "vo_adv_5205002_065",
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n……",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "喂！",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "那邊的萎靡粉紅",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "能戰鬥嗎？",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "功勞也可以全～都歸給本小姐就是了？",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "那、",
    "voice": "vo_adv_5205002_066",
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "那當然啊！",
    "voice": null,
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我才不至於要讓華音來擔心我……！",
    "voice": null,
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "黑暗精靈",
    "words": "嗯。",
    "voice": "vo_adv_5205002_067",
    "unit_id": 3312
  },
  {
    "type": "dialogue",
    "name": "黑暗精靈",
    "words": "\\n雖然也可以先在這裡排除礙事者，",
    "voice": null,
    "unit_id": 3312
  },
  {
    "type": "dialogue",
    "name": "黑暗精靈",
    "words": "\\n",
    "voice": null,
    "unit_id": 3312
  },
  {
    "type": "dialogue",
    "name": "黑暗精靈",
    "words": "但似乎還能期待",
    "voice": null,
    "unit_id": 3312
  },
  {
    "type": "dialogue",
    "name": "黑暗精靈",
    "words": "你們的有趣行動呢。",
    "voice": null,
    "unit_id": 3312
  },
  {
    "type": "dialogue",
    "name": "華音",
