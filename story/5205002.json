[
  {
    "type": "background",
    "bg_id": "502080"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "華音與紡希──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}成了這兩名奴隸的主人。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n然而這兩人卻是最合不來的。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "真是個嘴巴沒個停的傲嬌粉紅！",
    "voice": "vo_adv_5205002_000",
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "還在胸口開個愛心洞什麼的，真是莫名其妙～！",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "啥～！？",
    "voice": "vo_adv_5205002_001",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n我才不想被毫無品味還只會",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "耍嘴皮子的豎捲髮說──！",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希與華音",
    "words": "可惡──！",
    "voice": "vo_adv_5205002_002",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "等",
    "voice": "vo_adv_5205002_003",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "～",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "一下啦，騎士先生！",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n為什麼",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "要把魔卡拿出來？",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我們可",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "沒有在吵架喔！？",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "正是如此，",
    "voice": "vo_adv_5205002_004",
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "喔呵呵呵呵！",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "所以趕快收起那片可恨至極的板子，",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n不，",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "當場把它敲碎如何！",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "紡希與華音",
    "words": "「",
    "voice": "vo_adv_5205002_005",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "紡希與華音",
    "words": "當然會啊～♪」\\n「那是當然的～♪」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "紡希與華音",
    "words": "哼！",
    "voice": "vo_adv_5205002_006",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "……",
    "voice": "vo_adv_5205002_007",
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "儘管如此，",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "這實在不合理至極……",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n為何本小姐",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "必須要跟這種粉紅又狂妄的丫頭，",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n去找三流的雜碎們不可？",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "別再嘮叨了，快點找啦。",
    "voice": "vo_adv_5205002_008",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n這地方我們不熟，",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n所以這是只會耍嘴皮子的華音派上用場的機會喔？",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "還真敢說啊，妳這──",
    "voice": "vo_adv_5205002_009",
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "──你們",
    "voice": "vo_adv_5205002_010",
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "是奴隸與主人吧？",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "什麼？",
    "voice": "vo_adv_5205002_011",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n有什麼事？",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "才剛見面就突然──",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "奴隸",
    "words": "──很抱歉，但請你們就此消失吧！",
    "voice": "vo_adv_5205002_012",
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "主人",
    "words": "──上吧，",
    "voice": "vo_adv_5205002_013",
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "主人",
    "words": "我的奴隸啊！",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "background",
    "bg_id": "502080"
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "唔！？",
    "voice": "vo_adv_5205002_014",
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "你突然",
    "voice": null,
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "是要幹嘛！",
    "voice": null,
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "哦～",
    "voice": "vo_adv_5205002_015",
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "呵呵呵♪",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n竟然突然就被襲擊了，",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "看來妳似乎相當遭人怨恨呢♪",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "是因為妳平時素行不良吧？",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "向我學學如何？",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我才沒有遭人怨恨！",
    "voice": "vo_adv_5205002_016",
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n說到底我可是偶像！",
    "voice": null,
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我的工作是傳遞",
    "voice": null,
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "歌曲與舞蹈，才不是什麼怨恨的！",
    "voice": null,
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "……偶像？",
    "voice": "vo_adv_5205002_017",
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "哦～",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "相當不錯的職業嘛。",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "讓妳當襯托本小姐的伴舞也是可以的喔？",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "襯托華音這種事我絕對不要！",
    "voice": "vo_adv_5205002_018",
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n──這就是",
    "voice": null,
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "最後一擊了！",
    "voice": null,
    "unit_id": 134811
  },
  {
    "type": "background",
    "bg_id": "502080"
  },
  {
    "type": "dialogue",
    "name": "二人組",
    "words": "咕啊啊啊啊啊啊",
    "voice": "vo_adv_5205002_019",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "二人組",
    "words": "啊啊啊啊！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "……差不多就這樣吧。",
    "voice": "vo_adv_5205002_020",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "姑且",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "先用絲線把他們綁起來吧。",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "雖不及我的程度，",
    "voice": "vo_adv_5205002_021",
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "但相當能幹嘛。",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n用絲線束縛的效率也是既迅速",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "又美麗……",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "不過，",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "偶像是像這樣的存在嗎……？　",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我說",
    "voice": "vo_adv_5205002_022",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "你們，",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "為什麼要襲擊我們？",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "奴隸",
    "words": "黑暗精靈跟",
    "voice": "vo_adv_5205002_023",
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "奴隸",
    "words": "女哥布林",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "奴隸",
    "words": "到處在宣傳著啊……",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "奴隸",
    "words": "\\n說會給予",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "奴隸",
    "words": "在這個結界中",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "奴隸",
    "words": "最後勝出的人",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "奴隸",
    "words": "從異世界來的「最強奴隸」……",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "從異世界來的",
    "voice": "vo_adv_5205002_024",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "最強……",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "奴隸！？",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n那該不會是……！！",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "──喂，你！",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "黑暗精靈那幫人",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "在哪裡！？",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "主人",
    "words": "那些傢伙應該正在那邊，",
    "voice": "vo_adv_5205002_025",
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "主人",
    "words": "\\n召集像我們這樣的人，",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "主人",
    "words": "把剛剛的話宣傳出去……",
    "voice": null,
    "unit_id": 18711
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "……唔！",
    "voice": "vo_adv_5205002_026",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "等一下，傲嬌粉紅！",
    "voice": "vo_adv_5205002_027",
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "……",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "她無視本小姐走了。",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "還真～～",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "是忙碌呢，",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "庶民們。",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "為什麼我必須為了庶民",
    "voice": "vo_adv_5205002_028",
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "而移動這雙玉足？",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
