    "words": "唔──！",
    "voice": "vo_adv_5205002_069",
    "unit_id": 19411
  },
  {
    "type": "dialogue",
    "name": "哥布林女士",
    "words": "──我們要用這個結界來打倒涅妃‧涅羅。",
    "voice": "vo_adv_5205002_070",
    "unit_id": 19411
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "唔……",
    "voice": "vo_adv_5205002_071",
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "哦？",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "黑暗精靈",
    "words": "那麼，",
    "voice": "vo_adv_5205002_072",
    "unit_id": 3312
  },
  {
    "type": "dialogue",
    "name": "黑暗精靈",
    "words": "接下來要開始的是，",
    "voice": null,
    "unit_id": 3312
  },
  {
    "type": "dialogue",
    "name": "黑暗精靈",
    "words": "\\n測試主人與奴隸間羈絆與力量的",
    "voice": null,
    "unit_id": 3312
  },
  {
    "type": "dialogue",
    "name": "黑暗精靈",
