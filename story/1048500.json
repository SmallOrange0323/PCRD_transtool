  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "不好意思，",
    "voice": "vo_adv_1048500_000",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "該不會",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "害你等了很久吧？",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "……啊，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "原來只是提前一點到嗎，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這樣的話那就好。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "所以，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "今天找我有什麼事嗎？",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "咦！？",
    "voice": "vo_adv_1048500_001",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "謝、",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "謝謝！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "真是沒想到",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "竟然會有人為我慶生。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n呵呵，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這種事不管幾歲都一樣令人開心呢。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "咦，",
    "voice": "vo_adv_1048500_002",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "你說要請我吃點什麼當作禮物……",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這倒是不必了……",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "因為！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n要是想吃什麼，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "接下來就去特賣會手到擒來！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "呃，",
    "voice": "vo_adv_1048500_003",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這我當然非常感謝，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "可是怎麼會突然……",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "啊，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "對喔，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "今天是我的生日，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "所以你願意幫忙我嗎？",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "如果是這樣，",
    "voice": "vo_adv_1048500_004",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "那我可要把你好好使喚一番了。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "好比說採購公會用的公物，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "送給兄妹們的伴手禮……",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "嗯，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "應該會忙上一整天吧♪",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n呵呵，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "看來今天會是很有意思的一天。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "咦，",
    "voice": "vo_adv_1048500_005",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "真的可以嗎！？",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "謝謝你！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n哇……",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "裡頭不只有日用品，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "連道具店的折價券都有啊！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "只不過，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "為什麼會突然……",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "咦？",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "因為今天是我生日？",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "呵呵，",
    "voice": "vo_adv_1048500_006",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "謝謝你。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n既然這樣，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我們一起使用這張",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "兩人同享的午餐半價券吧。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n今天這個日子，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "好歹也該一起輕鬆地過。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "走吧，",
    "voice": "vo_adv_1048500_007",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我們這就出發前往店裡。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n既然是過生日，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "就該有效率地，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "開開心心地過！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "而且當然，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "你今天可得",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "陪伴我到最後喔♪",
    "voice": null,
    "unit_id": 104811
  }
]
