    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "對吧♪",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "總而言之，",
    "voice": "vo_adv_5220002_047",
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "就是這樣──",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n烏爾姆，",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "能請妳消失嗎？",
