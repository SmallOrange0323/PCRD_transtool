    "type": "dialogue",
    "name": "烏爾姆",
    "words": "就告辭了。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……！",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "咦咦～？",
    "voice": "vo_adv_5220002_032",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "真冷淡～",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我就是難得",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "有事想跟妳說，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "才過來這裡的啊～",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "有事想跟我說……？",
    "voice": "vo_adv_5220002_033",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "嗯♪",
    "voice": "vo_adv_5220002_034",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "雖然突然這麼說很冒犯……",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "就是想說能不能請",
    "voice": "vo_adv_5220002_035",
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "烏爾姆消失呀♪",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……！？",
    "voice": "vo_adv_5220002_036",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "哦，",
    "voice": "vo_adv_5220002_037",
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "被躲開了啊～",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "本來打算一擊就結束的……",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "好歹還算是",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "龍人族，",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "是嗎？",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……能請妳說明一下嗎？",
    "voice": "vo_adv_5220002_038",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n突然就展開攻擊，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我根本搞不清楚狀況。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "嗯～",
    "voice": "vo_adv_5220002_039",
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "說明啊……",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n烏爾姆如果",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "知道自己",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "什麼都不懂時做的東西，",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n在自己不知道的地方被擅自拿去用，",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "會怎麼想？",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "啊？",
    "voice": "vo_adv_5220002_040",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "妳突然在說什麼……",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "才不突然呢～",
    "voice": "vo_adv_5220002_041",
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n小幻的",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "公主騎士跟我說了，",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n你們就是「被創造出來的人偶」啊。",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "遊戲中的角色啊，",
    "voice": "vo_adv_5220002_042",
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n不光需要實裝的模特兒，",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "也需要原案",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "插畫。",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n你們也一樣。",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "…………！",
