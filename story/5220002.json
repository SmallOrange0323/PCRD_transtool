    "voice": "vo_adv_5220002_050",
    "unit_id": 127812
  },
  {
    "type": "background",
    "bg_id": "501663"
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "哎呀☆",
    "voice": "vo_adv_5220002_051",
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n好險好險～♪",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "每個人都這樣……！",
    "voice": "vo_adv_5220002_052",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "可以請你們別擅自決定",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "什麼抹不抹消嗎……！？",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我也不是",
    "voice": "vo_adv_5220002_053",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "自願誕生的。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "但是──",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "即便如此，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我也活到今天了。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "老姊也是──",
    "voice": "vo_adv_5220002_054",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n一本正經、",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "弱小",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "又笨拙……",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "明明她也只是像平常人一樣活著而已！　",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "然而……",
    "voice": "vo_adv_5220002_055",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "妳們卻！！",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "…………♪",
    "voice": "vo_adv_5220002_056",
    "unit_id": 106712
  },
  {
    "type": "background",
    "bg_id": "501663"
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "咕……",
    "voice": "vo_adv_5220002_057",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "啊啊！",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "不行喔～",
    "voice": "vo_adv_5220002_058",
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n妳嘴上很會說，",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "卻完全沒發揮出性能。",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n缺乏危機意識還真傷腦筋呢～",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "意氣用事、",
    "voice": "vo_adv_5220002_059",
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "直線又單調的攻擊。",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "這種攻擊",
