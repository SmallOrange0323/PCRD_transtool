    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "居然會被這種程度的攻擊打傷，",
    "voice": "vo_adv_5220002_060",
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n即使妳才剛痊癒，也讓人有點失望呢。",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n這樣根本連熱身都稱不上～",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "唔……",
    "voice": "vo_adv_5220002_061",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "咕……！",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "但是，",
    "voice": "vo_adv_5220002_062",
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "這也沒辦法。",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n你們是AI，",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "跟我們不同──",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n說到底",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "就只是在模仿人類罷了。",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "反正都是最後了……",
    "voice": "vo_adv_5220002_063",
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n就讓妳見識見識",
    "voice": null,
    "unit_id": 106712
  },
  {
