  {
    "type": "dialogue",
    "name": "旁白",
    "words": "露製作了特製魔物料理、安表演了唱歌，\\n熱鬧的宴會正在如火如荼地進行中。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "109400401"
  },
  {
    "type": "dialogue",
    "name": "露",
    "words": "咯～",
    "voice": "vo_adv_1094004_000",
    "unit_id": 109311
  },
  {
    "type": "dialogue",
    "name": "露",
    "words": "吃得好飽～♪",
    "voice": null,
    "unit_id": 109311
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "對啊對啊～♪",
    "voice": "vo_adv_1094004_001",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "說什麼請大家好好地享用，",
    "voice": "vo_adv_1094004_002",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n不就是妳們兩個吃得最多嗎……？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "安小姐，",
    "voice": "vo_adv_1094004_003",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "剛才的歌聲真是扣人心弦。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "真的嗎？　",
    "voice": "vo_adv_1094004_004",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "太好了～！",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n欸嘿嘿……",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "古蕾婭也喜歡嗎？",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "安……",
    "voice": "vo_adv_1094004_005",
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "嗯。",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "\\n真的非常優美。",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "謝謝妳",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "唱給我聽。",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "嗯嗯！　",
    "voice": "vo_adv_1094004_006",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "只要妳喜歡，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "我也會很開心。",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "啊，",
    "voice": "vo_adv_1094004_007",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "對了！",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "吶吶，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "下次古蕾婭也一起唱吧？",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "一、",
    "voice": "vo_adv_1094004_008",
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "一起？　",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "可是我",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "對唱歌有點……",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那樣的話，",
    "voice": "vo_adv_1094004_009",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您要不要來演奏樂器呢？",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n這裡",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "剛好有手風琴。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "手風琴！　",
    "voice": "vo_adv_1094004_010",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "好耶，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "可可蘿，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "真是一個好主意～！",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n吶吶古蕾婭，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "彈吧彈吧～！",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "安真是的……",
    "voice": "vo_adv_1094004_011",
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "好啦，",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "我知道了。",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "\\n因為太突然了，",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "我不知道能不能好好地配合妳的歌聲哦？",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "沒問題沒問題！　",
    "voice": "vo_adv_1094004_012",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "我和古蕾婭一定辦得到，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "對吧！",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就這樣，幸福的時光轉瞬即逝。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500353"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "――從外面隱隱約約地傳來，某人正在哼著歌的聲音。\\n跟隨那美麗的歌聲，向前走去……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "……呼。",
    "voice": "vo_adv_1094004_013",
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "唔、",
    "voice": "vo_adv_1094004_014",
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "奇怪？　",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "哇……{0}！",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "\\n……",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "剛、",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "剛才的，",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "你都聽到了？",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "嗚嗚、",
    "voice": "vo_adv_1094004_015",
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "你全都聽到了對吧……",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "好害羞～……",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "因為晚上太開心了，",
    "voice": "vo_adv_1094004_016",
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "總覺得還有點興奮",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "睡不著覺……",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "於是試著出來散步後，",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "卻發現今天是個寂靜又美好的夜晚，",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "所以就……",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "……",
    "voice": "vo_adv_1094004_017",
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "不過，",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "這是一首很棒的歌曲對吧。",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "我聽說這是可可蘿教安",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "唱的歌曲……",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "想感謝她給我如此美妙的禮物，",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "晚點還得向可可蘿說才行。",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "還有{0}……",
    "voice": "vo_adv_1094004_018",
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "\\n安在練習唱歌的時候，",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "你一直都陪在她身邊對吧？",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "謝謝。",
    "voice": "vo_adv_1094004_019",
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "多虧有你，",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "我才能留下這麼美好的回憶。",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "那是一段十分明亮",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "又快樂、",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "閃閃發光的時光……",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "……和安在一起的時光",
    "voice": "vo_adv_1094004_020",
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "總是那麼地美好。",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "我之前說過吧？",
    "voice": "vo_adv_1094004_021",
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "我",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "來到馬納歷亞之後，",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "還是有點害怕和大家互動，",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "\\n所以就常常待在音樂塔……",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "這件事。",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "那天我也是",
    "voice": "vo_adv_1094004_022",
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "一如往常地一個人彈奏著鋼琴。",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "\\n然後――",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "安就出現在我的面前了。",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "對著這樣的我",
    "voice": "vo_adv_1094004_023",
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "搭了話……",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "陪我",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "一起彈奏鋼琴。",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "那時候的光景，",
    "voice": "vo_adv_1094004_024",
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "直到現在我都還記得很清楚。",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "我所看到的世界，",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "就像瞬間染上色彩一般……",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "\\n突然",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "眼前事物都綻放出耀眼的光芒似地。",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "……",
    "voice": "vo_adv_1094004_025",
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "你是不是覺得",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "我太誇張？",
    "voice": null,
