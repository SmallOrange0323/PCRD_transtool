  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在聖誕節這天，城鎮被染成一片雪白。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n克莉絲提娜、伊莉亞、望三人大顯身手（？）的事情，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n慢慢地在蘭德索爾傳開了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "嗯～",
    "voice": "vo_adv_5029003_000",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "好想來弄個規模大一點的惡作劇～",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "不過，陷阱和驚嚇箱我都玩膩了，",
    "voice": "vo_adv_5029003_001",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "雖然不管我做什麼哥哥都會上當，",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n但是難得的聖誕節，",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "玩大一點比較有意思～",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "嗯～？　",
    "voice": "vo_adv_5029003_002",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "好像有什麼東西從天上掉下來了？",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "這是什麼～",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "這個……",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "黑黑圓圓的，",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "該不會是……",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "炸彈？",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "好厲害！　",
    "voice": "vo_adv_5029003_003",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "好厲害喔！　",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "我還是第一次看到這麼大的炸彈！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "太棒了！　",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "有了這個哥哥一定會嚇一大跳的！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "background",
    "bg_id": "500110"
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "唉……",
    "voice": "vo_adv_5029003_004",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "聖誕節快要結束了……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n裝飾好的聖誕樹也得收起來……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "總覺得有點寂寞……",
    "voice": "vo_adv_5029003_005",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "要是外面",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "能有棵很大的聖誕樹，",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "就能一直享受聖誕節的氣氛了……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "咦咦！？　",
    "voice": "vo_adv_5029003_006",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "咦咦咦咦咦！？",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n外面，",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "竟然長出了一棵大樹……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "而且還一直扭來扭去……！？",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "這個是聖誕樹嗎？　",
    "voice": "vo_adv_5029003_007",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "可是，",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "它還在動……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "好可怕……！",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n這是什麼？　",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "該怎麼辦呢，",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "嗚嗚～",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "咲戀媽媽！",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "background",
    "bg_id": "500036"
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "妳向聖誕老人許了什麼願？",
    "voice": "vo_adv_5029003_008",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "我想要去",
    "voice": "vo_adv_5029003_009",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "旅行！　",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "哥哥你呢？",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "我想要",
    "voice": "vo_adv_5029003_010",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "一艘很大的飛空艇！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "啊！　",
    "voice": "vo_adv_5029003_011",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "那，我們一起搭乘那個飛空艇",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "去旅行嘛！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "\\n",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "希望聖誕老人",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "會來！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "嗯！",
    "voice": "vo_adv_5029003_012",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "喂，",
    "voice": "vo_adv_5029003_013",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "妳聽說了嗎？香織。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "聽說什麼～？　",
    "voice": "vo_adv_5029003_014",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "嚼嚼。",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "聽說蘭德索爾各處",
    "voice": "vo_adv_5029003_015",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "都有奇怪的事發生。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n像是有什麼奇怪的東西從天而降。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "從天空而降～？",
    "voice": "vo_adv_5029003_016",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "啊！　",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "該不會是",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "聖誕老人吧？",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "嚼嚼。",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "嚼嚼。",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "對耶，",
    "voice": "vo_adv_5029003_017",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "今天是聖誕節呢。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "話說，",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "妳從剛剛開始就一直在吃什麼東西啊？　",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我們還在巡邏耶？",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "妳說這個～？　",
    "voice": "vo_adv_5029003_018",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "剛剛從天上掉下來的～！",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "正好",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我肚子也餓了～♪",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "從天上……",
    "voice": "vo_adv_5029003_019",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "不會吧。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "【哞哞自衛隊】的那兩位！",
    "voice": "vo_adv_5029003_020",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n可以過來一下嗎！？",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "嗯？",
    "voice": "vo_adv_5029003_021",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "怎麼了！？",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "是竊盜案！　",
    "voice": "vo_adv_5029003_022",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "有小偷！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "那可不得了～！　",
    "voice": "vo_adv_5029003_023",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "嚼嚼！",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n什麼東西",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "被偷了？　",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "咕嚕！",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "飛空艇",
    "voice": "vo_adv_5029003_024",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "被偷了！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "……啊？",
    "voice": "vo_adv_5029003_025",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我在試飛新買的飛空艇的時候，",
    "voice": "vo_adv_5029003_026",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n被小偷襲擊了……！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "飛空艇……",
    "voice": "vo_adv_5029003_027",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "這種東西有辦法偷嗎……？",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "好像有人騎著馴鹿靠過來，",
    "voice": "vo_adv_5029003_028",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "然後一眨眼就不見了！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "總之，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "請妳們幫我找回來！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "在背後指使馴鹿的犯人一定是――",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "聖誕老人，不會錯的！",
    "voice": "vo_adv_5029003_029",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "真琴、香織",
    "words": "……聖誕老人？",
    "voice": "vo_adv_5029003_030",
    "unit_id": null
  },
