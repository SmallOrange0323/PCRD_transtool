  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "請看～♪",
    "voice": "vo_adv_9008006_000",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n大間那邊的漁協",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "送了本節目一條很漂亮的金槍鮪～！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "雖然當地曾有過島鯨事件那樣的艱辛時期，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不過今年聽說也是大豐收喔♪",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "貪吃佩可……",
    "voice": "vo_adv_9008006_001",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n就算妳在廣播節目上說「請看～」",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "聽眾們也是看不見的唷？",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊，",
    "voice": "vo_adv_9008006_002",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我都忘了～",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "欸嘿☆",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不過不過，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這看起來超級好吃耶！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我們今天要在播音間實際品嚐，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "替大家進行美食報導喔～！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "嗯。",
    "voice": "vo_adv_9008006_003",
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n這我喜歡。",
    "voice": null,
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "（嚼嚼）",
    "voice": null,
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "喔喔～！",
    "voice": "vo_adv_9008006_004",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "普蕾西亞",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "的吃相很豪邁呢！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我也不會輸的～！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嚼嚼☆",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "啊，",
    "voice": "vo_adv_9008006_005",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "妳們",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "不要只顧著吃，",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "要記得美食報導……",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "呃、",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "啊唔唔……",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "完全沒在聽……！",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "導演",
    "words": "優衣小姐──！",
    "voice": "vo_adv_9008006_006",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "導演",
    "words": "\\n麻煩妳撐場面，代替她們進行美食報導吧～♪",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "欸！？",
    "voice": "vo_adv_9008006_007",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我嗎！？",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "怎、",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "怎麼辦……！",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "唔唔唔……",
    "voice": "vo_adv_9008006_008",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "現在也只能",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "去做了對吧……！",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n好……！",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n──咬下！！",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "啊……！",
    "voice": "vo_adv_9008006_009",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "真驚人，",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "非常好吃！",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n明明口感十分清爽，",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "味道卻相當濃厚呢！",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "並且還入口即化……",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "雖然生魚片就很好吃了，",
    "voice": "vo_adv_9008006_010",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "但若拿瘦肉部位",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "搭配品質好一點的油和香草，",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n製成一道油燉魚肉料理，",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "應該會很不錯呢。",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "油脂較少的部分",
    "voice": "vo_adv_9008006_011",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "則可以做成酥炸魚肉，",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "既健康又好吃。",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "不曉得",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "騎士先生會比較喜歡哪種呢……",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "咦？",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "兩位",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "怎麼了嗎？",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "沒有啦……",
    "voice": "vo_adv_9008006_012",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "只是聽了優衣的這些話後……",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "讓我想繼續吃更多了！！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嚼嚼嚼～～～♪",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "啊姆。",
    "voice": "vo_adv_9008006_013",
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "嗯。",
    "voice": null,
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "啊……！？",
    "voice": "vo_adv_9008006_014",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "又開始吃了！？",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n話說",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "原本那麼大一條的金槍鮪，",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n竟已經越變越小……！",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "導演",
    "words": "麻煩",
    "voice": "vo_adv_9008006_015",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "導演",
    "words": "妳再繼續進行第二次美食報導喔──♪",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "咦咦咦咦咦！？",
    "voice": "vo_adv_9008006_016",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "請給我，",
