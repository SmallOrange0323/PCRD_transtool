[
  {
    "type": "background",
    "bg_id": "501622"
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "話說回來，",
    "voice": "vo_adv_5137422_000",
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "「紅霧精靈」真的很強耶！",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "不愧是守護世界的精靈啊──！",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "志那都跟埃拉被附身的時候，",
    "voice": "vo_adv_5137422_001",
    "unit_id": 128911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n我還想說不知道該怎麼辦才好呢。",
    "voice": null,
    "unit_id": 128911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "她們的戰鬥力",
    "voice": "vo_adv_5137422_002",
    "unit_id": 128812
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "原本就很驚人了，",
    "voice": null,
    "unit_id": 128812
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 128812
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "而紅霧精靈居然",
    "voice": null,
    "unit_id": 128812
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "操控那兩個人來攻擊我們。",
    "voice": null,
    "unit_id": 128812
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "能夠成功打倒精靈，",
    "voice": "vo_adv_5137422_003",
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "都是多虧有大家同心協力呢。",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "優衣、",
    "voice": "vo_adv_5137422_004",
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "怜、",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "騎士先生、",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "菲歐……",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "厄莉絲。",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "還有我……",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n以及埃拉跟志那都。",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "她們兩個直到最後的最後，",
    "voice": "vo_adv_5137422_005",
    "unit_id": 128812
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "都在抵抗精靈。",
    "voice": null,
    "unit_id": 128812
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 128812
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "所以精靈",
    "voice": null,
    "unit_id": 128812
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "也沒辦法奪走她們的一切吧。",
    "voice": null,
    "unit_id": 128812
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 128812
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就算她們失去自我意識也一樣。",
    "voice": null,
    "unit_id": 128812
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "是啊。",
    "voice": "vo_adv_5137422_006",
    "unit_id": 128911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n要是少了其中一個人，",
    "voice": null,
    "unit_id": 128911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "就沒有辦法打倒它了。",
    "voice": null,
    "unit_id": 128911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "所以……",
    "voice": "vo_adv_5137422_007",
    "unit_id": 128911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "謝謝妳，",
    "voice": "vo_adv_5137422_008",
    "unit_id": 128911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "厄莉絲。",
    "voice": null,
    "unit_id": 128911
  }
]
