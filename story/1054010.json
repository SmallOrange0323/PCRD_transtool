    "name": "紡希",
    "words": "……騎士先生同意幫忙了。",
    "voice": "vo_adv_1054010_082",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n我對男裝組的服飾",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "完全沒有信心……不過，",
    "voice": null,
    "unit_id": 105411
