    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "不光是穿起來要舒適合身，",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n也得讓騎士先生看起來很帥氣才行！　",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "……我的苦瓜臉不見了？",
