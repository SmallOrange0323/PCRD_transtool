  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "很難為情就是。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "\\n",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "其實是今天",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "排打工的人",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "臨時請假……",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "因為以餐車兜售的工作，",
    "voice": "vo_adv_1135003_006",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "如果人手不足，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "就會留下庫存。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "\\n所以我現在很頭痛，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "不曉得該怎麼辦。",
