    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "嗯……",
    "voice": "vo_adv_1135003_001",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "真是頭痛啊。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "\\n再這樣下去會……",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "美里",
