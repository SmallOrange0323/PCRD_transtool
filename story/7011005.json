    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "既然如此，",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我只有切腹謝罪……",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "住手啊。",
    "voice": "vo_adv_7011005_079",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "妳如果切腹的話，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我不就得跟著妳一起切腹嗎？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "大姐頭……",
    "voice": "vo_adv_7011005_080",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "難道",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "大姐頭也做夢了？",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "是啊。",
    "voice": "vo_adv_7011005_081",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我夢見妳在我的店裡工作。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不過，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "妳，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "噗哧、",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "哈哈哈……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "怎、",
    "voice": "vo_adv_7011005_082",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "怎麼了？",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不是，",
    "voice": "vo_adv_7011005_083",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "說到妳啊，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "連在夢裡都採取同樣的行動，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n真的好滑稽，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "呵呵、",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "哈哈哈哈哈！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "哎呀哎呀……",
    "voice": "vo_adv_7011005_084",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "實在太丟臉了是也。",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那麼，",
    "voice": "vo_adv_7011005_085",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小哥，接下來你打算怎麼辦？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n還要繼續搜索嗎？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "喔！　",
    "voice": "vo_adv_7011005_086",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "將軍也是嗎？",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我現在也覺得",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "超想吃魚！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "哎呀哎呀，",
    "voice": "vo_adv_7011005_087",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "比起記憶更在意吃的嗎？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "算了，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "雖然這麼說",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "但我也肚子餓了呢。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "看起來應該沒辦法繼續搜索下去了。",
    "voice": "vo_adv_7011005_088",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n之後改天再來吧。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "將軍、",
    "voice": "vo_adv_7011005_089",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "大姐頭，",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "今天真的謝謝你們！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我決定",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "繼續精進自己，",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "一定要成為最傑出的臣子！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "雖然沒有達成目的，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n不過3人都一臉滿足地離開了露娜之塔。",
