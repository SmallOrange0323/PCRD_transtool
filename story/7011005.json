[
  {
    "type": "background",
    "bg_id": "500430"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "羈絆漸漸加深的流夏和妮諾，在不知不覺間開始展現出",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n絕佳的默契。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "斬裂吧！　",
    "voice": "vo_adv_7011005_000",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "忍法‧",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "木之葉旋風之術！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "——咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "雖然只是撒葉子而已，",
    "voice": "vo_adv_7011005_001",
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "但足以擾亂敵軍了！",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這樣就結束了！　",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "喝啊！",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "background",
    "bg_id": "500430"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "――嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "好刀法！　",
    "voice": "vo_adv_7011005_002",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "讓人不禁看得入迷是也！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "妳的忍法也不遑多讓啊。",
    "voice": "vo_adv_7011005_003",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那麼，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "剛剛打倒的好像是這層的主人，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "也差不多該獲得一些線索了啊。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "快看，",
    "voice": "vo_adv_7011005_004",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "將軍、",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "大姐頭！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n被打倒的魔物身上，",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "好像有東西跑出來了！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "哇喔！　",
    "voice": "vo_adv_7011005_005",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "好漂亮的石頭是也。",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "這一定是某種寶物是也！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "喂，",
    "voice": "vo_adv_7011005_006",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不要隨便摸它！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "哇喔！　",
    "voice": "vo_adv_7011005_007",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "好、",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "好刺眼！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "石頭發出了強烈光芒是也！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "嗚，",
    "voice": "vo_adv_7011005_008",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小哥！　",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "妮諾！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "background",
    "bg_id": "510290"
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "很好，",
    "voice": "vo_adv_7011005_009",
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "完成了！　",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小哥，",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這個也幫我擺上去吧。",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就算奉承我，",
    "voice": "vo_adv_7011005_010",
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "也只能拿到魚頭之類的東西喲。",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不過，",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你也真好事。",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "難得的休假日",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "居然還來店裡幫忙。",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "怎麼連你都這樣，",
    "voice": "vo_adv_7011005_011",
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "別再開玩笑了！",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "賣魚的不需要收小弟，",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "拜託你饒了我吧。",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……然後，",
    "voice": "vo_adv_7011005_012",
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "從剛剛開始",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "一直在偷看這裡的",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n那個金髮女孩",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "是你的朋友嗎？",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "雖然她試圖躲藏在電線桿後面，",
    "voice": "vo_adv_7011005_013",
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不過很可惜行蹤早就曝光囉。",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "是、",
    "voice": "vo_adv_7011005_014",
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "是嗎？　",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "但是她怎麼散發出",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "一股不太尋常，\\n近似執念的氣息……",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "冷靜一點。",
    "voice": "vo_adv_7011005_015",
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我完全聽不懂你在說什麼。",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "總而言之，",
    "voice": "vo_adv_7011005_016",
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "至少知道她是你認識的人了。",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "雖然我不太想和她扯上關係，",
    "voice": "vo_adv_7011005_017",
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n不過萬一她在店附近做出奇怪舉動，那就傷腦筋了。",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "喂～",
    "voice": "vo_adv_7011005_018",
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那邊那位金髮姑娘！　",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "妳找我們有什麼事嗎？",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "什、",
    "voice": "vo_adv_7011005_019",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "什麼！　",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我的隱身術居然被識破了！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "難、",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "難道",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "她會傳說中的心眼術嗎！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "能讓",
    "voice": "vo_adv_7011005_020",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "將軍另眼相看的人，",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "果然不是簡單人物！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "哎呀，",
    "voice": "vo_adv_7011005_021",
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "好像比想像中還要麻煩啊。",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "總而言之，先過來這邊吧？",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "那、",
    "voice": "vo_adv_7011005_022",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "那麼，",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "打擾了。",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "登登登！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "不是的，",
    "voice": "vo_adv_7011005_023",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "今天",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我是來",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "拜見那位",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "太刀洗流夏大人！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "嗯？　",
    "voice": "vo_adv_7011005_024",
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "妳怎麼知道我的名字？",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "因為",
    "voice": "vo_adv_7011005_025",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "是將軍告訴我的！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你啊，",
    "voice": "vo_adv_7011005_026",
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "難道不懂什麼叫個人資料嗎？",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "真拿你沒辦法，",
    "voice": "vo_adv_7011005_027",
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "真是的。",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "總而言之小姑娘，",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "妳到底找我有什麼事？",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "如果妳只是來找我買魚，",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我倒是很高興。",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "流夏大人，",
    "voice": "vo_adv_7011005_028",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "不對，",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "武士大師！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n請將我、",
    "voice": null,
