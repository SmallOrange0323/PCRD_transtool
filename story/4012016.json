    "words": "咦？",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n難不成是交換身體了？",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "成人苑",
    "words": "因為啊，",
    "voice": "vo_adv_4012016_002",
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "成人苑",
    "words": "今天要去找素材的洞窟",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "成人苑",
    "words": "\\n非常狹窄，",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "成人苑",
    "words": "望是進不去深處的。",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "成人苑",
    "words": "\\n想說由嬌小的彩羽代替妳去。",
    "voice": null,
    "unit_id": 132712
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "哇，",
    "voice": "vo_adv_4012016_003",
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "真令人放心！",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那就麻煩了……",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "啊，",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "咦，",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這麼說來，",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n露易製作的交換身體祕藥，",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "記得就幾分鐘……",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "小孩彩羽",
    "words": "哇哈哈哈──！",
    "voice": "vo_adv_4012016_004",
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "小孩彩羽",
    "words": "\\n那就Let's go……",
    "voice": null,
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "小孩彩羽",
    "words": "\\n",
    "voice": null,
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "小孩彩羽",
    "words": "哇啊啊！？",
    "voice": null,
    "unit_id": 132612
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "……咦咦咦！？",
    "voice": "vo_adv_4012016_005",
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n回來了！？",
    "voice": null,
    "unit_id": 132412
  },
