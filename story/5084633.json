  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "就算試著開著這樣的玩笑，",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "也只感覺到空虛而已呢……",
