  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "宮子遠遠地走在前頭，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}與千歌好不容易才跟上了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "太棒了呦！",
    "voice": "vo_adv_7016003_000",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "輕輕鬆鬆來的！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "就照這個節奏繼續前進！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "精靈",
    "words": "──！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "嗯嗯，",
    "voice": "vo_adv_7016003_001",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "那個，",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "差不多該……",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "嗯，",
    "voice": "vo_adv_7016003_002",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是啊。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "宮子小姐！",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "請等一下！",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "已經要休息了嗎？",
    "voice": "vo_adv_7016003_003",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n真的是拿你們沒辦法。",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "或者說還有布丁嗎！？",
    "voice": "vo_adv_7016003_004",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "已經沒有布丁了……",
    "voice": "vo_adv_7016003_005",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "那就趕快前進吧！",
    "voice": "vo_adv_7016003_006",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n趕快結束，再給人家布丁～！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "那個……",
    "voice": "vo_adv_7016003_007",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "宮子小姐，",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "妳從剛剛看起來就心情不太好……",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "……沒有那種事。",
    "voice": "vo_adv_7016003_008",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子只要有布丁，心情一直都很好的呦。",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "不過現在已經沒有布丁就是了……",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是剛剛",
    "voice": "vo_adv_7016003_009",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "和【惡魔偽王國軍】的大家說過話之後\\n開始的吧？",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "就說那個話題已經結束了啦！",
    "voice": "vo_adv_7016003_010",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "如果發生了什麼事，",
    "voice": "vo_adv_7016003_011",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "能說說詳細經過嗎？",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "而且這孩子看起來也很在意……",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "精靈",
    "words": "──！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "最重要的是，",
    "voice": "vo_adv_7016003_012",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "如果這件事我們能助上一臂之力，我們也希望幫上忙。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "……人家知道了。",
    "voice": "vo_adv_7016003_013",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n既然你們都這麼說了，就告訴你們吧。",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "好的……",
    "voice": "vo_adv_7016003_014",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "前陣子",
    "voice": "vo_adv_7016003_015",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "是公會創建紀念日，",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n大家一起準備了豪華的布丁……",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "那可是很豪華的布丁耶！",
    "voice": "vo_adv_7016003_016",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "可是……",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "可是……？",
    "voice": "vo_adv_7016003_017",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子只是先吃了布丁而已，",
    "voice": "vo_adv_7016003_018",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n大家就突然生氣了！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n他們太奇怪了！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "這也太……",
    "voice": "vo_adv_7016003_019",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "對、",
    "voice": "vo_adv_7016003_020",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "對啊……",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "再怎麼說這也是宮子小姐不對……",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "真是的，",
    "voice": "vo_adv_7016003_021",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "什麼嘛！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "你們也和大家說一樣的話！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是、",
    "voice": "vo_adv_7016003_022",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是大家不對嗎？",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "沒錯呦！",
    "voice": "vo_adv_7016003_023",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "你們果然瞭解呢！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是、",
    "voice": "vo_adv_7016003_024",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是嗎？",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "再怎麼說也是",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "公會的大家比較可憐不是嗎？",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "反正那也是為了讓宮子吃掉才準備來的！",
    "voice": "vo_adv_7016003_025",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "既然如此，還因為人家吃了而生氣，太奇怪了吧！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "他們會那樣生氣，",
    "voice": "vo_adv_7016003_026",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "是因為根本不在乎宮子來的！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n人家最討厭那些薄情的人了！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我覺得",
    "voice": "vo_adv_7016003_027",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "不是這樣……",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "那是紀念日對吧？",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "既然如此，",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "什麼時候、",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "和誰一起吃應該很重要才是。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "大家一定是",
    "voice": "vo_adv_7016003_028",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "想要一邊和宮子小姐一起",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "慶祝，\\n一邊享用吧？",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "正因為她們很重視與宮子小姐之間的回憶，",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "所以才會生氣……",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "人家才不知道！",
    "voice": "vo_adv_7016003_029",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "比起不能吃的回憶，",
    "voice": "vo_adv_7016003_030",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "可以吃的布丁更重要來的！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "就算這樣！",
    "voice": "vo_adv_7016003_031",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "……就算這樣，",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我還是覺得，是不重視與大家之間回憶的\\n宮子小姐不對。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "人家知道了。",
    "voice": "vo_adv_7016003_032",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "宮子小姐……",
    "voice": "vo_adv_7016003_033",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "千歌也和大家一樣！",
    "voice": "vo_adv_7016003_034",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "根本不在乎宮子！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n人家完──全明白了！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "宮子小姐！",
    "voice": "vo_adv_7016003_035",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "人家不管了！",
    "voice": "vo_adv_7016003_036",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "不進什麼千歌的公會了！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n就在這裡分道揚鑣來的！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "再見呦！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "哼！",
    "voice": "vo_adv_7016003_037",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "宮子小……",
    "voice": "vo_adv_7016003_038",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "走掉了呢……",
    "voice": "vo_adv_7016003_039",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "對不起，",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我說得太過份了……",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "精靈",
    "words": "──！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "抱歉……",
    "voice": "vo_adv_7016003_040",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我說得那麼大聲，",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "還嚇到你……",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "謝謝你這麼安慰我。",
    "voice": "vo_adv_7016003_041",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n你很溫柔呢……",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "可是，",
    "voice": "vo_adv_7016003_042",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我卻傷害了宮子小姐……",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "如果",
    "voice": "vo_adv_7016003_043",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "還能見到宮子小姐，",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我想要好好向她道歉。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "如果還能見到的話……",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "……是啊。",
    "voice": "vo_adv_7016003_044",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
