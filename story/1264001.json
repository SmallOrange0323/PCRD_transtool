  },
  {
    "type": "background",
    "bg_id": "501660"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "收到「吉歐‧提格尼亞」人們的加油打氣後，隔天──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n準備旅行的兩人，向普蕾西亞請教了",
    "voice": null,
