    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "很抱歉！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "嗯啊！？",
    "voice": "vo_adv_1264001_066",
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "\\n",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "太……",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "太過分了～～～！！",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "\\n老夫辛辛苦苦特地拿過來的……！！",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "這樣的話就用更不起眼的……",
    "voice": "vo_adv_1264001_067",
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "\\n對了，",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "現在正好可以把剛開發的新裝備帶過來……",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "\\n不，",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
