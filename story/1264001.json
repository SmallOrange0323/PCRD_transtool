    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "克蘿～～",
    "voice": "vo_adv_1264001_052",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "茜～～～～！！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "啊！",
    "voice": "vo_adv_1264001_053",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n波波爺爺！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "這裡、",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "我在這裡喔～！！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "老夫聽說了，",
    "voice": "vo_adv_1264001_054",
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "克蘿茜！",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "\\n妳",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "要去小伙子的世界？",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "\\n",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "為什麼這麼重要的事情",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "沒有來跟老夫說啊！",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "對不起～！",
    "voice": "vo_adv_1264001_055",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n我本來正打算去跟你說的～！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "真是的妳這傢伙……",
    "voice": "vo_adv_1264001_056",
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "\\n",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "算了，",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "先不說這個。",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "\\n老夫可不是來這裡發牢騷的。",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "今天是來這裡──",
    "voice": "vo_adv_1264001_057",
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "\\n",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "給妳這個東西的──────！！！",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "哇哇！？",
    "voice": "vo_adv_1264001_058",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n這、",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "這是──！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n之前那個",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "超巨大手臂不是嗎～！！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "嘎哈哈！！",
    "voice": "vo_adv_1264001_059",
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "\\n不是只有這樣喔？",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "\\n老夫還斟酌挑選了適合旅行的強化零件！",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "首先是這個鑽頭！",
    "voice": "vo_adv_1264001_060",
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "經過不斷改良後變得更巨大了喔！",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "\\n然後是可以提升腳部動力的",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "外部元件！",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "\\n當然它的火力是我掛保證的！！",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "哇～！",
    "voice": "vo_adv_1264001_061",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n不管哪個都很大呢！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "確實很大！",
    "voice": "vo_adv_1264001_062",
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "\\n",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "不過",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "大比小更有活力！",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "\\n有活力就是好事！！",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "你～在說什麼，",
    "voice": "vo_adv_1264001_063",
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "醒目比不起眼好多了吧！",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "\\n",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "……嗯？",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "\\n稍等一下，",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "難道不起眼比較好嗎？",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "嗯──",
    "voice": "vo_adv_1264001_064",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "這我就不曉得了呢──？",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n不過，",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "如果太大的話另一邊的人可能會嚇一跳？",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "那就",
    "voice": "vo_adv_1264001_065",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "不行呢！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "波波爺爺，",
