    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "我就知道！　",
    "voice": "vo_adv_1070001_004",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "這裡這裡！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "\\n",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "我來替你帶路！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "鸚鵡",
    "words": "麻煩你啦！　",
    "voice": "vo_adv_1070001_005",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鸚鵡",
    "words": "麻煩你啦！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500170"
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "我之前有聽姐姐說過。",
    "voice": "vo_adv_1070001_006",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "\\n她說在城鎮的店裡買了鸚鵡。",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "到了！　",
    "voice": "vo_adv_1070001_007",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "這深處裡有個洞窟，",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "姐姐的家就在那裡！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "\\n這裡有點暗，",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "但別擔心。",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "跟著我來！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "background",
    "bg_id": "500250"
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "姐姐～！　",
    "voice": "vo_adv_1070001_008",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "大哥哥",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "把鸚鵡送過來了！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "哎呀，真的呢。",
    "voice": "vo_adv_1070001_009",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "你把他給帶來了啊。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "誒嘿嘿～！　",
    "voice": "vo_adv_1070001_010",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "那我要走囉！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "\\n幫我和老闆問個好！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "……歡迎你，",
    "voice": "vo_adv_1070001_011",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "甦醒的公主騎士。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "主人在等你。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n我帶你去見她。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "background",
    "bg_id": "500341"
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "客人來了，",
    "voice": "vo_adv_1070001_012",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "主人。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n我把{0}先生帶來了。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "still",
    "still_id": "107000101"
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "這裡是",
    "voice": "vo_adv_1070001_013",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我的研究設施。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "歡迎你的到來。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "鸚鵡",
    "words": "……有勞妳了。",
    "voice": "vo_adv_1070001_014",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鸚鵡",
    "words": "妳回入口繼續看守吧。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "遵命。",
    "voice": "vo_adv_1070001_015",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "主人。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "小的前去執行任務。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "鸚鵡",
    "words": "那麼，",
    "voice": "vo_adv_1070001_016",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鸚鵡",
    "words": "我也差不多要回去本體了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鸚鵡",
    "words": "\\n這趟長途之旅",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鸚鵡",
    "words": "辛苦你了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "那隻鸚鵡是我創造出來的虛假之物。",
    "voice": "vo_adv_1070001_017",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n剛才的光芒",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "就是將那鸚鵡變成魔力收回進我體內了。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我們又見面了。{0}。",
    "voice": "vo_adv_1070001_018",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……莫非你",
    "voice": "vo_adv_1070001_019",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "失去記憶了……？",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我現在開始替你診斷。",
    "voice": "vo_adv_1070001_020",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n讓我稍微碰觸你一會。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "可以吧？",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……原來如此。",
    "voice": "vo_adv_1070001_021",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "這就等同於只有容器甦醒了呢。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "連行為記憶等等也都喪失……",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "能活著近乎是奇蹟了。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "嗯……",
    "voice": "vo_adv_1070001_022",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "大致的情況我明白了。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "健康狀態沒有問題。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "自我介紹晚了。",
    "voice": "vo_adv_1070001_023",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我是……",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "比其他一般的人",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n還稍微親切的姐姐。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "可以吧？",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "still",
    "still_id": "107000102"
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "對。",
    "voice": "vo_adv_1070001_024",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "我是姐姐。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "這麼坦率，很好。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "要是透露出太多我的情報會過於危險，",
    "voice": "vo_adv_1070001_025",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "\\n現在不報上名號才是明智之舉吧。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "其實",
    "voice": "vo_adv_1070001_026",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "有關於這次的委託，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "\\n是有熟人拜託我，希望我能照顧你。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "那雖然是我創造的虛假之物，",
    "voice": "vo_adv_1070001_027",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "但做得太完美了，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "\\n結果變得不聽從我這裡的命令。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "這次湊巧請熟人替我回收那東西，",
    "voice": "vo_adv_1070001_028",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "\\n於是想機會正好，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "就委託你送過來了。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "嗯，",
    "voice": "vo_adv_1070001_029",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "就是這樣。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "我從今天開始",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "會教你這個世界的常識。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "background",
    "bg_id": "500341"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "……那全都是謊言喔。",
    "voice": "vo_adv_1070001_030",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "但現在的你不會注意到吧。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "真正的虛假之物們正在大陸各地進行監視，",
    "voice": "vo_adv_1070001_031",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "我知道你的出現，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "並利用委託企圖與你接觸。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "我雖然躲避真那與晶的耳目，",
    "voice": "vo_adv_1070001_032",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "暗中監視你的動向，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "但卻無法掌握你的言行舉止像個幼兒般的理由。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "看來你是在那場戰鬥中",
    "voice": "vo_adv_1070001_033",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "承受了過重的傷害呢……",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "失去的一般常識等等，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "我也來替你補足吧。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "促使你成長，",
    "voice": "vo_adv_1070001_034",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "應該能讓你",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "再次與真那對峙。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "姊姊",
    "words": "\\n……",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
