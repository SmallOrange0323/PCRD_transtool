    "voice": "vo_adv_5088007_043",
    "unit_id": 102611
  },
  {
    "type": "background",
    "bg_id": "500156"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "又到了另一天，在【牧場】的公會小屋──",
