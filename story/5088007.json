    "unit_id": 15912
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "什麼！？",
    "voice": "vo_adv_5088007_038",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "啾三",
    "words": "雖然我發誓不再為非作歹，",
    "voice": "vo_adv_5088007_039",
    "unit_id": 15912
  },
  {
    "type": "dialogue",
    "name": "啾三",
    "words": "但是那麼輕易就被一擊打倒，",
    "voice": null,
    "unit_id": 15912
  },
  {
    "type": "dialogue",
    "name": "啾三",
    "words": "\\n讓我覺得自己很不中用……",
    "voice": null,
    "unit_id": 15912
  },
  {
    "type": "dialogue",
    "name": "啾三",
    "words": "我只是單純",
    "voice": null,
    "unit_id": 15912
  },
  {
    "type": "dialogue",
    "name": "啾三",
    "words": "想變強！",
    "voice": null,
    "unit_id": 15912
  },
  {
    "type": "dialogue",
    "name": "啾三",
    "words": "\\n大姐，",
    "voice": null,
    "unit_id": 15912
  },
  {
    "type": "dialogue",
    "name": "啾三",
    "words": "求求妳……！",
    "voice": null,
    "unit_id": 15912
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "等等，",
    "voice": "vo_adv_5088007_040",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "別這樣啦！",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我可不做那種事哦！",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "唉，",
    "voice": "vo_adv_5088007_041",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "但是，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n那時我很抱歉，",
    "voice": null,
    "unit_id": 102611
  },
  {
