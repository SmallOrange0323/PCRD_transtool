  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "薇歐莉特。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n公主三人的全力攻擊，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "把以米奈娃為目標被引誘來的幻境龍后，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n連同露娜之塔的最上層一起粉碎了──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "……啊啊……",
    "voice": "vo_adv_2217001_001",
    "unit_id": 107411
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "我",
    "voice": "vo_adv_2217001_002",
    "unit_id": 107411
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "死了。",
    "voice": null,
    "unit_id": 107411
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "這就是",
    "voice": "vo_adv_2217001_003",
    "unit_id": 107411
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "生命的終結。",
    "voice": null,
    "unit_id": 107411
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n這就是",
    "voice": null,
    "unit_id": 107411
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "臨終。",
    "voice": null,
    "unit_id": 107411
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n這個，",
    "voice": null,
    "unit_id": 107411
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "我所恐懼的",
    "voice": null,
    "unit_id": 107411
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "正是這個。",
    "voice": null,
    "unit_id": 107411
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "悲傷、",
    "voice": "vo_adv_2217001_004",
    "unit_id": 107411
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "空虛、",
    "voice": null,
    "unit_id": 107411
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "痛苦、",
    "voice": null,
    "unit_id": 107411
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "難受。",
    "voice": null,
    "unit_id": 107411
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n",
    "voice": null,
    "unit_id": 107411
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "我這一生",
    "voice": null,
    "unit_id": 107411
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "究竟是什麼呢？",
    "voice": null,
    "unit_id": 107411
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "在我還沒有形成自我意識時，",
    "voice": "vo_adv_2217001_005",
    "unit_id": 107411
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "我獨自一人迫降在",
    "voice": null,
    "unit_id": 107411
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n一顆擠滿了不同種族的星球上。",
    "voice": null,
    "unit_id": 107411
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "就這樣不停躲藏，",
    "voice": null,
    "unit_id": 107411
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "不停逃跑，",
    "voice": null,
    "unit_id": 107411
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "不停恐懼。",
    "voice": null,
    "unit_id": 107411
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n如果就此結束，",
    "voice": null,
    "unit_id": 107411
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "這就會成為我一生的全部。",
    "voice": null,
    "unit_id": 107411
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "………………",
    "voice": "vo_adv_2217001_006",
    "unit_id": 107411
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "我還",
    "voice": "vo_adv_2217001_007",
    "unit_id": 107411
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n不能結束。",
    "voice": null,
    "unit_id": 107411
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "我",
    "voice": "vo_adv_2217001_008",
    "unit_id": 107411
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "還沒得到容身之處。",
    "voice": null,
    "unit_id": 107411
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n我",
    "voice": null,
    "unit_id": 107411
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "還沒有感受到生命。",
    "voice": null,
    "unit_id": 107411
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n我",
    "voice": null,
    "unit_id": 107411
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "還沒有抵達未來。",
    "voice": null,
    "unit_id": 107411
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "既然如此，",
    "voice": "vo_adv_2217001_009",
    "unit_id": 107411
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n",
    "voice": null,
    "unit_id": 107411
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "即便",
    "voice": null,
    "unit_id": 107411
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "要承擔無法返回的風險──",
    "voice": null,
    "unit_id": 107411
  },
  {
    "type": "still",
    "still_id": "221609803"
  },
  {
    "type": "dialogue",
    "name": "一夥",
    "words": "「！！！！」",
    "voice": "vo_adv_2217001_010",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "「──幻境龍后！！！」",
    "voice": "vo_adv_2217001_011",
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "「那個模樣是……！？」",
    "voice": "vo_adv_2217001_012",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "為了以防萬一，",
    "voice": "vo_adv_2217001_013",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "我對角色實施的緊急處理。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n以我的HP歸零為觸發條件所發動的",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "中斷處理。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n不……",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "身為遊戲開發者，",
    "voice": "vo_adv_2217001_014",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "這應該稱呼為──",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "「第二型態」",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "吧。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "「唔……！」",
    "voice": "vo_adv_2217001_015",
    "unit_id": 106118
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "那麼。",
    "voice": "vo_adv_2217001_016",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n讓我們將恐懼，",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "徹底驅散吧──",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "still",
    "still_id": "221609803"
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "──「致命視界‧",
    "voice": "vo_adv_2217001_017",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "具現」。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "「！！！」",
    "voice": "vo_adv_2217001_018",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "………………",
    "voice": "vo_adv_2217001_019",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "要處理",
    "voice": "vo_adv_2217001_020",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n超越規格的性能，還真是困難呢。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "畢竟連同有塔在內的島……",
    "voice": "vo_adv_2217001_021",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "不，",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n連同區域一起徹底消除的話，",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "感覺就會出問題。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "而且──",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "「……",
    "voice": "vo_adv_2217001_022",
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "唔……」",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "妳把夥伴保護得真好呢，",
    "voice": "vo_adv_2217001_023",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "米奈娃。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n不愧是這個世界的管理者。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "不過管理AI感到痛苦",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "究竟有什麼意義，",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "我倒是存疑。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "「……她的輸出",
    "voice": "vo_adv_2217001_024",
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "\\n甚至超越了[rub:我]管理者[/rub]",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "的最大值……？",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "\\n",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "那種",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "事是……」",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "管理者。",
    "voice": "vo_adv_2217001_025",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n那確實",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "是很了不起。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "但妳忘了嗎？",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "我",
    "voice": "vo_adv_2217001_026",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "可是創造者喔。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "「……！",
    "voice": "vo_adv_2217001_027",
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "\\n",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "怎麼會這樣……",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "\\n是作為遊戲製作者……",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "事先植入了",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "米奈娃",
    "words": "專用的強化更新……？」",
    "voice": null,
    "unit_id": 191112
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "這種程度的強化",
    "voice": "vo_adv_2217001_028",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "當然有風險，",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "我原本",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "就為了不被其他七冠看出來，",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n而必須悄悄植入了。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "不過──",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "迷宮女王",
    "voice": "vo_adv_2217001_029",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "模索路晶給了我很好的提示。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n那就是她所隱藏的，",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
