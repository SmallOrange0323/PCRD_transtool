  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "哼，",
    "voice": "vo_adv_9500095_021",
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "可別敷衍了事啊！",
