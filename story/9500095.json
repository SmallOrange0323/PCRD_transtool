[
  {
    "type": "background",
    "bg_id": "509040"
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "哈──哈哈！",
    "voice": "vo_adv_9500095_000",
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "居然選了我！",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n你也蠻有眼光的嘛。",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "好，",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "大壞蛋諾維姆大人",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "就助你一臂之力吧！",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "呃，",
    "voice": "vo_adv_9500095_001",
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "可以嗎？",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "我是壞人喔？",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "最後世界被顛覆也",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "別後悔喔。",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "如果就算這樣你還要選我，",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "那膽子還真不小！",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "不過，公主啊……",
    "voice": "vo_adv_9500095_002",
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "我這種大壞蛋竟也能被選上！",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "哈哈哈！",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "不，",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "這不好笑吧。",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "你知道吧，",
    "voice": "vo_adv_9500095_003",
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "我心中",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "早有認定的夥伴，",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n你跟",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "那種夥伴不同。",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "雖然不同……",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "可你為什麼要選我？",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "……嘿嘿！",
    "voice": "vo_adv_9500095_004",
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "這樣啊，",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "既然如此，就交給我吧！",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "──哦？這傢伙剛剛發光了……！",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "你也很有幹勁嗎，",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "天樓霸斷劍！",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "第一次持有這傢伙時，",
    "voice": "vo_adv_9500095_005",
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "便有句話出現在我腦中──",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n「獲得此劍之人啊。",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "當統御繁星者迷惘時，",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n霸斷天樓，",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "拯救世界吧。",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "當[rub:兇駭]兇駭[/rub]災厄從天而降時，",
    "voice": "vo_adv_9500095_006",
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n霸斷[rub:天光]天光[/rub]，",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "統御世界吧」。",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "雖然[rub:這傢伙]劍[/rub]跟我都曾經被",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "幻境龍后折斷過一次──",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "是因為尾狗刀、",
    "voice": "vo_adv_9500095_007",
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "晶和你幫助了我，",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "我才能振作起來無數次。",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n就像月亮跟星星一般，",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "再次升起。",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n所以──",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "──約好了，",
    "voice": "vo_adv_9500095_008",
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "我會",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "跟夥伴一起",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "跑在你前頭。",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n我們會不斷散發出光芒，",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "照亮前方。",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n所以你把",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "大家帶來吧！",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "嘿嘿，",
    "voice": "vo_adv_9500095_009",
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "你記得很清楚嘛。",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n被你這麼叫，",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "感覺果然不壞。",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "要上囉！",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "世界第一的大壞蛋要通過啦！",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "咦，",
    "voice": "vo_adv_9500095_010",
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "你也要當壞蛋！？",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "唔、",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "嗯……",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "……我",
    "voice": "vo_adv_9500095_011",
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "是覺得你不太適合啦～",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "但",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "感覺很好玩……",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "不不不……",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "──不行，",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "我是笨蛋，無法判斷！",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "在這種時候，",
    "voice": "vo_adv_9500095_012",
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "問夥伴是最好的辦法！",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "──喂，",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "尾狗刀！",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "──嗯？",
    "voice": "vo_adv_9500095_013",
    "unit_id": 106241
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n諾維姆，幹嘛，",
    "voice": null,
    "unit_id": 106241
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "怎麼了──？",
    "voice": null,
    "unit_id": 106241
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106241
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "……嗯嗯……",
    "voice": null,
    "unit_id": 106241
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "哦──",
    "voice": "vo_adv_9500095_014",
    "unit_id": 106241
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106241
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "嗯，",
    "voice": null,
    "unit_id": 106241
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "很好啊。",
    "voice": null,
    "unit_id": 106241
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "好隨便！？",
    "voice": "vo_adv_9500095_015",
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n尾狗刀，",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "你這樣真的好嗎！？",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "因為──",
    "voice": "vo_adv_9500095_016",
    "unit_id": 106241
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "{0}也是個超～壞的傢伙喔。",
    "voice": null,
    "unit_id": 106241
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106241
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "他攻陷的女孩數量，",
    "voice": null,
    "unit_id": 106241
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106241
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "兩隻手都數不清吧～？",
    "voice": null,
    "unit_id": 106241
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "啊──",
    "voice": "vo_adv_9500095_017",
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "原來如此。",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "哈哈哈哈哈！",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n什麼嘛，",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "原來你",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "也是個壞人啊，{0}！",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "那沒問題！",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "兩個壞蛋",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "就彼此聯手吧！",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "大壞蛋天團，",
    "voice": "vo_adv_9500095_018",
    "unit_id": 106241
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "成軍。",
    "voice": null,
    "unit_id": 106241
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106241
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "順便說一句──",
    "voice": null,
    "unit_id": 106241
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "我不會把諾維姆",
    "voice": null,
    "unit_id": 106241
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "交給你的。",
    "voice": null,
    "unit_id": 106241
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106241
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "就這樣，拜託你啦──",
    "voice": null,
    "unit_id": 106241
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "喂！！！？",
    "voice": "vo_adv_9500095_019",
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "諾維姆",
    "words": "\\n喂，尾狗刀，你在說什麼啊！！？",
    "voice": null,
    "unit_id": 106141
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "哈哈，",
    "voice": "vo_adv_9500095_020",
    "unit_id": 106241
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "細節什麼的",
    "voice": null,
    "unit_id": 106241
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "之後再商量──",
    "voice": null,
    "unit_id": 106241
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n總之，先打倒",
    "voice": null,
    "unit_id": 106241
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "幻境龍后",
    "voice": null,
    "unit_id": 106241
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "吧。",
    "voice": null,
    "unit_id": 106241
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n我會在後方支援，",
    "voice": null,
    "unit_id": 106241
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "最後一擊就交給你們了。",
