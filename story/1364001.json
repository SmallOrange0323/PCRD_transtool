    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "差不多是那樣。",
    "voice": "vo_adv_1364001_026",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "詳細內容不方便多說，",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "但是我正在調查某個目標★",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "那麼，",
    "voice": "vo_adv_1364001_027",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "優衣你們呢？",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n看你們好像在和剛剛那隻魔物戰鬥。",
