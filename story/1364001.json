    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n真琴和初音",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "，還有美空也是……",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我碰巧看到你們往森林裡面走。",
    "voice": "vo_adv_1364001_021",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "因為是兩個人一起，想說不要打擾你們，",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "結果就聽到慘叫聲。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "衝過來果然是對的呢。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "小初音正在工作哦♪",
    "voice": "vo_adv_1364001_022",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "因為收到調查委託，",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "說是森林的狀況不對勁～",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n然後就遇到真琴和美空，",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嚇了我一跳呢。",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我的話，",
    "voice": "vo_adv_1364001_023",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "是因為接了討伐魔物的委託。",
