    "name": "真琴",
    "words": "就幫你們一把吧。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n反正我的委託目標也是那隻魔物，",
    "voice": null,
