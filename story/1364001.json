    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "呵呵，",
    "voice": "vo_adv_1364001_003",
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "太好了♪",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "要是聖誕節就這樣結束，",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n感覺",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "有點寂寞呢。",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我想做很多的料理和蛋糕，",
    "voice": "vo_adv_1364001_004",
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n讓大家",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "都能愉快地度過♪",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "謝謝你，騎士先生♪",
    "voice": "vo_adv_1364001_005",
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我也會一起加油的。",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "background",
    "bg_id": "500170"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就這樣──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n優衣和{0}",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "來到了遠離城鎮的森林裡。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "騎士先生，",
    "voice": "vo_adv_1364001_006",
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "為什麼要來森林呀？",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n不是要準備派對嗎……",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "食材！？",
    "voice": "vo_adv_1364001_007",
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n你指的，",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "難道是魔物？",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "不、",
    "voice": "vo_adv_1364001_008",
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "不愧是騎士先生……！",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "連食材都很講究……",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "騎士先生這麼認真準備的料理……！",
    "voice": "vo_adv_1364001_009",
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "開始興奮起來了……",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "雖然找到了很多魔物，",
    "voice": "vo_adv_1364001_010",
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "不過全部",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "都有點小隻呢。",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "進森林深處看看吧。",
    "voice": "vo_adv_1364001_011",
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……這一帶，",
    "voice": "vo_adv_1364001_012",
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "相當地",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "安靜呢。",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "巨大的魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "呀！？",
    "voice": "vo_adv_1364001_013",
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "不會吧，",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "和之前的魔物相比",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "大了好多……！",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "巨大的魔物",
    "words": "──吼喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "要狩獵這麼大隻的魔物！？",
    "voice": "vo_adv_1364001_014",
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n騎士先生",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "也太認真了……！",
    "voice": null,
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "巨大的魔物",
    "words": "──吼喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "呀啊啊！？",
    "voice": "vo_adv_1364001_015",
    "unit_id": 136412
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你們，",
    "voice": "vo_adv_1364001_016",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "退開點！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n喝啊啊！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500170"
  },
  {
    "type": "dialogue",
    "name": "巨大的魔物",
    "words": "──嘎喔喔喔喔喔！",
