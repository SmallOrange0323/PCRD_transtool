    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "還是說",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "很像你們會做的事……",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "不過，",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "也無所謂。",
    "voice": null,
    "unit_id": 104311
  },
  {
