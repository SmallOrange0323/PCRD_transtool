    "words": "落葉闊葉樹。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "\\n順帶一提，",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "當時的日本",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "是繩文時代唷。",
    "voice": null
  },
  {
    "type": "still",
    "still": "138900402",
    "still_id": "138900402"
  },
  {
    "name": "飛白",
    "words": "對吧？",
    "voice": "vo_adv_1389004_049"
  },
  {
    "name": "飛白",
    "words": "\\n因為我",
