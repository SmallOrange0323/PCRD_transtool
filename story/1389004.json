    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "\\n你還好嗎？",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "\\n還是你升天了嗎？",
    "voice": null
  },
  {
