    "words": "真遺憾。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "\\n正確答案",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "是B。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "太棒了，",
    "voice": "vo_adv_1389004_046"
  },
  {
    "name": "飛白",
    "words": "答對了。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "\\n作為獎勵，",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "姐姐來摸摸你的頭吧。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "冰河期結束，",
    "voice": "vo_adv_1389004_047"
  },
  {
    "name": "飛白",
    "words": "表示已經開始暖化。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "\\n冰因為暖化而融化，導致海洋面積增加，",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "\\n日本列島也從大陸分離，",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "變成了像現在這樣的形狀。",
