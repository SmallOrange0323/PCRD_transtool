  {
    "name": "飛白",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "可是……",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "明明我是想要讓你鼓起幹勁的，",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "老師我好難過。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "\\n不可以成為只憑外貌，就把別人當成變疑分子的人唷。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "你知道就好。",
    "voice": "vo_adv_1389004_036"
  },
  {
    "name": "飛白",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "那麼，",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "請好好專心讀書吧。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "讀歷史的時候，",
    "voice": "vo_adv_1389004_037"
  },
  {
    "name": "飛白",
    "words": "\\n有的人會以死記為目標，",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "勉強硬背下來。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "\\n但是，",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "那樣可稱不上真正地學會新知。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "既然要讀書，",
    "voice": "vo_adv_1389004_038"
  },
  {
    "name": "飛白",
    "words": "大家都會想要愉快或是有趣地讀吧？",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "\\n因此，",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "透過猜謎來讀書同時享受樂趣，",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "\\n是我推薦的學習方法之一。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "所以說呢，",
    "voice": "vo_adv_1389004_039"
  },
  {
    "name": "飛白",
    "words": "歷史問答。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "\\n鏘。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "大約一萬年前。",
    "voice": "vo_adv_1389004_040"
  },
  {
    "name": "飛白",
    "words": "\\n離現在最近的冰河時期──",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "第四紀冰河時期結束了。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "\\n那麼，",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "在當時的地球，",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "發生了什麼樣的變化呢？",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "這也是讀歷史的",
    "voice": "vo_adv_1389004_041"
  },
  {
    "name": "飛白",
    "words": "一點小應用。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "\\n雖然可能不會出現在考題上，",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "\\n但要是你要跟我一樣進入歷史系就讀，",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "這可是必備知識唷。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "那麼為了方便理解，",
    "voice": "vo_adv_1389004_042"
  },
  {
    "name": "飛白",
    "words": "我稍微省略一點，再說一遍問題。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "\\n大約一萬年前，",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "冰河時期結束了。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "在當時的地球，",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "\\n發生了什麼樣的變化呢？",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "請從下列三個選項中作答。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "A，",
    "voice": "vo_adv_1389004_043"
  },
  {
    "name": "飛白",
    "words": "地球的地軸傾斜90度。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "\\nB，",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "海平面上升，陸地的形狀改變。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "\\nC，",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "恐龍從地球滅絕。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "來，",
    "voice": "vo_adv_1389004_044"
  },
  {
    "name": "飛白",
    "words": "你認為正確答案是哪個？",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "錯～",
    "voice": "vo_adv_1389004_045"
  },
  {
