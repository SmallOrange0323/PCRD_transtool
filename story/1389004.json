    "words": "\\n",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "你看了小格蕾的鋼管舞後，震驚到昏過去了。",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "\\n這是大夢想樂園史上",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "最高等級的反應呢。",
    "voice": null
  },
  {
    "name": "鏡華",
    "words": "雖然感覺",
    "voice": "vo_adv_1389004_075"
  },
  {
    "name": "鏡華",
    "words": "不像是震驚到昏過去……",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "這樣的話，",
    "voice": "vo_adv_1389004_076"
  },
  {
    "name": "格蕾斯",
    "words": "剩下的理由只有一個……",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "我的鋼管舞",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "太過刺激了呢。",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "明明大家都在場，",
