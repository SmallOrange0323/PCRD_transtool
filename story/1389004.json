  },
  {
    "name": "媞雅",
    "words": "似乎非常優秀。",
    "voice": null
  },
  {
    "name": "媞雅",
    "words": "\\n聽說她的爺爺是考古學家，",
    "voice": null
  },
  {
    "name": "媞雅",
    "words": "受其影響，",
    "voice": null
  },
  {
    "name": "媞雅",
    "words": "而決定朝歷史學的道路前進。",
    "voice": null
  },
  {
    "name": "媞雅",
    "words": "尤其",
    "voice": "vo_adv_1389004_070"
  },
  {
    "name": "媞雅",
    "words": "是關於遠古巫女的研究，",
    "voice": null
  },
  {
    "name": "媞雅",
    "words": "\\n她似乎投入到",
    "voice": null
  },
  {
    "name": "媞雅",
    "words": "廢寢忘食的程度。",
    "voice": null
  },
  {
    "name": "媞雅",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "媞雅",
    "words": "能做到這個地步，",
    "voice": null
  },
  {
    "name": "媞雅",
    "words": "已經是愛了吧，",
    "voice": null
  },
  {
    "name": "媞雅",
    "words": "愛。",
    "voice": null
  },
  {
    "name": "媞雅",
    "words": "不過，",
    "voice": "vo_adv_1389004_071"
  },
  {
    "name": "媞雅",
    "words": "她跟那位遠古巫女",
    "voice": null
  },
  {
    "name": "媞雅",
    "words": "已經在LoA成為朋友了，",
    "voice": null
  },
  {
    "name": "媞雅",
    "words": "\\n某種意義上很走運呢。",
    "voice": null
  },
  {
    "name": "媞雅",
    "words": "\\n因為等她察覺時，目的已經達成了嘛。",
    "voice": null
  },
  {
    "name": "媞雅",
    "words": "機會難得，",
    "voice": "vo_adv_1389004_072"
  },
  {
    "name": "媞雅",
    "words": "你就向格蕾斯",
    "voice": null
  },
  {
    "name": "媞雅",
    "words": "多學一點東西吧？",
    "voice": null
  },
  {
    "name": "媞雅",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "媞雅",
    "words": "要是有大姐姐手把手教導，",
    "voice": null
  },
  {
    "name": "媞雅",
    "words": "即使是你這個笨蛋，",
    "voice": null
  },
  {
    "name": "媞雅",
    "words": "\\n也會稍微變聰明一點吧。",
    "voice": null
  },
