    "unit_id": 122731
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n但那個……",
    "voice": null,
    "unit_id": 122731
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "你也是一個人，",
    "voice": null,
    "unit_id": 122731
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "看起來又很閒！",
    "voice": null,
    "unit_id": 122731
  },
  {
    "type": "dialogue",
    "name": "鏡華",
