  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "你……",
    "voice": null,
    "unit_id": 122731
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "……沒、",
    "voice": "vo_adv_1227004_052",
    "unit_id": 122731
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "沒什麼！",
    "voice": null,
    "unit_id": 122731
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "不過……",
    "voice": "vo_adv_1227004_053",
    "unit_id": 122731
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我可能",
