    "unit_id": 122731
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "也一樣。",
    "voice": null,
    "unit_id": 122731
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 122731
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "不想在學校被看見丟臉的一面，",
    "voice": null,
    "unit_id": 122731
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 122731
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "因此而感到不安……",
    "voice": null,
    "unit_id": 122731
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "是不是再多做自己一點……",
    "voice": "vo_adv_1227004_054",
    "unit_id": 122731
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "就好了呢？",
    "voice": null,
    "unit_id": 122731
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "那",
    "voice": "vo_adv_1227004_055",
    "unit_id": 122731
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "從現在開始，我們兩人一起來練習游泳吧。",
    "voice": null,
    "unit_id": 122731
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n畢竟一起游也比較開心！",
