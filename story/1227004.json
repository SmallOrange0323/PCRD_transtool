  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "呼吸？",
    "voice": null,
    "unit_id": 122731
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "～～～！",
    "voice": "vo_adv_1227004_059",
    "unit_id": 122731
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n我剛剛的話果然還是不算數！",
    "voice": null,
    "unit_id": 122731
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "就算你溺水，我也不會救你的！",
