    "unit_id": 122731
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "這樣不好喔。",
    "voice": null,
    "unit_id": 122731
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "就算不做那種事，",
