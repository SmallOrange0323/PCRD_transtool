    "unit_id": 122731
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "要不要來比賽？",
    "voice": null,
    "unit_id": 122731
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n如果能贏過你，",
    "voice": null,
    "unit_id": 122731
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我覺得我在學校也就沒問題了！",
