  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "嗚嗚……",
    "voice": "vo_adv_5009411_001",
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "這麼可怕的事",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n希望能早點結束就好……",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "胡桃真是膽小呢♪",
    "voice": "vo_adv_5009411_002",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n不過，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我的年紀算是胡桃的姊姊，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n所以根本不害怕呢～♪",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "……啊，綾音！",
    "voice": "vo_adv_5009411_003",
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n綾音的後面有個黑色的影子……！？",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "……咦咦！？",
    "voice": "vo_adv_5009411_004",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "突、突然出現太犯規了……！！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "……咦，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "……什麼都沒有？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "欸嘿嘿……",
    "voice": "vo_adv_5009411_005",
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "綾音果然也是",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n和我一樣害怕嘛……♪",
    "voice": null,
    "unit_id": 108511
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我、我才沒有！",
    "voice": "vo_adv_5009411_006",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我剛才只是那個……",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "只是有點嚇到罷了！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "呵呵呵……♪",
    "voice": "vo_adv_5009411_007",
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "好了，妳們二個，",
    "voice": null,
    "unit_id": 108411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "到最後也不要掉以輕心的上吧！",
    "voice": null,
    "unit_id": 108411
  }
]
