  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "なんか、",
    "voice": "vo_adv_5134064_000",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "急に初夢に願いを込めようみたいな流れになったけど……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "そんな大げさな目標、",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "あたしにあるわけないんだよね～",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "そもそも願ったところで夢を自由にできるわけないし。",
    "voice": "vo_adv_5134064_001",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "深く考えず、",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "ぐっすり眠った方がいい夢が見れそうだよ……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "ふぁ～……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "そういうわけで、",
    "voice": "vo_adv_5134064_002",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "おやすみなさい～……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "ぐぅ……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "still",
    "still_id": "513406401"
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "むにゃむにゃ……",
    "voice": "vo_adv_5134064_003",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "ん～……？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "あれ、",
    "voice": "vo_adv_5134064_004",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "あたし、",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\n寝たんじゃなかったっけ？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\nなんでこんなところに突っ立ってるんだろう？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "試しに、",
    "voice": "vo_adv_5134064_005",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "尻尾をつねってみよう。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "……うりゃ！",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "痛くない……",
    "voice": "vo_adv_5134064_006",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\nということは、",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "もしかしてこれって夢？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "夢ならではってことは何も起こってないし、",
    "voice": "vo_adv_5134064_007",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "何も願わなかったせいで",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "つまんない夢になっちゃったのかも。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "でも逆に考えれば、",
    "voice": "vo_adv_5134064_008",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "誰にも邪魔されず",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\n好きなだけダラダラできるってことでは……？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "そう考えたら、",
    "voice": "vo_adv_5134064_009",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "割と悪くない初夢だね～",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "とりあえず、",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "横になって……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "still",
    "still_id": "513406402"
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "いや～",
    "voice": "vo_adv_5134064_010",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\n普段ならこんなところで寝転んだら、",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\n絶対リマリマとかしおりんが注意してくるもんね。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "まっひ～はボケと勘違いして",
    "voice": "vo_adv_5134064_011",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\nツッコミ入れてきそうだけど。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "これで",
    "voice": "vo_adv_5134064_012",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "お菓子とジュースがあれば言うことなしだったけど、",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "とりあえず二度寝しよっと……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "おやすみ～……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "background",
    "bg_id": "500156"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "……むにゃむにゃ",
    "voice": "vo_adv_5134064_013",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "……あれ？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "あたし、",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "こんなところで寝てたっけ？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "さっきまで、",
    "voice": "vo_adv_5134064_014",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "全然違う場所にいたような……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "あっ。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\nそっか、",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "夢の中でまた眠ったせいで、",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "勘違いしちゃったのか。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "まぁいいや、",
    "voice": "vo_adv_5134064_015",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "まだ起きるには早いし",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "二度寝……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "あれ？　",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "ホントにこれって二度寝？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\n実は",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "三度寝だったりしない？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "いや、",
    "voice": "vo_adv_5134064_016",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "もしかしたら覚えてないだけで",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\nそれ以上眠っているかも……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "果たしてあたしは今、",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "現実の中にいるのか、",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "夢の中にいるのか……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "ぶっちゃけどっちでもいいと思いつつ、",
    "voice": "vo_adv_5134064_017",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "真実を知るために",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "再び眠ることにしたのだった……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "ぐぅ……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "シオリ",
    "words": "……間違いなく現実だから、",
    "voice": "vo_adv_5134064_018",
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "シオリ",
    "words": "そろそろ起きてください、",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "シオリ",
    "words": "リンちゃん。",
    "voice": null,
    "unit_id": 103813
  }
]
