    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "咦？",
    "voice": "vo_adv_5160004_059",
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "但是",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "蘭德索爾並沒有預定",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "要辦那種活動啊……",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "育幼院的小孩子２",
    "words": "我也有聽說喔。",
    "voice": "vo_adv_5160004_060",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "育幼院的小孩子２",
    "words": "好像有超大的蛇，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "育幼院的小孩子２",
    "words": "\\n還有像蛇一樣的人們在遊行",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "育幼院的小孩子２",
    "words": "前往城堡的樣子！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "……這是怎麼回事？",
    "voice": "vo_adv_5160004_061",
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "像蛇一樣的人，",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "是指吉歐‧格黑納的",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "妖魔人吧？",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "為什麼",
