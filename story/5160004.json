  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "當莫妮卡和梅杜莎正在前往蘭德索爾時，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n華音所率領的蛇之軍團抵達了蘭德索爾城鎮中，",
