[
  {
    "type": "background",
    "bg_id": "502114"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "從前夕祭典過了一晚，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "終於來到蛇祭當天──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n梅杜莎正一個人走在早晨的居住區之間。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "……終於",
    "voice": "vo_adv_5160004_000",
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "到了這一天呢。",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "姊姊，",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "我會做到的。",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "\\n我一定會打倒涅妃‧涅羅，",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "救出妳們。",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "哦，",
    "voice": "vo_adv_5160004_001",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "怎麼啦梅杜莎，",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "妳起得真早。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n蛇祭是從下午才開始吧？",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我看妳那樣子，",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "似乎是緊張到沒能睡著呢。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "啊？",
    "voice": "vo_adv_5160004_002",
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "那、",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "那怎麼可能……",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "我是期待過頭，才太早醒來了而已！",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "是這樣嗎。",
    "voice": "vo_adv_5160004_003",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "雖然參加者們",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "都是一些強者，",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n但妳也很強不是嗎？",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n不用著急，",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "去發揮妳平常的實力就好了。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "就說我沒有在緊張了嘛！",
    "voice": "vo_adv_5160004_004",
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "畢竟",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "我會奪冠這點已經是確定了的。",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "我思考的是奪冠之後，",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "有關涅妃‧涅羅的事。",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……",
    "voice": "vo_adv_5160004_005",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這樣啊。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n雖然咲戀他們",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "回蘭德索爾了，沒辦法觀戰，",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n但作為代替，",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我會連他們的分一起替妳加油的！",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "我是不需要被加油啦……",
    "voice": "vo_adv_5160004_006",
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "不過，",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "畢竟我也稍微有受妳一點照顧，",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "就讓妳看看我華麗勝出",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "的樣子吧。",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "啊啊！",
    "voice": "vo_adv_5160004_007",
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "莫妮卡小姐～！",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n不好了，",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "大事不妙了～！",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "米亞？",
    "voice": "vo_adv_5160004_008",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "怎麼啦，那麼慌張……",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "該不會是",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "蛇祭參加者在失控搗亂吧？",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "不，",
    "voice": "vo_adv_5160004_009",
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "情況反過來～",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "參加者",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "全部不見了！",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "全、",
    "voice": "vo_adv_5160004_010",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "全部！？",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "如果是一兩個人還好說，",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "居然是全部？",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "一時之間讓人很難相信……",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "就、",
    "voice": "vo_adv_5160004_011",
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "就是說啊……",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "他們都是充滿自信",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n從吉歐‧格黑納各地",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "前來參加的，",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "實在難以想像他們會在比賽開始前放棄～",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "既然如此，",
    "voice": "vo_adv_5160004_012",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "他們究竟",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "是上哪去了？",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "雖然也可能是綁架，",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "但參加者全是強者，",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "要把他們所有人帶走，",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n是無法辦到的吧。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "有沒有",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "什麼可疑之處呢？",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "工作人員1",
    "words": "嗯～",
    "voice": "vo_adv_5160004_013",
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "工作人員1",
    "words": "競技場有",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "工作人員1",
    "words": "留下宴會的痕跡，",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "工作人員1",
    "words": "\\n卻、",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "工作人員1",
    "words": "卻沒有爭執",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "工作人員1",
    "words": "的痕跡啊。",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "工作人員2",
    "words": "首先，",
    "voice": "vo_adv_5160004_014",
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "工作人員2",
    "words": "血氣方剛的吉歐‧格黑納人",
    "voice": null,
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "工作人員2",
    "words": "\\n居然會毫不抵抗地被帶走，",
    "voice": null,
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "工作人員2",
    "words": "正常來說是不可能的啦。",
    "voice": null,
    "unit_id": 52111
  },
  {
    "type": "dialogue",
    "name": "工作人員1",
    "words": "啊，",
    "voice": "vo_adv_5160004_015",
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "工作人員1",
    "words": "要說可疑的話，",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "工作人員1",
    "words": "聽說",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "工作人員1",
    "words": "有人在半夜聽見了吹笛聲。",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "工作人員1",
    "words": "\\n",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "工作人員1",
    "words": "前夜祭典也沒有準備笛子之類的，",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "工作人員1",
    "words": "要說可疑",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "工作人員1",
    "words": "是挺可疑的……",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "對了對了，",
    "voice": "vo_adv_5160004_016",
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "一樣是昨天半夜，也有人說聽見了女人的大笑聲。",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n我自己",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "昨天帶著耳塞睡覺，所以沒注意到……",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "不過那究竟是什麼呢？",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "會是新型魔物之類的嗎～？",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "大笑……",
    "voice": "vo_adv_5160004_017",
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "我說，",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "莫妮卡？",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "嗯，",
    "voice": "vo_adv_5160004_018",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我也有相同想法。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n……前幾天",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "那個暴露狂很可疑。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "暴露狂",
    "voice": "vo_adv_5160004_019",
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "嗎……",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "該不會",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "是華音小姐吧～？",
