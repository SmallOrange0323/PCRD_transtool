  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "有哪裡在痛嗎！？",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "看起來好像沒受傷……",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "不是，",
    "voice": "vo_adv_5160004_045",
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "有好討厭的聲音……",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "嗚，",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "頭、",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "好痛……",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "聲音？",
    "voice": "vo_adv_5160004_046",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "經妳這麼一說，",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "似乎隱約有笛聲呢……",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "哦哦哦哦……哦哦……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "剛才那個",
    "voice": "vo_adv_5160004_047",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "是什麼啊……",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "地鳴……",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "不……",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n很有可能出了什麼事。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "梅杜莎，",
