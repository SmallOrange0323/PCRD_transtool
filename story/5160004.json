    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "華音那傢伙，",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "明明嘴上說過打倒涅妃‧涅羅，",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "\\n為什麼會去蘭德索爾啊！",
