    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "妳走得動嗎？",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "那當然、",
    "voice": "vo_adv_5160004_048",
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "呀……",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "不用擔心我，",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "我一定會打飛那個暴露狂的！",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "background",
    "bg_id": "500110"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "與此同時，在咲戀育幼院中，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n大家剛一起吃完年菜並稍作休息──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "呼，",
    "voice": "vo_adv_5160004_049",
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "多謝款待。",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n吉歐‧格黑納雖然也是好地方，",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "但果然還是自己家最讓人放鬆呢。",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "真的很久沒像這樣",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "悠哉度過了。",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "不過",
    "voice": "vo_adv_5160004_050",
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "其實不需要連你也一起回來的呀。",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "其實你也",
    "voice": "vo_adv_5160004_051",
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "不用那麼老實聽話啦。",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "不過",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "謝謝你。",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "小孩子們",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "也都很高興",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "你能夠過來。",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "育幼院的小孩子１",
    "words": "咲戀媽媽！",
    "voice": "vo_adv_5160004_052",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "育幼院的小孩子１",
    "words": "大哥哥！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "育幼院的小孩子１",
    "words": "\\n謝謝你們的伴手禮！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "呵呵，",
    "voice": "vo_adv_5160004_053",
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "不用客氣。",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n大家也有努力",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "在看家對吧。",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "育幼院的小孩子２",
