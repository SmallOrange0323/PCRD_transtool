  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "嗚嗚……",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "梅杜莎！？",
    "voice": "vo_adv_5160004_044",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "怎麼了，",
