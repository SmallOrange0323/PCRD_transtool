    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員",
    "words": "其、",
    "voice": "vo_adv_5160004_022",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員",
    "words": "其實……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員",
    "words": "他們似乎前往蘭德索爾了。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "什麼……？",
    "voice": "vo_adv_5160004_023",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "你是說真的嗎！？",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員",
    "words": "是的。",
    "voice": "vo_adv_5160004_024",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員",
    "words": "根據複數目擊者提供的情報，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員",
    "words": "\\n蛇的妖魔人們",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員",
    "words": "沉默不語地",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員",
    "words": "被巨大的蛇帶領，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員",
    "words": "\\n朝著通往蘭德索爾的",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員",
    "words": "魔法之門出發了！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員",
    "words": "而且也有證言指出",
    "voice": "vo_adv_5160004_025",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員",
    "words": "從那團人之中傳出了",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員",
    "words": "詭異的笛聲",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員",
    "words": "\\n還有像笨蛋一樣的大笑聲！",
