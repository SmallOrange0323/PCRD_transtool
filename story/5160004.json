    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團隊長",
    "words": "唔，",
    "voice": "vo_adv_5160004_039",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團隊長",
    "words": "有妄想症的暴露狂真難應付……！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團隊長",
    "words": "\\n果然前幾天時",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團隊長",
    "words": "就算憑蠻力也該抓住她才對的。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團隊長",
    "words": "\\n總之現在立刻掉頭回去吧！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團隊長",
    "words": "否則……",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "哎呀，",
    "voice": "vo_adv_5160004_040",
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "從新年一開始就這麼熱衷在工作啊。",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "等本小姐獲得這個國家後，",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n可以讓你當管家來聽我使喚。",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "不、",
    "voice": "vo_adv_5160004_041",
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "過、",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "呢，",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "拿刀指向我的罪過，",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "可絕非小事。",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n我要你用自己的身體",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "好好贖罪。",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "來，",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "盡情聆聽吧！",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "莊嚴的弄蛇之曲！",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "之後，比華音晚了一些，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n莫妮卡和梅杜莎也回到了蘭德索爾。",
