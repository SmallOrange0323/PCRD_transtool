    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不是妳出生成長的城堡。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n不能大半夜",
