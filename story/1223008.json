  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "與其說是保護者，",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不如說是在監督她。",
    "voice": null,
    "unit_id": 104431
  },
