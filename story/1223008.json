  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "班比邀請{0}一同散步，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n他們和貝斯一起，在古城附近漫步。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "哇！",
    "voice": "vo_adv_1223008_000",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "這裡有花朵盛開呢！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n也有蝴蝶！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "貝斯",
    "words": "呀嗚──♪",
    "voice": "vo_adv_1223008_001",
    "unit_id": 8311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "咦，",
    "voice": "vo_adv_1223008_002",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "那裡結著果實！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "那裡則有奇怪的光──",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "光？",
    "voice": "vo_adv_1223008_003",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "嗯……？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "吶，僕從，",
    "voice": "vo_adv_1223008_004",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "之前是不是也發生過類似的事？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "就是",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "在洞窟的時候──",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "貝斯",
    "words": "呀噗！？",
    "voice": "vo_adv_1223008_005",
    "unit_id": 8311
  },
  {
    "type": "dialogue",
    "name": "貝斯",
    "words": "呀嗚呀嗚呀──！？",
    "voice": null,
    "unit_id": 8311
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "僕從──",
    "voice": "vo_adv_1223008_006",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "僕從，",
    "voice": "vo_adv_1223008_007",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你睡著了嗎……？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n吶……？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "班比才沒有那麼重呢──",
    "voice": "vo_adv_1223008_008",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n真是的，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "真拿你沒辦法。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "嘿咻……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n再不起來的話，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "班比就咬你了唷──？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "咦──？",
    "voice": "vo_adv_1223008_009",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "班比難得來了，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "真無趣……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n吶，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你真的不起來嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n……哇──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "僕從的臉頰",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "可以拉好長唷──♪",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "510092"
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "啊！",
    "voice": "vo_adv_1223008_010",
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "你終於起來了！",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比來玩了唷♪",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "怎麼進來……？",
    "voice": "vo_adv_1223008_011",
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "從那邊的窗戶進來的唷。",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "硬擠之後，",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "就咻──地進來了！",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "不對唷！",
    "voice": "vo_adv_1223008_012",
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "是還是晚上才對吧！",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "夜晚",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "才是班比的主場！",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "不說這個了，",
    "voice": "vo_adv_1223008_013",
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n今天班比要跟僕從介紹一個孩子！",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "still",
    "still_id": "122300801"
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "鏘──♪",
    "voice": "vo_adv_1223008_014",
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "這是班比的朋友",
    "voice": "vo_adv_1223008_015",
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "貝斯唷！",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "很可愛吧！",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "貝斯，",
    "voice": "vo_adv_1223008_016",
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "這就是之前班比說過的僕從唷？",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "嘿嘿♪",
    "voice": "vo_adv_1223008_017",
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n班比很喜歡",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "僕從這一點♪",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "僕從知道嗎？",
    "voice": "vo_adv_1223008_018",
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n「膽小龍貝斯」這個故事！",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "貝斯",
    "voice": "vo_adv_1223008_019",
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "是在森林出生的小龍。",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "大妖精說，",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "牠將來會成為",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "森林之主，",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n所以牠與森林裡的居民一起長大。",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "牠既嬌小",
    "voice": "vo_adv_1223008_020",
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "又膽小。",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "但是，",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "當森林裡的居民遇上困難，",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "牠總是會試著幫忙。",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "就連壞女王",
    "voice": "vo_adv_1223008_021",
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "被大家擊敗後，",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n也只有貝斯",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "反對將她趕出森林。",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "牠說：「就像女王有刺一樣，",
    "voice": "vo_adv_1223008_022",
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "我也有利牙。",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n但我有大家的陪伴，",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "女王卻沒有人在她身邊。",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n女王需要有人幫她。」",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "然後，",
    "voice": "vo_adv_1223008_023",
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "因自己的刺",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "傷了大家",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "也傷了自己的",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "孤獨女王，",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n和貝斯",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "成為了朋友。",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "所以班比",
    "voice": "vo_adv_1223008_024",
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "非常喜歡貝斯！",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n因為牠願意成為",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "女王的朋友♪",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "還有",
    "voice": "vo_adv_1223008_025",
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "僕從也是！",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n在學校時，",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n你一直對班比",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "非常親切對吧。",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "所以班比，",
    "voice": "vo_adv_1223008_026",
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n也決定",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "要一直珍惜你！",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n因為「契約」",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "是絕對的！",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "background",
    "bg_id": "510092"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "唉唉～",
    "voice": "vo_adv_1223008_027",
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "如果能就這樣，把僕從帶回家就好了……",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "這樣就能每天",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "一起照顧你和貝斯了。",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "……對了！",
    "voice": "vo_adv_1223008_028",
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "和班比訂下真正的「契約」就行啦！",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "這樣就能一直在一起了！",
    "voice": null,
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "那麼僕從！",
    "voice": "vo_adv_1223008_029",
    "unit_id": 122332
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n會有一點刺刺的唷……",
    "voice": null,
