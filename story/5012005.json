[
  {
    "type": "background",
    "bg_id": "500060"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "隔天早上――",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "前輩。",
    "voice": "vo_adv_5012005_000",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "醒了吧，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "早安。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n有睡好嗎？",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "咦？　",
    "voice": "vo_adv_5012005_001",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "你問我為什麼不是穿睡衣",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "嗎？",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "那是、",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "那是因為……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "一直穿著很害羞啊。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "那個，",
    "voice": "vo_adv_5012005_002",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "真琴說要去巡邏，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n所以出門去了。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "霞",
    "voice": "vo_adv_5012005_003",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "在我起床時已經不見了……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "有可能是在房間裡進行些調查，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "真琴說的。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "喔～",
    "voice": "vo_adv_5012005_004",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "{0}早啊。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n步未，也謝謝妳看家囉。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "歡迎回家，",
    "voice": "vo_adv_5012005_005",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "真琴。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "總之",
    "voice": "vo_adv_5012005_006",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "這一帶沒什麼可疑的。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n可以暫時安心了。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "……話說回來，",
    "voice": "vo_adv_5012005_007",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "哀嘆之女神啊。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "{0}",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "竟然被那種可怕的傢伙\\n給盯上啦。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "咦？　",
    "voice": "vo_adv_5012005_008",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "霞還窩在房裡嗎？",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "喂～",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "霞～！！",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "啊，抱歉，",
    "voice": "vo_adv_5012005_009",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "剛剛在查點東西。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "大家早啊。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "因為對印象中的",
    "voice": "vo_adv_5012005_010",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "古老文獻有點在意，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "所以再查了一下。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "然後我",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "確定了一件事。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "要聽聽看嗎？",
    "voice": "vo_adv_5012005_011",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "以『馬車競賽與哀嘆之公主』……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "為題，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n不為人知的",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "古老傳說。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "――某一個王國中，",
    "voice": "vo_adv_5012005_012",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "有一位嚴格的國王，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n及他的女兒……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "也就是心地善良的公主。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n她被國王",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "許配給一位",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "鄰國的王子。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "公主也",
    "voice": "vo_adv_5012005_013",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "接受了這個安排……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "本應如此。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n但是她",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "因國事出訪馬車競賽，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n而與一位男子相遇。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "那名男子",
    "voice": "vo_adv_5012005_014",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "是一位被大家稱作馬車競賽英雄的年輕人，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "兩人在瞬間墜入情網。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "然後，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "國王非常震怒。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "並且下諭令，",
    "voice": "vo_adv_5012005_015",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "在賽事中暗殺了年輕人。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "知道了這件事，",
    "voice": "vo_adv_5012005_016",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "卻無法將國王定罪的公主，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n在失意之中，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "了結了自己的生命，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "想讓兩人在天上相遇――",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "啊，",
    "voice": "vo_adv_5012005_017",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "也就是說……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "background",
    "bg_id": "500012"
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "放心吧。",
    "voice": "vo_adv_5012005_018",
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "\\n你啊，",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "什麼事都做不了。",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "我是知道的。",
    "voice": "vo_adv_5012005_019",
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "\\n因為你",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "跟以前的我有著相同的氣味。",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "咦……？",
    "voice": "vo_adv_5012005_020",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "篤定自己什麼都不會而自我決斷……",
    "voice": "vo_adv_5012005_021",
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "\\n當一切都染上絕望後，",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "開始詛咒自己……",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "\\n那種",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "愚者的氣味。",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "background",
    "bg_id": "500060"
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "…………",
    "voice": "vo_adv_5012005_022",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "欸，霞。",
    "voice": "vo_adv_5012005_023",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "馬車競賽的英雄，",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n就是之前在鎮上看到的海報上畫的",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "那個人對吧？",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n但他和公主曾是戀人的事",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "卻沒聽說過呢……",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "傳說這種東西，",
    "voice": "vo_adv_5012005_024",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "常常會衍生出不同的故事。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "而這世上",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "所流傳的資訊，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "往往也只會留下\\n對傳出去的人有利的一面。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "原來如此啊……",
    "voice": "vo_adv_5012005_025",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "所以，",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "霞認為那位公主\\n就是哀嘆之女神啊。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "不過雖說是傳說……",
    "voice": "vo_adv_5012005_026",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "還真是個悲傷的故事呢。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "對啊。",
    "voice": "vo_adv_5012005_027",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n即使這位公主獻身於惡魔，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n也是沒辦法的事吧。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "真想幫她……",
    "voice": "vo_adv_5012005_028",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "步未？",
    "voice": "vo_adv_5012005_029",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "啊、",
    "voice": "vo_adv_5012005_030",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "對、",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "對不起。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "前輩都被盯上了，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "還說這種話真不得體。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "但是，",
    "voice": "vo_adv_5012005_031",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "若這是真的話……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "有點想幫助她。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n總覺得，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "她好像至今仍在",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "承受著悲傷痛苦一樣……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "……",
    "voice": "vo_adv_5012005_032",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "嗯，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "對呀。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "哈哈。",
    "voice": "vo_adv_5012005_033",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "真是個貪心的傢伙呢，",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "步未。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n除了守護{0}，",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n也想對哀嘆之女神說教啊。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "說、",
    "voice": "vo_adv_5012005_034",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "說教什麼的，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我並沒有這麼想……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "呵呵。",
    "voice": "vo_adv_5012005_035",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "嗯，不管要做什麼，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "都得先找出她才能開始啊。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n也就是說，從現在起，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "就是開心的推理時間。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "快看看這個。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "你打開蘭德索爾的示意圖，",
    "voice": "vo_adv_5012005_036",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "要做什麼？",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "要做記號啊。",
    "voice": "vo_adv_5012005_037",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "昨天馬車衝進的地方，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "在這裡。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n真琴，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "助手先生頭上有花瓶掉落的地方在哪裡？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "啊……",
    "voice": "vo_adv_5012005_038",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "這邊吧，",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "嘿。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "步未。",
    "voice": "vo_adv_5012005_039",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "你曾說一直在看著助手先生",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "對吧。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n你可以把助手先生被盯上的地方",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "標示在這個地圖上嗎？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "好，",
    "voice": "vo_adv_5012005_040",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "好的！",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我知道了！",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "嗯，",
    "voice": "vo_adv_5012005_041",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "前天是這邊……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "大前天是這邊，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "和那邊。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n再之前是這邊。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "再更之前是那裡。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "然後更更之前是這邊，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "還有――",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "喂、",
    "voice": "vo_adv_5012005_042",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "喂喂喂喂。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n步未這傢伙，",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "到底是能記到多久以前啊？　",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "{0}，\\n開始感到危險也不過是",
    "voice": "vo_adv_5012005_043",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "在這2、3天而已吧？",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "意思是在那傢伙注意到之前，",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "老早就一直在看著他了！？　",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "真、",
    "voice": "vo_adv_5012005_044",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "真厲害呀。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n某種意義上來說，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "是超越哀嘆之女神的跟蹤……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "不，我什麼都沒說。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "――",
    "voice": "vo_adv_5012005_045",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "呼。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "久等了，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "這些就是全部……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "呃",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n那個，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "妳們兩位怎麼了？　",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "一言不發的。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "啊、",
    "voice": "vo_adv_5012005_046",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "啊啊！　",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "那個，",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "抱歉。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "不小心愣了一下。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "哈哈，",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "啊哈哈。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "總、",
    "voice": "vo_adv_5012005_047",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "總之呢。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "看了步未幫忙記下的地方，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "有發現什麼事情嗎？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "嗯？　",
    "voice": "vo_adv_5012005_048",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "鎮上……",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "不、",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "也有些地方不是。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "住宅區裡，",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "集會所前……",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "嗯？　",
    "voice": "vo_adv_5012005_049",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "該不會……",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "都是在人多的地方！？",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "嗯。",
    "voice": "vo_adv_5012005_050",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我也這麼認為唷。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "多虧了步未。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "犯人的樣貌似乎浮現在眼前囉。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "哀嘆之女神。",
    "voice": "vo_adv_5012005_051",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "她想要",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "在眾人的面前",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n加害助手先生，絕對沒錯。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "沒錯……",
    "voice": "vo_adv_5012005_052",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "就像是",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "重現她所遭遇的悲劇。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n被禁錮在這種固執的想法之中，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這樣絕對不算少見。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "同時，",
    "voice": "vo_adv_5012005_053",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "想將周圍的人全部捲入恐怖的氛圍之中，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n有點像愉快犯呢……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "但是，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我們沒有時間害怕。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "哀嘆之女神，",
    "voice": "vo_adv_5012005_054",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "曾這麼多次",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "試圖接近助手先生……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "也就是說她",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
