[
  {
    "type": "background",
    "bg_id": "500341"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "分身似似花在與{0}的談話中，\\n觀察了暫時未見的他成長了多少。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……公主騎士的力量變得比以前更強大，",
    "voice": "vo_adv_1070004_000",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "不對，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "是漸漸恢復到原來的狀態了。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "看來就如同我的判斷，",
    "voice": "vo_adv_1070004_001",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你喪失的記憶",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n似乎就是公主騎士之力的關鍵呢。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "今後的戰鬥，",
    "voice": "vo_adv_1070004_002",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "尤其是",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "與真那的決戰，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我認為你的力量是必要的。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "因此，",
    "voice": "vo_adv_1070004_003",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我現在要從留在我體內",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "約3成左右的記憶裡，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "將現實世界中",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "與你相遇的記憶",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "播放出來。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我也是第一次做這種事。",
    "voice": "vo_adv_1070004_004",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "所以不曉得會發生什麼事。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "但是，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這對我們而言",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "是必須進行的事。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你明白吧？",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "很好的回答。",
    "voice": "vo_adv_1070004_005",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "那麼現在開始",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "播放記憶――",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "background",
    "bg_id": "510210"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "――那一天{0}為了參加\\n在學校裡舉辦有關學生網路使用的演講，\\n而前往體育館。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "啊！　",
    "voice": "vo_adv_1070004_006",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "{0}！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "\\n下一節課",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "聽說從體育館改成教室了！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "原本預定要來的講師……",
    "voice": "vo_adv_1070004_007",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "厚生勞動省的人！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "\\n好像病倒了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "所以",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "特別改成利用網路直播",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "\\n由別的人來演講了〜",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "老師是這樣說的！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "510220"
  },
  {
    "type": "dialogue",
    "name": "男學生１",
    "words": "反正",
    "voice": "vo_adv_1070004_008",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男學生１",
    "words": "就是聽大叔在長篇大論吧？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男學生１",
    "words": "\\n不曉得能不能早點結束……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "107000401"
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "――大家好，",
    "voice": "vo_adv_1070004_009",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "椿丘高校的同學們。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n看得到這裡的樣子嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男學生２",
    "words": "是女人耶……",
    "voice": "vo_adv_1070004_010",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男學生２",
    "words": "老師，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男學生２",
    "words": "這個沒有正常播放嗎！？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "看來影像似乎沒正常顯示呢。",
    "voice": "vo_adv_1070004_011",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n變更這裡的設定吧。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "107000402"
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……這樣有播放出來嗎？　",
    "voice": "vo_adv_1070004_012",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "大家好。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n我是現士實似似花。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這次是",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "代替熟人進行演講。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "我記得這個人就是那個吧？",
    "voice": "vo_adv_1070004_013",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "\\n是WISDOM的……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "七冠！　",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "好厲害～！　",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "是本人耶！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男學生１",
    "words": "咦！？　",
    "voice": "vo_adv_1070004_014",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男學生１",
    "words": "是本人嗎！？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "請各位安靜。",
    "voice": "vo_adv_1070004_015",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我是本人。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "今日因為不方便，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n所以很遺憾無法直接與各位見面。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "男學生２",
    "words": "什麼七冠啊……",
    "voice": "vo_adv_1070004_016",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男學生２",
    "words": "不管怎麼看都是小學生吧。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "今天",
    "voice": "vo_adv_1070004_017",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "原本是想和各位",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "談談有關",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n正確使用網路的方法……",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "但我改變主意了。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "剛才",
    "voice": "vo_adv_1070004_018",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "說我是小學生的",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "那邊那位同學。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n這次的樣本",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "就用你了。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "男學生２",
    "words": "咦……？",
    "voice": "vo_adv_1070004_019",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "2年級，",
    "voice": "vo_adv_1070004_020",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "座號是……",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "5號。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "籃球社員，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "自家的格局是……",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "4LDK。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "還有個妹妹呢。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "男學生２",
    "words": "等等，",
    "voice": "vo_adv_1070004_021",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男學生２",
    "words": "為什麼！　",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男學生２",
    "words": "是怎麼知道的……！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "原來如此。",
    "voice": "vo_adv_1070004_022",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "上次的考試",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "因為不及格被母親罵了……",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "那就算把我誤認成小學生，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這也沒辦法呢。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "男學生２",
    "words": "真、",
    "voice": "vo_adv_1070004_023",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男學生２",
    "words": "真的很抱歉！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男學生２",
    "words": "\\n對不起！　",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男學生２",
    "words": "是我錯了！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "好吧。",
    "voice": "vo_adv_1070004_024",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "就看你謝罪的份上原諒你。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "各位剛才",
    "voice": "vo_adv_1070004_025",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "是不是認為我",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n入侵他的手機",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "偷看個人情報呢？",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "那完全錯誤。",
    "voice": "vo_adv_1070004_026",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "其實",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "剛才的情報",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n全都只是收集了網路上現有的情報。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "其實剛才他的個人情報也是，",
    "voice": "vo_adv_1070004_027",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "他本人自然是不用說，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n還有他的家人及朋友，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "也就是說，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "是你們發送出去的訊息。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "剛才的同學",
    "voice": "vo_adv_1070004_028",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "等回家後，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "就去對朋友與家人說，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n並確認過去上傳到",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "SNS的照片與視頻吧。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "現在的時代",
    "voice": "vo_adv_1070004_029",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "從本人或其他人的SNS帳號，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n就能簡單地",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "查出個人情報。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "對機械的防範對策",
    "voice": "vo_adv_1070004_030",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "當然是日益精進，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n但重要的",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "還是使用那些的使用者本人。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "使用mimi的VR遊戲",
    "voice": "vo_adv_1070004_031",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "或使用網路時",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n也同樣應該注意",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "個人情報的管理。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "當然，",
    "voice": "vo_adv_1070004_032",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "mimi",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "或VR網路的防護系統，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n都是接近完美的。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "但是，",
    "voice": "vo_adv_1070004_033",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "相對的，使用者本人",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "就必須注意",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n在網上含有個人情報的發言。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "background",
    "bg_id": "510221"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "啊，",
    "voice": "vo_adv_1070004_034",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "找到了找到了！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "\\n吶，{0}。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "可以拜託你一下嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "其實",
    "voice": "vo_adv_1070004_035",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "老師拜託我",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "把東西搬到頂樓……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "\\n可以請你幫忙嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "510181"
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "啊哈哈哈……",
    "voice": "vo_adv_1070004_036",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "沒想到你居然這麼輕易就接受了，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "\\n真令人驚訝。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "或許我根本",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "不需要做出這種事來呢――",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "――面對你，就算繼續偽裝也沒什麼用吧。",
    "voice": "vo_adv_1070004_037",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "真是濫好人到讓人都失去騙人的意義了呢，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你這個人。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你好，{0}。",
    "voice": "vo_adv_1070004_038",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "不能什麼情報都囫圇吞棗地相信喔。",
    "voice": "vo_adv_1070004_039",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這麼輕易就跟著我過來了，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你的濫好人程度真令人訝異。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "但是，",
    "voice": "vo_adv_1070004_040",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你那樣的處事態度，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n或許就如同晶所說的，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "那正是我失敗的理由吧。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "對究極個體的",
    "voice": "vo_adv_1070004_041",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我們七冠而言，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你是個完全相對的存在……",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n我現在",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "對你抱有非常深的興趣。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我忘了說，",
    "voice": "vo_adv_1070004_042",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "今天的演講",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n全是借用校內的空教室",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "進行發送的。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "那個男學生的個人情報，",
    "voice": "vo_adv_1070004_043",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n及全學生的情報都只是我事前調查的。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "因為還是高中生，所以也無可奈何，",
    "voice": "vo_adv_1070004_044",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n但沒想到所有人都相信了……",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "但明天應該會有什麼爆料吧。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "那個擊敗我的公主騎士的模樣，",
    "voice": "vo_adv_1070004_045",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n我很想親自看一眼。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "所以拜託熟人協助我，",
    "voice": "vo_adv_1070004_046",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n替我調整成能夠",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "以代理身份進行演講。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我只是尋找了日本未發布的ID所分配的mimi，",
    "voice": "vo_adv_1070004_047",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n然後再調查",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "來自該裝置的網路使用蹤跡而已。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "公主騎士的mimi",
    "voice": "vo_adv_1070004_048",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "是七冠特別準備的東西。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "要查出那些事，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "對同樣身為七冠的我而言並不是難事。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……你不需要那麼警戒我也沒問題的。",
    "voice": "vo_adv_1070004_049",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n就算把這麼大甜頭的情報",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "交給其他七冠",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "也沒什麼意思。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "因此，",
    "voice": "vo_adv_1070004_050",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "今天的事情",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "就當作我們兩人的祕密吧。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……要找出他的蹤跡",
    "voice": "vo_adv_1070004_051",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "實在太過簡單了。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "看來晶",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "是想讓他和我們七冠碰面吧……",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "應該不是希望我們照顧他",
    "voice": "vo_adv_1070004_052",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這種天真的想法吧。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n……",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "晶。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "要推測妳的想法還是依然這麼麻煩呢。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "而且，",
    "voice": "vo_adv_1070004_053",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "在現實中進行個人攻擊，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "並不符合我的喜好。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "能像這樣見到面我就滿足了。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我像這樣出現在你面前，",
    "voice": "vo_adv_1070004_054",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這是第一次也是最後一次。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "否則到戰鬥時，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這可能會讓我動了不必要的情感。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "下次",
    "voice": "vo_adv_1070004_055",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "在阿斯特朗中再見吧。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n在那之前，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "請你一定要好好保重。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……下次再見面時，",
    "voice": "vo_adv_1070004_056",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我絕對會打倒你。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "那麼再見了，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "晶的公主騎士。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "background",
    "bg_id": "500341"
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……播放結束。",
    "voice": "vo_adv_1070004_057",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "剛才的就是我和你",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "在現實世界中的記憶。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "以前就算在那之後我們彼此也仍然是敵人，",
    "voice": "vo_adv_1070004_058",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "但現在為了逃離這個世界，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我會協助你。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這個嘛……",
    "voice": "vo_adv_1070004_059",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "視你的行動而定，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "目前就先這麼決定吧。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這樣啊……",
    "voice": "vo_adv_1070004_060",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "但願能夠如此。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我期待你的表現。",
    "voice": "vo_adv_1070004_061",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "因為要怎麼看我這個萬花筒，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n只有你能夠決定了。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}在心裡許下即使這場戰鬥結束了，\\n也希望似似花不會變成敵人，能依然是同伴的願望。",
