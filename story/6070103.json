    "type": "dialogue",
    "name": "アキノ",
    "words": "そうですわね！　",
    "voice": "vo_adv_6054103_003",
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "ここはもう開き直って、",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "\\nあなたさまとの時間を",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "大切にしますわ。",
    "voice": null,
    "unit_id": 114411
  },
  {
