    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "ええ！　",
    "voice": "vo_adv_6054103_002",
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "優秀なメルクリウス財団のメンバーが",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "\\nおりますので！　",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "それに私、",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "風邪など一度も",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "\\n引いたことがありませんの！　",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "おーほっっほっほ！",
    "voice": null,
    "unit_id": 114411
  },
