    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "これであなたさまが",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "\\n私の騎士となってくだされば……",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "ふふ、",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "冗談です。",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "\\n",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
    "words": "今はまだ、",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "アキノ",
