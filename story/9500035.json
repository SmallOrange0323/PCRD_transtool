  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "超級開心──！！",
    "voice": null,
    "unit_id": 101741
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n最喜歡{0}了～！",
    "voice": null,
    "unit_id": 101741
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "抱緊緊～！",
    "voice": null,
    "unit_id": 101741
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我啊，",
    "voice": "vo_adv_9500035_001",
    "unit_id": 101741
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "也很喜歡{0}喔～！",
    "voice": null,
    "unit_id": 101741
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n超超",
    "voice": null,
    "unit_id": 101741
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "超～喜歡的！",
    "voice": null,
    "unit_id": 101741
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "所以……",
    "voice": null,
    "unit_id": 101741
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我再也不會",
    "voice": null,
    "unit_id": 101741
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "離開你了喔～！",
    "voice": null,
    "unit_id": 101741
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "嘿嘿……",
    "voice": "vo_adv_9500035_002",
    "unit_id": 101741
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "感覺就像做夢一樣，整個人輕飄飄的～",
    "voice": null,
    "unit_id": 101741
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n原來心意相通，",
    "voice": null,
    "unit_id": 101741
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "是這麼快樂的事呢～？",
    "voice": null,
    "unit_id": 101741
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "就像日頭在胸口一樣，",
    "voice": "vo_adv_9500035_003",
    "unit_id": 101741
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "暖烘烘的……",
    "voice": null,
    "unit_id": 101741
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101741
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "全身充滿了喜悅……",
    "voice": null,
    "unit_id": 101741
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "不知道{0}能不能也感受到",
    "voice": "vo_adv_9500035_004",
    "unit_id": 101741
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我怦怦亂跳的心呢──？",
    "voice": null,
    "unit_id": 101741
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n抱緊緊～♪",
    "voice": null,
    "unit_id": 101741
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "哈哈～♪",
    "voice": "vo_adv_9500035_005",
    "unit_id": 101741
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "現在好想和你一起盡情跳舞喔～！",
    "voice": null,
    "unit_id": 101741
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101741
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "可以陪我跳一首嗎～？",
    "voice": null,
    "unit_id": 101741
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101741
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "船到橋頭自然直嘛──",
    "voice": null,
    "unit_id": 101741
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我會好好帶領你的喔～♪",
    "voice": null,
    "unit_id": 101741
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "今後也還有",
    "voice": "vo_adv_9500035_006",
    "unit_id": 101741
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "好～多令人心動和期待的事情",
    "voice": null,
    "unit_id": 101741
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "在等著我們～",
    "voice": null,
    "unit_id": 101741
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n一想到能和你一起感受這些……",
    "voice": null,
    "unit_id": 101741
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "怎麼辦～！？",
    "voice": null,
    "unit_id": 101741
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n感覺怎麼跳都跳不夠耶～！？",
    "voice": null,
    "unit_id": 101741
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "……那個呀～",
    "voice": "vo_adv_9500035_007",
    "unit_id": 101741
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "從今以後，",
    "voice": null,
    "unit_id": 101741
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "跳舞的時候也好，",
    "voice": null,
    "unit_id": 101741
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "沒有跳舞的時候也好，",
    "voice": null,
    "unit_id": 101741
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n希望你都能一～直待在我身邊呀～",
    "voice": null,
    "unit_id": 101741
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101741
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "嘿嘿，",
    "voice": null,
    "unit_id": 101741
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "請多指教啦～！",
    "voice": null,
    "unit_id": 101741
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "果然，",
    "voice": "vo_adv_9500035_008",
    "unit_id": 101741
  },
  {
    "type": "dialogue",
