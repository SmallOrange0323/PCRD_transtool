    "type": "dialogue",
    "name": "凱留",
    "words": "我已經多久沒有這樣子做了？",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這張桌子夠用吧……",
    "voice": "vo_adv_5126003_064",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我準備了人數相當的坐墊，",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n應該不至於會坐到屁股痠痛……",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "也準備了很多能量飲料來對抗瞌睡蟲，",
    "voice": "vo_adv_5126003_065",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n連真的撐不住想小睡片刻時，可以蓋的毯子也拿出來了……",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊，",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我忘了。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n還要準備用來提高專注力的精油……",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "！！",
    "voice": "vo_adv_5126003_066",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n他們來了……！！",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "still",
    "still_id": "512600301"
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "讓妳久等了，凱留寶──♪",
    "voice": "vo_adv_5126003_067",
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "哎呀，",
    "voice": "vo_adv_5126003_068",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "妳整理得滿乾淨的嘛。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "可以感受到妳要招待這位大人最起碼該有的考量。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "璃乃、妮諾",
    "words": "打擾了～！",
    "voice": "vo_adv_5126003_069",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "給我等一下───！！！",
    "voice": "vo_adv_5126003_070",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你……",
    "voice": "vo_adv_5126003_071",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你們是來準備考試的吧～～！？",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你們到底",
    "voice": "vo_adv_5126003_072",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是在想什麼啊，手上滿是零食和遊戲！？",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "而且還穿成這樣……",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你們是打算舉行睡衣派對嗎！！？",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "沒錯！",
    "voice": "vo_adv_5126003_073",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我負責採購零食！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n有洋芋片、巧克力、軟糖和棉花糖！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n全都是凱留喜歡吃的零食！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這樣吃會胖啊！",
    "voice": "vo_adv_5126003_074",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我帶來了古今中外、",
    "voice": "vo_adv_5126003_075",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "全國各地所盛行的遊戲！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "有將棋、",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "撲克牌、",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "花牌豬鹿蝶！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n壓軸則是浴衣桌球大戰是也！！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "別鬧了～～～～～！！！",
    "voice": "vo_adv_5126003_076",
    "unit_id": 127212
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "鈴奈等人",
    "words": "呀啊啊啊──！！！？",
    "voice": "vo_adv_5126003_077",
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500952"
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "好……",
    "voice": "vo_adv_5126003_078",
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "好過分喔，凱留寶～",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "突然就施展魔法……",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "唔，",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "咦！？",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "睡衣不見了！",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n這是老師使用的變裝魔法……？",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是啊，",
    "voice": "vo_adv_5126003_079",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我偷學起來那個魔法了，因為我是天才嘛。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好了，",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "快把零食和遊戲收起來！",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我們要來念書了！",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "咦～",
    "voice": "vo_adv_5126003_080",
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "難得來到凱留寶的房間，",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n竟然要念書，這樣太可惜了吧……",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我說你們……",
    "voice": "vo_adv_5126003_081",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "應該不會不知道吧？",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這次的考試如果不及格，",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就必須參加補習喔！",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n而且",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "補習和畢業旅行都是在同一天！！",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "換句話說，",
    "voice": "vo_adv_5126003_082",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "如果考試不及格就不能去畢業旅行了！！",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "鈴奈等人",
    "words": "咦咦咦──！！！？？？",
    "voice": "vo_adv_5126003_083",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在這之後，多虧有凱留徹底的指導，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n鈴奈他們才能夠勉強以及格分數通過考試。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "總算可以去畢業旅行的一夥人，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n揚聲歡呼，並將凱留拋了起來。",
    "voice": null,
    "unit_id": null
  }
]
