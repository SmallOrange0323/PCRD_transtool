  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "任何事都要懂得從不同角度來思考",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……受教了。",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……唔，現在不用跟我說這些啦！！",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "答案是「沒有pain，",
    "voice": "vo_adv_5126003_036",
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "就沒有gain」",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n對吧♪",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這個答案根本沒翻到啦！！！",
    "voice": "vo_adv_5126003_037",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……直譯的話是「沒有痛苦就沒有收穫」。",
    "voice": "vo_adv_5126003_038",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "意思是說，要取得有價值之物，",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就會伴隨著危險。",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n正確的諺語像「不入虎穴，焉得虎子」就是其中一例。",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "唉……",
    "voice": "vo_adv_5126003_039",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我大概知道妳們的程度了。",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "很遺憾，看來我們很難一起念書了。",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那麼，",
    "voice": "vo_adv_5126003_040",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "辛苦妳們了。",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我會為妳們加油的。",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "鈴奈等人",
    "words": "凱留～～～！！！\\n凱留寶～～～！！！\\n凱留～～～！！！",
    "voice": "vo_adv_5126003_041",
    "unit_id": null
  },
  {
