[
  {
    "type": "background",
    "bg_id": "500080"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "某一天的休息時間，{0}等人",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n正熱絡地聊著畢業旅行的話題。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "啊～",
    "voice": "vo_adv_5126003_000",
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家真的好期待畢業旅行喔～♪",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才，",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我們一起同組吧！",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "當然，",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "凱留寶也是♪",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "鈴奈，",
    "voice": "vo_adv_5126003_001",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳滿心期待是沒問題，",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n不過在畢業旅行之前，還有一個活動喔。",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "咦？",
    "voice": "vo_adv_5126003_002",
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "還有什麼活動啊？",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "會是文化祭嗎？",
    "voice": "vo_adv_5126003_003",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "還是運動會！？",
    "voice": "vo_adv_5126003_004",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "應該是遠足是也♪",
    "voice": "vo_adv_5126003_005",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是期末考喔。",
    "voice": "vo_adv_5126003_006",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "鈴奈等人",
    "words": "！！！",
    "voice": "vo_adv_5126003_007",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……好，",
    "voice": "vo_adv_5126003_008",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這公式很完美。",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n這邊的應用題也答對了！",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "狀態很不錯呢──",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "怎麼，",
    "voice": "vo_adv_5126003_009",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "有什麼不對嗎？",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "雖然我並沒有特別喜歡念書，",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "但是想說既然都來學校上課了，實際投入後",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "感覺還滿有趣的。",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "呵呵，",
    "voice": "vo_adv_5126003_010",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "照這樣子繼續努力下去，搞不好可以拿到不錯的成績。",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我從沒想過自己會這麼期待考試呢──",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "好……",
    "voice": "vo_adv_5126003_011",
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "好帥氣！！",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "等、",
    "voice": "vo_adv_5126003_012",
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "等等，人家也要……！！",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "對了，要不要大家一起念？",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "惠理子寶，妳們也一起來嘛！",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我是無所謂啦，",
    "voice": "vo_adv_5126003_013",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "但是妳們的程度到哪裡呢？",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "如果程度差太多，",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n就算一起讀書，效率也會很差。",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "對了，",
    "voice": "vo_adv_5126003_014",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這裡剛好有本題庫，",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n不如就來稍微做個測驗吧。",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那麼，",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "由我出題，請大家回答。",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "首先，第一題！",
    "voice": "vo_adv_5126003_015",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n「請用可笑至極來造句。」",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n好，有誰要回答？",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "好～的！",
    "voice": "vo_adv_5126003_016",
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我的造句是──",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n「吃飽飯後如果馬上跑步真的是可笑至極！」",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不，那是危險至極，不是可笑至極！",
    "voice": "vo_adv_5126003_017",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "吃飽後若馬上去跑步對消化很不好，千萬不可以這樣做喔！",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "呵呵，",
    "voice": "vo_adv_5126003_018",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "這很簡單。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我的造句是",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "「除了我以外竟然有臭蟲膽敢接近{0}大人，",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n簡直可笑至極，我要親手狠狠暴打他們一頓。」",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "呃，意思雖然對了，但這私心也太可怕了！",
    "voice": "vo_adv_5126003_019",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n……唔，妳在瞪我嗎！？",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "好的，",
    "voice": "vo_adv_5126003_020",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我的造句是",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n「要是切腹了，就可笑至極是也！」",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這是什麼情況啊！！？",
    "voice": "vo_adv_5126003_021",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "唉……",
    "voice": "vo_adv_5126003_022",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "所謂的可笑至極，",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就是過於愚蠢或滑稽的意思。",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "正確的造句範例有「不讀書就想在考試拿高分，簡直可笑至極」。",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好，下一題！",
    "voice": "vo_adv_5126003_023",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n「哺乳類、",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "鳥類、",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "爬蟲類、",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "兩棲類和",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "魚類，",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n這些因為具有相同特徵而被稱為什麼動物？」",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "答案是「脊椎動物」！",
    "voice": "vo_adv_5126003_024",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "順帶一提，人類的脊椎是由",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "頸椎七節、",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "胸椎十二節、",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "腰椎五節、",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "骶骨和",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "尾骨\\n所組成，",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "若熟悉其構造，要破壞人體可謂輕而易舉……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不，雖然是正確答案，但是補充說明也太可怕了！！",
    "voice": "vo_adv_5126003_025",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "嗯～",
    "voice": "vo_adv_5126003_026",
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家的答案是～",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "「全都是努力活著的動物」！",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "很棒的答案！！",
    "voice": "vo_adv_5126003_027",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n但完全答錯了！！！",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "唔……",
    "voice": "vo_adv_5126003_028",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "全都有「類」這個字呢。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "這也就是說，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "答案是「會住在一起的動物」！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "因為俗話說「動物以類居」！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "俗話說的應該是「物以類聚」！",
    "voice": "vo_adv_5126003_029",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "但是這個才不是答案！",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "答案是「脊椎動物」喔。",
    "voice": "vo_adv_5126003_030",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "簡單來說，就是指擁有脊骨的動物。",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n……",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那麼，接下來是最後一題。",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "「請將下列的語言翻譯成諺語。",
    "voice": "vo_adv_5126003_031",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\nNo pain, no gain.」",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好，",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "請確實回答。",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "直譯的話",
    "voice": "vo_adv_5126003_032",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "是指沒有痛苦就無法有所穫得吧！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我知道了！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "正確答案是",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n「不入虎穴，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "醃梅虎子」！！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "醃梅是什麼啦！！",
    "voice": "vo_adv_5126003_033",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n是焉得啦！！",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n……",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "話說焉得是什麼意思啊！！",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "「不入虎穴，焉得虎子」是也！",
    "voice": "vo_adv_5126003_034",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我第一次聽到這句諺語時，",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n還以為這是在說擅自闖進老虎巢穴，",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "搶走幼虎的大壞蛋……",
