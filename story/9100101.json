  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "超異域公主連結☆",
    "voice": "vo_adv_9100101_000",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "Re:Dive！",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "前情提要！",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "still",
    "still_id": "900650005"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你們與對立已久的【憤怒‧軍團】",
    "voice": "vo_adv_9100101_001",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n經過一番激戰後，終於互相了解。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "still",
    "still_id": "900650001"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你們好好地握手言和……",
    "voice": "vo_adv_9100101_002",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "本應該是這樣的。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "still",
    "still_id": "900650006"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這時，突然出現",
    "voice": "vo_adv_9100101_003",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "一名叫做厄莉絲的神祕女子！",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不光是容貌，就連對你的感情都和優衣一模一樣，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "嚇死人了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "still",
    "still_id": "900650007"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "面對蜂擁而至的厄莉絲軍力，",
    "voice": "vo_adv_9100101_004",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你們敗得一塌糊塗。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n贊恩和阿澤爾德",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "也都為了保護你們而犧牲了……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "多虧了阿澤爾德，",
    "voice": "vo_adv_9100101_005",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你們才能勉強逃離厄莉絲……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "但在那之後，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "苦難還是接二連三地來～",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "still",
    "still_id": "211200401"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "厄莉絲的心腹──",
    "voice": "vo_adv_9100101_006",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "彌勒的力量讓贊恩變得狂暴，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n讓你們再次陷入交戰的處境……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "still",
    "still_id": "900650002"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "被迫參與了美空的遊戲後，",
    "voice": "vo_adv_9100101_007",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n蘭德索爾的街上陷入大混亂……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "still",
    "still_id": "900650008"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "站在厄莉絲那一邊的尾狗刀",
    "voice": "vo_adv_9100101_008",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "襲擊了",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n獸人的國家和可可蘿的家鄉，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "大家忙於應戰而焦頭爛額……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "still",
    "still_id": "900650003"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我也",
    "voice": "vo_adv_9100101_009",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好不到哪裡去，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n差點被彌勒抓去當怪物的能量了～！？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "still",
    "still_id": "211200601"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "啊，",
    "voice": "vo_adv_9100101_010",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你們還和在牧場",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "被厄莉絲洗腦的",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n克莉絲提娜和似似花對戰了吧？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "簡直就是",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "敵人接二連三！",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "危機倒海排山！",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "根本沒時間休息！！",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "still",
    "still_id": "900650009"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不過，",
    "voice": "vo_adv_9100101_011",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "儘管如此，你們還是沒有放棄呢♪",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n為了解救被抓走的我，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你們都跑到索爾之塔來了呢……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "呵呵。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "still",
    "still_id": "900650004"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "居然為了救我，",
    "voice": "vo_adv_9100101_012",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "和那個彌勒做交易，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n你",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "也真是傻瓜。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "但是……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "謝謝你，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我很高興♪",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "still",
    "still_id": "211400601"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "可",
    "voice": "vo_adv_9100101_013",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "是～～～！？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這時，發生了更驚人的事！",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n厄莉絲的城堡……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "居然撞上了索爾之塔！！",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n她試圖奪取索爾之塔的控制權！",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "still",
    "still_id": "900650010"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "在這場混亂之中，",
    "voice": "vo_adv_9100101_014",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這次居然變成你被擄走……！",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n幸虧優衣出面幫忙度過了危機。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n世界差一點就終結了呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "但是……",
    "voice": "vo_adv_9100101_015",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你被奪回後，厄莉絲似乎下定決心，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n要不顧一切地破壞整個世界",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "和系統。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "still",
    "still_id": "900650011"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "想要收集玩家靈魂的彌勒",
    "voice": "vo_adv_9100101_016",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "也露出了本性，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n和",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "厄莉絲兩個人做出了不得了的事。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n那就是──",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "still",
    "still_id": "211501001"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "──「終炎巨神」。",
    "voice": "vo_adv_9100101_017",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "厄莉絲的城堡",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "和容器魔物融合，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n創造出了巨大的怪物！",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "而它正在",
    "voice": "vo_adv_9100101_018",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "沿路燒毀森林和道路，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n往蘭德索爾步步逼近。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "得打倒它才行……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "否則這個世界將被火海籠罩──！！",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "……我說，{0}。",
    "voice": "vo_adv_9100101_019",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n哪怕是這樣，你也不會放棄的吧？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你不會放棄的，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我很清楚。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "所以我也不會放棄的！",
    "voice": "vo_adv_9100101_020",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n我會一直引領你直到最後一刻的！",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "為了阻止那個怪物，",
    "voice": "vo_adv_9100101_021",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "大家必須齊心協力，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n奪回被搶走的索爾魔珠……！",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n順便把彌勒那傢伙",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
