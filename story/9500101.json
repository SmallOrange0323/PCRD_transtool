    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n能被你選中，",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "真是太好了──",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我",
    "voice": null,
    "unit_id": 129041
  },
  {
