    "name": "厄莉絲",
    "words": "可以……",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "問你嗎？",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n問你選我的理由。",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……嗯，",
    "voice": "vo_adv_9500101_007",
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "謝謝你，",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "騎士先生。",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "你給我的名字、",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "回憶……",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n全都是",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我重要的寶物。",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我的願望──",
    "voice": "vo_adv_9500101_008",
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n就是今後也能一直",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "與你並肩而行。",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "除此之外，",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
