  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我不想放開你。",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "所以，",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "一起朝著未來──",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "前進吧。",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "欸，",
    "voice": "vo_adv_9500101_010",
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "騎士先生。",
    "voice": null,
    "unit_id": 129041
  },
