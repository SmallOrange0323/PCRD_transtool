  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "真的、",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "選我了呢。",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n不是別人，",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "而是我。",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……謝謝你，",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "騎士先生。",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我一直",
    "voice": "vo_adv_9500101_001",
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "都在等著這一刻。",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n為了騎士先生──",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n獻上身心，",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "甚至是１位元的情報……",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "因為",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "這就是我的願望。",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "如今",
    "voice": "vo_adv_9500101_002",
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "能得到你的選擇……",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n我感覺、",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "感覺好像終於抵達了理想鄉。",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我真的、",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "繞了好遠的路……",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "好漫長……",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……但是，",
    "voice": "vo_adv_9500101_003",
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我……",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "卻一再犯錯。",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n今後",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "或許也定會做出",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "不正確的舉動……",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "就算是這樣，",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "你也願意在我身邊嗎……？",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "呵呵……",
    "voice": "vo_adv_9500101_004",
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "有點",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "害羞耶。",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "但是──",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我很開心。",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "會讓我想聽……",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "很多很多次。",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "就算全世界都與我為敵，",
    "voice": "vo_adv_9500101_005",
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n但只要跟騎士先生在一起，",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我就絕對不會輸。",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "因為，",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "有你相信我。",
    "voice": null,
    "unit_id": 129041
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "欸，",
    "voice": "vo_adv_9500101_006",
    "unit_id": 129041
  },
  {
