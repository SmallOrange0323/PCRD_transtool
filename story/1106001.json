    "name": "真步",
    "words": "咦？",
    "voice": "vo_adv_1106001_081",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n您問人家",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "為什麼能聽懂聖獸先生說的話？",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "那是因為聖獸先生",
    "voice": "vo_adv_1106001_082",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "是真步真步王國的居民呀。",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n只要是人家這個公主，",
