    "type": "dialogue",
    "name": "真步",
    "words": "人家是真步真步王國的公主，",
    "voice": "vo_adv_1106001_008",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "所以當然要來囉。",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "今天",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
