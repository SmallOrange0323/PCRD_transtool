  {
    "type": "dialogue",
    "name": "旁白",
    "words": "真步與{0}為了參加某個活動，\\n而來到了夏天的海邊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "嗯～",
    "voice": "vo_adv_1106001_000",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "天氣真棒。",
