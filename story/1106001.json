  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "您一定也能和祂說話的♪",
    "voice": null,
    "unit_id": 110611
  },
  {
