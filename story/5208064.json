[
  {
    "type": "background",
    "bg_id": "500403"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在怜的複製品世界旅行最後一天，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n從和正將軍那裡得知了祕密釣點的兩人，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n垂下了釣線，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "悠閒地度過了安穩的時光。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……在這之後，",
    "voice": "vo_adv_5208064_000",
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "我們又要暫時分別了呢。",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "快樂的時光",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "總是轉瞬即逝。",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "呵呵。",
    "voice": "vo_adv_5208064_001",
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……嗯？",
    "voice": "vo_adv_5208064_002",
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……啊啊，",
    "voice": "vo_adv_5208064_003",
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "抱歉，",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我高興到",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不小心笑出來了。",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "謝",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "謝妳。",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n謝謝妳說",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "跟我在一起的這幾天",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "很快樂。",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……",
    "voice": "vo_adv_5208064_004",
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "這是",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "當然的啊。",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "妳、",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "妳看，",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "浮標沉下去了。",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在距離那裏有段距離的樹蔭下，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "有個人影正注視著兩人。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……呵呵。",
    "voice": "vo_adv_5208064_005",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n看來她們都很開心，真是太好了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "怜～！",
    "voice": "vo_adv_5208064_006",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n妳在看什麼～！？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "噓……",
    "voice": "vo_adv_5208064_007",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "妳太大聲了，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "日和。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n妳看",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "那邊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……啊。",
    "voice": "vo_adv_5208064_008",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n那是",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "怜的……！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……唔！",
    "voice": "vo_adv_5208064_009",
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "剛才",
    "voice": "vo_adv_5208064_010",
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我好像聽到了日和的聲音。",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "還有……",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "另一個聲音是……",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "呵呵……",
    "voice": "vo_adv_5208064_011",
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "原來如此。",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……志那都，",
    "voice": "vo_adv_5208064_012",
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "妳把耳朵摀起來一下。",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……嗯？",
    "voice": "vo_adv_5208064_013",
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "好。",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "呼……",
    "voice": "vo_adv_5208064_014",
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "得好好協助我們那位有點笨拙，",
    "voice": "vo_adv_5208064_015",
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n而且",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "又很容易害羞的隊長才行呢～！",
    "voice": null,
    "unit_id": 108912
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……！",
    "voice": "vo_adv_5208064_016",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n呵呵呵！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "嗯，",
    "voice": "vo_adv_5208064_017",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "交給我吧。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n我會在這裡",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "跟志那都一同向未來邁進，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n所以妳也……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "不對。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我也要保重啊！",
    "voice": "vo_adv_5208064_018",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "怜的這趟複製品世界旅行就這樣落幕了。",
    "voice": null,
    "unit_id": null
  }
]
