[
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "給我等一下，",
    "voice": "vo_adv_5094321_000",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "現在究竟是怎麼回事！？",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n我們不是已經把冒牌阿斯特賴亞菇的魔物打倒了嗎？",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……很遺憾，",
    "voice": "vo_adv_5094321_001",
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "對方似乎還沒學到教訓呢。",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n不愧是有辦法當上老大的傢伙，",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "其自尊心看來相當高哪。",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "啊哇哇哇……！",
    "voice": "vo_adv_5094321_002",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n而且",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "現在牠還不斷地在增加蘑菇手下的數量……！",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "若對手打算以量取勝，",
    "voice": "vo_adv_5094321_003",
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我們也互相配合，聯手應戰吧。",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "互相配合……",
    "voice": "vo_adv_5094321_004",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "也就是說",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "要比孤伶伶一個人",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "還來得多人數的團隊合作吧，",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我明白了！",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我覺得到目前為止我們也都有在團隊合作啊……",
    "voice": "vo_adv_5094321_005",
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "算了，不計較那麼多。",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n總而言之，先把手下們給解決掉吧！",
    "voice": null,
    "unit_id": 122211
  }
]
