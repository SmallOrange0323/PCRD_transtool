[
  {
    "type": "dialogue",
    "name": "智",
    "words": "輝美小姐……！",
    "voice": "vo_adv_5102301_000",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "妳這樣不停除掉其他直播主，",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n持續踐踏他人的「喜歡」，",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "對妳究竟有什麼好處？",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "該不會是因為",
    "voice": "vo_adv_5102301_001",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "那個緣故吧？",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n到頭來，",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "妳是為了錢",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "才開直播之類的？",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n然後，",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "因為想要賺到更多錢，",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "所以才要幹掉對手之類的？",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "妳說我是為了錢？",
    "voice": "vo_adv_5102301_002",
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "呵呵……",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "哈哈哈哈哈！",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "有什麼好笑的？",
    "voice": "vo_adv_5102301_003",
    "unit_id": 123511
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "不……",
    "voice": "vo_adv_5102301_004",
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "抱歉。",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "因為這個猜測太離譜了，",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "讓我忍不住笑出來。",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "我從來沒有為了錢",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "而開直播。",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "我只是希望",
    "voice": "vo_adv_5102301_005",
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "能有更多人看我的直播，",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n想要獲得更多的點讚罷了。",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "的確，",
    "voice": "vo_adv_5102301_006",
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "對直播主來說，",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n觀看人數和點讚之類的",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "都很重要，但是啊……",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "這些難道值得妳不惜踐踏他人重視的事物嗎！？",
    "voice": null,
    "unit_id": 123711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "是啊，",
    "voice": "vo_adv_5102301_007",
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "妳說對了。",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n對我而言，",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "我就是渴望到願意賭上一切！",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "誰都別想阻擋我！",
    "voice": "vo_adv_5102301_008",
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "\\n我要讓你們",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "輝美",
    "words": "就在這裡Game Over！",
    "voice": null,
    "unit_id": 16711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "妳想得美！",
    "voice": "vo_adv_5102301_009",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我們",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "一定會阻止妳的！",
    "voice": null,
    "unit_id": 123611
  }
]
