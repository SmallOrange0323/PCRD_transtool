  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "秋乃、咲戀和{0}將惡質貴族一夥交給【王宮騎士團】後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在入夜的蘭德索爾中走著。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "呼～",
    "voice": "vo_adv_1809004_000",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "事情總算告一段落了呢。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "今天晚上好像能睡得很好～",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "因為這陣子",
    "voice": "vo_adv_1809004_001",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "一直忙得暈頭轉向呢。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "話雖如此，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "明天好像又要開始忙了……",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "畢竟那個笨蛋貴族造成了一堆混亂啊。",
    "voice": "vo_adv_1809004_002",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我們得把事情周到地處理完才行。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "真叫人提不起勁啊……",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "沒問題的，",
    "voice": "vo_adv_1809004_003",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "咲戀！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "對我們來說，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "這點事情算不了什麼！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "讓我們同心協力，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "一起跨越這個難關吧！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "就算我操心",
    "voice": "vo_adv_1809004_004",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "也無濟於事呢。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "……好！",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "既然如此，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我們立刻來開會吧！",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "就這麼辦！",
    "voice": "vo_adv_1809004_005",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n我們不能浪費時間啊。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "這就叫時間就是金錢，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "光陰似箭！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "是啊是啊，",
    "voice": "vo_adv_1809004_006",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "光陰似箭……",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "呃，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "是不是",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "有點刺眼？",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "這道光",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "是什麼……！？",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我、",
    "voice": "vo_adv_1809004_007",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我都睜不開眼睛了啊～！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "background",
    "bg_id": "510392"
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "非常感謝您",
    "voice": "vo_adv_1809004_008",
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "今天",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "應邀前來。",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "別這麼說，",
    "voice": "vo_adv_1809004_009",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "收到令尊的邀請，我當然很樂意來。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "\\n比起這件事情，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "咲戀小姐才是，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "\\n得應付我這種老人家，應該很辛苦吧。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "一點都不辛苦喔。",
    "voice": "vo_adv_1809004_010",
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "身為晚輩能聽到",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "對未來助益良多的話，",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n這樣的機會可不多得啊。",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "哈哈哈。",
    "voice": "vo_adv_1809004_011",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "\\n聽您這麼說，都讓我想和您好好聊聊了，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "\\n但老人家還是老實地",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "去找老人家聊天吧。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "年輕人和年輕人一起聊天才是最開心的吧。",
    "voice": "vo_adv_1809004_012",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "\\n那我先告辭了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "下次有機會，",
    "voice": "vo_adv_1809004_013",
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "請您一定要再和我聊聊。",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我打擾到你們了嗎？",
    "voice": "vo_adv_1809004_014",
    "unit_id": 103232
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "沒這回事。",
    "voice": "vo_adv_1809004_015",
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n這是那位先生對我們的體貼。",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我也要感謝",
    "voice": "vo_adv_1809004_016",
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "秋乃妳",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "特地前來。",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "有熟悉的面孔在場，",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我就會感到很安心。",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "雖然妳這麼說，",
    "voice": "vo_adv_1809004_017",
    "unit_id": 103232
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "但我總覺得妳看起來相當心不在焉呢？",
    "voice": null,
    "unit_id": 103232
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "並、",
    "voice": "vo_adv_1809004_018",
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "並沒有……",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "這回事、",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "喔？",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我能體會妳的感受。",
    "voice": "vo_adv_1809004_019",
    "unit_id": 103232
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n妳一定",
    "voice": null,
    "unit_id": 103232
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "是在掛念",
    "voice": null,
    "unit_id": 103232
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "鎮上的祭典吧。",
    "voice": null,
    "unit_id": 103232
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "妳、",
    "voice": "vo_adv_1809004_020",
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "妳怎麼會知道……！",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "如果要問",
    "voice": "vo_adv_1809004_021",
    "unit_id": 103232
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "為什麼的話，",
    "voice": null,
    "unit_id": 103232
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "或許",
    "voice": null,
    "unit_id": 103232
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "是因為",
    "voice": null,
    "unit_id": 103232
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我也很在意這件事情吧。",
    "voice": null,
    "unit_id": 103232
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "秋乃也是……？",
    "voice": "vo_adv_1809004_022",
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n那、",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "那是，呃……",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "是因為妳很在意",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "祭典的攤販嗎？",
    "voice": null,
    "unit_id": 102831
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "咦！？",
    "voice": "vo_adv_1809004_023",
    "unit_id": 103232
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "啊、",
    "voice": null,
    "unit_id": 103232
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "是、",
    "voice": null,
    "unit_id": 103232
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "是啊！",
    "voice": null,
    "unit_id": 103232
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n就是這樣！",
    "voice": null,
    "unit_id": 103232
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "傳聞中",
    "voice": "vo_adv_1809004_024",
    "unit_id": 103232
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "醬汁在鐵板上燙出的香氣，",
    "voice": null,
    "unit_id": 103232
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n和多彩糖漿一應俱全的刨冰。",
    "voice": null,
    "unit_id": 103232
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103232
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我是在想，",
    "voice": null,
    "unit_id": 103232
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "就是，",
    "voice": null,
    "unit_id": 103232
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我很想要",
    "voice": null,
    "unit_id": 103232
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "……",
    "voice": null,
    "unit_id": 103232
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "去看看那些東西……",
    "voice": null,
    "unit_id": 103232
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "而且我聽說那位大人……",
    "voice": "vo_adv_1809004_025",
    "unit_id": 103232
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "要和某個人一起去參加祭典，",
    "voice": "vo_adv_1809004_026",
    "unit_id": 103232
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n但我最後沒有問他",
    "voice": null,
    "unit_id": 103232
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "是要和誰一起去……",
    "voice": null,
    "unit_id": 103232
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103232
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "雖然能夠確定那個人不是咲戀……",
    "voice": null,
    "unit_id": 103232
  },
  {
    "type": "dialogue",
    "name": "咲戀",
