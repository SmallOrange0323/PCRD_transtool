  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "克蘿茜！",
    "voice": "vo_adv_9006601_000",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n拜託妳了……！",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "好的！",
    "voice": "vo_adv_9006601_001",
    "unit_id": 126412
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 126412
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "──雙倍火箭拳～！",
    "voice": null,
    "unit_id": 126412
  },
  {
    "type": "background",
    "bg_id": "502080"
  },
  {
    "type": "dialogue",
    "name": "蜘蛛魔物們",
    "words": "──嘎吱嘎吱嘎吱！",
    "voice": null,
    "unit_id": 50011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "克蘿茜，",
    "voice": "vo_adv_9006601_002",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "萊拉耶爾小姐！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "騎士，",
    "voice": "vo_adv_9006601_003",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "各位。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n情況",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "怎麼樣了呢？",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "這個的話，",
    "voice": "vo_adv_9006601_004",
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "簡單來說──",
    "voice": null,
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "原來如此！",
    "voice": "vo_adv_9006601_005",
    "unit_id": 126412
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 126412
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "多虧了騎士先生的朋友們，",
    "voice": null,
    "unit_id": 126412
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "人質平安無事是嗎？",
    "voice": null,
    "unit_id": 126412
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是的，",
    "voice": "vo_adv_9006601_006",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但是……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n因為不知道厄莉絲小姐的魔力保護",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "能維持多久，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n得趕緊打倒阿剌克涅女士才行。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "雖然",
    "voice": "vo_adv_9006601_007",
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "有涅妃‧涅羅小姐",
    "voice": null,
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n在保護琳德小姐她們，以及居住區的各位，",
    "voice": null,
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n但是戰況相當膠著。",
    "voice": null,
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "因此……",
    "voice": null,
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "趕快。",
    "voice": "vo_adv_9006601_008",
    "unit_id": 126111
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n行動吧。",
    "voice": null,
    "unit_id": 126111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "等等，帆稀！",
    "voice": "vo_adv_9006601_009",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n路是這邊沒有錯吧！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "通訊魔法的帆稀",
    "words": "「嗯，",
    "voice": "vo_adv_9006601_010",
    "unit_id": 106715
  },
  {
    "type": "dialogue",
    "name": "通訊魔法的帆稀",
    "words": "沒錯沒錯～",
    "voice": null,
    "unit_id": 106715
  },
  {
    "type": "dialogue",
    "name": "通訊魔法的帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106715
  },
  {
    "type": "dialogue",
    "name": "通訊魔法的帆稀",
    "words": "只是──」",
    "voice": null,
    "unit_id": 106715
  },
  {
    "type": "dialogue",
    "name": "蜘蛛魔物們",
    "words": "──嘎吱嘎吱嘎吱！",
    "voice": null,
    "unit_id": 50011
  },
  {
    "type": "dialogue",
    "name": "通訊魔法的帆稀",
    "words": "「有很多蜘蛛魔物",
    "voice": "vo_adv_9006601_011",
    "unit_id": 106715
  },
  {
    "type": "dialogue",
    "name": "通訊魔法的帆稀",
    "words": "從地下的巢穴冒出來呢～",
    "voice": null,
    "unit_id": 106715
  },
  {
    "type": "dialogue",
    "name": "通訊魔法的帆稀",
    "words": "\\n就像是巢穴前被人放了砂糖的螞蟻那樣，",
    "voice": null,
    "unit_id": 106715
  },
  {
    "type": "dialogue",
    "name": "通訊魔法的帆稀",
    "words": "大量地聚集～」",
    "voice": null,
    "unit_id": 106715
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "除了蜘蛛魔物以外，",
    "voice": "vo_adv_9006601_012",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n還必須提防",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "芙蕾雅",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n和【蠻賊三姊妹】……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "誰怕誰啊！",
    "voice": "vo_adv_9006601_013",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我要把她們全部宰掉，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "再把最深處的蜘蛛老大挖出來！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好！",
    "voice": "vo_adv_9006601_014",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我們要打倒阿剌克涅，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "救出小雪菲！",
    "voice": null,
    "unit_id": 105811
  }
]
