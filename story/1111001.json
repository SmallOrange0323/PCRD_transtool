[
  {
    "type": "background",
    "bg_id": "505034"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "萬聖節時在熱鬧的蘭德索爾散步的{0}，\\n在鬧區街道上遇到了\\n正抱著行李走著的鏡華。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "嘿咻……",
    "voice": "vo_adv_1111001_000",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "嘿咻……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "很好。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "拿了很多杯子蛋糕，",
    "voice": "vo_adv_1111001_001",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n這樣就準備萬全了！",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "不過啊，",
    "voice": "vo_adv_1111001_002",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "就算說是萬聖節，",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "人還真是多呢……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "漂亮的裝飾品，",
    "voice": "vo_adv_1111001_003",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "還有看起來很好吃的糖果。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n變裝的孩子們好像也很開心……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "啊，",
    "voice": "vo_adv_1111001_004",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "那孩子的衣服",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "好可愛啊。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n我也有點想穿穿看……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "呃，",
    "voice": "vo_adv_1111001_005",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "不行不行！",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n今天可不是來玩的呢。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "今天是",
    "voice": "vo_adv_1111001_006",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "為了發糖果給大家",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "才來到這裡的，",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "得好好像個大人，",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "像個姐姐一樣呢。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "呀、",
    "voice": "vo_adv_1111001_007",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "呀啊！",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "呃……",
    "voice": "vo_adv_1111001_008",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "是{0}啊……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "真是的，",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "請不要嚇我啦。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "嗯？",
    "voice": "vo_adv_1111001_009",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n你想要做什麼，",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "伸那隻手？　",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "手指還動來動去……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "該、",
    "voice": "vo_adv_1111001_010",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "該不會……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "是想要惡作劇嗎……？",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "不行啦！？　",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "你想被抓起來嗎！？",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "真是的。",
    "voice": "vo_adv_1111001_011",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "給你糖果就好了吧？",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "呼……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "你真是的……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n明明年紀就比我大……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "因為",
    "voice": "vo_adv_1111001_012",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "有準備糖果所以是沒關係啦。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "現在就拿出來，",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "稍微等一下喔。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "哇哇，",
    "voice": "vo_adv_1111001_013",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "怎麼了！？",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "為什麼啦！",
    "voice": "vo_adv_1111001_014",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "\\n這可是我的喔！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "\\n放開我啦！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男孩 2",
    "words": "一個而已沒關係吧！",
    "voice": "vo_adv_1111001_015",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男孩 2",
    "words": "\\n給我啦！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "是怎麼了啊，",
    "voice": "vo_adv_1111001_016",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "那些孩子們。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n是在吵架嗎……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "那樣子打鬧的話會很危險的。",
    "voice": "vo_adv_1111001_017",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n好像也已經造成周圍的人困擾了……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "去阻止他們！",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "沒事的。",
    "voice": "vo_adv_1111001_018",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n這種程度",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我一個人就可以了。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "……但是。",
    "voice": "vo_adv_1111001_019",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n你不用做任何事情，",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "只要待在我身邊，",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "就能讓我放心了……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "你在說什麼啊，",
    "voice": "vo_adv_1111001_020",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "你也要一起來啊。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "放你一個人的話，",
    "voice": "vo_adv_1111001_021",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "你一定會迷路吧？",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "你什麼都不用做，",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "好好跟緊我就好了。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "喂――！",
    "voice": "vo_adv_1111001_022",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n那邊的兩個人，",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "快點住――手！",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "幹嘛啦！",
    "voice": "vo_adv_1111001_023",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "\\n我現在在跟這傢伙――",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男孩 2",
    "words": "就是現在！",
    "voice": "vo_adv_1111001_024",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "嗚哇、",
    "voice": "vo_adv_1111001_025",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "你、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "你在幹嘛啦！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "\\n……啊！　",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "果汁！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "咦？　",
    "voice": "vo_adv_1111001_026",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "呀啊！",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "啊……",
    "voice": "vo_adv_1111001_027",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "好冰……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "男孩 2",
    "words": "喂、",
    "voice": "vo_adv_1111001_028",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男孩 2",
    "words": "喂！　",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男孩 2",
    "words": "這要怎麼辦啊！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男孩 2",
    "words": "\\n都是你的錯啦！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "才、",
    "voice": "vo_adv_1111001_029",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "才不是！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男孩 1",
    "words": "\\n是你啦……！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "夠了，",
    "voice": "vo_adv_1111001_030",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "不要再吵了！",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "……是為什麼要吵架呢，",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "跟姐姐說說看吧？",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "真是的。",
    "voice": "vo_adv_1111001_031",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n居然為了搶糖果吵架。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "……聽好囉，",
    "voice": "vo_adv_1111001_032",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "你們兩個。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n在有很多人的地方吵鬧的話，",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n會給大家帶來困擾的。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
