    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "好嗎？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "惡徒2",
    "words": "啊，",
    "voice": "vo_adv_1001010_065",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "惡徒2",
    "words": "是的……！　",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "惡徒2",
    "words": "當然！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "護衛１",
    "words": "嘖，",
    "voice": "vo_adv_1001010_066",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "護衛１",
    "words": "什麼啊那個女的……",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "護衛１",
    "words": "\\n不關她的事突然跳出來。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "護衛１",
    "words": "真無聊。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "background",
    "bg_id": "500090"
  },
  {
    "type": "dialogue",
    "name": "王宮騎士隊長",
    "words": "那麼，",
    "voice": "vo_adv_1001010_067",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士隊長",
    "words": "惡徒們就移交給我們了。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "惡徒2",
    "words": "小姐，",
    "voice": "vo_adv_1001010_068",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "惡徒2",
    "words": "承蒙妳",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "惡徒2",
    "words": "的照顧。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "惡徒2",
    "words": "真的很抱歉……",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "惡徒1",
    "words": "那位小哥，",
    "voice": "vo_adv_1001010_069",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "惡徒1",
    "words": "也謝謝你呢。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "惡徒1",
    "words": "……你們是",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "惡徒1",
    "words": "我們的救命恩人。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我才是，",
    "voice": "vo_adv_1001010_070",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "謝謝你！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "你們有好好遵守約定，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我很高興呢！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "惡徒1",
    "words": "……像妳這樣的人，",
    "voice": "vo_adv_1001010_071",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "惡徒1",
    "words": "要是",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "惡徒1",
    "words": "我們能早點遇到就好了。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "惡徒1",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "惡徒1",
    "words": "那我們走了。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……",
    "voice": "vo_adv_1001010_072",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "走掉了呢。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n那些人，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "如果有好好反省就好呢。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "護衛１",
    "words": "哼，",
    "voice": "vo_adv_1001010_073",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "護衛１",
    "words": "哪可能每次都讓妳這麼順利呀！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "護衛１",
    "words": "像你們這樣天真的人，",
    "voice": "vo_adv_1001010_074",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "護衛１",
    "words": "總有一天會吃到苦頭的！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "護衛１",
    "words": "別再讓我們遇到了！　",
    "voice": "vo_adv_1001010_075",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "護衛１",
    "words": "掰啦！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "護衛１",
    "words": "\\n反正一定會橫死在某處吧，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "護衛１",
    "words": "笨蛋們！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……",
    "voice": "vo_adv_1001010_076",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "天真的人……",
    "voice": "vo_adv_1001010_077",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "真的很天真嗎？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n即使惡徒也想要幫助他們，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這樣的作法真的有錯嗎。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……嗯，",
    "voice": "vo_adv_1001010_078",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "是吧。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n不管眼前誰有困難，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我都無法置之不理！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "沒什麼了不起的唷。",
    "voice": "vo_adv_1001010_079",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "等我回過神，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "發現身體早已先行動而已。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "騎士先生。",
    "voice": "vo_adv_1001010_080",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這樣鼓勵我，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "謝謝你。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "被人說我天真也沒關係。",
    "voice": "vo_adv_1001010_081",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n今後",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我要不斷不斷地，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "不論是誰",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "都要繼續幫助他們！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "重新打起精神的日和，\\n在心中暗自強烈地發誓。",
    "voice": null,
    "unit_id": null
  }
