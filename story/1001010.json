  {
    "type": "dialogue",
    "name": "旁白",
    "words": "那天{0}與日和，\\n接受了某個商隊的護衛委託。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "日和",
