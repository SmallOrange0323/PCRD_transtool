  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "歲末將至，在眾人忙碌奔波之時，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n被咲戀找來的{0}來到了咲戀育幼院。",
