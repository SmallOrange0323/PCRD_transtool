[
  {
    "type": "background",
    "bg_id": "500146"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}的劍貫穿自過去誕生的異形。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n寄宿於劍中的過往力量，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "使七冠的力量無效化，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "並將其破壞。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "……謝謝。",
    "voice": "vo_adv_5201010_000",
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "…………",
    "voice": "vo_adv_5201010_001",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "對不起。",
    "voice": "vo_adv_5201010_002",
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "\\n讓你做了",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "那麼難受的事。",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "我只能拜託你……",
    "voice": "vo_adv_5201010_003",
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "不。",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "\\n是我原本就想",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "拜託{0}和菲歐。",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "因為我透過這副身體",
    "voice": "vo_adv_5201010_004",
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "一直看著。",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "\\n看著{0}和菲歐的冒險。",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "\\n",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "就好像……",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "我也",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "跟著你們",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "一起冒險一樣。",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "雖然是我自己一廂情願……",
    "voice": "vo_adv_5201010_005",
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "\\n",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "但如果要道別──",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "我希望對象是你們。",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "still",
    "still_id": "520101001"
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "我很快就要消失了。",
    "voice": "vo_adv_5201010_006",
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "\\n所以在臨走前──",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "──菲歐。",
    "voice": "vo_adv_5201010_007",
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "\\n我有一個請求。",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "……是",
    "voice": "vo_adv_5201010_008",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "什麼呢？",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "往後……",
    "voice": "vo_adv_5201010_009",
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "能請妳",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "繼續使用這副身體嗎？",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "我希望能由妳",
    "voice": "vo_adv_5201010_010",
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "來繼承「女神愛梅斯」。",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "……！",
    "voice": "vo_adv_5201010_011",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "當然，",
    "voice": "vo_adv_5201010_012",
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "不需要一直使用也沒關係。",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "\\n",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "畢竟",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "那副妖精的模樣",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "很適合妳。",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "不過，",
    "voice": "vo_adv_5201010_013",
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "只要偶爾就好。",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "\\n",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "如果妳願意用這副從我的意志中誕生的身體，",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "\\n在這個世界到處飛翔的話……",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "我會很開心的。",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "……好。",
    "voice": "vo_adv_5201010_014",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n當然……",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "當然好了。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "這簡直是最棒的禮物。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "謝謝妳──",
    "voice": "vo_adv_5201010_015",
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "我的",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "妹妹。",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "……！",
    "voice": "vo_adv_5201010_016",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "{0}、",
    "voice": "vo_adv_5201010_017",
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "菲歐。",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "\\n這是我最後留下的",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "「記憶碎片」。",
    "voice": null,
    "unit_id": 52711
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "……路上小心。",
    "voice": "vo_adv_5201010_018",
    "unit_id": 52711
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "background",
    "bg_id": "510460"
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "……很好。",
    "voice": "vo_adv_5201010_019",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "七冠",
    "words": "…………",
    "voice": "vo_adv_5201010_020",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "《阿斯特朗傳奇》──",
    "voice": "vo_adv_5201010_021",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "──開發完成！",
    "voice": "vo_adv_5201010_022",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "七冠",
    "words": "…………",
    "voice": "vo_adv_5201010_023",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "呵。",
    "voice": "vo_adv_5201010_024",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我本以為製作遊戲是輕而易舉的事，",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n沒想到並不無聊呢。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我還是第一次體驗到",
    "voice": "vo_adv_5201010_025",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "睡眠不足的滋味。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n以後大概不會再有了。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n……",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "不過我認為",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "是值得的。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "真是的。",
    "voice": "vo_adv_5201010_026",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n七冠聚在一起共同打造一件東西，",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "\\n我至今仍認為這是不可能的現象……",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "包括像這樣製作完成在內。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "…………",
    "voice": "vo_adv_5201010_027",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "真那。",
    "voice": "vo_adv_5201010_028",
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "\\n你不用說些什麼嗎？",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "請你不要操多餘的心，",
    "voice": "vo_adv_5201010_029",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "棗老師。",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n我不需要做那種與他人共享感情的事。",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n……",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "既然要問，",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "就去問不在場的那傢伙如何？",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "她也不是會在眾人面前吐露情感的人。",
    "voice": "vo_adv_5201010_030",
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "\\n",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "但這個場面",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "她應該看在眼裡了。",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "那麼──",
    "voice": "vo_adv_5201010_031",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "雖然還沒正式開服，",
    "voice": "vo_adv_5201010_032",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "不過都好不容易完成了。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "要不要",
    "voice": "vo_adv_5201010_033",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "登入看看呢──",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "澄花。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "我、",
    "voice": "vo_adv_5201010_034",
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "真的……",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "可以嗎？",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "\\n由我當……",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "澄花",
    "words": "第一個登入的人……",
    "voice": null,
    "unit_id": 52731
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "沒問題。",
    "voice": "vo_adv_5201010_035",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這件事已經定案了。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "儘管吃驚吧，",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "難得",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我們七冠所有人一同贊成。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n這可是很罕見的事喔。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "……我只是說不管是誰",
    "voice": "vo_adv_5201010_036",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "都可以罷了。",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "妳看，",
    "voice": "vo_adv_5201010_037",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "再等下去不坦率的傢伙就會跑出來了，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
