[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在蘭德索爾四處奔走的碧一行人，終於找到了玩具王。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n他們開始詢問玩具王想和",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "所有小孩子成為朋友的目的。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "成、",
    "voice": "vo_adv_5068005_000",
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "成成成、",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "成為朋友……",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "而且對象是蘭德索爾的所有小孩子……？",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "可是，",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "你只是在讓「玩具王二世」們四處搞破壞而已吧……？",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "就是說啊。",
    "voice": "vo_adv_5068005_001",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "你襲擊了孩子們，",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n還想著要和他們當朋友……？",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "襲擊……？",
    "voice": "vo_adv_5068005_002",
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "妳在說什麼啊？",
    "voice": null,
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "我",
    "voice": "vo_adv_5068005_003",
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "是在和小孩子們玩！",
    "voice": null,
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "\\n我們要締結一輩子的友誼，",
    "voice": null,
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "永遠玩在一起！",
    "voice": null,
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "小碧你們也看到了吧？",
    "voice": "vo_adv_5068005_004",
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "\\n那些被送到工廠的",
    "voice": null,
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "殘破不堪的玩具！",
    "voice": null,
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "我當初",
    "voice": "vo_adv_5068005_005",
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "也是像那樣被丟棄的！",
    "voice": null,
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "所以才會被扔在倉庫的一角，",
    "voice": "vo_adv_5068005_006",
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "長久以來飽受著孤獨！",
    "voice": null,
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "玩具王……",
    "voice": "vo_adv_5068005_007",
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n你該不會認為",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "自己是被丟棄的吧……？",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "是啊，沒錯！！",
    "voice": "vo_adv_5068005_008",
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "不、",
    "voice": "vo_adv_5068005_009",
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "不是這樣的……",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "你誤會了！",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n玩具王你",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "沒有被丟棄！",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "你會被送到工廠，",
    "voice": "vo_adv_5068005_010",
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n是因為你的主人",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "很愛惜你……",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "你的主人長大後，",
    "voice": "vo_adv_5068005_011",
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n希望你能一輩子被孩子們疼愛，",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "永遠當他們的玩伴……",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "才把你送去工廠修理，",
    "voice": "vo_adv_5068005_012",
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "想為你找到新的主人……！",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "還有，",
    "voice": "vo_adv_5068005_013",
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n玩具王你看到的那些",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "壞掉的玩具也都是如此……！",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "所以，",
    "voice": "vo_adv_5068005_014",
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "請別再說自己是被丟棄的玩具了……！",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "住口住口住口！",
    "voice": "vo_adv_5068005_015",
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "\\n誰會相信",
    "voice": null,
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "那種話啊！",
    "voice": null,
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "玩具總有一天",
    "voice": "vo_adv_5068005_016",
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "會被丟棄！",
    "voice": null,
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "\\n這就是玩具的命運！",
    "voice": null,
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "身為玩具必定的結局！",
    "voice": null,
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "「玩具王二世」們也將面臨相同下場……",
    "voice": "vo_adv_5068005_017",
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "\\n我不想讓它們也體會這種悲傷……！",
    "voice": null,
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "所以，",
    "voice": "vo_adv_5068005_018",
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "我把力量分給了1000名同胞們，",
    "voice": null,
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "\\n讓它們和我一樣能自由活動！",
    "voice": null,
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "這一切都是為了改變",
    "voice": "vo_adv_5068005_019",
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "我和同胞們",
    "voice": null,
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "注定被丟棄的命運！",
    "voice": null,
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "怎、",
    "voice": "vo_adv_5068005_020",
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "怎麼會……",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "居然能將邊緣精神分給二世們……",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "玩具王遠比我承受了",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "更巨大的孤獨……！",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "只要能讓孩子們一直陪我玩，",
    "voice": "vo_adv_5068005_021",
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "我們就能當永遠的朋友！",
    "voice": null,
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "\\n這樣一來，",
    "voice": null,
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "蘭德索爾的所有小孩子就都是我的玩伴了！",
    "voice": null,
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "擁有意識、能夠自由行動的玩具就只有我一個！",
    "voice": "vo_adv_5068005_022",
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "\\n換句話說，",
    "voice": null,
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "我就是世界上",
    "voice": null,
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "最棒的玩具！",
    "voice": null,
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "啊啊，",
    "voice": "vo_adv_5068005_023",
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "我現在能感覺到……",
    "voice": null,
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "第二小隊正在和孩子們玩耍……",
    "voice": null,
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "\\n形同我手足的同胞們所感受到的友情，",
    "voice": null,
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "傳達到了我的身心靈！",
    "voice": null,
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "有1000名同胞，",
    "voice": "vo_adv_5068005_024",
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "快樂程度便是1000倍──！",
    "voice": null,
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這種事……",
    "voice": "vo_adv_5068005_025",
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這種事一點都不快樂……！",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "就是啊，",
    "voice": "vo_adv_5068005_026",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "玩具王！",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "孩子們和",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "他們的家長都正為此感到困擾！",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n玩得開心的，",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "就只有你們自己而已！",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "快停手吧！",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "唔唔唔，",
    "voice": "vo_adv_5068005_027",
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "吵死了──！",
    "voice": null,
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "\\n身為人類的你們，",
    "voice": null,
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "怎麼可能理解玩具的孤獨！",
    "voice": null,
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "如果非要妨礙我的話……！",
    "voice": "vo_adv_5068005_028",
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "\\n就算是找到我的小碧，",
    "voice": null,
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "我也不會手下留情！",
    "voice": null,
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "所有小隊聽令！",
    "voice": "vo_adv_5068005_029",
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "\\n「玩具王二世」們啊，",
    "voice": null,
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "給我聽仔細了！",
    "voice": null,
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "我會",
    "voice": "vo_adv_5068005_030",
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "再次給你們力量！",
    "voice": null,
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "\\n現在立即",
    "voice": null,
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "集結至我身邊！",
    "voice": null,
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王二世等人",
    "words": "嘎嘎嘎！嘎嘎嘎！嘎嘎嘎！",
    "voice": null,
    "unit_id": 14913
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "連剛才回收的玩具",
    "voice": "vo_adv_5068005_031",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "都再次動起來了！？",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n這到底是怎麼回事！？",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "1000名同胞啊！",
    "voice": "vo_adv_5068005_032",
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "\\n現在正是我們成為",
    "voice": null,
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "最強、",
    "voice": null,
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "最大、",
    "voice": null,
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "擁有最頂級性能的玩具之時！",
    "voice": null,
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王二世等人",
    "words": "嘎嘎嘎嘎嘎嘎！嘎嘎嘎嘎嘎嘎！嘎嘎嘎嘎嘎嘎！\\n嘎嘎嘎嘎嘎嘎！嘎嘎嘎嘎嘎嘎！嘎嘎嘎嘎嘎嘎！\\n嘎嘎嘎嘎嘎嘎！嘎嘎嘎嘎嘎嘎！嘎嘎嘎嘎嘎嘎！",
    "voice": null,
    "unit_id": 14913
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "──玩具王，",
    "voice": "vo_adv_5068005_033",
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "玩具王",
    "words": "1000隻大合體！",
    "voice": null,
    "unit_id": 14911
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "咦咦～～！？",
    "voice": "vo_adv_5068005_034",
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n玩具王們都聚集過去，",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "變得越來越大了！？",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "still",
    "still_id": "506800501"
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "合體完成！",
    "voice": "vo_adv_5068005_035",
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "究極",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "機械玩具王！！",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "啊哇哇哇哇……！",
    "voice": "vo_adv_5068005_036",
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "玩具王們合體了～！？",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這也太巨大了……！",
    "voice": "vo_adv_5068005_037",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n它們明明不具備合體功能……",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "究竟是如何辦到的……！",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "哼哈哈哈哈哈哈哈哈哈！",
    "voice": "vo_adv_5068005_038",
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "只要深愛著孩子們，",
    "voice": "vo_adv_5068005_039",
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "玩具就是無所不能的！",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "位於如燃燒般赤紅心臟深處的我，",
    "voice": "vo_adv_5068005_040",
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "\\n和1000隻玩具的軀體相接，",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "向它們傳遞力量！",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "我能發揮出一次背起1000個小孩子的力量！",
    "voice": "vo_adv_5068005_041",
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "\\n能同時背起1000人的玩具，",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "僅此我一隻！",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "說是要背起小孩子……",
    "voice": "vo_adv_5068005_042",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n它要是以這種狀態去見他們，",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "可就不光是讓人受點小傷而已了……",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "沒錯……",
    "voice": "vo_adv_5068005_043",
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "現在的玩具王，",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n誤解了「和小孩子玩」的意義。",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "這樣一來，我就是世界上擁有",
    "voice": "vo_adv_5068005_044",
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "最頂級性能的玩具了！",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "從今以後我再也不會被孩子們厭棄，",
    "voice": "vo_adv_5068005_045",
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "會是他們一輩子的玩伴！",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "\\n我能擁有永遠不變的友情！",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "換言之，",
    "voice": "vo_adv_5068005_046",
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "我就是孩子們",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "永遠的朋友了──！",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "那麼，",
    "voice": "vo_adv_5068005_047",
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "我現在要去跟孩子們玩了，告辭！",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "\\n小碧你們，",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "讓路吧！",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "再會了！",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "碧、美冬",
    "words": "呀啊啊啊～～！？",
    "voice": "vo_adv_5068005_048",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "鬼抓人、",
    "voice": "vo_adv_5068005_049",
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "踢罐子、",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "捉迷藏……",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "\\n啊啊，感覺每個都很有趣……",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "好猶豫啊！",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "不過……",
    "voice": "vo_adv_5068005_050",
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "我擁有無限的時間。",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "\\n我要和孩子們把所有遊戲都玩遍！",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "哇哈哈哈哈！！",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "請、",
    "voice": "vo_adv_5068005_051",
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "請等一下……！",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "唔……",
    "voice": "vo_adv_5068005_052",
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "還有事嗎？",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "\\n我可是很忙的。",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "小孩子們都在等我呢。",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那、",
    "voice": "vo_adv_5068005_053",
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那個……",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "玩具王！",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "你所認為的友情……",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "是什麼呢？",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "妳說什麼？",
    "voice": "vo_adv_5068005_054",
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "雖然身為邊緣人的我沒什麼立場評論，",
    "voice": "vo_adv_5068005_055",
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "但我認為，玩具王所說的友情，",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "並不怎麼美好……",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "什麼……？",
    "voice": "vo_adv_5068005_056",
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "因為，",
    "voice": "vo_adv_5068005_057",
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "友情應該是要為彼此著想的！",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "但是，",
    "voice": "vo_adv_5068005_058",
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "你所認為的友情，",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n只是單方面地把自己的想法",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "強加在孩子身上，支配著他們而已……",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "剛才",
    "voice": "vo_adv_5068005_059",
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "回收「玩具王二世」時，",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我看見蘭德索爾各處",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "都是放聲哭泣的小孩子……",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "在我看來，",
    "voice": "vo_adv_5068005_060",
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n那不像是和朋友開心玩樂的畫面……",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "我還以為妳要說什麼呢……",
    "voice": "vo_adv_5068005_061",
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "換我問問妳。",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "小碧……",
    "voice": "vo_adv_5068005_062",
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "對妳而言，",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "「有我在喔好朋友號」",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "並不算是朋友吧？",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "\\n它應該只是你用來練習交朋友的道具。",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "而且，",
    "voice": "vo_adv_5068005_063",
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "妳會去玩具工廠打工，",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "\\n就是因為粗暴地對待它，把它弄壞了的緣故……",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "妳之前曾這麼說過吧？",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "是、",
    "voice": "vo_adv_5068005_064",
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "是這樣沒錯……",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "然後，",
    "voice": "vo_adv_5068005_065",
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "妳若交到了人類朋友，就不再需要練習的道具。",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "\\n這麼一來，",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "它就失去利用價值了。",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "這樣的妳，",
    "voice": "vo_adv_5068005_066",
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "沒有資格和我們這種被粗暴對待……",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "\\n玩壞後便被丟棄的玩具，高談人類與玩具間的友情！",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那、",
    "voice": "vo_adv_5068005_067",
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那個……！",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "雖然正如你所說，",
    "voice": "vo_adv_5068005_068",
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "好朋友號是我製作出來，",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n用來練習交朋友的對象……",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "但、",
    "voice": "vo_adv_5068005_069",
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "但是……！",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "自從開始打工以後，",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我就變得比之前",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "更加倍珍惜好朋友號了……！",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "為了改造它而努力工作的過程很有趣，",
    "voice": "vo_adv_5068005_070",
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "玩具好朋友被製造出來，",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "好朋友號的朋友圈擴大時，",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我也打從心底為它感到開心……！",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "可是……",
    "voice": "vo_adv_5068005_071",
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "可是……",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "或許玩具王說得沒錯……",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "好朋友號……",
    "voice": "vo_adv_5068005_072",
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我一直以來都把你當成練習道具，",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "只考慮了我自己，真的很抱歉……",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "你",
    "voice": "vo_adv_5068005_073",
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "是怎麼……",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "看待我的呢……",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "你從很久很久以前，",
    "voice": "vo_adv_5068005_074",
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "就一直是我重要的……",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "嗚嗚……",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "這是被戳中痛處的淚水吧！",
    "voice": "vo_adv_5068005_075",
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "我就說嘛！",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "\\n小碧，",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "誤解友情的人……",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "其實是妳才對吧！",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "讓我去和朋友玩──！！",
    "voice": "vo_adv_5068005_076",
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "\\n唔喔啊啊啊啊！！",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "{0}，",
    "voice": "vo_adv_5068005_077",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "把你的力量借給我！",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n我們要保護小碧！",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "別礙事！！",
    "voice": "vo_adv_5068005_078",
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "唔……！",
    "voice": "vo_adv_5068005_079",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "小碧，",
    "voice": "vo_adv_5068005_080",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "快振作起來……！",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "領、",
    "voice": "vo_adv_5068005_081",
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "領班……",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "團長……",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "「有我在喔好朋友號」",
    "voice": "vo_adv_5068005_082",
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "……",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "嗚嗚……！",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "哭喊也沒用！",
    "voice": "vo_adv_5068005_083",
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "\\n接下來，準備吃下",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "和我絕交的一擊吧！！",
    "voice": null,
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "到此為止了！",
    "voice": "vo_adv_5068005_084",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "機械玩具王",
    "words": "什麼！？",
    "voice": "vo_adv_5068005_085",
    "unit_id": 14912
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我不許你",
    "voice": "vo_adv_5068005_086",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "再讓我的朋友哭泣了！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在碧等人命懸一線的瞬間，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n一道彷彿能使危機出現轉機的神祕之聲轟然響起。",
    "voice": null,
    "unit_id": null
  }
]
