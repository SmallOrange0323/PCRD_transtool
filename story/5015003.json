  {
    "type": "dialogue",
    "name": "旁白",
    "words": "打聽結束的{0}一行人。\\n大家到約好的茶館集合。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "餡蜜……",
    "voice": "vo_adv_5015003_000",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "既美麗又甜美……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n在豆沙上面淋上",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "甜甜的黑色糖蜜……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "簡直就是完美……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "是完美的和諧啊……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "東國料理真是太美味了……",
    "voice": "vo_adv_5015003_001",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "好像會變胖，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "太可怕了……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不用擔心那個喔。",
    "voice": "vo_adv_5015003_002",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "因為東國的甜點",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n跟蛋糕比起來，更不容易發胖。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "東國甜點",
    "voice": "vo_adv_5015003_003",
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "全部都很美味，",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "尤其",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "草莓大福是我最推薦的！",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "那、",
    "voice": "vo_adv_5015003_004",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "那個呀……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……看到我們正用美味的甜食",
    "voice": "vo_adv_5015003_005",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n逃避現實，你就應該要察覺吧。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "順帶一提，",
    "voice": "vo_adv_5015003_006",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "在我想要打聽什麼的時候，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "大家竟然都理所當然的說",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我的美貌已經超越了美麗之神了。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "而且，",
    "voice": "vo_adv_5015003_007",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "還被推銷了",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n適合我的美貌的商品，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "讓我又買了好幾把髮簪。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我也是……",
    "voice": "vo_adv_5015003_008",
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n不管我怎麼問，",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "他們都",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "含糊的",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "帶過去，",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "而且還",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "不停地被推銷商品。",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "本來想要拒絕的，",
    "voice": "vo_adv_5015003_009",
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "結果",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "臣服於這個DX巨大招財貓的",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "光芒之下了……",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "空花也是……！",
    "voice": "vo_adv_5015003_010",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n一回過神，",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "就買下了",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n比平常採集時會被糾纏住的常春藤",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "還要更粗更堅固的繩子……",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "哎、哎呀，",
    "voice": "vo_adv_5015003_011",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "我看到的時候，",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n就覺得有點想買了……",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "（流口水）……",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……能、",
    "voice": "vo_adv_5015003_012",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "能找到自己想要的東西真是太好了呢。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我的情況也很類似，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "為了讓對方失去戒心就聊了起來，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "結果被說服買下了這個金平糖……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "回去之後我要好好地品嚐。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我算是躲過了推銷，",
    "voice": "vo_adv_5015003_013",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n但也是因為那樣，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "完全不能和人好好的交談……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "前、",
    "voice": "vo_adv_5015003_014",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "前輩的情況怎樣呢？",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "那那、",
    "voice": "vo_adv_5015003_015",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "那該不會……！",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "虐待狂先生，",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "你是想和誰玩那個玩具啊！？",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "咦？　",
    "voice": "vo_adv_5015003_016",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "這就是一般和小孩子玩的玩具啊？",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "空花還以為一定是……",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "不是，",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "什、什麼事都沒有！",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "前、",
    "voice": "vo_adv_5015003_017",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "前輩穿和服！？",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "呼啊啊啊……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "好、",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "好想看一眼……！",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "嗚嗚……",
    "voice": "vo_adv_5015003_018",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "要是去服裝出租店時，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n建議前輩也穿就好了……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "結果大家",
    "voice": "vo_adv_5015003_019",
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "只增加了土產，",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "完全沒有收獲呢……",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "明明知道絕對有什麼事情的……",
    "voice": "vo_adv_5015003_020",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "就是啊……",
    "voice": "vo_adv_5015003_021",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "不論是哪間店，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "都很會做生意，\\n但是，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "感覺都很強勢。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "既然這樣，",
    "voice": "vo_adv_5015003_022",
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "就再調查一下！",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "是啊。",
    "voice": "vo_adv_5015003_023",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我也很在意這個詭異的氣氛。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n出了店外，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這次我們全部的人一起去打聽吧。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "茶屋老闆",
    "words": "啊，",
    "voice": "vo_adv_5015003_024",
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "茶屋老闆",
    "words": "客人！",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "茶屋老闆",
    "words": "\\n請等一下！",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "咦，",
    "voice": "vo_adv_5015003_025",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "有什麼事嗎？",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "錢已經付過了――",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "茶屋老闆",
    "words": "不是的，",
    "voice": "vo_adv_5015003_026",
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "茶屋老闆",
    "words": "是想請你們再多點些什麼吧！",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "茶屋老闆",
    "words": "\\n",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "茶屋老闆",
    "words": "你們看，",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "茶屋老闆",
    "words": "像是我們這裡的名產抹茶煎餅之類的！",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "…………",
    "voice": "vo_adv_5015003_027",
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我知道你是因為我的美貌，",
    "voice": "vo_adv_5015003_028",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "所以想要多留下我們一會，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不過我們還有急事。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "茶屋老闆",
    "words": "沒問題的！",
    "voice": "vo_adv_5015003_029",
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "茶屋老闆",
    "words": "\\n這個可以邊走邊吃！",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "可、",
    "voice": "vo_adv_5015003_030",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "可是，",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n空花已經",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "吃得很飽了……",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "茶屋老闆",
    "words": "那不然這邊的饅頭！",
    "voice": "vo_adv_5015003_031",
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "茶屋老闆",
    "words": "\\n這個可以帶著走，",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "茶屋老闆",
    "words": "晚點再吃也……",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "――夠了，",
    "voice": "vo_adv_5015003_032",
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "請不要再推銷了……！！",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "妮、",
    "voice": "vo_adv_5015003_033",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "妮諾……？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "為什麼……",
    "voice": "vo_adv_5015003_034",
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "為什麼要這樣子，",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n無視別人的想法，",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "也要推銷東西呢！",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "茶屋老闆",
    "words": "妳問為什麼……",
    "voice": "vo_adv_5015003_035",
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "茶屋老闆",
    "words": "那個……",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "茶屋老闆",
    "words": "\\n",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "茶屋老闆",
    "words": "和、",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "茶屋老闆",
    "words": "和你們這些外地人無關吧！",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "……大江戶町應該是",
    "voice": "vo_adv_5015003_036",
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "大家互相幫忙，",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n充滿東國人情味，",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "有著小鎮風情的城鎮才對！",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n可是……",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "這太奇怪了……",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "太奇怪了啦……",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "茶屋老闆",
    "words": "小、",
    "voice": "vo_adv_5015003_037",
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "茶屋老闆",
    "words": "小姐……",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "老闆……",
    "voice": "vo_adv_5015003_038",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "妮諾她",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "非常喜愛東國文化。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "而且，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "也很喜歡這個重視東國文化的城鎮。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "所以她",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "才會對這城鎮的現況感到感嘆。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……如果有什麼原因，請說給我們聽吧。",
    "voice": "vo_adv_5015003_039",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n說不定",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我們也能幫上忙。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "茶屋老闆",
    "words": "你、",
    "voice": "vo_adv_5015003_040",
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "茶屋老闆",
    "words": "你胡扯什麼！",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "茶屋老闆",
    "words": "\\n",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "茶屋老闆",
    "words": "我也…",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "茶屋老闆",
    "words": "我也是啊！",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "茶屋老闆",
    "words": "\\n",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "茶屋老闆",
    "words": "其實我才不想做這種事！！",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "茶屋老闆",
    "words": "可是啊……",
    "voice": "vo_adv_5015003_041",
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "茶屋老闆",
    "words": "要上繳給惡代官大人",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "茶屋老闆",
    "words": "\\n的上納金不夠……",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "惡代官大人？",
    "voice": "vo_adv_5015003_042",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n那是怎麼一回事――",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "鎮民的聲音",
    "words": "呀――――！！",
    "voice": "vo_adv_5015003_043",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "有、",
    "voice": "vo_adv_5015003_044",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "有人尖叫！？",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n是從外面傳來的……！",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "老闆！",
    "voice": "vo_adv_5015003_045",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n稍後我們再跟你問清楚！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "走吧，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "各位！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}一行人往尖叫聲傳來的方向跑了過去。",
