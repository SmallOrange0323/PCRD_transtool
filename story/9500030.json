  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "{0}哥哥！",
    "voice": "vo_adv_9500030_000",
    "unit_id": 102341
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n欸，",
    "voice": null,
    "unit_id": 102341
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "那是真的、真的嗎？",
    "voice": null,
    "unit_id": 102341
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n不是在做夢吧？",
    "voice": null,
    "unit_id": 102341
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "嘿嘿……",
    "voice": null,
    "unit_id": 102341
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "好開心呀♪",
    "voice": null,
    "unit_id": 102341
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "那個啊，",
    "voice": "vo_adv_9500030_001",
    "unit_id": 102341
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "哥哥。",
    "voice": null,
    "unit_id": 102341
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n我也……",
    "voice": null,
    "unit_id": 102341
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「等一下～～！",
    "voice": "vo_adv_9500030_002",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n不好意思打斷你們，",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "但在那之前，",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n先讓我和小子單獨談談。」",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "噗吉……？",
    "voice": "vo_adv_9500030_003",
    "unit_id": 102341
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102341
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "但是……",
    "voice": null,
    "unit_id": 102341
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「綾音，",
    "voice": "vo_adv_9500030_004",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "放心吧。",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n我只是去進行一場『男人之間的對話』而已。」",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「小子，",
    "voice": "vo_adv_9500030_005",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "綾音",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "就拜託你了。",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n要是讓綾音哭泣、",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "讓她感到寂寞，",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "或是讓她感到不安的話，",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n我，",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "噗吉大人可不會放過你喔？」",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「……嘿嘿。",
    "voice": "vo_adv_9500030_006",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "看著你的眼神，",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "我似乎也不需要多說什麼了。",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n看來你真的",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "很重視綾音啊。",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n你的心意，",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "我確實收到了。」",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「喂～",
    "voice": "vo_adv_9500030_007",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "抱歉啊，綾音。",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "讓妳久等了。",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n我已經俐落地談妥",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "男人之間的事了♪",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n接下來輪到綾音了。",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "把妳的答覆，",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "說給他聽吧。」",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "噗吉……",
    "voice": "vo_adv_9500030_008",
    "unit_id": 102341
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102341
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "……嗯♪",
    "voice": null,
    "unit_id": 102341
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "哥哥。",
    "voice": "vo_adv_9500030_009",
    "unit_id": 102341
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n我，",
    "voice": null,
    "unit_id": 102341
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "喜歡哥哥。",
    "voice": null,
    "unit_id": 102341
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102341
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "比任何人都喜歡……",
    "voice": null,
    "unit_id": 102341
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我想應該，",
    "voice": null,
    "unit_id": 102341
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "是世界上最喜歡哥哥的人了。",
    "voice": null,
    "unit_id": 102341
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "今後，",
    "voice": "vo_adv_9500030_010",
    "unit_id": 102341
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我也想一直和哥哥在一起。",
    "voice": null,
    "unit_id": 102341
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102341
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我絕對不要",
    "voice": null,
    "unit_id": 102341
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "和哥哥分開！",
    "voice": null,
    "unit_id": 102341
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102341
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "所以……",
    "voice": null,
    "unit_id": 102341
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "那個……",
    "voice": null,
    "unit_id": 102341
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "……真的嗎？",
    "voice": "vo_adv_9500030_011",
    "unit_id": 102341
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102341
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "今後也會一直",
    "voice": null,
    "unit_id": 102341
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "陪在我身邊嗎？",
    "voice": null,
    "unit_id": 102341
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102341
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "……",
    "voice": null,
    "unit_id": 102341
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "太好了！",
    "voice": null,
    "unit_id": 102341
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "太",
    "voice": null,
    "unit_id": 102341
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "好了、太好了～！",
    "voice": null,
    "unit_id": 102341
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "說好了喔！",
    "voice": "vo_adv_9500030_012",
    "unit_id": 102341
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "要說到做到喔！？",
    "voice": null,
    "unit_id": 102341
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102341
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "就算哥哥說不要，我也不會離開哥哥喔！",
    "voice": null,
    "unit_id": 102341
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "嘿嘿……♪",
    "voice": "vo_adv_9500030_013",
    "unit_id": 102341
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n謝謝哥哥願意",
    "voice": null,
    "unit_id": 102341
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "和我約定！",
    "voice": null,
    "unit_id": 102341
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102341
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "這樣一來，",
    "voice": null,
    "unit_id": 102341
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我就沒有什麼好害怕的了！",
    "voice": null,
    "unit_id": 102341
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "最喜歡哥哥了！",
    "voice": "vo_adv_9500030_014",
    "unit_id": 102341
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "要永遠、永遠",
    "voice": null,
    "unit_id": 102341
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "在一起喔！",
    "voice": null,
    "unit_id": 102341
  }
]
