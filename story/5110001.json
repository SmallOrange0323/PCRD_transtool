[
  {
    "type": "background",
    "bg_id": "500035"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "從熱鬧的白天進入平靜夜晚的蘭德索爾街頭，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n矛依未正在一個人遊蕩。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "哎呀──",
    "voice": "vo_adv_5110001_000",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "天都黑了……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n真不像我呢，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "竟然跟普通人一樣在慶典上玩樂……！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "不過",
    "voice": "vo_adv_5110001_001",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "沒關係！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "慶典也才剛開始！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n把壞蛋的實力",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "留到明天再來大展身手！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你、",
    "voice": "vo_adv_5110001_002",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你幹什麼……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "說些莫名其妙的話……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "喂、",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "喂，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你打算幹嘛，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "住手，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "嗚、",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "嗚哇──！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "什麼？",
    "voice": "vo_adv_5110001_003",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "剛才的聲音……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "有人被襲擊了嗎？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "雖然不知道是什麼惡劣的壞蛋，",
    "voice": "vo_adv_5110001_004",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "選在有我的地方做壞事，算他倒楣！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "好──！",
    "voice": "vo_adv_5110001_005",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "當作是慶典的延續，上吧！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "哈──哈哈！",
    "voice": "vo_adv_5110001_006",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "大壞蛋諾維姆登場！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n想變成天樓霸斷劍上鏽斑的人，儘管來吧！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……",
    "voice": "vo_adv_5110001_007",
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "咦，",
    "voice": "vo_adv_5110001_008",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "女的？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "有點意外啊……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "不過也是，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這城鎮裡也是有幾個很扯的女生嘛。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "喂，",
    "voice": "vo_adv_5110001_009",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "放開那個男的！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n選在慶典的日子襲擊別人",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "是三流壞蛋才會做的事喔！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……襲擊？",
    "voice": "vo_adv_5110001_010",
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "還以為妳突然冒出來是要說些什麼，",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "誤會也該有個限度吧。",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "──這是救濟喔。",
    "voice": "vo_adv_5110001_011",
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "啊？",
    "voice": "vo_adv_5110001_012",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "救濟？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n一個勁地抓著他的臉還說是救濟──",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "太好了……",
    "voice": "vo_adv_5110001_013",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "哈哈，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "太好了，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "太好了──！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "嗚喔，",
    "voice": "vo_adv_5110001_014",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這、",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這傢伙怎麼一回事……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n明明被襲擊了，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "為什麼還一臉開心的樣子啊？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "振作一點！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "嗚喔──！",
    "voice": "vo_adv_5110001_015",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "打進沙灘棒球全國大賽啦──！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "嗚嗚……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我現在，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "超級感動的！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "喂喂，",
    "voice": "vo_adv_5110001_016",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "完全無法溝通啊……？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "那當然。",
    "voice": "vo_adv_5110001_017",
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "因為他現在已經是「樂園的居民」，",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "身處在幸福當中。",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "他已經完全",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "看不到現實了。",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "啊、",
    "voice": "vo_adv_5110001_018",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "啊？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "妳在說什麼……？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n不要說這麼難懂的話啦！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "啊不管了！",
    "voice": "vo_adv_5110001_019",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "總之就先把妳打飛！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "要怪就怪妳運氣不好，遇到了大壞蛋！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……仔細一看，",
    "voice": "vo_adv_5110001_020",
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "妳的臉看起來很不幸呢。",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "什……",
    "voice": "vo_adv_5110001_021",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "妳曾遭逢天大的悲劇，",
    "voice": "vo_adv_5110001_022",
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "現在緊抓著過去的回憶生活著。",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "不是嗎？",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "妳……！",
    "voice": "vo_adv_5110001_023",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "看來說對了呢。",
    "voice": "vo_adv_5110001_024",
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "但我沒有揶揄妳的意思。",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "倒不如說，妳是正確的。",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "即使心中懷抱夢想和希望，",
    "voice": "vo_adv_5110001_025",
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "也很容易被現實否定。",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "等待我們的是絕望的未來喔。",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "既然如此，",
    "voice": "vo_adv_5110001_026",
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "乾脆永遠",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "沉浸在幸福的回憶裡，不是比較好嗎？",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這種事，",
    "voice": "vo_adv_5110001_027",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "怎麼可能──",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "辦得到喔，",
    "voice": "vo_adv_5110001_028",
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我們辦得到。",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n我們就是為此而來的。",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "看到剛剛那位男子了吧？",
    "voice": "vo_adv_5110001_029",
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n看起來非常幸福的樣子……",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "這就是最完美的證據喔。",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這傢伙……",
    "voice": "vo_adv_5110001_030",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "跟單純腦袋有問題的傢伙不一樣耶？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這傢伙抱著強大的信念，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "並擁有能實現這個信念的力量……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "那麼，",
    "voice": "vo_adv_5110001_031",
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我也讓妳成為樂園的居民吧。",
    "voice": null,
    "unit_id": 9011
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "呃！",
    "voice": "vo_adv_5110001_032",
