  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "なんかさー、",
    "voice": "vo_adv_6023108_000",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "クラスの子たちとか、",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "\\nうちのこと謎に恐がってンだよねー",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "え、なんでよ、",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "うちのどこがそんな恐いのかな。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "顔。",
    "voice": "vo_adv_6023108_001",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "なるほど、顔か。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "うん、",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "顔はどうしようもない。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "生まれつきだから。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "ごめん諦めて。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "えー、",
    "voice": "vo_adv_6023108_002",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "そおかな、",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "そんな声してるぅ？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "\\nふみゅう、",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "自分ではよく分かんにゃいけど……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "おい。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "なんだその目は。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "呆れか。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "憐れみか。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "やめろ見るな。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "見るな。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "あ？　",
    "voice": "vo_adv_6023108_003",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "なんだァ、",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "てめえ……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "うちがいつそんなオーラ放った？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "あんたに脅迫とか恫喝とかしたことあるか？　",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "言ってみろゴルァ！",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "\\n声を荒げて脅したことなんか一度もねえだろ！　",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "天使だコノヤロウ！",
    "voice": null,
    "unit_id": 110811
  }
]
