    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "是、",
    "voice": "vo_adv_1147001_078",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "是啊！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "\\n實在是太厲害了，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "不小心嚇了一大跳啊……！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "不只天空放晴，",
    "voice": "vo_adv_1147001_079",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "\\n連剛才的狂暴的巨浪",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "都徹底平息了！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "不等能再發呆了！",
    "voice": "vo_adv_1147001_080",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "快準備出航啦──！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "喂，",
    "voice": "vo_adv_1147001_081",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "你們也過來幫忙準備！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "\\n想上船的話，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "就乖乖當個最底層的漁夫助手吧！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "漁夫的孩子們",
    "words": "我們知道了！",
    "voice": "vo_adv_1147001_082",
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "501161"
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "哎呀～",
    "voice": "vo_adv_1147001_083",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "教訓完作惡的魔物後",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n心情真好！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "真痛快！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "它錯就錯在新年這天睡昏頭，",
    "voice": "vo_adv_1147001_084",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "竟然躲在烏雲裡繼續睡回籠覺！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "它自己應該也沒想到，",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "才剛迎來新年竟然就被人教訓了一頓吧！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你說誰啊！？",
    "voice": "vo_adv_1147001_085",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我只是",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "想把魔物打倒而已喔！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "還有，",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我叫諾維姆啦！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你也差不多該記住了吧！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "不過，",
    "voice": "vo_adv_1147001_086",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "今天就不跟你計較了……",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "比起這個，",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我們也快去吧！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "錯過上船時間就不好了！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "接下來要大釣特釣，",
    "voice": "vo_adv_1147001_087",
    "unit_id": 114711
  },
