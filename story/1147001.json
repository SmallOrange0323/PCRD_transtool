[
  {
    "type": "background",
    "bg_id": "501163"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在大間鎮過新年的{0}，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n於夜晚的街道上撞見了熟悉的身影。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "啊呣！",
    "voice": "vo_adv_1147001_000",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "唔呣！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "嚼嚼……！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n咕嘟……",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "真好吃──！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "咦？",
    "voice": "vo_adv_1147001_001",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "在那裡的人是……",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "喂──！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "{0}──！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這邊啦這邊──！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "嘿！",
    "voice": "vo_adv_1147001_002",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你最近還好嗎？",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n我過得很好喔！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "是嘛！",
    "voice": "vo_adv_1147001_003",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "那就好！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n雖然發生了很多事，",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "但這個城鎮還是個好地方呢！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "畢竟，",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這裡的魚超級好吃！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "而且這裡的夜晚很安靜，",
    "voice": "vo_adv_1147001_004",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "海浪聲讓人心情舒暢，",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n很助眠喔！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……只不過，",
    "voice": "vo_adv_1147001_005",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "也差不多該回蘭德索爾了。",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "雖然有些依依不捨，",
    "voice": "vo_adv_1147001_006",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "但也不能一直在這裡悠悠哉哉的啊。",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "而且，",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我也很在意",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "蘭德索爾舉辦的那個什麼廟會！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "話說回來，",
    "voice": "vo_adv_1147001_007",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你明天有什麼計畫？",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這樣啊！",
    "voice": "vo_adv_1147001_008",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "那明天就來陪我吧！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我打算跟著漁夫大叔",
    "voice": "vo_adv_1147001_009",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "出海釣魚喔！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你也跟我一起來！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我想在離開這裡之前，",
    "voice": "vo_adv_1147001_010",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n留下",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "最後的回憶！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "會這麼說啊，",
    "voice": "vo_adv_1147001_011",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n是因為我們好不容易",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "變成夥伴了對吧？",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "至今為止都只有和戰鬥相關的回憶，",
    "voice": "vo_adv_1147001_012",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "既然如此，",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "今後再創造一些快樂的回憶",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n應該也不錯，",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我是這麼想的。",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "再加上，",
    "voice": "vo_adv_1147001_013",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "能趁新鮮品嚐自己釣到的魚，",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n這可是相當少有的機會喔！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "就這麼決定了！",
    "voice": "vo_adv_1147001_014",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "聽說海釣",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "一大早就得出發，",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n我要先去睡了！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你也別睡過頭囉！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我們明天要釣一堆魚，",
    "voice": "vo_adv_1147001_015",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "然後吃個過癮──！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "明天見啦，",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "晚安──！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "快起床──！",
    "voice": "vo_adv_1147001_016",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "天亮啦──！！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你是不是",
    "voice": "vo_adv_1147001_017",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "睡傻啦？",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "快去洗把臉，",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我們要出海囉──！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "background",
    "bg_id": "501163"
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這、",
    "voice": "vo_adv_1147001_018",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這是怎麼回事──！？",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n喂，",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "海浪怎麼這麼洶湧啊？",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "昨天睡前",
    "voice": "vo_adv_1147001_019",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "還是一片平靜的吧……？",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你應該還記得吧？",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我是有聽說冬天很常出現狂浪，",
    "voice": "vo_adv_1147001_020",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n但會像這樣一夜之間就天翻地覆嗎？",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "哦，",
    "voice": "vo_adv_1147001_021",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "早啊！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "\\n妳起得真早。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "我還以為妳一定會睡過頭。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "誰會睡過頭啊，",
    "voice": "vo_adv_1147001_022",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我又不是小孩子！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "比起這個，",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "不用為出海做準備嗎？",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "漁夫的孩子1",
    "words": "就是說啊──！",
    "voice": "vo_adv_1147001_023",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "漁夫的孩子1",
    "words": "快讓我上船啦──！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "漁夫的孩子1",
    "words": "\\n我都遵守約定，",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "漁夫的孩子1",
    "words": "元旦好好睡覺沒有守夜耶──！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "漁夫的孩子2",
    "words": "我今天一定要在船上看日出啦──！",
    "voice": "vo_adv_1147001_024",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "漁夫的孩子2",
    "words": "\\n而且，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "漁夫的孩子2",
    "words": "這是我們第一次出海耶！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "漁夫的孩子2",
    "words": "我們已經期待很久了！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "這我當然知道。",
    "voice": "vo_adv_1147001_025",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "但是啊，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "你們仔細看看大海吧？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "\\n風浪這麼大，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "現在還沒辦法開船出海。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "你們想成為獨當一面的優秀漁夫，",
    "voice": "vo_adv_1147001_026",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "\\n就要具備讀浪的能力。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "要開船出海",
    "voice": "vo_adv_1147001_027",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "還得等一段時間。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "學會等待也是漁夫的工作。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "\\n太過焦躁而提前收竿的話，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "就會把魚給放跑。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "大海不會逃走。",
    "voice": "vo_adv_1147001_028",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "相反它無邊無際地在你面前展開。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "\\n所以現在就拿出海上男兒的風範，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "沉著地等待時機吧。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "漁夫的孩子們",
    "words": "知道了……",
    "voice": "vo_adv_1147001_029",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你們給我聽好了。",
    "voice": "vo_adv_1147001_030",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "別從新年開始就悶悶不樂的啊！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n難得的喜慶氛圍都被破壞掉了！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "再等等看的話，",
    "voice": "vo_adv_1147001_031",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "說不定天氣就會放晴啦！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n現在放棄還太早了！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "還有，",
    "voice": "vo_adv_1147001_032",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "即使不在船上也能看到日出吧。",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n和我們一起在岸上等日出吧？",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我們雖然是為了海釣而來，",
    "voice": "vo_adv_1147001_033",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "但像現在這樣等日出也不錯。",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n反正這種象徵吉祥的事物",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "永遠看不膩，",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "也能算是個美好回憶嘛！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "漁夫的孩子1",
    "words": "對耶。",
    "voice": "vo_adv_1147001_034",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "漁夫的孩子1",
    "words": "你們兩個",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "漁夫的孩子1",
    "words": "馬上就要回去了。",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "漁夫的孩子1",
    "words": "\\n",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "漁夫的孩子1",
    "words": "那，",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "漁夫的孩子1",
    "words": "在日出前跟我說說你們的事嘛！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "漁夫的孩子2",
    "words": "姐姐在蘭德索爾",
    "voice": "vo_adv_1147001_035",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "漁夫的孩子2",
    "words": "是做什麼的啊──？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "哦哦，",
    "voice": "vo_adv_1147001_036",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "想聽大壞蛋諾維姆的故事嗎？",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n你問得真好……",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "──然後啊，",
    "voice": "vo_adv_1147001_037",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我一揮動天樓霸斷劍，",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n那些小嘍囉就通通被轟飛了！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "哈哈哈！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "漁夫的孩子1",
    "words": "好厲害！",
    "voice": "vo_adv_1147001_038",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "漁夫的孩子1",
    "words": "\\n",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "漁夫的孩子1",
    "words": "我想看看",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "漁夫的孩子1",
    "words": "那把大劍！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "漁夫的孩子1",
    "words": "妳把它藏在哪裡呀──？",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "天樓霸斷劍",
    "voice": "vo_adv_1147001_039",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "是我的殺手鐧。",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "只有在幹壞事時──",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……我說，",
    "voice": "vo_adv_1147001_040",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "日出時間",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "是不是快到了啊？",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "不要說天氣變好了，",
    "voice": "vo_adv_1147001_041",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n雲層好像更厚了耶？",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "漁夫的孩子1",
    "words": "問你喔，",
    "voice": "vo_adv_1147001_042",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "漁夫的孩子1",
    "words": "爸爸……",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "漁夫的孩子1",
    "words": "我們是不是",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "漁夫的孩子1",
    "words": "看不到日出了？",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "看來",
    "voice": "vo_adv_1147001_043",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "是那樣沒錯……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "再加上",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "大海也鬧起脾氣來了，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "\\n巨浪一波接著一波，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "這下根本無法出海。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "抱歉啊，",
    "voice": "vo_adv_1147001_044",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "讓大家白期待了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "\\n我們也同樣",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "很想出海……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "但是，",
    "voice": "vo_adv_1147001_045",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "對手是大自然。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "\\n我們這些渺小的人類，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "也有無法戰勝的時候啊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "呃！",
    "voice": "vo_adv_1147001_046",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "竟然還打雷了？",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n沒辦法……",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "在下雨前",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "趕緊回旅館吧。",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "再多待一天，",
    "voice": "vo_adv_1147001_047",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "明天一定要出海！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "所謂「太陽依舊會升起」",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "嘛！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "是啊，",
    "voice": "vo_adv_1147001_048",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "但願如此。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "只是，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "這陣雷……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "說不定……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "啊，",
    "voice": "vo_adv_1147001_049",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "那巨大的雷光柱……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "果然沒錯！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "為什麼不祥的預感總是會靈驗啊！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "抱歉在妳興奮時潑冷水……",
    "voice": "vo_adv_1147001_050",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "\\n這裡恐怕明天也見不到太陽了。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "……不，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "何止明天，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "最近暫時都見不到吧。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "暴風雨就要來了。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "嗯？",
    "voice": "vo_adv_1147001_051",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "不就是打雷嗎？",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n總有停下來的時候吧？",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "那陣雷",
    "voice": "vo_adv_1147001_052",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "可不只是天氣不好造成的。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "\\n我們漁夫能分辨得出來，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "那是名為",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "「雷雷」的魔物在作祟！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "可惡！",
    "voice": "vo_adv_1147001_053",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "本來帶著好心情要出海捕魚的！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "\\n新年剛開始就真不走運啊……！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "什麼嘛……",
    "voice": "vo_adv_1147001_054",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "原來只是魔物在搗蛋啊。",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "什麼「只是」……",
    "voice": "vo_adv_1147001_055",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "每到這個時期，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "我們都很為那傢伙所苦啊。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "\\n而且，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "要是把它當成普通的雷雷，那可就大錯特錯了。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "它吸收了冬季厚重烏雲裡積累的電氣，",
    "voice": "vo_adv_1147001_056",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "\\n比一般的雷雷更加膨大。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "妳也看見剛才的落雷了吧？",
    "voice": "vo_adv_1147001_057",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "它的威力超乎尋常！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "就像",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "脂肪增多後回流的魚一樣！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "我們漁夫",
    "voice": "vo_adv_1147001_058",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "是大海的專家。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "抓水裡的魚一向手到擒來。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "\\n但是，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "遇到雲裡的魔物也只能舉雙手投降了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "根本束手無策啊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "放心吧！",
    "voice": "vo_adv_1147001_059",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "包在我們身上！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n我們會讓你能出海的！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "喂，你們。",
    "voice": "vo_adv_1147001_060",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n剛剛說",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "想看我的天樓霸斷劍對吧？",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "漁夫的孩子1",
    "words": "對、",
    "voice": "vo_adv_1147001_061",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "漁夫的孩子1",
    "words": "對呀……",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "漁夫的孩子1",
    "words": "妳該不會",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "漁夫的孩子1",
    "words": "要去打倒魔物吧？",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "漁夫的孩子2",
    "words": "雖然妳說那是一把大劍，",
    "voice": "vo_adv_1147001_062",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "漁夫的孩子2",
    "words": "\\n但再怎麼說，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "漁夫的孩子2",
    "words": "要對付雲裡的魔物也太勉強了！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我要釣很多魚，",
    "voice": "vo_adv_1147001_063",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "然後大吃一頓！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "要是有人想妨礙我，",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "只要把他轟飛就行了！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你們也好、",
    "voice": "vo_adv_1147001_064",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "漁夫大叔們也好，",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "大家都想出海吧？",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n那就和我一樣啦！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "喂，{0}！",
    "voice": "vo_adv_1147001_065",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "把你的力量借給我！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "輪到大壞蛋出場了！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "作惡的傢伙",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "就由我來解決！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "很好！",
    "voice": "vo_adv_1147001_066",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "力量湧出來了！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n新年第一劍……",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我要鼓足幹勁，",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "拿出全力上囉──！！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "顯現吧！",
    "voice": "vo_adv_1147001_067",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "天樓霸斷劍──！！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "background",
    "bg_id": "500522"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "哈～哈哈哈！",
    "voice": "vo_adv_1147001_068",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "怎麼樣，認輸了吧！！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "雲散去了……！",
    "voice": "vo_adv_1147001_069",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "\\n也就是說",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "妳只憑一劍",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "就把空中的魔物打倒了嗎？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "嗯！",
    "voice": "vo_adv_1147001_070",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這就是我們",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "和天樓霸斷劍的力量！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我就說吧，",
    "voice": "vo_adv_1147001_071",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "連雲裡的魔物都能轟飛。",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "有我和這傢伙在，",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "就沒有什麼是砍不倒的！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "漁夫的孩子們",
    "words": "好、",
    "voice": "vo_adv_1147001_072",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "漁夫的孩子們",
    "words": "好猛喔～～",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "哦？",
    "voice": "vo_adv_1147001_073",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "大海的彼端似乎漸漸亮起來了。",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……那是！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "太好了！",
    "voice": "vo_adv_1147001_074",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "好像正好趕上日出喔！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n今天的太陽看起來",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "格外巨大耶！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "果然吉祥的事物看多少次都還是很棒呢。",
    "voice": "vo_adv_1147001_075",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n也和你創造出新的回憶啦！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "漁夫們",
    "words": "哦哦～～",
    "voice": "vo_adv_1147001_076",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "喂，",
    "voice": "vo_adv_1147001_077",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "大叔們！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你們要發呆到什麼時候啊！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "攪亂大海的魔物已經消失了！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這下就能開船出海了吧？",
