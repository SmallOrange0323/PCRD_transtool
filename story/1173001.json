    "name": "千歌",
    "words": "沒想到光是場面不同，",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n居然會顯得這麼困難……",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "不過……",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "那、",
    "voice": "vo_adv_1173001_039",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "那那……",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "那個，",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "你、",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "你你你……",
