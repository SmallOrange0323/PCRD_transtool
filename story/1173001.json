[
  {
    "type": "background",
    "bg_id": "500160"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "慈樂之音巡演中的某個夏日，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n千歌獨自佇立在海灘上。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "唉……",
    "voice": "vo_adv_1173001_000",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "就是覺得難得的假期關在旅館裡也很可惜，",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n才會豁出去跑來海邊……",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "但在海邊",
    "voice": "vo_adv_1173001_001",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "到底要做些什麼才好……？",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我很少從事夏天的娛樂，",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n所以不是很懂……",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "沙灘上的人",
    "voice": "vo_adv_1173001_002",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "大多是一家人或情侶……",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "落單的似乎就只有我……",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "像這種時候，",
    "voice": "vo_adv_1173001_003",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "要是有望或紡希陪在身邊就好了，",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "但她們都有事出門了。",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我乾脆乖乖回旅館去吧──",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "呀！",
    "voice": "vo_adv_1173001_004",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "嚇、",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "嚇我一跳……",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n原來是{0}啊……",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "難、",
    "voice": "vo_adv_1173001_005",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "難不成你有聽見",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我剛才的自言自語？",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "……",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是的，",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "就像你看到的，",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我沒事可做，",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "不知如何是好。",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "咦，",
    "voice": "vo_adv_1173001_006",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "跟你一起玩？",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "莫非",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "你經常來海邊嗎？",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "每、",
    "voice": "vo_adv_1173001_007",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "每年嗎！",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "那還真是可靠呢。",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n那麼，和我也……",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "啊！",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "冷靜想想，",
    "voice": "vo_adv_1173001_008",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "跟男性獨處，",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "在海邊，",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "而且是穿著泳裝一起玩，",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "這是一件非常害羞的事吧……！？　",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我之前有單獨跟他出門過好幾次，",
    "voice": "vo_adv_1173001_009",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "但海邊跟泳裝的組合，",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "難度好像太高了……",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "那、",
    "voice": "vo_adv_1173001_010",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "那、",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "那個……",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我果然辦不到！",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "唉，",
    "voice": "vo_adv_1173001_011",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我原本還以為成功舉辦大型演唱會後，",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我已經很有自信了，",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "但會因為這種小事就亂了手腳，",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "就代表我還不行啊。",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我果然",
    "voice": "vo_adv_1173001_012",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "不適合",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "享受夏季的大海對吧……",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "對、",
    "voice": "vo_adv_1173001_013",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "對不起，",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我突然覺得很難為情……",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "你不用管我，",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "請儘管享受大海吧。",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "咦？",
    "voice": "vo_adv_1173001_014",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "……",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "這麼說來，",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "跟你相遇時的我，",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n因為太過緊張而沒辦法在別人面前唱歌呢。",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "……可是，",
    "voice": "vo_adv_1173001_015",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "跟你在一起後，",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我慢慢變得有辦法在別人面前唱歌，",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "後來甚至還開了個人演唱會。",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "即使一個人辦不到，",
    "voice": "vo_adv_1173001_016",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "只要跟你在一起，就一定沒問題……",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "不好意思，",
    "voice": "vo_adv_1173001_017",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "讓你看到我丟臉的樣子了。",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "……那個，",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我要重新拜託你。",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "請你",
    "voice": "vo_adv_1173001_018",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "教我享受夏季大海的方法。",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "來到沙灘上後我再次感覺到……",
    "voice": "vo_adv_1173001_019",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n人數的多寡跟熱鬧的程度",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "應該是和蘭德索爾相差不遠，",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n但氣氛卻因為開放感而顯得完全不同。",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "好熱……",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "這就是夏季大海的熱氣……",
    "voice": "vo_adv_1173001_020",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "跟演唱會又不同的熱氣……",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "大家就是想感受這種熱氣",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "才聚集過來的嗎……？　",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "哇，",
    "voice": "vo_adv_1173001_021",
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "有很多人呢。",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "感覺一不小心",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "就會走散……",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "怕走散的話，喏，",
    "voice": "vo_adv_1173001_022",
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "只要像這樣牽著手就沒問題了。",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "呵呵呵，",
    "voice": "vo_adv_1173001_023",
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "謝謝。",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "那我們走吧♪",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "……總覺得，",
    "voice": "vo_adv_1173001_024",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "很棒呢……",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "像那樣牽手的感覺。",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "呃，",
    "voice": "vo_adv_1173001_025",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我我",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我是在",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "胡思亂想什麼啊！",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "可是……",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "如果能像周圍的情侶那樣牽手，",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "肯定會……",
    "voice": null,
    "unit_id": 117311
  },
  {
