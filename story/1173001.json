    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "明明穿泳裝開演唱會時，也是很多人在看，",
    "voice": "vo_adv_1173001_030",
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "但我現在總覺得靜不下來。",
