    "name": "千歌",
    "words": "我想跟你一起享受自由。",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n我現在變得會這樣想了……",
    "voice": null,
    "unit_id": 117311
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "{0}，我們走吧。",
    "voice": "vo_adv_1173001_037",
