  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──依里為了改善自己的怕生而展開特訓。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n當她在會合地點等待時，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n姍姍來遲的{0}終於出現了。",
