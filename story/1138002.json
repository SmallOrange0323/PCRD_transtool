    "words": "呵呵，",
    "voice": "vo_adv_1138002_054",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "只要看見你們倆剛才相處的情形，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n就能知道他並不是那樣的人喔。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n真不愧是天使大人的戀人呢。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "………………！？",
    "voice": "vo_adv_1138002_055",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n戀、",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "戀戀、",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "戀人……！？",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "你們兩位要舉辦婚禮時，",
    "voice": "vo_adv_1138002_056",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "請一定要讓我好好報答你們。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "在那之前，我會好好努力，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "讓自己不是經營攤販，\\n而是擁有自己的商店。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "不、",
    "voice": "vo_adv_1138002_057",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "不是這樣的！！",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n我和那傢伙",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "並不是那種關係……！",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "歡迎回來。",
    "voice": "vo_adv_1138002_058",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n沒什麼，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我們只是在聊你和天使大人的關係。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "不，所以說，我們是……",
    "voice": "vo_adv_1138002_059",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "啊，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "對了！",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n你也來跟他說！",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n跟他說我們的關係並不是那樣……",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "什、",
    "voice": "vo_adv_1138002_060",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "什什……",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "什…………",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "喔喔，",
    "voice": "vo_adv_1138002_061",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "你們果然是那樣的關係啊。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "為什麼你總愛講這種會讓人誤解的話啊！",
    "voice": "vo_adv_1138002_062",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n受不了，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "你別再開口了～～！！",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "background",
    "bg_id": "500041"
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "──好，",
    "voice": "vo_adv_1138002_063",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "大致完成了呢。",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "剩下的我們會想辦法處理，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "所以今天就先解散吧。",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我會準備當天的餐點。",
    "voice": "vo_adv_1138002_064",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n不只是為了妻子而已，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我會試著做出能讓天使大人",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n和來參加的各位開心享用的菜餚。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "麻煩你了。",
    "voice": "vo_adv_1138002_065",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "那這麼一來，大部分的準備工作就……",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "啊！",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n還沒有決定好要找誰來主持祝福儀式……",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "的、",
    "voice": "vo_adv_1138002_066",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "的確是這樣。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "但我沒有錢",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "能找人來擔任這個職務……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "既然如此，",
    "voice": "vo_adv_1138002_067",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "就只能由我們自己來了嗎？",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n遇到這種狀況，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "應該是那傢伙比較適合吧……",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "可是，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我……！",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "那、",
    "voice": "vo_adv_1138002_068",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "那個……",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "可以讓我來負責這個職務嗎？",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "咦……",
    "voice": "vo_adv_1138002_069",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "雖然我可能會做得不太好……",
    "voice": "vo_adv_1138002_070",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "但提議要來舉辦",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "這場婚禮的人是我，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n所以我想好好努力到最後，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "祝福你們兩位！",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "而、",
    "voice": "vo_adv_1138002_071",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "而且，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "你看！",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n我難得做出了這樣的打扮！",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "所、",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "所以說……",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "那個……",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我和妻子……",
    "voice": "vo_adv_1138002_072",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "果真是受到上天眷顧著呢。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "……咦？",
    "voice": "vo_adv_1138002_073",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我沒有拒絕妳的理由。",
    "voice": "vo_adv_1138002_074",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n反而是我要拜託妳才對。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "天使大人，",
    "voice": "vo_adv_1138002_075",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "可以請妳在婚禮上",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "祝福我和妻子嗎？",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "……好、",
    "voice": "vo_adv_1138002_076",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "好的！",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n我……",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "會全力以赴的！",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──最後決定親自為新郎和新娘獻上祝福的依里，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n更堅定了決心，等待著婚禮之日到來。",
    "voice": null,
    "unit_id": null
  }
]
