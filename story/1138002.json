  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "天使大人嗎？",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "你、",
    "voice": "vo_adv_1138002_006",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "你說實現心願……",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "那、",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "那個，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n雖然我打扮成這副樣子，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "但我並不是真正的天使……",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "所以說，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "那個，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "這、",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "這種事情有點……",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "不、",
    "voice": "vo_adv_1138002_007",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "不是這樣嗎？",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "這件事是在我去咲戀育幼院擺攤時，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n從他和孩子們那裡聽說的……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "他們說有個會幫忙解決煩惱的人，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "而那個人一定就是，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "能幫人實現心願的",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "天使……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "不，",
    "voice": "vo_adv_1138002_008",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "所以說，那個……",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我、",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我問你！",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n這是怎麼一回事啊！",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "咦……",
    "voice": "vo_adv_1138002_009",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "你說這是因為",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "你想幫助在傷腦筋的人……",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "嗯，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "雖然我是能夠同理你這種想法……",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "可是，",
    "voice": "vo_adv_1138002_010",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我這種人能解決成年人遇到的困擾嗎……",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "總、",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "總而言之，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "就先聽他說說看吧……",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "那、",
    "voice": "vo_adv_1138002_011",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "那個……",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "雖然不知道像我這樣的人能不能幫上你的忙，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "可以請你先說說看是什麼事情嗎？",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "謝、",
    "voice": "vo_adv_1138002_012",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "謝謝妳！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我其實是個",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "用小攤子在賣餐點的人，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n不過我在不久前結婚了。",
