    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "是這樣嗎！？",
    "voice": "vo_adv_1138002_013",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n恭喜你！",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "…………",
    "voice": "vo_adv_1138002_014",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "你們的婚姻",
    "voice": "vo_adv_1138002_015",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "不順利嗎……？",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "不，",
    "voice": "vo_adv_1138002_016",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我們夫妻的感情很好。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "妻子為了我，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "總是在不辭辛勞地努力，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n為了回應妻子的心意，我也想努力打拼。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "……但我完全沒能",
    "voice": "vo_adv_1138002_017",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "為妻子做點什麼。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n我才剛開始擺攤，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "既沒辦法",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "送她衣服，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "甚至也無法舉行婚禮。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "…………",
    "voice": "vo_adv_1138002_018",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "要是我賺得更多，",
    "voice": "vo_adv_1138002_019",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n就能為妻子舉辦婚禮了，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "事情卻無法如我所願……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "……但就算是這樣，",
    "voice": "vo_adv_1138002_020",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我還是想做點什麼，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n回報總是在支持我的妻子！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "天使大人，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "如果妳願意的話，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n能不能請妳和我一起想想向妻子表達謝意的方法呢？",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "就算沒辦法舉辦婚禮，",
    "voice": "vo_adv_1138002_021",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "至少讓我為她做點什麼……！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "就、",
    "voice": "vo_adv_1138002_022",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "就算你這麼說……",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "就、",
    "voice": "vo_adv_1138002_023",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "就算找我商量這種事，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我也沒辦法幫忙解決啊！",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "雖然很抱歉，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "但這時候只能說我也不知道……",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "咦？",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "男性",
