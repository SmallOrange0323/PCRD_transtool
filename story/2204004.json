    "voice": "vo_adv_2204004_008",
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n雖然兄長大人他們說了",
    "voice": null,
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n絕對不可以勉強……",
    "voice": null,
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "是啊，",
    "voice": "vo_adv_2204004_009",
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "莉莉。",
    "voice": null,
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n這個世界的大家",
    "voice": null,
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "都對我們非常好。",
    "voice": null,
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "想要幫上忙，",
    "voice": null,
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "現在正是該努力的時候……",
    "voice": null,
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我也是這麼想的。",
    "voice": null,
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "是的！",
    "voice": "vo_adv_2204004_010",
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n就在這邊展現",
    "voice": null,
    "unit_id": 125811
  },
  {
    "type": "dialogue",
