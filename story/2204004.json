  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n她就會持續叫出魔物，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n這樣遲早會完蛋的吧。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不只是叫出魔物，",
    "voice": "vo_adv_2204004_029",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n而且還非常精密地操控魔物，",
