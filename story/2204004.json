  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──背面世界「吉歐‧提格尼亞」。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在通往帕菲之城的拉摩利爾街道附近──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "魔物的集團",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "由天空中的魔法陣召喚出來的",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n眾多蘭德索爾的魔物，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n踐踏著這個歌詠和平世界的花草。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "…………",
    "voice": "vo_adv_2204004_000",
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "向{0}等人宣戰的神祕女性「芙蕾雅」。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n她身在數不進的魔物大陣後方，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n藉由看不見的力量來指揮魔物。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "502040"
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "唔……！",
    "voice": "vo_adv_2204004_001",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "吉歐‧提格尼亞方的重要戰力萊拉耶爾公主，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n因體力消耗及受到強化後的魔物們攻擊而負傷並撤退。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n本以為戰況會就此一面倒──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "220400401"
  },
  {
    "type": "dialogue",
    "name": "沃爾加諾",
    "words": "──來吧來吧來吧！",
    "voice": "vo_adv_2204004_002",
    "unit_id": 193511
  },
  {
    "type": "dialogue",
    "name": "沃爾加諾",
    "words": "\\n給我睜大雙眼好好見識",
    "voice": null,
    "unit_id": 193511
  },
  {
    "type": "dialogue",
    "name": "沃爾加諾",
    "words": "\\n超可愛貓妖精的力量啦混帳！",
    "voice": null,
    "unit_id": 193511
  },
  {
    "type": "dialogue",
    "name": "巨人族青年",
    "words": "雖、",
    "voice": "vo_adv_2204004_003",
    "unit_id": 9411
  },
  {
    "type": "dialogue",
    "name": "巨人族青年",
    "words": "雖然很可怕……",
    "voice": null,
    "unit_id": 9411
  },
  {
    "type": "dialogue",
    "name": "巨人族青年",
    "words": "\\n雖然媽媽說不能夠打架",
    "voice": null,
    "unit_id": 9411
  },
  {
    "type": "dialogue",
    "name": "巨人族青年",
    "words": "……",
    "voice": null,
    "unit_id": 9411
  },
  {
    "type": "dialogue",
    "name": "巨人族青年",
    "words": "\\n",
    "voice": null,
    "unit_id": 9411
  },
  {
    "type": "dialogue",
    "name": "巨人族青年",
    "words": "但如果是為了保護大家，",
    "voice": null,
    "unit_id": 9411
  },
  {
    "type": "dialogue",
    "name": "巨人族青年",
    "words": "我……！",
    "voice": null,
    "unit_id": 9411
  },
  {
    "type": "dialogue",
    "name": "魔物的集團",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "女半身人",
    "words": "加油啊男人們！",
    "voice": "vo_adv_2204004_004",
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "女半身人",
    "words": "\\n要是受傷了",
    "voice": null,
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "女半身人",
    "words": "會馬上幫你們治療！",
    "voice": null,
    "unit_id": 9311
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "為了守護祖國與同胞，為了守護公主。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n吉歐‧提格尼亞的居民拿起了陌生的武器，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n挺身對抗魔物們",
    "voice": null,
    "unit_id": null
  },
