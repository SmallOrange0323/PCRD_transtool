    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "……秋乃真的",
    "voice": "vo_adv_7006001_003",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "很不服輸呢。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "才、",
    "voice": "vo_adv_7006001_004",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "才不想要被咲戀",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "這樣說呢！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n雖然上次投資商品的比賽輸給我，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n但妳到最後一刻都還是窮追不捨呢！！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "啊、",
    "voice": "vo_adv_7006001_005",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "那個呀、",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "進行到一半時明明就是我會贏，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "但秋乃卻",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
