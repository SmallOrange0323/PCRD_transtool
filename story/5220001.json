[
  {
    "type": "background",
    "bg_id": "501770"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "克蘿茜和",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "烏爾姆突然被霸瞳皇帝帶走，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n彼此之間",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "緊瀰漫著緊張的氣氛。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……看來這裡",
    "voice": "vo_adv_5220001_000",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "還沒受到影響。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "你是想問，",
    "voice": "vo_adv_5220001_001",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我為什麼沒事嗎？",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "嗯，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "當然有事啊。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "因為你們的關係，我的力量大幅減弱。",
    "voice": "vo_adv_5220001_002",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "所以別再讓我重複一些",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "只會白費功夫的",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "徒勞爭辯。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "…………",
    "voice": "vo_adv_5220001_003",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "不過，",
    "voice": "vo_adv_5220001_004",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "如果你們想浪費時間，我也不會阻止。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "只是在這麼做的期間，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "那個魔物……",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "聯合國的傢伙們催生出的",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n玩具，其威脅",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "應該會擴散至整個阿斯特朗吧。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "哼，",
    "voice": "vo_adv_5220001_005",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "你果然什麼都不知道啊。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n……",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "好吧，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "就由我來告訴你。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "那個魔物啊──",
    "voice": "vo_adv_5220001_006",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n是聯合國準備的",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "「刪除檔案的程式」。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "刪除、",
    "voice": "vo_adv_5220001_007",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "檔案……？",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "那個的攻擊",
    "voice": "vo_adv_5220001_008",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "會[rub:刪除]消除[/rub]這個世界的所有資源。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n不管是領域或",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "NPC，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "一切都是。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "別著急。",
    "voice": "vo_adv_5220001_009",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n這要先說到這個世界之外──",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n也就是「[rub:那邊]現實[/rub]」……",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "background",
    "bg_id": "510410"
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "米奈娃的禁錮，",
    "voice": "vo_adv_5220001_010",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "還有",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "幻境龍后的企圖……",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "為了對抗這一連串的事件，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n聯合國和國際刑警都在暗地裡四處奔走，這你知道吧。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "但他們被搶先一步，",
    "voice": "vo_adv_5220001_011",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "最終",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "淪落到連現實都受到威脅的局面。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "結果，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "聯合國有部分的傢伙就有了這種愚蠢的想法。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "「憑自己力量無法掌控的危險世界",
    "voice": "vo_adv_5220001_012",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n就該永遠消除」",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "──這樣。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "background",
    "bg_id": "501770"
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "幸運的是，",
    "voice": "vo_adv_5220001_013",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "大多數玩家已經登入，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "剩下的只有像你這樣",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "知曉部分原委的關係者。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "反正",
    "voice": "vo_adv_5220001_014",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "「現實」也已經亂成一團了，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n就是覺得趁機",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "全部抹消",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "更省事吧。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "完全就是",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "膽小的凡人們會想出來的計畫。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……等等。",
    "voice": "vo_adv_5220001_015",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "意思是，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "像我們這樣的存在──",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "怎麼可能在意呢。",
    "voice": "vo_adv_5220001_016",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "你們終究是NPC，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n只是資料而已。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "唔……！",
    "voice": "vo_adv_5220001_017",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "這個世界雖不穩定，",
    "voice": "vo_adv_5220001_018",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "卻凝聚了天才們的智慧。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "那些無名小卒想隨心所欲地伸手擺弄這裡，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "一般來說是不可能的。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "但是那些傢伙──",
    "voice": "vo_adv_5220001_019",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "很湊巧地",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "成功[rub:復原]提取[/rub]了",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n幻境龍后留下的程式。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "刪除檔案的程式",
    "words": "──咕哦哦哦哦哦！！",
    "voice": null,
    "unit_id": 10713
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "……！",
    "voice": "vo_adv_5220001_020",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "騎士先生，",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "快退下！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "background",
    "bg_id": "501770"
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "你對那個魔物擁有的魔力有印象嗎？",
    "voice": "vo_adv_5220001_021",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "不，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "應該有吧。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n畢竟給牠最後一擊的就是你們啊。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "那場戰鬥後……",
    "voice": "vo_adv_5220001_022",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "幻境龍后所孵化的龐大程式",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n改變形狀，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "落在了阿斯特朗的某處。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "而那些趁著阿斯特朗的混亂、",
    "voice": "vo_adv_5220001_023",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "成功進行非法存取的",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "聯合國",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n的傢伙們，偶然發現了它。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "他們利用那些殘渣催生出的，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "就是那個魔物。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "雖是殘渣，",
    "voice": "vo_adv_5220001_024",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "但原本的容量天差地遠。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n要讓牠擁有消除世界的權能，也是輕而易舉。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "只要不斷絕根源，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "魔物恐怕會不斷被催生出來。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "唔……！",
    "voice": "vo_adv_5220001_025",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "那",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "究竟該怎麼做……！",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "background",
    "bg_id": "501770"
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "只能找出來了。",
    "voice": "vo_adv_5220001_026",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "從寬廣的阿斯特朗中，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n找出幻境龍后留下的程式殘骸。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "那簡直",
    "voice": "vo_adv_5220001_027",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "就像是大海撈針般，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "想找到一般來說是不可能的。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "很遺憾，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "那似乎在我的「眼睛」都找不到的場所。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……所以，",
    "voice": "vo_adv_5220001_028",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n用那個機械人偶吧。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "background",
    "bg_id": "501770"
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "唔……",
    "voice": "vo_adv_5220001_029",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "咦？",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n我、",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "我嗎？",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "嗯，",
    "voice": "vo_adv_5220001_030",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "沒錯。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n長老製的初期型AI──",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "妳的系統",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "就由我來幫忙更新。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "妳的核心就是",
    "voice": "vo_adv_5220001_031",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "超AI米奈娃的雛形。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "只要安裝追加更新，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "應該至少還能探測到",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n幻境龍后留下的程式。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……本來",
    "voice": "vo_adv_5220001_032",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "要叫到這邊的人",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "只有妳而已。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "若是那邊的兩人沒跟來，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我就會像之前那樣馬上駭進去，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n把妳變成一個沉默的裝置。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "你們會怎麼樣，",
    "voice": "vo_adv_5220001_033",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我沒什麼興趣。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "但是，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "那些無知愚昧的傢伙居然毫不客氣地闖進來，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n還想對本該屬於我的世界肆意妄為，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "讓我很不快。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "醜話先說在前頭，",
    "voice": "vo_adv_5220001_034",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "這不是提議，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "也不是懇求。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n這是單純的事實，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "也是「命令」。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n你們無權拒絕。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……是說，",
    "voice": "vo_adv_5220001_035",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "妳直到不久前還是我們的敵人，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n無法保證妳不會對克蘿小姐動什麼手腳。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我說過了，",
    "voice": "vo_adv_5220001_036",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n跟你們的意志無關。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "如果你們要抵抗，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我甚至可以用武力強行讓你們屈服。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "不管怎麼樣，",
    "voice": "vo_adv_5220001_037",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我都準備哪天就除掉你們這些障礙。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "這樣",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "就只是稍微提前了一點──",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "等一下！",
    "voice": "vo_adv_5220001_038",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "呃……",
    "voice": "vo_adv_5220001_039",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "困難的事情",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "我不太清楚。",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "總之只要讓妳進行維護，",
    "voice": "vo_adv_5220001_040",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n我就能夠幫助大家對吧？",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……嗯，",
    "voice": "vo_adv_5220001_041",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "沒錯。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n不過前提是……",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "妳能傻到毫無防備地",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "把自己交給我就是。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "…………",
    "voice": "vo_adv_5220001_042",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "…",
    "voice": "vo_adv_5220001_043",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "…我知道了。",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n那我",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "願意做！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "呃，",
    "voice": "vo_adv_5220001_044",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "克蘿小姐！？",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "沒問題的！",
    "voice": "vo_adv_5220001_045",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "雖然",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "霸瞳皇帝的確對我做過過分的事情……",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "……但是！",
    "voice": "vo_adv_5220001_046",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n想保護大家居住的這個世界，",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n我覺得自己跟霸瞳皇帝一樣都有這樣的心情！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "…………",
    "voice": "vo_adv_5220001_047",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "咦？",
    "voice": "vo_adv_5220001_048",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n不對嗎？",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……真服了妳。",
    "voice": "vo_adv_5220001_049",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n能請妳別擅自用那種好像很了解我的口吻講話嗎？",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "有什麼樣的創造主，",
    "voice": "vo_adv_5220001_050",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "就有什麼樣的產物。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "其實，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我是很想再多加",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n至少一個多餘的程式進去啦……",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "──！",
    "voice": "vo_adv_5220001_051",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n……剛剛那是……",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我更新了系統。",
    "voice": "vo_adv_5220001_052",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n現在的妳，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "應該能夠追蹤元凶的氣息。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "妳打算去哪？",
    "voice": "vo_adv_5220001_053",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "很遺憾，",
    "voice": "vo_adv_5220001_054",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我沒你們那麼閒。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "現在的你們，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "根本也沒有需要我監視的必要吧。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "你們就儘管四處奔波吧，",
    "voice": "vo_adv_5220001_055",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "就像嗅聞金塊的小狗一樣。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "克蘿小姐，",
    "voice": "vo_adv_5220001_056",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "妳的身體",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "真的沒問題嗎？",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n是不是被裝了什麼奇怪的機能……",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "是，",
    "voice": "vo_adv_5220001_057",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "沒問題！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "我反而還覺得狀況超好呢！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "雖然距離相當遠，",
    "voice": "vo_adv_5220001_058",
    "unit_id": 126412
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "但感應器馬上就有反應了！",
    "voice": null,
    "unit_id": 126412
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 126412
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "這是──",
    "voice": null,
    "unit_id": 126412
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "是在、",
    "voice": null,
    "unit_id": 126412
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "蘭德索爾附近嗎……？",
    "voice": null,
    "unit_id": 126412
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n居然可以感應到不同的世界……",
    "voice": null,
    "unit_id": 126412
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……看來",
    "voice": "vo_adv_5220001_059",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "她好歹有遵守說過的話，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "雖然真的超級可疑的。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "烏爾姆果然還是",
    "voice": "vo_adv_5220001_060",
    "unit_id": 126412
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n無法信任霸瞳皇帝嗎？",
    "voice": null,
    "unit_id": 126412
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "那當然，",
    "voice": "vo_adv_5220001_061",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "畢竟最近才剛跟她戰鬥過，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n親眼見識過她有多危險了。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "我",
    "voice": "vo_adv_5220001_062",
    "unit_id": 126412
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "之前是也忍不住發火了……",
    "voice": null,
    "unit_id": 126412
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 126412
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "但我覺得那個人",
    "voice": null,
    "unit_id": 126412
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "一定沒那麼壞！",
    "voice": null,
    "unit_id": 126412
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "只是、",
    "voice": "vo_adv_5220001_063",
    "unit_id": 126412
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "那個……",
    "voice": null,
    "unit_id": 126412
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "對了！",
    "voice": null,
    "unit_id": 126412
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n只是最喜歡世界的心情多到滿出來而已！",
    "voice": null,
    "unit_id": 126412
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "是",
    "voice": "vo_adv_5220001_064",
    "unit_id": 126412
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "的！",
    "voice": null,
    "unit_id": 126412
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 126412
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "雖然我不太清楚……",
    "voice": null,
    "unit_id": 126412
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n看到那個人的雙眼，",
    "voice": null,
    "unit_id": 126412
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "我就覺得會不會是這樣！",
    "voice": null,
    "unit_id": 126412
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "不，",
    "voice": "vo_adv_5220001_065",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "你幹嘛認同啊？",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n就是因為這樣，我才受不了濫好人……",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "那樣聽起來確實比較自然呢。",
    "voice": "vo_adv_5220001_066",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "第一，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "雖然由我來說也怪怪的……",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n喜歡世界還做那種事，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "性格也太有問題了。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "刪除檔案的程式",
    "words": "──咕喔喔喔喔喔！！",
    "voice": null,
    "unit_id": 10713
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "唔……！",
    "voice": "vo_adv_5220001_067",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "看來這裡已經不安全了。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "是，",
    "voice": "vo_adv_5220001_068",
    "unit_id": 126412
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "趕快行動吧！",
    "voice": null,
    "unit_id": 126412
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n噴射靴，",
    "voice": null,
    "unit_id": 126412
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "啟動──",
    "voice": null,
    "unit_id": 126412
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "那個！",
    "voice": "vo_adv_5220001_069",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "不好意思。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n在尋找那個程式方面……",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n我可以",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "跟大家分開行動嗎？",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "烏爾姆？",
    "voice": "vo_adv_5220001_070",
    "unit_id": 126412
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我知道眼下是這個世界的危機，",
    "voice": "vo_adv_5220001_071",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n也想幫忙。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "可是……",
    "voice": "vo_adv_5220001_072",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我還是\\n擔心……",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "大家、",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "跟姊姊。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "沒事的。",
    "voice": "vo_adv_5220001_073",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n我如果不安全，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "老姊會哇哇大哭的。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "既然如此……",
    "voice": "vo_adv_5220001_074",
    "unit_id": 126412
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n程式我們會想辦法，",
    "voice": null,
    "unit_id": 126412
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 126412
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "烏爾姆去琳德她們那邊吧！",
    "voice": null,
    "unit_id": 126412
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……好。",
    "voice": "vo_adv_5220001_075",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n兩位，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "謝謝你們。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "好的！",
    "voice": "vo_adv_5220001_076",
    "unit_id": 126412
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "我們走吧，",
    "voice": null,
    "unit_id": 126412
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "騎士先生！",
    "voice": null,
    "unit_id": 126412
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 126412
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "為了保護──",
    "voice": null,
    "unit_id": 126412
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "大家，",
    "voice": null,
    "unit_id": 126412
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "保護這個世界！",
    "voice": null,
    "unit_id": 126412
  }
]
