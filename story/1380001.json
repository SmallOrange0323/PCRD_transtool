  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "而且──",
    "voice": null,
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "畢竟我們的公主是一本正經，",
    "voice": "vo_adv_1380001_050",
    "unit_id": 133012
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
