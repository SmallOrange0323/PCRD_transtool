    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "騎、",
    "voice": "vo_adv_1380001_031",
    "unit_id": 133115
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "騎士先生的臉，",
    "voice": null,
    "unit_id": 133115
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "靠得這麼近！",
    "voice": null,
    "unit_id": 133115
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133115
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "不，",
    "voice": null,
    "unit_id": 133115
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "不是這個！",
    "voice": null,
    "unit_id": 133115
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "得趕快",
    "voice": null,
    "unit_id": 133115
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
