  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ロゼッタの容態？",
    "voice": "vo_adv_6038310_000",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "　ああそうか、",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ユニコプターもろとも炎上したから",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\nその後の安否が気になっていたのか。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "安心しろ、",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "やつは石だ",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "燃えん。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "試しにほれ、",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "挨拶がてら、",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "なにか適当にオーダーしてみればいいさ。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ロゼッタ",
    "words": "ぽーん！",
    "voice": "vo_adv_6038310_001",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ロゼッタ",
    "words": "　♪ぽぽんがぽん",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ロゼッタ",
    "words": "（あそれ）",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ロゼッタ",
    "words": "　♪ぽぽんがぽん",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ロゼッタ",
    "words": "（よいしょ）",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ロゼッタ",
    "words": "\\n顔が恐いぞクロエ君",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ロゼッタ",
    "words": "　頭ちぇるったチエル君",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ロゼッタ",
    "words": "　才色兼備のユニちゃん先輩",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ロゼッタ",
    "words": "\\n三人揃えばユニちゃんズ",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ロゼッタ",
    "words": "　ユニちゃん音頭でドソル晴れ",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ロゼッタ",
    "words": "（うぇーい）",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ロゼッタ",
    "words": "ぽーん！",
    "voice": "vo_adv_6038310_002",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ロゼッタ",
    "words": "　当該情報",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ロゼッタ",
    "words": "「管理者の３サイズ」は",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ロゼッタ",
    "words": "厳重にロックされています",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ロゼッタ",
    "words": "\\n関連情報として",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ロゼッタ",
    "words": "ミス・クロエの数値を取得！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ロゼッタ",
    "words": "\\n上から順に、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ロゼッタ",
    "words": "はちじゅ――",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ＯＫロゼッタやめるんだ。",
    "voice": "vo_adv_6038310_003",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "殺される。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "君が無事でも",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ぼくと彼は殺される。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ロゼッタ",
    "words": "きゅーん！",
    "voice": "vo_adv_6038310_004",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ロゼッタ",
    "words": "　只今のコマンドに対して",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ロゼッタ",
    "words": "乙女の脆弱性が発見されました！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ロゼッタ",
    "words": "\\nもう友達ではいられません！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ロゼッタ",
    "words": "　この石の高鳴り、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ロゼッタ",
    "words": "もしかして",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ロゼッタ",
    "words": "これが恋？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ロゼッタ、",
    "voice": "vo_adv_6038310_005",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "君メスだったのか……",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "そもそも雌雄の別があったのか……",
    "voice": null,
    "unit_id": 111011
  }
]
