[
  {
    "type": "background",
    "bg_id": "500130"
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "任務を終えた帰り道。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "\\nノウェムはため息交じりに呟きを漏らす。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "ほんっと",
    "voice": "vo_adv_5110604_000",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "人使い荒いよなぁ",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "アイツら。",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "どしたの急に。",
    "voice": "vo_adv_5110604_001",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "\\nストレス溜まった顔しちゃって。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "七冠の連中だよ。",
    "voice": "vo_adv_5110604_002",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\nちょっとアタシたちをこき使いすぎだと思わないか？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "それは仕方ないでしょ。",
    "voice": "vo_adv_5110604_003",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "ボクらはそういう役回りなんだからさー",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "それがアタシたちの仕事だってのは分かってるけどさ、",
    "voice": "vo_adv_5110604_004",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\nそれでもこう、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "時々無性に暴れたくなるんだよ～！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "仕方ないなぁ。",
    "voice": "vo_adv_5110604_005",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "愚痴くらいなら聞いてあげるよ。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "\\n具体的に誰が気に入らないわけ？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "そうだな～",
    "voice": "vo_adv_5110604_006",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\n特にひどいのは……",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "ク",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "リスティーナだ！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "ほうほう。",
    "voice": "vo_adv_5110604_007",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "\\nそれはまたどうして。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "すぐに怒鳴るしさー、",
    "voice": "vo_adv_5110604_008",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "人を囮に使うしさー、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "この間なんて、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\n退屈だから",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "その辺のモンスター全部倒してこい！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "とか言い出すしさー",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "なるほどねー",
    "voice": "vo_adv_5110604_009",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "……うん、",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "オクトー",
    "words": "それでそれで？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "口を開けば",
    "voice": "vo_adv_5110604_010",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "「さっさと動け！」",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "とか、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\nちょっと失敗すると",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "「お仕置きが必要なようだな？」",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "とか、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "見た目まんま、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "やたらと圧が強いんだよなー",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "ふむふむ。",
    "voice": "vo_adv_5110604_011",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\nもっと言っていいぞ。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "おう、",
    "voice": "vo_adv_5110604_012",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "いくらでも出てくるぞ！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\nっていうかどうしたんだよオクトー",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\nなんだか今日は",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "いつもより聞き上手だな？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "……だろう？",
    "voice": "vo_adv_5110604_013",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "……な？",
    "voice": "vo_adv_5110604_014",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "ヤツならもういないぞ。",
    "voice": "vo_adv_5110604_015",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "面白い講座の特等席を快くワタシに譲ってくれたよ。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "……さぁ、",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "続きを話すがいい。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "いくらでも出てくるんだろう？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "クッ、",
    "voice": "vo_adv_5110604_016",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "クリスティーナ！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\n待ってくれ、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "これは誤解なんだ！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "っていうか",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "どこから聞いてたんだ！？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "「ほんっと人使い荒いよなぁ",
    "voice": "vo_adv_5110604_017",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "アイツら」",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "初めっからだな！",
    "voice": "vo_adv_5110604_018",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "どうした、",
    "voice": "vo_adv_5110604_019",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "なにを挙動不審になっている。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "「特にひどい」",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "クリスティーナさんが聞き上手に徹してやっているんだ。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "遠慮なく話すがいいよ。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "……話せ。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "圧っ！　",
    "voice": "vo_adv_5110604_020",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "この圧なんだよ～！　",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "ふっふっふっふっふ。",
    "voice": "vo_adv_5110604_021",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\nいや、",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "退屈しのぎの散歩も悪くないものだ。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "誓約女君",
    "words": "こんな愉しい瞬間に出くわせるのだからな！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "オ",
    "voice": "vo_adv_5110604_022",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "クトー！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\n覚えてろよおおおおおおおおおおお！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "ノウェムがクリスティーナに解放されるのは、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "\\nそれから数時間後のことであった。",
    "voice": null,
    "unit_id": null
  }
]
