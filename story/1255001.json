    "name": "山賊頭目",
    "words": "快想想辦法！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "\\n你以為我付了多少錢給你們！？",
