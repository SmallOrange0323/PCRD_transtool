    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "啊！？",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "\\n我已經有說不會讓妳變身了吧！！",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "呀啊！",
    "voice": "vo_adv_1255001_054",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n謝、",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "謝謝你……",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我的額頭差點就被刀刺中了……",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "但",
    "voice": "vo_adv_1255001_055",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "這樣我無法專注精神，",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n也沒辦法轉換職業，",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "使用魔法的力量……",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n該怎麼做才……！？",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "咦？",
    "voice": "vo_adv_1255001_056",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "等等！？",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n你一個人跑到前面去很危險啊！！",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "明明沒什麼了不起的本領，少來礙事！",
