    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "喂喂喂，",
    "voice": "vo_adv_1255001_061",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "我要不斷丟刀子過去囉！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "\\n要是不確實",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "用劍彈開，你就要到那個世界去囉，小子！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "background",
    "bg_id": "500142"
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "你是因為相信我才站出來的。",
    "voice": "vo_adv_1255001_062",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "你相信",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "只要拖延時間，",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我就絕對能改變狀況……",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "既然這樣，我……",
    "voice": "vo_adv_1255001_063",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "就要回應那份心意啊！",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "你、",
    "voice": "vo_adv_1255001_064",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "你們是在磨蹭什麼啊！？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "\\n那個女的身體開始發光了，",
