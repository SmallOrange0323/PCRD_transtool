    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "原來如此，",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "如果是王宮騎士，",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "可能也能幫到別人！",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "王、",
    "voice": "vo_adv_1255001_091",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "王宮騎士！？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "\\n怎麼可能當上啊，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "這跟我們至今的人生根本完全相反嘛！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "不試著做做看是不會知道的！",
    "voice": "vo_adv_1255001_092",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n你們至今都在做壞事，",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "那就作為補償把助人當成職業吧！",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "試著以轉換職業成",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "王宮騎士為目標！！",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "…………",
    "voice": "vo_adv_1255001_093",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "唉。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "你們直到最後都是濫好人啊。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "\\n我再怎麼樣不從，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "聽著都失去作惡的念頭了。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "咦？",
    "voice": "vo_adv_1255001_094",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "難道",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "真的要去應徵嗎！？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "\\n像我們這種人，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "在書面徵選時就會被刷掉了喔！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "就算被刷掉，",
    "voice": "vo_adv_1255001_095",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "我們也沒損失吧。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "\\n即使",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "要考慮什麼其他的路，",
