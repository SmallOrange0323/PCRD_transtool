[
  {
    "type": "background",
    "bg_id": "500391"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}閒來無事在街上散步。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在他偶然看向公布欄前方時，看到了一邊注視著手邊的信，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n一邊貌似煩惱的吉塔。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "嗯──",
    "voice": "vo_adv_1255001_000",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "怎麼辦？",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "這個……",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "無視也沒關係吧……？",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "但",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "果然還是好好回應比較……",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "咦！？",
    "voice": "vo_adv_1255001_001",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "呃……",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "對了，",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我在找新的打工！",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n因為為了讓騎空團壯大，",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "也是需要錢的呢。",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "所以那個～",
    "voice": "vo_adv_1255001_002",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "你看，",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "這個！",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我在想要不要去參加",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "這個【王宮騎士團】的新團員招募之類的！",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n你也來怎麼樣？",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我、",
    "voice": "vo_adv_1255001_003",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我的眼神很閃爍？",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "沒有啦……",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n而且我直到剛剛都在讀信，",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n根本完全沒在看公布欄？",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "唔唔，",
    "voice": "vo_adv_1255001_004",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "眼睛好尖，",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "真是驚人的動態視力……",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我明明認為自己立刻就把信藏起來了……",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n其實……",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "那個……",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我收到決鬥書了……",
    "voice": "vo_adv_1255001_005",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "而且",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "還是感覺滿懷恨意的決鬥書！",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "內容？",
    "voice": "vo_adv_1255001_006",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我知道了，",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我唸出來喔……",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "咳咳。",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "可恨的",
    "voice": "vo_adv_1255001_007",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "吉塔小姐尊鑒，",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "妳過得怎麼樣呢？",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n自從被妳妨礙生意後，我就過得很淒慘。",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "不但錢包掉了、",
    "voice": "vo_adv_1255001_008",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "小指撞到櫃子、",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n得了感冒、",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "還被我養的狗咬了手。",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n我只覺得這一切都是妳的錯。",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "因此，",
    "voice": "vo_adv_1255001_009",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "雖然很麻煩妳，但能請妳前來小巷子，",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n接受與我一對一（重要）決鬥嗎？",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n由於我真的非常火大，",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我會一直等到妳來為止。",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "敬上。",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "對方這樣寫……",
    "voice": "vo_adv_1255001_010",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n雖然沒有寄件人姓名，",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "但真的非常生氣吧！？",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "……這樣啊，",
    "voice": "vo_adv_1255001_011",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "確實會讓人覺得或許是陷阱對吧。",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "但我覺得，",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "這位寄件人是我至今教訓過的某個人。",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "如果是這樣，",
    "voice": "vo_adv_1255001_012",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "要是放著不管，對方說不定又會做壞事。",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "必須告訴他要好好反省才行！",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "咦？",
    "voice": "vo_adv_1255001_013",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "你也要跟來嗎？",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "……你在擔心我啊，",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "謝謝你。",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n這樣的話雖是一對一決鬥，",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "但還是請你單純陪同出席吧。",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "background",
    "bg_id": "500890"
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "對方指定的地點是這裡吧。",
    "voice": "vo_adv_1255001_014",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "對手是……",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "妳來了啊……",
    "voice": "vo_adv_1255001_015",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "\\n之前那時",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "還真是受到妳很多照顧啊？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "你……！",
    "voice": "vo_adv_1255001_016",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "呵呵呵，",
    "voice": "vo_adv_1255001_017",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "妳似乎想起來了啊。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "\\n沒錯，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "我就是之前……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "……是",
    "voice": "vo_adv_1255001_018",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "哪位啊？",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "呃，",
    "voice": "vo_adv_1255001_019",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "妳根本不記得！？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "\\n我是被妳用奇怪力量痛揍一頓的",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "山賊頭目啊！！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "說是奇怪力量還真失禮呢……",
    "voice": "vo_adv_1255001_020",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "啊，",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我想起來了！",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n我記得是在街道上襲擊路過商隊的那群人！",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n你還是沒在反省嗎！？",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "怎麼可能反省啊，",
    "voice": "vo_adv_1255001_021",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "都被妨礙生意了！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "\\n我這次一定要宰了妳，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "出來吧，大夥！！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "坦白說，",
    "voice": "vo_adv_1255001_022",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "我很懂這根本就只是在遷怒啦……",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "但我們也是收了錢的呢。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "我才不管什麼騎空團，",
    "voice": "vo_adv_1255001_023",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "反正就是默默無名的弱小公會吧？",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "\\n",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "只要多人圍毆就能輕鬆獲勝了！！",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "啊！",
    "voice": "vo_adv_1255001_024",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "你好詐！",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n你明明",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "在決鬥書上寫是一對一決鬥的！",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "你是準備了多少人啊！",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "吵死了，",
    "voice": "vo_adv_1255001_025",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "勝者為王啦！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "\\n這次跟我上次的手下們可不一樣，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "\\n都是我重金吸引來的高手……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "別以為妳能靠同樣的手段獲勝！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒們",
    "words": "呀哈──！！",
    "voice": "vo_adv_1255001_026",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我生氣了！",
    "voice": "vo_adv_1255001_027",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "做這種卑鄙的事！",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n為了讓你反省，我這次一定",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "要再用體術……",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "哎呀，",
    "voice": "vo_adv_1255001_028",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "馬上就要使出那個轉換職業嗎？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "才不會讓妳得逞！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "呀啊！？",
    "voice": "vo_adv_1255001_029",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n飛、",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "飛刀！？",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "雖然不知道妳魔術的關竅，",
    "voice": "vo_adv_1255001_030",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "但重點在於不讓妳變身就好了。",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "\\n",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "而且就算萬一妳變身了……",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "既然妳是用拳頭的對手，",
    "voice": "vo_adv_1255001_031",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "那用投擲武器就行了！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "我們在妳攻擊不到的地方，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "所以會單方面痛宰妳的！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "有應對轉換職業的對策……！？",
    "voice": "vo_adv_1255001_032",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "不過，",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "那樣的話，我只要用劍來應戰就行了吧！",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我要一口氣拉近距離了喔！",
    "voice": "vo_adv_1255001_033",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n劈斬吧，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "妙想奇劍！！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "background",
    "bg_id": "500890"
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "……妳有做什麼嗎？",
    "voice": "vo_adv_1255001_034",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "什……！？",
    "voice": "vo_adv_1255001_035",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n我明明盡全力擊中了，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "但完全沒有效！！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "因為",
    "voice": "vo_adv_1255001_036",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "上次戰鬥時我被妳用劍跟拳頭修理得慘不忍睹啊，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "所以我把用特殊製法製作出來的",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "強大鎧甲交給這些傢伙了。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "\\n這可是被評價為不論怎麼樣的斬擊和打擊都能完全防禦的珍品。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "也就是說，",
    "voice": "vo_adv_1255001_037",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "憑妳那把鈍刀是傷不了我們分毫的啦！",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "\\n",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "喝啊！！",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "background",
    "bg_id": "500890"
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "呀啊！",
    "voice": "vo_adv_1255001_038",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我的劍……！？",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "怎麼辦？",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "沒有武器的話，我就束手無策……",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "勝負已定了啊！",
    "voice": "vo_adv_1255001_039",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "就這樣收拾她！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "別怪我們啊，",
    "voice": "vo_adv_1255001_040",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "小姑娘！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "\\n以後決鬥時",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "可要慎選對象啊！！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "……！？",
    "voice": "vo_adv_1255001_041",
    "unit_id": 105712
  },
  {
    "type": "background",
    "bg_id": "500890"
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "唔……",
    "voice": "vo_adv_1255001_042",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "你這傢伙",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "少來礙事！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "\\n想讓我先一刀劈了你嗎！？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "謝謝你，",
    "voice": "vo_adv_1255001_043",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "得救了～！",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "但這個狀況",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "該怎麼辦啊……！",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "咦？",
    "voice": "vo_adv_1255001_044",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "你為什麼突然抓住我的手？",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "先逃再說……",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "等、",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "等等！？",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "你們在幹什麼！",
    "voice": "vo_adv_1255001_045",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "\\n趕快追上去收拾他們！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "background",
    "bg_id": "500142"
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "呼……",
    "voice": "vo_adv_1255001_046",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "呼……！",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n那些人",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "還在追我們！！",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n怎麼辦？",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "再這樣下去……",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "嗯……",
    "voice": "vo_adv_1255001_047",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我們能不能逃進這邊的瞭望塔裡？",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "……唔唔，",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "鎖起來了。",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n其他看起來能躲的地方……",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "總算是追上了，",
    "voice": "vo_adv_1255001_048",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "你們已經放棄了吧。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "不過，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "你們又逃進了一個相當有趣的地方呢？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "雖然那座塔現在被用作瞭望塔，",
    "voice": "vo_adv_1255001_049",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "\\n但過去似乎住著魔女，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "傳聞她時常施展可疑的詛咒。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "以送這個囂張的女人上路而言，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "豈不是最棒的地方嗎？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我才不是魔女……",
    "voice": "vo_adv_1255001_050",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "啊！",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n對了，",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "現在可能就是我用上新力量的時機！",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "雖然我並不能完美地運用自如，",
    "voice": "vo_adv_1255001_051",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "但似乎也只有這個扭轉局勢的方法了……！",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "用力",
    "voice": "vo_adv_1255001_052",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "想像魔法的力量……！",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "專注、",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "專注……！",
