    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "這只能防禦物理攻擊，",
    "voice": "vo_adv_1255001_074",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "\\n我也沒料到她能用魔法啊！",
