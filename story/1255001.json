    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "\\n",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "那麼想死的話，",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "就先以你為目標吧！",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "background",
    "bg_id": "500142"
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "算我拜託你，快退後！",
    "voice": "vo_adv_1255001_058",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n你真的會死的喔！",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "……！",
    "voice": "vo_adv_1255001_059",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "多麼感人的台詞啊！",
