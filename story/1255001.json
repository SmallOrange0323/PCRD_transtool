    "type": "dialogue",
    "name": "暴徒２",
    "words": "\\n好燙燙燙，",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "這不是你自豪的鎧甲嗎！？",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "\\n完全不防火嘛！",
