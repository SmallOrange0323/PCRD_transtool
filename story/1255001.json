    "type": "dialogue",
    "name": "山賊頭目",
    "words": "不行不行，",
    "voice": "vo_adv_1255001_087",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "那樣絕對會死！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "不過，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "就算事到如今改過自新，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "該做什麼工作才好……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "唔～",
    "voice": "vo_adv_1255001_088",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "說的也是啊……",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "你有沒有什麼好點子……",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "嗯？",
    "voice": "vo_adv_1255001_089",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "那張傳單",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "怎麼了嗎？",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n……你說在那邊撿到，",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "剛好適合這些人？",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "是公布欄也有貼的",
    "voice": "vo_adv_1255001_090",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "【王宮騎士團】新團員招募傳單嗎……",
