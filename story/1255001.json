  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "山賊頭目",
    "words": "雖然你得要忽略自己的實力不足，",
