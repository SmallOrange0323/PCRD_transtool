[
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "找到了！",
    "voice": "vo_adv_5142302_000",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "就是那隻魔物！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "居然不學乖",
    "voice": "vo_adv_5142302_001",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "又開始作亂，真是令人難以置信。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "到底是對自己的力量有多過度自信呀……",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "就是啊……",
    "voice": "vo_adv_5142302_002",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "不過，",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "牠看起來比上次還要難纏喔？",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "在作亂的途中逐漸變強了呢……！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "哼。",
    "voice": "vo_adv_5142302_003",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "這沒什麼大不了的。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n畢竟是個只會用蠻力",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "的愚蠢敵人，",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n根本不是我的對手。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "「只會用蠻力」……？",
    "voice": "vo_adv_5142302_004",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n跟某人有點像呢……",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "妳有說什麼嗎？",
    "voice": "vo_adv_5142302_005",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "啊、",
    "voice": "vo_adv_5142302_006",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "啊哈哈……",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "沒有啊～？",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "比起這個，",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "走吧！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我們趕快打倒那傢伙吧！",
    "voice": null,
    "unit_id": 129811
  }
]
