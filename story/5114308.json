[
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "唔，",
    "voice": "vo_adv_5114308_000",
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "又來了！",
    "voice": null,
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "怎麼又來了！",
    "voice": null,
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n一鬆懈下來，",
    "voice": null,
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "就好像要被魄力給壓制了……！",
    "voice": null,
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "生意人即使如此也會不放棄喵──！",
    "voice": "vo_adv_5114308_001",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "莫妮卡，",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "讓對方見識一下生意人的骨氣喵！",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我是軍人！",
    "voice": "vo_adv_5114308_002",
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "但……",
    "voice": null,
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "也是個生意人！",
    "voice": null,
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "為了能",
    "voice": null,
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "提供客人美味的咖啡與幸福……",
    "voice": null,
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "就要以全力以赴的態度面對對手喵！",
    "voice": "vo_adv_5114308_003",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "好，",
    "voice": "vo_adv_5114308_004",
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "放馬過來！",
    "voice": null,
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n這是咖啡廳",
    "voice": null,
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "「Naschkatze」的",
    "voice": null,
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "總體戰！",
    "voice": null,
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "了解喵！",
    "voice": "vo_adv_5114308_005",
    "unit_id": 125111
  }
]
