  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "呀呵！",
    "voice": "vo_adv_5019101_000",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "　天氣超讚！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "不覺得真的有「到海邊啦」",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "的感覺嗎？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "明天的活動我會好好的表現，",
    "voice": "vo_adv_5019101_001",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n暑假就該像這樣",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "好好地拿來渡假啊！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "真是壯觀的舞台呢！",
    "voice": "vo_adv_5019101_002",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n雖然",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "不是我要上台，",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "卻覺得緊張起來了～……",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我們可不能輸給其他的粉絲，",
    "voice": "vo_adv_5019101_003",
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n要一起好好聲援鈴奈哦。",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "鈴奈，",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "加油！",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "各位！",
    "voice": "vo_adv_5019101_004",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "　請幫我加油！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家會",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "比平常更High的！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "所以，",
    "voice": "vo_adv_5019101_005",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我想和大家一起渡過，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "創造出很多",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "讚到爆的回憶呢。",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈等人",
    "words": "下回，",
    "voice": "vo_adv_5019101_006",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鈴奈等人",
    "words": "「鈴奈的彩虹舞臺！」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500681"
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "真是的，",
    "voice": "vo_adv_5019101_007",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我沒聽說會下雨啊！",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "剛才明明還是",
    "voice": "vo_adv_5019101_008",
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "大晴天，怎麼會～",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "不會吧吧吧吧！",
    "voice": "vo_adv_5019101_009",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n看起來不會停的樣子！",
    "voice": null,
    "unit_id": 110011
  },
