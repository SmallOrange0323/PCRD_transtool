  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "小棉花糖牠啊，",
    "voice": "vo_adv_6076104_000",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n在吃開口笑時，總是吃得津津有味～♪",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "不過，",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我希望牠可以吃得更開心，",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "是不是要稍微做點變化呢～？",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "原來如此～",
    "voice": "vo_adv_6076104_001",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "狗狗",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "最喜歡骨頭了～！",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "真有你的！",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "這是個好主意～♪",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我馬上來",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "試做看看！",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n當骨骨開口笑完成後，",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "再請你來試吃看看～♪",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "開口笑的甜味加上",
    "voice": "vo_adv_6076104_002",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "肉乾的鹹味，",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n究竟會變成什麼樣的味道，真難以想像～！",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "不過，",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "感覺是個有趣的點子～",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "如果你還有想到其他的點子，",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "儘管跟我說喔～♪",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "這倒也是！",
    "voice": "vo_adv_6076104_003",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "因為",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "目前所做的開口笑，",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n小棉花糖就很喜歡吃了～♪",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "那我就",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "一如既往地",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "用心來做開口笑吧～♪",
    "voice": null,
    "unit_id": 117711
  }
]
