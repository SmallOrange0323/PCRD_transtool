  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──某日午後，於【龍族巢穴】的據點。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……啊，",
    "voice": "vo_adv_5090601_000",
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "步未未，",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "妳真的來啦！",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "嗯，",
    "voice": "vo_adv_5090601_001",
    "unit_id": 121512
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "那當然，",
    "voice": null,
    "unit_id": 121512
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "因為是祈梨約我的啊。",
    "voice": null,
    "unit_id": 121512
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 121512
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "……不過，",
    "voice": null,
    "unit_id": 121512
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "為什麼",
    "voice": null,
    "unit_id": 121512
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "會叫我穿",
    "voice": null,
    "unit_id": 121512
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "怪盜服過來呢？",
    "voice": null,
    "unit_id": 121512
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n祈梨也是穿怪盜服……",
    "voice": null,
    "unit_id": 121512
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "其實啊……",
    "voice": "vo_adv_5090601_002",
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n我想委託步未未",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "執行超級極惡任務哦！",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "咦！？",
    "voice": "vo_adv_5090601_003",
    "unit_id": 121512
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "超級極惡任務……！？",
    "voice": null,
    "unit_id": 121512
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 121512
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "那到底是",
    "voice": null,
    "unit_id": 121512
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "怎樣的……！？",
    "voice": null,
    "unit_id": 121512
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "聽了可別嚇到哦。",
    "voice": "vo_adv_5090601_004",
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那個超級極惡任務──",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "就是跟我一起",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "偷偷潛入老大的",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "祕密房間！",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "帆稀小姐的房間……！？",
    "voice": "vo_adv_5090601_005",
    "unit_id": 121512
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "對！",
    "voice": "vo_adv_5090601_006",
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "話雖如此，",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "也不是要去偷老大的東西。",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我只是想一起潛入房間，",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "跟步未未拍張照片而已。",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n換句話說，",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "就是一種試膽大會！",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "被發現我們那麼做，",
    "voice": "vo_adv_5090601_007",
    "unit_id": 121512
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n帆稀小姐會很生氣吧……？",
    "voice": null,
    "unit_id": 121512
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "話、",
    "voice": "vo_adv_5090601_008",
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "話是沒錯……",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這是我一生一次的請求！",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n希望妳能跟我潛入老大的祕密房間！",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我們",
    "voice": "vo_adv_5090601_009",
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "當怪盜都辦成那麼厲害的事了，",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n這不是會讓人想以某種形式留下來嗎？",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "所以，",
    "voice": "vo_adv_5090601_010",
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我想在最後穿著這件衣服，",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n將進行怪盜活動的瞬間拍成照片保存……",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我想把回憶",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "化為實體留存下來啊！",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "嗯……",
    "voice": "vo_adv_5090601_011",
    "unit_id": 121512
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……步未未，",
    "voice": "vo_adv_5090601_012",
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "妳還是不願意嗎？",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "只要帆稀小姐沒發現的話……",
    "voice": "vo_adv_5090601_013",
    "unit_id": 121512
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n反正只是拍張照片……",
    "voice": null,
    "unit_id": 121512
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 121512
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "應該不會……",
    "voice": null,
    "unit_id": 121512
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "造成麻煩吧……？",
    "voice": null,
    "unit_id": 121512
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "哦，",
    "voice": "vo_adv_5090601_014",
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "步未未，",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "妳終於有意願了啊！",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……哦，",
    "voice": "vo_adv_5090601_015",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "怪盜團",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "再次集結喵？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "這個聲音是……",
    "voice": "vo_adv_5090601_016",
    "unit_id": 121512
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "幻影貓！？",
    "voice": null,
    "unit_id": 121512
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n沒看到人……",
    "voice": null,
    "unit_id": 121512
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "妳",
    "voice": null,
    "unit_id": 121512
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "怎麼會來這裡？",
    "voice": null,
    "unit_id": 121512
  },
  {
    "type": "dialogue",
    "name": "幻影貓",
    "words": "沒什麼，",
    "voice": "vo_adv_5090601_017",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "幻影貓",
    "words": "我剛好有點事喵。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "幻影貓",
    "words": "\\n我確實拿到關於那群惡徒的資料了喵。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "幻影貓",
    "words": "\\n這樣假預告信的事我們就互不相欠喵。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "看來老大她……",
    "voice": "vo_adv_5090601_018",
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n又在我們不知情的狀況下",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "擅自作主了……",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "幻影貓",
    "words": "話說……",
    "voice": "vo_adv_5090601_019",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "幻影貓",
    "words": "馬上就是點心時間了喵。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "幻影貓",
    "words": "\\n",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "幻影貓",
    "words": "所以說，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "幻影貓",
    "words": "快來吃這個喵！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "……桌子上",
    "voice": "vo_adv_5090601_020",
    "unit_id": 121512
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "什麼時候",
    "voice": null,
    "unit_id": 121512
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "多出了鯛魚燒！？",
    "voice": null,
    "unit_id": 121512
  },
  {
    "type": "dialogue",
    "name": "幻影貓",
    "words": "這是我請的喵♪",
    "voice": "vo_adv_5090601_021",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "幻影貓",
    "words": "\\n",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "幻影貓",
    "words": "就為他人懲罰壞蛋這點，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "幻影貓",
    "words": "妳們跟我很像喵。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "幻影貓",
    "words": "\\n換句話說……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "幻影貓",
    "words": "妳們可以說是我的後輩也不為過喵！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "幻影貓",
    "words": "因此，",
    "voice": "vo_adv_5090601_022",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "幻影貓",
    "words": "那些鯛魚燒",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "幻影貓",
    "words": "算妳們後輩特別價格喵！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "突然擺出前輩的架子，",
    "voice": "vo_adv_5090601_023",
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "請的東西還要跟人收錢！？",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n這傢伙",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "到底是怎麼搞的！？",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "但是，",
    "voice": "vo_adv_5090601_024",
    "unit_id": 121512
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "看起來好好吃……",
    "voice": null,
    "unit_id": 121512
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 121512
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "那個，",
    "voice": null,
    "unit_id": 121512
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我就把錢放在桌子上囉，",
    "voice": null,
    "unit_id": 121512
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n幻影貓。",
    "voice": null,
    "unit_id": 121512
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……不過，",
    "voice": "vo_adv_5090601_025",
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "說得也是，",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n在執行重要工作前會很想要吃甜的，",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n所以要我花錢也是可以啦？",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "幻影貓",
    "words": "喵哈哈，",
    "voice": "vo_adv_5090601_026",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "幻影貓",
    "words": "謝謝惠顧！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "幻影貓",
    "words": "\\n",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "幻影貓",
    "words": "那麼，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "幻影貓",
    "words": "怪盜團，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "幻影貓",
    "words": "祝妳們好運喵！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……她好像走掉了。",
    "voice": "vo_adv_5090601_027",
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那個貓女",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "到底是怎樣啊？",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……算了，別管她，",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "來吃鯛魚燒吧。",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "……哇，",
    "voice": "vo_adv_5090601_028",
    "unit_id": 121512
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "這個鯛魚燒",
    "voice": null,
    "unit_id": 121512
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "好好吃哦……♪",
    "voice": null,
    "unit_id": 121512
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "真的耶……！",
    "voice": "vo_adv_5090601_029",
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n竟然能滿足我這個美食家的味蕾，",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "真有她的！",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "看來我不得不認同",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "幻影貓了呢……！",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……嚼嚼。",
    "voice": "vo_adv_5090601_030",
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "話說回來，",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "步未未，",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "事到如今，",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n妳不覺得「怪盜團」這個稱呼",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "讓人很提不起勁嗎？",
