[
  {
    "type": "dialogue",
    "name": "嘆きの女神",
    "words": "さあ、",
    "voice": "vo_adv_5012010_000",
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "嘆きの女神",
    "words": "貴様らも後悔と慟哭を",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "嘆きの女神",
    "words": "無様に垂れ流せ！",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "嘆きの女神",
    "words": "\\nそして絶望を貪る",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "嘆きの女神",
    "words": "我が眷属として、",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "嘆きの女神",
    "words": "\\n永遠の闇へ",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "嘆きの女神",
    "words": "その身を堕とすがよいわぁああ！",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "アユミ",
    "words": "このっ……",
    "voice": "vo_adv_5012010_001",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "アユミ",
    "words": "わからずやー！！",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "嘆きの女神",
    "words": "なに！？",
    "voice": "vo_adv_5012010_002",
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "嘆きの女神",
    "words": "　この一撃を弾くだとっ！？",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "アユミ",
    "words": "これは、",
    "voice": "vo_adv_5012010_003",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "アユミ",
    "words": "先輩がくれた大切な力！",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "アユミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "アユミ",
    "words": "あなたを救うための力だよ！！",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "アユミ",
    "words": "あなたが愛した人のことを、",
    "voice": "vo_adv_5012010_004",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "アユミ",
    "words": "私たちは知らないけど……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "アユミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "アユミ",
    "words": "大好きな人には笑っていてほしいよ！！",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "アユミ",
    "words": "今のあなたを見て、",
    "voice": "vo_adv_5012010_005",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "アユミ",
    "words": "その人が笑っているとは思えない！！",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "嘆きの女神",
    "words": "知ったふうな口を",
    "voice": "vo_adv_5012010_006",
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "嘆きの女神",
    "words": "きくなと言っている！",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "嘆きの女神",
    "words": "\\n私の心は、",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "嘆きの女神",
    "words": "私しか知らぬ！！",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "アユミさん。",
    "voice": "vo_adv_5012010_007",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "残念だけど、",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "彼女は在りし日の王女ではない。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "絶望の中で魔物へと",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "その身を堕とした、",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "怨念そのものだ。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "言葉で分かり合えないなら、",
    "voice": "vo_adv_5012010_008",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "身体でぶつかり合うしかねぇだろ。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "{0}！　とびっきりの強化を頼むぜ！",
    "voice": "vo_adv_5012010_009",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "\\n頭でっかちの王女様に、",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "お説教してやらねぇとな！！",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "うぉお、",
    "voice": "vo_adv_5012010_010",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "力がみなぎって",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "ゾクゾクするぜ！！",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "おぉりゃぁああ！！",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "アユミ",
    "words": "絶対に、",
    "voice": "vo_adv_5012010_011",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "アユミ",
    "words": "あなたを助けてみせる……！！",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "アユミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "アユミ",
    "words": "てやぁあああー！！",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "嘆きの女神……",
    "voice": "vo_adv_5012010_012",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "あなたは十分苦しんだはずだ。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "私たちがあなたを、",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "その呪縛から解放してみせる！",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "神妙にお縄につくがいい！！",
    "voice": "vo_adv_5012010_013",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "\\nこれで、",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "カスミ",
    "words": "捜査終了だぁあああ！！",
    "voice": null,
    "unit_id": 101411
  }
]
