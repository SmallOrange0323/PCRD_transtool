[
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "玩著怪盜遊戲的小鬼們……",
    "voice": "vo_adv_5090321_000",
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "\\n",
    "voice": null,
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "你們",
    "voice": null,
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "是否夠格跟我戰鬥……",
    "voice": null,
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "\\n就用這個收藏品來測試看看吧！",
    "voice": null,
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "什麼……！？",
    "voice": "vo_adv_5090321_001",
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n奇怪的拉霸機一台接一台跑出來了啦！？",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "這是買來迎擊入侵者用的東西。",
    "voice": "vo_adv_5090321_002",
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "\\n這玩意",
    "voice": null,
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "可是很貴的哦。",
    "voice": null,
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "\\n但也因為如此，",
    "voice": null,
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "是我自豪的收藏品啊。",
    "voice": null,
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "那真是太可惜了呢？",
    "voice": "vo_adv_5090321_003",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n因為你那自豪的收藏品，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n會被我們全部打爛！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這樣會造成多少億盧幣的損失呢？",
    "voice": "vo_adv_5090321_004",
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "哈哈～！",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "想想就叫人興奮呢！",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "哼哼哼……",
    "voice": "vo_adv_5090321_005",
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "做得到就試試看吧！",
    "voice": null,
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "\\n",
    "voice": null,
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "……話說回來，",
    "voice": null,
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "感覺不到步未的氣息……",
    "voice": null,
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "\\n是躲在哪想趁機偷襲我嗎？",
    "voice": null,
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "……在那嗎！？",
    "voice": null,
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "被發現了……！！",
    "voice": "vo_adv_5090321_006",
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "果然還是要先",
    "voice": null,
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "把這些拉霸機打倒才行……！",
    "voice": null,
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "還真是不能大意啊……",
    "voice": "vo_adv_5090321_007",
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "\\n",
    "voice": null,
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "唯獨妳，我一定要在這把妳解決掉，",
    "voice": null,
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "步未！",
    "voice": null,
    "unit_id": 16011
  }
]
