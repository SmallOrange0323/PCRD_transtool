  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "這是志那都和埃拉兩人",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在與{0}等人會合不久後發生的事……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "那麼～",
    "voice": "vo_adv_5137064_000",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "要來吃什麼呢？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "大家也快趁現在先決定好要吃什麼東西吧！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "要點什麼都可以喔♪",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "真的可以嗎？",
    "voice": "vo_adv_5137064_001",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "啊哈哈，",
    "voice": "vo_adv_5137064_002",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "不用客氣不用客氣！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "畢竟姐姐我可是",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "有討伐魔物得到的賞金呢♪",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "討伐魔物的賞金……",
    "voice": "vo_adv_5137064_003",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n原來如此。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……埃拉。",
    "voice": "vo_adv_5137064_004",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n話別說得太滿。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n要是妳手上的錢不夠怎麼辦。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "沒事沒事！",
    "voice": "vo_adv_5137064_005",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n要是真有什麼萬一，就去洗碗或做其他事抵債吧！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n而且……",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "只要志那都別喝太多就行了，",
    "voice": "vo_adv_5137064_006",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "對吧♪",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "…………！！",
    "voice": "vo_adv_5137064_007",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "別喝太多……？",
    "voice": "vo_adv_5137064_008",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n是指什麼呀？",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "啊哈哈，",
    "voice": "vo_adv_5137064_009",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "很在意嗎？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "其實呢……",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "埃拉……",
    "voice": "vo_adv_5137064_010",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n等等，",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "別再說了──",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "background",
    "bg_id": "500050"
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "乾杯～！",
    "voice": "vo_adv_5137064_011",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……",
    "voice": "vo_adv_5137064_012",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "乾杯。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "咕嚕咕嚕咕嚕……",
    "voice": "vo_adv_5137064_013",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "噗哈──！！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "啊～",
    "voice": "vo_adv_5137064_014",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "真暢快～～～♪",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "哈哈，",
    "voice": "vo_adv_5137064_015",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "客人喝得很豪爽呢。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n久等了，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "為兩位送上",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "烤雞肉串兩人份。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "太棒啦～！",
    "voice": "vo_adv_5137064_016",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n我等很久了♪",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……謝謝。",
    "voice": "vo_adv_5137064_017",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "不過，沒想到客人",
    "voice": "vo_adv_5137064_018",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "確實很有本事呢。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "竟然",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "轉",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "眼間就把魔物給打倒了。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "常客2",
    "words": "就是說啊！",
    "voice": "vo_adv_5137064_019",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "常客2",
    "words": "\\n雖然天空變紅也很讓人震驚，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "常客2",
    "words": "\\n但這件事更讓我驚訝呢！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "常客1",
    "words": "再加上，同行的另一位大姐感覺也是個大美人……",
    "voice": "vo_adv_5137064_020",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "謝謝！",
    "voice": "vo_adv_5137064_021",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "不過，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "要是只顧著看這邊，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "小心麥酒會變得不冰了喔～？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "常客3",
    "words": "大姐說的沒有錯。",
    "voice": "vo_adv_5137064_022",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "常客3",
    "words": "\\n你們兩個就適可而止吧。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "常客3",
    "words": "\\n",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "常客3",
    "words": "真抱歉啊，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "常客3",
    "words": "還請兩位慢慢坐。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "啊哈哈，",
    "voice": "vo_adv_5137064_023",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "謝謝謝謝～♪",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "……我說，志那都。",
    "voice": "vo_adv_5137064_024",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n妳要是一直戴著面罩，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "就什麼都吃不了也喝不了耶？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "…………因為我不曾，",
    "voice": "vo_adv_5137064_025",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n在人多的地方露出自己的面貌。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "所以……",
    "voice": "vo_adv_5137064_026",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "需要一點心理準備。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "啊～",
    "voice": "vo_adv_5137064_027",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "畢竟我們能出現在人們面前的機會有限呢。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n基本上",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "是一直關在塔裡嘛。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "埃拉為何可以這麼平靜？",
    "voice": "vo_adv_5137064_028",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……妳不會緊張嗎？",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "嗯♪",
    "voice": "vo_adv_5137064_029",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n因為我在原本的世界裡，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "姑且是作為一個友善的神明在活動嘛。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "出來見人的時候，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "也基本上都是在慶典這類的場合。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "這樣啊……",
    "voice": "vo_adv_5137064_030",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n和我那邊",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "相差很多呢。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……我在眾人面前現身之際，",
    "voice": "vo_adv_5137064_031",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "就是進行試煉的時候。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "我會給予大家建議或課題，",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "幫助他們克服困境。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "啊哈哈，",
    "voice": "vo_adv_5137064_032",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "有夠像神明的～♪",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "不過我說啊，",
    "voice": "vo_adv_5137064_033",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "待在這邊的期間，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "妳也只是個「很普通的一般人」。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n稍微放輕鬆一點也沒關係吧？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "要是周遭的視線很令人在意，",
    "voice": "vo_adv_5137064_034",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "到時候我會幫妳擋住的。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n好嗎？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……聽妳這樣講好像年紀比我還大呢。",
    "voice": "vo_adv_5137064_035",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "論「原本」的話，妳的年紀應該比我小吧。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "別在意別在意！",
    "voice": "vo_adv_5137064_036",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "就交給姐姐我吧～！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "開玩笑的♪",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "啊哈哈哈哈！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……呵呵。",
    "voice": "vo_adv_5137064_037",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "啊啊……",
    "voice": "vo_adv_5137064_038",
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n每一樣都很好吃呢。",
    "voice": null,
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n尤其是這道燉煮牛肉，",
    "voice": null,
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "味道非常地有深度……",
    "voice": null,
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "濃厚的滋味令人欲罷不能。",
    "voice": null,
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "很美味對吧～！",
    "voice": "vo_adv_5137064_039",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n要不要",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "再續加一份燉煮牛肉？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "麥酒要不要也再來一杯？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "大杯的可以嗎？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "嗯，",
    "voice": "vo_adv_5137064_040",
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "大杯。",
    "voice": null,
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "啊哈哈，",
    "voice": "vo_adv_5137064_041",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "看來妳挺能喝的嘛♪",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "老",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "闆！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n兩杯大杯的麥酒！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "還要再續一份燉煮牛肉～！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "了解～！",
    "voice": "vo_adv_5137064_042",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "不過話說回來……",
    "voice": "vo_adv_5137064_043",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "這邊的麥酒。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n雖然很好喝，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "但總～覺得和我那邊的不同呢……",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "怎麼個不同法？",
    "voice": "vo_adv_5137064_044",
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "我那邊的顏色更紅。",
    "voice": "vo_adv_5137064_045",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "雖然風味也比較獨特啦。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "但只要愛上了，就忘不掉那個滋味呢……♪",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "唔嗯。",
    "voice": "vo_adv_5137064_046",
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n果然是因為不同世界而有所差異嗎……",
    "voice": null,
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "世界不同的話，麥酒也會不同啊～",
    "voice": "vo_adv_5137064_047",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n這樣說起來……",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "管理者也會不同……",
    "voice": "vo_adv_5137064_048",
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "對吧。",
    "voice": null,
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "是呀。",
    "voice": "vo_adv_5137064_049",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "……這個世界的管理者，",
    "voice": "vo_adv_5137064_050",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "不曉得是怎麼樣的人呢。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "考慮到目前在此的是我們兩人……",
    "voice": "vo_adv_5137064_051",
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n那麼最有可能的，",
    "voice": null,
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "就是優衣的「複製品」。",
    "voice": null,
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n當然也有可能是其他人。",
    "voice": null,
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "也不曉得其他還有多少個",
    "voice": "vo_adv_5137064_052",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "「複製品世界」存在呢。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "唉～",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "光是想到就覺得累了啊。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "不過，",
    "voice": "vo_adv_5137064_053",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "不管怎麼說，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n要是可以和這邊世界裡的日和好好相處就好了。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "畢竟她們也只是資料被拿去利用了而已。",
    "voice": "vo_adv_5137064_054",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n打造出我們世界的，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n終究還是我們自己呢。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "是啊。",
    "voice": "vo_adv_5137064_055",
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n……妳說的沒錯。",
    "voice": null,
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "久等了，",
    "voice": "vo_adv_5137064_056",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "兩杯大杯麥酒。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n還有燉煮牛肉。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "謝謝。",
    "voice": "vo_adv_5137064_057",
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "對了，",
    "voice": "vo_adv_5137064_058",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "老闆。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n這附近，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "有沒有",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "顏色更紅的麥酒呀？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "紅色……",
    "voice": "vo_adv_5137064_059",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "啊啊，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "妳是說赤麥酒嗎。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "這附近雖然沒有，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "但我記得到西部地區應該就喝得到了。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "西部……",
    "voice": "vo_adv_5137064_060",
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "是我入侵時所在的地區嗎。",
    "voice": null,
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "入侵？",
    "voice": "vo_adv_5137064_061",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "啊哈哈，",
    "voice": "vo_adv_5137064_062",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "只是我們在談的事情而已！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "老闆謝謝你，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "打聽到好情報了～♪",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n志那都，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "我們明天就往西──",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "呼。",
    "voice": "vo_adv_5137064_063",
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "再來一杯，",
    "voice": null,
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "麥酒。",
    "voice": null,
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "大杯的。",
    "voice": null,
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "喝得有夠快的！？",
    "voice": "vo_adv_5137064_064",
    "unit_id": 135512
  },
  {
    "type": "background",
    "bg_id": "500170"
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "埃拉。",
    "voice": "vo_adv_5137064_065",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n到此為止了。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "妳如果",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "要再繼續回想下去──",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "我、",
    "voice": "vo_adv_5137064_066",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "我知道了啦！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n我不說我不說！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n所以妳不要拔劍啦～！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "總覺得……",
    "voice": "vo_adv_5137064_067",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "她們感情很好呢。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……就是說呢。",
    "voice": "vo_adv_5137064_068",
    "unit_id": 100311
  }
