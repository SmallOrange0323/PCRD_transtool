[
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "贏了！　",
    "voice": "vo_adv_9029156_000",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我們贏了，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "貪吃佩可！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是的♪　",
    "voice": "vo_adv_9029156_001",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "賭上肚子餓得咕嚕咕嚕叫的貪吃佩可之名，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n絕對不能在食慾上敗北的呢！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "如此一來貪吃佩可小姐，",
    "voice": "vo_adv_9029156_002",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "可正式成為",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n食慾比鱷魚龍",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "還要旺盛的人了呢……！",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "討厭，",
    "voice": "vo_adv_9029156_003",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "人家會害羞啦～☆",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……那樣真的值得高興嗎？　",
    "voice": "vo_adv_9029156_004",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "受不了妳們。",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那麼，",
    "voice": "vo_adv_9029156_005",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我就不客氣囉～",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n頭部周圍看起來像裙帶菜的部分似乎可以生吃呢♪",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n嗯嗯嗯，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我拔！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "咦？　",
    "voice": "vo_adv_9029156_006",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "等等……",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n連這傢伙妳也要吃嗎……？　",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "而且是生吃……？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嗯嗯……",
    "voice": "vo_adv_9029156_007",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嚼嚼……",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "和一般的海藻有點不太一樣呢～",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嗯，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "散發著鱷魚的風味，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "也很有嚼勁～",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "十分美味☆",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗯。",
    "voice": "vo_adv_9029156_008",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳的食慾果然",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是在鱷魚之上呢。",
    "voice": null,
    "unit_id": 106011
  }
]
