  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "被彈開了……？",
    "voice": "vo_adv_5206004_005",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n因為我中斷了「睡眠」導致力量不足嗎……",
