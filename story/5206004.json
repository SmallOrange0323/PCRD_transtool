    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "是我",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "沒有控制這個夢境的權限……",
