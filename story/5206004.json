  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "騎士先生很擔心妳。",
    "voice": "vo_adv_5206004_003",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n該請妳從夢中醒過來了，",
