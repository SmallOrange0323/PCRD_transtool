[
  {
    "type": "background",
    "bg_id": "500020"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "演唱會隔天。\\n望來找{0}。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "因為我一直到昨天都在忙著準備演唱會和寫新歌，",
    "voice": "vo_adv_1029007_000",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "所以今天我請他們讓我休假一天喔。",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "欸，機會難得，就我們兩人來舉辦慶功宴吧？",
    "voice": "vo_adv_1029007_001",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "咦？你問為什麼兩個人……因為……",
    "voice": "vo_adv_1029007_002",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你想想，演唱會之前我們不也一起工作了嗎？",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n那份工作的也順便辦！",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "就這麼決定囉！",
    "voice": "vo_adv_1029007_003",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n我知道這附近有間好吃的店，",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "就去那裡吃飯吧！",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "background",
    "bg_id": "500050"
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這間是我很喜歡的店喔。",
    "voice": "vo_adv_1029007_004",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我想你一定也會喜歡的――",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "男粉絲",
    "words": "咦！？望望！？",
    "voice": "vo_adv_1029007_005",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不、不好了！",
    "voice": "vo_adv_1029007_006",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n好像是我的粉絲們……！",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我們快逃！\\n造成騷動的話，也會給店家添麻煩的！",
    "voice": "vo_adv_1029007_007",
    "unit_id": 102911
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "呼……呼……沒有再追過來了吧。",
    "voice": "vo_adv_1029007_008",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n突然要你逃跑，抱歉喔。",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那我們再去吃飯吧。",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "小孩粉絲",
    "words": "啊～是望望～♪ ",
    "voice": "vo_adv_1029007_009",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "小孩粉絲",
    "words": "好可愛喔～！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這裡竟然也有我的粉絲！？\\n",
    "voice": "vo_adv_1029007_010",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "抱歉，我今天休假――！",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "老人粉絲",
    "words": "喔喔……這不是望望嗎……",
    "voice": "vo_adv_1029007_011",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人粉絲",
    "words": "\\n跟我死去的老伴簡直一模一樣……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這、這裡也有粉絲嗎？",
    "voice": "vo_adv_1029007_012",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "要逃跑囉！",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "background",
    "bg_id": "500130"
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "結果逃到街道外了……\\n",
    "voice": "vo_adv_1029007_013",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "但都逃到這裡了，應該不會再有――",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "無賴（小）",
    "words": "喔喔！這、這不是望望嗎！",
    "voice": "vo_adv_1029007_014",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴（小）",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴（小）",
    "words": "老子是你的鐵粉喔！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "我也是！待會再讓我逮捕你們！",
    "voice": "vo_adv_1029007_015",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n望望！先幫我簽個名！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "無賴（大）",
    "words": "嗯，我們都先不要吵了！",
    "voice": "vo_adv_1029007_016",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無賴（大）",
    "words": "\\n望望",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無賴（大）",
    "words": "，跟我握個手吧！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "連、連這裡都有！？",
    "voice": "vo_adv_1029007_017",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "今天……今天一天就好，",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "放過我吧――！",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "background",
    "bg_id": "500211"
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "呼……",
    "voice": "vo_adv_1029007_018",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我們兩人終於能夠獨處了。",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "雖然已經傍晚了……\\n唉，難得的休假要結束了。",
    "voice": "vo_adv_1029007_019",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "抱歉喔。\\n我又搞砸了你的休假……",
    "voice": "vo_adv_1029007_020",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "話說回來，我們第一次見面也是這種情況呢。",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你說的沒錯。\\n不久前我們兩人才約會……",
    "voice": "vo_adv_1029007_021",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "才練習過約會而已呢。",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "是啊。像是女生、小孩和老爺爺粉絲們……",
    "voice": "vo_adv_1029007_022",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "有各式各樣的人為我加油，真的很開心呢。",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "但我的目標是超級偶像喔。",
    "voice": "vo_adv_1029007_023",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n還差得遠呢。",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我得更加更加地努力才行。",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那我們兩人來舉辦慶功宴吧！",
    "voice": "vo_adv_1029007_024",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n雖然沒有食物和飲料……",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "欸，坐吧坐吧！",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……你說再不回去就太晚了？",
    "voice": "vo_adv_1029007_025",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "雖、雖然這麼說沒錯啦……",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n但我們還沒舉辦慶功宴呢……",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "是、是嗎？能聽到你這麼說……我也很開心。",
    "voice": "vo_adv_1029007_026",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯，說得也是。",
    "voice": "vo_adv_1029007_027",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "雖然今天泡湯了，但下次一定要……",
    "voice": "vo_adv_1029007_028",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "呃，果然還是不行嗎？",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n雖然我很開心有這麼多粉絲，",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n但相對的一定會失去私人時間……",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "唉……不能跟你一起玩……",
    "voice": "vo_adv_1029007_029",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n我要不乾脆不當偶像了……",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我、我當然是開玩笑的喔！開個玩笑而已～",
    "voice": "vo_adv_1029007_030",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……{0}，\\n你希望我繼續當偶像嗎？",
    "voice": "vo_adv_1029007_031",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "如果……{0}對我說，",
    "voice": "vo_adv_1029007_032",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n「不要當偶像了」的話……",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "呵呵呵。",
    "voice": "vo_adv_1029007_033",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n你不可能會說這種話吧。",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "因為你一直都在為我加油嘛。",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "當偶像是一件相當辛苦的工作，",
    "voice": "vo_adv_1029007_034",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n不但有一堆討厭的事情，也完全沒有私人時間……",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "即便如此，我能堅持下去的理由，\\n就是因為遇到了你喔。",
    "voice": "vo_adv_1029007_035",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "因為啊，你知道我是偶像後，\\n還能很自然地跟我相處對吧？",
    "voice": "vo_adv_1029007_036",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "只有在你面前，\\n我才能……成為一個普通的女孩子喔。",
    "voice": "vo_adv_1029007_037",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "所以，我平常才能繼續努力當偶像。",
    "voice": "vo_adv_1029007_038",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n像現在這樣和你在一起的時間，",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n正是支持著我的原動力喔。",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那個……\\n今天我有件事無論如何都想告訴你――",
    "voice": "vo_adv_1029007_039",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我，",
    "voice": "vo_adv_1029007_040",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "對{0}──",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "對{0}──",
    "voice": "vo_adv_1029007_041",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "………………",
    "voice": "vo_adv_1029007_042",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "對{0}……一直以來都很感謝喔。",
    "voice": "vo_adv_1029007_043",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我很信賴你。\\n在我成為頂尖偶像前，你要繼續協助我喔？",
    "voice": "vo_adv_1029007_044",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "啊哈哈，今後也請多指教！",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "以上就是我想說的話，完畢！",
    "voice": "vo_adv_1029007_045",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n我們回家吧！{0}！",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "………………",
    "voice": "vo_adv_1029007_046",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "如果告訴他我的心情，\\n我就沒辦法再當偶像了……",
    "voice": "vo_adv_1029007_047",
