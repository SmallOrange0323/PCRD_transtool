[
  {
    "type": "background",
    "bg_id": "502332"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "涅比亞，",
    "voice": "vo_adv_5150411_000",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n妳應該有話要跟大家說吧。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "這次",
    "voice": "vo_adv_5150411_001",
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "我的惡作劇造成各位的困擾，",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "我深感抱歉。",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "妳有乖乖說出來呢～♪",
    "voice": "vo_adv_5150411_002",
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n向人賠罪也是很重要的哦～",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "嗚嗚",
    "voice": "vo_adv_5150411_003",
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "……",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "難得的夏天耶……",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "這樣夏天會在我只能顧著低頭道歉中結束的……",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "……妳在說什麼啊。",
    "voice": "vo_adv_5150411_004",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n夏天還沒結束吧。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "菲歐……？",
    "voice": "vo_adv_5150411_005",
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我也是很期待的哦。",
    "voice": "vo_adv_5150411_006",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "期待這個大家都",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "樂在其中的",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "暑假。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "機會難得，",
    "voice": "vo_adv_5150411_007",
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我們就讓城鎮再稍微維持這個樣子，",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n然後來享受一下跟平時不一樣的蘭德索爾吧～♪",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "就是這麼回事。",
    "voice": "vo_adv_5150411_008",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n來，走囉，",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "涅比亞。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "……嗯♪",
    "voice": "vo_adv_5150411_009",
    "unit_id": 190912
  }
]
