[
  {
    "type": "background",
    "bg_id": "500330"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "某個大晴天。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}等人",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "為了幫忙音樂劇團的公演，\\n動身前往村子的劇場。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "話說回來，",
    "voice": "vo_adv_5100601_000",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "沒想到噗吉會有出演音樂劇的一天！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「喔？",
    "voice": "vo_adv_5100601_001",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "怎麼？",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n妳忘記我在繆思小鎮的精彩表現了嗎──？」",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我沒有忘記喔！",
    "voice": "vo_adv_5100601_002",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "那時候的噗吉",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "超帥氣的！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「當時真步公主",
    "voice": "vo_adv_5100601_003",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "和綾音看起來也很可靠喔。",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n正因為有兩位在，",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "我才能下定決心",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "參與音樂劇。」",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "是呀。",
    "voice": "vo_adv_5100601_004",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "那時候",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "劇團的各位",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "也相當高興呢。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "還能像這樣見到面，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "真是令人高興的緣分哪。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "是啊是啊，",
    "voice": "vo_adv_5100601_005",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "真的是這樣！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n音樂劇也很令人期待，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "不過……",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n我最期待的是",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "能再見到劇團的成員們！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「是啊！",
    "voice": "vo_adv_5100601_006",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "我也這麼覺得……",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "嗯？」",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "噗吉先生？",
    "voice": "vo_adv_5100601_007",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "怎麼了嗎？",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「……不，",
    "voice": "vo_adv_5100601_008",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "是我多心了。",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n一瞬間有種那傢伙在的",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "感覺……」",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "你說的「那傢伙」，",
    "voice": "vo_adv_5100601_009",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "是指植物羊先生嗎？",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「是啊。",
    "voice": "vo_adv_5100601_010",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "不過那傢伙現在去旅行了，",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n不管怎麼說，",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "都不可能那麼巧在這裡見到面。」",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "嗯。",
    "voice": "vo_adv_5100601_011",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "畢竟不久前才收到",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "牠說下次旅行要去",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "深山的信呢。",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「對吧。",
    "voice": "vo_adv_5100601_012",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "果然是錯覺吧！",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n植物羊",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "不可能會在這裡的。」",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "大姊姊你們，",
    "voice": "vo_adv_5100601_013",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "認識植物羊嗎？",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "咦？",
    "voice": "vo_adv_5100601_014",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "熊熊先生、熊熊先生！",
    "voice": "vo_adv_5100601_015",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "\\n難道你就是",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "噗吉先生嗎？",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「沒、",
    "voice": "vo_adv_5100601_016",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "沒錯！",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "我就是噗吉大人啦！",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n這麼快就有我的粉絲了嗎……",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "真不虧是我！」",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "噗吉，你冷靜一點。",
    "voice": "vo_adv_5100601_017",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "根本沒有人說是你的粉絲！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「啊，",
    "voice": "vo_adv_5100601_018",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "抱歉抱歉。",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "所以說，",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "小妹妹妳為什麼",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "認識我？",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n我們是初次見面吧？」",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "嗯！",
    "voice": "vo_adv_5100601_019",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "其實啊！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "我是從植物羊那邊聽說的！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "小妹妹妳",
    "voice": "vo_adv_5100601_020",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "認識植物羊先生嗎？",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "嗯！",
    "voice": "vo_adv_5100601_021",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "植物羊是我的救命恩人",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "喔！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "background",
    "bg_id": "501840"
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "那個啊，",
    "voice": "vo_adv_5100601_022",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "之前啊……",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "因為爸爸有工作，\\n所以我們去了有點遠的地方。",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "\\n",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "青蛙先生玩偶也有一起去！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "因為爸爸要我當個乖孩子等他，",
    "voice": "vo_adv_5100601_023",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "所以我就在噴水池附近，",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "\\n跟青蛙先生一起等喔，",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "然後附近馬車的馬先生啊，",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "\\n就突然跑了起來呢！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "等我注意到的時候，",
    "voice": "vo_adv_5100601_024",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "馬先生已經跑到好近的地方了……",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "\\n雖然大家",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "都大叫要我快逃，",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "\\n但是我害怕到沒辦法動了。",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "那時候，",
    "voice": "vo_adv_5100601_025",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "我真的覺得",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "「要被撞上了！」喔。",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "\\n所以我怕得",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "閉上了眼睛。",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "\\n然後……",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "植物羊",
    "words": "危險！",
    "voice": "vo_adv_5100601_026",
    "unit_id": 16612
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "我聽到有人這樣說。",
    "voice": "vo_adv_5100601_027",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "但是，",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "不管經過多久，",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "馬車都沒有撞上我。",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "\\n我覺得奇怪，",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "才發現是植物羊啊，",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "衝進了我跟馬先生之間，",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "\\n幫我把馬先生擋下來了。",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "植物羊",
    "words": "痛痛痛痛痛……",
    "voice": "vo_adv_5100601_028",
    "unit_id": 16612
  },
  {
    "type": "dialogue",
    "name": "植物羊",
    "words": "沒事吧？",
    "voice": null,
    "unit_id": 16612
  },
  {
    "type": "dialogue",
    "name": "植物羊",
    "words": "\\n",
    "voice": null,
    "unit_id": 16612
  },
  {
    "type": "dialogue",
    "name": "植物羊",
    "words": "……嗯嗯，",
    "voice": null,
    "unit_id": 16612
  },
  {
    "type": "dialogue",
    "name": "植物羊",
    "words": "太好了！",
    "voice": null,
    "unit_id": 16612
  },
  {
    "type": "dialogue",
    "name": "植物羊",
    "words": "沒有受傷呢。",
    "voice": null,
    "unit_id": 16612
  },
  {
    "type": "dialogue",
    "name": "植物羊",
    "words": "\\n",
    "voice": null,
    "unit_id": 16612
  },
  {
    "type": "dialogue",
    "name": "植物羊",
    "words": "馬兒也是，",
    "voice": null,
    "unit_id": 16612
  },
  {
    "type": "dialogue",
    "name": "植物羊",
    "words": "謝謝你願意停下來。",
    "voice": null,
    "unit_id": 16612
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "植物羊",
    "voice": "vo_adv_5100601_029",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "超級帥氣喔！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "\\n",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "然後啊，",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "植物羊在我還嚇一跳的時候，",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "\\n幫我把青蛙先生撿回來了。",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "「雖然青蛙先生被馬車壓到了，",
    "voice": "vo_adv_5100601_030",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "不過只要把這個放進去就行囉。」",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "\\n植物羊邊這樣說邊給了我綿毛。",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "\\n",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "軟綿綿地跟棉花糖一樣！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "background",
    "bg_id": "500330"
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「妳就是在那時聽說了我的事情嗎？」",
    "voice": "vo_adv_5100601_031",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "嗯！",
    "voice": "vo_adv_5100601_032",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "我聽了噗吉先生你們的事，",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "\\n還有玩偶亞瑟的事情。",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "植物羊",
    "voice": "vo_adv_5100601_033",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "在害怕和嚇一跳的心情從我心裡消失前，",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "\\n",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "跟我說了很多話喔。",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "你們看你們看，",
    "voice": "vo_adv_5100601_034",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "這就是當時的",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "青蛙先生喔！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "哎呀，",
    "voice": "vo_adv_5100601_035",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "軟綿綿又討人喜愛，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "真是最棒的朋友呢。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "嗯！",
    "voice": "vo_adv_5100601_036",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "\\n青蛙先生也跟植物羊變成好朋友了喔！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "\\n",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "雖然植物羊",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "立刻就又去旅行了……",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "是這樣啊。",
    "voice": "vo_adv_5100601_037",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "不過，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "能知道牠過得很好，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n咱們也很高興喔。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "植物羊先生真的是在",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "到處旅行呢。",
    "voice": null,
    "unit_id": 101011
  },
