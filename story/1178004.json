[
  {
    "type": "background",
    "bg_id": "505035"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "為萬聖節慶典收尾的遊行結束後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n蘭德索爾熱烈的氣氛逐漸轉為寧靜──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "哇呀──",
    "voice": "vo_adv_1178004_000",
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "滿足，",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "滿足是也！",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n萬聖節",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "原來是這麼好玩的習俗，",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "超乎想像！",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "等將軍",
    "voice": "vo_adv_1178004_001",
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "造好城堡，",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n我們也在城腳的城鎮",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "舉辦東國風的萬聖節慶典吧！",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "真想從天守閣",
    "voice": "vo_adv_1178004_002",
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "觀看百姓",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "開心慶祝的樣子是也！",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "……喔？",
    "voice": "vo_adv_1178004_003",
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "將軍身上又發出",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "之前那種威嚴的光芒了是也！",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "明明是晚上",
    "voice": "vo_adv_1178004_004",
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "卻亮得像白天一樣，",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "眼睛睜不開了！",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "哎～",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "呀～～！！",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "background",
    "bg_id": "510220"
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "好，今天課就上到這裡。",
    "voice": "vo_adv_1178004_005",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "\\n請大家回家路上注意安──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "咻啪啪啪！",
    "voice": "vo_adv_1178004_006",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n打擾了──！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "打擾了──！！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "妳、",
    "voice": "vo_adv_1178004_007",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "妳是誰！？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "那身制服……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "是王林道的……？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "\\n來這邊有什麼事？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "有事先辦好訪問申請嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "防問神情？",
    "voice": "vo_adv_1178004_008",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "太複雜的日文",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我聽不懂是也。",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我是",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "法國來的留學生是也。",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "Bonjour！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "有更重要的事，將軍！",
    "voice": "vo_adv_1178004_009",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n糟糕了是也！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "大事不妙了是也！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "此乃無法預測的危急狀況是也！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "商店街",
    "voice": "vo_adv_1178004_010",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "竟然遭到侵略了是也！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n詳情",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "等到了現場再說！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "先趕過去吧！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "那",
    "voice": "vo_adv_1178004_011",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "椿丘高校的各位老師同學，",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我們就此別過，",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "隱身是也！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "後會有期忍忍是也！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "啊，",
    "voice": "vo_adv_1178004_012",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "喂！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "給我等一等──！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "510290"
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "不給糖就搗蛋！",
    "voice": "vo_adv_1178004_013",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "喔──好可怕、",
    "voice": "vo_adv_1178004_014",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "好可怕。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n我給你點心，放過我吧。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "不給我點心就要惡作劇囉──！",
    "voice": "vo_adv_1178004_015",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "吼吼──！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "呀啊──！",
    "voice": "vo_adv_1178004_016",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "給妳很～甜的糖果吧──！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "將軍……",
    "voice": "vo_adv_1178004_017",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "如你所見是也……",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n商店街……",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "已經被妖怪們侵略了！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我們要馬上趕跑妖怪，",
    "voice": "vo_adv_1178004_018",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "守護居民的生活是也！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n想必這會是",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "一場邁向統一天下的",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "關鍵戰役！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "啊！",
    "voice": "vo_adv_1178004_019",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "我們還沒跟那兩個人要點心！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "對呀，",
    "voice": "vo_adv_1178004_020",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "去跟他們拿吧！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "孩子們",
    "words": "不給糖就搗蛋！",
    "voice": "vo_adv_1178004_021",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "孩子們",
    "words": "\\n不交出點心就對你們惡作劇喔──！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "唔！？",
    "voice": "vo_adv_1178004_022",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "隨即就被妖怪包圍了是也。",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "威脅對我不管用喔──！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我平時",
    "voice": "vo_adv_1178004_023",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "帶在身上的",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "這個",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "糯米丸子，",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n只會賜給要成為將軍的家臣的人！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "喔喔──！",
    "voice": "vo_adv_1178004_024",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "這丸子看起來滿好吃的！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "\\n快把它搶過來──！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "包在我身上！",
    "voice": "vo_adv_1178004_025",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "咕嘰咕嘰咕嘰咕嘰～～！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "欸，",
    "voice": "vo_adv_1178004_026",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "嗚哇，",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "住手……！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "呀哈哈哈哈哈！！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "好、",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "好癢是也！！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "趁現在",
    "voice": "vo_adv_1178004_027",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "拿走妳的丸子啦──！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "掰掰──！",
    "voice": "vo_adv_1178004_028",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "呼……",
    "voice": "vo_adv_1178004_029",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "呼……",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n多麼",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "窮兇惡極的",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "妖怪小孩呀……",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "居然搶走我的糯米丸子跑走了……",
    "voice": "vo_adv_1178004_030",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "最近的年輕人",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "難道不知道桃太郎嗎……",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "實在可嘆是也……",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "呵呵呵……",
    "voice": "vo_adv_1178004_031",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "也罷。",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n事到如今",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我就展現一下殺手鐧是也。",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "將軍，",
    "voice": "vo_adv_1178004_032",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "請在此稍候片刻！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n我準備了",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "一招暗藏已久的密技是也！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "咻啪啪！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "still",
    "still_id": "117800401"
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "哈──",
    "voice": "vo_adv_1178004_033",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "哈、",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "哈、",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "哈──！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "天狗大人駕到是也！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n若有壞小孩，",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "就讓你嘗嘗神隱的滋味是也──！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "正是！",
    "voice": "vo_adv_1178004_034",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n既然對手",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "扮成妖怪，",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我們也",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "用同一招即可是也！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "正所謂",
    "voice": "vo_adv_1178004_035",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "入境隨俗是也。",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n同樣打扮成妖怪，",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "就不怕遭到他們襲擊了。",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "而且",
    "voice": "vo_adv_1178004_036",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "天狗啊，",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "在口耳相傳中，",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "是能夠變化成",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "人類模樣的是也。",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "正是最適合",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "這個狀況的妖怪是也！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "哎呀──",
    "voice": "vo_adv_1178004_037",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我有事先",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "在包包裡偷藏好這套服裝",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "真是明智之舉是也。",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n有備",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "無患是也！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "嘿嘿嘿……",
    "voice": "vo_adv_1178004_038",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "難得有這個機會是也！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "在日本妖怪之中",
    "voice": "vo_adv_1178004_039",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "就屬",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "天狗",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "最帥氣是也！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n若要變裝，",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "天狗是唯一選擇！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "不作他想！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "走吧，",
    "voice": "vo_adv_1178004_040",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "不可忘記我們的目的。",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "接下來",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "要開始端正世風是也！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "本人是",
    "voice": "vo_adv_1178004_041",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "正義的大天狗，",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n要來嚴懲那些",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "對百姓作惡的",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "妖怪小孩──！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "蔬菜店店員",
    "words": "哎唷，",
    "voice": "vo_adv_1178004_042",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "蔬菜店店員",
    "words": "天狗小姐。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "蔬菜店店員",
    "words": "妳的扮裝很用心啊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "蔬菜店店員",
    "words": "\\n喔喔，好可怕好可怕。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "蔬菜店店員",
    "words": "我給妳點心，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "蔬菜店店員",
    "words": "求求妳別對我惡作劇啊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "喔喔──！",
    "voice": "vo_adv_1178004_043",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "蔬果店大叔！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "你看起來很有活力",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "真是太好了！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "這煎餅",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "看起來",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "真好吃是也！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "可是，",
    "voice": "vo_adv_1178004_044",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我明明沒說不給糖就搗蛋，",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n為什麼",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "要給我點心呢？",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "蔬菜店店員",
    "words": "這是萬聖節活動的一部分，",
    "voice": "vo_adv_1178004_045",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "蔬菜店店員",
    "words": "我都會發給有變裝的人，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "蔬菜店店員",
    "words": "\\n為了幫商店街宣傳啊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "蔬菜店店員",
    "words": "話說回來，",
    "voice": "vo_adv_1178004_046",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "蔬菜店店員",
    "words": "妳這服裝還真用心欸。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "蔬菜店店員",
    "words": "\\n說到變裝，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "蔬菜店店員",
    "words": "大家全都扮成吸血鬼之類的洋派鬼怪，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "蔬菜店店員",
    "words": "\\n扮天狗很少見啊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "呵呵呵，",
    "voice": "vo_adv_1178004_047",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "要說日本傳統風妖怪，",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n除了天狗別無他選！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "花店",
    "words": "哎呀～",
    "voice": "vo_adv_1178004_048",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "花店",
    "words": "好可愛的天狗呀。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "花店",
    "words": "\\n來，這個給妳。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "花店",
    "words": "請收下我的餅乾。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "肉舖",
    "words": "妳扮得真了不起。",
    "voice": "vo_adv_1178004_049",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "肉舖",
    "words": "\\n我們店裡有在發饅頭。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "肉舖",
    "words": "來吧，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "肉舖",
    "words": "喜歡哪個儘管拿！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "這次",
    "voice": "vo_adv_1178004_050",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "是被商店街的人們包圍是也！？",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n得到了",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "這麼多點心！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "啊！",
    "voice": "vo_adv_1178004_051",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "這些難道是",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "要進貢給",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "將軍的嗎……？",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "如果是這麼一回事，",
    "voice": "vo_adv_1178004_052",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我還想要拿更多是也！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "拿出天狗真本事的時候到了呀──！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "哈、",
    "voice": "vo_adv_1178004_053",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "哈、",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "哈──！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "各位老百姓啊──！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n倘若不想遭到",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "天狗惡作劇，",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "就交出",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "更多點心來是也！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "超強……",
    "voice": "vo_adv_1178004_054",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "\\n那個天狗",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "是剛才帶丸子的大姐姐吧？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "她要到了那麼多點心……",
    "voice": "vo_adv_1178004_055",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "唔！",
    "voice": "vo_adv_1178004_056",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "你們是",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "剛才",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "那兩隻小妖怪吧？",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "假如你們放棄惡作劇，",
    "voice": "vo_adv_1178004_057",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "成為這一位",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "將軍的家臣，",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n我就分給你們一些",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我得到的點心吧！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "也可邀其他朋友",
    "voice": "vo_adv_1178004_058",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "一起來是也！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "如何？",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "你們願意發誓",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "效忠將軍嗎？",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "孩子們",
    "words": "我發誓──！",
    "voice": "vo_adv_1178004_059",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "答得好！",
    "voice": "vo_adv_1178004_060",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n我用點心",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "使侵略的妖怪歸降，",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "並擴充家臣了是也──！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "來吧，",
    "voice": "vo_adv_1178004_061",
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我們要納入",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "更多家臣！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n百鬼夜行要開始了是也──！",
    "voice": null,
    "unit_id": 103031
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好，",
    "voice": "vo_adv_1178004_062",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "辛苦了～",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "如何？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "有做一場好夢嗎？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "妮諾真是的，",
    "voice": "vo_adv_1178004_063",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "雀躍成那個樣子，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n看來她真的很想扮天狗呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "雖然很機靈地趁勢拿到許多點心，",
    "voice": "vo_adv_1178004_064",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不過又全部分給了小孩子，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "真像妮諾的作風呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "她擁有讓其他人綻放笑容的力量對吧，",
    "voice": "vo_adv_1178004_065",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不過本人應該沒有察覺到。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "妮諾所仰慕的你，",
    "voice": "vo_adv_1178004_066",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "在未來的日子裡也要守住她的笑容喔？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n那就這樣，再見囉。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "505035"
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "嗯，",
    "voice": "vo_adv_1178004_067",
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "嗯嗯",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "……",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我似乎興奮過頭累倒了，",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "不小心睡著了是也……",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "啊！",
    "voice": "vo_adv_1178004_068",
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "請將軍快起床！",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n在到家以前",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "都算是祭典是也！",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "而且",
    "voice": "vo_adv_1178004_069",
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "要是在這裡睡著，",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n靈魂",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "說不定會被誤帶去靈界！",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "雖說",
    "voice": "vo_adv_1178004_070",
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "那邊開始爆發",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "像東國戰國時代般的戰爭，",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n但是現在",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "去靈界還太早了是也！",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "首先",
    "voice": "vo_adv_1178004_071",
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我們要先統一這個現實的天下是也！",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n然後",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "等壽終正寢之後，",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我們再去統一死者的世界！",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "到了靈界，",
    "voice": "vo_adv_1178004_072",
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "在遊行時遇到的",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "妖魔",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "和幽靈們，",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n肯定",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "會助我們一臂之力。",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "大家死後還能再會，",
    "voice": "vo_adv_1178004_073",
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "他們都是將軍",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "未來的家臣是也！",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "哈……",
    "voice": "vo_adv_1178004_074",
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "不過話說回來，",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n死掉之後",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "也能待在將軍身邊，",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "真是叫人興奮難耐！",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "據說死後的世界",
    "voice": "vo_adv_1178004_075",
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "會永遠存續下去，",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n我在那邊",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "也要一直",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "一直",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "當你的頭號家臣喔──！！",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "首次度過萬聖節的妮諾",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n天馬行空地幻想著今後繼續延續的統一天下漫漫長路──",
    "voice": null,
    "unit_id": null
  }
]
