[
  {
    "type": "background",
    "bg_id": "500036"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在蘭德索爾的某街角，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n答應要陪璃乃念書的{0}前來赴約。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "今天",
    "voice": "vo_adv_1193004_000",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "要好好念書！",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "雖說現在正值聖誕季，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "但這兩件事是",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "毫不相干的！",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我可要好好專心念書！",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "……話是這麼說……",
    "voice": "vo_adv_1193004_001",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "但我卻忍不住偷懶起來，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "所以才請哥哥過來一趟。",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "請你務必緊盯著我！",
    "voice": "vo_adv_1193004_002",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "拜託你了！",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "老實說，",
    "voice": "vo_adv_1193004_003",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "預定要做的問答集已經堆積如山了……",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "啊啊啊──！",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n這真教人絕望……",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "不，",
    "voice": "vo_adv_1193004_004",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我很清楚，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "這全是我自己的錯！",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n一下跑去打工，一下又栽進編織的世界，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我很罕見地在念書上敷衍了事……",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n這是我早就知道的事，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "所以我不會找藉口的！",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "但是！",
    "voice": "vo_adv_1193004_005",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "現在應該還來得及挽回！",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n我要好好做……！",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "就是這麼一回事。",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "如果有哥哥在我身邊，",
    "voice": "vo_adv_1193004_006",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n我就有動力把自己逼到極限！",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n這樣一來，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我就逃不了了！",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "況且，",
    "voice": "vo_adv_1193004_007",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "今天我們之間的距離……",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "似乎也比平時還來得近，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我、",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我會打起精神來的！",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "很好，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "今天馬上就從這裡開始……",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "…………",
    "voice": "vo_adv_1193004_008",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "哥哥……",
    "voice": "vo_adv_1193004_009",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "呼……",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n我還得、",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "好好念書、",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "才行……",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "請你再多",
    "voice": "vo_adv_1193004_010",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "陪在、我身邊……",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "…………呼……",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "呼……",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我還清醒著……",
    "voice": "vo_adv_1193004_011",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "喔……",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "棲息在蘭德索爾周遭",
    "voice": "vo_adv_1193004_012",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "森林地帶的魔物，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "已知就有好幾種。",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n請回答在這之中，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "好食植物性養分的",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "四足獸魔物的種類名稱，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n以及簡明扼要地呈現出",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "該種類之特徵行動的……",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "嗯……",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "這個是……",
    "voice": "vo_adv_1193004_013",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "偽裝成陷阱題的",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "送分題呢……",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "唔……",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "在這裡可以",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "多賺到一些",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "答對題數……",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "嗯嗯……",
    "voice": "vo_adv_1193004_014",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "哥哥……？",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "不知怎地，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "覺得好刺眼……",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "background",
    "bg_id": "510272"
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "哥哥、",
    "voice": "vo_adv_1193004_015",
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "哥哥！",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "在這邊！",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "你快看！",
    "voice": "vo_adv_1193004_016",
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "閃閃發亮！",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n很有燈飾的氛圍呢！",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "快點快點！",
    "voice": "vo_adv_1193004_017",
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n要是走散了就糟了。",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "啊，",
    "voice": "vo_adv_1193004_018",
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "那裡有張空的長椅，",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "要不要去坐？",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n就在那裡，",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我們走吧！",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "still",
    "still_id": "119300401"
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "太好了，",
    "voice": "vo_adv_1193004_019",
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "幸好有坐到！",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "呃，",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "你說用不著這麼慌張？",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n被你這麼一說，",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "或許是這樣吧！",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "不過，",
    "voice": "vo_adv_1193004_020",
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "現在可是和哥哥在約會呢！",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我希望可以盡可能地好好享受這段時光！",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我也知道，",
    "voice": "vo_adv_1193004_021",
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n自己用不著這麼焦急。",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "但是，",
    "voice": "vo_adv_1193004_022",
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我也不想白白浪費任何一分一秒。",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n因為",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "這是只屬於我們兩個人的時光啊。",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n能像這樣一起來看聖誕節燈飾。",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "哥哥與",
    "voice": "vo_adv_1193004_023",
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "妹妹！",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "就只有我們兩個人！",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "在這般情境下，",
    "voice": "vo_adv_1193004_024",
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "有誰還能耐住性子啊。",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n再說，",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "金幣似箭，",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "得好好善用時間才行！",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "哥哥也覺得很開心吧？",
    "voice": "vo_adv_1193004_025",
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n呵呵呵，",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "你是逃不過妹妹我這雙眼睛的。",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "還請老實地承認吧？",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "你也覺得很開心？",
    "voice": "vo_adv_1193004_026",
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "……太好了！",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我從以前就一直很想來看",
    "voice": "vo_adv_1193004_027",
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "這場燈飾。",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n啊，",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "呃……",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "當然是想和哥哥兩個人",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "一起來看！",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "不過，",
    "voice": "vo_adv_1193004_028",
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "因為忙著念書，",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n那個，",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "雖然有點不好開口說……",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "但我今年可是",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "卯足了幹勁在準備呢。",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "所以，",
    "voice": "vo_adv_1193004_029",
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我很高興",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "哥哥能夠陪我一起來。",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n這簡直就像在做夢一樣，",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "嘿嘿……",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我好像說得有點太誇張了吧？",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "據說這場燈飾",
    "voice": "vo_adv_1193004_030",
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "是以星座為主題。",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n如果仔細找找，",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "似乎可以發現有許多星座隱藏在其中。",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "像這樣往上看，",
    "voice": "vo_adv_1193004_031",
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "就好像在觀看天象儀。",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n這裡是",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "小熊座，",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "那裡是",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "天鵝座……",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n而那個是，",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "南十字星……？",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "原來如此，",
    "voice": "vo_adv_1193004_032",
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "不管季節或",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "緯度，",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n實際上在這裡不可能看到的星座也",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "被鑲嵌在裡頭呢。",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "啊，",
    "voice": "vo_adv_1193004_033",
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "在燈飾的另一側，",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "也可以看到星星喔……",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n想不到連真正的星空也看得到，",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "真是奢侈的享受！",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "…………",
    "voice": "vo_adv_1193004_034",
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "那個……",
    "voice": "vo_adv_1193004_035",
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "哥哥。",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n你會不會覺得",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "有點冷啊？",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "現在是冬天",
    "voice": "vo_adv_1193004_036",
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "的夜晚，",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我們又待在戶外。",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "肯定會覺得冷，",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "對吧？",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "still",
    "still_id": "119300402"
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "所以為了哥哥……",
    "voice": "vo_adv_1193004_037",
