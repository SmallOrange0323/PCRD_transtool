    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "禮物喔！",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我原本是想編織一對同款圍巾，",
    "voice": "vo_adv_1193004_038",
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n不過後來想說機會難得，",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我們一起圍一條圍巾也很讚！",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "連我自己也覺得這是個好主意，",
    "voice": "vo_adv_1193004_039",
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "你覺得呢？",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n這樣暖和嗎？",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "聽到哥哥這麼說，",
    "voice": "vo_adv_1193004_040",
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我就放心了。",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我也",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "覺得很暖和。",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "感受得到哥哥的體溫……",
