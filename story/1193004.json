    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "沒關係，沒關係！",
    "voice": "vo_adv_1193004_041",
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n因為，",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我們可以像這樣兩個人一起出來，",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n對我來說就是最棒的聖誕禮物了。",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我會好好褒獎你的。",
    "voice": "vo_adv_1193004_042",
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "開玩笑的啦，",
