    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n今後的樂趣，",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "當然是越多越好！",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "希望今後",
    "voice": "vo_adv_1193004_048",
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "與哥哥之間的情感可以變得更好，",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n身為妹妹的我，",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "呃不，",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "就算不是這樣也沒關係。",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我想繼續一起過",
    "voice": "vo_adv_1193004_049",
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "美好的聖誕節……！　",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我們明年也",
    "voice": "vo_adv_1193004_050",
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "一起過",
    "voice": null,
    "unit_id": 101131
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "聖誕節吧，",
