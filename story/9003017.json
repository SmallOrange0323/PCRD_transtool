[
  {
    "type": "background",
    "bg_id": "500361"
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "４周年を迎えた当日。\\nペコリーヌたちに呼び出された{0}──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "{0}くん、",
    "voice": "vo_adv_9003017_000",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "お待たせしましたっ！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\nそれじゃあ、",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "いきますよ？　",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "せーのっ！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "みんな",
    "words": "４周年、",
    "voice": "vo_adv_9003017_001",
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "みんな",
    "words": "おめでとうございまーすっ！！",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "おや、",
    "voice": "vo_adv_9003017_002",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主さまがポカンとされておりますが……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "ちょっとペコリーヌ、",
    "voice": "vo_adv_9003017_003",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "あんたちゃんと説明したの？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n今日、",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "４周年の記念パーティーっをやるってこと。",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "この反応だと……",
    "voice": "vo_adv_9003017_004",
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "まだだったみたいね。",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "ああ～、",
    "voice": "vo_adv_9003017_005",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "あはは……",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "ごめんなさい。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\nギリギリまで作業していたので、",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "つい。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "カリン",
    "words": "それでは、",
    "voice": "vo_adv_9003017_006",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "カリン",
    "words": "私からご説明しますね。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "げっ。",
    "voice": "vo_adv_9003017_007",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "あんた、",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "どこからともなく出てくるのやめなさいよ！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "カリン",
    "words": "今回、",
    "voice": "vo_adv_9003017_008",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "カリン",
    "words": "あなたに各地を巡って集めてもらった封筒には\\n活動記録のほかにもう一つ、",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "カリン",
    "words": "大事な物が入っていたんです。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "カリン",
    "words": "\\n今日の４周年のお祝いに合わせた、",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "カリン",
    "words": "特別なプレゼントを作るための。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "ヒヨリ",
    "words": "実はね、",
    "voice": "vo_adv_9003017_009",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "ヒヨリ",
    "words": "騎士くんが訪問した先のみんなに\\n協力してもらって、",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "ヒヨリ",
    "words": "お気に入りの写真を入れてもらってたんだ！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "というよりも、",
    "voice": "vo_adv_9003017_010",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "そちらが本命だったと言えばいいのかな。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "\\n各地を巡ってもらったのも、",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "レイ",
    "words": "そのためだったというわけさ。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "ユイ",
    "words": "秘密にしててごめんね、",
    "voice": "vo_adv_9003017_011",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "ユイ",
    "words": "騎士クン。",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "ほらペコリーヌ、",
    "voice": "vo_adv_9003017_012",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "見せてやんなさいよ。",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "はい！",
    "voice": "vo_adv_9003017_013",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\nそれじゃあ、",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "これを……",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "どうぞっ☆",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "えへへ☆　",
    "voice": "vo_adv_9003017_014",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "はい！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\nあなたと過ごした４年間の思い出と、",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\nこれからの未来への想いを込めたカレンダーを作っちゃいました！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "そしたら、",
    "voice": "vo_adv_9003017_015",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "こんなに大ボリュームになっちゃったんですけど。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\nやばいですね☆",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "カリンさまを始め、",
    "voice": "vo_adv_9003017_016",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "各ギルドのみなさまも\\n主さまのためならと、",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "喜んでお手伝いを引き受けてくださいました。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "フェスも生放送もあったし、",
    "voice": "vo_adv_9003017_017",
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "スケジュールに間に合うか心配だったけど……",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "\\nユイさんたちもカレンダー作りを手伝ってくれたの。",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "みんなの想いを込めて作ったから、",
    "voice": "vo_adv_9003017_018",
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "大切にしてくれるとうれしいわ。",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "この１年のことも、",
    "voice": "vo_adv_9003017_019",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "もちろんこれまでの４年間のことも。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\nぜんぶぜんぶ、",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "大切な……",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "忘れられない思い出です。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "もちろん、",
    "voice": "vo_adv_9003017_020",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "これからの１年も、",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "その先の未来も！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\nこれからもあなたと、",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "数えきれないくらいたくさんの思い出を作って\\nずっとずーっと、",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "みんな一緒に楽しく食卓を囲んでいきましょう☆",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "なーんかおしまいっぽい雰囲気出してるけど、",
    "voice": "vo_adv_9003017_021",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\nまだ４周年の記念パーティーがあるんでしょ！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n早くしないと料理が冷めちゃうわよ？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "そうですね！　",
    "voice": "vo_adv_9003017_022",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "料理はおいしく楽しく、",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "ですよね！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\nみんなで笑顔で食べるのが、",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "一番ですから！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "それじゃあ、",
    "voice": "vo_adv_9003017_023",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "みなさん。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "準備はいいですか？",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\nグラスを持っていきますよ～！　",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "せーのっ！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "みんな",
    "words": "４周年、",
    "voice": "vo_adv_9003017_024",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "みんな",
    "words": "ありがとうございます！",
    "voice": null,
    "unit_id": null
  }
]
