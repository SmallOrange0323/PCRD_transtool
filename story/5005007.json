    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "嗚喵……",
    "voice": "vo_adv_5005007_003",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "真的耶……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這個海岸，",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "好久不見了喵。",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n好懷念喵～！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "平安無事地到達真是太好了呢……！",
    "voice": "vo_adv_5005007_004",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "來來，",
    "voice": "vo_adv_5005007_005",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "那麼既然事情告一段落，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n寶藏也拿到了，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "今天就來舉辦解決事件的慶功宴！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "大家都要穿泳衣參加唷！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "太好了！",
    "voice": "vo_adv_5005007_006",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "當然應該有喝到飽吧！",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "優花梨，腦袋裡總是只有喝喵！",
    "voice": "vo_adv_5005007_007",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "也邀請{0}大人",
    "voice": "vo_adv_5005007_008",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "一起參加！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "background",
    "bg_id": "500520"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就這樣，\\n回到現實的【墨丘利財團】和{0}，\\n決定在瑪爾傑海岸慶祝一番。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "那麼，",
    "voice": "vo_adv_5005007_009",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "慶祝事情解決＆獲得寶藏，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "乾杯──！",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "4人",
    "words": "乾杯──！",
    "voice": "vo_adv_5005007_010",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "咕嚕、咕嚕、咕嚕、咕嚕、咕嚕……",
    "voice": "vo_adv_5005007_011",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "噗哈，",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "這一杯真是幸福得讓人受不了～！",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "still",
    "still_id": "500500701"
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "幸福",
    "voice": "vo_adv_5005007_012",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "嗎……",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "雖然我們對島鯨說得很有氣勢，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "不過說真的，放棄那座島的生活也有點可惜呢～",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "自己專用的訓練場、",
    "voice": "vo_adv_5005007_013",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "特別的SPA、",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "按摩……",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n在想睡的時候睡覺，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "在想起床的時候起床……",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "日常生活貓咪們什麼都會幫我做喵。",
    "voice": "vo_adv_5005007_014",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n只要道謝，",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "貓咪們就會很開心喵……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "鬆軟的床、",
    "voice": "vo_adv_5005007_015",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "好吃的飯……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "心境上可說是度假了一個夏天的感覺呢……",
    "voice": "vo_adv_5005007_016",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n今年過了個……",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "很棒的夏天啊！",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "哦～",
    "voice": "vo_adv_5005007_017",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "在我們擔心的時候，",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "竟然遇到了那麼開心的事呢～",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n真是的，",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "好狡猾～",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "即、",
    "voice": "vo_adv_5005007_018",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "即使如此，",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "那也不過是幻覺喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n而且繼續那樣待下去的話也會死嘛！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "不顧危險",
    "voice": "vo_adv_5005007_019",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "跑來救我們的【墨丘利財團】最棒了喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "嗯！",
    "voice": "vo_adv_5005007_020",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "拚了老命呢～",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "妳們兩個不見之後，",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n剩下的工作該怎麼辦才好，",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "珠希在其它店簽帳的錢還了沒有，",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n這些都讓我擔心得坐立不安呢～",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "是啊是啊，",
    "voice": "vo_adv_5005007_021",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我們只要少了誰的話，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n其它人就必須工作到",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "徹夜難眠的程度呢！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "欸……？",
    "voice": "vo_adv_5005007_022",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我們不在之後晚上都睡不著，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n原來是這個意思……？",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "然後，",
    "voice": "vo_adv_5005007_023",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "為了救出妳們兩位所花費的\\n這次的費用，",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "在這裡～♪",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n請看！",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "帳單！",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "欸！？",
    "voice": "vo_adv_5005007_024",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "個、十、百、千……",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "三千萬盧幣！？",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "妳、",
    "voice": "vo_adv_5005007_025",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "妳們不是也獲得寶藏了嗎喵！？",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "不不，",
    "voice": "vo_adv_5005007_026",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "就算賣了從島鯨身上獲得的貓幣，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n也完全不夠付呢。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n可不能小看",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "飛空艇的燃料費和",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "船的租金喔。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "等等……",
    "voice": "vo_adv_5005007_027",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這是，開玩笑的吧！？",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "不，",
    "voice": "vo_adv_5005007_028",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "是真的唷～",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n為了收回這些錢",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "妳們兩位要給我好～",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "好地工作唷～！",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "沒、沒人性！",
    "voice": "vo_adv_5005007_029",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "冷血的傢伙！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "最差勁了喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "如、",
    "voice": "vo_adv_5005007_030",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "如果是這樣的話，",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "果然應該待在島上就好了喵──！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "果然我，",
    "voice": "vo_adv_5005007_031",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "最討厭奢侈什麼的啦──！",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "不會讓妳們逃走喔！",
    "voice": "vo_adv_5005007_032",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我會讓妳們扎扎實實地工作──！",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "等等",
    "voice": "vo_adv_5005007_033",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我再去叫醒島鯨一下喵──！",
    "voice": null,
    "unit_id": 107911
  },
  {
