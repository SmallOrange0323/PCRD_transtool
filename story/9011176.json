  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "真可惜。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "貪吃佩可小姐。",
    "voice": "vo_adv_9011176_002",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n如果真的",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "把那雕像拿來裝飾的話，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n應該就不會有人想要拜訪【美食殿堂】了吧。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "怎麼看都像是壞蛋的集團呢……",
