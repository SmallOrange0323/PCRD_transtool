[
  {
    "type": "background",
    "bg_id": "500140"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在離萬聖節樂園有點距離的郊外，\\n{0}正陪著怜一起進行特訓。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "喝！",
    "voice": "vo_adv_1140001_000",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "喝啊啊啊！",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "background",
    "bg_id": "500140"
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "呼……",
    "voice": "vo_adv_1140001_001",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "目前就先這樣，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n暫時休息一下吧。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "抱歉，",
    "voice": "vo_adv_1140001_002",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "還讓你來陪我。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你看我服裝和裝備都換新的了對吧？",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "所以我想盡快先讓身體適應。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "畢竟",
    "voice": "vo_adv_1140001_003",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我總不能在忙著準備慶典而人來人往的大街上，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n揮舞自己還用不習慣的劍啊。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不過",
    "voice": "vo_adv_1140001_004",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你的身手也變好了呢。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我有好幾次都認真使出攻擊，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "結果都被你漂亮地化解掉了。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……你說",
    "voice": "vo_adv_1140001_005",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "難怪會覺得手特別酸麻？",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "因為我認為現在的你不會有問題。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n這就表示你身手有顯著提升呢。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "話說回來，",
    "voice": "vo_adv_1140001_006",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這風真舒服……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "說起來，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "萬聖節慶典好像馬上就要開始了？",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "慶典嗎？",
    "voice": "vo_adv_1140001_007",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "還很難說……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我也不是沒有興趣……",
    "voice": "vo_adv_1140001_008",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "但我每天都要鍛鍊，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "而且一個人去逛也有點怪。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "好了，",
    "voice": "vo_adv_1140001_009",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "先不說這些，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "等再休息一下後，就繼續開始特訓──",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "呀、",
    "voice": "vo_adv_1140001_010",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "呀啊啊！？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n誰來、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "救救我啊～～～～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "悲鳴……！？",
    "voice": "vo_adv_1140001_011",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是從那裡傳來的嗎！？",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "{0}，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我們趕緊過去！！",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "background",
    "bg_id": "500170"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "唔哇啊啊啊！！",
    "voice": "vo_adv_1140001_012",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "載貨馬車被襲擊了……！",
    "voice": "vo_adv_1140001_013",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "先擊退魔物吧！",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "喝啊啊啊啊！",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "background",
    "bg_id": "500170"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "解決掉了啊……",
    "voice": "vo_adv_1140001_014",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "你、",
    "voice": "vo_adv_1140001_015",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "你們是……？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "沒有錯。",
    "voice": "vo_adv_1140001_016",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "先別管那個，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你有沒有受傷？",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "啊、",
    "voice": "vo_adv_1140001_017",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "嗯，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我沒什麼事，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "不用擔心。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "只是，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "因為被魔物襲擊的關係，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我的貨物……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……雖然擊退剛才的魔物了，",
    "voice": "vo_adv_1140001_018",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n但很難說不會有其他的魔物被剛才的騷動吸引過來。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "若是可以，",
    "voice": "vo_adv_1140001_019",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "最好盡早離開這個地方。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "好了，快點走吧，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你也來幫忙。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "background",
    "bg_id": "501130"
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "真不好意思，",
    "voice": "vo_adv_1140001_020",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "還讓你們特地送我。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我真的很希望能給小姑娘你們謝禮……",
    "voice": "vo_adv_1140001_021",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "但很抱歉，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "情況就如你們所見。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這些貨物……",
    "voice": "vo_adv_1140001_022",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是攤販的建材嗎？",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "但是，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "看這個樣子……",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "是啊……",
    "voice": "vo_adv_1140001_023",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我確認過東西的情況了，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n但因為被魔物襲擊的關係，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "要在萬聖節出攤的",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n攤位骨架和台面都嚴重毀損了。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "就算準備好商品了，",
    "voice": "vo_adv_1140001_024",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "但若沒有最重要的攤位的話……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "不過在這個萬聖節即將到來的時期，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "就算去訂製新的攤位",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n也大概趕不上吧。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "這樣子可做不了生意啊……",
    "voice": "vo_adv_1140001_025",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "但有保住性命才最重要。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n只好安慰自己",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "能平安無事就算好了……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "的確，",
    "voice": "vo_adv_1140001_026",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "只要能調齊攤販用的木材，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n剩下的就總會有辦法解決……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "但我總不能讓你幫我到這個程度……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……以防萬一我先問清楚，",
    "voice": "vo_adv_1140001_027",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n你應該不會說，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "要自己一個人去收集建材吧？",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "果然……",
    "voice": "vo_adv_1140001_028",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我就知道你會那麼說。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "但要去的不是一個人，",
    "voice": "vo_adv_1140001_029",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "而是二個人。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我也和你同行，",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "畢竟人手還是越多越好。",
    "voice": null,
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就是這麼回事……",
    "voice": "vo_adv_1140001_030",
    "unit_id": 114011
  },
  {
    "type": "dialogue",
    "name": "怜",
