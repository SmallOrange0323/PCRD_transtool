[
  {
    "type": "background",
    "bg_id": "500240"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "此時，與流夏和七七香分別的{0}，\\n與杏奈一同抵達了洞窟。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "呼～",
    "voice": "vo_adv_5008002_000",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "沒想到才剛到達就準備了食物給我們吃，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n真是太棒的職場了！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "工作的幹勁都湧上來了！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "而且工作內容，",
    "voice": "vo_adv_5008002_001",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "還只要在洞窟裡挖掘，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n這樣簡單的工作――",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "啊啊啊呀，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "抱歉。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "通緝犯",
    "words": "哦，",
    "voice": "vo_adv_5008002_002",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "通緝犯",
    "words": "小心點――",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "這男人感覺真壯碩呢……",
    "voice": "vo_adv_5008002_003",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "嗯？",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n剛才的人，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "好像在哪見過……？",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "吉格魯特，",
    "voice": "vo_adv_5008002_004",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "你對那男人的臉有印象嗎？",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "總覺得",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我的宇宙本源很在意那個人啊。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "通緝犯？　",
    "voice": "vo_adv_5008002_005",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "對啊",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "通緝令！　",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "難怪我會覺得似曾相識！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "你記憶力真好呢，吉格魯特！　",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "幫大忙了！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "你、",
    "voice": "vo_adv_5008002_006",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "你說什麼～！？",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "欸？",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "你不是失去記憶嗎，吉格魯特！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "不對，",
    "voice": "vo_adv_5008002_007",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "不是在說這個！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我記得那傢伙……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "對啦，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "是通緝犯！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "站住，你這傢伙！　",
    "voice": "vo_adv_5008002_008",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "你就是被通緝中的通緝犯吧！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "通緝犯",
    "words": "這麼說來，妳……",
    "voice": "vo_adv_5008002_009",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "通緝犯",
    "words": "不就是移動龍卷風嗎？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "通緝犯",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "通緝犯",
    "words": "怎麼，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "通緝犯",
    "words": "想在這裡打嗎？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "你明白的話就好辦了。",
    "voice": "vo_adv_5008002_010",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "你就懾服於我強大的力量下，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n化為饗宴的祭品吧！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "現場監督",
    "words": "那邊那兩人！　",
    "voice": "vo_adv_5008002_011",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場監督",
    "words": "你們在做什麼！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場監督",
    "words": "\\n這裡禁止私鬥！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "通緝犯可就在眼前啊？　",
    "voice": "vo_adv_5008002_012",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "而且觸犯禁忌就是我的――",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "現場監督",
    "words": "如果這麼做，會拿不到薪水喔！",
    "voice": "vo_adv_5008002_013",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "現場監督",
    "words": "\\n那樣也沒關係嗎！？",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "那、",
    "voice": "vo_adv_5008002_014",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "那樣就傷腦筋了……！　",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我好不容易才到這裡來的，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n怎麼能沒拿到打工錢就默默回去……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "不對，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "果然還是應該無視規定，打倒眼前這傢伙才對……？",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "通緝犯",
    "words": "撿回一條命了。",
    "voice": "vo_adv_5008002_015",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "通緝犯",
    "words": "再會啦！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "啊，",
    "voice": "vo_adv_5008002_016",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "你……！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "可惡，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "難得獎金自己送上門了！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "沒辦法了……",
    "voice": "vo_adv_5008002_017",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "專注在工作上吧。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "呼……",
    "voice": "vo_adv_5008002_018",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "呼。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "工作是很單純，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n可是要像這樣持續不斷挖洞，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "還真難熬……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "吉格魯特，",
    "voice": "vo_adv_5008002_019",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "你那裡如何？",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "那是因為你一直在搬運我挖掘的土石啊。",
    "voice": "vo_adv_5008002_020",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "會累也是當然的……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "謝謝你這麼努力，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "吉格魯特。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "這麼說來，",
    "voice": "vo_adv_5008002_021",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我沒問過什麼時候休息呢。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n就在這裡刻下休息之時吧。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "哈啊，",
    "voice": "vo_adv_5008002_022",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "哈啊，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "哈啊……！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "你怎麼了，吉格魯特？",
    "voice": "vo_adv_5008002_023",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "怎麼突然變得這麼喘。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "你有這麼累了嗎？",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "奇怪，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "喘的人不是吉格魯特。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "是誰啊……？",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "是這個男人啊……！",
    "voice": "vo_adv_5008002_024",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "喂，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "怎麼了？　",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "振作點啊！！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "因為一直沒有休息，",
    "voice": "vo_adv_5008002_025",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "所以頭暈了而已……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "謝謝。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "我沒見過",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "你們呢……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我們是今天才來的。",
    "voice": "vo_adv_5008002_026",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "今後請多指教。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "妳說今天才來的……！？",
    "voice": "vo_adv_5008002_027",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
