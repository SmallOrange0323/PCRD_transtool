  {
    "type": "dialogue",
    "name": "旁白",
    "words": "吉歐‧格黑納某處。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n撈金魚的攤販前。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "啊啊……",
    "voice": "vo_adv_9009002_000",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n往那邊逃了。",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "普蕾西亞！",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "捕撈工具……",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "呃，",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "快拿起撈魚網準備……！",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "嗯。",
    "voice": "vo_adv_9009002_001",
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n準備、",
    "voice": null,
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "捕撈。",
    "voice": null,
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "金魚？",
    "words": "嘰嘎嘎嘎嘎嘎嘎嘎嘎！！",
    "voice": "vo_adv_9009002_002",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "就差一點了，",
    "voice": "vo_adv_9009002_003",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "普蕾西亞♪",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n加油！",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "金魚？",
    "words": "嘰嘎嘎嘎嘎嘎嘎嘎嘎！！",
    "voice": "vo_adv_9009002_004",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "金魚。",
    "voice": "vo_adv_9009002_005",
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n撈到了。",
    "voice": null,
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "裸露的鋸齒狀牙齒、",
    "voice": "vo_adv_9009002_006",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "多隻眼睛、",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "像鰭一樣的手腳……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n宛如從地獄深處",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "傳來的死亡叫喚。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "雖然身體的確是金色的……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "但這個",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "真的是金魚嗎？",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "我也不清楚，",
    "voice": "vo_adv_9009002_007",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "不過……",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n店長說",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "這個是金魚。",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n我想",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "應該就是金魚了吧。",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "雖然",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "看起來很難飼養……",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "嗯。",
    "voice": "vo_adv_9009002_008",
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n接下來，",
    "voice": null,
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "試味道。",
    "voice": null,
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "是、",
    "voice": "vo_adv_9009002_009",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "是呀。",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n只要味道好的話……",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "味道……",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "味道！？",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "烤到。",
    "voice": "vo_adv_9009002_010",
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n五分熟。",
    "voice": null,
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n喔。",
    "voice": null,
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "那個，",
    "voice": "vo_adv_9009002_011",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "普蕾西亞，",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "請等一下……！",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n那條魚",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "怎麼看都不像是適合食用的樣子……！！",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n至少先準備好腸胃藥再來……",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "好啦好啦，",
    "voice": "vo_adv_9009002_012",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "莉莉。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n不是有些食物長得不怎麼樣，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "但卻很好吃嗎♪",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n肯定沒有問題的。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "對吧，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "普蕾西亞。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "嗯。",
    "voice": "vo_adv_9009002_013",
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "我咬……",
    "voice": null,
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "可璃亞、莉莉",
    "words": "…………",
    "voice": "vo_adv_9009002_014",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "…………",
    "voice": "vo_adv_9009002_015",
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "非常刺激的，",
    "voice": "vo_adv_9009002_016",
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n美味。",
    "voice": null,
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "妖魔人店主",
    "words": "哈哈哈，",
    "voice": "vo_adv_9009002_017",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "妖魔人店主",
    "words": "那就好！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "妖魔人店主",
    "words": "\\n居然當場吃掉捕撈上來的獵物，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "妖魔人店主",
    "words": "很適合吉歐‧格黑納嘛！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "妖魔人店主",
    "words": "\\n如果是這樣的活動，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "妖魔人店主",
    "words": "我想大家每年都會很樂意來遊玩的！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "……就這樣，由於莉莉等人的關係，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n使得錯誤的撈金魚文化在吉歐‧格黑納流傳開來了。",
    "voice": null,
    "unit_id": null
  }
]
