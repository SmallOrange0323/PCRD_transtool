[
  {
    "type": "background",
    "bg_id": "500020"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}正悠閒地在蘭德索爾散步。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "{0}！",
    "voice": "vo_adv_1031006_000",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我、我找了你好久……大事不好了……",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "世界會在今天毀滅。",
    "voice": "vo_adv_1031006_001",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "今天早上我父親的占卜出現了這個結果。",
    "voice": "vo_adv_1031006_002",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n說今天世界會毀滅……",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我父親是傑出的靈媒，占卜的準確度很高。",
    "voice": "vo_adv_1031006_003",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "沒有錯吧，爸爸？",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "嗯嗯……我以占星術為重點，分析宇宙本源的波動，",
    "voice": "vo_adv_1031006_004",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n然後根據因果輪迴即業報的一貫法則，",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n世界即將回歸靈魂搖籃的根源也就不證自明了……",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "總之，就是世界會在今天毀滅。",
    "voice": "vo_adv_1031006_005",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "今天是世界末日呀……",
    "voice": "vo_adv_1031006_006",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n忍，小伙子，謝謝你們一路相伴啊。",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "爸爸……",
    "voice": "vo_adv_1031006_007",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我才謝謝你把我養育到這麼大。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "唉……最後真想和可愛女孩開心地說說話……",
    "voice": "vo_adv_1031006_008",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n忍、小伙子，聽我最後一個請求吧。",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n你們幫忙一下，讓我可以和女孩子打情罵俏吧！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "比起那種事，",
    "voice": "vo_adv_1031006_009",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n{0}最好也去做想做的事情喔。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n因為今天是世界末日了。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "忍、忍？",
    "voice": "vo_adv_1031006_010",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n不是呀，那可是我最後的請求耶……",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這麼說起來也是呢。就算突然聽到這種事……",
    "voice": "vo_adv_1031006_011",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n應該有很多想在最後一天做的事情吧。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "咦，沒有？真的嗎？",
    "voice": "vo_adv_1031006_012",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這樣呀……不過，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n或許這樣比較像{0}的風格呢。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "你說我想做的事情……嗎？",
    "voice": "vo_adv_1031006_013",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "沒有，我也沒有什麼特別想做的事情……",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "那就實現我最後的願望吧！",
    "voice": "vo_adv_1031006_014",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n我想和身材正點的妙齡女孩做那些事情和這些事情……！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "你、",
    "voice": "vo_adv_1031006_015",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "你肚子餓了嗎？",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這麼說起來我也是……",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那我們先去吃飯吧。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n吃完飯再來想要做什麼事情。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "因為是最後的午餐了，我們去大飽口福吧。",
    "voice": "vo_adv_1031006_016",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "忍、忍────！",
    "voice": "vo_adv_1031006_017",
    "unit_id": 2411
  },
  {
    "type": "background",
    "bg_id": "500050"
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我吃飽了。",
    "voice": "vo_adv_1031006_018",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "真的很好吃呢。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "呵呵，雖然狠下心點了有點貴的餐點，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n但今天是世界末日了，所以無所謂的。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "……因為吃飽了，所以想休息一下？",
    "voice": "vo_adv_1031006_019",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那我們去平原吧。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "忍！別管他了，聽聽我的願望────！！",
    "voice": "vo_adv_1031006_020",
    "unit_id": 2411
  },
  {
    "type": "background",
    "bg_id": "500130"
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "有涼爽的微風，真的很舒服呢。",
    "voice": "vo_adv_1031006_021",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n感覺好像來野餐一樣。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我沒有野餐過……",
    "voice": "vo_adv_1031006_022",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "所以感覺很新鮮，很開心。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "background",
    "bg_id": "500131"
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "……你醒來了嗎？\\n{0}你，剛剛睡著了唷。",
    "voice": "vo_adv_1031006_023",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "啊，怎麼會躺在我腿上嗎？不好意思，是我擅自這麼做的。",
    "voice": "vo_adv_1031006_024",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "因為我覺得你躺在我腿上應該比躺在平原上好睡……",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n這樣做……不好嗎？",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "太好了。",
    "voice": "vo_adv_1031006_025",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n{0}的睡臉很可愛呢。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "呵呵呵。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "太陽要下山了，今天一天也快結束了呢。",
    "voice": "vo_adv_1031006_026",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那個，趁這個難得的機會，要不要欣賞一下美麗的星空呢？",
    "voice": "vo_adv_1031006_027",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n這是世界末日的夜晚，比起喧鬧的城鎮，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "待在安靜的地方，心情感覺比較平靜……",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "background",
    "bg_id": "500212"
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "哇──星星好漂亮喔。",
    "voice": "vo_adv_1031006_028",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那我們就在這裡眺望星空，等待世界毀滅吧。",
    "voice": "vo_adv_1031006_029",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "今天，那個……好像約會一樣呢。",
    "voice": "vo_adv_1031006_030",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n我很開心喔。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "呵呵呵，世界末日也不全然是壞事呢。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不……不只是今天。",
    "voice": "vo_adv_1031006_031",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "認識{0}之後，",
    "voice": "vo_adv_1031006_032",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "每天都很快樂。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n最後的夜晚",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "可以和你一起度過……",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我很開心。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "{0}……",
    "voice": "vo_adv_1031006_033",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n最後一天和我在一起，過得開心嗎？",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "……謝、謝謝。",
    "voice": "vo_adv_1031006_034",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "能聽你那樣說……我很高興。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不管世界末日何時到來都不要緊了，",
    "voice": "vo_adv_1031006_035",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我現在……",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "就是這麼幸福。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "background",
    "bg_id": "500210"
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "……啊，天亮了呢。",
    "voice": "vo_adv_1031006_036",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "爸爸，你不是說世界會在昨天毀滅的嗎？",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n因為宇宙本源所以因果會回到靈魂搖籃根源之類的……？",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "……那、那是騙人的。",
    "voice": "vo_adv_1031006_037",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "咦，",
    "voice": "vo_adv_1031006_038",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "騙人的！？到底怎麼回事！？",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "我以為如果是世界末日，忍和小伙子，",
    "voice": "vo_adv_1031006_039",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n都會幫忙實現我的願望。所以不小心就……",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n可是你們兩個人完全不理我說的話……",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "什麼不小心呀，爸爸！",
    "voice": "vo_adv_1031006_040",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n你不惜撒謊，就是為了想和女孩子打情罵俏嗎？",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "撒謊也該知道分寸的！",
    "voice": "vo_adv_1031006_041",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n你害我拉著{0}，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
