  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在薇歐莉特暗殺未遂事件過後不久，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}再度拜訪了黎薩。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "……！",
    "voice": "vo_adv_1404004_000",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n…………這樣啊……",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "現實的",
    "voice": "vo_adv_1404004_001",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "我的身體……",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n雖然我有說，",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "希望先行登出的他能去尋找，",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n但沒想到竟然真的會找到。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "…………",
    "voice": "vo_adv_1404004_002",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n真的",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "存在呢……",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n雖然就像「箱子裡的貓」一樣，",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "不確定是什麼狀態就是了。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "……所以，",
    "voice": "vo_adv_1404004_003",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "我的身體在哪裡？",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "如果是不太偏僻的地方之類的就好了。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "background",
    "bg_id": "510070"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "登出到現實世界的{0}，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n為了尋找黎薩的肉體而奔走。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "線索是黎薩說從芙蕾雅那裡聽來的資訊，還有",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n模索路晶送來的",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "幾個候補座標。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n可是……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "510470"
  },
  {
    "type": "background",
    "bg_id": "510450"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "到手的資訊裡，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "國內全軍覆沒。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n之後也去了幾個地方搜索……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "510500"
  },
  {
    "type": "background",
    "bg_id": "500180"
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "……某座無人島的",
    "voice": "vo_adv_1404004_004",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "荒涼研究室。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "我的肉體",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "竟然在那種地方呢。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "background",
    "bg_id": "502680"
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "雖然和我有著完全不同的「血脈」、",
    "voice": "vo_adv_1404004_005",
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "不同的目的，",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "甚至是出生於不同的國家。",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n但妳也是",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "藉由基因操作",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "所創造出來的存在喔。",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n黎薩。",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "恐怕，",
    "voice": "vo_adv_1404004_006",
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n是將幾位優秀人類的基因組合後所製造出來的複製人……",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n大概是這樣吧。",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "background",
    "bg_id": "500180"
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "意思是芙蕾雅所說的事",
    "voice": "vo_adv_1404004_007",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n果然是真的",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "嗎？",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "不實際去看看也不會知道就是了……",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "只要離開這個世界、",
    "voice": "vo_adv_1404004_008",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "登出的話……",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "就能夠確認真相了。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n我其實是什麼人，",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "以及為什麼我會生存在這個世界……",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "……我的內在和外在，",
    "voice": "vo_adv_1404004_009",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "為什麼會如此不和諧呢？",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "…………",
    "voice": "vo_adv_1404004_010",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "……要是說不害怕就是騙人的了。",
    "voice": "vo_adv_1404004_011",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "畢竟那是其他三大世界以外的未知地方，",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n生活型態一定也完全不同吧？",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "不過，",
    "voice": "vo_adv_1404004_012",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "反正我也沒有其他要去的地方……",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "我也",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "不可能永遠",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n死守著這個世界。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "所以──",
    "voice": "vo_adv_1404004_013",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "我要去。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n去「現實世界」這個地方……",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "「現實世界」……",
    "voice": "vo_adv_1404004_014",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n這個世界的起源之地。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n究竟",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "是怎麼樣的地方呢……",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "──離開",
    "voice": "vo_adv_1404004_015",
    "unit_id": 140412
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "阿斯特朗。",
    "voice": null,
    "unit_id": 140412
  },
  {
    "type": "background",
    "bg_id": "510440"
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "…………",
    "voice": "vo_adv_1404004_016",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "這裡",
    "voice": "vo_adv_1404004_017",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "就是這個世界的「研究所」……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n修剪整齊的草木、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "玻璃，還有……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "這是",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "鐵？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n是無機物",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "且冰冷……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "果然",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "跟四世界的任何一個都不同……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "而且",
    "voice": "vo_adv_1404004_018",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "這個身體",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n是因為一直沉睡著嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "非常容易疲勞……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "……呼…………",
    "voice": "vo_adv_1404004_019",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "不用在意我。",
    "voice": "vo_adv_1404004_020",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n比起這個，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "我想快點看看外面的世界。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "因為我……",
    "voice": "vo_adv_1404004_021",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n還沒",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "對這個狀況感到「無聊」。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "……或許，",
    "voice": "vo_adv_1404004_022",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "我也有可能改變啊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n我這份[rub:・]衝[/rub][rub:・]動[/rub]，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "終於──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "510500"
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "………………",
    "voice": "vo_adv_1404004_023",
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "140400401"
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "…………",
    "voice": "vo_adv_1404004_024",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n…………這樣啊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "這裡……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "啊啊，",
    "voice": "vo_adv_1404004_025",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "這裡就是……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "「遊戲」外的",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "「現實世界」。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n風很舒服，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "有海潮的氣味……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n顏色鮮豔，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "好眩目……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "我曾在抱持興趣的同時，",
    "voice": "vo_adv_1404004_026",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "也感到恐懼的地方。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n竟然這麼──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "140400402"
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "──這麼",
    "voice": "vo_adv_1404004_027",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "索然無味。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "我感覺到內心深處的興奮",
    "voice": "vo_adv_1404004_028",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "正在迅速消退。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n有部分的自己不禁覺得「也不過如此啊」。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "明明能見到未知的世界，",
    "voice": "vo_adv_1404004_029",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "應該是難得一遇的事才對──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n但就連這個，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "到手的瞬間也會褪色。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "……真的是",
    "voice": "vo_adv_1404004_030",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "無可救藥呢，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n我……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "「……看來",
    "voice": "vo_adv_1404004_031",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "妳順利在這裡找到肉體了呢。」",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "still",
    "still_id": "140400401"
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "這個聲音……",
    "voice": "vo_adv_1404004_032",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "霸瞳皇帝？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n為什麼──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "「妳在驚訝什麼？",
    "voice": "vo_adv_1404004_033",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n妳該不會以為，",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "來到這裡之前的情報，都是晶一個人收集的吧？",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n還是說，",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "妳什麼都沒聽她說？」",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "「不過，",
    "voice": "vo_adv_1404004_034",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "這些精準度糟透了的資訊，",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n我確實不希望被當成是自己的成果就是了。",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n……看來得教育一下",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "聯合國的調查員們呢。",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "啊啊，真麻煩。」",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "…………",
    "voice": "vo_adv_1404004_035",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n難道說，你",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "從一開始就對我──？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "「自我意識過剩也差不多一點。",
    "voice": "vo_adv_1404004_036",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "我只是有些個人很在意的事，",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "所以才在登出後調查而已喔。」",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "「不過，",
    "voice": "vo_adv_1404004_037",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "最後找到的，",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n也只不過是稍微補充了一些妳早已知道的資訊罷了。",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "因為這間研究所本身，",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "似乎早在很久以前就已經關閉了。」",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "「這裡",
    "voice": "vo_adv_1404004_038",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "是由某位資產家所建造的",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "私人研究所喔。",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n目的只有一個──",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "『將優秀的基因組合起來，",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "創造出更高等的人類』。」",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "「據說那位資產家",
    "voice": "vo_adv_1404004_039",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "觀測到了地球之外的『上位存在』之類的，",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n似乎是想為了迎接他們",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "的到來，而準備好優秀的棋子呢。",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n……不過，",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "他在看到實驗成果之前，",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "好像就已經發瘋死去了。」",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "「而",
    "voice": "vo_adv_1404004_040",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "為了創造那些棋子，",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "作為其中一項實驗進行的，",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n就是『僅在VR中",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "從零開始塑造人格』",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "這樣的內容。」",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "「肉體則使其另外在培養艙中成長，",
    "voice": "vo_adv_1404004_041",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n等人格長成後再進行整合，",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "讓其在現實中甦醒……",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n似乎就是這樣的計畫呢。」",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "……！",
    "voice": "vo_adv_1404004_042",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n難道──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "「妳理解得很快嘛。",
    "voice": "vo_adv_1404004_043",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n沒錯，",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "也就是說──」",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "「黎薩‧費妲，",
    "voice": "vo_adv_1404004_044",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n妳的肉體確實",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "是在『[rub:這邊]現實世界[/rub]』培育的，",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n但妳的故鄉並不是這裡。」",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "「妳精神的故鄉是",
    "voice": "vo_adv_1404004_045",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "VR的世界──",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n也就是說，",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "心靈和肉體，是分別在不同世界生存著的喔。」",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "…………",
    "voice": "vo_adv_1404004_046",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n分別在",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "不同世界……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "140400402"
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "……這樣啊。",
    "voice": "vo_adv_1404004_047",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n說的也是呢……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "雖然這是件令人難以突然相信的事……",
    "voice": "vo_adv_1404004_048",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n但老實說，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "我心中也有某部分覺得合情合理。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "一直以來，我……",
    "voice": "vo_adv_1404004_049",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n明明生活在LoA中，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "卻覺得自己有哪裡格格不入，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n看著現實世界，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "也完全沒有感到懷念。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "……這是當然的吧。",
    "voice": "vo_adv_1404004_050",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "我的[rub:心靈]精神[/rub]與[rub:身體]肉體[/rub]，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "從一開始就是分離的……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n而且兩邊都只存在著我的一半。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "「優等生的我的外在」與",
    "voice": "vo_adv_1404004_051",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "「愚蠢的我的內在」。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n我之中的",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "這種互為相反的特質……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n或許，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "也是因為我的這種出身吧……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "……感謝你告訴我，",
    "voice": "vo_adv_1404004_052",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "霸瞳皇帝。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n我沒想到你會這麼親切就是了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "「說是感謝，",
    "voice": "vo_adv_1404004_053",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "妳的表情倒是相當陰沉呢？",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "不過，",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "這對我來說",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "也算是不錯的試驗，幫大忙了。」",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "「那麼，",
    "voice": "vo_adv_1404004_054",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "我的任務到此結束。",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "妳就儘管煩惱吧。」",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "………………",
    "voice": "vo_adv_1404004_055",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "…………實在是",
    "voice": "vo_adv_1404004_056",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "不能算沒事呢。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n說到底，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "訊息量太大了……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "到頭來，",
    "voice": "vo_adv_1404004_057",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "我的世界",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "──我[rub:・]完[/rub][rub:・]整[/rub][rub:・]的[/rub][rub:・]容[/rub][rub:・]身[/rub][rub:・]之[/rub][rub:・]處[/rub]",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n在哪邊的世界都不存在。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "那",
    "voice": "vo_adv_1404004_058",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "我真正的容身之處在哪裡？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n究竟該去哪，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "才能讓我這個存在安歇呢……？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "……再繼續想也沒用吧。",
    "voice": "vo_adv_1404004_059",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n事到如今，我也不可能回去另一個世界，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n我必須先思考該如何在這邊",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "生活才行。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "你的心意讓我很高興，",
    "voice": "vo_adv_1404004_060",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "但那就不必了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n畢竟",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "你家感覺也有其他女孩子在……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n我也不是那種能一直像這樣被保護的性格。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "況且……",
    "voice": "vo_adv_1404004_061",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "現在我只",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "想整理心情。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n或者，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "要是有什麼能讓我忘我投入的事就……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "140400401"
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "咦？",
    "voice": "vo_adv_1404004_062",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "…………",
    "voice": "vo_adv_1404004_063",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n看看",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "世界……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "140400403"
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "…………也對呢。",
    "voice": "vo_adv_1404004_064",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n反正現在的我",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "既沒有容身之處，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "也沒有什麼特別的目標。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "什麼都不想、",
    "voice": "vo_adv_1404004_065",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "去旅行……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n試著看看這個世界，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "可能也不錯呢。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "510500"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──就這樣，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "第一次見到現實世界那一天的事，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n成了對黎薩而言的一段苦澀回憶。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "然後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "過了一段時間──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "510080"
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "還算有……",
    "voice": "vo_adv_1404004_066",
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "我是很想這麼說啦，",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "但老實說，完全沒有呢……",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n這裡的文明和三大世界差異太大了，",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "我還有太多要學的了。",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "不過，",
    "voice": "vo_adv_1404004_067",
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "倒也不是無法生活。",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n那之後，我也借助了其他人的力量，",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "多少學習了一些這個世界的事……",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "事實上，就連今天，",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "我也是想方設法才來到你家的。",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "在那之後，我有想過了……",
    "voice": "vo_adv_1404004_068",
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "我",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "想要去「狄蜜特聖廟國」這個國家看看。",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "對。",
    "voice": "vo_adv_1404004_069",
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "就是原為貪吃佩可公主的故鄉，",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n並且據說由革命黨建立的",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "那個國家喔。",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "模索路晶小姐……",
    "voice": "vo_adv_1404004_070",
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "在LoA的話，",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "名字是叫拉比林斯達吧？",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "那個人",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "提出願意協助我。",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n接下來我打算和她會合，",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "一起前往那個國家。",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "……不過，",
    "voice": "vo_adv_1404004_071",
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "聽說如今革命已經失去了正當性，",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "當地正陷入混亂。",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n至於能不能見到「那孩子」，",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "我也不太確定……",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "芙蕾雅喔。",
    "voice": "vo_adv_1404004_072",
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n在現實世界中，",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "她曾是革命黨的代表性人物吧？",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "……",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "雖然我失敗了，",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "但她成功了呢……",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "成功推翻了政權。",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "你們",
    "voice": "vo_adv_1404004_073",
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "應該常見到那個帶著「憤怒」的孩子吧，",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "而我姑且算是",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "她的夥伴……",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n所以和她聊過各種事，",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "也有讓她告訴我這邊的事。",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "老實說，",
    "voice": "vo_adv_1404004_074",
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "我對其他人並不感興趣，",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n但我果然還是",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "無法對那孩子置之不理。",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "據說她已經從革命黨中消失，",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "如今下落不明……",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "嗯，",
    "voice": "vo_adv_1404004_075",
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "是啊。",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n……就算因為那場戰鬥消失了，",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "她也有可能已經登出了……",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "就像我一樣呢。",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "總之，",
    "voice": "vo_adv_1404004_076",
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "事情就是這樣，",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "所以今天我是來向你道別的。",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n畢竟給你添了不少麻煩，",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "我想自己姑且有義務向你報告一下。",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "哎呀，",
    "voice": "vo_adv_1404004_077",
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "你會覺得寂寞嗎？",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "……我",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "開玩笑的啦。",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "雖然我還不知道",
    "voice": "vo_adv_1404004_078",
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "這趟旅程的盡頭會有什麼……",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "但我打算",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "暫時以全新的心情重新看待這個世界喔。",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "我不會失蹤的，",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "這點你就放心吧。",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "所以……",
    "voice": "vo_adv_1404004_079",
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "我們之後再見吧。",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n溫柔的",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "爛好人騎士先生。",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "background",
    "bg_id": "510100"
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "……呼……",
    "voice": "vo_adv_1404004_080",
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "……「現實世界」。",
    "voice": "vo_adv_1404004_081",
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n我",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "身體的故鄉。",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n老實說，",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "我還完全不能適應……",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "……在這個世界，",
    "voice": "vo_adv_1404004_082",
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "真的有可能",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n實現我的願望嗎……",
    "voice": null,
    "unit_id": 140431
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "VR與現實，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "黎薩在兩個世界都擁有故鄉。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n這名不斷徬徨尋找答案的少女，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n就此踏入了未知的世界。",
    "voice": null,
