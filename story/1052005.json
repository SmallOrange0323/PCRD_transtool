[
  {
    "type": "background",
    "bg_id": "500170"
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "好，",
    "voice": "vo_adv_1052005_000",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "今天也打起精神採伐木材吧！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "林業林業～哼哼哼♪",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "那些似乎誤認我是魔物的討伐隊員們……",
    "voice": "vo_adv_1052005_001",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "好像因為那個人好好地說明後，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n不再接近這片森林了呢。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不過，要是這片森林裡的魔物搗亂……",
    "voice": "vo_adv_1052005_002",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n就得由我們【伊麗莎白牧場】",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n來負責處理了。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "為了自身的安全，這點責任得自己擔起才行呢。",
    "voice": "vo_adv_1052005_003",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "而且這片森林裡，也沒有那麼危險的魔物在。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "【哞哞自衛隊】也有派\\n小鈴她們來幫忙警備。",
    "voice": "vo_adv_1052005_004",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "就算發生什麼事，也不會有問題呢。",
    "voice": "vo_adv_1052005_005",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n而且到目前為止，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "還非常地平靜♪",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "得好好感謝那個人才行呢。",
    "voice": "vo_adv_1052005_006",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "畢竟那個人如此為我著想，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n費盡辛勞替我說服討伐隊的人們。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "想跟那個人道謝呢～送點禮物好了。",
    "voice": "vo_adv_1052005_007",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "請真陽教我做料理，做做點心之類的。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不過人家笨手笨腳的。",
    "voice": "vo_adv_1052005_008",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n做出好吃的點心，得要特訓一下呢。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不過，\\n該煩",
    "voice": "vo_adv_1052005_009",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "惱的事就只有這點程度，實在是非常幸福呢。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不會有人喊『有魔物～』到處追我，\\n也不",
    "voice": "vo_adv_1052005_010",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "會遇到什麼死劫呢。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "要是這平安無事的日常能持續下去就好了。",
    "voice": "vo_adv_1052005_011",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "就把這個當作目標，",
    "voice": "vo_adv_1052005_012",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n為了不要被【伊麗莎白牧場】趕走……\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "至少自己的生活費，得自己好好賺才行。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "好！\\n我就持續努力採伐，把木材拿去賣吧！",
    "voice": "vo_adv_1052005_013",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "嘿咻、嘿咻～♪",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "慢著。",
    "voice": "vo_adv_1052005_014",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n不好意思，能麻煩妳不要砍倒我嗎？",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "哇",
    "voice": "vo_adv_1052005_015",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "？\\n咦、咦？",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n樹木說話了……！？",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我並不是樹。",
    "voice": "vo_adv_1052005_016",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n……請稍等一下，現在就讓妳看我的真面目。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "妳好。",
    "voice": "vo_adv_1052005_017",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n初次見面。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n總之，請先稱呼我為似似花。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "咦……樹木，變身成女孩子了！",
    "voice": "vo_adv_1052005_018",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "這是什麼？魔法？",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n幻覺？",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "嗯，是類似魔法的東西。",
    "voice": "vo_adv_1052005_019",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n不過，是比平常的魔法還要高等的超自然現象。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "那個……\\n雖然我不太懂，",
    "voice": "vo_adv_1052005_020",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不過那個魔法我也能使用嗎？",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "能不能用那個魔法，變成人類的樣子？",
    "voice": "vo_adv_1052005_021",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "人、人、人家想要變成人類！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "嗯。",
    "voice": "vo_adv_1052005_022",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "非常可惜，這是屬於我的特有能力。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n所以要為他人所用，會很困難吧。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "與我並列為『七冠』的其他人暫且不提……",
    "voice": "vo_adv_1052005_023",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "對於妳來說，應該是不可能的吧。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "這樣啊。\\n",
    "voice": "vo_adv_1052005_024",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "真可惜，不過沒有辦法呢。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "畢竟生來就是這樣，\\n",
    "voice": "vo_adv_1052005_025",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "就算內心再怎麼像人類……",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n也不能奢求像普通的女孩子一樣幸福呢。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……嗯。",
    "voice": "vo_adv_1052005_026",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n我想如果是一時的，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "是有可能動用我的權能讓妳改變外表。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "不過這終究只是暫時的變化，有許多的規矩必須遵守。",
    "voice": "vo_adv_1052005_027",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "咦，真的嗎？",
    "voice": "vo_adv_1052005_028",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n好厲害！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n那麼",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "，可以拜託妳嗎？",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "報酬我會確實給的，不過我寄居在別人家中……",
    "voice": "vo_adv_1052005_029",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "存款不太多，不過我會努力賺的。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我不需要報酬。",
    "voice": "vo_adv_1052005_030",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這個世界的金錢，在現實裡沒有任何的價值。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "不然這樣吧。",
    "voice": "vo_adv_1052005_031",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我想請妳付出一點勞力，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n就當作是幫妳變身的回報吧。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "不，就請妳協助我的實驗吧。",
    "voice": "vo_adv_1052005_032",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n妳似乎是非常稀有的存在……",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n我對妳非常感興趣。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "實驗？\\n好、好像是很不妙的交易呢……",
    "voice": "vo_adv_1052005_033",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "有點可怕呢。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這並非強制的哦。",
    "voice": "vo_adv_1052005_034",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "決定權，在於妳。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "無論是童話故事或是現實裡，引發奇蹟是需要代價的。",
    "voice": "vo_adv_1052005_035",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "要人無償完成自己的要求，不是件很自私的事嗎？",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "說的也是呢……\\n請讓我稍微考慮一下。",
    "voice": "vo_adv_1052005_036",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "能不能告訴我，那個實驗的內容？",
    "voice": "vo_adv_1052005_037",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我會研究內容、謹慎思考後再做出回答。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "妳會一直待在這片森林裡嗎？",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "是的。",
    "voice": "vo_adv_1052005_038",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n正確來說，我待在森林更深處一點的實驗場……",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n基本上生活在廢墟裡頭。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "為了避開人的耳目，我在樹上設置了結界，",
    "voice": "vo_adv_1052005_039",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n要是被砍伐就麻煩了。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "啊，所以妳才會等著打算砍樹的我呢。",
    "voice": "vo_adv_1052005_040",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n我了解了，那麼妳明天也會來這裡吧。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "可以請妳等我嗎，似似花？",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "啊……",
    "voice": "vo_adv_1052005_041",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "要是沒有意外的話，我是不會離開這裡的哦。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "為了預防萬一，先容我說一聲。",
    "voice": "vo_adv_1052005_042",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n請妳暫且不要對任何人說遇見我的事。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "嗯",
    "voice": "vo_adv_1052005_043",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "。\\n感覺",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "妳也有自己的理由呢。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "請不必擔心。\\n不想被不認識的人給發現，這一點我也一樣。",
    "voice": "vo_adv_1052005_044",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我是不會對任何人說關於妳的事的。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我答應妳，似似花。",
    "voice": "vo_adv_1052005_045",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n雖然不太清楚怎麼回事，要是一個人煩惱很難受……",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "就別客氣，找姊姊商量吧♪",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "請不要把我當小孩子。",
    "voice": "vo_adv_1052005_046",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n我的年齡可和外表不同哦？",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "不過，我相信妳哦。",
    "voice": "vo_adv_1052005_047",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "比起人類，動物的的信用是很足夠的。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n我們就一起為不後悔這場相遇而努力吧。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "background",
    "bg_id": "500150"
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我回來了～……\\n",
    "voice": "vo_adv_1052005_048",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "咦！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "又送信來牧場了呢。",
    "voice": "vo_adv_1052005_049",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "嘻嘻，辛苦了～♪",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "嗯。\\n大家都辛苦了呢。",
    "voice": "vo_adv_1052005_050",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "努力工作，還有活下去都很累人♪",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "啊哈哈。\\n是這樣嗎？可能是工作剛結束，所以累了吧？",
    "voice": "vo_adv_1052005_051",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "話說回來，你看得出我的臉色嗎？",
    "voice": "vo_adv_1052005_052",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "人家可和普通人類不同，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n臉色的變化應該很難看出來才對～……？",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "哎呀呀？\\n",
    "voice": "vo_adv_1052005_053",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "怎麼了？",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n為什麼抱過來呢……？",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "因為累了，所以想給軟綿綿的毛皮療癒一下？",
    "voice": "vo_adv_1052005_054",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "真是的，人家可不是什麼健康產品哦～？",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不過沒關係。",
    "voice": "vo_adv_1052005_055",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "真是個好孩子～……♪",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "（唔～……對這個人來說，",
    "voice": "vo_adv_1052005_056",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我大概只是『奇怪的動物』吧。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n人類女孩子不可能這麼隨便給別人抱呢。）",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "（果然……\\n這樣，感覺有點寂寞呢。）",
    "voice": "vo_adv_1052005_057",
    "unit_id": 105211
  }
]
