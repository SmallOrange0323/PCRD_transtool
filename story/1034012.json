[
  {
    "type": "background",
    "bg_id": "500070"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}被人叫出去，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n而來到了【墨丘利財團】的公會小屋。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這麼突然把你找來，",
    "voice": "vo_adv_1034012_000",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "真是抱歉呢。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "那個……",
    "voice": "vo_adv_1034012_001",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "是有關於優花梨的事情。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "她正在禁酒？　",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "的事情你知道吧。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "啊――！　",
    "voice": "vo_adv_1034012_002",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "這裡的計算又錯了！",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n這不是又要從頭開始算了嗎！　",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "好樣的，",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我就做給你看！",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "她自從不喝麥酒以後，",
    "voice": "vo_adv_1034012_003",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n出現了許多的轉變……",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "真是的，",
    "voice": "vo_adv_1034012_004",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "所以我就說申請書要早點送來了啊！",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n為什麼每次都要拖到最後一刻才送來啊～！？",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "就是【墨丘利財團】的業務，",
    "voice": "vo_adv_1034012_005",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "那個……",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n我是很不想這麼說，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "但是工作……",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "進展得非常順利。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "創立新事業？",
    "voice": "vo_adv_1034012_006",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n這個試算是怎麼回事，",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "不會想得太美好了嗎！？",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "好啊，",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我現在就直接去",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "找他談談！",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "……優花梨她",
    "voice": "vo_adv_1034012_007",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n任何工作都會接手完成。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "嗯。",
    "voice": "vo_adv_1034012_008",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我十分清楚自己說了奇怪的話。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "但是，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "世界上",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "有所謂的平衡啊……？",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "優花梨工作越是精明能幹，",
    "voice": "vo_adv_1034012_009",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n就越是有人會光明正大的混水摸魚……",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n也會有什麼事",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "都推給她去做的人出現……",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "啊――",
    "voice": "vo_adv_1034012_010",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "珠希，",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "妳又在走廊上邊走邊吃鯛魚燒了吧！",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n秋乃，",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "還有很多文件想讓妳過目，",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n麻煩妳不要想逃走！",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "……咳咳。",
    "voice": "vo_adv_1034012_011",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "總而言之。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "現在的優花梨",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "總是把自己逼得很緊，讓人看不下去。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n你可以想辦法幫她一下嗎？",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "嗯，",
    "voice": "vo_adv_1034012_012",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "麻煩你了。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n若對象是你，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "想必優花梨也會讓自己放鬆點吧。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "background",
    "bg_id": "500050"
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "{0}居然會主動邀請我去吃飯，",
    "voice": "vo_adv_1034012_013",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n真是難得呢。",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "其實我還有工作沒做完……",
    "voice": "vo_adv_1034012_014",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "可是美冬把我趕出公會小屋了。",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "真是的。",
    "voice": "vo_adv_1034012_015",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "她到底是什麼意思嘛。",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n我哪有時間悠悠哉哉的……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "咦，",
    "voice": "vo_adv_1034012_016",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "咦！？",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n不、",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "不行啦！？　",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "你還太早了……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "欸，",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我？",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n你是叫我喝嗎？",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "……不，",
    "voice": "vo_adv_1034012_017",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我就算了。",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我已經……",
    "voice": "vo_adv_1034012_018",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "不喝麥酒了。",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "喝水就行了……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "你、",
    "voice": "vo_adv_1034012_019",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "你那眼神是什麼意思？",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我是說真的喔？　",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "這次我",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "絕對連一滴酒都不會碰的！",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我已經",
    "voice": "vo_adv_1034012_020",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "不想再見到麥酒了！",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "來，你久等的麥酒！",
    "voice": "vo_adv_1034012_021",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "………………………………………………",
    "voice": "vo_adv_1034012_022",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "吞口水。",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "不、",
    "voice": "vo_adv_1034012_023",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "不行不行……！",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "店員先生，",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "這個我們不喝，",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "可以請你收回去嗎？",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "好，",
    "voice": "vo_adv_1034012_024",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "麥酒",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "再一杯是吧～！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "為什麼！？",
    "voice": "vo_adv_1034012_025",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "這是我請妳喝的。",
    "voice": "vo_adv_1034012_026",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "不，",
    "voice": "vo_adv_1034012_027",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我就說我不喝了啊！",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "唔嗯～",
    "voice": "vo_adv_1034012_028",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "老實說，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "我們也覺得很傷腦筋啊。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n自從客人妳",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "開始禁酒以後，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "本店的營業額就下降了。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "原來我有喝這麼多……？",
    "voice": "vo_adv_1034012_029",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "但、",
