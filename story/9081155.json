    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "不是鳳鳳，",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "而是鳳凰！",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "不對，",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "好久不見，",
    "voice": null,
    "unit_id": 134712
