  {
    "type": "dialogue",
    "name": "布武機",
    "words": "嗯～？　",
    "voice": "vo_adv_9500073_000",
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "哦……",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "嗯～～～～♡",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "雜碎哥哥啊～",
    "voice": "vo_adv_9500073_001",
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "你知道自己說的是",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "什麼意思嗎？",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "意思就是「超雜碎又弱小的我，",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "沒有最喜歡的布武機",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n就活不下去～」",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "吧～♡",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "咦？",
    "voice": "vo_adv_9500073_002",
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "你沒說那種話？",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "呀哈哈，",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "你也太急了吧，好遜♪",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "不過啊──",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "雜碎哥哥的真心話",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "早就露餡了啦。",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "就算嘴上逞強，",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "靈魂卻渴望輸給布武機～",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "之類的？",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "表情？",
    "voice": "vo_adv_9500073_003",
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "舉止？",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "氣場？",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "畢竟從那些地方，全──部都",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n散發出超雜碎的氣味了嘛♪",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "真是有夠丟人的──♡",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "啊～啊，",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "看著看著都覺得你可憐起來了♪",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "然後，",
    "voice": "vo_adv_9500073_004",
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "你是說，請讓你把一切都奉獻給布武機～",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "來著？",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "哥哥姑且也有派上用場的地方，",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "實際上也有幫上忙？",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n所以我就在想～",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "聽聽你的請求，好像也不是",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "不行吧──",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "──逗～你的，",
    "voice": "vo_adv_9500073_005",
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "噗噗～！",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "你該不會真的期待了吧？",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n我才沒有什麼獎賞給弱弱的超雜碎哥哥～♡",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n想拜託我的話，",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "就再更難看地低頭啊……",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "啊……？",
    "voice": "vo_adv_9500073_006",
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "不是，",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "等一下……",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "哥哥你在說什麼啊！？",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n都走到這一步了，還能那樣嗎？",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "不可能吧！？",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n等等，",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "不要若無其事地打算去哪！",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "欸，",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "別無視我～！",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "啊──",
    "voice": "vo_adv_9500073_007",
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "真是的，",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "我知道了啦！",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "我聽哥哥的請求就是了！",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "區區雜碎哥哥，竟然還敢這麼囂張，雖然讓人超火大，",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n不過我還是會好好戰鬥的！",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "哇──",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "布武機真親切～！",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "呼──",
    "voice": "vo_adv_9500073_008",
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "呼……",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "有、",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "有好好聽話，很了不起嘛？",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n哥哥果然必須這樣才對吧～",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "違抗我的命令什麼的是不可能的，",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "應該說，",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "你做不到吧♡",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "啊──",
    "voice": "vo_adv_9500073_009",
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "就說不行啦！",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "真是的，",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "那種事不可以！",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "哥哥要和我一起",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "把臭蜥蜴女打飛！",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "好，就這麼決定──♪",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "不接受異議──♪",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "然",
    "voice": "vo_adv_9500073_010",
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "後",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "呢──♡",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n等事情結束後，",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "就會讓你一輩子當布武機的奴隸的",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "做好覺悟吧，",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "雜",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "碎",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "哥",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "哥",
    "voice": null,
    "unit_id": 130241
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "♡",
    "voice": null,
