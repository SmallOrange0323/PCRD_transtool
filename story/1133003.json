[
  {
    "type": "background",
    "bg_id": "501030"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "吃完冰淇淋的{0}與七七香\\n決定繼續美少女遊戲模擬約會──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "…………",
    "voice": "vo_adv_1133003_000",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "討厭啦，",
    "voice": "vo_adv_1133003_001",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "害、",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "害我也有點緊張起來了……",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "剛才那句話……",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "只要和我在一起就很開心，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "應該",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "是真心的吧？　",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "唔～",
    "voice": "vo_adv_1133003_002",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "本來只是想體驗經典的主流約會事件，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n怎麼氣氛變得",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "有點奇怪了呢～！　",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "這一切通通都是",
    "voice": "vo_adv_1133003_003",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "剛才那句話害的啦～！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n有種「對七七香的心臟造成暴擊！」",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "的感覺～！　",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "……嗯！？",
    "voice": "vo_adv_1133003_004",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "沒、",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "沒有，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "沒事啦～",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我只是在",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "計劃下一個約會事件而已☆",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "話說回來，",
    "voice": "vo_adv_1133003_005",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "這個態度是什麼意思呀！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n你可是在和名為七七香的美少女約會耶？",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n應該要更興奮、",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "更加小鹿亂撞才對吧～！　",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "就只有我在害羞，",
    "voice": "vo_adv_1133003_006",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "對方連半點害羞的感覺都沒有，這是怎麼回事！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n好歹稍微在意一點，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "心動☆",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "一下啊！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "……我要雪剛才的恥，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "再找個食物",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "當題材吧？　",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "唔……",
    "voice": "vo_adv_1133003_007",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "好像可以再去吃點東西～",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "嘿，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "你有想吃什麼東西嗎？",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "不不不，",
    "voice": "vo_adv_1133003_008",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我們不是才剛吃完冰淇淋嗎！？",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "身體受寒的話會搞壞肚子，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "別想了！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "好！",
    "voice": "vo_adv_1133003_009",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "那我們一起去狩獵吧！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "喂不對，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "那是別種遊戲啦！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我們現在是美少女遊戲呢！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "不對，",
    "voice": "vo_adv_1133003_010",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "等一下！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "冷靜下來。",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n就算我再想用食物讓他心跳加速，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n感覺也只會被他忽視。",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "或許我應該改用",
    "voice": "vo_adv_1133003_011",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "「手碰手心跳加速☆」的題材攻略他。",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "說到海邊的經典美少女遊戲事件……",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "啊！　",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我想想，",
    "voice": "vo_adv_1133003_012",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "還是游個泳再去吃東西吧！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "那樣肚子也比較餓，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "時間點正好。",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "主流中的主流，",
    "voice": "vo_adv_1133003_013",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "海邊的超近距離臉紅心跳事件！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n這樣一來，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我的心動回憶就能確實展開了！　",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "……啊，",
    "voice": "vo_adv_1133003_014",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "對了！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n如果用上看剛才買的書一定會很有意思，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我去把書拿來～",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "鏘鏘～",
    "voice": "vo_adv_1133003_015",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "這是我剛剛買的潛水魔法♪",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n今天",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我們就用這個魔法",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "到海裡看看吧！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "哼，",
    "voice": "vo_adv_1133003_016",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "不必擔心。",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我已經大致掌握內容了。",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n何況七七香還是個天才魔法少女，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "小菜一碟啦！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "還有，",
    "voice": "vo_adv_1133003_017",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我要用的不是所有魔法，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "只是一小部分而已，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "安心又安全！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "只要限制在確保視野及呼吸的條件下，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "就可以簡化魔法了。",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "……你這個眼神是還在懷疑吧～？",
    "voice": "vo_adv_1133003_018",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "不過，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "不敢一下子就嘗試太深的水域的話，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "先就近試試吧。",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "附魔！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "這樣一來就沒問題了☆",
    "voice": "vo_adv_1133003_019",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n快點，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "把臉埋到海裡試試？",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "什麼！？",
    "voice": "vo_adv_1133003_020",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "……啊，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我忘了眼睛的防護！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "哇，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "眼睛裡進了不少海水吧！？",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "對不起、對不起！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "唔，",
    "voice": "vo_adv_1133003_021",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "這個時候應該要用……",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "構築！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n把臉埋進",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "這些純水裡，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "眼睛眨一眨！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "呃，",
    "voice": "vo_adv_1133003_022",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "咳。",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "雖然出了一點小差錯，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "但現在已經萬無一失了！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "走，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我們一起潛進海裡吧！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "一，二，三！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "still",
    "still_id": "113300301"
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "哇～",
    "voice": "vo_adv_1133003_023",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "好壯觀的景色！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n看來魔法控制得非常成功呢～♪",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "哼哼，",
    "voice": "vo_adv_1133003_024",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "這下你明白七七香的厲害之處了吧？",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n這樣的福利",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "可是不可多得的機會喔☆",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "現在你的身體",
    "voice": "vo_adv_1133003_025",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "應該可以自在活動了，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n要不要試著",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "接近魚呀？",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "哦，",
    "voice": "vo_adv_1133003_026",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "連海豚都湊過來了呢！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n其實",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "你滿討動物喜歡的吧？",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "別謙虛～",
    "voice": "vo_adv_1133003_027",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
