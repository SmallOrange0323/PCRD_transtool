    "name": "七七香",
    "words": "還有，",
    "voice": "vo_adv_1133003_038",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "你為什麼可以這麼若無其事地遞給我啊！",
