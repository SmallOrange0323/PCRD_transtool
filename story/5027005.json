[
  {
    "type": "background",
    "bg_id": "500830"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "嘉夜她們所在的公會──【龍族巢穴】和茉莉一行人，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n為了尋找智以及龍，在茂密的樹林中前進著。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "這個方向對嗎？",
    "voice": "vo_adv_5027005_000",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "沒問題，",
    "voice": "vo_adv_5027005_001",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "方向正確～♪",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n以我剛剛",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "『看到』的內容的話☆",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "老大這種時候特別可靠，讓人很放心。",
    "voice": "vo_adv_5027005_002",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "嘉夜夜，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "妳那邊有沒有發現什麼？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這個，",
    "voice": "vo_adv_5027005_003",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "是那個石板吧？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "會掉在這裡就表示……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "樹在搖晃！？",
    "voice": "vo_adv_5027005_004",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "在那裡！",
    "voice": "vo_adv_5027005_005",
    "unit_id": 106511
  },
  {
    "type": "background",
    "bg_id": "500850"
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "小智姐！！",
    "voice": "vo_adv_5027005_006",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "咦！？",
    "voice": "vo_adv_5027005_007",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "　為什麼茉莉妳會在這裡？",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "妳這樣問就不對了。",
    "voice": "vo_adv_5027005_008",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "而且說起來，那是我們要問妳的才對。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "一個人跑出去還被逼到絕境，",
    "voice": "vo_adv_5027005_009",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "真是不像話！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……",
    "voice": "vo_adv_5027005_010",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "嗯，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "妳說得沒錯。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n光靠我一個人，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "沒辦法像你們這樣",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "把事情處理好。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "這樣一來任務也失敗了……",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "沒有臉見茉莉……",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "你這個人……",
    "voice": "vo_adv_5027005_011",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "真是的，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "敗給你了。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "嗯……",
    "voice": "vo_adv_5027005_012",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "抱歉，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "茉莉。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "嗚哇～！！",
    "voice": "vo_adv_5027005_013",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "　",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "小智姐！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n竟然丟下我跑掉，太過分了！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "喂喂，",
    "voice": "vo_adv_5027005_014",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "看來妳也很受愛戴嘛。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n與其說什麼沒臉見她，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不如別做這種讓夥伴擔心的事情啦。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "而且，所謂的夥伴",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "沒什麼幫不幫得上的分別吧？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "對嘉夜夜來說也是嗎……？",
    "voice": "vo_adv_5027005_015",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "那當然？",
    "voice": "vo_adv_5027005_016",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……欸嘿嘿，",
    "voice": "vo_adv_5027005_017",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這樣啊。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "哈哈……",
    "voice": "vo_adv_5027005_018",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "真傷腦筋。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n竟然被監視的對象說教。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "不過，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "妳說得沒錯。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我讓各位擔心了呢。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "這是個需要讓妳這麼拼命的任務嗎～？",
    "voice": "vo_adv_5027005_019",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "【王宮騎士團（NIGHTMARE）】的小姐☆",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "沒想到妳連這個都知道了啊……",
    "voice": "vo_adv_5027005_020",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我投降了，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "完全逃不出妳的手掌心呢。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "撇下我們偷跑的人",
    "voice": "vo_adv_5027005_021",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "還真敢講耶。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "因為焦急和競爭意識",
    "voice": "vo_adv_5027005_022",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "而失去冷靜，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我果然",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "還不夠成熟呢。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我要再次",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "正式跟妳道謝，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "茉莉。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "謝謝妳來救我，我真的很高興。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "小智姐！！",
    "voice": "vo_adv_5027005_023",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "喔？",
    "voice": "vo_adv_5027005_024",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "一開始就這麼坦率的話就可愛多了嘛",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "之後要好好感謝我祈梨大人，然後成為我的手下……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "那個",
    "voice": "vo_adv_5027005_025",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "各位～",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "不好意思在大家聊得開心的時候打擾～……",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "昨晚",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "的……",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "『那個』",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "是牠沒錯吧？",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "龍？",
    "words": "……",
    "voice": "vo_adv_5027005_026",
    "unit_id": 12311
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "所有人的視線都集中到帆稀的手所指向的地方。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n那隻巨大生物，就像是在打量般地盯著眾人看。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我說，",
    "voice": "vo_adv_5027005_027",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "老大……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我們在找的龍……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "是這傢伙沒錯嗎？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "祈梨妳之前直接遇到過牠吧，",
    "voice": "vo_adv_5027005_028",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "妳怎麼看？",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "唔……",
    "voice": "vo_adv_5027005_029",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "有這麼醜嗎？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "龍？",
    "words": "咕喔！？",
    "voice": "vo_adv_5027005_030",
    "unit_id": 12311
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "拉格，",
    "voice": "vo_adv_5027005_031",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "你能和牠對話嗎？",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "拉格",
    "words": "嘎喔！",
    "voice": "vo_adv_5027005_032",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "龍？",
    "words": "咕喔喔喔……",
    "voice": "vo_adv_5027005_033",
    "unit_id": 12311
  },
  {
    "type": "dialogue",
    "name": "拉格",
    "words": "嘎嘎嘎。",
    "voice": "vo_adv_5027005_034",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "龍？",
    "words": "咕喔……",
    "voice": "vo_adv_5027005_035",
    "unit_id": 12311
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……總覺得，",
    "voice": "vo_adv_5027005_036",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "好像語言不通的樣子。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "難不成，",
