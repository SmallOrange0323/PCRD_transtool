    "voice": "vo_adv_9500013_000",
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我嗎！？",
    "voice": null,
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "真、",
    "voice": null,
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "真的嗎？",
    "voice": null,
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "騎士先生，",
    "voice": null,
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "選我",
    "voice": null,
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "真的沒問題嗎！？",
    "voice": null,
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "因、",
    "voice": "vo_adv_9500013_001",
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "因為我……",
    "voice": null,
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n我想你應該",
    "voice": null,
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "已經知道了吧……",
    "voice": null,
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n我喜歡怜大人，",
    "voice": null,
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "也喜歡騎士先生喔？",
    "voice": null,
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "而且，",
    "voice": "vo_adv_9500013_002",
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我總是無法變得坦率。",
    "voice": null,
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "也對騎士先生",
    "voice": null,
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "說了好多過分的話。",
    "voice": null,
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n你居然還選擇了這樣的我……",
    "voice": null,
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "……不，",
    "voice": "vo_adv_9500013_003",
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "不是這樣呢。",
    "voice": null,
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n騎士先生是在了解我的一切之後，",
    "voice": null,
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n也依然",
    "voice": null,
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "選擇了我對吧。",
    "voice": null,
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "但我卻還是",
    "voice": "vo_adv_9500013_004",
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "一個人在這邊扭扭捏捏……",
    "voice": null,
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "啊～～",
    "voice": null,
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "真是的！",
    "voice": null,
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "騎士先生！",
    "voice": "vo_adv_9500013_005",
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我老實說！",
    "voice": null,
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我，",
    "voice": null,
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "現在",
    "voice": null,
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "非常、",
    "voice": null,
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "非常",
    "voice": null,
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "開心！",
    "voice": null,
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n開心到覺得",
    "voice": null,
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "這是不是一場夢……",
    "voice": null,
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n簡直",
    "voice": null,
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "不敢相信……！",
    "voice": null,
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "不過，",
    "voice": "vo_adv_9500013_006",
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "只要你選擇我……",
    "voice": null,
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n只要你全部接納",
    "voice": null,
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我貪心的感情，",
    "voice": null,
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我也會",
    "voice": null,
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "坦率面對自己的心意……！",
    "voice": null,
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "騎士先生和怜大人",
    "voice": "vo_adv_9500013_007",
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我都要選，",
    "voice": null,
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "目標是左擁右抱！",
    "voice": null,
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n事已至此，",
    "voice": null,
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "那我就要貫徹到底！",
    "voice": null,
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "畢竟我就是個",
    "voice": null,
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "這麼貪心的人！",
    "voice": null,
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "即使如此，",
    "voice": "vo_adv_9500013_008",
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "如果你還愛我的話……",
    "voice": null,
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "那今後",
    "voice": null,
    "unit_id": 105441
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "也請你多多指教了……！",
    "voice": null,
    "unit_id": 105441
  }
]
