  {
    "type": "dialogue",
    "name": "未央",
    "words": "偶像的工作喔！",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "剛剛在這裡跳舞，",
    "voice": "vo_adv_1126004_006",
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "然後這些孩子們就來找我說話了呢。",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "他們喜歡模仿偶像，",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "所以希望我教她們～",
