    "name": "未央",
    "words": "將來無可限量啊……",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "女子１",
    "words": "咦？",
    "voice": "vo_adv_1126004_021",
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "女子１",
    "words": "\\n大姐姐，",
    "voice": null,
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "女子１",
    "words": "妳不會生氣地說",
    "voice": null,
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "女子１",
    "words": "「這樣不行」嗎？",
    "voice": null,
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "我才不會說這種話呢，",
    "voice": "vo_adv_1126004_022",
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "大家照自己喜歡的方式做就好了！",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "不用完美地做到",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "我所教的所有東西也沒關係喔。",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "啊哈哈！",
    "voice": "vo_adv_1126004_023",
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "感覺是有點超現實的風格呢。",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "不過，",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "就是這樣。",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "就照著自己的風格去做就好了！",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "女子１",
    "words": "不用做得很好也沒關係嗎？",
    "voice": "vo_adv_1126004_024",
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "女子１",
    "words": "\\n因為，",
    "voice": null,
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "女子１",
    "words": "偶像不都做得很好嗎？",
    "voice": null,
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "這個",
    "voice": "vo_adv_1126004_025",
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "嘛。",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "雖然現在只是模仿遊戲，",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "但一當上偶像，",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n就會有種不得不保持完美的心情，",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "這點我明白的。",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "不過，",
    "voice": "vo_adv_1126004_026",
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "如果滿腦子只想著那些事，",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "讓開心的",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "心情因此跑不見，",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "這樣就有～點可惜了呢！",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "勇敢做自己，盡情享受其中，",
    "voice": "vo_adv_1126004_027",
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n以此為基礎，",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "再要求完美才是最棒的呢。",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "無論如何一定要和觀眾們一起同樂！",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "大概是這種感覺♪",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "女子１",
    "words": "嗚……",
    "voice": "vo_adv_1126004_028",
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "女子１",
    "words": "那",
    "voice": null,
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "女子１",
    "words": "該怎麼做才好呢？",
    "voice": null,
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "這樣的話……",
    "voice": "vo_adv_1126004_029",
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "好！",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "把我教妳的事",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "先全部都忘記吧！",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "然後",
    "voice": "vo_adv_1126004_030",
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "再配合音樂隨心所欲地跳跳看吧。",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n要遵從自己的感覺舞動身體喔，",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "要開始囉～！",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "跳吧跳吧～！",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "女孩子們",
    "words": "喔～！",
    "voice": "vo_adv_1126004_031",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "——好了，",
    "voice": "vo_adv_1126004_032",
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "今天的偶像訓練課程結束了！",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "大家，",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "體會過後有什麼感想嗎？",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "女子２",
    "words": "人家覺得",
    "voice": "vo_adv_1126004_033",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女子２",
    "words": "自己好像可以成為很厲害的偶像！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女子２",
    "words": "\\n回去之後要和爸爸媽媽炫耀！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女孩子3",
    "words": "還算是蠻開心的，",
    "voice": "vo_adv_1126004_034",
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "女孩子3",
    "words": "想組個團體試試看呢～",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女孩子3",
    "words": "\\n我們三個人的話，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女孩子3",
    "words": "感覺可以以頂點為目標呢。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女子１",
    "words": "……嗯，",
    "voice": "vo_adv_1126004_035",
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "女子１",
    "words": "我也想試試看！",
    "voice": null,
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "女子１",
    "words": "\\n",
    "voice": null,
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "女子１",
    "words": "我們一起加油試試看！",
    "voice": null,
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "嗯嗯，",
    "voice": "vo_adv_1126004_036",
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "照這個氣勢",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "朝著真正的偶像前進吧☆",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "那麼",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "回家路上要小心喔——！　",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "掰掰——！",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "女孩子們",
    "words": "掰掰～！",
    "voice": "vo_adv_1126004_037",
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "哎呀～，",
    "voice": "vo_adv_1126004_038",
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "讓她們玩得開心真是太好了！",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "事出突然，",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "謝謝你願意幫忙。",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "啊哈哈，",
    "voice": "vo_adv_1126004_039",
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "其實",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "全都是從製作人那裡現學現賣的啦！",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n剛開始當偶像的時候，",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "我也像那孩子",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "一樣呢。",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "自己如果",
    "voice": "vo_adv_1126004_040",
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "不開心的話，",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "心意就無法傳達給觀眾們了。",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "當偶像的時候，",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "就是想要和大家一起",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "帶著笑容享受的嘛。",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "……呃，",
    "voice": "vo_adv_1126004_041",
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "雖然我也不能說得太冠冕堂皇啦！",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "我也不能忘記初衷、",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "朝更高更高的目標邁進，",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "並且繼續加油才行呢！",
    "voice": null,
    "unit_id": 112631
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好，",
    "voice": "vo_adv_1126004_042",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "辛苦了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "……雖然讓你作夢是沒什麼問題，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "但果然有很多謎團呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "說起來這些記憶，",
    "voice": "vo_adv_1126004_043",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "真的是在那邊的世界發生過的事嗎？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n畢竟那些孩子們是「外側」的存在，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "到底該怎麼處理才好呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不過，",
    "voice": "vo_adv_1126004_044",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "也不像是從你或那孩子的願望中誕生的夢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "算了，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "能留下一些快樂的回憶或許也不是件壞事嘛。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500332"
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "咦……",
    "voice": "vo_adv_1126004_045",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "我們",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "該不會是睡著了吧……？",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "咦，",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "已經黃昏了嗎！　",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "那自主練習只好等下次……",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "……好像，",
    "voice": "vo_adv_1126004_046",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "做了奇怪的夢呢。",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "我像是偶像的老師一樣，",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "對小女孩們說了",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "「自己也得與觀眾們一起樂在其中」",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "這樣的建議。",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "在這個時間點，",
    "voice": "vo_adv_1126004_047",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "做了這種夢可真不可思議……",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "難不成是那種「照著夢裡那樣做的話就沒問題」",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "的預知夢嗎？",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "是嗎……",
    "voice": "vo_adv_1126004_048",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "嗯，",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "說的也是呢。",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "那麼，",
    "voice": "vo_adv_1126004_049",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "我會帶著後援會的大家……",
