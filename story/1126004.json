  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "辛苦了～！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "你在休息嗎？",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n我",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "剛剛和後援會的大家",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "聊了很多事情！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "接著",
    "voice": "vo_adv_1126004_001",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "再稍微做一下自主練習，",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "再來就想好好休息了呢。",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n也快要傍晚了……",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "……話說",
    "voice": "vo_adv_1126004_002",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "不覺得有點亮嗎？",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "咦，",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "是你在發光！？",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n是有什麼機關嗎！？　",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "你是",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "怎麼……",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "呀啊啊！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "background",
    "bg_id": "510120"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "假日正在散步的{0}。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n正走到公園附近的時候——",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "112600401"
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "好了～",
