  {
    "type": "dialogue",
    "name": "旁白",
    "words": "和【new generations】一同在村裡停留的{0}，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在陪著未央等人結束練習後──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "未央",
