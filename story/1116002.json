  },
  {
    "type": "dialogue",
    "name": "粉絲１",
    "words": "唱得好棒啊！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "粉絲２",
    "words": "好像只有今天這場活動",
    "voice": "vo_adv_1116002_031",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "粉絲２",
    "words": "\\n可以聽到的限定版本喔。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "粉絲２",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "粉絲２",
    "words": "不枉我在大冷天跑來！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "工作人員2",
    "words": "唉呀，",
    "voice": "vo_adv_1116002_032",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "工作人員2",
    "words": "一時之間還真是不知道如何是好呢，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "工作人員2",
    "words": "真是幫上大忙了。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "工作人員2",
    "words": "\\n客人們也都",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "工作人員2",
    "words": "很滿意呢。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "工作人員2",
    "words": "\\n",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "工作人員2",
    "words": "可是你啊，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "工作人員2",
    "words": "是從哪裡弄來這種稀有音源的？",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "呵呵，",
    "voice": "vo_adv_1116002_033",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "作戰好像很成功呢。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "大家都沒想到居然是本人在",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "販賣處裡面唱歌吧？　",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "因為有得到{0}的能力強化，",
    "voice": "vo_adv_1116002_034",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n所以沒有麥克風也能唱出音量，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "喉嚨也沒有問題。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "一直以來都是受到大家的支持，",
    "voice": "vo_adv_1116002_035",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這次要換我來努力了！　",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "辛苦了。",
    "voice": "vo_adv_1116002_036",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "活動成功結束真是太好了呢。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不客氣。",
    "voice": "vo_adv_1116002_037",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "雖然出了一些狀況，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n但是順利結束真是太好了呢。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "也吸引到了粉絲以外的客人，",
    "voice": "vo_adv_1116002_038",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n唱片也完售了，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "努力有回報呢。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "但是呢，",
    "voice": "vo_adv_1116002_039",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "可不能覺得已經結束了喔？",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n我們的約會現在才要進入正題呢。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "剛剛",
    "voice": "vo_adv_1116002_040",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "唱了很多歌現在狀況很好呢，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "要好好的享受了呢！",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "成功渡過了意外事故，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n情緒更加高昂的望，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n再次下定決心，要完成一場最棒約會。",
    "voice": null,
    "unit_id": null
  }
