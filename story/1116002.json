  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "約定的日子終於到來，望前往了約好見面的地方。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗚嗚，",
    "voice": "vo_adv_1116002_000",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "果然還是太早來了啊。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "距離約好的時間還有很久呢……",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "期待到沒辦法待在家裡所以跑出來了，",
    "voice": "vo_adv_1116002_001",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "總覺得像小孩子一樣有點丟臉呢。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯～",
    "voice": "vo_adv_1116002_002",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "可是這也沒辦法啊？",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n這是我第一次跟男生一起過聖誕節，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n當然會很期待呀！",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "衣服已經都搭配好了、",
    "voice": "vo_adv_1116002_003",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "禮物也確實準備好了、",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n想去的店跟活動也確認過了！",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "身為偶像",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "必須一直將達到完美作為目標呢！",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……不對，",
    "voice": "vo_adv_1116002_004",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我會不會做過頭了？　",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "會不會嚇到他啊？",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n應該、沒問題吧？",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "background",
    "bg_id": "500036"
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯，",
    "voice": "vo_adv_1116002_005",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "抵達了會合地點的",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n聖誕樹下了……",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "但、",
    "voice": "vo_adv_1116002_006",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "但是這裡有好多人啊！",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "就算是聖誕季，人也太多了吧……",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……嗯？　",
    "voice": "vo_adv_1116002_007",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "啊！　",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "{0}！？",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "為什麼？　",
    "voice": "vo_adv_1116002_008",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "明明離約好的時間還有很久呢。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我好像也沒有資格說別人呢。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "啊，",
    "voice": "vo_adv_1116002_009",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "仔細一看好像在準備什麼活動呢。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "咦，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那個不是【慈樂之音】的海報嗎！",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "咦，",
    "voice": "vo_adv_1116002_010",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "咦？　",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我完全不知道欸？",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "到底是在做什麼呢，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "在這種地方？",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "好像是在做唱片的促銷活動呢。",
    "voice": "vo_adv_1116002_011",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "是不是盯上了聖誕季的人潮呢。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我們的製作人",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "還真是準備萬全呢。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "可是",
    "voice": "vo_adv_1116002_012",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "也沒必要在約會前打工吧。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不過，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這真的很像{0}會做的事呢。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "雖然想要去幫忙，",
    "voice": "vo_adv_1116002_013",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "可是我出去感覺會引起騷動，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n反而會造成困擾，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "還是偷偷地觀察他工作吧。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "搭建臨時的販賣攤位，",
    "voice": "vo_adv_1116002_014",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "準備傳單跟周邊。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n招攬客人還有為到場的粉絲整隊。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "為了在寒冷的天氣中讓活動成功，",
    "voice": "vo_adv_1116002_015",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n大家都好拼命呢……",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "因為有大家在背後支持我們，",
    "voice": "vo_adv_1116002_016",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n我們才能盡情地做自己的工作呢，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "得好好感謝他們呢。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "工作人員1",
    "words": "喂喂，",
    "voice": "vo_adv_1116002_017",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工作人員1",
    "words": "不會吧！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工作人員1",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工作人員1",
    "words": "活動馬上就要開始了啊，怎麼辦啊。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "怎、",
    "voice": "vo_adv_1116002_018",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "怎麼了？　",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "有突發狀況？",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "工作人員1",
    "words": "唱片的播放器居然故障了，",
    "voice": "vo_adv_1116002_019",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工作人員1",
    "words": "這可是新歌的促銷活動啊，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工作人員1",
    "words": "\\n沒有歌的話根本辦不下去啊！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工作人員1",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工作人員1",
    "words": "為什麼沒有確認啊！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工作人員2",
    "words": "非、",
    "voice": "vo_adv_1116002_020",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "工作人員2",
    "words": "非常抱歉……",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "工作人員2",
    "words": "\\n我會馬上準備新的播放器。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "工作人員1",
    "words": "就算你說要準備，",
    "voice": "vo_adv_1116002_021",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工作人員1",
    "words": "是想回去辦公室拿嗎？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工作人員1",
    "words": "\\n那樣來不及吧。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工作人員1",
    "words": "喂、",
    "voice": "vo_adv_1116002_022",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工作人員1",
    "words": "喂等等……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工作人員1",
    "words": "跑掉了。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工作人員1",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工作人員1",
    "words": "那個打工的",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工作人員1",
    "words": "知道辦公室在哪裡嗎？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "{0}，稍微等等！",
    "voice": "vo_adv_1116002_023",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "關於這部分無可奉告！",
    "voice": "vo_adv_1116002_024",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我知道！",
    "voice": "vo_adv_1116002_025",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我知道所以你冷靜一點！",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我剛剛都聽到了。",
    "voice": "vo_adv_1116002_026",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "播放器，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "壞掉了對吧？",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "但就算是要去拿替換的播放器，",
    "voice": "vo_adv_1116002_027",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n不管多麼快都來不及的。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "所以",
    "voice": "vo_adv_1116002_028",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "就用現在有的東西來應對吧。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "交給我吧，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我已經有想法了。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "一起合力",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "渡過這個難關吧！",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "勇氣的翅膀　",
    "voice": "vo_adv_1116002_029",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "向天空展翅～♪",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "粉絲１",
    "words": "欸欸――，",
    "voice": "vo_adv_1116002_030",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "粉絲１",
    "words": "是小望的清唱！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "粉絲１",
    "words": "\\n",
    "voice": null,
