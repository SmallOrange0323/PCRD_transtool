  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "お前さん、",
    "voice": "vo_adv_6044110_000",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "ナナカの水着……",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "どう思う？",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "ほら、",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "あの水着、",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "ちょっと派手だろ？",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "こう、",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "いいとか悪いとか。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "お前さんはどう感じたのか",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "気になってね。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "あんな水着、",
    "voice": "vo_adv_6044110_001",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "どこで手に入れたんだろうね。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "まあ、",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "人には人の分ってもんがあるから……",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "アタシはこういう",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "\\n奥ゆかしい感じの水着が性に合ってるのさ。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "結構いい感じだろ？",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "へぇ、",
    "voice": "vo_adv_6044110_002",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "そうかい。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "ああいう水着がいいのかい……",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "お前さんも男だね。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "なんだか安心しちまったよ。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "確かにそうだね。",
    "voice": "vo_adv_6044110_003",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "アタシにはとてもじゃないけど着こなせそうにないし。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "まったく、",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "うちのメンバーは",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "ルカ",
    "words": "個性的なやつら揃いで飽きないよ。",
    "voice": null,
    "unit_id": 113111
  }
]
