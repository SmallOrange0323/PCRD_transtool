[
  {
    "type": "background",
    "bg_id": "501030"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "度假在一片好評之中展開，第二天。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}不知道如何使用到晚上前的自由時間，\\n因此放空地眺望著海，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "這時候，雪菲來到他身邊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我說，",
    "voice": "vo_adv_1351003_000",
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "{0}。",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n到晚上之前還有時間，",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "如果你願意……",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "要不要",
    "voice": "vo_adv_1351003_001",
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "跟我約會？",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "啊，",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "要是你沒有",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "其他預定的話……",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "謝、",
    "voice": "vo_adv_1351003_002",
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "謝謝你。",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "話雖如此，",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "但是我沒決定好要去哪裡就是了。",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "總之……",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我們就一起去散個步吧。",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "好，",
    "voice": "vo_adv_1351003_003",
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "突破第一關了。",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "比我想得",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "還要輕易地就得到OK的回答了呢。",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "但是，",
    "voice": "vo_adv_1351003_004",
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "接下來才是正題。",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "到晚上之前，",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我要問出那時候告白的答覆……",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "background",
    "bg_id": "500690"
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "──昨天真的很謝謝你。",
    "voice": "vo_adv_1351003_005",
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "但是",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "最後的按摩，",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "是不是",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "有點做過頭了啊……",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "抱歉喔。",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "呵呵，",
    "voice": "vo_adv_1351003_006",
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "是那樣嗎？",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "雖然最後，",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我們幾乎都是在互相搔癢了。",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n但是包含我在內，",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "大家看起來都很開心，真是太好了。",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "大家幫我按摩之後，",
    "voice": "vo_adv_1351003_007",
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我好像也有稍微消除了疲勞。",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "最近不時會遇上在海邊被魔物包圍的狀況，",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "很辛苦呢。",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "話題聊得很熱烈，",
    "voice": "vo_adv_1351003_008",
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "這可能是個好時機。",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n只要不經意地問出口，",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "氣氛應該也不會變得奇怪……",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "「你覺得怎麼樣呢？",
    "voice": "vo_adv_1351003_009",
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我那時候的告白。」",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "……沒錯，",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "要用盡可能自然的感覺。",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "隨口說出來喔。",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "那、",
    "voice": "vo_adv_1351003_010",
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "那個啊……",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我稍微有點事情",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "想問你一下。",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "你、",
    "voice": "vo_adv_1351003_011",
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "你覺得",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "怎麼樣──",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "就是。",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "那個……",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我、",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我、",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我──",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "──我在想你會不會有點餓了？",
    "voice": "vo_adv_1351003_012",
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "你也",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "還沒",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "吃午餐吧？",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "果、",
    "voice": "vo_adv_1351003_013",
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "果然",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "會餓吧！",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我去海之家買點什麼回來。",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "你在這裡等我。",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "沒、",
    "voice": "vo_adv_1351003_014",
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "沒問題，",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "不需要著急。",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n因為還有時間……",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "讓你久等了。",
    "voice": "vo_adv_1351003_015",
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n我買了炒麵回來喔。",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "還有",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "薯條跟烤雞串。",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n是不是",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "有點買太多了呢……",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "因為我太慌張，",
    "voice": "vo_adv_1351003_016",
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n所以說出從菜單上面開始",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "到下面全部都要，",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n這件事要保密就是了……",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "那麼，",
    "voice": "vo_adv_1351003_017",
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我們開動吧。",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "啊，",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "這麼說來……",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "昨天，",
    "voice": "vo_adv_1351003_018",
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我沒能",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "「啊～嗯」地餵你吃呢。",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "要來試試看嗎？",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "那麼，",
    "voice": "vo_adv_1351003_019",
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我要餵了喔？",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "來，",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "啊～嗯……",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "好吃嗎？",
    "voice": "vo_adv_1351003_020",
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "太好了。",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "要再吃一口嗎？",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "來，",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "啊～嗯。",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "咦，",
    "voice": "vo_adv_1351003_021",
    "unit_id": 135111
  },
  {
