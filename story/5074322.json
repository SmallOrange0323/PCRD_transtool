  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "哎呀，",
    "voice": "vo_adv_5074322_002",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這就是覺醒狀態嗎？",
