    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "比剛才還更有魄力了呢。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "受了傷會恢復，",
    "voice": "vo_adv_5074322_003",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "以為已經打倒了，結果又來個覺醒。",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這麼難纏會惹人厭的喔？",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這可是人家嘔心瀝血做出來的成果，",
    "voice": "vo_adv_5074322_004",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n當然不可能被輕易打倒囉。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不過很遺憾，",
    "voice": "vo_adv_5074322_005",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "遇上我是你倒楣。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "現在我要將你全部切除掉！",
    "voice": null,
    "unit_id": 117511
