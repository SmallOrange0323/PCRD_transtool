[
  {
    "type": "background",
    "bg_id": "501050"
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我們明明是來找「祈願竹」，",
    "voice": "vo_adv_6044305_000",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "但事情卻演變得這麼嚴重。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "但是，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "都看到織女那麼傷心的樣子了，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n也無法對她置之不理啊。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "嗯。",
    "voice": "vo_adv_6044305_001",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "看到她那眼淚，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "吉格魯特也放不下她吧？",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "現在正是讓人見識我們熾炎戰鬼煉獄血盟暗黑團的力量",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "的時候！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "以此",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "讓我們的名聲",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "轟動世界！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我們走！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "問題是那裡！？",
    "voice": "vo_adv_6044305_002",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "這、",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "這個嘛，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我想想。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "那個，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "就是那個。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "要是我",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "和吉格魯特以外的傢伙去冒險，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "你",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "會很寂寞吧？",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "你就想成是這種心情吧。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "……",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "喂！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "不准給我一臉茫然的樣子！！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "關於那點",
    "voice": "vo_adv_6044305_003",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我也沒辦法說什麼。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "但是，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "對織女而言，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "他是交往很久",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "又有感情的對象吧。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "正因為如此，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我們才要代替傷心的織女",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "審判牛郎！",
    "voice": null,
    "unit_id": 113211
  }
]
