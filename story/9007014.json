[
  {
    "type": "background",
    "bg_id": "501670"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "莉瑪和栞為了捉到5.5周年的魔物，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n和烏爾姆以及沃爾加諾一起在街上四處奔波。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "小栞，",
    "voice": "vo_adv_9007014_000",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "魔物往妳那邊去了！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "交給我吧！",
    "voice": "vo_adv_9007014_001",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我會把它引誘到陷阱去……！",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "5、5、",
    "voice": "vo_adv_9007014_002",
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "5.5～～！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "啊，",
    "voice": "vo_adv_9007014_003",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n它中陷阱了。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "真厲害，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "妳們合作無間呢。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "沒有啦，",
    "voice": "vo_adv_9007014_004",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "沒有妳說得那麼厲害……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n都要多虧莉瑪的大動作",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "引開了魔物的注意。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "那麼，",
    "voice": "vo_adv_9007014_005",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "這就是大家通力合作的成果囉！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "也要謝謝烏爾姆和沃爾加諾先生的",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "鼎力相助♪",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "在設置完陷阱之後，",
    "voice": "vo_adv_9007014_006",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我做的也只有在旁邊看著啊。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我沒做什麼，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "不用謝我啦。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "照這樣的步調，",
    "voice": "vo_adv_9007014_007",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "感覺剩下的魔物應該也能全部捉到了。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n再加把勁吧。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "嘿咻……",
    "voice": "vo_adv_9007014_008",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "這些魔物在捉到之後也比預想的還要溫馴，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "看來這工作比預料的更輕鬆呢。",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "沃爾加諾",
    "words": "這大概",
    "voice": "vo_adv_9007014_009",
    "unit_id": 193511
  },
  {
    "type": "dialogue",
    "name": "沃爾加諾",
    "words": "是因為那個吧……",
    "voice": null,
    "unit_id": 193511
  },
  {
    "type": "dialogue",
    "name": "沃爾加諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 193511
  },
  {
    "type": "dialogue",
    "name": "沃爾加諾",
    "words": "多虧了莉瑪小姐的毛絨絨，",
    "voice": null,
    "unit_id": 193511
  },
  {
    "type": "dialogue",
    "name": "沃爾加諾",
    "words": "才能如此輕易成功吧。",
    "voice": null,
    "unit_id": 193511
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "咦？",
    "voice": "vo_adv_9007014_010",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n沃爾加諾先生，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "那是什麼意思？",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "沃爾加諾",
    "words": "因為，",
    "voice": "vo_adv_9007014_011",
    "unit_id": 193511
  },
  {
    "type": "dialogue",
    "name": "沃爾加諾",
    "words": "那個啊！",
    "voice": null,
    "unit_id": 193511
  },
  {
    "type": "dialogue",
    "name": "沃爾加諾",
    "words": "一碰到莉瑪小姐全身毛絨絨的觸感，",
    "voice": null,
    "unit_id": 193511
  },
  {
    "type": "dialogue",
    "name": "沃爾加諾",
    "words": "\\n就連魔物",
    "voice": null,
    "unit_id": 193511
  },
  {
    "type": "dialogue",
    "name": "沃爾加諾",
    "words": "都會變得無法抵抗啊……！",
    "voice": null,
    "unit_id": 193511
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "對啊。",
    "voice": "vo_adv_9007014_012",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "因為莉瑪的毛茸茸觸感",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "實在太棒了，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n說不定連魔物都陶醉其中了呢。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "哎呀，",
    "voice": "vo_adv_9007014_013",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "是這樣嗎？",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我每天都很用心梳理，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n如果大家喜歡那就太好了！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "沃爾加諾",
    "words": "嗯，",
    "voice": "vo_adv_9007014_014",
    "unit_id": 193511
  },
  {
    "type": "dialogue",
    "name": "沃爾加諾",
    "words": "真的是毛絨絨到不行啊！",
    "voice": null,
    "unit_id": 193511
  },
  {
    "type": "dialogue",
    "name": "沃爾加諾",
    "words": "……怎、",
    "voice": "vo_adv_9007014_015",
    "unit_id": 193511
  },
  {
    "type": "dialogue",
    "name": "沃爾加諾",
    "words": "怎麼樣，",
    "voice": null,
    "unit_id": 193511
  },
  {
    "type": "dialogue",
    "name": "沃爾加諾",
    "words": "小栞？",
    "voice": null,
    "unit_id": 193511
  },
  {
    "type": "dialogue",
    "name": "沃爾加諾",
    "words": "\\n我剛剛那句稱讚如何！？",
    "voice": null,
    "unit_id": 193511
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "雖然好像有點突兀，",
    "voice": "vo_adv_9007014_016",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n但以讚美的話來說",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我覺得還算不錯……！",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "咦？",
    "voice": "vo_adv_9007014_017",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n沃爾先生之前不是",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "跟莉瑪小姐告白還失敗了嗎？",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "沃爾加諾",
    "words": "沒有啦！！",
    "voice": "vo_adv_9007014_018",
    "unit_id": 193511
  },
  {
    "type": "dialogue",
    "name": "沃爾加諾",
    "words": "沒有吧！？",
    "voice": null,
    "unit_id": 193511
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "沒、",
    "voice": "vo_adv_9007014_019",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "沒事的。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "畢竟那個時候你們才剛認識，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我覺得以後還有很多培養感情的機會……！",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "所以",
    "voice": "vo_adv_9007014_020",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我也會幫忙的。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "讓大家感情能變得更好……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "這樣啊。",
    "voice": "vo_adv_9007014_021",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "嗯，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "隨你們便吧。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "只要不要做太過頭，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "反而讓莉瑪小姐討厭你就好。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "沃爾加諾",
    "words": "哈哈，",
    "voice": "vo_adv_9007014_022",
    "unit_id": 193511
  },
  {
    "type": "dialogue",
    "name": "沃爾加諾",
    "words": "怎麼可能有那種事……",
    "voice": null,
    "unit_id": 193511
  },
  {
    "type": "dialogue",
    "name": "沃爾加諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 193511
  },
  {
    "type": "dialogue",
    "name": "沃爾加諾",
    "words": "欸，小栞，",
    "voice": null,
    "unit_id": 193511
  },
  {
    "type": "dialogue",
    "name": "沃爾加諾",
    "words": "莉瑪小姐會不會",
    "voice": null,
    "unit_id": 193511
  },
  {
    "type": "dialogue",
    "name": "沃爾加諾",
    "words": "嫌我",
    "voice": null,
    "unit_id": 193511
  },
  {
    "type": "dialogue",
    "name": "沃爾加諾",
    "words": "很煩啊？",
    "voice": null,
    "unit_id": 193511
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "不用那麼擔心的，",
    "voice": "vo_adv_9007014_023",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "你看，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "莉瑪她也……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "…………",
    "voice": "vo_adv_9007014_024",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "哇～～～～～～！！　",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "剛才沃爾加諾先生說的那句話……",
    "voice": "vo_adv_9007014_025",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我感覺得到那不是客套，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n而是打從心底稱讚我的毛髮！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我感受得",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "非常強烈！！　",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "可是！",
    "voice": "vo_adv_9007014_026",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "在我的心中，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "即使到了現在……",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "他還是佔了",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n最大的一席地！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "啊啊，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "命運是如此殘酷地",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "玩弄著",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n我的少女心……！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我到底",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "該怎麼做才好……",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "莉瑪好像",
    "voice": "vo_adv_9007014_027",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "也高興得全身扭來扭去，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n我覺得這個發展還算不錯。",
