  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "大家",
    "voice": "vo_adv_5136402_001",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "好厲害喔！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n對方明明變得很強，卻還是打贏了！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "很好，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "今天要大肆慶祝喔──！　",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……實際上",
    "voice": "vo_adv_5136402_002",
    "unit_id": 128812
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是如何？",
    "voice": null,
    "unit_id": 128812
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我們沒能打贏吧？",
    "voice": null,
    "unit_id": 128812
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "…………是啊。",
    "voice": "vo_adv_5136402_003",
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "沒能打贏。",
    "voice": null,
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "但確實有把它趕跑。",
    "voice": null,
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……戰果已經十分足夠了。",
    "voice": "vo_adv_5136402_004",
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n做得好。",
    "voice": null,
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……是嗎。",
    "voice": "vo_adv_5136402_005",
    "unit_id": 128812
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 128812
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那就好。",
    "voice": null,
    "unit_id": 128812
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "各位，",
