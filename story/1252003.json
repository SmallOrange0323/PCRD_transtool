[
  {
    "type": "background",
    "bg_id": "501950"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "這天，光顧「Naschkatze」的客人絡繹不絕。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "你總算來了！",
    "voice": "vo_adv_1252003_000",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n今天場面超級混亂。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "如果你能來幫忙就太好了！",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我晚點再跟你解釋！",
    "voice": "vo_adv_1252003_001",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "快點，",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "幫我把這個送去窗邊那桌。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n加糖的原創咖啡兩杯，",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "然後是餅乾。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "顧客1",
    "words": "謝謝，",
    "voice": "vo_adv_1252003_002",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "顧客1",
    "words": "咦",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "顧客1",
    "words": "咦？",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "顧客1",
    "words": "\\n莫妮卡呢？",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "顧客2",
    "words": "剛剛看起來很忙呢～",
    "voice": "vo_adv_1252003_003",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "顧客2",
    "words": "\\n今天會不會來我們這邊呢。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "閣下，",
    "voice": "vo_adv_1252003_004",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "抱歉。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "接著幫我把這個送去裡邊的四人桌──",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "送好後，",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "幫我在這杯花草茶裡倒入熱水，",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n然後送去",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "入口那邊的沙發桌。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "你說今天看起來相當忙碌？",
    "voice": "vo_adv_1252003_005",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "是啊，",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "發生了一些事……",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "顧客3",
    "words": "那個那個，莫妮卡，",
    "voice": "vo_adv_1252003_006",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "顧客3",
    "words": "可以聽我說一下嗎？",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "顧客3",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "顧客3",
    "words": "我想跟妳說",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "顧客3",
    "words": "我家老公的事情！",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "顧客3",
    "words": "\\n他下班一到家就直接在沙發上睡著……！",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "顧客3",
    "words": "要吃白飯嗎？",
    "voice": "vo_adv_1252003_007",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "顧客3",
    "words": "還是要吃配菜？",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "顧客3",
    "words": "\\n我問他這些，",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "顧客3",
    "words": "他也完全不回應！",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "那真是辛苦啊。",
    "voice": "vo_adv_1252003_008",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……不過，",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "白飯和配菜",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "是只能選擇其中一種的嗎……？",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "顧客3",
    "words": "哎呀，",
    "voice": "vo_adv_1252003_009",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "顧客3",
    "words": "這麼一說也是呢！",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "顧客3",
    "words": "但是重點不是這個……",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "顧客1",
    "words": "啊，",
    "voice": "vo_adv_1252003_010",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "顧客1",
    "words": "也可以聽我說嗎？",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "顧客1",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "顧客1",
    "words": "最近採購的價格又變高了……",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "顧客1",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "顧客1",
    "words": "莫妮卡這邊",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "顧客1",
    "words": "也有採購的煩惱嗎？",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "顧客2",
    "words": "我也有煩惱……",
    "voice": "vo_adv_1252003_011",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "顧客2",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "顧客2",
    "words": "那個那個，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "顧客2",
    "words": "今年春天流行的洋裝，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "顧客2",
    "words": "\\n粉紅色跟黃綠色，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "顧客2",
    "words": "妳覺得哪一個好～？",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我、",
    "voice": "vo_adv_1252003_012",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我知道了。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n我會聽你們說的，再等一下。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n凡事都要照順序來，",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這是從小就該學習的規矩對吧！",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我們公會的辦事處",
    "voice": "vo_adv_1252003_013",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "確實就是大家休息的場所，",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n然後變成咖啡廳。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "讓居民商量自己的困擾",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "也跟委託相關，",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n因此這裡是跟城鎮居民有所聯繫的重要場所。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "所以，",
    "voice": "vo_adv_1252003_014",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "雖然諮商這件事本身是沒有問題的……",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n但經過口耳相傳，",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "回過神來客人就已經絡繹不絕了。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "但是",
    "voice": "vo_adv_1252003_015",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "也不能不理會需要幫助的居民啊。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "所以",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "只能一個一個聽聽他們的煩惱。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "好，",
    "voice": "vo_adv_1252003_016",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "咖啡準備好了。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "可以幫我",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "把這個送去給那位婦女嗎？",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我去",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "聽聽剛才那些人的煩惱。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "顧客4",
    "words": "哎呀，",
    "voice": "vo_adv_1252003_017",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "顧客4",
    "words": "謝謝你。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "顧客4",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "顧客4",
    "words": "……不過我等了很久呢……",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "顧客4",
    "words": "感覺最近",
    "voice": "vo_adv_1252003_018",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "顧客4",
    "words": "咖啡的味道變了……",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "顧客4",
    "words": "\\n而且",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "顧客4",
    "words": "店裡的氣氛也變得不一樣，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "顧客4",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "顧客4",
    "words": "總覺得好像很辛苦呢……",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "顧客4",
    "words": "是不是發生了什麼事呢？",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "顧客4",
    "words": "啊，",
    "voice": "vo_adv_1252003_019",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "顧客4",
    "words": "抱歉呢。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "顧客4",
    "words": "我只是有一點擔心。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "顧客4",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "顧客4",
    "words": "打擾你工作，真抱歉。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "好，",
    "voice": "vo_adv_1252003_020",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "解決一件事了。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "接著下一件吧。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "雖然還有很多事情要解決……",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "不過腳踏實地完成工作",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "才是所謂的軍人！",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "呼、",
    "voice": "vo_adv_1252003_021",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "呼……",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "\\n這裡也沒有……！",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "怎麼了！？",
    "voice": "vo_adv_1252003_022",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n怎麼一臉驚慌的樣子，",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "究竟發生什麼事了。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "不、",
    "voice": "vo_adv_1252003_023",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "不好意思！",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "有沒有看到我們家女兒？",
    "voice": null,
    "unit_id": 4911
  },
  {
