[
  {
    "type": "dialogue",
    "name": "雪",
    "words": "嗚哇，",
    "voice": "vo_adv_5074204_000",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "有種討厭的感覺耶……",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n待在這裡",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "肯定對肌膚有害！",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這大概是院長搞的鬼吧。",
    "voice": "vo_adv_5074204_001",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "他用藥使自己的魔力遽增，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "導致魔力都洩漏了出來。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "要是一直暴露在這些魔力之中，",
    "voice": "vo_adv_5074204_002",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "會嚴重損害鎮民健康的。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "受不了！",
    "voice": "vo_adv_5074204_003",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "到底有多惡劣啊，",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "那個院長！",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "要趕快打倒他讓城鎮恢復原狀！",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "所以說呢，",
    "voice": "vo_adv_5074204_004",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "醫生",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "加油♪",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這孩子到底在說什麼傻話啊？",
    "voice": "vo_adv_5074204_005",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "是妳自己插手多管閒事的，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "做事要有始有終啊。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "好啦，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "走吧。",
    "voice": null,
    "unit_id": 117511
  }
]
