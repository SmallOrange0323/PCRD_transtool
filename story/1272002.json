    "voice": "vo_adv_1272002_001",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "硬幣自己動了！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "\\n妳",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "沒有在用魔法吧！？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "妳先別講話！",
    "voice": "vo_adv_1272002_002",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "有……？",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "沒有？",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "\\n",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "…………答案是沒有♪",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "\\n坂本老師他",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "沒有交往對象！",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……真是有夠蠢的呢。",
    "voice": "vo_adv_1272002_003",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就算這裡是魔法學園，",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "但那也太不科學到令人反胃了。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "班導",
    "words": "哦～",
    "voice": "vo_adv_1272002_004",
    "unit_id": 915
  },
  {
    "type": "dialogue",
    "name": "班導",
    "words": "還有人在啊？",
    "voice": null,
    "unit_id": 915
  },
  {
    "type": "dialogue",
    "name": "班導",
    "words": "\\n妳們幾個",
    "voice": null,
    "unit_id": 915
  },
  {
    "type": "dialogue",
    "name": "班導",
    "words": "快點回家去～",
    "voice": null,
    "unit_id": 915
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "好、",
    "voice": "vo_adv_1272002_005",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "好的！",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "\\n",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "坂本老師♪",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……這麼說來，",
    "voice": "vo_adv_1272002_006",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我們的老師是叫坂本嘛。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "等等，",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "為什麼會喜歡上那種狂戰士啊！！",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "啊～",
    "voice": "vo_adv_1272002_007",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "坂本老師走掉了……",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "\\n我今天",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "明明還看到了",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "三次黑色掃帚的說～",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "啊～",
    "voice": "vo_adv_1272002_008",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "妳是說一天內看見三次騎著黑色掃帚的人，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "\\n就會招來幸運的迷信吧。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "\\n不過，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "他都跟妳說話了，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "也算是有好運吧♪",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……受不了，",
    "voice": "vo_adv_1272002_009",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "又是魔仙、",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "又是黑色掃帚……",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那只不過是騙小孩的無聊迷信罷了。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……啊，",
    "voice": "vo_adv_1272002_010",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "咦……",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "奇怪……？",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "等、",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "等等，",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "咦……！？",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不見了……！！",
    "voice": "vo_adv_1272002_011",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我的鉛筆盒不見了！！",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "怎麼",
    "voice": "vo_adv_1272002_012",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "會這樣……",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "話說這不太妙吧！？",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "咦，",
    "voice": "vo_adv_1272002_013",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你問我為什麼那麼慌張……？",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……這跟你沒有關係！",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "總之得要找到鉛筆盒才行……！",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這……",
    "voice": "vo_adv_1272002_014",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這樣啊，",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "幫大忙了。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……不過，",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我先給你一個忠告。",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就算找到鉛筆盒，",
    "voice": "vo_adv_1272002_015",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "也絕對不能打開來看……！",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n要是敢看，",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我就宰了你！",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "知道了嗎！？",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "background",
    "bg_id": "501111"
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……我記得下午在室外實習的時候還有拿在手上。",
    "voice": "vo_adv_1272002_016",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n應該是在那張長椅附近……",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊，",
    "voice": "vo_adv_1272002_017",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "有了！！",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就是這個鉛筆盒！！",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n太好了～～！！",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "沒想到這麼簡單就找到了呢！",
    "voice": "vo_adv_1272002_018",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "雖然給你添了麻煩，",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "但已經沒事了！",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你看，",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "裡面的東西也都……",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……不見了！！？",
    "voice": "vo_adv_1272002_019",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "咦！？",
    "voice": "vo_adv_1272002_020",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "怎麼會！？",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n為什麼只有橡皮擦不見了啊～～！？",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "沒錯……",
    "voice": "vo_adv_1272002_021",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗯？",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你有兩塊，可以給我一塊？",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "對啦，",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不是這個問題……！",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n一定得要是那塊橡皮擦才行啊……",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "糟糕……",
    "voice": "vo_adv_1272002_022",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n要是有人看到那塊橡皮擦，",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我就……",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你問說為什麼那麼重要？",
    "voice": "vo_adv_1272002_023",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那是因為……",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "女學生3",
    "words": "啊，",
    "voice": "vo_adv_1272002_024",
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "女學生3",
    "words": "凱留",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "女學生3",
    "words": "妳在這裡做什麼？",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "女學生4",
    "words": "妳先聽我說！",
    "voice": "vo_adv_1272002_025",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女學生4",
    "words": "她剛剛被告白了耶！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女學生4",
    "words": "\\n而且對象還是她一直單戀著的人！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女學生3",
    "words": "嗯，",
    "voice": "vo_adv_1272002_026",
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "女學生3",
    "words": "我現在超幸福的♪",
    "voice": null,
