  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n當凱留與{0}正準備回家時，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n聽見了班上女同學的聲音。",
