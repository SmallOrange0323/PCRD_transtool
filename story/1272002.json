    "voice": "vo_adv_1272002_000",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "魔仙。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "\\n",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "我最喜歡的坂本老師",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "有交往對象嗎……？",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女學生2",
