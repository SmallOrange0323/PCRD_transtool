[
  {
    "type": "background",
    "bg_id": "509040"
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "啊？",
    "voice": "vo_adv_9500092_000",
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n{0}，",
    "voice": null,
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "你剛剛說什麼？",
    "voice": null,
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "我跟你是死黨吧，",
    "voice": "vo_adv_9500092_001",
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "會有人在這種情況下選擇死黨的嗎？",
    "voice": null,
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "…………",
    "voice": "vo_adv_9500092_002",
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "想一直和我在一起……",
    "voice": "vo_adv_9500092_003",
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "嗎。",
    "voice": null,
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "這可沒得商量，",
    "voice": null,
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n抱歉啊。",
    "voice": null,
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "不管如何努力──",
    "voice": "vo_adv_9500092_004",
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "總有一天",
    "voice": null,
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "其中一方都會先死去，",
    "voice": null,
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n有一人",
    "voice": null,
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "會被留下。",
    "voice": null,
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "就像我……",
    "voice": null,
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "被雙胞胎妹妹留下那樣。",
    "voice": null,
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "騎士公，",
    "voice": "vo_adv_9500092_005",
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "我啊，",
    "voice": null,
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "也並不討厭你。",
    "voice": null,
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "但是，",
    "voice": null,
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "我已經不想再留下同伴，",
    "voice": null,
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "也不想被留下。",
    "voice": null,
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "……所以，",
    "voice": null,
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "抱歉──",
    "voice": null,
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "…………啊？",
    "voice": "vo_adv_9500092_006",
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "啊……",
    "voice": "vo_adv_9500092_007",
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "你說的難道是",
    "voice": null,
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "那個？",
    "voice": null,
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n就像之前我被幹掉時，",
    "voice": null,
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "附到你身上那樣嗎？",
    "voice": null,
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "──哈。",
    "voice": null,
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "啊哈哈！！",
    "voice": "vo_adv_9500092_008",
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n這樣啊──",
    "voice": null,
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "那不錯啊！",
    "voice": null,
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "也就是說，",
    "voice": "vo_adv_9500092_009",
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "要是我先死，",
    "voice": null,
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "就又要附到你身上嗎？",
    "voice": null,
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "──受不了，",
    "voice": null,
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "真拿你沒辦法。",
    "voice": null,
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "你這樣的傻子，",
    "voice": null,
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "讓人實在沒辦法挪開視線。",
    "voice": null,
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "……但是，",
    "voice": "vo_adv_9500092_010",
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "不管是誰要變成幽靈，",
    "voice": null,
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "我跟你",
    "voice": null,
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "都不能在這裡掛掉。",
    "voice": null,
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n幻境龍后──",
    "voice": null,
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "先去給那婊子",
    "voice": null,
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "一點顏色瞧瞧再說吧。",
    "voice": null,
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "那麼，",
    "voice": "vo_adv_9500092_011",
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "打起精神來吧，死黨──",
    "voice": null,
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "呃，",
    "voice": null,
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "不對。",
    "voice": null,
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "總覺得",
    "voice": null,
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "很不好意思……",
    "voice": null,
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "請多指教啊，",
    "voice": "vo_adv_9500092_012",
    "unit_id": 135941
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "頭家。",
    "voice": null,
    "unit_id": 135941
  }
]
