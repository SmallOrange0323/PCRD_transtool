[
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "──發生過這樣的事情呢。",
    "voice": "vo_adv_1002002_000",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "從那以後，他就陪我修行了好幾次。",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "原來如此呀……",
    "voice": "vo_adv_1002002_001",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "優衣……妳呀，喜歡上了那傢伙吧？",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "喜、喜喜喜！？",
    "voice": "vo_adv_1002002_002",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "騎士先生才、才不是我喜歡的對象……！",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "比起這件事，還是專心挑選食材吧！",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "吶！",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我知道啦。真是拿妳沒辦法。",
    "voice": "vo_adv_1002002_003",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n……",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我說優衣，站在那邊的人，",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n不就是那傢伙嗎？",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "真是的……真琴妳呀，",
    "voice": "vo_adv_1002002_004",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "就打算這樣嘲弄我……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "啊咧？",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "騎士先生！？",
    "voice": "vo_adv_1002002_005",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "你、你好呢！",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n天氣真好呢！你、你在做什麼呢？",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "喂喂……",
    "voice": "vo_adv_1002002_006",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n妳整個人也變得太僵硬了",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "原來騎士先生你打算去吃午飯呀。",
    "voice": "vo_adv_1002002_007",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "這樣呀……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "……我說優衣。",
    "voice": "vo_adv_1002002_008",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "機會難得，",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n妳就試試也邀請那傢伙一起吃午飯吧。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "欸欸欸欸！？",
    "voice": "vo_adv_1002002_009",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "不、不行啦……！我還沒有心理準備……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "沒、",
    "voice": "vo_adv_1002002_010",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "沒什麼事！",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我、我們也差不多該走了呢！",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "那我們就告辭了……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……騎士先生。",
    "voice": "vo_adv_1002002_011",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "那個，如果你方便的話……可以一起吃頓午飯嗎？",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "材料的話剛好現在正在採買，",
    "voice": "vo_adv_1002002_012",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n而且吃飯的話大家一起吃會更好吃……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "你覺得……如何呢？",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "可以嗎……？",
    "voice": "vo_adv_1002002_013",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "那得快點去採購才行呢！",
    "voice": "vo_adv_1002002_014",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "……真是太好啦，優衣。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "background",
    "bg_id": "500040"
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我回來了～。",
    "voice": "vo_adv_1002002_015",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "騎士先生你請坐吧。",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n料理會由我和真琴來製做的。",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "就是這樣，所以你乖乖的等吧。",
    "voice": "vo_adv_1002002_016",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "……我說優衣。雖然我知道妳喜歡那傢伙，",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n但契機是什麼啊？",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……妳可別反應得太大聲嚷嚷喔？",
    "voice": "vo_adv_1002002_017",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "其實──",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "──妳說那傢伙可能是經常在夢中出現的騎士先生？",
    "voice": "vo_adv_1002002_018",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "這樣啊……雖然之前有聽妳說了，所以不難理解如果",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n那樣的傢伙出現了，妳會採取這樣的態度……",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "好！這裡就由我為了青梅竹馬的妳，幫妳一把吧！",
    "voice": "vo_adv_1002002_019",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "真琴！？",
    "voice": "vo_adv_1002002_020",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "糟啦，我忘了工作上還有些事沒做啊！",
    "voice": "vo_adv_1002002_021",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我出門一趟，那午飯就交給你們兩人處理囉！",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n我馬上回來！",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "這麼突然……！",
    "voice": "vo_adv_1002002_022",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……真的離開了呀",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "。",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "沒、沒問題的！",
    "voice": "vo_adv_1002002_023",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "料理我自己一人也做得來，請不用擔心。",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "首先得把材料準備好才是……",
    "voice": "vo_adv_1002002_024",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "不用了，你坐著就可以了呢。",
    "voice": "vo_adv_1002002_025",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……那我還、還是拜托你好了。",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "啊咧！？為什麼你在我後面！？",
    "voice": "vo_adv_1002002_026",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n明明直到剛才還是坐著的……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "呀啊！",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "嗚……不……",
    "voice": "vo_adv_1002002_027",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "不會痛？",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n啊咧……？",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……騎騎騎、騎士先生！？",
    "voice": "vo_adv_1002002_028",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n為、為為為為什麼！？",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "（為什麼我、我會被騎士先生抱著呢！？",
    "voice": "vo_adv_1002002_029",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "被這麼近距離緊盯著看的話，我……！）",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我……我我我我我……！",
    "voice": "vo_adv_1002002_030",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n我……！",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "對不起！！",
    "voice": "vo_adv_1002002_031",
    "unit_id": 100211
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "（啊啊……",
    "voice": "vo_adv_1002002_032",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n難得真琴為我製造了二人獨處的機會……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我真是大笨蛋！）",
    "voice": null,
    "unit_id": 100211
  }
]
