    "voice": "vo_adv_1246002_067",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "雖然被說是媽媽的味道，讓我有點驚訝，",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n不過，看你吃得那麼開心，真是太好了！",
    "voice": null,
    "unit_id": 124611
  },
