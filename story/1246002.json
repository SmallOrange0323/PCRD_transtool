[
  {
    "type": "background",
    "bg_id": "501471"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在離開神殿的歸途上，美里與{0}",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n路過新年熱鬧滾滾的大街。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "啊，",
    "voice": "vo_adv_1246002_000",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "你肚子會餓嗎？",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n難得來到大街，要不要吃點什麼？",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "不知道有沒有賣些什麼新年料理呢……",
    "voice": "vo_adv_1246002_001",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀哎呀，",
    "voice": "vo_adv_1246002_002",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "那就麻煩你帶路囉♪",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "別用跑的～",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "「大江戶風餐廳」……？",
    "voice": "vo_adv_1246002_003",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "嗯，",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "店面看來頗有風情呢♪",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n還擺了許多豎旗……",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "「迎新春！",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "供應年糕湯！」",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "……\\n宣傳這樣寫著呢！",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "年糕湯很不錯呢～～～",
    "voice": "vo_adv_1246002_004",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n可以吃到大江戶風的年糕湯嗎～♪",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n嗯呵呵，",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "真令人期待。",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "那麼，我們快進去吧……",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "啊，這樣啊～？",
    "voice": "vo_adv_1246002_005",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "門簾的確",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "還沒有掛出來。",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "話說回來，{0}",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "你還真清楚呢～",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "咦，",
    "voice": "vo_adv_1246002_006",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "因為你之前曾在這裡打工過，所以才知道的嗎～？",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "工作勤奮值得嘉獎～",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "很好很好♪",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "唔，抱歉。",
    "voice": "vo_adv_1246002_007",
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n你們是來用餐的客人嗎？",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "等等，",
    "voice": "vo_adv_1246002_008",
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "你不是先前曾在這裡打工過的小伙子嗎！",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "\\n",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "呿、你這傢伙！",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "竟然帶著這麼漂亮的姑娘過來！",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "\\n",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "……呼、",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "呼……",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀哎呀，",
    "voice": "vo_adv_1246002_009",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "你沒事吧……？",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "……嗯？",
    "voice": "vo_adv_1246002_010",
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "啊，",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "說來慚愧，",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "\\n因為新年玩過頭了，覺得有點不太舒服。",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "我只要好好睡一覺就沒事了！",
    "voice": "vo_adv_1246002_011",
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "\\n因為現在還在準備中，可能會耽擱點時間，",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "\\n請你們再稍待片刻……",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "嗚唔！",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "呼、",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "呼",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "……呼！！",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "是啊，",
    "voice": "vo_adv_1246002_012",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "看起來很不舒服的樣子……",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "你還是多休息比較好吧……？",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "嗚唔……",
    "voice": "vo_adv_1246002_013",
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "不，",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "我不能休息……！",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "\\n",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "每年過新年的時候，",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "都會有許多常客，",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "\\n過來吃我煮的年糕湯呢……！",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "其中有不少是大江戶出身的客人，",
    "voice": "vo_adv_1246002_014",
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "新年期間無法返鄉，得留下來工作。",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "\\n招待他們享用一碗年糕湯，",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "可說是我的使命……！！",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "\\n",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "……嗚唔",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "……！！",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀，",
    "voice": "vo_adv_1246002_015",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "老闆大叔！",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "你看看……",
    "voice": "vo_adv_1246002_016",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "你連站都站不穩了……！",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n我能深切感受到老闆大叔的熱忱，",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n不過，你這樣子是不可能開店的……",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "嗚唔……！",
    "voice": "vo_adv_1246002_017",
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "可是……！",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "……那個，{0}。",
    "voice": "vo_adv_1246002_018",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "嗯呵呵，",
    "voice": "vo_adv_1246002_019",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "果然是這樣～",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我就知道你會這麼說～！",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "所以說……",
    "voice": "vo_adv_1246002_020",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "老闆大叔。",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n我們想",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n代替你來開店，",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "你覺得呢～？",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "……喂喂，",
    "voice": "vo_adv_1246002_021",
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "我很感激你們願意幫忙。",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "\\n但是，你們太低估這份工作，我也會很困擾……",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "\\n",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "我專研此道已有30年之久，",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "你們以為有那麼容易重現我的味道嗎！",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "你說得沒錯。",
    "voice": "vo_adv_1246002_022",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我沒辦法製作店裡所有的料理。",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "不過，",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "如果只限一道的話……",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "可以請你只教我怎麼煮年糕湯嗎？",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "……我之前的確曾教過你這小伙子",
    "voice": "vo_adv_1246002_023",
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "如何備料。",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "\\n如果只有年糕湯，或許有可能辦到……",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "\\n",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "不過……",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "我先問個問題。",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "妳為什麼會提出這請求……？",
    "voice": "vo_adv_1246002_024",
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "\\n",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "我們今天才第一次見面，",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "妳應該沒有義務幫這個忙吧。",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "老大",
    "words": "\\n既然如此，為什麼會……！",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "當然是因為……",
    "voice": "vo_adv_1246002_025",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124611
