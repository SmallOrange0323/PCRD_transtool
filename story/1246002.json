    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "常客1",
    "words": "腦海中便立即浮現出媽媽的笑容！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "常客1",
    "words": "\\n該怎麼說呢，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "常客1",
    "words": "味道完全不一樣……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "常客1",
    "words": "但是，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
