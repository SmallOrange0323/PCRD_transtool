[
  {
    "type": "background",
    "bg_id": "501200"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "忽然出現的黑色精靈之力，使得可可蘿的存在即將消失。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在重視的眾人逐漸淡忘自己時，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n可可蘿選擇獨自離開蘭德索爾，踏上旅程。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "總算、",
    "voice": "vo_adv_5059001_000",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "抵達了呢。",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……",
    "voice": "vo_adv_5059001_001",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……真是奇妙。",
    "voice": "vo_adv_5059001_002",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n明明離開的時間並沒有過多久。",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這樣一看，",
    "voice": "vo_adv_5059001_003",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n感覺卻相當懷念。",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "首先，",
    "voice": "vo_adv_5059001_004",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "得這麼說一句。",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下回來了。",
    "voice": "vo_adv_5059001_005",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "精靈族之村──",
    "voice": "vo_adv_5059001_006",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下的故鄉。",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "如果是這座祭祀精靈",
    "voice": "vo_adv_5059001_007",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "並與其共存",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "的村莊……",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n或許有線索釐清",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下目前所遇到的狀況。",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "像是無法順利叫出精靈的事，",
    "voice": "vo_adv_5059001_008",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n還有那隻在下不記得",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "曾操控過的黑色精靈。",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "以及……",
    "voice": "vo_adv_5059001_009",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下重視的人們",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n逐漸淡忘",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下的事……",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "關於",
    "voice": "vo_adv_5059001_010",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "黑色精靈的狀況，",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n就先來問問村裡的長老，",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "也就是在下的父親吧……！",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……只是",
    "voice": "vo_adv_5059001_011",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "有個問題……",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "哎呀？",
    "voice": "vo_adv_5059001_012",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "您是……",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "！",
    "voice": "vo_adv_5059001_013",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那、",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那個，",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下……",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "您是冒險者嗎？",
    "voice": "vo_adv_5059001_014",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n歡迎來到",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "精靈族之村。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是、",
    "voice": "vo_adv_5059001_015",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是的……",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "幸會。",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "她果然",
    "voice": "vo_adv_5059001_016",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不記得",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下呢。",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n明明從前，",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下有跟她打過好幾次招呼的……",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "雖然在下很清楚",
    "voice": "vo_adv_5059001_017",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "愛梅斯大人所說的「存在會消失」",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n是什麼意思……",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不過還是不免感到落寞。",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "……您怎麼了？",
    "voice": "vo_adv_5059001_018",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不，",
    "voice": "vo_adv_5059001_019",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "沒什麼……",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請您不要介意。",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "可能是長途跋涉而有點疲倦了。",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不說那個，",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "方便請教一下嗎？",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "好的，",
    "voice": "vo_adv_5059001_020",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "什麼事？",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請問村子的長老在嗎？",
    "voice": "vo_adv_5059001_021",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在下",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "有事情想求教……",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "啊……",
    "voice": "vo_adv_5059001_022",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "長老",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "是嗎……？",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "很抱歉，",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "長老目前",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "不在村子裡。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n他到外頭去進行",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "精靈的相關研究了……",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……這樣嗎……",
    "voice": "vo_adv_5059001_023",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "真遺憾……",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "那個，",
    "voice": "vo_adv_5059001_024",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "您到這兒來的路上……",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "一路安好嗎？",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "路上？",
    "voice": "vo_adv_5059001_025",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n呃，",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "沒有特別的狀況……",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "那真是太好了。",
    "voice": "vo_adv_5059001_026",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n村子",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "附近正好有危險的──",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 14411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "！",
    "voice": "vo_adv_5059001_027",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這道",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "聽來像吼叫聲的是……！？",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "……請您從這裡，",
    "voice": "vo_adv_5059001_028",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "看看的森林深處。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那、",
    "voice": "vo_adv_5059001_029",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那是……",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "精靈",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "嗎……？",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n看起來非常巨大……",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "黑色精靈",
    "words": "…………",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "！？",
    "voice": "vo_adv_5059001_030",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您是……",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "怎麼會在",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這時出現……！？",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "黑色精靈",
    "words": "……！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "怎麼回事……？",
    "voice": "vo_adv_5059001_031",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n難不成",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是被那隻巨大精靈的叫聲……",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "給引出來的……！？",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "嗚……！",
    "voice": "vo_adv_5059001_032",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "咳咳，",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "咳咳……！",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "忽然……",
    "voice": "vo_adv_5059001_033",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "渾身、",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "無力……？",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "難道、",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下已經……？　",
    "voice": null,
