  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下會",
    "voice": "vo_adv_5059001_034",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就此消失嗎……？",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n消失之後也絲毫不會、",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "成為任何人的回憶……？",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主、",
    "voice": "vo_adv_5059001_035",
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "人",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……！",
    "voice": null,
    "unit_id": 105914
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "您、您沒事吧！？",
    "voice": "vo_adv_5059001_036",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "有沒有人呀！",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n快來人呀！",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "同時，在蘭德索爾的鎮上。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……唉～",
    "voice": "vo_adv_5059001_037",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小凱留，",
    "voice": "vo_adv_5059001_038",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "妳好像心不在焉的。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "如果有什麼煩惱，請儘管對我說喔。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "倒也不是煩惱啦。",
    "voice": "vo_adv_5059001_039",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "只是最近老覺得少了些甚麼，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "或是說一直覺得不太對勁……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……妳也是嗎？",
    "voice": "vo_adv_5059001_040",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳問我也……",
    "voice": "vo_adv_5059001_041",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "呃……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳也一樣？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是呀……",
    "voice": "vo_adv_5059001_042",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n就像是無論吃了多少飯，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "都沒有飽足感那樣……",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我知道貪吃佩可是講正經的，",
    "voice": "vo_adv_5059001_043",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n可是由她來比喻很讓人擔心伙食費耶……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "寂寞……",
    "voice": "vo_adv_5059001_044",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "或許是這樣沒錯。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這是為什麼呢？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "近來大家一起相處的時間很多，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n明明就不可能感到寂寞才是……",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "唉，",
    "voice": "vo_adv_5059001_045",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "搞不懂的事情放在心上也沒意義。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我們難得上街一趟，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就隨便買點東西轉換心情吧。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "說得也是。",
    "voice": "vo_adv_5059001_046",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那我",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "想到市場去！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "說不定有在賣什麼罕見的食材～♪",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我不是說要轉換心情嗎！",
    "voice": "vo_adv_5059001_047",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n那不就跟平常沒兩樣了！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "像這種時候",
    "voice": "vo_adv_5059001_048",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就是要擬定一些活動計畫啦。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "想去哪裡、",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "想做什麼，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "光是",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "在腦中想像就很開心了，對吧？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "辦活動不錯耶☆",
    "voice": "vo_adv_5059001_049",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n既然如此，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我想去旅行！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "對了，",
    "voice": "vo_adv_5059001_050",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我們之前有抽到招待券去了海邊一趟呢～",
