  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "唔唔～",
    "voice": "vo_adv_6019204_000",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我很想和鈴奈和好，",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "可是我第一次遇到這種事，不知道該怎麼辦才好……",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "喏，",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "如果是你，",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "會怎麼和她和好？",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "真是的，",
    "voice": "vo_adv_6019204_001",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你不用說我也知道啦～！",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "果然",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "只能那樣做了呢……",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "感覺",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "多虧了你，",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我好像豁然開朗了。",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "……",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "謝謝你。",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "沒想到",
    "voice": "vo_adv_6019204_002",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你會說這麼孩子氣的話呢。",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "啊，",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你該不會是把我當笨蛋吧……？",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "不過，",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "這種時候",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "仰賴占卜",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "或許也是一個方法呢。",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "啊？　",
    "voice": "vo_adv_6019204_003",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "要是什麼都不做，暑假就要結束了，",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n鈴奈的活動就是明天喔？　",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "……",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "沒錯，",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "得儘快才行！",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n不要再光想要怎麼做了，",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "要快點和鈴奈道歉才行～！",
    "voice": null,
    "unit_id": 110211
  }
]
