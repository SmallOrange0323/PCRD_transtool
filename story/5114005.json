    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "條紋",
    "words": "喵～！",
    "voice": "vo_adv_5114005_022",
    "unit_id": 1715
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "好厲害喵，",
    "voice": "vo_adv_5114005_023",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "生意超興隆喵！",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "輕輕鬆鬆就超過目標營業額了喵！",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n繼續保持喵！",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "still",
    "still_id": "511400502"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "不斷增加──",
