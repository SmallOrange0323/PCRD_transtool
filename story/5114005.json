  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "雖、",
    "voice": "vo_adv_5114005_024",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "雖然很忙──",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "但客人增加了好幸福喵──！",
    "voice": "vo_adv_5114005_025",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "今天也儘管來吧喵──！",
    "voice": "vo_adv_5114005_026",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n放馬過來吧喵──！",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "黑",
    "words": "喵～",
    "voice": "vo_adv_5114005_027",
    "unit_id": 1714
  },
  {
    "type": "dialogue",
    "name": "黑",
    "words": "喵……",
    "voice": null,
    "unit_id": 1714
  },
  {
    "type": "dialogue",
    "name": "黑",
    "words": "\\n喵嗚……？",
    "voice": null,
    "unit_id": 1714
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "怎麼了喵？",
    "voice": "vo_adv_5114005_028",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
