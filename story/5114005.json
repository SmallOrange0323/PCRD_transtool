  {
    "type": "dialogue",
    "name": "旁白",
    "words": "「Naschkatze」的來客數順利地提升。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n某天早上，珠希正在前往店裡的途中──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "呼喵……",
    "voice": "vo_adv_5114005_000",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n早晨的陽光真刺眼喵……",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "早起好痛苦喵。",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "因為昨天還有幻影貓的工作……",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "老虎",
    "words": "喵嗚……",
    "voice": "vo_adv_5114005_001",
    "unit_id": 1712
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "你也一樣嗎喵……",
    "voice": "vo_adv_5114005_002",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "昨天客人也好多，",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "能者多勞啊喵……",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "珠希！",
    "voice": "vo_adv_5114005_003",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n妳太慢了，",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "快進店裡做好準備！",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "莫妮卡……！？",
    "voice": "vo_adv_5114005_004",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n現在應該還沒到上班時間啊……",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "現在不是悠哉的時候了！",
    "voice": "vo_adv_5114005_005",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "妳快看！",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "已經有這麼多客人了啊！",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "……嗯喵……？",
    "voice": "vo_adv_5114005_006",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "客人……？",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "哇──！？",
    "voice": "vo_adv_5114005_007",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這、",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這、",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這是怎麼回事喵！？",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "現在根本還沒到營業時間啊喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "女顧客１",
    "words": "我從昨天晚上一直等到現在喔。",
    "voice": "vo_adv_5114005_008",
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "女顧客１",
    "words": "\\n",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "女顧客１",
    "words": "差不多可以進去了吧？",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "女顧客１",
    "words": "\\n我好期待喔～！",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我、",
    "voice": "vo_adv_5114005_009",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我知道了喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我們馬上就開始營業喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "still",
    "still_id": "511400501"
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "有這麼多的客人前來光顧，",
    "voice": "vo_adv_5114005_010",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n真是開心到要慘叫了哪！",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "可以再多來一點沒問題喔！",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "白",
    "words": "喵～！",
    "voice": "vo_adv_5114005_011",
    "unit_id": 1713
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "接著，顧客人數不斷地增加──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男顧客１",
    "words": "不好意思──！",
    "voice": "vo_adv_5114005_012",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男顧客１",
    "words": "我想要點餐～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "好的──！",
    "voice": "vo_adv_5114005_013",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "我要點鯛魚燒！",
    "voice": "vo_adv_5114005_014",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "好的！",
    "voice": "vo_adv_5114005_015",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "請稍等！",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "鯛魚燒馬上就要烤好囉！",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "女顧客２",
    "words": "我",
    "voice": "vo_adv_5114005_016",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女顧客２",
    "words": "想要特選懷舊點心拼盤",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女顧客２",
    "words": "加奶茶的套餐。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "好的喵～！",
    "voice": "vo_adv_5114005_017",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n特選懷舊點心拼盤有附繽紛果凍喵♪",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "男顧客２",
    "words": "我要十隻特大鯛魚燒──！",
    "voice": "vo_adv_5114005_018",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "十……",
    "voice": "vo_adv_5114005_019",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n客人，",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "您這樣不會吃太多了嗎……？",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "黑",
    "words": "喵嗚。",
    "voice": "vo_adv_5114005_020",
    "unit_id": 1714
  },
  {
    "type": "dialogue",
    "name": "黑",
    "words": "\\n喵～！",
    "voice": null,
    "unit_id": 1714
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "好的喵～！",
    "voice": "vo_adv_5114005_021",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "您還要點貓咪零嘴套餐，我了解了喵！",
