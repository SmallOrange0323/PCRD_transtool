    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n這麼一來，",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
