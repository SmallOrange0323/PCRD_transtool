  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我們會的。",
    "voice": null,
    "unit_id": 133811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "要來些可麗餅當茶點嗎？",
    "voice": "vo_adv_5201323_003",
    "unit_id": 133711
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……",
    "voice": "vo_adv_5201323_004",
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "雖然我沒資格說，",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n但妳們還真的覺得沒問題嗎？",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "甚至要拿權能造出喝茶桌椅，",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "就算是我也認為太超過了喔。",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "騙妳的騙妳的。",
    "voice": "vo_adv_5201323_005",
    "unit_id": 133711
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n幫忙打，",
    "voice": null,
    "unit_id": 133711
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我會幫忙打啦。",
    "voice": null,
    "unit_id": 133711
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133711
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "讓我們同心協力",
    "voice": null,
    "unit_id": 133711
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "打倒那傢伙囉～！",
    "voice": null,
    "unit_id": 133711
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "真是任性呢。",
