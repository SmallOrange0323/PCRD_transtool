[
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "為什麼……",
    "voice": "vo_adv_5012322_000",
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "為什麼我被打倒了……！",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "\\n被妳這樣的人……",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "像以前的我，",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "\\n什麼都辦不到的愚者……！！",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "正如你所說，",
    "voice": "vo_adv_5012322_001",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n我只會看著別人，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n但卻是個什麼都不會的愚者……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "但是，",
    "voice": "vo_adv_5012322_002",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "這麼懦弱的我，卻也有著夥伴守候。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "所以我",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "現在才站在這裡。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "連這樣的我都做得到，",
    "voice": "vo_adv_5012322_003",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "妳一定也可以。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "現在開始也不遲。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n和大家……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "還有我一起重新開始吧……！",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "我才不認同……",
    "voice": "vo_adv_5012322_004",
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "我怎麼可能會認同你們！！",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "不要說絕望……",
    "voice": "vo_adv_5012322_005",
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "希望和……",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "世界也是讓人憎恨！",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "\\n整個世界都",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "永遠的墜落到無盡的黑暗裡吧！",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我、",
    "voice": "vo_adv_5012322_006",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我不會讓妳這麼做的！",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "世界、",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "還有妳",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "都會被救贖的……！",
    "voice": null,
    "unit_id": 105511
  }
]
