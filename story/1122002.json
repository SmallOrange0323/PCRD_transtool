  {
    "type": "dialogue",
    "name": "黑商",
    "words": "仔細一瞧，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "黑商",
    "words": "妳是剛才在店內的傢伙吧。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "黑商",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "黑商",
    "words": "原來如此，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "黑商",
    "words": "交易現場被人看到了啊。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "黑商",
    "words": "\\n這麼說的話，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "黑商",
    "words": "剛才的客人已經被逮到了？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "你說得沒錯。",
    "voice": "vo_adv_1122002_062",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n……你如果肯乖乖投降就幫大忙了。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "黑商",
    "words": "嘿，",
    "voice": "vo_adv_1122002_063",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "黑商",
    "words": "真是愚蠢的小妹妹。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "黑商",
    "words": "\\n我是不知道妳是偵探還是誰，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "黑商",
    "words": "竟然敢一個人大搖大擺地跑來。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "黑商",
    "words": "\\n這玩意兒的力量，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "黑商",
    "words": "妳就好好見識見識吧！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "果然是打算使用魔導具……！　",
    "voice": "vo_adv_1122002_064",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "——就是現在，",
    "voice": "vo_adv_1122002_065",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "助手先生！",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "background",
    "bg_id": "500890"
  },
  {
    "type": "dialogue",
    "name": "黑商",
    "words": "什麼！？",
    "voice": "vo_adv_1122002_066",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "黑商",
    "words": "\\n竟然還躲了一個人！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "他是笨蛋情侶的另外一位唷。",
    "voice": "vo_adv_1122002_067",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n你似乎記得我的樣子，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "但卻好像不記得他呢。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "做得好，助手先生。",
    "voice": "vo_adv_1122002_068",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n你那個若無其事的演技，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "似乎有好好發揮作用呢。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "黑商",
    "words": "可惡，",
    "voice": "vo_adv_1122002_069",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "黑商",
    "words": "把那東西還來！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "那可不行。",
    "voice": "vo_adv_1122002_070",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "給我束手就擒吧——",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "束縛之徑！",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "黑商",
    "words": "可、",
    "voice": "vo_adv_1122002_071",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "黑商",
    "words": "可惡……！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "黑商",
    "words": "\\n不過是區區的偵探……！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "呵呵。",
    "voice": "vo_adv_1122002_072",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n區區的偵探也很能幹對吧？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "辛苦你了，",
    "voice": "vo_adv_1122002_073",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "助手先生。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n能順利逮捕犯人真是太好了。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "他之後",
    "voice": "vo_adv_1122002_074",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "將會接受審問。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "得逼他吐出有關魔導具的情報才行呢。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "……呼。",
    "voice": "vo_adv_1122002_075",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "啊，呃……",
    "voice": "vo_adv_1122002_076",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "在助手先生看來，",
    "voice": "vo_adv_1122002_077",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n我今天",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "感覺如何？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "！　",
    "voice": "vo_adv_1122002_078",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "是、",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "是這樣嗎？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n這次……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "嗯，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "看來你不是在說謊呢。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "你、",
    "voice": "vo_adv_1122002_079",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "你那表情是什麼意思？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "露出一臉不可思議的表情。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "別看我這樣，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我可是很在意的喔。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "完全不像個偵探……",
    "voice": "vo_adv_1122002_080",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n什麼的，我不想被人",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這麼認為",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "呢。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "或許只要是小孩子，",
    "voice": "vo_adv_1122002_081",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n都會很憧憬魔法少女……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "但對我來說，",
    "voice": "vo_adv_1122002_082",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "就是「名偵探」。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "然後我",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "現在也依然對那點抱持憧憬。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "所以那個……",
    "voice": "vo_adv_1122002_083",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "唯獨這一點",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我是絕不會退讓的。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "不過，",
    "voice": "vo_adv_1122002_084",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "能聽到你說我是個很出色的偵探，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n讓我覺得心情舒暢多了。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "謝謝，",
    "voice": "vo_adv_1122002_085",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "助手先生。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "你今天也是一名",
    "voice": "vo_adv_1122002_086",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "很出色的「偵探助手｣喔。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "解決一個事件的霞，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n又再次確認了自己兒時就對「名偵探」的憧憬。",
    "voice": null,
    "unit_id": null
  }
]
