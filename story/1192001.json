[
  {
    "type": "background",
    "bg_id": "500863"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在積雪的冬季牧場裡，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n真陽一邊翻修設施，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "一邊唸叨著。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "唔──",
    "voice": "vo_adv_1192001_000",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "果然到處都有問題啊……",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "在降下大雪以前",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "必須都修好才行。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "雖然靠我的雙手可以修復到某種程度啦，",
    "voice": "vo_adv_1192001_001",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n但還是需要請專業的師傅，",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n來進行大規模的整修吧。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "可是",
    "voice": "vo_adv_1192001_002",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "又不能小看費用……",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "還是我再來開發新商品",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "呢？",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "剛好有客人會來光顧，",
    "voice": "vo_adv_1192001_003",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "也差不多到這個季節啦。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n開發聖誕節周邊商品應該還不錯吧。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "嗯，",
    "voice": "vo_adv_1192001_004",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "新商品……",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "聖誕節的新商品",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "來賣剩蛋？",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n聖誕老人每年要包禮物",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "也很惱人……",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "嗯嗯？",
    "voice": "vo_adv_1192001_005",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "剛剛那句好像還不錯？",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "節奏不錯還有諧音，",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "說不定可以用在新段子上耶。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "不過，",
    "voice": "vo_adv_1192001_006",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "這樣就不是開發商品，",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "而是開發新哏了啦！",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "啊啊，",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "怎麼辦……",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "老哥，",
    "voice": "vo_adv_1192001_007",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "你來玩啊？",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "不好意思",
    "voice": "vo_adv_1192001_008",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "等我一下啦。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我先把這裡的柵欄修好。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "最近，",
    "voice": "vo_adv_1192001_009",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "來牧場的遊客",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "慢慢變多了。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "大家都是為了聖誕節，",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "來買牛奶、",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n奶油之類的蛋糕材料。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "當然，",
    "voice": "vo_adv_1192001_010",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "客人變多我很開心，",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n只是相對的，",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "設施的修繕和",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "道路的整理就很辛苦啦。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "難得過來一趟，",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我總不能讓大家受著傷回去吧。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "剷雪、",
    "voice": "vo_adv_1192001_011",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "翻修柵欄、",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "裝飾……",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "要做的事情多到跟山一樣高。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "即使是冬天也有一堆事要做的啦。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "老哥，",
    "voice": "vo_adv_1192001_012",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "你東張西望地在看什麼啊？",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n那片雪景",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "有那麼稀奇嗎？",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "對喔。",
    "voice": "vo_adv_1192001_013",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "在蘭德索爾，",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n很少會積這麼厚的雪吧。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "這對我來說很稀鬆平常，",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "已經見怪不怪了啦。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我小時候",
    "voice": "vo_adv_1192001_014",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "常坐著雪橇到處去玩呢。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "真懷念……",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "你想看雪橇嗎？",
    "voice": "vo_adv_1192001_015",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "去倉庫找一找應該會有。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "不說了，",
    "voice": "vo_adv_1192001_016",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "要趕緊工作啦。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我可沒時間悠哉地玩耍呢。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "還得趕快剷雪才行。",
    "voice": "vo_adv_1192001_017",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "老哥，",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "你要是小看雪可是會後悔的喔。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "沒錯沒錯，",
    "voice": "vo_adv_1192001_018",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "雪的重量壓在建築物上，",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n就會發出這種聲音……",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "啊────！",
    "voice": "vo_adv_1192001_019",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "倉、",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "倉倉、",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "倉庫！",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n那邊的倉庫垮了啦！",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "老哥！",
    "voice": "vo_adv_1192001_020",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "剛剛可不是在搞笑喔！",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "哎呀，",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "現在不是吐槽的時候啦！",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "動物群",
    "words": "嘶嘶────────！！\\n哞────────！！",
    "voice": "vo_adv_1192001_021",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "哇哇！",
    "voice": "vo_adv_1192001_022",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "剛剛的聲音嚇到正在放牧的動物啦！",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n得趕快安撫牠們！",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我要去追牠們啦！",
    "voice": "vo_adv_1192001_023",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "喂────！",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "等等我──！！",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "動物群",
    "words": "嘶嘶────\\n哞────",
    "voice": "vo_adv_1192001_024",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "大家，",
    "voice": "vo_adv_1192001_025",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "已經沒事了。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "只要待在這個馬廄裡就可以安心啦～",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "不過，",
    "voice": "vo_adv_1192001_026",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我幾乎都抓回來了，",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "怎麼好像還少了幾頭？",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n都去哪裡了呢……",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "嗯？",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "哎呀……",
    "voice": "vo_adv_1192001_027",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "這裡的柵欄",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
