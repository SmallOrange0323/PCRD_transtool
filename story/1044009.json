    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "啊啊啊啊……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "啊啊啊",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "啊！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "怎麼回事？",
    "voice": "vo_adv_1044009_071",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "剛剛那是……",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你怎麼了？",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "露出那種表情。",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身嗎？",
    "voice": "vo_adv_1044009_072",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身沒事喔？",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n不如說充滿力量……",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "哦？",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "哦哦哦？",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "恢復了……",
    "voice": "vo_adv_1044009_073",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n明明妾身也沒碰觸你……",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不，",
    "voice": "vo_adv_1044009_074",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "等一下，",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n要高興還太早了，",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "因為過去也偶爾會發生這事。",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這種時候要是得意忘形，",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "馬上就會失去力量而變小……",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "沒變小啊。",
    "voice": "vo_adv_1044009_075",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n不只是外貌……",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "力量也比至今為止都更加充滿全身。",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯，",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這樣一來……",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "來吧！",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "吾之眷屬們啊！",
    "voice": null,
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "使魔們",
    "words": "嘰──！",
    "voice": null,
    "unit_id": 2011
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "呵哈哈哈哈哈！",
    "voice": "vo_adv_1044009_076",
    "unit_id": 104411
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "很好很好！",
    "voice": null,
    "unit_id": 104411
  },
