  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在聖德蕾莎女子學院內部，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n那一群正值青春年華的少女們，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n今天依然熱烈聊著女孩子的話題。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500750"
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "然後啊～",
    "voice": "vo_adv_1109005_000",
    "unit_id": 3011
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "他啊～",
    "voice": null,
    "unit_id": 3011
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "\\n說一開始見面的時候，",
    "voice": null,
    "unit_id": 3011
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "\\n好像就一心向著我了耶～",
    "voice": null,
    "unit_id": 3011
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "又在曬恩愛了……",
    "voice": "vo_adv_1109005_001",
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "\\n真是夠了，",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "都聽膩了啦……",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生3",
    "words": "就是說啊，",
    "voice": "vo_adv_1109005_002",
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生3",
    "words": "差不多也該顧慮一下我們了吧。",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生3",
    "words": "\\n",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生3",
    "words": "是說，",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生3",
    "words": "沒想到美衣子真的交到男朋友了呢～",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "啥！？",
    "voice": "vo_adv_1109005_003",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "妳、",
    "voice": "vo_adv_1109005_004",
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "妳幹嘛，琪愛兒……",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "妳怎麼了，",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "突然發出奇怪的聲音……",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生3",
    "words": "是說，",
    "voice": "vo_adv_1109005_005",
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生3",
    "words": "妳那是",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生3",
    "words": "什麼表情啊？",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生3",
    "words": "總之先坐下吧。",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "咦，",
    "voice": "vo_adv_1109005_006",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "等等……",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "美衣子，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "妳說真的嗎！？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "欸嘿，",
    "voice": "vo_adv_1109005_007",
    "unit_id": 3011
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "是真的～☆",
    "voice": null,
    "unit_id": 3011
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "\\n",
    "voice": null,
    "unit_id": 3011
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "我昨天碰巧遇見他，",
    "voice": null,
    "unit_id": 3011
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "兩個人聊得入迷，\\n就自然發展成那樣子了，",
    "voice": null,
    "unit_id": 3011
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 3011
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "呵呵呵……",
    "voice": null,
    "unit_id": 3011
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "怎麼",
    "voice": "vo_adv_1109005_008",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "會那樣子……",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "咦，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "可是……",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "那個人，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "明明說他對戀愛不感興趣的……！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "什麼？　",
    "voice": "vo_adv_1109005_009",
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "美衣子說過那種話嗎？",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生3",
    "words": "她怎麼可能",
    "voice": "vo_adv_1109005_010",
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生3",
    "words": "那樣說呢。",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生3",
    "words": "\\n她可是我們裡面最想談戀愛的。",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "對吧？",
    "voice": "vo_adv_1109005_011",
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "\\n不久前才對送貨員哥哥心動的說。",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "……咦？",
    "voice": "vo_adv_1109005_012",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "啊啊，",
    "voice": "vo_adv_1109005_013",
    "unit_id": 3011
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "那個送貨員。",
    "voice": null,
    "unit_id": 3011
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "\\n",
    "voice": null,
    "unit_id": 3011
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "呵……",
    "voice": null,
    "unit_id": 3011
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "的確，",
    "voice": null,
    "unit_id": 3011
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "有那個人呢。",
    "voice": null,
    "unit_id": 3011
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "咦？　",
    "voice": "vo_adv_1109005_014",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "咦？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "太強了，",
    "voice": "vo_adv_1109005_015",
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "美衣子。",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "\\n明明完全沒有進展，",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "\\n妳竟然已經",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "把他當成過去的男人看待了。",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "欸，",
    "voice": "vo_adv_1109005_016",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "等一下等一下。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n咦？　",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "那跟美衣子交往的男生是？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n不是",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "之前那個……",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "送貨員",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "嗎？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "不是啦，",
    "voice": "vo_adv_1109005_017",
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "記得嗎，",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "就那個人啊。",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "\\n之前琪愛兒也見過一次嘛，",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "那個",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "月學的……",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "\\n",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "名字我忘了，",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "總之就是那個全身散發出我很行的男生。",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "不，那人我連一丁點都不記得，",
    "voice": "vo_adv_1109005_018",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "原來是這樣，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "不是那個送貨員，而是其他的路人啊，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "懂了懂了！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "討厭，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "妳早說嘛！　",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "嚇我一跳呢，真是的！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "呵呵，",
    "voice": "vo_adv_1109005_019",
    "unit_id": 3011
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "琪愛兒好像很開心。",
    "voice": null,
    "unit_id": 3011
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "\\n妳高興的像是自己的事情一樣呢。",
    "voice": null,
    "unit_id": 3011
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "\\n",
    "voice": null,
    "unit_id": 3011
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "謝謝妳！　",
    "voice": null,
    "unit_id": 3011
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "我們",
    "voice": null,
    "unit_id": 3011
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "一定會幸福的！",
    "voice": null,
    "unit_id": 3011
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "喂～！",
    "voice": "vo_adv_1109005_020",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n恭喜學姐，好羨慕妳咻～咻～！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "哦，",
