  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "是怎麼啦。",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "\\n未免太興奮了吧，",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "今天的琪愛兒。",
