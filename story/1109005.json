    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "啊哈哈！",
    "voice": "vo_adv_1109005_022",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n那人被甩了嗎！　",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "真可憐，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "笑死我了～！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n噗嘻嘻嘻嘻，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "肚子好痛……！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "女學生3",
    "words": "真的耶，",
    "voice": "vo_adv_1109005_023",
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生3",
    "words": "看起來超開心的。",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生3",
    "words": "\\n",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生3",
    "words": "怎麼啦琪愛兒，",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生3",
    "words": "發生什麼好事了嗎？",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
