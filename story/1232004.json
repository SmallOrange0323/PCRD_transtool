    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "真是屈辱至極……」",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "……♪",
    "voice": "vo_adv_1232004_045",
    "unit_id": 102331
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「喂你們，",
    "voice": "vo_adv_1232004_046",
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "不准一臉滿足地笑著看我。",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n可惡，",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "人類終究是自私自利的生物──」",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「嗯？",
    "voice": "vo_adv_1232004_047",
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "那是什麼？」",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「小子啊，",
    "voice": "vo_adv_1232004_048",
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "那個放在露台桌上的",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "奇妙東西是什麼啊？」",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「拉麵！？",
    "voice": "vo_adv_1232004_049",
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "那個嗎？",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n咦？",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "你正要吃訂購送來的當地特產拉麵時，",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n我們就來了？」",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「呃，麵條已經吸滿湯汁，",
    "voice": "vo_adv_1232004_050",
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n變成沒有湯汁的粄條了。",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n那樣已經不能吃了吧。」",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「刨冰！？",
    "voice": "vo_adv_1232004_051",
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "咦？",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "你在冰店買了冰塊回來後，自己親手刨的？",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n你製作好嚮往的『彩色刨冰』，",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n現在正要開始享用時，",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "我們來了？」",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「呃，刨冰已經完全融化，",
    "voice": "vo_adv_1232004_052",
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n變成單純的彩色果汁了。」",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「…………」",
    "voice": "vo_adv_1232004_053",
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「對了，綾音，",
    "voice": "vo_adv_1232004_054",
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "人偶劇！",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n我們在開演前，從會場飛奔出來──",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n……啊，",
    "voice": null,
    "unit_id": 2131
