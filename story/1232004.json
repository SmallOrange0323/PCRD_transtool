  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "隔天早上。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "綾音等人和變得親近的普烏人民相約再見後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n踏上回到蘭德索爾的歸途。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「真的耶～",
    "voice": "vo_adv_1232004_000",
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n普烏那群人願意告訴我們安全的回程路，",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "真是幫大忙了。」",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「真是的，",
    "voice": "vo_adv_1232004_001",
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "既然有這種道路，",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "就該把這條路該寫在地圖上吧。",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n什麼",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "『前往普烏的路途非常險峻』",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "啊。",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n這個冒險家其實是偷偷潛入的吧？",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "我們拜他所賜，吃足了苦頭耶。」",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "…………",
    "voice": "vo_adv_1232004_002",
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "…",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "…對不起啦？",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "是我無論如何都想來，",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "耍起性子……",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「不不不！",
    "voice": "vo_adv_1232004_003",
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "這不是綾音的錯啦。",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n畢竟",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "我也想要知道自己的起源。」",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "不過，",
    "voice": "vo_adv_1232004_004",
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我們到頭來還是一無所知……",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n我的任性",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "只是讓你們遭遇危險，",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "最重要的噗吉起源",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "也沒有半點收穫……",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「綾音……",
    "voice": "vo_adv_1232004_005",
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "妳別露出這種表情啦……」",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "可",
    "voice": "vo_adv_1232004_006",
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "是，",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "因為這趟冒險的緣故，",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "噗吉全身",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "變得髒兮兮，",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "還傷痕累累……",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n你一定很痛吧……",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "對不起……",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「……我一點都不痛。",
    "voice": "vo_adv_1232004_007",
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "妳不用這麼溫柔地撫摸我啦。」",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "你騙人……",
    "voice": "vo_adv_1232004_008",
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "很痛吧。",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「…………」",
    "voice": "vo_adv_1232004_009",
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "……奇怪？",
    "voice": "vo_adv_1232004_010",
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "總覺得",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "懸崖的另一頭好刺眼……？",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n太陽……？",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "不對……",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "這是什麼光……",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "background",
    "bg_id": "510080"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "星期日午後。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}家的門鈴響了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "…………！",
    "voice": "vo_adv_1232004_011",
    "unit_id": 102331
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「別這樣，綾音！",
    "voice": "vo_adv_1232004_012",
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "我求求妳千萬不要做這件事！",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "小、",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "小子，",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "沒事沒事！",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "我們沒事，你快幫我趕走綾音！」",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "…………！！",
    "voice": "vo_adv_1232004_013",
    "unit_id": 102331
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「綾音！",
    "voice": "vo_adv_1232004_014",
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "喂，",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "不要把我交出去！",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n都說我死都不要了！",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n就算你找小子幫忙，",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "討厭的東西就是討厭──」",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "…………！",
    "voice": "vo_adv_1232004_015",
    "unit_id": 102331
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「妳說不行？",
    "voice": "vo_adv_1232004_016",
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "不管噗吉說什麼，",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "這件事妳絕不退讓？",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "……呃，",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "她在用有別於平時的堅定眼神，盯著我看啊！」",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「不對，",
    "voice": "vo_adv_1232004_017",
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "就算綾音再三拜託，",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "我也不會退讓喔？",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "我堅決拒絕。",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "請恕我拒絕『那個』！",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n聽好了，",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "妳敢做『那個』看看。",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "我就要和綾音絕交！」",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "…………！！！！",
    "voice": "vo_adv_1232004_018",
    "unit_id": 102331
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「什麼！？",
    "voice": "vo_adv_1232004_019",
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "喂，我都說要絕交了……",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "妳現在",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "完全無視我，要把我交給小子啊！？」",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「啊──",
    "voice": "vo_adv_1232004_020",
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "這樣啊。",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "想必妳是不知道絕交的意思吧？",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "我明白了，我來告訴妳。",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "綾音，",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "首先妳把我放下來，",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "先坐在那裡。",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "聽好了，",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "所謂的絕交啊，",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "是這世上最難受最恐怖──」",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「呃，喂，綾音，",
    "voice": "vo_adv_1232004_021",
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "聽我說話啊──！",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "喂！",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "不要……",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "讓小子看到我的背後啊！」",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "……嗯！",
    "voice": "vo_adv_1232004_022",
    "unit_id": 102331
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「……小子，",
    "voice": "vo_adv_1232004_023",
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "你這傢伙注意到了啊……」",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「啊～啊，",
    "voice": "vo_adv_1232004_024",
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "對啦！",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "我也沒有要隱瞞的意思。",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "我的背上",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "現在全是冰淇淋。」",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「咦？",
    "voice": "vo_adv_1232004_025",
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "你問為什麼？",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "今天啊，",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "我本來要和綾音一起",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "觀賞人偶劇。",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n所以我們直到剛才都待在劇場。」",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「可是，就在公演開始前。",
    "voice": "vo_adv_1232004_026",
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "隔壁小毛頭拿著的冰淇淋",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "沾到了我身上。",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "綾音才會慌張地跑到這裡來，",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "就是這麼回事。」",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「……啊～小子，",
    "voice": "vo_adv_1232004_027",
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "你用同情不已的眼神看著別人的背後呢～",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "可是呢，",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "你的好意造成我的困擾。",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "我不需要同情。",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n我現在的狀況的確很慘。",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "但那又如何！」",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「沾到冰淇淋的玩偶有什麼不對？",
    "voice": "vo_adv_1232004_028",
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "會被警察逮捕嗎？",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "小孩們會嚇到大哭嗎？",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "這怎麼可能啊。",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "所以沒有任何問題。",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "小子，你說對吧？」",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "……",
    "voice": "vo_adv_1232004_029",
    "unit_id": 102331
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "嗯！！",
    "voice": null,
    "unit_id": 102331
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「…………！！！！」",
    "voice": "vo_adv_1232004_030",
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「小子……",
    "voice": "vo_adv_1232004_031",
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "喂，小子啊……",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "你平時，",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n不是連察言觀色的察字都不會寫，",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "是個漫不經心的傢伙嗎。",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "我啊，",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "也很喜歡你這種不足之處喔。」",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「話說，喂，",
    "voice": "vo_adv_1232004_032",
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "你今天是怎麼回事……",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n為什麼會如此機靈。",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "小子，這一點都不像你……」",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "…………！！",
    "voice": "vo_adv_1232004_033",
    "unit_id": 102331
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「我不要！",
    "voice": "vo_adv_1232004_034",
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "別這樣！",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n只有『那個』……",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "千萬不要為我做全身清洗啊────！",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "對玩偶而言，",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "沒有比全身清洗更屈辱的事情了！」",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「你們能夠想像嗎？",
    "voice": "vo_adv_1232004_035",
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n水分以驚濤駭浪之勢滲入全身……",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "泡沫不由分說地襲來……」",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「身體宛如要沉至地底般地變得沉重，",
    "voice": "vo_adv_1232004_036",
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n宛如在濁流下，整個人被任憑沖洗般的感覺……",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "喔喔喔，",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "光是想像就毛骨悚然……」",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「與其被這樣對待，",
    "voice": "vo_adv_1232004_037",
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "我寧願污漬一輩子都黏在背上！",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n就算乾掉生刺也無所謂！",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "所以，求求你們，",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "不要為我做全身清洗……！」",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「小子！",
    "voice": "vo_adv_1232004_038",
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "你是我的夥伴吧？",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "你不會背叛我吧！？」",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「小子！！」",
    "voice": "vo_adv_1232004_039",
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "……………………！！！！",
    "voice": "vo_adv_1232004_040",
    "unit_id": 102331
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「………………",
    "voice": "vo_adv_1232004_041",
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "你這傢伙──！」",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「嗚啊啊啊啊啊啊！",
    "voice": "vo_adv_1232004_042",
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n我要跟你們絕交啦啊啊啊啊啊啊",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "噗嚕噗嚕噗嚕噗嚕……」",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "still",
    "still_id": "123200401"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "微風吹拂……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「嗚、",
    "voice": "vo_adv_1232004_043",
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "嗚嗚……」",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「我被抓去洗了……",
    "voice": "vo_adv_1232004_044",
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n然後，",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "被晾在曬衣繩上……",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n我的靈魂",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "就跟被漂白沒兩樣……",
