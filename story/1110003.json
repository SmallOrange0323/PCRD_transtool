[
  {
    "type": "background",
    "bg_id": "500730"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}收到了一封優妮拜託幫忙購物的信件，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n於是到了蘭德索爾的街上買齊了她所指定的研究用素材，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n接著便造訪了聖德蕾莎女子學院並且正在尋找她的所在之處。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "呀啊！？",
    "voice": "vo_adv_1110003_000",
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "\\n有、",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "有男性……",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "為什麼",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "會來我們的",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "學院……？",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "看起來",
    "voice": "vo_adv_1110003_001",
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "舉止相當可疑呢。",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "\\n",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "東張西望的，",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "似乎是在",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "物色著什麼的模樣……",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "您好？　",
    "voice": "vo_adv_1110003_002",
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "那邊那位男性。",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "\\n不好意思，",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "請問您",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "今天造訪這所學院",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "有什麼事呢？",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "優妮",
    "voice": "vo_adv_1110003_003",
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "同學？　",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "呃，",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "是哪位呀……",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "啊……",
    "voice": "vo_adv_1110003_004",
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "\\n該不會……",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "是那一位嗎？",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "\\n",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "就是那個，",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "在就學期間便獲得名譽博士稱號的，",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "編在特別班的那位。",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "哎呀真討厭，",
    "voice": "vo_adv_1110003_005",
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "您是說優妮博士嗎？",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "\\n",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "她是開校以來的才女，也是出了名的",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "「小小賢者」。",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "\\n那位人士相當的「特別」，",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "因此在教室中相當難與她碰上一面。",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "她究竟在何處我們也無從知曉，",
    "voice": "vo_adv_1110003_006",
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "\\n",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "畢竟對我們一般的學生來說，",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "她也是一位遙不可及的人士。",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "據說她住在高處，",
    "voice": "vo_adv_1110003_007",
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "並且過著像是仙人一般的生活，",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "\\n如同這般，",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "有著各式各樣的傳聞……",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "哎呀？",
    "voice": "vo_adv_1110003_008",
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "\\n時機正巧，",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "教務主任到這兒來了呢。",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "\\n",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "不如讓我們去問問看吧！",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "日安，",
    "voice": "vo_adv_1110003_009",
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "修女！",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "\\n那個，",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "這位男性他——",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "哎呀，",
    "voice": "vo_adv_1110003_010",
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "什麼事，",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "扯著這麼大的嗓門成何體統。",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "\\n",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "像我打從一出生",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "在呱呱墜地之後，",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "\\n就不曾在人的面前大聲嚷嚷，",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "呀啊啊啊，",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "是男人！？",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "那",
    "voice": "vo_adv_1110003_011",
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "那、",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "那、",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "那邊那個男人！　",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "你在這裡做些什麼！",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "\\n",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "離我的學生遠一些，",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "你這下流之人！",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "您、",
    "voice": "vo_adv_1110003_012",
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "您這麼突然是怎麼了，",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "修女……？",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "我在不久之前，",
    "voice": "vo_adv_1110003_013",
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "就接到了無數的通報。",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "\\n說有位可疑男子，",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "似乎在學院內四處徘徊物色目標。",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "\\n",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "那位男子",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "說的就是你沒錯吧？",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "哎呀，",
    "voice": "vo_adv_1110003_014",
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "如此厚顏無恥絲毫沒有悔過之意！",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "\\n",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "事到如今嘴裡竟然還吐得出這種話！",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "\\n得了便宜還賣乖，",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "就是在說你這種男人吧！",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "哎呀，",
    "voice": "vo_adv_1110003_015",
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "如此厚顏無恥還睜眼說瞎話！",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "\\n",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "事到如今嘴裡竟然還吐得出這種話！",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "\\n難道你就沒有",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "能夠坦然面對過錯的果斷嗎！",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "然而，",
    "voice": "vo_adv_1110003_016",
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "咳咳，",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "我們所憎惡的是罪，",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "並非是憎惡人本身。",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "\\n",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "因此究竟你為何會犯下此等罪過，",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "\\n就在神的名義之下，",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "坦承一切吧。",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "哦？",
    "voice": "vo_adv_1110003_017",
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "你在找人？",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "\\n究竟是找誰……？",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "咦？",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "優妮同學？",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "哎呀，",
    "voice": "vo_adv_1110003_018",
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "是為了優妮博士的研究？",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "\\n哎呀，",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "你把她所需的素材都買來了？",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "\\n",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "哎呀哎呀哎呀！　",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "那還真是辛苦你了！",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "原來是這樣呀，",
    "voice": "vo_adv_1110003_019",
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "你是優妮博士的……",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "呃，",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "是她的徒弟嗎？",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "\\n",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "不不，沒關係的。",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "畢竟她是我們學院中備受矚目的明日之星。",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "\\n",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "得讓她的研究萬無一失地進行才行呢，",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "呵呵呵。",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "好了，",
    "voice": "vo_adv_1110003_020",
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "那邊的女學生們？",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "\\n就帶著博士的徒弟先生",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女性教員",
    "words": "到那座「象牙之塔」去吧。",
    "voice": null,
    "unit_id": 3211
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "象牙之塔",
    "voice": "vo_adv_1110003_021",
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "是……",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "\\n",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "呃……",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "是舊校舍的圖書館……",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "來著？",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "真是令人不敢置信……",
    "voice": "vo_adv_1110003_022",
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "\\n那棟土裡土氣的建築物，",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "原來還有在使用啊……",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "background",
    "bg_id": "500960"
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "嗶嗶嗶！　",
    "voice": "vo_adv_1110003_023",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "嗶嗶嗶！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "\\n通知優妮博士！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "\\n請您趕緊起床，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "您有外部的來訪者！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "嗯啊～……",
    "voice": "vo_adv_1110003_024",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "呼啊。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "早安啊世界。",
    "voice": "vo_adv_1110003_025",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n今天也還是老樣子，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "你這個下三濫的騙子。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "嗯嗯……？",
    "voice": "vo_adv_1110003_026",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "哦呀？",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "怎麼，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這不是夢嗎？",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "嗨，",
    "voice": "vo_adv_1110003_027",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "{0}學弟。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n能再見到你真是再好不過了。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n你今天來這裡",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "有什麼事嗎？",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "啊，",
    "voice": "vo_adv_1110003_028",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這樣啊，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "原來是這個。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這是我拜託你的呢。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "半開玩笑所寄出的信件上，寫下了失禮的請託，",
    "voice": "vo_adv_1110003_029",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n沒想到你還真的聽進去了呢。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n你人真好呢。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "不，我訂正，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "你是個好人呢。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "嗯，",
    "voice": "vo_adv_1110003_030",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "謝謝你過來，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "感謝你不辭辛勞至此。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n多謝Thank you，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "鞠躬……",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "欸嘿嘿。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "不過，",
    "voice": "vo_adv_1110003_031",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "總覺得呀，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "感覺有點不可思議，讓人坐立不安。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "啊啊，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "回想起來，在我實質上佔據這座「塔」之後，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n這或許是我第一次招呼客人到這裡來也說不定呢。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "……啊，",
    "voice": "vo_adv_1110003_032",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "對了！",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n我記得這種時候，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "庶民的作法",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "是得端出粗茶來進行招待吧。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "抱歉我考慮不周，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我馬上準備。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "你就隨意找地方坐一下。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "讓你久等了。",
    "voice": "vo_adv_1110003_033",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n這是招待你的茶和小菜，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "請別客氣。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "嗯？",
    "voice": "vo_adv_1110003_034",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n怎麼了，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "{0}學弟。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n眼睛不要一直眨呀眨的，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "吃啊，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "快給我吃。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "喝得真豪邁。",
    "voice": "vo_adv_1110003_035",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n沒想到你一口氣喝光了。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "嗯，",
    "voice": "vo_adv_1110003_036",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "你的表情可真悽慘呢。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我想也是啦，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "畢竟那東西超難喝嘛。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "哎呀，",
    "voice": "vo_adv_1110003_037",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "抱歉，我太晚和你說明了，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "那是將某種植物系魔物的葉片裡的",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "有害物質去除後所煎出來的茶——",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "——雖說分類是茶，",
    "voice": "vo_adv_1110003_038",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "但與其說是飲品，應該說是嗜好品。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "是種只要在舌頭上沾上一點，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "就能享受其難喝的奧妙的東西。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "在我的故鄉，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "比起香菸或咖啡，大家更愛這個喔。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "要說有什麼有趣的……",
    "voice": "vo_adv_1110003_039",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "嗯……",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "是難喝到覺得好笑，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "大概比較接近這個感覺吧。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n在難吃的彼端會窺見神祕的境地，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "那真令人心曠神怡呀。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "哦，",
    "voice": "vo_adv_1110003_040",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "毫不猶豫就選了那個，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "你的眼光可真是好呢。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "那是深月老師給我的",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "滋養強壯的營養食品哦。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "不，",
    "voice": "vo_adv_1110003_041",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "等等。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "你是齧齒類的",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "小動物嗎。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n別給我一顆顆地咬碎來吃啦。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n給我抓一把喀滋喀滋地嚼著吃啦。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "沒什麼，",
    "voice": "vo_adv_1110003_042",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這哪有什麼問題。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n因為效用有點籠統，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "所以過度攝取的危險度也相對較低。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "至於我給它的評價是，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "可以當成點心來吃。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "不過嘛，",
    "voice": "vo_adv_1110003_043",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "因為功效過於強烈，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "所以多少會使人有些精力過剩，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "但是至少裡面並沒有加入會對人體造成不可逆影響的成分。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n就算是小孩子也能夠安心食用。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "你問法律？",
    "voice": "vo_adv_1110003_044",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n啊，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我想大概是沒問題。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n至少在深月老師還沒出什麼事以前都沒問題。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "所以說，",
    "voice": "vo_adv_1110003_045",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "{0}學弟啊。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n我希望你能夠嚴格地評價一下。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n優妮學姐的初次招待，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "你覺得怎麼樣呢？",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我照著書上做，",
    "voice": "vo_adv_1110003_046",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "試著添加了許多招待方的個性在裡頭。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "只是我還沒有掌握你的興趣和嗜好，因此仍有些不安，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "但若能讓遠道而來的客人感到開心的話，那就太好了。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "不是，",
    "voice": "vo_adv_1110003_047",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "那沒什麼，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "畢竟我出身於窮鄉僻壤的地方呢。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n在我進到這所學院前，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "從來都沒有下過｢山」。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "離棄了社會的老賢者們",
    "voice": "vo_adv_1110003_048",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "和他們龐大的藏書做為了我的再生父母，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "如今回想起來，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我那成長期過得可還真是封閉呢。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "也不知是否原因如此，",
    "voice": "vo_adv_1110003_049",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "看樣子我這個人，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n似乎稍微欠缺了所謂的一般常識。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "關於我的言行舉止，",
    "voice": "vo_adv_1110003_050",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n萬一讓你想到些什麼，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我希望你能夠毫無顧忌地說出來。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "不對，說吧，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "快說。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "啊，",
    "voice": "vo_adv_1110003_051",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "嗯，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這個嘛。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n該說是很死板，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "也能說是很古板，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "又或者是說口頭對談時",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "過於咬文嚼字的這幾點我也有自覺。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "啊，",
    "voice": "vo_adv_1110003_052",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "不，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我不是要你講這個。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "的確，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我有著超乎常人的可愛外表，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n然而那是先天的資質，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "若要歸咎於環境與教育上或有難處。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "哦？　",
    "voice": "vo_adv_1110003_053",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "你說你聽不懂我在說什麼？",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "啊啊，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "原來如此，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "是這麼回事啊。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n我說話的方式很不尋常，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "你有如此的指謫也是無可厚非。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "畢竟自我懂事以來，",
    "voice": "vo_adv_1110003_054",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n就和操著這種口吻的老賢者們生活在一起。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "換句話說就如同故鄉的方言一般呢。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "當初剛入學時，",
    "voice": "vo_adv_1110003_055",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我也曾有段時期相當勤奮地試著用標準的口吻來講話——",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "一開始啊，",
    "voice": "vo_adv_1110003_056",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我好像也是滿正常地在講話的——",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "但是啊，",
    "voice": "vo_adv_1110003_057",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "只要綜觀來看就會發現，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n在這間學院裡，出乎意料地有很多像我這種準方言話者。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "像是「～的呢」",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "或是",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "「～呢」",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "或是",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "「～切嚕」",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "之類的。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "若千金小姐腔能通用的話，",
    "voice": "vo_adv_1110003_058",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "那麼賢者腔應該也能通用才是。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "在我得出了這個結論後，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我就決定要恢復自然的方言口吻了。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "然而事實上，",
    "voice": "vo_adv_1110003_059",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我的桌子在我入學後不久，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "就被移到這座「塔」裡了。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "從那以來，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我就幾乎沒有什麼機會能和同學講上話了。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "嗯，",
    "voice": "vo_adv_1110003_060",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這個嘛……",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "講白一點，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "就是因為我太過優秀了，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n大概就是這麼一回事吧。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "若按照學院的說法，",
    "voice": "vo_adv_1110003_061",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n讓已經遠遠高人一等的我，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n再和其他學生上同等級的課，似乎也沒什麼太大的意義。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "與其去記下前人撰寫的教科書，",
    "voice": "vo_adv_1110003_062",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "更希望我在以讓人能理解我所闡明的新知新見這條路上邁進。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "他們就是像這樣溫柔地對我諄諄教誨。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "講白一點，",
    "voice": "vo_adv_1110003_063",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n就是要我「與其去上課還不如寫論文吧」",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "的意思。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "假設我的研究",
    "voice": "vo_adv_1110003_064",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n能夠在學會中獲得一定程度的評價，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "屆時位於這個領域中的聖德蕾莎女子學院的地位勢必也會有所提升吧。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "……不，",
    "voice": "vo_adv_1110003_065",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "雖然我講得好像一副不關我的事的樣子。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "但我當然",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "也有那份想要衣錦還鄉的野心。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "畢竟對那些寂寥淒涼的老人家們，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我可還沒做過些像樣的孝順之事呢。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "而學校做為代替研究室的場地所提供的這間老舊圖書館，",
    "voice": "vo_adv_1110003_066",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n俗稱「象牙之塔」的此處，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "對求知慾旺盛的我來說，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "是相當具魅力的寶物庫。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "每每隨手一翻書架，",
    "voice": "vo_adv_1110003_067",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "古老的文獻便會接二連三地跑出來。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "新知新見",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "便在其中滾啊滾地打轉著。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "各式各樣的學問──",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "又或者說是名為學問的娛樂，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這裡都應有盡有。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這麼棒的一個地方為什麼會被廢棄，",
    "voice": "vo_adv_1110003_068",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我至今仍覺得不可思議。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "甚至就連國內的知識分子垂涎三尺地蜂擁至此都不是什麼怪事。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "總而言之，",
    "voice": "vo_adv_1110003_069",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n就是因為如此，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n我今天",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "便依舊窩在這間陳舊的書庫裡——",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "時而終日貪圖著文獻。",
    "voice": "vo_adv_1110003_070",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "時而抱著書本沉沉睡去。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "提筆撰寫著用以代替課業的研究論文哦。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "好了，",
    "voice": "vo_adv_1110003_071",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這樣你明白我的意思了嗎？",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "同志。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "倘若今後你能與我一同齊心協力來努力的話可就幫大忙了。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "也就是說啊，",
    "voice": "vo_adv_1110003_072",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n講白一點，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "就是我希望你還能再到這裡來。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這樣啊，",
    "voice": "vo_adv_1110003_073",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "嗯，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "那就太好了，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "嗯。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就這樣，\\n{0}在這之後似乎就時常被優妮找去「象牙之塔」的樣子。",
    "voice": null,
    "unit_id": null
  }
]
