[
  {
    "type": "dialogue",
    "name": "怜",
    "words": "總算追上它了！",
    "voice": "vo_adv_5136302_000",
    "unit_id": 128811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 128811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "看來傷口都痊癒了呢。",
    "voice": null,
    "unit_id": 128811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "它在剛剛的戰鬥中",
    "voice": "vo_adv_5136302_001",
    "unit_id": 128911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "應該也學習成長了吧。",
    "voice": null,
    "unit_id": 128911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 128911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "必須要小心謹慎才行……！",
    "voice": null,
    "unit_id": 128911
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "學習……",
    "voice": "vo_adv_5136302_002",
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "難道說，",
    "voice": "vo_adv_5136302_003",
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "要是我們做了奇怪的動作，",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n它也會學起來嗎？",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "欸，",
    "voice": "vo_adv_5136302_004",
    "unit_id": 128911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "這個嘛……",
    "voice": null,
    "unit_id": 128911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "或許是？",
    "voice": null,
    "unit_id": 128911
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "是吧？",
    "voice": "vo_adv_5136302_005",
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "如果故意讓它學習奇怪的東西……",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "也許就能輕易打倒它了！",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這個作戰本身就很怪了。",
    "voice": "vo_adv_5136302_006",
    "unit_id": 128811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 128811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "居然會想到這種事……",
    "voice": null,
    "unit_id": 128811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是被埃拉影響了嗎？",
    "voice": null,
    "unit_id": 128811
  }
]
