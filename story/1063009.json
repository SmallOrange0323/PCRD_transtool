    "words": "\\n",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "還是說，",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "是{0}太敏銳了呢……？",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "其實啊……",
    "voice": "vo_adv_1063009_004",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n我收到了「森林守衛測驗」",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "的應試通知。",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "嗯。",
    "voice": "vo_adv_1063009_005",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "所謂的森林守衛，",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n是我故鄉的森林裡",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "代代流傳的重要職責。",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "不但很強，",
    "voice": "vo_adv_1063009_006",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "而且又帥氣！",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "我的夢想，",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "就是成為森林守衛。",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "為了成為森林守衛，",
    "voice": "vo_adv_1063009_007",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "需要通過困難的測驗，",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n而我",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "收到了應試通知。",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "耶嘿嘿……",
    "voice": "vo_adv_1063009_008",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "謝啦。",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "雖然光是被認可能參加測驗，",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n就已經是一件非常值得開心的事了……",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "……但我在煩惱",
    "voice": "vo_adv_1063009_009",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "要不要去參加測驗。",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "因為我從以前就一直聽說",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "測驗非常困難。",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "……呵呵。",
    "voice": "vo_adv_1063009_010",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n{0}，你真溫柔。",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "但是……",
    "voice": "vo_adv_1063009_011",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "我還是",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "沒有自信，",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n因為我一定只是",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "代替蘿莎麗亞被選上的而已。",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "如果",
    "voice": "vo_adv_1063009_012",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "蘿莎麗亞她在的話……",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n本來應該是蘿莎麗亞",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "會收到應試通知的吧。",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "我一個人去接受測驗沒問題嗎？",
    "voice": "vo_adv_1063009_013",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "我很不安……",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "咦？",
    "voice": "vo_adv_1063009_014",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n你的意思是……？",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "background",
    "bg_id": "500190"
  },
  {
    "type": "dialogue",
    "name": "森林的使者",
    "words": "歡迎妳，",
    "voice": "vo_adv_1063009_015",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "森林的使者",
    "words": "亞里莎。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "森林的使者",
    "words": "\\n非常感謝妳",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "森林的使者",
    "words": "參加森林守衛測驗。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "森林的使者",
    "words": "我是森林的使者，",
    "voice": "vo_adv_1063009_016",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "森林的使者",
    "words": "\\n負責監督森林守衛測驗，",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "森林的使者",
    "words": "\\n還請多多指教。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "好、",
    "voice": "vo_adv_1063009_017",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "好的！",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "\\n請多多指教！",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "森林的使者",
    "words": "呵呵，",
    "voice": "vo_adv_1063009_018",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "森林的使者",
    "words": "真是坦率的人呢。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "森林的使者",
    "words": "\\n",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "森林的使者",
    "words": "不過，",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "森林的使者",
    "words": "要成為森林守衛所需要的……",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "森林的使者",
    "words": "\\n並不是坦率。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "森林的使者",
    "words": "所謂的森林守衛，",
    "voice": "vo_adv_1063009_019",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "森林的使者",
    "words": "正如其名，",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "森林的使者",
    "words": "是守護精靈之森的人。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "森林的使者",
    "words": "\\n必須既能成為精靈們的守護者，",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "森林的使者",
    "words": "\\n又能成為引領森林的楷模。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "森林的使者",
    "words": "那樣的森林守衛需要擁有的……",
    "voice": "vo_adv_1063009_020",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "森林的使者",
    "words": "\\n",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "森林的使者",
    "words": "是能擊破障礙的力量，",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "森林的使者",
    "words": "\\n以及",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "森林的使者",
    "words": "能貫徹理想的堅強意志。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "力量",
    "voice": "vo_adv_1063009_021",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "和意志……",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "森林的使者",
    "words": "為此，",
    "voice": "vo_adv_1063009_022",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "森林的使者",
    "words": "森林守衛測驗分成兩種項目。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "森林的使者",
    "words": "\\n",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "森林的使者",
    "words": "「力量測驗」",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "森林的使者",
    "words": "與「意志測驗」。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "森林的使者",
    "words": "妳必須兩者都通過，",
    "voice": "vo_adv_1063009_023",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "森林的使者",
    "words": "\\n",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "森林的使者",
    "words": "才能被認可為森林守衛！",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "嗚嗚，",
    "voice": "vo_adv_1063009_024",
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "亞里莎",
    "words": "會是很困難的測驗對吧……",
    "voice": null,
    "unit_id": 106311
  },
  {
    "type": "dialogue",
    "name": "森林的使者",
    "words": "是啊。",
    "voice": "vo_adv_1063009_025",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "森林的使者",
    "words": "\\n",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "森林的使者",
    "words": "但是亞里莎，",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "森林的使者",
    "words": "既然妳收到了邀請，",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "森林的使者",
    "words": "\\n就表示妳有",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "森林的使者",
    "words": "合格的可能。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "森林的使者",
    "words": "祝妳武運昌隆。",
    "voice": "vo_adv_1063009_026",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "森林的使者",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "森林的使者",
    "words": "我想盡快開始進行準備……",
    "voice": null,
    "unit_id": 6511
  },
