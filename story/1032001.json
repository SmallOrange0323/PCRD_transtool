[
  {
    "type": "background",
    "bg_id": "500210"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}在溪谷採集素材時，\\n見到了一位女孩。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……",
    "voice": "vo_adv_1032001_000",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "唉，真是頭痛。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n我明明只是要去父親大人的房間而已……",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "這裡到底是哪裡呢？",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "就算我想要問路，也沒看到任何人。",
    "voice": "vo_adv_1032001_001",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n這樣的話，我連城鎮也回不去了呢……",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "哎呀？有聲音……",
    "voice": "vo_adv_1032001_002",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n我還以為這裡沒有任何人，原來還是有人在呀。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "真沒想到竟然能遇到人啊。",
    "voice": "vo_adv_1032001_003",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n你在這麼偏僻的地方做什麼呢？",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "採集素材……？",
    "voice": "vo_adv_1032001_004",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n哎呀，太意外了。如果有想要的東西，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n用錢買不就好了？",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "雖然如此，但對我來說真是太剛好啦。",
    "voice": "vo_adv_1032001_005",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你能不能",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "為本小姐\\n帶路到紫藤家呢？",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……咦？你不知道紫藤家在哪裡？",
    "voice": "vo_adv_1032001_006",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你、你是開玩笑的吧？",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "紫藤家……",
    "voice": "vo_adv_1032001_007",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "那就是",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我家啊。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "……呵呵，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "說到這裡，你應該就知道了吧。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "沒錯，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我正是",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "那位秋乃・紫藤啊！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "怎麼樣呢？",
    "voice": "vo_adv_1032001_008",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n果然讓你嚇了一跳吧？",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "果然是這樣子呢。",
    "voice": "vo_adv_1032001_009",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "那麼，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我就不需向你說明",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n紫藤家了吧？",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "……為什麼你要轉移目光呢？",
    "voice": "vo_adv_1032001_010",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "你……其實是不知道的對吧！？",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "咦！？　",
    "voice": "vo_adv_1032001_011",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "真的嗎？\\n不管是本小姐",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "還是紫藤家，你都不知道嗎！？",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "真、",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "真不敢相信啊！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "說到紫藤家，",
    "voice": "vo_adv_1032001_012",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "可是在整個大陸中聲名遠播的商家喔！？",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "然後，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "他們的女兒",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "就是我，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "秋乃・紫藤喔。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "沒想到竟然會有人不知道……",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "……咦？喪失記憶？",
    "voice": "vo_adv_1032001_013",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "若是那樣，就沒辦法了。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n那麼，至少請你為本小姐帶路到城鎮吧？",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "你願意接受請求嗎？",
    "voice": "vo_adv_1032001_014",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "真是幫了大忙啦。在這種地方迷路，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n不知會變成怎樣……你是本小姐的救世主啊。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "background",
    "bg_id": "500131"
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "呼，我終於回到城鎮上了。",
    "voice": "vo_adv_1032001_015",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "也辛苦你啦。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "你真是幫了大忙啦。",
    "voice": "vo_adv_1032001_016",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "其實，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n父親大人正在要求我，成為「獨當一面的商人」……",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "今天沒有護衛跟隨，也是因為這個原因。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "如果是這裡，我一個人也能夠回得了家。",
    "voice": "vo_adv_1032001_017",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "那麼，今天真是謝謝你了。祝你身體健康。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我家大概在……",
    "voice": "vo_adv_1032001_018",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "這邊吧！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "……哎呀？你為什麼要拉住我呢？",
    "voice": "vo_adv_1032001_019",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "咦？你說我正要走回剛才來的道路？",
    "voice": "vo_adv_1032001_020",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "是這樣子嗎……我差點回到剛才的地方了呢。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "其實我……經常會走錯路。",
    "voice": "vo_adv_1032001_021",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "果然，就算是從這裡，我好像也無法獨自回家呢 ……",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "如果可以，",
    "voice": "vo_adv_1032001_022",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我希望你能送本小姐回家，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n可是你好像不知道紫藤家的位置……",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "真是令人頭痛……",
    "voice": "vo_adv_1032001_023",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n這樣下去，我永遠都回不了家呢……",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "哎、哎呀？你要去哪裡呢！？",
    "voice": "vo_adv_1032001_024",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "不要對我見死不救啊！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "咦？",
    "voice": "vo_adv_1032001_025",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "你在做什麼呢？",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "路人",
    "words": "啊，紫藤家嗎？",
    "voice": "vo_adv_1032001_026",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "路人",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "路人",
    "words": "紫藤家的話，只要從這條路往前直走就會到囉。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "……原來如此！　",
    "voice": "vo_adv_1032001_027",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "就算你不知道，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n如果是其他人，就會知道紫藤家啊。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "只要知道路的話，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "你也能為本小姐帶路了呢！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "……那麼，",
    "voice": "vo_adv_1032001_028",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n其他人已經為你指路了，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "你能帶本小姐過去嗎？",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "background",
    "bg_id": "500031"
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "啊，看得到我家了！",
    "voice": "vo_adv_1032001_029",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "這樣的話，我肯定能不迷路地回到家呢。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "真是多虧了你，幫了大忙呢。",
    "voice": "vo_adv_1032001_030",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "作為回禮，你能收下這個嗎？",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "這只是微薄的謝禮。",
    "voice": "vo_adv_1032001_031",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "雖然這個金額……頂多只能",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n蓋一棟房子吧……",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "是不是太少了呢？",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "哎呀？你說你無法收下？",
    "voice": "vo_adv_1032001_032",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "……多麼清高的人啊，我很中意呢。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "你的名字是？　",
