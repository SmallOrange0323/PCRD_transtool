  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}和優花梨，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在聖誕節熱鬧的蘭德索爾街道上走著。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "雖然聖誕約會行程泡湯了……",
    "voice": "vo_adv_1146003_000",
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "但像現在這樣兩個人漫無目的地走著好像也不壞。",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "比起硬是要主導約會，",
    "voice": "vo_adv_1146003_001",
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "還是順其自然更好呢……",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "天色完全暗下來了呢……",
    "voice": "vo_adv_1146003_002",
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "那、",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "那個……",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我們現在要做什麼？",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "哦、",
    "voice": "vo_adv_1146003_003",
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "哦哦……",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "那我在這裡等你……",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "唉……",
    "voice": "vo_adv_1146003_004",
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "嗯，",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "這也可以說是很像他的風格啦。",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "哈囉～",
    "voice": "vo_adv_1146003_005",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "優花梨～！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "呀！",
    "voice": "vo_adv_1146003_006",
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "咦、",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "咦咦咦？",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n妳為什麼會在這裡啊？",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "哪有為什麼，",
    "voice": "vo_adv_1146003_007",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "當然是和你們一樣在聖誕約會呀♪",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "然後啊，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "我在約會途中看見你們，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "本來想說",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "\\n還是別來打擾好了，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "但剛剛看到妳男朋友跑掉……",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "啊，",
    "voice": "vo_adv_1146003_008",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "你們該不會分手了吧？",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "不是啦！",
    "voice": "vo_adv_1146003_009",
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "才不是",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "那樣！",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "啊哈哈，",
    "voice": "vo_adv_1146003_010",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "開玩笑的啦。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "我剛剛都聽到了。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "你們之間的氣氛不錯嘛。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "是、",
    "voice": "vo_adv_1146003_011",
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "是那樣嗎？",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "本來以為你們之間會有些彆扭的，",
    "voice": "vo_adv_1146003_012",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "\\n但他竟然在約會中提出要上廁所，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "\\n看來你們相處得很自在，我也放心了呢。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "這個嘛，",
    "voice": "vo_adv_1146003_013",
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "說來話長……",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "啊哈哈哈……",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "對了，",
    "voice": "vo_adv_1146003_014",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "妳知道這附近",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "有個看夜景的地方嗎？",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "好像有在雜誌上看到過……",
    "voice": "vo_adv_1146003_015",
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n但那種地方人通常都很多，不好玩吧？",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "是這樣沒錯啦，",
    "voice": "vo_adv_1146003_016",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "但那裡氣氛超好的。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "\\n「想讓關係更進一步，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "就趁現在了！」",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "的時候正適合去走走喔？",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "什、",
    "voice": "vo_adv_1146003_017",
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "什麼讓關係更進一步啦……！",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "不，",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "但是……",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我很享受像現在這樣和他悠閒地散步……",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "呵呵，",
    "voice": "vo_adv_1146003_018",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "你們很甜蜜嘛。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "沒、",
    "voice": "vo_adv_1146003_019",
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "沒有這回事啦……",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "啊，",
    "voice": "vo_adv_1146003_020",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "妳男友也差不多該回來了吧？",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "我男友也在等著我，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "就先走一步啦。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "那麼，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "要加油唷，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "酒友",
    "words": "優花梨♪",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "啊……",
    "voice": "vo_adv_1146003_021",
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "走掉了。",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "不過，",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "「想讓關係更進一步，",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "就趁現在了！」",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "嗎……",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "對我們而言好像還太早了。",
    "voice": "vo_adv_1146003_022",
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "但如果，",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "是他約我去的話……",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "哇呀啊啊！",
    "voice": "vo_adv_1146003_023",
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "沒、",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "沒什麼！",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "沒什麼啦！",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n我只是在自言自語，你別介意！",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "接、",
    "voice": "vo_adv_1146003_024",
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "接下來要做什麼呢？",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "咦？",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "你有想去的地方啊。",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "好啊，",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我們走吧。",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "background",
    "bg_id": "500025"
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "這裡",
    "voice": "vo_adv_1146003_025",
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "該不會……",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "是剛剛提到的看夜景的地方……？　",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "你竟然想來這裡啊？",
    "voice": "vo_adv_1146003_026",
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "真虧你會知道耶……",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "該不會……",
    "voice": "vo_adv_1146003_027",
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "想讓關係更進一步，",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "就趁現在……",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "是指這一刻嗎！？",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "怎怎怎、",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "怎麼辦！",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "太突然了，我還沒做好心理準備……",
    "voice": null,
    "unit_id": 114612
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "妳、",
    "voice": "vo_adv_1146003_028",
    "unit_id": 114612
  },
  {
