  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "某天的午後。{0}在涅比亞的要求下，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n獨自走上前往公會小屋三樓的樓梯。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "你們頭一次來到這個房間時，",
    "voice": "vo_adv_1186004_000",
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "那可真是雞飛狗跳啊～♪",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n除了你跟可可蘿以外，",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "大家都超失控……",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "欸。",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "……幹嘛～？",
    "voice": "vo_adv_1186004_001",
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "你在提防我？",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n你說擔心會被我惡作劇",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "是吧。",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "才不會好嗎，",
    "voice": "vo_adv_1186004_002",
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "起碼在只有你一個人的時候不會。",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n畢竟你",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "一點反應都沒有，無聊死了。",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "我也是有不會惡作劇的時候啊。",
    "voice": "vo_adv_1186004_003",
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "……怎麼一臉",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "無法想像的表情。",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "原來你也會",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "露出這種表情啊♪",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "先不說這些……",
    "voice": "vo_adv_1186004_004",
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "進入正題。",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n你幫我",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "強化吧♪",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "不然是要在哪裡啦？",
    "voice": "vo_adv_1186004_005",
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "好啦好啦，",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "快點♪",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "不用擔心，",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "我不會害你的！",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "真是的！",
    "voice": "vo_adv_1186004_006",
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "你平常都不會這麼有戒心的，",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "快點幫我強化啦！",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "不照做的話……",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "我就要惡作劇囉？",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "嗯嗯！",
    "voice": "vo_adv_1186004_007",
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "感覺很棒♪",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n那麼要開始囉！",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "一、二、三！",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "呀哈哈☆",
    "voice": "vo_adv_1186004_008",
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "怎麼樣？",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n我使用你的公主騎士之力",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "強制觸發了bug。",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n這麼一來，「幻影湖之霧」",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "對你也有效了吧。",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "你在發什麼呆啊？",
    "voice": "vo_adv_1186004_009",
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "仔細",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "看看你身邊♪",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "background",
    "bg_id": "510220"
  },
  {
    "type": "dialogue",
    "name": "同學１",
    "words": "{0}同學？班會已經結束了喔～？",
    "voice": "vo_adv_1186004_010",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學１",
    "words": "\\n你在發什麼呆啊？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學１",
    "words": "啊，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學１",
    "words": "該不會還想睡吧？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學１",
    "words": "\\n數學課時你也在打瞌睡對吧？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學２",
    "words": "怎麼啦，",
    "voice": "vo_adv_1186004_011",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學２",
    "words": "熬夜啊？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學２",
    "words": "\\n",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學２",
    "words": "收好的講義",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學２",
    "words": "我幫你送去教職員室，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學２",
    "words": "\\n你可以先回去了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學３",
    "words": "欸欸！",
    "voice": "vo_adv_1186004_012",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學３",
    "words": "今天回去要玩",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學３",
    "words": "阿斯特朗嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學３",
    "words": "\\n有更新對吧？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學１",
    "words": "沒錯沒錯，",
    "voice": "vo_adv_1186004_013",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學１",
    "words": "昨天有公告的那個！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學１",
    "words": "\\n回去時在電車上先登入看看好了～",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學２",
    "words": "{0}，你晚點也會上線吧？",
    "voice": "vo_adv_1186004_014",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學２",
    "words": "阿斯特朗。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學２",
    "words": "\\n有個任務我怎麼樣都過不了，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學２",
    "words": "可以幫忙一下嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "這裡是你讀的",
    "voice": "vo_adv_1186004_015",
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "高中的教室喔。",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "學校這地方",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "還真熱鬧呢。",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "課本",
    "voice": "vo_adv_1186004_016",
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "全部都收進書包裡了吧？",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n你想放在學校的話也行啦。",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "好，",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "那我們走吧！",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "……還能去哪裡，",
    "voice": "vo_adv_1186004_017",
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "當然是你家啊♪",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n剛才不是說要登入阿斯特朗嗎。",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n我會負責引導你直到登入的！",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "快點快點，",
    "voice": "vo_adv_1186004_018",
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "走吧！",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "background",
    "bg_id": "510210"
  },
  {
    "type": "dialogue",
    "name": "同學２",
    "words": "哇！",
    "voice": "vo_adv_1186004_019",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學２",
    "words": "別突然撞上來好不好。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學２",
    "words": "\\n嗯，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學２",
    "words": "明天見啦。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學３",
    "words": "{0}同學，",
    "voice": "vo_adv_1186004_020",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學３",
    "words": "晚點見囉！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學３",
    "words": "\\n我在之前阿斯特朗裡說好的地方等你～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "好像是呢！",
    "voice": "vo_adv_1186004_021",
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "畢竟",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "我現在是專為你存在的嘛♪",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "background",
    "bg_id": "510240"
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "這裡是校門啊。",
    "voice": "vo_adv_1186004_022",
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "嗯～",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "會跟心上人約在這裡碰面嗎？",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n真棒，",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "這種青春的感覺！",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "still",
    "still_id": "118600401"
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "傍晚的路上",
    "voice": "vo_adv_1186004_023",
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "人這麼多啊。",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n喂，",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "不往右閃會有危險喔！",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n後方有腳踏車衝過來！",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "再來是左邊！",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "哎唷，",
    "voice": "vo_adv_1186004_024",
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "你不要衝進樹叢裡啦！",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "哎呀呀。",
    "voice": "vo_adv_1186004_025",
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "路上這麼混亂，感覺好容易撞到人。",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n原來你每天",
    "voice": null,
    "unit_id": 190911
  },
  {
