  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "呼……",
    "voice": "vo_adv_5136101_000",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n差不多該休息一下了。",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "蘭德索爾……",
    "voice": "vo_adv_5136101_001",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n已經離得這麼遠了呢。",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "大家現在",
    "voice": "vo_adv_5136101_002",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "在做什麼呢？",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "background",
    "bg_id": "502050"
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "優衣她",
    "voice": "vo_adv_5136101_003",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "已經抵達精靈族之村了嗎～？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "應該",
    "voice": "vo_adv_5136101_004",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "是沒有這麼快的吧？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "不過她自己一人，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "半路也可能會有魔物出現！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "唔嗯～",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "當初果然應該送她去的～！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "優衣的話一定沒問題的。",
    "voice": "vo_adv_5136101_005",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "怜！",
    "voice": "vo_adv_5136101_006",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n比賽結束了嗎？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "結果如何？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "有沒有受傷？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "當然是贏了，",
    "voice": "vo_adv_5136101_007",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "也沒有受傷。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n是場很棒的對戰。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "太好了～！",
    "voice": "vo_adv_5136101_008",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n那我就放心了～！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "謝謝。",
    "voice": "vo_adv_5136101_009",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "好了，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "接著輪到妳了。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n趕緊準備好吧。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……優衣外出修行了。",
    "voice": "vo_adv_5136101_010",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我們也不能輸給她呢。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "說的也是！",
    "voice": "vo_adv_5136101_011",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "畢竟我們是",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "【破曉之星】嘛！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n即使分隔兩地，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "但心意也是一樣的！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "沒錯，",
    "voice": "vo_adv_5136101_012",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "無論何時，我們的心意──",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "都是一樣的。",
    "voice": "vo_adv_5136101_013",
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "502050"
  },
  {
    "type": "dialogue",
    "name": "日和、怜",
    "words": "咦？",
    "voice": "vo_adv_5136101_014",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "剛才，",
    "voice": "vo_adv_5136101_015",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "好像聽到了什麼聲音……",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是錯覺……",
    "voice": "vo_adv_5136101_016",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "嗎？",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "下一回，",
    "voice": "vo_adv_5136101_017",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "「I Wish　",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "緊握的這雙手」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "502050"
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我們是不是稍～微有點太早出現了啊？",
    "voice": "vo_adv_5136101_018",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n剛才應該不要出聲比較好嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "…………別問我。",
    "voice": "vo_adv_5136101_019",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n我很困擾。",
    "voice": null,
    "unit_id": null
  }
]
