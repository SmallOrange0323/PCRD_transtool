[
  {
    "type": "background",
    "bg_id": "500370"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "某個午後。{0}",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n被雪叫了出來，陪他一起購物。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "哦～",
    "voice": "vo_adv_1263004_000",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "真棒呢，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這瓶紫色的指甲油。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n你不覺得這個顏色",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "跟這件禮服很搭嗎？",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "能幫我放進購物籃嗎？",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "還有，",
    "voice": "vo_adv_1263004_001",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我從以前就很在意",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "那邊的護髮油呢。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n聽說用了頭髮會變得光澤閃耀。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你也把那個",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "放進購物籃吧。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "哈哈，",
    "voice": "vo_adv_1263004_002",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "怎麼可能。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我身上可是一毛錢都沒有喔。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "先前，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我才剛把全部財產",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "通通拿去買了美容液呢。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "但是，",
    "voice": "vo_adv_1263004_003",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這是",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我變得越來越美的機會吧？",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你也說過對吧，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n說想要看到變得更美的我。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "所以說，",
    "voice": "vo_adv_1263004_004",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這是來自宇宙最美的我的請求！",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你願意替我支付",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這筆費用嗎？",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我會變得更美作為給你的償還♪",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "……咦，",
    "voice": "vo_adv_1263004_005",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "竟然又突然",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "發出耀眼光芒……！",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "果然還是太狡猾了，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "明明我也想要像那樣發出光芒！",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不能用禮服的力量",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "想想辦法嗎……？",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "background",
    "bg_id": "510090"
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "嗯，",
    "voice": "vo_adv_1263004_006",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不管什麼時候來，這房間都一樣簡樸呢。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n我滿喜歡",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你房間這樣",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "乾淨整潔的感覺。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "可是，",
    "voice": "vo_adv_1263004_007",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "又覺得有點太過簡樸了。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "舉例來說，",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "要是在牆壁上貼上我的海報，",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n你不覺得房間",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "會變得更華麗、更棒嗎？",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "唔嗯。",
    "voice": "vo_adv_1263004_008",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "總之，",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "要是你想要，隨時都可以說喔。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不管你要多少張，",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我都會把海報準備好♪",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "言歸正傳。",
    "voice": "vo_adv_1263004_009",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我今天",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "會來的理由……",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你應該還記得吧？",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "──沒錯，",
    "voice": "vo_adv_1263004_010",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "為了要留存永恆之美！",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我",
    "voice": "vo_adv_1263004_011",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "一直很期待今天這個日子！",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "當然，",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你也是吧？",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "那麼，",
    "voice": "vo_adv_1263004_012",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我去換個衣服。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n你也",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "將桌子收到一旁，",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "開始著手準備吧。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我換好衣服了。",
    "voice": "vo_adv_1263004_013",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n那就開始吧──",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我的攝影會！",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "still",
    "still_id": "126300401"
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "呵呵，",
    "voice": "vo_adv_1263004_014",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "如何？",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "如同先前所提到的，",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這次的主題是永恆之美……",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "為了表現出這個主題，",
    "voice": "vo_adv_1263004_015",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n我準備了符合吸血鬼形象的服裝！",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "高貴、神秘且妖豔……",
    "voice": "vo_adv_1263004_016",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "真是",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "再適合我不過了吧？",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "好了，",
    "voice": "vo_adv_1263004_017",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你就盡情地拍吧。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n從各種不同的角度，",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "將我的美",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "收入鏡頭內！",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "……話說回來。",
    "voice": "vo_adv_1263004_018",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "為了攝影會，",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n你在短時間內",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "準備得很仔細周全呢。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "為了營造氣氛，",
    "voice": "vo_adv_1263004_019",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n你不讓直射日光照進房間，而且……",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "帶有日常感的電腦與書桌",
    "voice": "vo_adv_1263004_020",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "也都收了起來。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "太棒了。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這正是",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "適合拍攝我的舞台！",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "still",
    "still_id": "126300402"
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "呵呵呵。",
    "voice": "vo_adv_1263004_021",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "選了你真是太好了。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n這樣子才是",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我的專屬攝影師。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "……嗯？",
    "voice": "vo_adv_1263004_022",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你說我現在的表情很棒？",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "是嗎？",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "雖然我的表情",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "無論何時都是最棒的……",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不過，",
    "voice": "vo_adv_1263004_023",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "說的也是呢。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n或許我有著只有與你在一起時，才會露出的表情。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "總覺得",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "有點不可思議。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "算了。",
    "voice": "vo_adv_1263004_024",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "更重要的是，",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你儘管拍吧。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "為了將我的美",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "全部留存為照片！",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "still",
    "still_id": "126300403"
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "那還用說。",
    "voice": "vo_adv_1263004_025",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我要上傳到SNS。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n這之後，",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我當然也打算把照片洗出來。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這也是為了後世的人們。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "……你的表情",
    "voice": "vo_adv_1263004_026",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "就像在問說這是什麼意思呢。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "好吧，",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我就漂亮地說明給你聽。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "雖然我美到",
    "voice": "vo_adv_1263004_027",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不像是這個世界的存在，",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "但要是",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "過了100年之後，",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我應該已經離開人世了吧？",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "100年後，世界上的人們",
    "voice": "vo_adv_1263004_028",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "會非常可憐吧。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n他們必須在失去我",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這個絕對之美的世界活下去。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不過，",
    "voice": "vo_adv_1263004_029",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "未來的人們",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "當然也會有救贖。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "雖然我打從心底感到遺憾，",
    "voice": "vo_adv_1263004_030",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n但我的肉體",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "遲早會迎來終結。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "然而──",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "如果是以照片和檔案的形式，",
    "voice": "vo_adv_1263004_031",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n那麼我的美貌",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "無論過了多久都能留存。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "沒錯，",
    "voice": "vo_adv_1263004_032",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "也就是說。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "可以永遠留存我的美。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這也是一種",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "「永恆之美」",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "對吧？",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "所以，我",
    "voice": "vo_adv_1263004_033",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "要將照片上傳到SNS。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n為了地球上",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "活在當下的所有人。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "然後，",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "更是為了後世！",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這正是",
    "voice": "vo_adv_1263004_034",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n作為美的化身所背負的義務♪",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "好了，",
    "voice": "vo_adv_1263004_035",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "要是你聽懂了，",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "就大拍特拍吧！",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這些照片會永遠留存，",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你也是",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "責任重大喔！",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "background",
    "bg_id": "510090"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "啊啊……",
    "voice": "vo_adv_1263004_036",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "真是太棒了！",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n每一張照片",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "全都美極了！",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我要將這麼多的尊貴至寶",
    "voice": "vo_adv_1263004_037",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "上傳到SNS。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "全世界都要感謝我，",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n甚至是將今天這個日子",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "定為紀念日也不為過吧。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "話說又回來。",
    "voice": "vo_adv_1263004_038",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n選擇吸血鬼風格的服裝，",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "果然是正確的決定呢。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "多虧如此，才能將這次的主題──",
    "voice": "vo_adv_1263004_039",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n「永恆之美」",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "完美地表現出來。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "因為吸血鬼是",
    "voice": "vo_adv_1263004_040",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "永生不死，",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n永遠美麗……",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這樣子的存在呢。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "其實",
    "voice": "vo_adv_1263004_041",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我有點憧憬呢，",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這種唯美的生物。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這點",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "也是我會選擇這套服裝的理由之一。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "如果真的有吸血鬼，",
    "voice": "vo_adv_1263004_042",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我一定要見上一面。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "雖然比不上我，",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "但對方肯定很美吧。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "哦，",
    "voice": "vo_adv_1263004_043",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你說吸血鬼真的存在？",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n如果是其他人聽到，",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "說不定會笑出來吧。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "當然，",
    "voice": "vo_adv_1263004_044",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "是相信你的。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "因為，",
    "voice": "vo_adv_1263004_045",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你想想看，",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "像我這樣",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n本來不應該存在於這個世界的美卻是真實存在的。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "所以說就算有吸血鬼存在，也一點都不奇怪。",
    "voice": "vo_adv_1263004_046",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n我是這麼認為的。",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "……不如說，",
    "voice": "vo_adv_1263004_047",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我也想要變成吸血鬼！",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "把那個人",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "介紹給我認識吧！",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "然後，我",
    "voice": "vo_adv_1263004_048",
    "unit_id": 100831
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "就可以獲得永恆之美！",
    "voice": null,
    "unit_id": 100831
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好，",
    "voice": "vo_adv_1263004_049",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這場夢就到此為止。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你問我，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "在這之後，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "雪怎麼樣了……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
