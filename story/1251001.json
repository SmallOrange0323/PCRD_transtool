[
  {
    "type": "background",
    "bg_id": "501950"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "某天午後──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在「Naschkatze」店內，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n珠希正無所事事。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "呼～",
    "voice": "vo_adv_1251001_000",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我捏我捏。",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "你的肉球捏起來太舒服了喵。",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我決定今天一整天都要欣賞你的肉球喵～",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "白",
    "words": "嗚喵～",
    "voice": "vo_adv_1251001_001",
    "unit_id": 1713
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "……嗚喵？",
    "voice": "vo_adv_1251001_002",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我是知道啦，但又沒有客人喵。",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n你自己還不是從剛剛開始就一直在洗同一個盤子喵。",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "雖然因為莫妮卡接下了討伐魔物的委託，",
    "voice": "vo_adv_1251001_003",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n所以就暫時讓我顧店……",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "但根本沒有任何要做的事喵。",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "好了，你也過來這邊，",
    "voice": "vo_adv_1251001_004",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "一起跟貓咪玩喵～",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我捏～",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我捏我捏～～",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我捏～～",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "呃，",
    "voice": "vo_adv_1251001_005",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "現在不是逃避現實的時候喵！！！",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "太多客人一擁而上雖然也很困擾，",
    "voice": "vo_adv_1251001_006",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "但要是就這樣下去，會連房租都付不出來的喵……！",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我們對餐點味道是有自信的……",
    "voice": "vo_adv_1251001_007",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "接下來得思考讓客人上門的方法才行喵……",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "妳好～",
    "voice": "vo_adv_1251001_008",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "\\n能給我一杯咖啡嗎？",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "我要外帶。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "啊，",
    "voice": "vo_adv_1251001_009",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "歡迎光臨～！",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我馬上準備喵～！",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "嗯嗯……",
    "voice": "vo_adv_1251001_010",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "好香。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "我果然最喜歡這裡的咖啡了。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "\\n我也好想讓奶奶喝到啊。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "\\n",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "我奶奶也",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "非常喜歡咖啡。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "妳這麼說讓我好開心喵！",
    "voice": "vo_adv_1251001_011",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n希望妳也務必帶奶奶過來喵～！",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "嗯，",
    "voice": "vo_adv_1251001_012",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "我是很想這麼做啦……",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "\\n",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "但奶奶住在遠離城鎮的地方，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "\\n加上腳也不方便，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "所以大概有點困難吧。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這樣啊喵……？",
    "voice": "vo_adv_1251001_013",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n妳奶奶的家在哪裡呢喵？",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "……嗯嗯，",
    "voice": "vo_adv_1251001_014",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "原來在那片岩壁的前方啊喵？",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我明白了喵！",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "那麼，",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "就由我來把咖啡外送到奶奶家喵！",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "喵呵呵♪",
    "voice": "vo_adv_1251001_015",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "不只有請人來的方法，",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n也有由我們從這裡送過去的方法啊喵！",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "咦……",
    "voice": "vo_adv_1251001_016",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "我是很開心啦，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "但我認為那很難喔？",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "\\n",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "雖然看起來可能",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "會覺得奶奶家離很近，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "但那裡──",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "機會難得，所以我也要請她吃鯛魚燒喵！",
    "voice": "vo_adv_1251001_017",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n那跟熱呼呼的咖啡可是絕配喵！",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "說的也是～",
    "voice": "vo_adv_1251001_018",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "畢竟今天也沒客人……",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我明白了喵！",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "那準備後就出發喵～！",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "background",
    "bg_id": "501580"
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "呼……",
    "voice": "vo_adv_1251001_019",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "呼……",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我們是咖啡廳「Naschkatze」喵……！",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n我們送咖啡來了……！",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "哎呀，你們",
    "voice": "vo_adv_1251001_020",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "這不全身是汗嗎……！",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "\\n你們是從鎮上跑過來的嗎！？",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "雖然這裡看起來離鎮上很近，",
    "voice": "vo_adv_1251001_021",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "但因為必須繞遠路，所以出乎意料地累人呢……",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "沒錯喵……",
    "voice": "vo_adv_1251001_022",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "比想像中還花時間，",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "讓妳久等了喵！",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "這也不是什麼久不久等的狀況……",
    "voice": "vo_adv_1251001_023",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "這麼說來，送咖啡？",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "\\n我並不記得我有做那樣的委託喔……？",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這是妳的孫女委託我們的喵。",
    "voice": "vo_adv_1251001_024",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n她說想讓奶奶喝到這個咖啡。",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "咦？",
    "voice": "vo_adv_1251001_025",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "那孩子嗎？",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "那還真令人開心呢。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "\\n她有記住我喜歡咖啡嗎……",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "呵呵呵。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "沒錯喵！",
    "voice": "vo_adv_1251001_026",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "也請妳一起享用鯛魚燒……",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "啊！",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "白",
    "words": "喵──♪",
    "voice": "vo_adv_1251001_027",
    "unit_id": 1713
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "喂、",
    "voice": "vo_adv_1251001_028",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "喂，你！",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這個鯛魚燒不是你的！",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "而且熱呼呼的鯛魚燒",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "對有貓舌的你來說……",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "白",
    "words": "舔舔。",
    "voice": "vo_adv_1251001_029",
    "unit_id": 1713
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "……很正常地在舔喵。",
    "voice": "vo_adv_1251001_030",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "難不成……",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "啊啊！？",
    "voice": "vo_adv_1251001_031",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "不管是鯛魚燒還是咖啡，",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n都已經冷掉了喵……",
    "voice": null,
    "unit_id": 125111
