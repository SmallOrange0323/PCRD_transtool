    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n要將誰都無法模仿的特別聖誕節獻給陛下，",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 128011
  },
