  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "這全都是",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "為了向陛下獻上最棒的聖誕節，",
