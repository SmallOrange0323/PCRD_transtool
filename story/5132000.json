  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "動用了我的人脈，",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n用划算的價格備齊了適合當作禮物的品牌產品！",
