    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n到了夜晚那可會成為無比美麗且值得一看的美景啊！",
    "voice": null,
    "unit_id": 128011
  },
  {
