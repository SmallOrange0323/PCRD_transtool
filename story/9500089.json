[
  {
    "type": "background",
    "bg_id": "509040"
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "……討厭，真可怕，",
    "voice": "vo_adv_9500089_000",
    "unit_id": 133041
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "我剛剛幻聽了。",
    "voice": null,
    "unit_id": 133041
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n居然聽到跟騎士氏相似的聲音，",
    "voice": null,
    "unit_id": 133041
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "說要選我。",
    "voice": null,
    "unit_id": 133041
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "你說、",
    "voice": "vo_adv_9500089_001",
    "unit_id": 133041
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "不是幻聽，",
    "voice": null,
    "unit_id": 133041
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n而且並不是在開玩笑呢。",
    "voice": null,
    "unit_id": 133041
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n……這樣啊，",
    "voice": null,
    "unit_id": 133041
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "嗯～",
    "voice": null,
    "unit_id": 133041
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "你突然這麼說，",
    "voice": "vo_adv_9500089_002",
    "unit_id": 133041
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "我很困擾。",
    "voice": null,
    "unit_id": 133041
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "……不必道歉。",
    "voice": "vo_adv_9500089_003",
    "unit_id": 133041
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 133041
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "老實說……",
    "voice": null,
    "unit_id": 133041
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "我也",
    "voice": null,
    "unit_id": 133041
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "喜歡你，",
    "voice": null,
    "unit_id": 133041
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n超級喜歡。",
    "voice": null,
    "unit_id": 133041
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "只是……",
    "voice": "vo_adv_9500089_004",
    "unit_id": 133041
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "我想著把這份心意藏在心底。",
    "voice": null,
    "unit_id": 133041
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 133041
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "因為作為守護騎士，",
    "voice": null,
    "unit_id": 133041
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "作為摯友，",
    "voice": null,
    "unit_id": 133041
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "我無法搶先菫一步。",
    "voice": null,
    "unit_id": 133041
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n……然而，",
    "voice": null,
    "unit_id": 133041
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "你竟主動說了……",
    "voice": null,
    "unit_id": 133041
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "……可以、",
    "voice": "vo_adv_9500089_005",
    "unit_id": 133041
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "再說一次嗎？",
    "voice": null,
    "unit_id": 133041
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 133041
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "讓我聽聽",
    "voice": null,
    "unit_id": 133041
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n騎士氏的心意。",
    "voice": null,
    "unit_id": 133041
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "……哇哦──",
    "voice": "vo_adv_9500089_006",
    "unit_id": 133041
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 133041
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "這種情話還真是適合亡靈。",
    "voice": null,
    "unit_id": 133041
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 133041
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "真不愧是你，",
    "voice": null,
    "unit_id": 133041
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "泡妞首領。",
    "voice": null,
    "unit_id": 133041
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "呵呵……",
    "voice": "vo_adv_9500089_007",
    "unit_id": 133041
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "我確實聽到",
    "voice": null,
    "unit_id": 133041
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "你剛剛的話了，",
    "voice": null,
    "unit_id": 133041
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n而我也下定了決心。",
    "voice": null,
    "unit_id": 133041
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n騎士氏……",
    "voice": null,
    "unit_id": 133041
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "不對。",
    "voice": null,
    "unit_id": 133041
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "我最喜歡你了，",
    "voice": "vo_adv_9500089_008",
    "unit_id": 133041
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n……{0}。",
    "voice": null,
    "unit_id": 133041
  }
]
