    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "但",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我真的很開心呢。",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "嗯，",
    "voice": "vo_adv_5054411_001",
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我也是。",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "……甚至有點太過投入，",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "不顧形象地拿出真本事了。",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "但也是因為這段時間很特別……",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "是呀。",
    "voice": "vo_adv_5054411_002",
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我們快點搞定擊退惡徒這種無趣的餘興節目，",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n繼續享受我們的派對吧！",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "那麼，",
    "voice": "vo_adv_5054411_003",
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "各位。",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "以薔薇假面的作風來說這句話吧……",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "你們準備好要奏響特別的最終樂章了嗎？",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "嗯！",
    "voice": "vo_adv_5054411_004",
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "那當然！",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "來吧，",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "{0}大人……",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我們走！",
    "voice": "vo_adv_5054411_005",
    "unit_id": 114411
  }
]
