  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "微服出訪享受假期的貪吃佩可和",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}在樹蔭下休息。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嘿嘿♪",
    "voice": "vo_adv_1075007_000",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "一起像男女朋友一樣度過假期，真的好開心！",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n不過，",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "距離靠得這麼近，",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "讓我心跳得有點快♪",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我的臉頰也已經",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "紅通通熱滾滾了☆",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "從旁人的角度來看，",
    "voice": "vo_adv_1075007_001",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我們是不是就像情侶一樣呢？",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "你覺得呢？",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊，",
    "voice": "vo_adv_1075007_002",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "哎呀呀？",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n{0}？",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……我戳，",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我戳。",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嘿嘿♪",
    "voice": "vo_adv_1075007_003",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "你的睡臉真的特別可愛！",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好想永遠看下去☆",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "今天給你添了很多麻煩，",
    "voice": "vo_adv_1075007_004",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我想你應該很累了吧？",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那應該讓你",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "繼續睡下去會比較好。",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "奇怪？",
    "voice": "vo_adv_1075007_005",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那道光是怎麼回事……？",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……我也",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "有點睏了。",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n現在睡著雖然有點可惜，",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "還是睡個一下下……",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "background",
    "bg_id": "510392"
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我看看……",
    "voice": "vo_adv_1075007_006",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "碰面地點應該，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n是這邊沒錯吧……",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "吸～呼……",
    "voice": "vo_adv_1075007_007",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嗚嗚……",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "明明昨天才和他碰過面，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "現在卻開始緊張起來了。",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不過",
    "voice": "vo_adv_1075007_008",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "會緊張也不奇怪！",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "因為我今天",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "非告訴他",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不可。",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我必須，",
    "voice": "vo_adv_1075007_009",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "向他說再見……",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我也想告訴他，",
    "voice": "vo_adv_1075007_010",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我其實不願意這麼做。",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不過，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我不能再繼續給他添麻煩了……",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我還不夠成熟，",
    "voice": "vo_adv_1075007_011",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "身為公主的自覺還不夠……",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "也沒有理解自己的發言有多大的影響力。",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "所以，",
    "voice": "vo_adv_1075007_012",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我告訴他我想讓他成為我的騎士，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n結果卻害他",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "在我不知情的情況下碰到很大的困擾。",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "他只是",
    "voice": "vo_adv_1075007_013",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "對我這個朋友很好，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n並不代表他答應要當我的騎士。",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我不想再繼續",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "給最喜歡的人添麻煩了。",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "成年之後，",
    "voice": "vo_adv_1075007_014",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我必須在任何人面前都表現像個王室成員。",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n……",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我將不再是個",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "普通的女孩子。",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "所以，在最後……",
    "voice": "vo_adv_1075007_015",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "想和他一起創造回憶，我才來到了日本。",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這個夏天，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "他帶給了我很多寶貴的事物。",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但這一切都會在",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "今天告終……",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "一起享受夏天慶典之後，",
    "voice": "vo_adv_1075007_016",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我就要……",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……！？",
    "voice": "vo_adv_1075007_017",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n{0}！！",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n呃，mimi的翻譯功能……！　",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "「謝謝你趕過來♪",
    "voice": "vo_adv_1075007_018",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "抱歉這麼突然就約你！」",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "「今天有舉辦",
    "voice": "vo_adv_1075007_019",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "煙火大會！",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我無論如何",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "都想體驗日本的慶典！」",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "「炒麵和棉花糖……",
    "voice": "vo_adv_1075007_020",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n刨冰和章魚燒……",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "光用想的我肚子就餓了☆」",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "「我最期待的是",
    "voice": "vo_adv_1075007_021",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "和你一起看煙火♪",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "然後……」",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "「…………」",
    "voice": "vo_adv_1075007_022",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "「沒什麼！",
    "voice": "vo_adv_1075007_023",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n哪邊有攤販呢？",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我想買點伴手禮☆」",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "怎、",
    "voice": "vo_adv_1075007_024",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "怎麼辦……！？",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n轉頭看攤販的時候",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "和他走散了……！　",
