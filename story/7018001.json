  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "雙手交握。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n保持這個姿勢，集中意識……",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n妳的手",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "應該會變得越來越溫暖。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "手變溫暖……",
    "voice": "vo_adv_7018001_032",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "但這不只是溫暖了……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n啊哇哇哇！",
