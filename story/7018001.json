    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "妳的臉色好蒼白……！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "請妳別管我，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "快放手吧……！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我沒事……",
    "voice": "vo_adv_7018001_036",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n只是頭有點暈而已……",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "全身都好燙……",
    "voice": "vo_adv_7018001_037",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "詛咒太強大，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "來不及淨化……！",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不行，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我要倒下去了……！　",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "啊哇哇！？",
    "voice": "vo_adv_7018001_038",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "你們還好嗎！？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n你們都摔得很重耶……！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "然後我總覺得",
