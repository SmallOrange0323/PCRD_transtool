    "name": "骷髏老爸",
    "words": "\\n本大爺要把你給驅除掉──！！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "鈴莓急急忙忙地修補忍的衣服。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n骷髏老爸對著看不見的惡靈怒吼。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n忍則是因為這不幸的巧合而滿臉通紅，僵在原地。",
    "voice": null,
    "unit_id": null
  }
]
