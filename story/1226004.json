  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "欣賞完星空後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n優衣和{0}回到了人潮退去的海灘──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "水上步行球、",
    "voice": "vo_adv_1226004_000",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "愛的一心一意炒麵、",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n兩人羽織刨冰跟",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "情侶騎馬打仗啊……",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "剛開始",
    "voice": "vo_adv_1226004_001",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我有點嚇到，",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n想說怎麼會想出這種活動……",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "不過，",
    "voice": "vo_adv_1226004_002",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我現在覺得",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "正是因為這樣，",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n遊客才能玩得開心吧。",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "不是有那種，",
    "voice": "vo_adv_1226004_003",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "對戀愛很膽小的人嗎……？",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我想可能有些人，",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "沒有什麼契機時，",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n就會下意識把自己心情的順位",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "擺在後面……",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "所以我想這個大聲催促著客人",
    "voice": "vo_adv_1226004_004",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n「戀愛吧～！」、",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "「享受吧～！」",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "的慶典，",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n一定能成為",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "讓人面對戀愛的",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "良好契機。",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "因為不管哪項活動，",
    "voice": "vo_adv_1226004_005",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "都讓人心跳得很快嘛。",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "實際體驗過的我都這麼說了，",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "肯定不會錯。",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "嗯？",
    "voice": "vo_adv_1226004_006",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "奇怪，",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "周遭突然變亮了？",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n這也是什麼活動的準備──",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "啊！",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "啊啊啊，",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "奇怪？",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n好、",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "好刺眼，",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "什麼都看不見了～！",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "background",
    "bg_id": "510250"
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "呼，",
    "voice": "vo_adv_1226004_007",
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "好熱啊……",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "──{0}！？",
    "voice": "vo_adv_1226004_008",
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n你、",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "你怎麼會在這裡！？",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "啊，",
    "voice": "vo_adv_1226004_009",
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "這、",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "這樣啊！",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "說得也是。",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n夏天來海邊還會有什麼理由嘛。",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "啊哈，",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "啊哈哈……",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "嗚嗚，",
    "voice": "vo_adv_1226004_010",
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我真是的，",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "到底要什麼時候才會習慣啊……",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "小、",
    "voice": "vo_adv_1226004_011",
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "小麥色？",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "曬得那麼黑",
    "voice": "vo_adv_1226004_012",
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "沒問題嗎……？",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "啊，",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "不過",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "有點想看看",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "他曬成小麥色的樣子……",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "咦？",
    "voice": "vo_adv_1226004_013",
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我嗎？",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "──啊，",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "對、",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "對呀！",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我跟弟弟一起",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "來海邊玩水。",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n我弟弟好像遇到了朋友，",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "才一到海邊人就不見了……",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "咦……！",
    "voice": "vo_adv_1226004_014",
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "跟{0}，",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "兩個人游？",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "啊……",
    "voice": "vo_adv_1226004_015",
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "那個………………",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "好",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "啊。",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "哇、",
    "voice": "vo_adv_1226004_016",
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "哇啊……",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "結果要一起游泳了……！",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n平常在變成這樣之前，",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我不是嚇得慌慌張張，",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n就是會逃走的說……",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "果然夏天的海灘",
    "voice": "vo_adv_1226004_017",
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "就是有種特別的力量嗎……",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n有著連這麼害羞的我，",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "都、",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "都能變得大膽之類的",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "力量嗎……？",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "今天",
    "voice": "vo_adv_1226004_018",
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "有來真是太好了……",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n真是要感謝",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "一直吵著想去海邊的",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "弟弟……！　",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "{0}，等等我～！",
    "voice": "vo_adv_1226004_019",
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "────！",
    "voice": "vo_adv_1226004_020",
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "不過，",
    "voice": "vo_adv_1226004_021",
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "先等一下……　",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "他說的一起游泳……",
    "voice": "vo_adv_1226004_022",
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "是要一起游泳嗎？",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n咦、",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "咦咦咦咦咦，",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "仔細一想……",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "這不是……",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "非常",
    "voice": "vo_adv_1226004_023",
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "害羞的事情嗎！？　",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……因為",
    "voice": "vo_adv_1226004_024",
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "像是在換氣的瞬間",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "表情肯定會很奇怪，",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n蛙式看起來也像青蛙，",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "而仰式什麼的……",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "不行！",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "絕對游不來的啦～！　",
    "voice": null,
    "unit_id": 122631
  },
  {
    "type": "dialogue",
    "name": "優衣",
