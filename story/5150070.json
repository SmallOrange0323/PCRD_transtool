[
  {
    "type": "background",
    "bg_id": "502330"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "……我有點事要拜託你。",
    "voice": "vo_adv_5150070_000",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "喂，",
    "voice": "vo_adv_5150070_001",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n聽從別人的請求前，要先聽完內容再說喔？",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n要是我是騙子怎麼辦？",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "……算了，",
    "voice": "vo_adv_5150070_002",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "要你懷疑別人很勉強吧。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "協助你那方面也是我的職責嘛。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "所以……",
    "voice": "vo_adv_5150070_003",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那個……",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我要拜託你。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你可以──",
    "voice": "vo_adv_5150070_004",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "稍微讓我碰一下嗎？",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "所以就叫你稍微考慮一下了……",
    "voice": "vo_adv_5150070_005",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不，",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "算了。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我會做出這種請求",
    "voice": "vo_adv_5150070_006",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "是有原因的。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n你想，",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不是",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "一直都只是看著你嗎？",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "以前……",
    "voice": "vo_adv_5150070_007",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我是菲歐的時候，",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n雖然也可以輕易碰觸你。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "但我會忍不住想著，",
    "voice": "vo_adv_5150070_008",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "以這個模樣來做那件事",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "會怎麼樣。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "所以，",
    "voice": "vo_adv_5150070_009",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我就覺得要不",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "先像這樣，",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n以拜託的形式來習慣吧。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你",
    "voice": "vo_adv_5150070_010",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "有自覺你變成了說「可以喔」的機械嗎？",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "真是的。",
    "voice": "vo_adv_5150070_011",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那麼，",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "既然也得到許可了，",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那我就稍微失禮一下喔。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "……首先是",
    "voice": "vo_adv_5150070_012",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "手臂。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "哎呀，",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "肌肉挺發達的呢。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "也對啊，",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "畢竟你有確實",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "在做劍的訓練之類的",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "嘛。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "接著是……",
    "voice": "vo_adv_5150070_013",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "腿。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "很緊實嘛。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n畢竟",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你這雙腳總在迷路，",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "讓人很困擾呢。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "肚子……",
    "voice": "vo_adv_5150070_014",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "哦，",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "原來變成這樣了啊。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "嘿～",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "戳戳。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "開玩笑的啦。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "胸……",
    "voice": "vo_adv_5150070_015",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "就",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "以後有機會再說。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n並不是",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "因為我害羞喔？",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "最後是",
    "voice": "vo_adv_5150070_016",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "臉……",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "嗯。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n是我很熟悉的臉。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n用兩手摸的話……",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "是這種感覺啊。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "…………",
    "voice": "vo_adv_5150070_017",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "啊！",
    "voice": "vo_adv_5150070_018",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n不小心",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "忘我了，",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "抱歉喔。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "是因為我的體型不同嗎？",
    "voice": "vo_adv_5150070_019",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n總覺得",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好不可思議。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "在碰之前取得許可是正確答案呢。",
    "voice": "vo_adv_5150070_020",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n要是像以前一樣不客氣地觸碰，",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n我可能也成為變態可疑分子的同夥了。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我姑且",
    "voice": "vo_adv_5150070_021",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "先叮嚀你喔，",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n要是有",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "其他的誰拜託你這種事，",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n可不能二話不說就說可以喔？",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "該說你是毫無防備",
    "voice": "vo_adv_5150070_022",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "還是警戒心不夠呢？",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n因為你感覺不管對誰都很信任。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "！",
    "voice": "vo_adv_5150070_023",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "……",
    "voice": "vo_adv_5150070_024",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "可以喔……",
    "voice": null,
    "unit_id": 131711
  }
]
