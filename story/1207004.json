  {
    "type": "dialogue",
    "name": "旁白",
    "words": "結束參拜後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n雪菲與{0}待在神殿的角落，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n並等著前去觀看祭典的其他成員回來。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "唔、",
    "voice": "vo_adv_1207004_000",
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "嗯…………",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "……啊，",
    "voice": "vo_adv_1207004_001",
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "對不起。",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "總覺得好睏……",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "……咦？",
    "voice": "vo_adv_1207004_002",
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "什麼？",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n你要",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "把肩膀借我靠嗎……？",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "呵呵，",
    "voice": "vo_adv_1207004_003",
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "你真的",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "很會照顧人呢。",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "你說不定",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "在失去記憶之前，",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "其實是有弟弟妹妹吧？",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n如果是這樣，",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我想你一定是個好哥哥。",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "那麼，",
    "voice": "vo_adv_1207004_004",
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我就恭敬不如從命……",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "就靠一下子……",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "……謝謝你。",
    "voice": "vo_adv_1207004_005",
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n哥哥……",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "background",
    "bg_id": "510131"
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "…………！",
    "voice": "vo_adv_1207004_006",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "你是……",
    "voice": "vo_adv_1207004_007",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "……",
    "voice": "vo_adv_1207004_008",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "我、",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "我沒事啦……！",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "呃……",
    "voice": "vo_adv_1207004_009",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "好久不見……",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "不好意思，",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "讓你見笑了……",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n我只是",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "發生了點事情……",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "我才要問你",
    "voice": "vo_adv_1207004_010",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "怎麼了嗎？",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n……",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "總覺得",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "有股很香的味道……",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "不用了。",
    "voice": "vo_adv_1207004_011",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n花式滑冰大會快到了，",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "必須管理體重才行……",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n況且",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "我肚子也不會餓……",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "……！？",
    "voice": "vo_adv_1207004_012",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n這、",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "這個",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "不是啦……！",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "是因為有很香的味道，",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "肚子才不小心有反應了……",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "討厭，",
    "voice": "vo_adv_1207004_013",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "你別笑啦……",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "很難為情耶……",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "那個……",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "你把一半都給我了，",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "這樣真的好嗎？",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "……好吧，",
    "voice": "vo_adv_1207004_014",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "既然你本人都說可以了……",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "那……",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "我就不客氣了。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "still",
    "still_id": "120700401"
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "……啊唔。",
    "voice": "vo_adv_1207004_015",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n嚼嚼……",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "豪燙……",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "豪燙……",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "這麼燙很不容易吃呢。",
    "voice": "vo_adv_1207004_016",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "雖然有點烤焦了……",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "不過",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "我不討厭……",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "……嗯。",
    "voice": "vo_adv_1207004_017",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n我剛才明明還沒有食慾的……",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n不過這點量，",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "感覺一下子就能吃完了……",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "啊啊，",
    "voice": "vo_adv_1207004_018",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "怎麼辦……",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n讓人停不下來了……",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "呵呵……",
    "voice": "vo_adv_1207004_019",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "好好吃。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n真的，",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "好好吃……",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "background",
    "bg_id": "510131"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "……呼，",
    "voice": "vo_adv_1207004_020",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "多謝款待。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n我不曉得",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "有多少年沒吃過烤地瓜了呢……",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "這麼說來，第一次吃的時候也是……",
    "voice": "vo_adv_1207004_021",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "……我小時候",
    "voice": "vo_adv_1207004_022",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "曾經因為沒在花式滑冰大會上",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "獲得冠軍……",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n結果很不甘心，",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "我還第一次大哭了一場。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "那個時候……",
    "voice": "vo_adv_1207004_023",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "哥哥買來了烤地瓜，",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n然後我們就像在這樣",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "坐在一起吃。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "哥哥他",
    "voice": "vo_adv_1207004_024",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "算是不太多話的人，",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "但那時候",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "他卻不斷地問我",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "「好吃嗎？」……",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "哥哥真是的，從那時候就很保護過度呢……",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "是啊……",
    "voice": "vo_adv_1207004_025",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "他是我珍視的家人。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "……然而我，",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "卻對這樣的哥哥遷怒，",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "傷害了他……",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "我啊……",
    "voice": "vo_adv_1207004_026",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "因為膝蓋有受傷，",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "所以變得沒辦法跳躍了……",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n但我說什麼",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "都無法放棄……",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "所以一直持續復健。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "老實說，",
    "voice": "vo_adv_1207004_027",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "我曾經好幾次都快挫敗了。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "聽到那些我原本的對手在比賽中表現活躍，",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "而我卻是在忍痛",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "進行艱苦的復健，",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "真的很難受。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "哥哥因為擔心我，",
    "voice": "vo_adv_1207004_028",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n所以",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "不斷來陪我復健。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "……哥哥他自己",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "明明應該也很忙的。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "多虧如此，",
    "voice": "vo_adv_1207004_029",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "我才恢復到能正常度日的程度。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "可是",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "醫生",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "還是對我說……",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n我沒辦法回去溜花式滑冰。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "我真的覺得很沮喪……",
    "voice": "vo_adv_1207004_030",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "變得什麼事都不想做……",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "一直把自己",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "關在家裡面不出去……",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "或許是因為很擔心我，",
    "voice": "vo_adv_1207004_031",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n所以",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "哥哥他找我",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "一起去參拜。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "於是我們今天",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "去了附近的神社，但是……",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "…………",
    "voice": "vo_adv_1207004_032",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "……哥哥他",
    "voice": "vo_adv_1207004_033",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "在神壇前，",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "一直向神許願。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "很認真地",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "在祈求某件事。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "當我想通他是在為我許願時，",
    "voice": "vo_adv_1207004_034",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n整個腦袋",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "都變得一團混亂了。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "我明明很高興，",
    "voice": "vo_adv_1207004_035",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "卻覺得好難受。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "我明明想感謝哥哥，",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "卻又對他感到很煩躁。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "結果我就這樣對他說……",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "「許願又有什麼用？",
    "voice": "vo_adv_1207004_036",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "明明就不可能會實現！",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n我明明",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "再也跳不起來了！」",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "……",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "然後……",
    "voice": "vo_adv_1207004_037",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "我就逃到這裡來了。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "……我真的",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "用了最糟糕的方式跟哥哥撒嬌。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "可是",
    "voice": "vo_adv_1207004_038",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "我真的不懂，",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n在這種絕望的狀態下，",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "許願又有什麼意義……",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "……你許願的時候？",
    "voice": "vo_adv_1207004_039",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "……決心？",
    "voice": "vo_adv_1207004_040",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "…………",
    "voice": "vo_adv_1207004_041",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "……這樣啊，",
    "voice": "vo_adv_1207004_042",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "就是說呢。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "所謂的「願望」，",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "並不是為了讓其他人幫自己實現而許願的……",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "而是為了表明",
    "voice": "vo_adv_1207004_043",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "想實現願望的決心呢……",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n如果是這樣解釋，",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "那我或許就能理解許願的意義了。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "……就算許願，",
    "voice": "vo_adv_1207004_044",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "也不知道是否能實現。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "即使如此，我……",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "也還是不想放棄……",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "如果要說值得期待的事……",
    "voice": "vo_adv_1207004_045",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "就只有那個遊戲……",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "雖然這也有可能只是個傳聞，",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "但是……",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "有值得一試的",
    "voice": "vo_adv_1207004_046",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "價值……！　",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "……嗯。",
    "voice": "vo_adv_1207004_047",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "謝謝你聽我說話。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n總覺得你……",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "有一點",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "像我哥哥，",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n所以我好像",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "就依賴了你不少事情。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "呃……",
    "voice": "vo_adv_1207004_048",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "雖然有點晚才問，",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n但你的名字……",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "……！",
    "voice": "vo_adv_1207004_049",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n是哥哥打來的電話。",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "對不起，",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "我去接一下……",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "「…………紫布菜，",
    "voice": "vo_adv_1207004_050",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "妳在哪？」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "……我在公園。",
    "voice": "vo_adv_1207004_051",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106432
