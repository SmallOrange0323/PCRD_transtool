    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n因為哥哥太重了，",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n我只能拖著你走～",
