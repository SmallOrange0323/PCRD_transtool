    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "好溫柔～～♡",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "嘻嘻嘻ｗ",
    "voice": "vo_adv_1401003_011",
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "果然哥哥超好應付的♡",
