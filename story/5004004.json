[
  {
    "type": "background",
    "bg_id": "500160"
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我們趕快去把可蘿仔救出來吧 ！",
    "voice": "vo_adv_5004004_000",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n只要還沒死，可能還是能夠讓她恢復意識的，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我來用探測魔法",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "找找可蘿仔的位置！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "啊，",
    "voice": "vo_adv_5004004_001",
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "或許沒有這個必要。",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "如{0}所述，",
    "voice": "vo_adv_5004004_002",
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n魔物想把他們拖往的地方……",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n說不定是在海底，",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "有一座不可思議的遺跡之類的。",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "雖然只是我的推測，",
    "voice": "vo_adv_5004004_003",
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n可可蘿很有可能是被囚禁在那裡了。",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "當然我並不十分確定，",
    "voice": "vo_adv_5004004_004",
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n還需要以探測魔法之類的方式",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "來掌握正確資訊。",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我也能使用一定程度的魔法，請讓我助你們一臂之力。",
    "voice": "vo_adv_5004004_005",
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "畢竟可可蘿是",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "在【咲戀育幼院】一起生活，",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n非常重要的家人之一。",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我很想幫忙。",
    "voice": "vo_adv_5004004_006",
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "一定要幫到。",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n不能讓這麼好的孩子",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "遭受如此的劫難。",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "當然，我們的心情也是一樣的。",
    "voice": "vo_adv_5004004_007",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我們就同心協力",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "，一起把小可蘿救出來吧。",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "當然！",
    "voice": "vo_adv_5004004_008",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "　",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "真是的，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "本以為是一個和平安穩的假期啊！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n居然會變成這樣，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "命運之神的心眼也太壞了吧！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不過在這裡唉聲嘆氣也於事無補！",
    "voice": "vo_adv_5004004_009",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我們一起努力",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "把可蘿仔安然地救出來",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "再把魔物給痛扁一頓，圓滿得把事情解決，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "全部了結後再把它當個笑話吧！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "沒錯。",
    "voice": "vo_adv_5004004_010",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "{0}，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n你能再用往常的那種力量",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "強化我們嗎？",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "雖然我現在沒有「皇家裝備」了，",
    "voice": "vo_adv_5004004_011",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n所以處於相當脆弱的狀態，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "可能會給你們扯後腿。",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但我不會忘記自己已掌握的技術。",
    "voice": "vo_adv_5004004_012",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n只要有了{0}的強化，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n要擊退一些小嘍囉之類的小事還是沒問題的。",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "回答的好！",
    "voice": "vo_adv_5004004_013",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "　",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳是叫鈴莓對吧……",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "運用妳的探測魔法，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n找出可蘿仔的確切位置吧！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我會對全員",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "施展能自在地在",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "水中活動的魔法！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "目的地是海底的謎之遺跡，所以這魔法是必要的對吧？",
    "voice": "vo_adv_5004004_014",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n不過我的魔力所剩無幾了所以無法持續很久，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n目標是速戰速決哦！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "是！",
    "voice": "vo_adv_5004004_015",
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "　以防萬一，",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n我帶上了海之家備用的潛水氧氣瓶！",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n只要使用收納魔法，",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "就能做到一定程度的壓縮保存，便於攜帶了！",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "哦哦，",
    "voice": "vo_adv_5004004_016",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳也能使用收納魔法嗎？",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊啊，就是在第一天小凱留所使用的那招對嗎。",
    "voice": "vo_adv_5004004_017",
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n從一個空無一物的地方，",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "突然生出了泳圈和飲料之類東西的那招……？",
    "voice": null,
    "unit_id": 107511
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那可是相當高難度的魔法呢。",
    "voice": "vo_adv_5004004_018",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "哼哼，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "看不出妳也是一位",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "相當優秀的魔法師呢？",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不敢當不敢當！",
    "voice": "vo_adv_5004004_019",
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "　我並不會使用什麼難度很高的魔法，",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "只是在處理家事上",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "使用收納魔法的話非常方便就記起來了！",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n這是女僕必備的專業！",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "雖然比起身為魔法師，或是其他身分，",
    "voice": "vo_adv_5004004_020",
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "服侍大小姐的女僕才是我的本業！",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "鈴莓～！",
    "voice": "vo_adv_5004004_021",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "噫呀！？",
    "voice": "vo_adv_5004004_022",
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "　哦哦哦，大小姐～！",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n怎麼說您您就到呢？",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "大小姐您怎麼會在這裡？",
    "voice": "vo_adv_5004004_023",
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n是不是我忘記帶什麼東西……",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n您幫我送過來了？",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "不是！",
    "voice": "vo_adv_5004004_024",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n我看見",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "刊登瑪爾傑海岸發生異變的報導，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n非常擔心妳",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "就趕了過來啊！",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "因為可能會很危險，",
    "voice": "vo_adv_5004004_025",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n所以我沒把綾音和胡桃",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "一起帶來就是了。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "這是非常正確的判斷，大小姐！",
    "voice": "vo_adv_5004004_026",
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "其實，",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我們現在正處於相當危險的緊急情況當中～！",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "如此如此這般這般……我們為了救出可可蘿小姐，",
    "voice": "vo_adv_5004004_027",
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n準備出發前往海底的遺跡了。",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n大小姐，",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "您打算如何呢？",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "嗯～……雖然我也很想與你們同行，",
    "voice": "vo_adv_5004004_028",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n但我也得準備好，萬一發生什麼事，得聯絡軍隊或警察請他們出動。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "而且，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我曾是【王宮騎士團（NIGHTMARE）】的成員，多少還是有些人脈。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我要請他們派遣增援過來，",
    "voice": "vo_adv_5004004_029",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n徹底防止任何人靠近瑪爾傑海岸一帶。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n才不至於",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "發生二度傷害。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "那邊搞定後我會前去跟上你們，",
    "voice": "vo_adv_5004004_030",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n也會視情況趕去支援的……",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n所以任何情況都別客氣，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "馬上用通訊魔法聯絡我。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "快去吧！",
    "voice": "vo_adv_5004004_031",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n現在情況分秒必爭，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "你們要趕緊行動了！",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "是的，大小姐！",
    "voice": "vo_adv_5004004_032",
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n唔唔～",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "果然在緊急時刻就是這麼靠得住♪",
    "voice": null,
    "unit_id": 107712
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "啊哈哈……",
    "voice": "vo_adv_5004004_033",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我只是努力想成為，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n能讓妳",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "覺得值得服侍的",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "主人罷了。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好了，閒聊就到此為止了！",
    "voice": "vo_adv_5004004_034",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n趕緊準備好，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "迅速展開行動吧？",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我會給全員裹上一層空氣皮膜，",
    "voice": "vo_adv_5004004_035",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n利用風之魔法產生推進力，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這樣就能在水中高速移動了！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我覺得用不了多久就能到達海底遺跡，",
    "voice": "vo_adv_5004004_036",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n也就是",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "敵人的所在地！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "可能會即刻進入戰鬥，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "各位可要繃緊神經喲！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我們馬上就去救妳了～可蘿仔！",
    "voice": "vo_adv_5004004_037",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳可千萬要平安無事啊……！",
    "voice": null,
    "unit_id": 107811
  }
]
