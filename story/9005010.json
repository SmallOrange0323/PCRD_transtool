[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "聽了兩位老師的建議，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n雪菲決心要找到屬於自己的禮物。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "想送給他的東西。",
    "voice": "vo_adv_9005010_000",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "肯定",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "就在我的心中。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n仔細想想我現在",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "擁有什麼吧……！",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "對了……",
    "voice": "vo_adv_9005010_001",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "回憶。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我在蘭德索爾",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "遇見了【美食殿堂】的夥伴們，",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n並且由他們拉拔成長……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我的心裡",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "有滿滿的回憶。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "這些刻在我心底的",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "重要記憶……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我想……",
    "voice": "vo_adv_9005010_002",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "呈現給他看。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "不過，",
    "voice": "vo_adv_9005010_003",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "該怎麼做……？",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n至今為止我也做過不少東西……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "或許很困難，",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "但我還是想用屬於我自己的方式來傳達。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "……哎呀？",
    "voice": "vo_adv_9005010_004",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n妳是",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "【美食殿堂】的……",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "？",
    "voice": "vo_adv_9005010_005",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "妳們是──",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "這樣啊……",
    "voice": "vo_adv_9005010_006",
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "要送給那個人",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "的禮物……",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "把回憶作為禮物，",
    "voice": "vo_adv_9005010_007",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "真是個",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "很棒的想法呢～♪",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "可是，",
    "voice": "vo_adv_9005010_008",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我現在還沒有任何頭緒。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n該怎麼將回憶具體呈現",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "呢……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "確實是個難題啊。",
    "voice": "vo_adv_9005010_009",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "妳乾脆",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "跟我一起說相聲怎麼樣？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "相聲！？",
    "voice": "vo_adv_9005010_010",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "真是的，",
    "voice": "vo_adv_9005010_011",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "真陽。",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n妳不要什麼事都想跟相聲扯在一起嘛。",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "跟龍人族女孩搭檔",
    "voice": "vo_adv_9005010_012",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "肯定很有噱頭的啊～",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "吐槽就用她的尾巴啦！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "既然",
    "voice": "vo_adv_9005010_013",
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "要送東西，",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n果然還是送可以長久留存的比較好呢。",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "那種可以一再回顧……",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "然後露出笑容的東西。",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "……嗯。",
    "voice": "vo_adv_9005010_014",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n我也是",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "這麼認為。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "咦？",
    "voice": "vo_adv_9005010_015",
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n話說小鈴呢？",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n剛才不是還跟我們在一起嗎？",
    "voice": null,
    "unit_id": 105213
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "嗯～",
    "voice": "vo_adv_9005010_016",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "啊，",
    "voice": "vo_adv_9005010_017",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "鈴鈴，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "妳又在躺著看漫畫啦！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "說了多少次這樣很沒規矩的啦～！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "嗯～",
    "voice": "vo_adv_9005010_018",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "因為漫畫",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "很有趣啊。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我又不擅長跟人家討論事情～",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n少了我一個也沒差吧～",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "……漫畫？",
    "voice": "vo_adv_9005010_019",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "咦？",
    "voice": "vo_adv_9005010_020",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "妳不知道嗎～？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n就是這種把故事畫成圖，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "看起來很有趣的書啊～",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "──就是這個！",
    "voice": "vo_adv_9005010_021",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "噫！？",
    "voice": "vo_adv_9005010_022",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "幹嘛突然大叫啦，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "討厭～",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "靈感乍現，雪菲亟欲實行。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n與真陽等人告別後，隨即飛奔而去。",
    "voice": null,
    "unit_id": null
  }
]
