[
  {
    "type": "background",
    "bg_id": "509040"
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "好的，",
    "voice": "vo_adv_9500059_000",
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "切嚕被指名啦～！",
    "voice": null,
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "被選中的",
    "voice": null,
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "是世界級美少女！",
    "voice": null,
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "哎呀，",
    "voice": null,
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "真不愧是學長，",
    "voice": null,
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "眼光也太高明了吧！",
    "voice": null,
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "哎呀，",
    "voice": "vo_adv_9500059_001",
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "這可真是令人震驚的發展呢。",
    "voice": null,
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n不過，雖然琪愛兒倒也沒到那種地步，",
    "voice": null,
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n但原來學長超喜歡琪愛兒學妹呢，",
    "voice": null,
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "啊哈，我就知道～！",
    "voice": null,
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "嗯，",
    "voice": "vo_adv_9500059_002",
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "我知道的。",
    "voice": null,
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n知道學長喜歡我，",
    "voice": null,
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n也知道這份喜歡",
    "voice": null,
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "並沒有比起其他",
    "voice": null,
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "任何人來得特別。",
    "voice": null,
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "讓人從眾多選項中挑出唯一的一個，",
    "voice": "vo_adv_9500059_003",
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n我覺得所謂世界的命運，",
    "voice": null,
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "也真是挺殘酷的啊。",
    "voice": null,
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n最後凸顯出來的，",
    "voice": null,
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "就是被選中的那個，以及",
    "voice": null,
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "其他沒被選中的。",
    "voice": null,
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "雖然慈樂之音她們再怎麼說都不可能，",
    "voice": "vo_adv_9500059_004",
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "但有那麼大量的女孩子的話，",
    "voice": null,
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "其中大概也會有",
    "voice": null,
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n一、兩個不小心愛上那個",
    "voice": null,
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "不起眼男生的怪人吧。",
    "voice": null,
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "所以，",
    "voice": "vo_adv_9500059_005",
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "他大概",
    "voice": null,
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "是選了一個不會引起爭端的對象。",
    "voice": null,
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n就算選了，「其他人」也不會因此騷動的、",
    "voice": null,
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n只是稍微世界第一可愛的、",
    "voice": null,
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "不會出錯的普通美少女──",
    "voice": null,
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "──之類的，",
    "voice": "vo_adv_9500059_006",
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "只是我裝作客觀的獨家解讀啦。",
    "voice": null,
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "不過憑直覺來看，",
    "voice": null,
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "他潛意識裡",
    "voice": null,
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "或許真有那種意圖吧。",
    "voice": null,
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "因為他是個總是",
    "voice": null,
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "會選擇不傷害任何人的答案的人。",
    "voice": null,
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "唉……",
    "voice": "vo_adv_9500059_007",
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "你真的",
    "voice": null,
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "就是都這樣啊，學長。",
    "voice": null,
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "啊，",
    "voice": "vo_adv_9500059_008",
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "沒什麼。",
    "voice": null,
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n我的意思是，我就是喜歡你",
    "voice": null,
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "那點呢。",
    "voice": null,
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "不，",
    "voice": "vo_adv_9500059_009",
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "沒關係、",
    "voice": null,
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "沒關係。",
    "voice": null,
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "所以說，不懂也沒關係啦！",
    "voice": null,
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "話說回來，",
    "voice": "vo_adv_9500059_010",
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "我就是為了讓你聽不懂才用抱怨的啊，",
    "voice": null,
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "你不明白嗎？",
    "voice": null,
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n你把少女的祕密",
    "voice": null,
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "當成什麼？我揍飛你喔！？",
    "voice": null,
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "好啦，來吧，",
    "voice": null,
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "讓我們和和氣氣地去拯救世界吧！",
    "voice": null,
    "unit_id": 110941
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "切嚕～☆",
    "voice": null,
    "unit_id": 110941
  }
]
