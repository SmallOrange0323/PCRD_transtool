    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "動作快，騎士先生！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "看著日和充滿活力奔跑起來的模樣，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}鬆了一口氣地追在她身後。",
    "voice": null,
