  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "順利將詐欺犯們交給【王宮騎士團】後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n日和及{0}一邊尋找拍攝的好地點，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n一邊徒步返回蘭德索爾。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "那位老奶奶的信",
    "voice": "vo_adv_1087007_000",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "還放在我們這裡，",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "所以得趕緊回去呢。",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "要是再慢吞吞的話，",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "太陽就要下山了。",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "你看，",
    "voice": "vo_adv_1087007_001",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "夕陽都已經……",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "咦？",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "現在還很早嗎？",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "那麼",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這道光是……",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "騎、",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "騎士先生！？",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "background",
    "bg_id": "510363"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "才剛過年幾天……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}走在路上要前往附近的神社，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n這時他看到一個熟悉的人蹲在路邊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "痛痛痛……",
    "voice": "vo_adv_1087007_002",
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n嗯～",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "還是太勉強自己了嗎……",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "咦？",
    "voice": "vo_adv_1087007_003",
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "學長？",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n你怎麼會在這裡……",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "啊，",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "要說的話我也一樣呢。",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "啊，",
    "voice": "vo_adv_1087007_004",
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "新",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "年快樂。",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n嗯。",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我現在正要去神社。",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "啊，",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "學長果然也是要去神社吧。",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "你知道嗎？",
    "voice": "vo_adv_1087007_005",
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n聽說那座神社",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "能保佑大家的腳和腰喔！",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我奶奶的腰好像很痛，",
    "voice": "vo_adv_1087007_006",
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n所以我想要去那參拜，",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "祈禱她能趕快好起來……",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "但卻被穿不慣的木屐",
    "voice": "vo_adv_1087007_007",
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "咬腳……",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "不對，",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n是被木屐繫帶？",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "磨傷腳趾縫了。",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "咦咦！",
    "voice": "vo_adv_1087007_008",
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n那樣子",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "不好啦……",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "而且，",
    "voice": "vo_adv_1087007_009",
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我現在",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "穿的是和服，",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "所以衣襬很窄……",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "你說，",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "既然這樣就借我搭個肩，",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "是嗎？",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "但是，",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這本來就是我自己準備不足……",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "真是的……",
    "voice": "vo_adv_1087007_010",
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "聽你那麼一說",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我就無法拒絕了嘛……",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "那麼，",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "就麻煩你囉。",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "background",
    "bg_id": "510303"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}讓日和搭著肩，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n一邊尋找能小歇一會兒的地方。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "謝謝你，",
    "voice": "vo_adv_1087007_011",
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "學長。",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n到這裡就行了。",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n再繼續走",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "也很引人注目……",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我坐著休息一下",
    "voice": "vo_adv_1087007_012",
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "就沒事了。",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "咦？",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……",
    "voice": "vo_adv_1087007_013",
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "竟然，",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "要我等你。",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "學長，",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "你真是溫柔。",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n明明可以丟著我不管的……",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "沒有啦，",
    "voice": "vo_adv_1087007_014",
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "開玩笑的。",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我其實",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "沒有那麼想。",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "明明自己也",
    "voice": "vo_adv_1087007_015",
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "覺得很丟臉，",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "卻還向學長撒嬌了。",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "唉……",
    "voice": "vo_adv_1087007_016",
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "都是因為一時衝動穿了新年和服來，",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n才給學長添麻煩了……",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "才剛過新年",
    "voice": "vo_adv_1087007_017",
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "就諸事不順，",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "心情真是開心不起來……",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "需要別人加油的人，",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "就是這樣的心情吧。",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "再說，",
    "voice": "vo_adv_1087007_018",
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我會這麼認真打扮，",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n就是因為想說，",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "有可能在路上碰巧遇到學長嘛……",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "遇是遇到了，",
    "voice": "vo_adv_1087007_019",
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "但竟然演變成這樣，",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n這我根本沒想過啊～！",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "可能因為在過新年，",
    "voice": "vo_adv_1087007_020",
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "就有點太興奮了……",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "好，",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "等學長回來後",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我就要告訴他，",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n我能夠自己",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "叫計程車回去。",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "啊，",
    "voice": "vo_adv_1087007_021",
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "學長……",
    "voice": null,
    "unit_id": 108732
  },
