    "name": "日和",
    "words": "不是，",
    "voice": "vo_adv_1087007_049",
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "雖然也很感謝你帶來這桶熱水，",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n但不是只為了這個，",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "還有很多事……",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我的腳已經沒事了，",
    "voice": "vo_adv_1087007_050",
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我跟你一起",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n把裝了熱水的桶子拿去還吧。",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "熱水……",
    "voice": "vo_adv_1087007_051",
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "倒進水溝裡就可以了吧？",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "好～！",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n那就，",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "出發前進～！",
    "voice": null,
    "unit_id": 108732
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就這樣，{0}和",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n恢復往常朝氣的日和，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n一起前往神社進行新年參拜。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好，",
    "voice": "vo_adv_1087007_052",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "辛苦了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n這對你來說",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "是第幾次的初夢了啊？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "當護花使者的手法",
    "voice": "vo_adv_1087007_053",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "有點太強硬了，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "但對現在的日和來說剛剛好吧？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "……我姑且問一下，",
    "voice": "vo_adv_1087007_054",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你的心態應該不是，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n只是想",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "摸她的腳吧？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你有時候會突然做出很反常的事嘛，",
    "voice": "vo_adv_1087007_055",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n所以就",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "姑且",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "問一下。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "喂，",
    "voice": "vo_adv_1087007_056",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "別把視線移開。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "算了，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "沒關係。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "以後當日和心情低落時，就要像這樣替她加油。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你啊，",
    "voice": "vo_adv_1087007_057",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "平常都是別人在替你加油吧？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "能自然地互相鼓勵是很棒的一件事，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n你好好珍惜吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那就下次見。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500560"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}在身體被搖晃而產生的震動中醒了過來。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "騎～士～先～生～",
    "voice": "vo_adv_1087007_058",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "真是的！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "啊，",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "醒了嗎？",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n在這種地方睡覺",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "是會著涼的喔！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "雖然，",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我剛才也睡著了啦……",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "不過，",
    "voice": "vo_adv_1087007_059",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "總覺得",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我的雙腳暖暖的。",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n騎士先生，",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "該不會是你替我暖腳了吧？",
