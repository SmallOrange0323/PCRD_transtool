    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "唔……",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "有沒有人",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "可以準備水？",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "同學",
    "words": "嗯！",
    "voice": "vo_adv_1252004_059",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學",
    "words": "\\n這就由我來做吧！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "幫了大忙！",
    "voice": "vo_adv_1252004_060",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我來送餐！",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "同學",
    "words": "為了讓他跟莫妮卡可以更方便行動，",
    "voice": "vo_adv_1252004_061",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學",
    "words": "\\n我來負責引導客人",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學",
    "words": "和點餐喔……！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學",
    "words": "如果能這樣維持下去，",
    "voice": "vo_adv_1252004_062",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學",
    "words": "營業額也許會很可觀……！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學",
    "words": "\\n我也該向他們兩人看齊，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "同學",
    "words": "好好努力！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "510181"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "抱歉，",
    "voice": "vo_adv_1252004_063",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我剛剛在換衣服所以晚了一點！",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……你說不換衣服也沒關係？",
    "voice": "vo_adv_1252004_064",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "確實有些不捨那身裝扮，",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n但也不適合穿著圍裙到處晃啊。",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "話說回來，",
    "voice": "vo_adv_1252004_065",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "終於告一段落了呢。",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "雖然有一度",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "還在想會變成怎樣，",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "不過最後結果很不錯。",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "沒想到事先準備的食材",
    "voice": "vo_adv_1252004_066",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "會全部用完……",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n雖然多虧於此我們也好好能休息，",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "但還是",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "有點可惜啊。",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "不過同學們似乎都很開心，",
    "voice": "vo_adv_1252004_067",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "真是太好了。",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "特別是我和閣下的共同戰線",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "表現得令人驚嘆！",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "沒想到我這樣的體型也能派上用場……",
    "voice": "vo_adv_1252004_068",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "至今為止都以為這只是個缺陷，",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "原來偶爾也能派上用場呢。",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "只有今天……",
    "voice": "vo_adv_1252004_069",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "也許我應該感謝自己很矮小這件事。",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……當然，",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "只有今天喔？",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "說到感謝，",
    "voice": "vo_adv_1252004_070",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我反而",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "該對閣下道謝呢。",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n如果閣下不在的話，",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "事情會變得怎麼樣呢……",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我要再次向你道謝。",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "不只是讓模擬咖啡廳重整旗鼓，",
    "voice": "vo_adv_1252004_071",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n讓我能夠用全新的角度看待事情。",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "而且……",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "也讓我完成了名為",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "「全力享受青春」的",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "個人任務啊！",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "呵呵，",
    "voice": "vo_adv_1252004_072",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "你又在謙虛了。",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這也是",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "閣下的作風啊。",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "不過呢，",
    "voice": "vo_adv_1252004_073",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我們稍微",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "慰勞一下自己吧？",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "所以我",
    "voice": "vo_adv_1252004_074",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "提議現在來辦個小小的慶祝會！",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "場地當然就是",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "那間懷舊點心店！",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "當然，",
    "voice": "vo_adv_1252004_075",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "閣下你也贊成對吧？",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好的，",
    "voice": "vo_adv_1252004_076",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "辛苦了～",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "兩位的",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "合作真的很厲害呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n默契十足，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "感覺完全就是夥伴了呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "而且，",
    "voice": "vo_adv_1252004_077",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "如果有稍微化解她的煩惱就好。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "雖然我是覺得不用這麼在意也沒關係。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n小小隻的也很可愛嘛。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不過每個人的煩惱因人而異呢。",
    "voice": "vo_adv_1252004_078",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "她似乎也做了各種努力，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "得為她加油才行。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "為了讓那孩子以後也能露出笑容，",
    "voice": "vo_adv_1252004_079",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你也要加油喔。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那麼，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "再見囉～",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "501950"
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "嗯……",
    "voice": "vo_adv_1252004_080",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這裡是……",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我剛才",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "睡著了嗎。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "閣下也睡著了嗎？",
    "voice": "vo_adv_1252004_081",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我們",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "可能都累了呢。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "話說回來，",
    "voice": "vo_adv_1252004_082",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "沒想到我們連在夢裡還是在一起工作……",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "雖然是個奇怪的夢……",
    "voice": "vo_adv_1252004_083",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "嗯",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "，",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "感覺還不差。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "雖然我剛才",
    "voice": "vo_adv_1252004_084",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "抱怨被當成小孩子看待……",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n不過這個體型讓他們比較容易對我傾訴的話，",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n我就當作是我的優勢吧。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "那麼，",
