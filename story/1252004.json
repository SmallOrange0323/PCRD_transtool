[
  {
    "type": "background",
    "bg_id": "501950"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}走進店裡時，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n一個孩子正在和莫妮卡說話。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "這樣啊……",
    "voice": "vo_adv_1252004_000",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "我懂了！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "\\n如果遇到那孩子的話我會試試向他搭話的！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "嗯，",
    "voice": "vo_adv_1252004_001",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這樣就好。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "對方一定會很開心。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "嗯！",
    "voice": "vo_adv_1252004_002",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "\\n謝謝妳聽我說！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "歡迎隨時過來。",
    "voice": "vo_adv_1252004_003",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "當然，",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "來買點心也可以喔。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "你來啦。",
    "voice": "vo_adv_1252004_004",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "{0}。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "嗯？",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "你問剛才的男孩子嗎。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "他是來找我諮商的。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "前幾天走失兒童那件事",
    "voice": "vo_adv_1252004_005",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "似乎在孩子們之間傳開了。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這裡好像就被當成能夠理解孩子心情的懷舊點心店",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n而大受好評的樣子。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "煩惱這種事",
    "voice": "vo_adv_1252004_006",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "不只大人有，",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "孩子們也會有煩惱。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n而這些孩子們也開始來這裡諮商了。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "雖然大部分都是一些小煩惱，",
    "voice": "vo_adv_1252004_007",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "不過聆聽也是很重要的對吧？",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "所以",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "有時間的話我就會聽他們訴說。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "認真對待小孩子",
    "voice": "vo_adv_1252004_008",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "是年長者",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "應該做的。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "而且",
    "voice": "vo_adv_1252004_009",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "因為這裡是懷舊點心店。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "所以這也是接待客人的一部分。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "他們也有可能順便買點心吃，",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n將來",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "也有可能加入我們公會哪！",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……不過",
    "voice": "vo_adv_1252004_010",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我有點在意，",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n孩子們有時候",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "會把我當成同齡的兒童。",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "就像朋友一樣很容易就對我傾訴什麼的……",
    "voice": "vo_adv_1252004_011",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……閣下，",
    "voice": "vo_adv_1252004_012",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "你從剛剛就很安靜，",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n有話想說就說啊？",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "咦？",
    "voice": "vo_adv_1252004_013",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "因為我很小隻所以沒辦法……",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我可沒辦法當作沒聽見啊！",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "喂，",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "等一下！",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "給我道歉！",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "咦……",
    "voice": "vo_adv_1252004_014",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "好像有東西在發光……！",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這、",
    "voice": "vo_adv_1252004_015",
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這是",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "怎麼回事……",
    "voice": null,
    "unit_id": 125212
  },
  {
    "type": "background",
    "bg_id": "510210"
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "歡迎來到椿丘高中！",
    "voice": "vo_adv_1252004_016",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這裡是模擬咖啡廳。",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我們有罕見的點心、紅茶、",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "花草茶應有盡有！",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "為了今天，",
    "voice": "vo_adv_1252004_017",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我們還準備了其他各種東西！",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "一定要來逛逛喔！",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "難得的文化祭，",
    "voice": "vo_adv_1252004_018",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n這次的模擬咖啡廳企畫是我們全班一致通過的！",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "要是都沒有客人會感到很落寞呢！",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "確實地完成工作是一名優良軍人的職責。",
    "voice": "vo_adv_1252004_019",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "來吧，",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "打起精神囉！",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "為了不要輸給其他班，",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "再大聲一點！",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "快，",
    "voice": "vo_adv_1252004_020",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "閣下不出聲的話",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "是不會有客人進來的喔？",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "嗯，",
    "voice": "vo_adv_1252004_021",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "感覺很好！",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "好──",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我也來！！",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "排隊隊伍已經這麼長了啊。",
    "voice": "vo_adv_1252004_022",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n應該暫時先少招攬一些客人嗎。",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "裡面的人也很忙的樣子……",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "沒問題嗎。",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "怎麼了，",
    "voice": "vo_adv_1252004_023",
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "閣下？",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……你說要去看看狀況？",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "嗯",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "，",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "麻煩了。",
    "voice": null,
    "unit_id": 105331
  },
  {
    "type": "dialogue",
    "name": "顧客1",
    "words": "你看你看，",
    "voice": "vo_adv_1252004_024",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "顧客1",
    "words": "這個模擬咖啡廳",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "顧客1",
    "words": "裡面很多人呢！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "顧客1",
    "words": "\\n聽說好像有很罕見的點心。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "顧客2",
    "words": "多瑙波紋蛋糕……",
    "voice": "vo_adv_1252004_025",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "顧客2",
    "words": "蜂螫蛋糕……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "顧客2",
    "words": "\\n感覺名字都很不可思議，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "顧客2",
    "words": "可是看起來都很好吃呢。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "顧客2",
    "words": "\\n進去……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "顧客2",
    "words": "的話要排隊啊～",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "顧客1",
    "words": "這個",
    "voice": "vo_adv_1252004_026",
    "unit_id": null
  },
