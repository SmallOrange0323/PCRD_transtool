[
  {
    "type": "background",
    "bg_id": "509040"
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "真的嗎……？",
    "voice": "vo_adv_9500005_000",
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n騎士先生，",
    "voice": null,
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "真的真的，",
    "voice": null,
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "要選我嗎？",
    "voice": null,
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……欸嘿嘿，",
    "voice": "vo_adv_9500005_001",
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "欸嘿嘿嘿嘿……",
    "voice": null,
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n這樣啊，",
    "voice": null,
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這樣啊……",
    "voice": null,
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……那個，",
    "voice": "vo_adv_9500005_002",
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "對不起，突然笑出來。",
    "voice": null,
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "但是，",
    "voice": null,
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "一想到騎士先生",
    "voice": null,
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "選擇了我，",
    "voice": null,
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n就忍不住開心了起來。",
    "voice": null,
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我偶爾會想。",
    "voice": "vo_adv_9500005_003",
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "「要是騎士先生選擇我，",
    "voice": null,
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我會是怎麼樣的",
    "voice": null,
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "心情呢？」。",
    "voice": null,
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我也是，",
    "voice": "vo_adv_9500005_004",
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "如果要成為誰的唯一，",
    "voice": null,
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我希望那會是騎士先生。",
    "voice": null,
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "沒想到會有這一天，",
    "voice": null,
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我也嚇了一跳！",
    "voice": null,
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "真是的～！",
    "voice": null,
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "騎士先生，",
    "voice": "vo_adv_9500005_005",
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "果然總是能讓我展露笑容呢！",
    "voice": null,
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n無論何時、",
    "voice": null,
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "何地……",
    "voice": null,
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "所以我的心",
    "voice": null,
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "才會",
    "voice": null,
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這樣揪緊。",
    "voice": null,
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "那個，",
    "voice": "vo_adv_9500005_006",
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "騎士先生。",
    "voice": null,
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n之前在海邊說的話，",
    "voice": null,
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我想再說一次。",
    "voice": null,
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n你願意接受嗎？",
    "voice": null,
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "因為會很大聲，",
    "voice": "vo_adv_9500005_007",
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n所以稍微後退一點，",
    "voice": null,
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "一步……",
    "voice": null,
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "兩步……",
    "voice": null,
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "三步……",
    "voice": null,
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "好了。",
    "voice": null,
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……",
    "voice": "vo_adv_9500005_008",
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "騎士先生！",
    "voice": null,
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n最喜歡你了──！！",
    "voice": null,
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……！",
    "voice": "vo_adv_9500005_009",
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n騎士先生……！",
    "voice": null,
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "抱緊────！",
    "voice": "vo_adv_9500005_010",
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……欸嘿嘿嘿。",
    "voice": null,
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n我們，",
    "voice": null,
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "真的是兩情相悅呢！",
    "voice": null,
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "要一直在一起喔，",
    "voice": "vo_adv_9500005_011",
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "騎士先生！",
    "voice": null,
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n今後要兩人一起笑著度過每一天！",
    "voice": null,
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100141
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "約好囉！",
    "voice": null,
    "unit_id": 100141
  }
]
