    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "……咦？　",
    "voice": "vo_adv_1095004_023",
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "不是那意思……",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "是說我很適合穿和服嗎！？",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "你、",
    "voice": "vo_adv_1095004_024",
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "你是在",
