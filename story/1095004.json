    "name": "空花",
    "words": "\\n是這個意思吧！？　",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "嘻嘻……",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "嘻！？",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "空、",
    "voice": "vo_adv_1095004_027",
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "空花、",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "絆到腳了……",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "虐待狂先生",
