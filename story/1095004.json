    "type": "dialogue",
    "name": "空花",
    "words": "和服……",
    "voice": "vo_adv_1095004_025",
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "是很容易穿脫的服裝，",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n你這個人格異常的虐待狂先生怎麼可能不知道……",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "就是說……",
    "voice": "vo_adv_1095004_026",
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "你更喜歡脫下和服的我囉……",
    "voice": null,
    "unit_id": 104532
  },
  {
