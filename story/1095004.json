  {
    "type": "dialogue",
    "name": "旁白",
    "words": "空花醒來時已是夜晚，身在公會小屋裡。\\n她發現不知道為什麼和{0}兩人獨處。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "為什麼我會在這裡……",
    "voice": "vo_adv_1095004_000",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "啊！",
    "voice": "vo_adv_1095004_001",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "難道是虐待狂先生",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "給空花吃了可疑的藥……！？",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "然後",
    "voice": "vo_adv_1095004_002",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "把意識不清的空花帶到房間裡，",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n正打算對我做出",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "不得了的事情嗎！？",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "也就是說空花……",
    "voice": "vo_adv_1095004_003",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "接下來就要變成大人了……！",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "……咦？　",
    "voice": "vo_adv_1095004_004",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "不、",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "不是嗎？",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "是、",
    "voice": "vo_adv_1095004_005",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "是因為空花又",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "咦――",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "的旋轉，",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "轉得頭暈眼花",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n所以你只是帶我到附近的公會小屋……",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "休息而已嗎？",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "這、",
    "voice": "vo_adv_1095004_006",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "這麼說來，",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "我好像有一點模糊的印象……",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "咦？　",
    "voice": "vo_adv_1095004_007",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "可是，",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "狀況差不了多少吧……？",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "你看嘛，",
    "voice": "vo_adv_1095004_008",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "現在這樣，",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "這個狀況不就是把我外帶了嗎……！",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "空花今天",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "就要羽化成夜之蝴蝶",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "展翅飛翔了……！",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "嗯！　",
    "voice": "vo_adv_1095004_009",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "怎、",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "怎麼了？　",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "房裡的燈突然亮了起來！？",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "一般這時候",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "不是該暗下來嗎……！",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "呀啊啊啊啊啊啊啊！！",
    "voice": "vo_adv_1095004_010",
    "unit_id": 109511
  },
  {
    "type": "still",
    "still_id": "109500401"
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "嗚嗚，",
    "voice": "vo_adv_1095004_011",
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "人家不習慣穿和服……",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "好難行動……",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n然後，",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "你還要人家穿這樣",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "來服務客人……",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "不過，",
    "voice": "vo_adv_1095004_012",
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "這個腰帶的束縛感還不差……",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "應該說很棒！　",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "（流口水）。",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "啊，",
    "voice": "vo_adv_1095004_013",
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "現在得專心工作才行……",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "歡迎光臨……",
    "voice": "vo_adv_1095004_014",
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "欸欸欸欸！？",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "你、",
    "voice": "vo_adv_1095004_015",
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "你是虐待狂先生！",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "你到這種地方來，",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "是要羞辱空花的吧……",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "（流口水）。",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "虐待狂先生對努力服務客人的空花，",
    "voice": "vo_adv_1095004_016",
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n發出殘忍的命令……",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "空花雖然不情願，",
    "voice": "vo_adv_1095004_017",
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "但是身為",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "員工，",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n無法違抗是客人的虐待狂先生……",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "被他強迫",
    "voice": "vo_adv_1095004_018",
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "做了菜單上沒有的……！",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n嘻嘻嘻……",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "……啊，",
    "voice": "vo_adv_1095004_019",
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "好的！　",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "我又沉浸在妄想裡了！",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "對不起，虐待狂先生，",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "您要點餐了嗎？",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "still",
    "still_id": "109500402"
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "你、",
    "voice": "vo_adv_1095004_020",
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "你的意思是",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "想要點空花嗎！？",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "如此大膽的點餐……",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "空花",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "該怎麼辦……",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "（流口水）。",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "still",
    "still_id": "109500402"
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "所、",
    "voice": "vo_adv_1095004_021",
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "所以說，",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "是要我把這件和服脫下來給你嗎！？",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "突然就玩這麼大……",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "嘻嘻嘻。",
    "voice": null,
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "不過，",
    "voice": "vo_adv_1095004_022",
    "unit_id": 104532
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "這是店裡的東西……",
