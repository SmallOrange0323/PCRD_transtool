  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "我就知道～",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "這樣",
    "voice": "vo_adv_1233003_031",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "好嗎？",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "你們還在回家途中呢，真不好意思……！",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "嗯～",
    "voice": "vo_adv_1233003_032",
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "好",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "啦～",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n我",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "就在這裡等你吧～",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "background",
    "bg_id": "500011"
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "喔～",
    "voice": "vo_adv_1233003_033",
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "小騎士。",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "歡迎回來～",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "你花了不少時間呢。",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n剛才那位老婆婆的家，",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "看來挺遠的～",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "我嗎？",
    "voice": "vo_adv_1233003_034",
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "我不要緊啦。",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n我只是在看著那邊那座公園的正太",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "養眼一下而已～",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "別管那個了～",
    "voice": "vo_adv_1233003_035",
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n小騎士，",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "你真的很溫柔呢～",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "可是～",
    "voice": "vo_adv_1233003_036",
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n你這麼善良～",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n說不定",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "會被很壞～的人騙喔～",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "因為到處都會有奸詐的傢伙，",
    "voice": "vo_adv_1233003_037",
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n有心利用像小騎士一樣的孩子～",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "……！",
    "voice": "vo_adv_1233003_038",
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n小騎士你啊～",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "你這一點",
    "voice": "vo_adv_1233003_039",
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "就像小孩一樣呢～",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n像是個純真無邪的男孩子～",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "如果你是正太，我早就不小心出手了～",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "不過，",
    "voice": "vo_adv_1233003_040",
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "你真的要多加注意喔～",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n不然，",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "你遲早會被壞人纏上的～",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "不過，",
    "voice": "vo_adv_1233003_041",
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "我嘴上這麼說，",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n但我也不全然是你的夥伴啦～",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "嗯？",
    "voice": "vo_adv_1233003_042",
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "那麼，",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n我為什麼要嘮叨個不停呢？　",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "拜託了～",
    "voice": "vo_adv_1233003_043",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "要是大家不買點什麼，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "\\n在家等我的小孩",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "就要沒飯吃了～",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "唔，",
    "voice": "vo_adv_1233003_044",
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "那位大叔真吵呢，",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n難得我正在想事情～",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "呃，",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "小騎士……？",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "我這邊",
    "voice": "vo_adv_1233003_045",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "都是些超稀有的商品。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "如何？",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "\\n請當作這是助人為樂～！",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "嗚哇！？",
    "voice": "vo_adv_1233003_046",
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "小騎士，",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "難道說？",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n又要幫助別人～？",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "真是善良過頭了……",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "小騎士覺得好就好～",
    "voice": "vo_adv_1233003_047",
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "嗯～",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "可是啊～",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "謝謝你啊小哥～！",
    "voice": "vo_adv_1233003_048",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "\\n那你多買一點吧～！",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "\\n我家中還有一個體弱多病的老婆需要醫藥費～",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "求求你！",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "拜託你！",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "嗯～",
    "voice": "vo_adv_1233003_049",
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n我好～像不太喜歡那個大叔～",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "去看一下狀況吧～",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "如何？",
    "voice": "vo_adv_1233003_050",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "可以吧？",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "\\n",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "這世界都是些冷酷無情的人，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "但小哥你不一樣吧？",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "\\n",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "我不會讓你吃虧的，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "就在我這裡買吧～",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "那個～",
    "voice": "vo_adv_1233003_051",
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "我說～？",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n小騎士，你在做什麼～？",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "我們該回去了喔～",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "哎呀？",
    "voice": "vo_adv_1233003_052",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "小姐，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "妳是這位小哥的同伴嗎？",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "\\n",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "妳真可愛呢～！",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "\\n買點什麼吧。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "像是使肌膚充滿光澤的保養品等等，如何──？",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "這是保養品～？",
    "voice": "vo_adv_1233003_053",
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "嗯～～～？",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "嗅嗅……",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "哎呀，",
    "voice": "vo_adv_1233003_054",
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "等等～",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n大～叔，你在跟我開玩笑嗎～？",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "這是",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "史萊姆的黏液吧？",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "！？",
    "voice": "vo_adv_1233003_055",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "為、",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "為什麼她會知道這件事……！？",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "\\n",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "為了不被發現，我明明已經添加香氣，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "沖淡氣味……！",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "……哈哈哈，",
    "voice": "vo_adv_1233003_056",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "小姐，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
