  {
    "type": "dialogue",
    "name": "旁白",
    "words": "萬聖節也接近尾聲了，\\n路上的孩子們也都踏上了歸途。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "傑克～！　",
    "voice": "vo_adv_5007007_000",
    "unit_id": 212
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "再見囉～！",
    "voice": null,
    "unit_id": 212
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "嗯！　明年見！　",
    "voice": "vo_adv_5007007_001",
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "我玩得很開心喔！",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "唔～",
    "voice": "vo_adv_5007007_002",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "傑克你也許很滿足，",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n但宮子沒要到布丁非常生氣來的！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "妳不是也收到很多",
    "voice": "vo_adv_5007007_003",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "糖果和巧克力嗎？",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "不是布丁就沒有意義了啦～",
    "voice": "vo_adv_5007007_004",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "布丁布丁布～丁！　",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "傑克，你再變一次布丁嘛～",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "我已經沒辦法變了啦！　",
    "voice": "vo_adv_5007007_005",
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "而且，",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "\\n我也不想再被妳吃了！",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "太過分了……",
    "voice": "vo_adv_5007007_006",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "人家拯救了萬聖節……",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "卻落得這種下場，太過分了～！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "呵呵，",
    "voice": "vo_adv_5007007_007",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "宮子，",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "妳忘了嗎？",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "忘了？　",
    "voice": "vo_adv_5007007_008",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "忘了什麼……來……的",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "啊！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "人家想起來了！！　",
    "voice": "vo_adv_5007007_009",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "萬聖節派對來的！！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "是。",
    "voice": "vo_adv_5007007_010",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "調查也結束了……",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我們來去參加派對吧。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "人家一直很期待呢～！",
    "voice": "vo_adv_5007007_011",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n{0}和傑克也一起去吧～",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "咦？　",
    "voice": "vo_adv_5007007_012",
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "我也可以一起去嗎！？",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "當然來的！　",
    "voice": "vo_adv_5007007_013",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "這種場合還是越多人越開心！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子在遇見忍他們之前，",
    "voice": "vo_adv_5007007_014",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "一直覺得一個人也不寂寞。",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "可是，現在已經不一樣了！　",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "果然，還是有朋友最好！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "所以，你也一起來吧！",
    "voice": "vo_adv_5007007_015",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n這樣子，",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "就會更加更～加幸福喔！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "哼，",
    "voice": "vo_adv_5007007_016",
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "我可沒有原諒你這混蛋！",
    "voice": null,
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n但既然忍和小鬼都這麼說了，只好讓你一起來了！",
    "voice": null,
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "充滿，",
    "voice": "vo_adv_5007007_017",
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "幸福……",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "\\n",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "這樣啊……",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "既然這樣，那我也要參加派對！",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "background",
    "bg_id": "500022"
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "這間店",
