    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "噫！　",
    "voice": "vo_adv_5007007_038",
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "忍好可怕！",
    "voice": null,
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "真的～！　",
    "voice": "vo_adv_5007007_039",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "這都是宮子努力得來的～！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "{0}你也多帶些布丁過來吧～",
    "voice": "vo_adv_5007007_040",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "今天的主角是宮子來的～！",
    "voice": "vo_adv_5007007_041",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "這些布丁，全部都是宮子的～！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n人家要一個人獨佔～！　",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "傑克你也不准碰布丁！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "一個人獨佔也太狡猾了！",
    "voice": "vo_adv_5007007_042",
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "\\n分一點幸福給我嘛！",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "吃布丁的幸福，",
    "voice": "vo_adv_5007007_043",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "是宮子的特權來的！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n你只能享受別的樂趣！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "宮子，",
    "voice": "vo_adv_5007007_044",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "他對妳提出交換條件時，",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n妳不是說和我一起吃布丁才會幸福嗎？",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "唔……",
    "voice": "vo_adv_5007007_045",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "妳聽到了嗎～？　",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "可是，這個布丁是……",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "唔～",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "忍，妳有點壞心喔。",
    "voice": "vo_adv_5007007_046",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那麼，",
    "voice": "vo_adv_5007007_047",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "妳是討厭我嗎？",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "不是的～！　",
    "voice": "vo_adv_5007007_048",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "人家最喜歡妳了～！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "妳又故意說這些壞心眼的話～！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "呵呵呵，",
    "voice": "vo_adv_5007007_049",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "因為妳當時說的話讓我太高興了，",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n忍不住想逗妳一下。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "我、我收回那些話～！",
    "voice": "vo_adv_5007007_050",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "布丁都是宮子一個人的～！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "好～",
    "voice": "vo_adv_5007007_051",
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "傑克",
    "words": "既然這樣那我只用蠻力來搶了！",
    "voice": null,
    "unit_id": 10511
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "住～手～來～的～！",
    "voice": "vo_adv_5007007_052",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "呵呵，",
    "voice": "vo_adv_5007007_053",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "還有很多呢！",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n不用搶也吃得到喔。",
    "voice": null,
    "unit_id": 108111
  },
