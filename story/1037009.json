    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "──我一定會把這份心情",
    "voice": "vo_adv_1037009_083",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "傳達給你的。",
