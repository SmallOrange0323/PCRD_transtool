    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "還有下次機會的話……",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n可以再和我",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "出去玩嗎？",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "這不是",
    "voice": "vo_adv_1037009_079",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "補償什麼的，",
