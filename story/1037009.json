    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "並不是因為被爺爺那樣說，",
    "voice": "vo_adv_1037009_084",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "而是我……",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "真正的心意。",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "也就是，",
    "voice": "vo_adv_1037009_085",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我真的……",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n很喜歡你",
    "voice": null,
    "unit_id": 103712
  },
  {
