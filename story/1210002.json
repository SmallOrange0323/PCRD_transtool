  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}和貪吃佩可被困在像是「現實」的世界，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n不斷重複經歷同一天。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n然後他們遇見了優衣，在她的帶領下來到椿丘高中。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "喔喔～！",
    "voice": "vo_adv_1210002_000",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這就是",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這個世界的學校啊……",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n感覺又和月光學院",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不太一樣呢～",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "那個，",
    "voice": "vo_adv_1210002_001",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我們要去上課，",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n但貪吃佩可妳……",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊哈哈～",
    "voice": "vo_adv_1210002_002",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我果然",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不能和你們一起進學校啊～",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "雖然我很想",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "盡量待在{0}的附近……",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "你們兩位，",
    "voice": "vo_adv_1210002_003",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "早安～！",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "早安，",
    "voice": "vo_adv_1210002_004",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "伊緒。",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "早安。",
    "voice": "vo_adv_1210002_005",
    "unit_id": 105532
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "嗯，",
    "voice": "vo_adv_1210002_006",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "你們兩位",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "一大早就能朝氣蓬勃地打招呼，真了不起～",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "哎呀，",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "那位女孩是……？",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "應該不是……",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "轉學生吧？",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "呃～～～",
    "voice": "vo_adv_1210002_007",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嗯………………",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我是{0}的親戚！",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "伊緒、優衣",
    "words": "咦？",
    "voice": "vo_adv_1210002_008",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "妳應該覺得我們一點都不像，",
    "voice": "vo_adv_1210002_009",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但我們其實是關係很遠很～",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "遠的親戚……",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n如果要回溯族譜的話，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "就是在我們的上五代……",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "怎、",
    "voice": "vo_adv_1210002_010",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "怎麼辦啊～！",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我順口就說我們是親戚，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但應該被看穿了吧～！？　",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "哎呀，",
    "voice": "vo_adv_1210002_011",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "原來是這樣～！",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "妳從國外和家人一起來旅行嗎？",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n是因為覺得日本的學校很稀奇，",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "才會送他來上學吧。",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "呵呵♪",
    "voice": "vo_adv_1210002_012",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "妳在日本要開心地玩喔。",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "那麼，",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "待會再跟你們兩位見囉。",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "她、",
    "voice": "vo_adv_1210002_013",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "她很乾脆地當真了……",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是說，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "原來她在這個世界也是{0}的老師啊～",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "先不提這個，",
    "voice": "vo_adv_1210002_014",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "雖然是想辦法度過這個難關了，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但在放學之前，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我該去哪裡……",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "嗯……",
    "voice": "vo_adv_1210002_015",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "雖然我覺得這麼做不太好，",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "但妳要不要去頂樓呢？",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n那裡不會有人出入，",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我想沒有人會發現妳的。",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "如果從後門進去，",
    "voice": "vo_adv_1210002_016",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "應該也不會在半路上被別人看到。",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "如果妳不介意，我可以帶妳過去……",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "哇～！",
    "voice": "vo_adv_1210002_017",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "謝謝妳，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "優衣！",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那",
    "voice": "vo_adv_1210002_018",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "{0}，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我在頂樓等你喔！",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n請你上完課後",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "再來接我！",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "background",
    "bg_id": "510180"
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……好閒喔。",
    "voice": "vo_adv_1210002_019",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n嗯～",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "還要再等多久，課才會上完啊……？",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我能做的事情就只有",
    "voice": "vo_adv_1210002_020",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "在街景中尋找罕見的建築物而已……",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "因為和從王宮望出去的景色完全不一樣，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這樣的確是很有意思……",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "最重要的是，",
    "voice": "vo_adv_1210002_021",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我又在不認識的世界",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "變回孤單一人，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n這比我想像中的還要寂寞……",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "還有，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我總覺得肚子也……",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "咕嚕嚕嚕嚕嚕嚕～～！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊",
    "voice": "vo_adv_1210002_022",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嗚～",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "一想到這件事，反而覺得更餓了……",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n等他們上完課，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我早就已經倒在路邊了啦……",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n在變成那樣之前，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "快來接我吧……",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "！？",
    "voice": "vo_adv_1210002_023",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "糟糕！",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "有人來了！",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我得找個地方躲起來……",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "呃，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這裡完全沒有地方能躲啊～～！！　",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "萬事休矣……",
    "voice": "vo_adv_1210002_024",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我會因為犯下非法侵入罪而遭到逮捕，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n真的在這個世界",
    "voice": null,
    "unit_id": 105831
  },
  {
