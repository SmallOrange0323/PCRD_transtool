  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107141
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我很開心喔，",
    "voice": null,
    "unit_id": 107141
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "{0}！！",
    "voice": null,
    "unit_id": 107141
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……嗯，",
    "voice": "vo_adv_9500028_001",
    "unit_id": 107141
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "怎麼了？",
    "voice": null,
    "unit_id": 107141
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n明明是你自己先提出的，",
    "voice": null,
    "unit_id": 107141
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "卻一副半信半疑的表情？",
    "voice": null,
    "unit_id": 107141
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107141
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我可是一直盼望著這一刻呢。",
    "voice": null,
    "unit_id": 107141
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "聽好了，",
    "voice": "vo_adv_9500028_002",
    "unit_id": 107141
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "你要更有自覺。",
    "voice": null,
    "unit_id": 107141
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n想想自己有多麼優秀，",
    "voice": null,
    "unit_id": 107141
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "又是怎樣的存在。",
    "voice": null,
    "unit_id": 107141
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107141
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "別誤會，",
    "voice": null,
    "unit_id": 107141
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我說的可不單純是力量的強弱，",
    "voice": null,
    "unit_id": 107141
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "而是氣魄。",
    "voice": null,
    "unit_id": 107141
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "你總想",
    "voice": "vo_adv_9500028_003",
    "unit_id": 107141
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "背負著一切。",
