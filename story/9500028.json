    "voice": null,
    "unit_id": 107141
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n沒錯──",
    "voice": null,
    "unit_id": 107141
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "是人心的一切。",
    "voice": null,
    "unit_id": 107141
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
