    "voice": "vo_adv_9500028_004",
    "unit_id": 107141
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n你比任何人都要強大。",
    "voice": null,
    "unit_id": 107141
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "真的是個",
    "voice": null,
    "unit_id": 107141
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "很強的男人。",
    "voice": null,
    "unit_id": 107141
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107141
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "強到足以讓克莉絲提娜姐姐我為你傾心",
