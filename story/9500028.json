  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我已經不再孤單了。",
    "voice": null,
    "unit_id": 107141
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n{0}，",
