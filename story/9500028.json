    "unit_id": 107141
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "呢。",
    "voice": null,
    "unit_id": 107141
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "證據就是──",
    "voice": "vo_adv_9500028_005",
    "unit_id": 107141
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n我不是早在很久以前就求過婚了嗎☆",
    "voice": null,
    "unit_id": 107141
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "讓我聽聽吧，",
    "voice": "vo_adv_9500028_006",
    "unit_id": 107141
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "{0}。",
    "voice": null,
    "unit_id": 107141
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n可以用你自己的話，",
    "voice": null,
    "unit_id": 107141
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "說出那一天的答案嗎？",
