[
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "那個巨大的雪人，",
    "voice": "vo_adv_5054301_000",
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n是設置在會場入口的雪人吧？",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "雖然外觀相差很多……",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "似乎是為了避人耳目，而進行過偽裝。",
    "voice": "vo_adv_5054301_001",
    "unit_id": 114611
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n真是計畫周全呢。",
    "voice": null,
    "unit_id": 114611
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "再鎮密的企劃書，",
    "voice": "vo_adv_5054301_002",
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n只要是出自惡徒之手，",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "就一律駁回！",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "說得沒錯。",
    "voice": "vo_adv_5054301_003",
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "這種淨給人添麻煩的計畫，",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "就讓它徹底泡湯吧。",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "另外，",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "還要和這傢伙索討",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "損害賠償金呢。",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "既然如此，",
    "voice": "vo_adv_5054301_004",
    "unit_id": 114611
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "請款單就交給我來寫吧！",
    "voice": null,
    "unit_id": 114611
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "那麼大家，",
    "voice": "vo_adv_5054301_005",
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n為了讓派對重新開始，",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我們各就各位，開始工作吧！",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "咲戀、優花梨",
    "words": "了解！",
    "voice": "vo_adv_5054301_006",
    "unit_id": null
  }
]
