    "type": "dialogue",
    "name": "凱留",
    "words": "咦，",
    "voice": "vo_adv_1272004_002",
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好強的光！！？",
    "voice": null,
    "unit_id": 127212
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n你有學過這種魔法嗎～～～！？",
