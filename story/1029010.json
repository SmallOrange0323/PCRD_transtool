  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "謝謝妳們！",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "決定參加祭典的演出之後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n望也十分積極地在完成偶像的工作。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "呼～",
    "voice": "vo_adv_1029010_051",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "活動成功結束真是太好了。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
