[
  {
    "type": "background",
    "bg_id": "500040"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "休息室小偷事件過後，望每天都在煩惱著。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯～",
    "voice": "vo_adv_1029010_000",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "之前是說了要成為真正的頂尖偶像，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不過真要做的話，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "具體來說要做些什麼才好呢？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "妳從剛才開始就在抱頭苦惱著什麼事情啊，",
    "voice": "vo_adv_1029010_001",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "小望？",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "不介意的話",
    "voice": "vo_adv_1029010_002",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "可以找我們商量。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "紡希、",
    "voice": "vo_adv_1029010_003",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "千歌……",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我問妳們喔，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "妳們兩個覺得要怎麼做才能成為",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n真正的頂尖偶像呢？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "真正的……？",
    "voice": "vo_adv_1029010_004",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "這問題還真難回答呢。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n不過，",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我認為",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "望已經是位十足的",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "頂尖偶像了。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "的確，",
    "voice": "vo_adv_1029010_005",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "不只是音響盤的銷量，",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "或是演唱會的來場人數，",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n小望就連寫真集的銷量也都是在前段班。",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "要是打算再更上一層樓，",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "那就得把目光投向蘭德索爾以外的地方才行了。",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "嗯，",
    "voice": "vo_adv_1029010_006",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我覺得不錯啊。",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "這樣我做的衣服",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "也可以被更多人看見。",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "千歌不這麼認為嗎？",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "這規、",
    "voice": "vo_adv_1029010_007",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "規模大到我頭好昏……",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "不過，",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "能唱歌給許多人聽的話",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "確實很令人開心。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "紡希說的好像也有道理，",
    "voice": "vo_adv_1029010_008",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯……",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "做到那種地步的話，",
    "voice": "vo_adv_1029010_009",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "想必所有人都會認可我們的實力。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "但總覺得我追求的",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "並不是這種東西。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "可是就算被問我是想追求什麼，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我也回答不出來……",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "打擾了。",
    "voice": "vo_adv_1029010_010",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "啊，",
    "voice": "vo_adv_1029010_011",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "好像有客人來了。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "來了，",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "請問是哪位？",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "初次見面您好，",
    "voice": "vo_adv_1029010_012",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "我是神殿的神官。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "咦，",
    "voice": "vo_adv_1029010_013",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "神殿？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那個，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "神官大人",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "找我們有什麼事呢？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "事情是這樣的，神殿每四年一次，",
    "voice": "vo_adv_1029010_014",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "\\n會為技藝之神舉行獻上音樂的祭典",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "──「奉音祭祀」。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "啊，",
    "voice": "vo_adv_1029010_015",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我有聽過那個祭典。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "印象中",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "會在神殿架設舞台，",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n然後在舞台上演奏傳統音樂對吧。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我沒有實際見過，",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "但聽說是個很盛大的祭典。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "正是如此。",
    "voice": "vo_adv_1029010_016",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "不曉得慈樂之音的各位，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "\\n有沒有意願參與",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "今年「奉音祭祀」的演出呢？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "望等人",
    "words": "咦咦咦～！",
    "voice": "vo_adv_1029010_017",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那個，",
    "voice": "vo_adv_1029010_018",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我們幾個是偶像……",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n那麼莊嚴的場合真的適合找我們過去嗎？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "當然沒問題。",
    "voice": "vo_adv_1029010_019",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "我們正是在考量過這一點之後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "\\n而希望能邀請三位參與演出的。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "這場祭典的演出",
    "voice": "vo_adv_1029010_020",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "並不過問音樂的種類。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "\\n只不過",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "考量到現場的氣氛，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "\\n所以至今都是演奏些傳統音樂，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "或是祭祀歌曲。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "那些都是極為出色的音樂，",
    "voice": "vo_adv_1029010_021",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "不過實際上音樂存在著各式各樣的種類。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "\\n我想要盡我所能地",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "不拘泥於音樂的類型，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "\\n讓這場祭典能夠成為獻上各式出色音樂的祭典。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "……事情我已經了解了。",
    "voice": "vo_adv_1029010_022",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "不過，",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "為什麼會找我們呢？",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n要找有聲望跟實力的偶像的話，應該還有其他選擇才對。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "妳說的沒錯。",
    "voice": "vo_adv_1029010_023",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "其實為了挑選出這次祭典的演出人選，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "\\n包含慈樂之音在內，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "我去觀看了許多偶像的公演。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "\\n每位偶像都十分出色，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "但在我眼中慈樂之音是最閃耀的一組團體。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "紡希小姐的服裝、",
    "voice": "vo_adv_1029010_024",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "千歌小姐的歌聲，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "\\n以及擔任Center的望小姐",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "所展現的表演與散發的存在感。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "\\n這些實在是令人驚艷，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "在眾多偶像之中",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "脫穎而出。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "我後來才知道，",
    "voice": "vo_adv_1029010_025",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "千歌小姐是唱喚士、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "紡希小姐是服裝師、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "\\n而望小姐則是單人偶像，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "三人以不同身分活躍在各自的領域上。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "\\n也許是因為如此，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "才能更加凸顯出各自的性格，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "感覺更加的耀眼奪目。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "而且還不只是有著強烈的個人色彩，",
    "voice": "vo_adv_1029010_026",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "\\n三位在舞台上互相支持，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "充分利用個人特質使得團體更加閃耀，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "\\n呈現出堪稱三位一體的表演。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "這是只有慈樂之音才能達到的境界。",
    "voice": "vo_adv_1029010_027",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "\\n我感受到妳們有著足以立於祭典會場的能耐，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "\\n以及能使觀眾為之入迷的",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "魅力。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "這、",
    "voice": "vo_adv_1029010_028",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "這會不會誇獎誇得太過頭了……？",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "另外我對於",
    "voice": "vo_adv_1029010_029",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "三位做為公會時的活動也深感佩服。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "\\n能唱能跳、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "守護人們，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "並為了笑容而戰的偶像。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "\\n這情操何等高尚、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "何等嶄新！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "實不相瞞，",
    "voice": "vo_adv_1029010_030",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "由於這祭典長年持續舉辦的關係，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "正逐漸流於形式。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "\\n傳統固然重要，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "但再這樣下去，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "\\n我擔心祭典的本質會蕩然無存。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "延續祭典本身也很重要，",
    "voice": "vo_adv_1029010_031",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "但祭典背負著祈求藝能發展，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "\\n傳遞優美的音樂，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "豐富人們的心靈，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "使其變得幸福",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "的使命。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "\\n我現在最煩惱的就是",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "哪天連這些使命也將不復存在。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "但若是跟祭典一樣，",
    "voice": "vo_adv_1029010_032",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "以守護人們，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "\\n替人們帶來笑容為理念的偶像──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "慈樂之音，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "\\n我相信就能維繫住即將斷絕的",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "這項理念。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "我相信，這會替祭典帶來嶄新的風氣，",
    "voice": "vo_adv_1029010_033",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "\\n並能使祭典",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "發展到更高的境界。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "\\n拜託了，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "神官",
    "words": "能否請三位參與演出呢？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "感、",
    "voice": "vo_adv_1029010_034",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "感謝您的賞識……",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "不過",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "這麼大的舞台實在……",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "是啊。",
    "voice": "vo_adv_1029010_035",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我們是很高興，",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "但太過突然了也不曉得該怎麼辦才好。",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n而且我們還有",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "除了慈樂之音以外的活動。",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "的確，",
    "voice": "vo_adv_1029010_036",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這麼大型的工作突然找上門",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "真的會覺得不知所措呢。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "可是",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這也許是個機會。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "要是能讓這麼大型的舞台成功，",
    "voice": "vo_adv_1029010_037",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "慈樂之音的名氣也會跟著上升，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n說不定還能掌握到成為真正頂尖偶像的必要條件。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不過，",
    "voice": "vo_adv_1029010_038",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這也有一定程度的風險呢。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "和以往粉絲會過來的演唱會不同，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "現場應該大多會是平常對偶像沒有興趣的人。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "要是失敗了，",
    "voice": "vo_adv_1029010_039",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n可能會連同至今建立起來的傳統",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "都一口氣搞砸……",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "即使如此，",
    "voice": "vo_adv_1029010_040",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "神官大人還是選擇了我們。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我想要回應他的熱情，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "而且要是在這時候逃避了，就沒資格當偶像了！　",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "──紡希、",
    "voice": "vo_adv_1029010_041",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "千歌。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我們參加吧。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "小望！？",
    "voice": "vo_adv_1029010_042",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "妳是認真的嗎？",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我知道妳們兩位",
    "voice": "vo_adv_1029010_043",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "光是慈樂之音以外的活動就忙得不可開交，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n很難接下這種",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不熟悉的地方所舉辦的大型活動。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不過",
    "voice": "vo_adv_1029010_044",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我想要試試看。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不只是因為慈樂之音",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "有可能進一步成長，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "更可能是通往真正頂尖偶像的道路。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "……我知道了。",
    "voice": "vo_adv_1029010_045",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "既然望都這麼說了，",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "那我也要參與演出。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "等一下，",
    "voice": "vo_adv_1029010_046",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "怎麼連千歌也要參加了！",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "真、",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "真的不要緊嗎？",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是的。",
    "voice": "vo_adv_1029010_047",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "一方面望一旦這麼認真就沒人能阻止她了，",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n另一方面",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我也想見識看看。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "望想成為的",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "真正頂尖偶像究竟是什麼樣的境界。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "唔、",
    "voice": "vo_adv_1029010_048",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "唔唔……",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "妳們兩位都這麼說了，",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "那不是只能參加了嗎！",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我也參加吧。",
    "voice": "vo_adv_1029010_049",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "因為我也是慈樂之音的一員嘛！",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "望",
