  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "難道在我睡著的時候，",
    "voice": "vo_adv_1029010_075",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你都一直待在我旁邊嗎？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "也就是說，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我的睡臉被你看到了嗎？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "討厭！",
    "voice": "vo_adv_1029010_076",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我最不想讓人看到自己毫無防備的樣子的說！",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我、",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我有打呼嗎？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "有說奇怪的夢話嗎？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你、",
    "voice": "vo_adv_1029010_077",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你這麼說我是挺高興的，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "但又覺得高興不太起來……",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "呃，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "先不說這些了，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n抱歉，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "讓你陪我到這麼晚……",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……你真的是",
    "voice": "vo_adv_1029010_078",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "有夠體貼耶。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "但看來，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我似乎也已經依賴起你這樣的體貼了。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不對，",
    "voice": "vo_adv_1029010_079",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不只是你，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我也依賴著其他工作人員。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "因為偶像的工作就是要倚靠所有人的支持，才能夠完成的嘛。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "為了支持我的大家，",
    "voice": "vo_adv_1029010_080",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我應該要到的事，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "就是做好萬全的準備，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "做出最精彩的表演。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n因為大家就是為此",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "才會一直努力工作的。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我當然也必須努力，",
    "voice": "vo_adv_1029010_081",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "但如果太過勉強自己，反而讓自己出狀況的話，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n大家的努力就都白費了……",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "光靠我一個人是當不成偶像的。",
    "voice": "vo_adv_1029010_082",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "千歌和紡希、",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "以及粉絲們自不用說，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n還有願意支持我的工作人員們，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "他們都是組成我這個偶像的一部分。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "只要當偶像一天，",
    "voice": "vo_adv_1029010_083",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這副身體就不會是我一個人的所有物。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我忘了這麼重要的事，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "居然還說想成為真正的頂尖偶像，真是太好笑了。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "{0}，\\n我要再次向你道歉，",
    "voice": "vo_adv_1029010_084",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "然後也要向你道謝。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我不會再勉強自己，",
    "voice": "vo_adv_1029010_085",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "也保證不會再讓你勉強自己了。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "所以，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "今後還請繼續支持我喔。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "作為一介偶像，以及作為一個人都有所成長的望，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n距離真正的頂尖偶像又更靠近了一步。",
    "voice": null,
    "unit_id": null
  }
]
