    "name": "望",
    "words": "而且",
    "voice": "vo_adv_1029010_053",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "可能是因為決定了目標，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我現在內心正雀躍不已。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "真想一口氣把現在我做得到的事情全部都做一遍！",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不過",
