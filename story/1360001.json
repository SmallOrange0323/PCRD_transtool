[
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "敗給{0}等人之後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "回過神來，她已身在洞窟之中。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n失去了記憶，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "現在的她成為連要面對自身罪孽這件事都遺忘的可憐存在。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n她的名字是──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "阿剌克涅。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "…………",
    "voice": "vo_adv_1360001_000",
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "……好暗。",
    "voice": "vo_adv_1360001_001",
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "\\n啊啊，",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "實在是",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "太暗了……",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "background",
    "bg_id": "501791"
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "這裡是，",
    "voice": "vo_adv_1360001_002",
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "哪裡呢……",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "\\n是在洞窟裡面嗎……？　",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "石頭，",
    "voice": "vo_adv_1360001_003",
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "好冰冷……",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "\\n身體，",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "好沉重……",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "我……",
    "voice": "vo_adv_1360001_004",
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "是想做什麼呢？",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "\\n該去哪裡才好呢？",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "\\n說起來……",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "我，",
    "voice": "vo_adv_1360001_005",
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "是誰……？",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "不知道……",
    "voice": "vo_adv_1360001_006",
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "什麼都不記得……",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "那個……",
    "voice": "vo_adv_1360001_007",
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "有人，",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "在嗎……？",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "\\n無論是誰都好……",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "\\n聽見的話，",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "請回答我……",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "…………",
    "voice": "vo_adv_1360001_008",
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "誰都、",
    "voice": "vo_adv_1360001_009",
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "不在呢……",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "\\n我，",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "是孤身一人呢……",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "我，",
    "voice": "vo_adv_1360001_010",
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "該怎麼辦才好呢……",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "\\n我，",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "究竟是誰呢……",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "請告訴我……",
    "voice": "vo_adv_1360001_011",
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "\\n有誰……",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "能有誰……",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "…………",
    "voice": "vo_adv_1360001_012",
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "經過了多久呢……",
    "voice": "vo_adv_1360001_013",
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "\\n兩天？",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "三天？",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "還是",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "更久……？　",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "原本就已經、",
    "voice": "vo_adv_1360001_014",
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "什麼都想不起來了。",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "\\n現在似乎連時間流逝的感覺，",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "都變得模糊……",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "啊啊……",
    "voice": "vo_adv_1360001_015",
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "好睏……",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "明明很睏，",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "卻又害怕睡著……",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "\\n醒來的時候，",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "又要被迫體認到自己是孤身一人這件事，",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "\\n我已經",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "無法忍受了……",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "……",
    "voice": "vo_adv_1360001_016",
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "是光。",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "耀眼的光芒……",
    "voice": "vo_adv_1360001_017",
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "溫暖的光芒……",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "\\n",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "但是……",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "多麼遙遠的光芒……",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "如果朝著那道光前進，",
    "voice": "vo_adv_1360001_018",
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "說不定會有什麼改變……",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "\\n",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "說不定就能不再是一個人了……",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "於是阿剌克涅獨自一人，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n彷彿被光芒吸引了一般，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "朝著洞窟外走去了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "502081"
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "……雖然樣貌變了很多……",
    "voice": "vo_adv_1360001_019",
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n但魔力可是無法蒙混過去的。",
    "voice": null,
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n這次一定要，",
    "voice": null,
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "將妳打到體無完膚！",
    "voice": null,
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "那個……",
    "voice": "vo_adv_1360001_020",
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n請問兩位……",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "知道些什麼",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "關於我的事情嗎？",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "阿剌……",
    "voice": "vo_adv_1360001_021",
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "克涅？",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "不好意思。",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n我沒有",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "印象……",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "妳在開什麼玩笑！",
    "voice": "vo_adv_1360001_022",
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n難道說，",
    "voice": null,
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "妳連我們都不記得了？",
    "voice": null,
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "我",
    "voice": "vo_adv_1360001_023",
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "好像是失去記憶了。",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "什麼都不記得……",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n不管是關於自己的事情，",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "還是關於家人的事情。",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "看來，",
    "voice": "vo_adv_1360001_024",
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "是我認錯人了。",
    "voice": null,
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "妳這樣的傢伙，",
    "voice": null,
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "我們可不認識。",
    "voice": null,
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "不認識……",
    "voice": "vo_adv_1360001_025",
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "是這樣嗎。",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n太可惜了……",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "background",
    "bg_id": "502711"
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "……",
    "voice": "vo_adv_1360001_026",
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "\\n這個人的名字，",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "是叫「阿剌克涅」",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "嗎……？",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "是的，",
    "voice": "vo_adv_1360001_027",
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "也許……",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "\\n別人是，",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "這麼稱呼我的。",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "咦？",
    "voice": "vo_adv_1360001_028",
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
