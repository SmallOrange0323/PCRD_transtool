[
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "呼～",
    "voice": "vo_adv_5040322_000",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n總算把那幾個長得和我們很像的傢伙打倒了啦。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "半藏",
    "words": "喔……？",
    "voice": "vo_adv_5040322_001",
    "unit_id": 13311
  },
  {
    "type": "dialogue",
    "name": "半藏",
    "words": "還挺有兩下子的嘛。",
    "voice": null,
    "unit_id": 13311
  },
  {
    "type": "dialogue",
    "name": "半藏",
    "words": "\\n遇到這樣的對手，",
    "voice": null,
    "unit_id": 13311
  },
  {
    "type": "dialogue",
    "name": "半藏",
    "words": "我也差不多該拿出真本事了。",
    "voice": null,
    "unit_id": 13311
  },
  {
    "type": "dialogue",
    "name": "監察官",
    "words": "什麼！？　",
    "voice": "vo_adv_5040322_002",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "監察官",
    "words": "你這傢伙！　",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "監察官",
    "words": "難道剛剛都還留了一手嗎！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "監察官",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "監察官",
    "words": "別開玩笑了！　",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "監察官",
    "words": "你可別忘記我付了多高的薪水給你們！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "監察官",
    "words": "\\n趕快讓那幾個傢伙",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "監察官",
    "words": "從世界上徹底消失！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "半藏",
    "words": "不用你說我也打算這麼做。",
    "voice": "vo_adv_5040322_003",
    "unit_id": 13311
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "他們",
    "voice": "vo_adv_5040322_004",
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "怎麼好像",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "起內鬨了？",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "雖然他們本來就不太像是夥伴，",
    "voice": "vo_adv_5040322_005",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "但的確是那樣的吧。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "讓他們見識一下，",
    "voice": "vo_adv_5040322_006",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "同心協力地一起戰鬥會有多強大！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "沒錯啦！",
    "voice": "vo_adv_5040322_007",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n只要我們團結在一起，",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "就所向無敵的啦！",
    "voice": null,
    "unit_id": 112811
  }
]
