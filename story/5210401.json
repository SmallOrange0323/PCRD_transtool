[
  {
    "type": "background",
    "bg_id": "502080"
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "嗶、",
    "voice": "vo_adv_5210401_000",
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "嗶咿……",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "這、",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "這樣就結束了？",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "\\n打倒了嗎？",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "不",
    "voice": "vo_adv_5210401_001",
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "小拿，",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "還沒結束。",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "\\n他會吸取別的蜘蛛的精氣，",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "並再次甦醒過來……",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "怎麼這樣！",
    "voice": "vo_adv_5210401_002",
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "用那種像是「肚子餓了吃點心！」",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "一樣的理由復活，",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "\\n太狡猾了啦～！",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "不，",
    "voice": "vo_adv_5210401_003",
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "魔力和體力",
    "voice": null,
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "都看得出逐漸衰退。",
    "voice": null,
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n我認為他已經不是能夠戰鬥的狀態了。",
    "voice": null,
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "那、",
    "voice": "vo_adv_5210401_004",
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "那麼，",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅",
    "words": "這樣就……？",
    "voice": null,
    "unit_id": 136011
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "審判長他，",
    "voice": "vo_adv_5210401_005",
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "似乎有話想對阿剌克涅小姐說。",
    "voice": null,
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "直接和他對話，",
    "voice": null,
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "把被強加的有罪判決",
    "voice": null,
    "unit_id": 137411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "駁回吧！",
    "voice": null,
    "unit_id": 137411
  },
  {
    "type": "background",
    "bg_id": "501030"
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "なんとか、",
    "voice": "vo_adv_5206401_000",
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "倒せたわね……",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "\\n",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "エリスさんのシャドウだけあって、",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "強かった……",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "プレシア",
    "words": "……（くんくん）",
    "voice": "vo_adv_5206401_001",
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "プレシア",
    "words": "\\n",
    "voice": null,
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "プレシア",
    "words": "まだ。",
    "voice": null,
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "プレシア",
    "words": "だよ。",
    "voice": null,
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "尽きない欲望をもとに、",
    "voice": "vo_adv_5206401_002",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "シャドウが復活する……",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "\\n",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "それに、",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "彼女はまだ本気を出していないわ……",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "まだ戦いは続くのね……",
    "voice": "vo_adv_5206401_003",
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "\\n",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "でも、",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "私たちも連携が取れてきたわ。",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "それは、",
    "voice": "vo_adv_5206401_004",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "分からないけれど……",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "急ぎましょう。",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "\\n次こそは……",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "プレシア",
    "words": "つぎは。",
    "voice": "vo_adv_5206401_005",
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "プレシア",
    "words": "\\nおしり。",
    "voice": null,
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "プレシア",
    "words": "ぺんぺん。",
    "voice": null,
    "unit_id": 135211
  }
]
