  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}和班比",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "今天也依舊勤奮地研究著",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n如何收集更多愛心──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "僕從，你看，",
    "voice": "vo_adv_1402002_000",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "這些人",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "都獨自拍照，還只拍自己的臉耶。",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n為什麼呀～？",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "自拍……？",
    "voice": "vo_adv_1402002_001",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "原來是這樣呀！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "那僕從，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "你也和班比一起來兩個人自拍吧！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "咦──",
    "voice": "vo_adv_1402002_002",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "不行嗎？",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "雖然有點寂寞……",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "那班比",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "還是自己一個人",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "努力挑戰「自拍」吧！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "……唔……",
    "voice": "vo_adv_1402002_003",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "有試著拍了幾次，但……",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n總覺得班比拍的照片，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "跟其他人的都不一樣耶？",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "不是臉拍得糊糊的，",
    "voice": "vo_adv_1402002_004",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "就是看起來有晃到……",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "總之",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "一點也不可愛～！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "到底為什麼會有這種差別呀？？",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "不像話──！",
    "voice": "vo_adv_1402002_005",
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "不像話不像話簡直太不像話──！",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n一點該有的水準都沒有───！",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我說妳啊，",
    "voice": "vo_adv_1402002_006",
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "明明外表資質是不錯的！",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "用的拍照方法卻根本不行！",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "浪費到我都看不下去了！",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "呃……",
    "voice": "vo_adv_1402002_007",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "妳是誰呀？",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "我是「自拍女帝」！",
    "voice": "vo_adv_1402002_008",
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "擁有超過數萬粉絲！",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "小時候在抓住媽媽的手指前，先跑去抓住自拍棒的那個嬰兒，",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "便是在說我！",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "請問女帝找班比",
    "voice": "vo_adv_1402002_009",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "有什麼事嗎？",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "身為會員制魔石通訊網的頂尖用戶，",
    "voice": "vo_adv_1402002_010",
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "\\n我不能放任不像話的自拍照大量出現……",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "就讓我來替妳好好上一堂課吧！",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "哦……",
    "voice": "vo_adv_1402002_011",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "聽起來很有趣呢──！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n可以呀～？",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比就來聽聽看妳的課！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "……怎、",
    "voice": "vo_adv_1402002_012",
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "怎麼回事，",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "竟莫名地很有風範……",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "總之，",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "開始自拍特訓！",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "首先要學會基本。",
    "voice": "vo_adv_1402002_013",
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "必須斜著",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "拿裝置！",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "絕對禁止拿直直的！",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "一切都是從傾斜開始！",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "好～♪",
    "voice": "vo_adv_1402002_014",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "拿斜的，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "斜的，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "斜……",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "唔",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "唔唔唔……",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "欸～",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "這樣夠斜",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "了嗎？",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "那樣太斜啦！",
    "voice": "vo_adv_1402002_015",
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "不如說這已經是「橫著拿」了吧！",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "別這樣很可怕好嗎！",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "理想的拿法是舉到左邊斜上方三十度！",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "記好，考試會考！",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "咦，",
    "voice": "vo_adv_1402002_016",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "連角度都有規定呀？",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n要三十度……",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "大概像這樣？",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "那樣差不多只有二十八度吧。",
    "voice": "vo_adv_1402002_017",
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "不過，",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "算妳及格吧。",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "好",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "了，",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "那接著用力把眼角往上張大！",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "做出向上看的可～愛表情！",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "萌萌心動──♡",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "可～",
    "voice": "vo_adv_1402002_018",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "愛……",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "可愛？",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "萌萌──？",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "唔唔唔……",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "感覺快撐不住了，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "好想眨眼！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "維持眼睛睜大的樣子，",
    "voice": "vo_adv_1402002_019",
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "再像鴨子一樣噘起嘴巴！",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "聽好了，鴨子！",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "妳必須成為鴨子！",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "睜大，",
    "voice": "vo_adv_1402002_020",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "噘起嘴巴……",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "鴨鴨……",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "唔唔唔，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "這樣嘴巴會很痠呀──！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "──那個啊，",
    "voice": "vo_adv_1402002_021",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "為什麼非得這樣做不可呀？",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n用普通的拍法不行嗎？",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "普通的拍法當然不行好嗎！",
    "voice": "vo_adv_1402002_022",
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "\\n如果想賺到更多愛心，",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "就乖乖照著我的話做！",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "討厭～！",
    "voice": "vo_adv_1402002_023",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n自拍一點都不開心嘛！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "background",
    "bg_id": "501611"
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "真是的，",
    "voice": "vo_adv_1402002_024",
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "小孩子就是這副德性……",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "你是",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "她的達令？",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "僕從？",
    "voice": "vo_adv_1402002_025",
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "那什麼東西啊。",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "可以不要講些我沒聽過的網路迷因嗎？",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "\\n那可是",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "辣妹的特權耶！",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "用的詞竟然比我還肉麻……",
    "voice": "vo_adv_1402002_026",
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "你挺不簡單的嘛。",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "\\n一般大眾似乎",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "分為「達令」派跟「北鼻」派，",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "\\n我自己覺得「北鼻」最閃。",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "但「鼻鼻」就算了，是鼻子在癢嗎。",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "總而言之，",
    "voice": "vo_adv_1402002_027",
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "你可不能太寵那孩子啊。",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "\\n畢竟爆紅這條路可不好走的……！",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "呵呵呵！",
    "voice": "vo_adv_1402002_028",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "腳底感覺好舒服喔～",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n水冰冰涼涼的，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "沙子又鬆軟滑順。",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "不知不覺間",
    "voice": "vo_adv_1402002_029",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "太陽公公也快下山了呢。",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "果然比起在那邊歪頭拍照，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "還是這樣更棒呀。",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "咦？",
    "voice": "vo_adv_1402002_030",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "僕從，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "剛才的你拍下來了？",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "是嗎？",
    "voice": "vo_adv_1402002_031",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "那就拍吧♪",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "既然僕從想幫班比拍照，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "當然是這樣更好囉♡",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "那如果像這樣，",
    "voice": "vo_adv_1402002_032",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "轉圈圈～♪",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n讓頭髮跟著海風飄起來，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "變成一個圓……",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "看起來就很漂亮對吧──？",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "再張開雙臂，",
    "voice": "vo_adv_1402002_033",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "上下揮一揮……",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "嘿嘿，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "這是學蝙蝠的動作喔！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "咻地──♪",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "飛起來──♪",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "這根本已經稱不上是自拍了吧……",
    "voice": "vo_adv_1402002_034",
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "\\n當初我看到妳時，還以為發現了有望成為下一個女帝的逸才啊。",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比已經有僕從在了！",
    "voice": "vo_adv_1402002_035",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "才～不需要成為",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "什麼女帝呢。",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "真是太浪費了！",
    "voice": "vo_adv_1402002_036",
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "\\n即使底子再怎麼好，",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "不好好運用在自拍上，根本就只是暴殄天物啊！",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "這什麼，",
    "voice": "vo_adv_1402002_037",
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "你幫那孩子拍的照片？",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "那種東西",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "怎麼可能贏過我的超讚自拍照……",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "……不、",
    "voice": "vo_adv_1402002_038",
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "不會吧，",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "有夠可愛…………？",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "臉上那自然的笑容，",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "眼睛還閃閃發光，",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "\\n明明沒有擺出自拍用的無敵表情，",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "但卻完美掌握了平衡！",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "啪唰啪唰♪",
    "voice": "vo_adv_1402002_039",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "潑水──！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n……",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "僕從，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "有沒有被噴濕呀？",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "不管～♪",
    "voice": "vo_adv_1402002_040",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "你要好好地避開呀？",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "然後邊躲邊幫班比拍照～♪",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "騙人。",
    "voice": "vo_adv_1402002_041",
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "這東西得到了一大堆愛心……",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "而且愛心竟然比我剛才的自拍還多啊！",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "連留言區也……",
    "voice": "vo_adv_1402002_042",
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "「班比",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "好可愛！」",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "\\n「自由自在地，真不錯──」",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "「表情超級棒耶。」",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "「再次迷上妳了」。",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "嘿嘿。",
    "voice": "vo_adv_1402002_043",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "謝謝大家",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "的稱讚──♪",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n咬下去♪",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "……",
    "voice": "vo_adv_1402002_044",
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "表情是真的相當不錯……",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "\\n該怎麼說，",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "彷彿打從心底感到放鬆一樣……",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "沒想到我的完美自拍照竟然會輸。",
    "voice": "vo_adv_1402002_045",
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "難不成現在已經不是自拍的時代，",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "而是給北鼻拍的時代！？",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "妳說",
    "voice": "vo_adv_1402002_046",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "什麼鼻啊？",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "僕從就是僕從呀？",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "那、",
    "voice": "vo_adv_1402002_047",
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "那個，",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "要怎麼做才能找到妳說的什麼僕從？",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "\\n快告訴我！",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "……",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "不，",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "還請教教我！",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "好啊！",
    "voice": "vo_adv_1402002_048",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n首先呢，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "像這樣往脖子",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "咬下去♡",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "這麼做之後──",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "咬下去♡",
    "voice": "vo_adv_1402002_049",
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "是吧？",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "自拍女帝",
    "words": "拼命筆記……！",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "background",
    "bg_id": "501610"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "過了幾天後──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "欸～",
    "voice": "vo_adv_1402002_050",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "不知道女帝在那之後怎麼了？",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n她都沒有再來這裡了……",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "真的嗎？",
    "voice": "vo_adv_1402002_051",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "快給班比看看♪",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "哇──！",
    "voice": "vo_adv_1402002_052",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "是女帝耶──！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "她在照片上跟一個男的臉貼得好近唷！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "上面還寫著「我有僕從了！」",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "呢！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "呵呵，",
    "voice": "vo_adv_1402002_053",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "看來她是",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "「咬下去♡」很多次呢！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n這樣比自拍可愛很多很～多倍呀！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "果然",
    "voice": "vo_adv_1402002_054",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "「現在已經是給僕從拍的時代」",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "呢♡",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "看著女帝轉職成「雙人合照女帝」後的樣子，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}和班比不禁相視而笑。",
    "voice": null,
    "unit_id": null
  }
]
