    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "開心的冒險也結束了啊。",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "欸，",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "露易！",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "彩羽還想要冒險！",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n畢竟年輕的奶奶也很有趣，",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "對吧♪",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "才不有趣。",
    "voice": "vo_adv_5204411_001",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n到底是有多悲情，",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n居然得跟自己的親祖母爭奪達令啊……",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "……不過，",
    "voice": "vo_adv_5204411_002",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n祖母竟然",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "也有那樣的黑歷史時代，",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n讓我有點吃驚。",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "……不過",
    "voice": "vo_adv_5204411_003",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "老實說，跟露易一模一樣就是了。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "啊！？",
    "voice": "vo_adv_5204411_004",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n哪裡像啊！？",
    "voice": null,
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "這個嘛──！",
    "voice": "vo_adv_5204411_005",
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "很毒舌、",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "會說自己是天才、",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "一下子就會得意忘形、",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "悶騷、",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "好騙、",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "愛生氣、",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "被盯著看就會害羞的地方，",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "也都跟露易一模一樣♪",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "這幾乎都是壞話吧！？",
    "voice": "vo_adv_5204411_006",
    "unit_id": 132312
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "啊哈哈！",
    "voice": "vo_adv_5204411_007",
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "不過呢不過呢，",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "最像的部分是～",
    "voice": null,
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "哦，",
    "voice": "vo_adv_5204411_008",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "是先讓人失落，",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "最後再吹捧的說話技巧啊。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n挺行的嘛，彩羽。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "好，",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "妳說吧。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "角很帥的部分♪",
    "voice": "vo_adv_5204411_009",
    "unit_id": 132412
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "我開心不起來！！",
