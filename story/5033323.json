    "words": "\\n",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "居然、",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "還有這麼強大的、",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "力量……！？",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "居然還能夠變得更巨大嗎……！？",
    "voice": "vo_adv_5033323_001",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "牠的力量該不會",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "沒有極限吧……！？",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "霞……",
    "voice": "vo_adv_5033323_002",
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "這樣下去沒問題嗎？",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "栞……",
    "voice": "vo_adv_5033323_003",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "我也很不安呢。",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "兩人",
    "words": "——但是。",
    "voice": "vo_adv_5033323_004",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "我們不能讓應該守護的人們",
    "voice": "vo_adv_5033323_005",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "\\n看到我們不安的表情呢。",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "是的。",
    "voice": "vo_adv_5033323_006",
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "不論什麼時候，",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "\\n魔法少女都必須要能滿臉笑容地",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "說出已經沒事了。",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "栞，",
    "voice": "vo_adv_5033323_007",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "\\n看來現在就是最高潮了。",
    "voice": null,
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "沒錯！　",
    "voice": "vo_adv_5033323_008",
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "大家一起戰勝牠，",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "\\n然後擺出勝利的招牌姿勢吧！",
    "voice": null,
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "Misty★霞",
    "words": "魔法偵探Misty★霞！",
    "voice": "vo_adv_5033323_009",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "Purely★栞",
    "words": "魔法獵人Purely★栞！",
    "voice": "vo_adv_5033323_010",
    "unit_id": 112311
  },
  {
    "type": "dialogue",
    "name": "兩人",
    "words": "蘭德索爾的和平，",
    "voice": "vo_adv_5033323_011",
    "unit_id": 112211
  },
  {
    "type": "dialogue",
    "name": "兩人",
    "words": "就由我們來守護！",
    "voice": null,
    "unit_id": null
  }
]
