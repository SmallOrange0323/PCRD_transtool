    "name": "純",
    "words": "只要跟你在一起，我……",
    "voice": "vo_adv_1242003_092",
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n好像就變得有點奇怪。",
    "voice": null,
    "unit_id": 124214
  },
  {
