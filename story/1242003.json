    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……請不要一直盯著我看。",
    "voice": null,
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "明明是我對她說了好像很了不起的話……",
    "voice": "vo_adv_1242003_091",
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "結果竟是這樣。",
    "voice": null,
    "unit_id": 124214
  },
  {
