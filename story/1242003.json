    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "那裡的餐點很便宜，份量又多，",
    "voice": null,
    "unit_id": 124212
  },
