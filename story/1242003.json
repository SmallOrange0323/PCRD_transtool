[
  {
    "type": "background",
    "bg_id": "500036"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "自上次逮捕了盜賊團且巧遇孕婦生產，又過了幾天後的某一天，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n純與{0}走在蘭德索爾的街道上。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "啊，",
    "voice": "vo_adv_1242003_000",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "等等，少年。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n你走得真快……",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "是我走太慢了嗎？",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我還不習慣以真面目示人，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不自覺地就會低著頭走路。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "唔，",
    "voice": "vo_adv_1242003_001",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你真不留情呢，少年。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……嗯？",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這鳴叫聲，難不成是……",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n啊，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "白鴿飛來了。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "棲息在那間教堂的鴿子們",
    "voice": "vo_adv_1242003_002",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "飛來宣告聖誕節的到來了。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "太好了。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "城鎮居民看起來也很開心呢。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n連在這裡也聽得到大家的歡笑聲。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "居民１",
    "words": "哈哈哈！",
    "voice": "vo_adv_1242003_003",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "居民１",
    "words": "果然要看到鴿子飛來，才會有聖誕節到來的感覺！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "居民１",
    "words": "\\n這一切都",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "居民１",
    "words": "多虧了聖誕節的聖女大人哪！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "居民２",
    "words": "是啊，",
    "voice": "vo_adv_1242003_004",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "居民２",
    "words": "這可是街坊最近的熱門話題呢。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "居民２",
    "words": "我也有所耳聞。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "居民２",
    "words": "\\n據說有人看到降臨在森林深處廢棄教堂的聖女大人，與天使一同嬉戲呢。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "居民２",
    "words": "\\n……而且她似乎是個令人驚嘆的美人，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "居民２",
    "words": "真想見她一面。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "居民１",
    "words": "我聽到的傳聞是，",
    "voice": "vo_adv_1242003_005",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "居民１",
    "words": "聖女大人顯現在一位孕婦面前，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "居民１",
    "words": "\\n不僅平息了暴風雪，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "居民１",
    "words": "甚至還接生了嬰兒！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "居民１",
    "words": "\\n……而且她似乎是個令人動容的美人，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "居民１",
    "words": "真想見她一面。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "居民1、居民2",
    "words": "……哦，",
    "voice": "vo_adv_1242003_006",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "居民1、居民2",
    "words": "真想見她一面。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "哦，",
    "voice": "vo_adv_1242003_007",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "聖女大人嗎？",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "在團員們之間",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "好像也蔚為話題呢。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "…",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "…不過，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這可不容輕忽，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "得提高警覺，多加留意。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n因為很可能會出現以聖女之名行騙的可疑人士。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……咦，",
    "voice": "vo_adv_1242003_008",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我嗎？",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "說我是聖女大人……？",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n雖然被誇大許多，但真要說起來，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "的確很像是我的遭遇……",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這樣一來，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "就只是聖女假面成了聖女的傳聞……",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "哼，",
    "voice": "vo_adv_1242003_009",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "什麼聖女大人嘛……！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n如果她真的存在……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "就赦免我的罪吧……！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n……哎呀！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "哇啊！",
    "voice": "vo_adv_1242003_010",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "不要看！！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "不要看如此醜陋的我的臉……",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "……啊，",
    "voice": "vo_adv_1242003_011",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "對不起，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "撞到你了。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "你的衣服被我手上的咖啡給弄髒了……",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n真的很抱歉……",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不，",
    "voice": "vo_adv_1242003_012",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "妳不用這麼慎重道歉。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "少年不會因為這點小事生氣。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "呃、",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "對了，少年，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你先找個地方清理一下吧。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你看，",
    "voice": "vo_adv_1242003_013",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "周遭的人們開始騷動了……",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "還有，妳也抬起頭來吧。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "不、",
    "voice": "vo_adv_1242003_014",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "不要！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "我之所以低著頭，就是不想被人看到臉……！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "不對……",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "那個……",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "總之妳先冷靜下來。",
    "voice": "vo_adv_1242003_015",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "原來如此，",
    "voice": "vo_adv_1242003_016",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "妳很害羞，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "而且有很嚴重的臉紅恐懼症嗎？",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我能理解妳的心情。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "……像妳這種美人，",
    "voice": "vo_adv_1242003_017",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "哪有可能理解我的心情。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "呃，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "咦咦咦！？",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這不是說我能夠完全理解，",
    "voice": "vo_adv_1242003_018",
    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "但我平時基本上都戴著頭盔，",
    "voice": null,
    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n且在鎧甲下還戴著這副面具。",
    "voice": null,
    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這就是我的標準裝扮。",
    "voice": null,
    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "要不要我也給妳",
    "voice": "vo_adv_1242003_019",
    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "一副這種面具？",
    "voice": null,
    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我身上帶了許多備用品喔。",
    "voice": null,
    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "相對的，雖然突兀，",
    "voice": "vo_adv_1242003_020",
    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "但請妳告訴我吧，",
    "voice": null,
    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n妳在撞到少年前所說的那句話。",
    "voice": null,
    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "因為我沒有戴頭盔，",
    "voice": null,
    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "所以聽得很清楚。",
    "voice": null,
    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "妳說：「如果聖女大人真的存在，",
    "voice": "vo_adv_1242003_021",
    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "就赦免我的罪吧！」",
    "voice": null,
    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這句話是什麼意思？",
    "voice": null,
    "unit_id": 124213
  },
  {
    "type": "background",
    "bg_id": "500170"
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "抱歉，",
    "voice": "vo_adv_1242003_022",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "還讓你們陪著我到這裡來……",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不，",
    "voice": "vo_adv_1242003_023",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我只是愛管閒事。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……所以說，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "現在站在那棵樹前的，就是妳所說的那個人？",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "對……",
    "voice": "vo_adv_1242003_024",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "喔，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "他本人果然比照片帥多了……♪",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "……唔，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "咿！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "咦，",
    "voice": "vo_adv_1242003_025",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "總覺得好像有人躲在那棵樹下。",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "……是我的錯覺嗎？",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "喂，妳不可以躲起來。",
    "voice": "vo_adv_1242003_026",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "妳是來見他的吧？",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n……為了懺悔自己所犯下的罪，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "並且向他道歉。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "啊，",
    "voice": "vo_adv_1242003_027",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "少年，因為你曾短暫離開，所以沒有聽到吧。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "那麼，我就簡單扼要地說明一下。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這位女性與那位男性",
    "voice": "vo_adv_1242003_028",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "是筆友。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n據說他們兩人從未見過面，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "僅透過書信往來。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……妳現在抱在手上的這一大疊信件，",
    "voice": "vo_adv_1242003_029",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n就是他寫給妳的信吧？",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "沒錯……",
    "voice": "vo_adv_1242003_030",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "這些全是我的寶物。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯……",
    "voice": "vo_adv_1242003_031",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "他們就像這樣持續相互通信，直到某一天，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n兩人提及想見彼此一面的話題，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "便決定互寄照片給對方。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "但是，她卻在此",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "做了錯事……",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "……是的……",
    "voice": "vo_adv_1242003_032",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "我將別人的照片寄給他。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "不同於醜陋的我，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "那是某個長得漂亮又時髦的女孩子的照片。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n但我卻說那就是我，欺騙了他……",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "妳用不著這麼貶低自己。",
    "voice": "vo_adv_1242003_033",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "正因為妳對此事感到痛苦，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "所以才會過來道歉。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n就在與他第一次見面的",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這一天。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "好慢喔……",
    "voice": "vo_adv_1242003_034",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "她是不是",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "發生了什麼事？",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我再多等她一下好了……",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "好啦，",
    "voice": "vo_adv_1242003_035",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "妳跟他約定好的時間已經超過囉。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "看他也等得有點焦急了，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "趕快過去吧。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "……請、",
    "voice": "vo_adv_1242003_036",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "請再給我一點時間。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n我想再整頓一下",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "自己的心情……",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……這樣啊。",
    "voice": "vo_adv_1242003_037",
    "unit_id": 124212
  },
  {
    "type": "background",
    "bg_id": "500172"
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "…………",
    "voice": "vo_adv_1242003_038",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯，",
    "voice": "vo_adv_1242003_039",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "就照她所說的，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "站在這裡等啊。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯，",
    "voice": "vo_adv_1242003_040",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "是這樣嗎？",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "如果是以前，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "可能會誤以為有副鎧甲擺在這裡。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……嗯，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "先不說我的事了。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我說妳啊，",
    "voice": "vo_adv_1242003_041",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "差不多",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "該整理好心情了吧？",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這座森林一到晚上，就會有魔物出沒喔。",
    "voice": "vo_adv_1242003_042",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "妳也該過去打聲招呼了。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "這我知道。",
    "voice": "vo_adv_1242003_043",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "可是……",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "請再多等我一下。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "等到我真正下定決心的那一刻……！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……話雖如此，我們已經等了好幾個小時。",
    "voice": "vo_adv_1242003_044",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "……因、",
    "voice": "vo_adv_1242003_045",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "因為，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "我真的沒有辦法啊……！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n我對於要展露自己真面目的恐懼，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "並不亞於懺悔的決心……！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "我們已經通信很久了，",
    "voice": "vo_adv_1242003_046",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "他若知道真相，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "肯定會對我感到幻滅……",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "這我實在沒辦法忍受！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……妳給我差不多一點。",
    "voice": "vo_adv_1242003_047",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯，",
    "voice": "vo_adv_1242003_048",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "啊啊……",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "謝謝你。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你真溫柔。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n不過，請放心，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我並沒有生氣。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……那個，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我可以稍微握著妳的手嗎？",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "……唔。",
    "voice": "vo_adv_1242003_049",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我話先說在前頭。",
    "voice": "vo_adv_1242003_050",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "妳一點也不醜，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "或者應該說，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "妳是個很可愛的女孩子。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n至少妳沒有必要",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這麼貶低自己。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "當然，每個人的自卑感各有不同，",
    "voice": "vo_adv_1242003_051",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n身為旁人的我無法大言不慚地要妳不要太在意。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……不過，",
    "voice": "vo_adv_1242003_052",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "重要的",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "是妳的內在，不是嗎？",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "……我的內在。",
    "voice": "vo_adv_1242003_053",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "妳是因為看了照片，",
    "voice": "vo_adv_1242003_054",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "才喜歡上他的外貌的嗎？",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n反過來說，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "妳認為他是因為外貌才選擇了妳嗎？",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "妳已經跟他互通過好幾百封信，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我想妳應該是最清楚的吧。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "……",
    "voice": "vo_adv_1242003_055",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "妳說得沒錯。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "早在看到他的照片之前，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "我就已經喜歡上他了……",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "喜歡上他在書信中所透露出的內在……！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "沒錯……",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "我不該一直發牢騷，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "老是在外貌上糾結……",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……很好，",
    "voice": "vo_adv_1242003_056",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "心情有比較沉澱下來了吧？",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n沒問題的，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我也會在這裡聲援妳，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "快過去找他……",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "糟了！！",
    "voice": "vo_adv_1242003_057",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n那名男性遭到魔物攻擊！！",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我馬上去救……",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "唔！？",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "哇啊啊啊～～！！！",
