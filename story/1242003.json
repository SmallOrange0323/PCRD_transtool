    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我、",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我無法收下這麼貴重的東西。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "沒關係，",
    "voice": "vo_adv_1242003_083",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "這是我抽獎抽到的。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "況且，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "對我來說，那個人所預約的餐廳更難能可貴啊♪",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "哦，",
    "voice": "vo_adv_1242003_084",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "竟然放閃起來了。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……既然妳這麼說，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "那我就心懷感激地收下了。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……嗯？",
    "voice": "vo_adv_1242003_085",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "妳要我把耳朵靠過去？",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n怎麼了嗎？",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "希望妳與",
    "voice": "vo_adv_1242003_086",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "妳重要的人",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "也能獲得幸福……",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "聖女大人。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "唔！？",
    "voice": "vo_adv_1242003_087",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "呃、",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不……！",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "喂，等等，",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "別走啊……",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不，",
    "voice": "vo_adv_1242003_088",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "那個……",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "沒什麼。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……唔。",
    "voice": "vo_adv_1242003_089",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "所以說了，",
    "voice": "vo_adv_1242003_090",
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "沒什麼。",
