    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "什麼！",
    "voice": "vo_adv_1242003_059",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "竟然搶先我一步！　",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "你、",
    "voice": "vo_adv_1242003_060",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "你快……",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "快點逃啊！！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "妳……",
    "voice": "vo_adv_1242003_061",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "是誰啊！？",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "我、",
    "voice": "vo_adv_1242003_062",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "我……",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "我……",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "就是跟你通信的筆友……！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "對不起，我寄了別人的照片給你……！！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "你、",
    "voice": "vo_adv_1242003_063",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "你別管我了，快點逃吧！！！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "……",
    "voice": "vo_adv_1242003_064",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我哪能逃走啊！！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "咦……",
    "voice": "vo_adv_1242003_065",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "為什麼……？",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n為什麼你要擋在我前面……",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "寄錯照片那有什麼關係。",
    "voice": "vo_adv_1242003_066",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "妳就跟我所想的一樣，",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "是個直率的人。",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "……全憑感覺行動，",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "是我喜歡上的人！！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "咦……",
    "voice": "vo_adv_1242003_067",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "女性、男性",
    "words": "呀啊啊！",
    "voice": "vo_adv_1242003_068",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性、男性",
    "words": "\\n哇啊啊！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我已見證到",
    "voice": "vo_adv_1242003_069",
    "unit_id": 124211
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你們兩人的情感了。",
    "voice": null,
    "unit_id": 124211
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124211
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "接下來就交給我吧！",
    "voice": null,
    "unit_id": 124211
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "喝啊！！",
    "voice": "vo_adv_1242003_070",
    "unit_id": 124211
  },
  {
    "type": "background",
    "bg_id": "500172"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……呼，",
    "voice": "vo_adv_1242003_071",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你們沒事吧？",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "謝、",
    "voice": "vo_adv_1242003_072",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "謝謝妳……",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "哇啊，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "不知為何，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "妳看起來好耀眼。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你才厲害呢，",
    "voice": "vo_adv_1242003_073",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "少年。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n多虧有你的強化，幫了我大忙。",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "background",
    "bg_id": "500038"
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "……我必須正式向你",
    "voice": "vo_adv_1242003_074",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "說聲抱歉。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "對不起，我欺騙了你。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "快把頭抬起來。",
    "voice": "vo_adv_1242003_075",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我一點都不介意。",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "為了轉換心情……",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "妳等一下願意陪我",
