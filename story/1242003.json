    "voice": "vo_adv_1242003_082",
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n這是",
    "voice": null,
    "unit_id": 124212
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "那間預約要等上一年的餐廳優待券……！？",
