  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]",
    "voice": "vo_adv_6124403_000",
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]想說終於解決靈魂出竅的事了，",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n[FFFFFFFF]結果忍超級生氣的，好可怕啊……",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n[FFFFFFFF]真是的，",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]我該怎麼做才好啊……",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]吵死了小伙子！",
    "voice": "vo_adv_6124403_001",
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]不用你說我也會這樣做！",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n[FFFFFFFF]就算一副老成，忍也還是小孩……",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]相對的，",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n[FFFFFFFF]我可是充滿大人的餘裕，能夠包容情緒化的女兒呢！",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]閉嘴小伙子！",
    "voice": "vo_adv_6124403_002",
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]為什麼我非得被你說教不可啊！",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n[FFFFFFFF]不過，",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]讓忍擔心這點，我確實有在反省啦……",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]……我就去道歉吧。",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]",
    "voice": "vo_adv_6124403_003",
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]啊啊！？",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]不行不行！",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n[FFFFFFFF]你想把我當成藉口，",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]跑去跟忍說話的意圖我可是一清二楚！",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n[FFFFFFFF]你是好意？",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]吵死了──！",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]要做好事去其他地方做！",
    "voice": null,
    "unit_id": 2415
  }
]
