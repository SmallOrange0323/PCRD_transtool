  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "{0}！",
    "voice": "vo_adv_1007004_018",
    "unit_id": 101831
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n上課時要保持安靜──！",
    "voice": null,
    "unit_id": 101831
  },
  {
    "type": "background",
    "bg_id": "510020"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "體育課――",
