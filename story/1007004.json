  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "哇、哇！？",
    "voice": "vo_adv_1007004_022",
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n好像有東西跑過來了喲！？",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "要撞到了喲～",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
