  },
  {
    "type": "dialogue",
    "name": "男學生們",
    "words": "\\n幹得好！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男學生們",
    "words": "\\n我們贏了──！",
