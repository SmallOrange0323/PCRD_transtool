  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "今天{0}也被宮子糾纏不清。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "{0}，布丁～！",
    "voice": "vo_adv_1007004_000",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "快買布丁給宮子來的～！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "不吃布丁的話宮子會死掉的～！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "你沒有錢嗎～？",
    "voice": "vo_adv_1007004_001",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子才不管呢～！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "總之快點買布丁來的～！！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "哇，好奇怪的光～！？",
    "voice": "vo_adv_1007004_002",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n這、這什麼～好刺眼來的～！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "嗚哇～來的～～～！",
    "voice": "vo_adv_1007004_003",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "background",
    "bg_id": "510240"
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "啊～！",
    "voice": "vo_adv_1007004_004",
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n你要去哪裡～？",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "……去學校？要上課？",
    "voice": "vo_adv_1007004_005",
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "嗚呃～光是聽到就覺得頭痛來的……",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n活著的人還真辛苦來的～",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "先別管那個，",
    "voice": "vo_adv_1007004_006",
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "難得見到面了，你快請宮子吃布丁來的～！",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "……因為你要上課所以沒辦法？",
    "voice": "vo_adv_1007004_007",
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子才不管那個來的～！",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n反正你要買布丁給宮子就對了喲～！",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "就算你說不行，宮子也不會放棄的～！！",
    "voice": "vo_adv_1007004_008",
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "路人１",
    "words": "真討厭──",
    "voice": "vo_adv_1007004_009",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "路人１",
    "words": "\\n那個人在自言自語耶～",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "路人２",
    "words": "搞不好是危險人物喔？",
    "voice": "vo_adv_1007004_010",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "路人２",
    "words": "\\n不要看他比較安全。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "……周圍的人都在看這邊？",
    "voice": "vo_adv_1007004_011",
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "啊～因為普通人看不到身為幽靈的宮子，",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n所以搞不好你會被當成一直自言自語的怪人來的～",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "不要在意那種事情喲～",
    "voice": "vo_adv_1007004_012",
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "比起那些快去買布丁來的……",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "啊！別逃跑──！",
    "voice": "vo_adv_1007004_013",
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "等等啊──！！！",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "background",
    "bg_id": "510220"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "上課中――",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "布～丁！布～丁！",
    "voice": "vo_adv_1007004_014",
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n快買布丁來的～！",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "嗚～～為什麼不理宮子來的～？",
    "voice": "vo_adv_1007004_015",
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n這樣的話宮子只好硬來了喲～！！",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "就是用蠻力把你帶到店裡去喲～！",
    "voice": "vo_adv_1007004_016",
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "嘿～看宮子的～！",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "男學生",
    "words": "怎麼了、怎麼了？",
    "voice": "vo_adv_1007004_017",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男學生",
    "words": "\\n{0}那傢伙為什麼站了起來？",
    "voice": null,
