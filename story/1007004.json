  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "午餐就是要吃布丁喲～！還有也要給宮子布丁來的～！",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "……不行？",
    "voice": "vo_adv_1007004_030",
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "嗚――！",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n今天你都只會一直說不行來的～！",
    "voice": null,
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "嗚嗚嗚……！",
    "voice": "vo_adv_1007004_031",
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n那宮子要這樣對付你！",
