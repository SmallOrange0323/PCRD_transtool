    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男學生們",
    "words": "{0}，搞什麼啊！",
    "voice": "vo_adv_1007004_027",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男學生們",
    "words": "\\n都是你害的才會輸了！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "啊……",
    "voice": "vo_adv_1007004_028",
    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n聚集太多人了，宮子沒辦法靠近那傢伙來的～",
