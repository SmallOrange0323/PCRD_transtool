    "unit_id": 100731
  },
  {
    "type": "dialogue",
    "name": "男學生",
    "words": "哇！",
    "voice": "vo_adv_1007004_032",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男學生",
    "words": "\\n那傢伙怎麼跑去柵欄的外面！？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男學生",
    "words": "\\n不要想不開啊！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男學生",
    "words": "不可以自殺──！",
    "voice": null,
    "unit_id": null
  },
  {
