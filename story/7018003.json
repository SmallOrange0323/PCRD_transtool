[
  {
    "type": "background",
    "bg_id": "500430"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "一行人一邊尋找出口，一邊想辦法處理附身在鈴莓身上的惡靈。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n但面對這前途堪憂的情況，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "忍不自覺地一直在嘆氣。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "居然沒辦法拯救想幫助的人……",
    "voice": "vo_adv_7018003_000",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我是個失職的",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "靈媒啊……",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "忍非常沮喪呢……",
    "voice": "vo_adv_7018003_001",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "這是我造成的，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "該怎麼向她搭話才好呢……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "這是個好點子呢！",
    "voice": "vo_adv_7018003_002",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我們也走了很多路，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "就來吃飯吧！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "這是女僕的本分，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "包在我身上！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "事情就是這樣！",
    "voice": "vo_adv_7018003_003",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "鏘鏘～！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "這是簡易午餐套餐！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "請各位",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "享用吧！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我也可以吃嗎？",
    "voice": "vo_adv_7018003_004",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "但這是鈴莓為",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "{0}做的……",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我做了很多，",
    "voice": "vo_adv_7018003_005",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "所以沒關係喔！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "……雖然說",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我不太能",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "保證這會好吃。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "來，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "請妳坐這裡吧！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "謝謝。",
    "voice": "vo_adv_7018003_006",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "其實",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我也餓了。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n那我開動了……",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "如何！？",
    "voice": "vo_adv_7018003_007",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n是能好好嚥下肚的味道嗎！？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我也曾為重要的人",
    "voice": "vo_adv_7018003_008",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "製作過點心。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n所以",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我能懂喔。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這是充滿了愛情",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "而十分美味的餐點呢。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "忍……",
    "voice": "vo_adv_7018003_009",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "嘻嘻，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我好開心♪",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n忍笑起來時",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "果然也很漂亮呢！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "……啊，",
    "voice": "vo_adv_7018003_010",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "對不起。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n我露出的",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "表情一直都很可怕吧……？",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n我也經常讓來占卜的人",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "一臉尷尬。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "沒有沒有！",
    "voice": "vo_adv_7018003_011",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "與其說是可怕的表情，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "更該說是認真的表情喔！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "就和我在服侍的大小姐一樣，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我能感覺到那是在擔心我",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "又為我著想的……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "溫柔的眼神。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我覺得很高興。",
    "voice": "vo_adv_7018003_012",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "因為妳很認真地",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "在為我著想。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "所以",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "忍絕對",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不可怕。",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "忍是非常溫柔的人！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "這是不會錯的！！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "呵呵……",
    "voice": "vo_adv_7018003_013",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "聽妳說得這麼鏗鏘有力，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n會讓原本沮喪的心情都消失不見呢。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n鈴莓，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "謝謝妳。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "是的♪",
    "voice": "vo_adv_7018003_014",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n這都要歸功於你提議",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "說要一起來吃飯！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "對了對了，",
    "voice": "vo_adv_7018003_015",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n我還挑戰做了{0}愛吃的菜喔！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不嫌棄的話，就請你盡情享用吧♪",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "謝謝招待。",
    "voice": "vo_adv_7018003_016",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n真希望我能做些什麼",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "來和鈴莓道謝……",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "這樣的話，",
    "voice": "vo_adv_7018003_017",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "能不能也為我占卜呢！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "……嗯，",
    "voice": "vo_adv_7018003_018",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "但占卜的結果可說是顯而易見啊。",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "爸爸，你安靜一點。",
    "voice": "vo_adv_7018003_019",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n那我",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "要來占卜囉。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "好緊張……！",
    "voice": "vo_adv_7018003_020",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "……占卜出來了。",
    "voice": "vo_adv_7018003_021",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "結果是",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "大凶。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n就算到了明天",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "或是大後天，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "好像還是會繼續維持同樣的運勢……",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "打擊好沉重……",
    "voice": "vo_adv_7018003_022",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "大凶……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n這果然代表了",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "「我會一直冒冒失失的」對吧……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "「會一直冒冒失失的」",
    "voice": "vo_adv_7018003_023",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "……我是沒算到這個結果，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "但今天……",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "有特別明顯的火難之相。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n請妳小心，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不要靠近火源。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我知道了！",
    "voice": "vo_adv_7018003_024",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n我今天絕對不會",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "靠近火源的！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "但",
    "voice": "vo_adv_7018003_025",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我才剛這麼想……！！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "就遇上了一群魔物嗎？",
    "voice": "vo_adv_7018003_026",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "而且那群傢伙",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "還用火用得毫不客氣。",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n真的就和忍的占卜一樣啊！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "哎呀～",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "真不愧是本大爺的女兒！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "遇到這種狀況，",
    "voice": "vo_adv_7018003_027",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我該怎麼辦才好！？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "請鈴莓離遠一點。",
    "voice": "vo_adv_7018003_028",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這邊就交給我來處理……",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "background",
    "bg_id": "500430"
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "……！？",
    "voice": "vo_adv_7018003_029",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "忍！？",
    "voice": "vo_adv_7018003_030",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n……喂，小伙子！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "忍被留在火海裡頭了！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n還和魔物們在一起！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "你快想點辦法！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "──呃，你那邊也在忙著處理魔物喔！",
    "voice": "vo_adv_7018003_031",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n你在關鍵時刻根本派不上用場啊！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "別擔心，",
    "voice": "vo_adv_7018003_032",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我能獨自應付這邊──",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "咳，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "咳咳！",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "吸到太多煙，",
    "voice": "vo_adv_7018003_033",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "呼吸不過來……！",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我得快點展開術式……！　",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "既然如此，就用本大爺的所有靈力……！！",
    "voice": "vo_adv_7018003_034",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我要跳到忍那邊了，",
    "voice": "vo_adv_7018003_035",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "請空出在那附近的空間！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n……嘿！！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "哇啊啊，",
    "voice": "vo_adv_7018003_036",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "呼……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我平安降落了！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "鈴莓……！？",
    "voice": "vo_adv_7018003_037",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n妳為什麼",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "過來了……！",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "因為",
    "voice": "vo_adv_7018003_038",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "忍遇到危機了啊！？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "雖然對特地為我占卜的忍很不好意思……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "但我絕對不要",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "束手旁觀！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我會把大家",
    "voice": "vo_adv_7018003_039",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "一起清掃乾淨的！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n狂風暴雨！！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "奇、",
    "voice": "vo_adv_7018003_040",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "奇怪……？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "威力怎麼好像比平常更強……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n是說",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "這會不會強過頭了啊！？　",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "background",
    "bg_id": "500430"
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "咳、",
    "voice": "vo_adv_7018003_041",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "咳咳……！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n是、",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "是的！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我們平安無事！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "忍還好嗎！？",
    "voice": "vo_adv_7018003_042",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "比起我，",
    "voice": "vo_adv_7018003_043",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "鈴莓比較嚴重……！",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "妳這不是燙傷了嗎……！",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "啊，",
    "voice": "vo_adv_7018003_044",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "這是那個……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "就和占卜一樣呢！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n這只是被我自己引發的爆炸波及到而已，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "也就是",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "自作自受！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我也能夠治療，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "請妳不用擔心！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不提這個……",
    "voice": "vo_adv_7018003_045",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "忍平安無事，這真是太好了！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "鈴莓……",
    "voice": "vo_adv_7018003_046",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "……奇怪？",
    "voice": "vo_adv_7018003_047",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我怎麼覺得",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "屁股有點涼涼的……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "呀！？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "是因為裙子被燒掉了一塊……！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "也得把這邊修補起來才行……！！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我也來幫忙……！",
    "voice": "vo_adv_7018003_048",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "鈴莓慌忙地壓著被燒掉的裙子布料，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n忍則是為了不讓男生們看到而擋住他們。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n這完美的合作就像是在體現兩人的情誼。",
    "voice": null,
    "unit_id": null
  }
]
