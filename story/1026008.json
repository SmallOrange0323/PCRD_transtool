[
  {
    "type": "background",
    "bg_id": "500011"
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "啊～訓練好辛苦……",
    "voice": "vo_adv_1026008_000",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "結果從早到晚都在練習揮槍啊～",
    "voice": "vo_adv_1026008_001",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n手臂的肌肉都浮腫起來了。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "這樣的話到了明天，",
    "voice": "vo_adv_1026008_002",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n肌肉會相當痠痛呦。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "咦……",
    "voice": "vo_adv_1026008_003",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n{0}，你說什麼？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n你問我充分地運動後不覺得心情很暢快嗎？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "哎呀……",
    "voice": "vo_adv_1026008_004",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n我沒辦法理解那種，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n熱血運動族般的反應呢。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "不過，能把麻煩事解決，",
    "voice": "vo_adv_1026008_005",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n心情也是有點舒爽啦。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "但我可不想做第二次呦～",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "說真的。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "雖然我的努力有得到認可，",
    "voice": "vo_adv_1026008_006",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n【哞哞自衛隊】的訓練只到今天就結束了。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "但下個月……活動報告時不露個臉的話，",
    "voice": "vo_adv_1026008_007",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n訓練就要變成兩倍。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "所謂兩倍，",
    "voice": "vo_adv_1026008_008",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "就是要揮槍200次？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n那樣的話手臂就要掉下來了……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "雖然大家說，每天只要踏實鍛鍊一下肌肉的話，",
    "voice": "vo_adv_1026008_009",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n就能從容地完成練習了。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "但我可沒那種力氣啦～",
    "voice": "vo_adv_1026008_010",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "話說，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "奇怪？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n{0}，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "你為什麼在笑呢？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "真過分啊～明明人家正感到痛苦。",
    "voice": "vo_adv_1026008_011",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "咦，我變得比平常還愛說話？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "果然是因為運動身體的關係，",
    "voice": "vo_adv_1026008_012",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n情緒也跟著高漲起來了吧？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "可能是地獄訓練順利完成，",
    "voice": "vo_adv_1026008_013",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n充滿了成就感也說不定。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "雖然一點也不開心，",
    "voice": "vo_adv_1026008_014",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n只感覺到痛苦。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "但是。",
    "voice": "vo_adv_1026008_015",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n做好該做的事，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n然後像這樣和{0}一起走在回家的路上……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "總覺得有點不錯呢。",
    "voice": "vo_adv_1026008_016",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n我一直，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "很憧憬像這樣子的感覺。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "嗚哇！？",
    "voice": "vo_adv_1026008_017",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n{0}，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "你又在發光了啦！",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n不要突然發光，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "會嚇人一跳的……！",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "background",
    "bg_id": "510080"
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "嘿咻～",
    "voice": "vo_adv_1026008_018",
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "咿、",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "呼呼……",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n欸咻～",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "still",
    "still_id": "102600801"
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "做紅豆麵包，比想像的還要辛苦呢，",
    "voice": "vo_adv_1026008_019",
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n這是相當需要體力的勞動啊……",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n手臂好像要掉下來了。",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "咦……",
    "voice": "vo_adv_1026008_020",
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n你說什麼，{0}？",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n看起來有模有樣的？",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "不要光說感想，來幫忙啦～",
    "voice": "vo_adv_1026008_021",
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "還有因為我累了，你去隨便買個紅豆麵包回來。",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n為了紓解壓力我想暴飲暴食。",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "嗯……也對呢，",
    "voice": "vo_adv_1026008_022",
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n因為現在在做紅豆麵包，",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n如果先吃了店裡賣的商品，感動就會減少了呢。",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "但是，我現在就想吃嘛。",
    "voice": "vo_adv_1026008_023",
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n好想吃紅豆麵包～",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n啊啊因為戒斷症狀手臂開始發抖了。",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "啊對了，做到一半就可以了，直接開動吧。",
    "voice": "vo_adv_1026008_024",
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "美式鬆餅不也是，",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n在煎之前的狀態是最好吃的嗎。",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "繼生巧克力、生牛奶糖之後，接著是生紅豆麵包！",
    "voice": "vo_adv_1026008_025",
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n這個會流行呦……☆",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "呵呵呵。",
    "voice": "vo_adv_1026008_026",
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n如果這個很美味的話，",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n下次開始就可以省去烤這個步驟了。",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "真是個一石二鳥的好主意呢～",
    "voice": "vo_adv_1026008_027",
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n{0}也這麼想的吧？",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "好。",
    "voice": "vo_adv_1026008_028",
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n決定了的話就快點，我開動～了……♪",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "嚼嚼。",
    "voice": "vo_adv_1026008_029",
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "嗚噁～",
    "voice": "vo_adv_1026008_030",
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "黏糊糊的好難吃。",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "果然是不烤不行的啊。",
    "voice": "vo_adv_1026008_031",
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n任何事情都沒有捷徑呢，",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n生活在世上還真艱辛啊。",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "再來，",
    "voice": "vo_adv_1026008_032",
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "要把",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "紅豆餡放進",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "麵團裡……",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "呼嚕……♪",
    "voice": "vo_adv_1026008_033",
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "呼嚕、",
    "voice": "vo_adv_1026008_034",
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "呼嚕……♪",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "……嗚啊？",
    "voice": "vo_adv_1026008_035",
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n咦，",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我睡著了？",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我好像咚一聲的失去意識了～",
    "voice": "vo_adv_1026008_036",
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n因為今天進行了名為製作紅豆麵包的嚴酷勞動，",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n把體力用光了呢。",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "但是現在，睡著的話是不行的。",
    "voice": "vo_adv_1026008_037",
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n在紅豆麵包烤好之前要醒著才行。",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "嗯？",
    "voice": "vo_adv_1026008_038",
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n哇啊，什麼？",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n不要搖我的肩膀啦～{0}？",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "咦，我站著睡著了？",
    "voice": "vo_adv_1026008_039",
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "嗚～好像是因為體力到達極限而睡著了……",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "謝謝你叫醒我哦，{0}。",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "還有，生紅豆麵包並不好吃，",
    "voice": "vo_adv_1026008_040",
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n所以還是好好的烤吧。",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "在這個狀態下把它吃完就太浪費了呢。",
    "voice": "vo_adv_1026008_041",
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "……好。",
    "voice": "vo_adv_1026008_042",
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n這樣一來，接著應該放進去烤就可以了。",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "啊啊，",
    "voice": "vo_adv_1026008_043",
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "紅豆麵包的香味飄出來了♪",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "……已經烤好了嗎？",
    "voice": "vo_adv_1026008_044",
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n還沒？",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n已經好了吧，打開烤箱囉！",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "嗚哇，紅豆麵～包！",
    "voice": "vo_adv_1026008_045",
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n好想見你啊～♪",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "好燙燙燙，還不能摸啊。",
    "voice": "vo_adv_1026008_046",
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "但是",
    "voice": "vo_adv_1026008_047",
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "人生中首次製作紅豆麵包，",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n漂亮地達成了哦～",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "謝謝你的幫忙哦，{0}。",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "那謝禮就，",
    "voice": "vo_adv_1026008_048",
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "按照約定……",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n我也會聽{0}的話哦。",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "嗯，我想從明天開始好好去上學。",
    "voice": "vo_adv_1026008_049",
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n總之，我會用我的方式努力的。",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "欸嘿嘿。",
    "voice": "vo_adv_1026008_050",
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n比起那個，一起試吃紅豆麵包吧。",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "嚼嚼♪",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "喔喔喔喔，真美～味☆",
    "voice": "vo_adv_1026008_051",
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n剛出爐的紅豆麵包，",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n會變得這麼好吃啊？",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "嚼嚼嚼嚼♪",
    "voice": "vo_adv_1026008_052",
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n真是讓人受不了！",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我，一直都搞錯了！",
    "voice": "vo_adv_1026008_053",
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n沒想到我連自己做好剛出爐的紅豆麵包都沒有吃過，",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n居然還敢宣稱自己喜歡紅豆麵包！",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "好啦，",
    "voice": "vo_adv_1026008_054",
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "{0}也吃吧！",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n雖然其實是不想分給任何人的，",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n但因為{0}是特別的！",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "互相分享喜悅嘛，",
    "voice": "vo_adv_1026008_055",
    "unit_id": 102631
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n兩個人一起……♪",
    "voice": null,
    "unit_id": 102631
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好的，",
    "voice": "vo_adv_1026008_056",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "辛苦你了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "啊……總覺得，連我都開始肚子餓了。",
    "voice": "vo_adv_1026008_057",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "雖然我沒有進食的功能，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n但看著你們能吃吃喝喝，我很羨慕呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "總之，話說回來。",
    "voice": "vo_adv_1026008_058",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你們的關係確實變好了呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "雖然要說的話，假日一起做麵包，",
    "voice": "vo_adv_1026008_059",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n與其說是朋友或戀人，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "更像是親子的感覺。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "但我覺得很好喔，令人欣慰呢……",
    "voice": "vo_adv_1026008_060",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n或許透過跟鈴的交流，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n你的心靈也被治癒了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "因為你最近，",
    "voice": "vo_adv_1026008_061",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n表情變得非常溫柔喔。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "在外面的世界中，",
    "voice": "vo_adv_1026008_062",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n無論是辛苦或痛苦的事，都堆積如山。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "但如果有能一起攜手度過，",
    "voice": "vo_adv_1026008_063",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n互相分享喜悅的人在，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n就一點都不會不幸喔。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "倒不如說，",
    "voice": "vo_adv_1026008_064",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "真的好羨慕啊。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "真好呢……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n{0}的夥伴，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "明明曾經是我呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "……總之也好。",
    "voice": "vo_adv_1026008_065",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n今天就到此為止，先失陪了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "兩個人都還是小孩子，",
    "voice": "vo_adv_1026008_066",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n快點回去，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不要熬夜早點睡喔。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "下次在夢裡再會吧。",
    "voice": "vo_adv_1026008_067",
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500011"
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "呼嚕、",
    "voice": "vo_adv_1026008_068",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "呼嚕……♪",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "唔嗯？",
    "voice": "vo_adv_1026008_069",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n紅豆麵包！",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n我開動了～♪",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "……唔嗯！？",
    "voice": "vo_adv_1026008_070",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n不對，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n這不是紅豆麵包，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "是{0}的後腦杓！",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "好痛啊，",
    "voice": "vo_adv_1026008_071",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "還以為牙齒要掉了……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n對不起哦{0}，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n睡昏頭不小心咬了你。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "話說，{0}……",
    "voice": "vo_adv_1026008_072",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n你，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "在背我回去嗎？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n因為我累壞了，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "在回去的路上熟睡了？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "這樣啊。",
    "voice": "vo_adv_1026008_073",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "謝謝你哦，{0}。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "……你不也好像發著光，突然睡著了嗎？",
    "voice": "vo_adv_1026008_074",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "那是在作夢嗎，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "嗚～嗯，剛睡醒頭腦無法思考！",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "……要是你有什麼煩惱的話，可以找我商量呦。",
    "voice": "vo_adv_1026008_075",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n雖然我，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "可能不太可靠。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "因為被同年紀的人，",
    "voice": "vo_adv_1026008_076",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n單方面的照顧，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "很難為情嘛。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "嗯？",
    "voice": "vo_adv_1026008_077",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n你說，一直都被我幫助著？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n咦～",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我有對你做了什麼嗎？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "真是的。",
    "voice": "vo_adv_1026008_078",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n老是在說些意義不明的事情呢，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n{0}。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "欸嘿嘿。",
    "voice": "vo_adv_1026008_079",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n喂，回去時，找間店買紅豆麵包來吃吧。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n我現在非常想吃……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "因為疲勞的時候想要補充糖分，",
    "voice": "vo_adv_1026008_080",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n而且肚子也餓了。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "在夢中啊……",
    "voice": "vo_adv_1026008_081",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n覺得好像吃了超級美味的紅豆麵包呢。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n真想再品嘗一次啊。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "不只是夢中，在現實中，",
    "voice": "vo_adv_1026008_082",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n也希望兩個人能要好的大口吃那個紅豆麵包啊。",
    "voice": null,
    "unit_id": 102611
  }
]
