    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "銀色長髮的女孩，",
    "voice": "vo_adv_1098007_088",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "跟一位長得與妳很像的女僕。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "該說是物以類聚嗎。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "這兩位也都是超級大好人啊。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "我有試過故意多找錢給她們，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "結果都有好好地還回來。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "到了這種地步反而會讓人開始擔心對吧？",
    "voice": "vo_adv_1098007_089",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "善良過頭，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "會讓人懷疑是不是有什麼內幕……",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "之類的。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "別看我這樣，",
    "voice": "vo_adv_1098007_090",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "我可是很敏銳的。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "那些新人們，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "實在是無法讓人信任。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "要小心點啊。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "\\n搞不好是裝成夥伴拉攏你們，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "等到取得信任後……",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "凱留、拉姆",
    "words": "…………",
    "voice": "vo_adv_1098007_091",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "咦……",
    "voice": "vo_adv_1098007_092",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "兩位，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "表情怎麼那麼認真。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "我，說了什麼奇怪的話了嗎？",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……大叔。",
    "voice": "vo_adv_1098007_093",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留、拉姆",
    "words": "「我宰了你哦！」\\n「好大的膽子。去死吧。」",
    "voice": "vo_adv_1098007_094",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "欸！？",
    "voice": "vo_adv_1098007_095",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你這個外人，",
    "voice": "vo_adv_1098007_096",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "又懂她們的什麼了。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n你要是在繼續亂說下去我可不饒你！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "或是讓拉姆來把你這張亂說話的嘴給縫起來。",
    "voice": "vo_adv_1098007_097",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "至少，",
    "voice": "vo_adv_1098007_098",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "像你這種明明在做生意，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n卻會說客人壞話的傢伙是沒有人會信任你的。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n今天可能是拉姆最後一次看到你這張骯髒臉了。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "咦、",
    "voice": "vo_adv_1098007_099",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "咦咦咦咦？？",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "話說回來……",
    "voice": "vo_adv_1098007_100",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "居然會有人內心這麼下流。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "肯定每天都過得很空虛。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n啊啊，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "真可憐。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就是說啊，",
    "voice": "vo_adv_1098007_101",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "真是可憐的傢伙！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "啥……！",
    "voice": "vo_adv_1098007_102",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "\\n我只是附和一下妳們說的話而已，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "為什麼要被妳們罵成這樣～！",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "還不想死就快消失吧。",
    "voice": "vo_adv_1098007_103",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n別再張開你那張臭嘴呼吸了。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "嗚",
    "voice": "vo_adv_1098007_104",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "嗚……",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "\\n我才不會再跟妳們說話～～！",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你別再出現了！",
    "voice": "vo_adv_1098007_105",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "哼！",
    "voice": "vo_adv_1098007_106",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "凱留，",
    "voice": "vo_adv_1098007_107",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "那種傢伙連目送他離開的價值都沒有。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "比起這個，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "餐點快冷掉了。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "still",
    "still_id": "109800701"
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗯，",
    "voice": "vo_adv_1098007_108",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "來吃吧來吃吧。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n再來加點個東西。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不好意思～！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我啊～",
    "voice": "vo_adv_1098007_109",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "很喜歡這裡的燉煮料理。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n雖然好像不是什麼人氣品項就是了。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "妳在說什麼。",
    "voice": "vo_adv_1098007_110",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n來到這裡卻不吃燉煮料理，這根本就不可能。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "沒錯！",
    "voice": "vo_adv_1098007_111",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳說得真對。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我搞不懂為什麼大家都不點。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "有時候偏向小孩子的口味會比較受歡迎──",
    "voice": "vo_adv_1098007_112",
    "unit_id": 109811
  },
  {
    "type": "still",
    "still_id": "109800702"
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……什麼啊。",
    "voice": "vo_adv_1098007_113",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留、拉姆",
    "words": "……",
    "voice": "vo_adv_1098007_114",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凱留、拉姆",
    "words": "別再看了快點吃（啊）。",
    "voice": "vo_adv_1098007_115",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "果然跟可可蘿說得一樣，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}在內心如此想著。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "end"
  }
]
