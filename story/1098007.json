    "name": "拉姆",
    "words": "不如說這以外的回答還比較難想像呢。",
    "voice": "vo_adv_1098007_085",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "如果有貼錯的折價貼紙也會跟我說。",
    "voice": "vo_adv_1098007_086",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "而且這陣子，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "你們不是又多了些新人嗎？",
