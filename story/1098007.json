[
  {
    "type": "background",
    "bg_id": "500050"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "某天，在採買結束後順道繞去餐廳的",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n拉姆與{0}。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "……\\n……",
    "voice": "vo_adv_1098007_000",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "不是。",
    "voice": "vo_adv_1098007_001",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n雖然不及雷姆親手做的料理，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "但是很好吃。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "……\\n……",
    "voice": "vo_adv_1098007_002",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "拉姆只是，",
    "voice": "vo_adv_1098007_003",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "在認真地品嘗餐點而已。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "還是說，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "這樣做在這個世界裡很不可思議嗎？",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "……",
    "voice": "vo_adv_1098007_004",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "自從那次跟蹤以來，",
    "voice": "vo_adv_1098007_005",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "拉姆偶爾會像這樣觀察這個男人。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "還是一樣那麼濫好人，",
    "voice": "vo_adv_1098007_006",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "過度的博愛主義者。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n而且，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "老實到像個笨蛋一樣。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "如果要再補充的話，",
    "voice": "vo_adv_1098007_007",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "那就是還有花心大蘿蔔的一面。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "儘管如此，",
    "voice": "vo_adv_1098007_008",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "這個城鎮上的居民",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n似乎都非常喜歡這個男人。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "拉姆完全無法理解。",
    "voice": "vo_adv_1098007_009",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆、？？？",
    "words": "……唉。",
    "voice": "vo_adv_1098007_010",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆、？？？",
    "words": "隔壁也傳來了嘆氣聲？",
    "voice": "vo_adv_1098007_011",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "{0}！",
    "voice": "vo_adv_1098007_012",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "還有拉姆！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你們在這裡做什麼。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "用看的就知道。",
    "voice": "vo_adv_1098007_013",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n在吃東西。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "這麼多餐廳居然會進到同一間，",
    "voice": "vo_adv_1098007_014",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "還坐在隔壁的座位。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "是啊。",
    "voice": "vo_adv_1098007_015",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "感覺有點不太自然呢。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "該不會……",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "難道說，凱留。",
    "voice": "vo_adv_1098007_016",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n妳喜歡拉姆嗎？",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啥啊啊！？",
    "voice": "vo_adv_1098007_017",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "怎麼可能！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "說到底如果我知道你們在這，",
    "voice": "vo_adv_1098007_018",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n就不會坐在隔壁了。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "搞不好甚至",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不會進來這間店吧？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "如果不是追著拉姆跑的話不可能會這麼巧。",
    "voice": "vo_adv_1098007_019",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n誠實一點吧。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "唯獨妳，我才不想被妳這麼說呢。",
    "voice": "vo_adv_1098007_020",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……{0}你、",
    "voice": "vo_adv_1098007_021",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你怎麼了。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n一直盯著我們兩個看。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "難道臉上有沾東西嗎？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "咦？",
    "voice": "vo_adv_1098007_022",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你說我跟拉姆很像？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留、拉姆",
    "words": "……",
    "voice": "vo_adv_1098007_023",
    "unit_id": 109811
  },
  {
    "type": "background",
    "bg_id": "500333"
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "總覺得",
    "voice": "vo_adv_1098007_024",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "兩位好相像呢。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "拉姆、凱留",
    "words": "哪裡像（啊！）",
    "voice": "vo_adv_1098007_025",
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500050"
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……我想起來了。",
    "voice": "vo_adv_1098007_026",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是在跟貝特魯吉烏斯戰鬥的時候……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那是不實指控啦。",
    "voice": "vo_adv_1098007_027",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我跟她何止不像，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "根本是完全相反好嗎！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n混在一起很危險，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就連接近都很危險！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳說對吧？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "拉姆。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "這次拉姆也同意妳。",
    "voice": "vo_adv_1098007_028",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "跟凱留混在一起會讓拉姆的格調降低的。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "拉姆在用餐時可不會像凱留一樣不解風情地嘆氣。",
    "voice": "vo_adv_1098007_029",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是說那個！？",
    "voice": "vo_adv_1098007_030",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不對妳也一樣有嘆氣吧！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "那只是，",
    "voice": "vo_adv_1098007_031",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "說了一聲唉而已。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n不是嘆氣。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……這到底是。",
    "voice": "vo_adv_1098007_032",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n什麼道理啊！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳的話我完全無法理解！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n一點都不像！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我跟妳絕對不像！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "雖然凱留要用什麼表情吃飯跟拉姆一點關係也沒有，",
    "voice": "vo_adv_1098007_033",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "但如果在隔壁像那樣大聲嘆氣的話會讓飯變難吃的。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n原來凱留妳也會有煩惱啊。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "反正一定是有關你們公會的事吧。",
    "voice": "vo_adv_1098007_034",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n因為你們明明吃飯時幾乎都一起吃，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n這次卻很稀奇地分頭行動。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳的直覺好到讓人有點火大……",
    "voice": "vo_adv_1098007_035",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不過，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳說得沒錯。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "咦？",
    "voice": "vo_adv_1098007_036",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你問說發生了什麼事，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是嗎？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……其實啊。",
    "voice": "vo_adv_1098007_037",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是貪吃佩可她又，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "隨口答應接下了委託。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "狩獵來的魔物隨便妳吃，",
    "voice": "vo_adv_1098007_038",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "所以免費幫忙驅除吧～",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n像這種委託，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "她很輕易地就接下來了。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "實際上，",
    "voice": "vo_adv_1098007_039",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這種委託也開始逐漸增加。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不過",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "工作就是工作啊？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "該拿的報酬還是得拿。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "再這樣下去",
    "voice": "vo_adv_1098007_040",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "【美食殿堂】會變成一個無償公會的。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好人做過頭反而害到自己的話，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n總有一天會經營不下去。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "原來如此。",
    "voice": "vo_adv_1098007_041",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n以凱留來說還真是正常的煩惱呢。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "老好人實在太多了，",
    "voice": "vo_adv_1098007_042",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "這點拉姆也這麼覺得。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……咦",
    "voice": "vo_adv_1098007_043",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……是、",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是嗎？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "真難得，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳的想法會跟我一樣……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "然、",
    "voice": "vo_adv_1098007_044",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "然後啊，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我就對她說了。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n要好好地跟對方拿錢才行，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這樣。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "然後，",
    "voice": "vo_adv_1098007_045",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "她回我「小凱留說得很對！」",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這句話。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n結果，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳猜她們後來怎麼做？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "只拿了微薄的報酬就滿足了",
    "voice": "vo_adv_1098007_046",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "，這樣嗎。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "沒錯！",
    "voice": "vo_adv_1098007_047",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就是這樣！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "如果對方在金錢上有困難",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "又或者只是小孩子，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那我還能理解。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n但是",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這可是透過公會管理協會的正式委託耶！？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "結果",
    "voice": "vo_adv_1098007_048",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "她們最後只跟對方，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "收取10盧幣？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "連懷舊點心都買不起啦！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "說再多都沒有用呢。",
    "voice": "vo_adv_1098007_049",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "對吧？",
    "voice": "vo_adv_1098007_050",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "對吧！？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊～太好了。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳能懂我。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "有時候我還會擔心，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "以為",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不正常的人是我呢。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "凱留妳不正常這件事拉姆並不否定。",
    "voice": "vo_adv_1098007_051",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "……",
    "voice": "vo_adv_1098007_052",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "話說回來{0}，",
    "voice": "vo_adv_1098007_053",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "你為何要一邊微笑",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n一邊用關愛的眼神看著這邊呢。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "凱留、拉姆",
    "words": "……",
    "voice": "vo_adv_1098007_054",
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500333"
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呵呵……",
    "voice": "vo_adv_1098007_055",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "果然，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "兩位非常相像呢♪",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "background",
    "bg_id": "500050"
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啥！？",
    "voice": "vo_adv_1098007_056",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "才、",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "才不是呢！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "剛才那只不過，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "稍微有那麼",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "一瞬間聊了起來而已吧？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這跟像不像什麼的",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "完全是，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "兩回事。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "而且你看，",
    "voice": "vo_adv_1098007_057",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "看清楚一點。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我跟拉姆，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就連點的餐點都完全不……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……咦、",
    "voice": "vo_adv_1098007_058",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "咦咦！？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "居然一樣！？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "拉姆妳等等……",
    "voice": "vo_adv_1098007_059",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n為什麼不管是吃喝的還是吃的，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "都跟我點一樣啦！？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗚咕、",
    "voice": "vo_adv_1098007_060",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗚咕",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "咕咕咕……！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "證據這麼齊全的話根本無法否定呢。",
    "voice": "vo_adv_1098007_061",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "凱留，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "妳差不多該承認了吧。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "咦……",
    "voice": "vo_adv_1098007_062",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n要、",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "要承認嗎？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "是啊。",
    "voice": "vo_adv_1098007_063",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "承認因為憧憬拉姆，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "想追上拉姆，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n所以凱留妳拚命地想變得跟拉姆一樣這個事實。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……啥啊啊啊！？",
    "voice": "vo_adv_1098007_064",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳說誰！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "想變得跟妳一樣！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "說起來拉姆妳才是",
    "voice": "vo_adv_1098007_065",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "在模仿我吧！？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "對吧？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是這樣沒錯吧！？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "妳說既高雅又優秀又可愛的拉姆？",
    "voice": "vo_adv_1098007_066",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n會模仿找不到什麼優點可以稱讚的凱留？",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳不要擺出那張",
    "voice": "vo_adv_1098007_067",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "發自內心感到疑惑的臉來把我當笨蛋耍～！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "在店裡不要大聲喧嘩，",
    "voice": "vo_adv_1098007_068",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "凱留。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "雖然凱留模仿拉姆這件事是非常顯而易見的事實。",
    "voice": "vo_adv_1098007_069",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "但有一件事比這還要更能確定。",
    "voice": "vo_adv_1098007_070",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "雖然你剛剛一直在說拉姆跟凱留很相像。",
    "voice": "vo_adv_1098007_071",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "但真正相像的不是拉姆跟凱留。",
    "voice": "vo_adv_1098007_072",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "而是過度濫好人使行為缺乏合理性的，",
    "voice": "vo_adv_1098007_073",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "這個",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "男人跟貪吃佩可她們。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "走失兒童及遺失物搜索……",
    "voice": "vo_adv_1098007_074",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n有人肚子餓了就會分便當給他吃，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n連討伐魔物都會出於善意來承接委託。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "無法忽視那些放著不管就好的事。",
    "voice": "vo_adv_1098007_075",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "只要對方遇到一點困難就會忍不住出手幫助。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n而{0}你就是其中的代表。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "啊～",
    "voice": "vo_adv_1098007_076",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "我懂～",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "\\n妳講的，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "我非常懂。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "呀啊！？",
    "voice": "vo_adv_1098007_077",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你、",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你突然之間是怎樣。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "仔細一看，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你是最近剛開的雜貨店那位……？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "沒錯沒錯！",
    "voice": "vo_adv_1098007_078",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "\\n最近你們很常來買東西對吧？",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "所以有關於你們的事，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "我應該也還算",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "清楚。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "請別隨便過來搭話。",
    "voice": "vo_adv_1098007_079",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "啊，",
    "voice": "vo_adv_1098007_080",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "畢竟我這樣算是亂入。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "真不好意思。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "\\n哎呀，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "因為來吃午餐時偶然聽到你們的對話。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "想說這個我得來附和一下才行。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "你們的夥伴啊，",
    "voice": "vo_adv_1098007_081",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "人真的是有夠好的～",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "你們很常混在一起對吧？",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "只不過因為太溫柔了，",
    "voice": "vo_adv_1098007_082",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "讓我有點擔心。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "\\n所以我就對她們說多少要去懷疑一下別人會比較好。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "因為我知道經商的世界有多嚴酷，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "算是稍微",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "給一點忠告吧？",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "結果啊、",
    "voice": "vo_adv_1098007_083",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "她們很有禮貌地",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "對著我說──！",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "感謝您這麼替我們著想，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "但是，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "在下幾人想要",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "維持這樣就好……",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "居然這樣回答。",
