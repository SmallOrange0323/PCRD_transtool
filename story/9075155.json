  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129613
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "居然是要──",
    "voice": null,
    "unit_id": 129613
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "視察吉歐‧尼布爾黑爾。",
    "voice": null,
    "unit_id": 129613
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n要不是皇女的聖令，",
    "voice": null,
    "unit_id": 129613
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "我才……",
    "voice": null,
    "unit_id": 129613
  },
  {
    "type": "dialogue",
    "name": "殭屍群",
    "words": "…………",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "我可以──",
    "voice": "vo_adv_9075155_001",
    "unit_id": 129613
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "應付殭屍。",
    "voice": null,
    "unit_id": 129613
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n──這不構成、",
    "voice": null,
    "unit_id": 129613
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "威脅。",
    "voice": null,
    "unit_id": 129613
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "──可是，",
    "voice": "vo_adv_9075155_002",
    "unit_id": 129613
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129613
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "幽……",
    "voice": null,
    "unit_id": 129613
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "幽靈就──",
    "voice": null,
    "unit_id": 129613
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "…………得趕緊移動。",
    "voice": "vo_adv_9075155_003",
    "unit_id": 129613
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n在幽靈出現之前──",
    "voice": null,
    "unit_id": 129613
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "學長～",
    "voice": "vo_adv_9075155_004",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "你在哪啊～？",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n想從陰影處觀察，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "卻根本找不到人……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n這個世界",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "也太廣大了……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "……咦？",
    "voice": "vo_adv_9075155_005",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "那邊的人是……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "是在吉歐‧格黑納幫助我修行的",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "安涅默涅小姐……！？",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n她或許會知道",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "學長的某些消息……！　",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "──請、",
    "voice": "vo_adv_9075155_006",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "請問～",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "咿──！？",
    "voice": "vo_adv_9075155_007",
    "unit_id": 129613
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n剛剛的聲音──",
    "voice": null,
    "unit_id": 129613
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "出、",
    "voice": null,
    "unit_id": 129613
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "出現了……！",
    "voice": null,
    "unit_id": 129613
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "咦？",
    "voice": "vo_adv_9075155_008",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "那個、",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "請等一下……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "別拋下我……！",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "──！",
    "voice": "vo_adv_9075155_009",
    "unit_id": 129613
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n看、",
    "voice": null,
    "unit_id": 129613
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "看不見東西……",
    "voice": null,
    "unit_id": 129613
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n但有什麼，",
    "voice": null,
    "unit_id": 129613
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "追來了──！　",
    "voice": null,
    "unit_id": 129613
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "──所以，",
    "voice": "vo_adv_9075155_010",
    "unit_id": 129613
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "我才不想來啊……！",
    "voice": null,
    "unit_id": 129613
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129613
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "這種，",
    "voice": null,
    "unit_id": 129613
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "會出現幽靈的地方……！",
    "voice": null,
    "unit_id": 129613
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "咦，",
    "voice": "vo_adv_9075155_011",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "妳怕幽靈嗎……？",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n只要別去管，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "這裡的幽靈看起來很多都是無害的啊……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "沒、",
    "voice": "vo_adv_9075155_012",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "沒事的喔──",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n這裡的幽靈",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "不會做壞事的……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "會說這種話的幽靈，",
    "voice": "vo_adv_9075155_013",
    "unit_id": 129613
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n怎麼可能──",
    "voice": null,
    "unit_id": 129613
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "值得信任……",
    "voice": null,
    "unit_id": 129613
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "咦，",
    "voice": "vo_adv_9075155_014",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "奇怪？",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n難道……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "妳以為我是幽靈……？",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n因為我太沒存在感……！？",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "比起這個！",
    "voice": "vo_adv_9075155_015",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "跑步鬧出這麼大的聲響",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "很危險喔，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n這一帶",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "有魔物的氣息……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "──出、",
    "voice": "vo_adv_9075155_016",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "出現了────！！",
