    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "看到班上同學",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "都拚命地",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n在互相分享意見，",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "就能感受到大家都是認真地想要好好努力的。",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "而人家，",
    "voice": "vo_adv_1310004_030",
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "一直都在留意情況，",
