    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "避免演變成大規模的衝突。",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "但是太過耗費心神……",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "感覺",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "有一點累了。",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "所以，",
