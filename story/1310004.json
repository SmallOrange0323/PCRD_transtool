  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "就連其他的活動，",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101031
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "或許也能和王子先生一起參加了呢♪",
