[
  {
    "type": "background",
    "bg_id": "502301"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "盡情享用了與涅妃‧涅羅一同製作的料理後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}在借來的民宅房間裡休息。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "──難道？",
    "voice": "vo_adv_1382004_000",
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n騎士閣下呀……",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "看樣子──",
    "voice": "vo_adv_1382004_001",
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "恁已經醒了呢。",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n幸好。",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "然而，",
    "voice": "vo_adv_1382004_002",
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "恁似乎仍處於夢境與現實之間。",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "一再對恁失禮，",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "實在萬分惶恐。",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "雖然觀望恁的酣眠面容",
    "voice": "vo_adv_1382004_003",
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "亦是一樂。",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n然奴家欲於同床之際，",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "與恁",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "說些枕邊密語……",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "不，",
    "voice": "vo_adv_1382004_004",
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "非是十萬火急之事。",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "僅是奴家個人遺憾之感。",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "以奴家「非人」之身，",
    "voice": "vo_adv_1382004_005",
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "如此言論是否妥當",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "雖不得而知。",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "然實不相瞞……",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家心中",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "有股「尚感不足」之寂寥呢。",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n現下，",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "還望與恁再多親暱交流。",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "……後續",
    "voice": "vo_adv_1382004_006",
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "便在夢境中享受。",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "浸入",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "如水面倒影般的夢境，",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "一同沉溺至",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "甜美深處吧。",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "background",
    "bg_id": "510081"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "某日傍晚，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}放學回到了家。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n打開客廳的門後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "出現在那裡的是──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "豆腐、",
    "voice": "vo_adv_1382004_007",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "蔥、",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "味噌……",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "原來如此，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "原來如此。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n主要食材，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "似是大致齊備。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "真是",
    "voice": "vo_adv_1382004_008",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "失禮了。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "冷卻存放各類食材的電倉，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "確實是極其奇妙之物。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "奴家不經意間，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "便窺探起其內部。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "那麼，",
    "voice": "vo_adv_1382004_009",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "騎士閣下呀。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "目前胃口如何？",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n定睛一看，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "日頭亦漸漸西下，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n奴家料想",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "應正好有些飢餓了。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "甚好、",
    "voice": "vo_adv_1382004_010",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "甚好。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n既如此，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "是否要與奴家一同準備晚膳呢？",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "雖說食材",
    "voice": "vo_adv_1382004_011",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "無彼處世界般「驚險刺激」。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "然而此刻",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "得與騎士閣下再次並立於廚房，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n奴家可謂是",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "喜悅之至。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "still",
    "still_id": "138200401"
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "──嗯，",
    "voice": "vo_adv_1382004_012",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "嗯。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n雖是自賣自誇，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "但成果相當不錯。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "來吧，",
    "voice": "vo_adv_1382004_013",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "騎士閣下呀。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n為試味道，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "能否",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "請恁嚐嚐呢？",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "哎呀呀……",
    "voice": "vo_adv_1382004_014",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "實在抱歉。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n由於是「非人」之身，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "無法控制力道。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n舀湯器具",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "已毀損到不留痕跡了。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "作為替代，",
    "voice": "vo_adv_1382004_015",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "奴家",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "便以手盛取。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "無甚大事，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "奴家生於華氏一萬餘度，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "此溫度可謂不痛不癢。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n恁無須顧慮，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "請享用吧。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "莫非",
    "voice": "vo_adv_1382004_016",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "是熱度過高",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "而不合於口嗎？",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "既如此，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "奴家便呼氣",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "為恁調至適溫吧。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "still",
    "still_id": "138200402"
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "……呼，",
    "voice": "vo_adv_1382004_017",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "呼……♪",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "still",
    "still_id": "138200403"
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "如此一來",
    "voice": "vo_adv_1382004_018",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "便無燙傷之虞。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "請盡情享受",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "奴家烹調之味……♪",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "……哎呀，",
    "voice": "vo_adv_1382004_019",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "這可怎麼了。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n恁的臉竟如此通紅。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "若是發燒可不妙。",
    "voice": "vo_adv_1382004_020",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "騎士閣下的臉",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "也須盡快降溫才是。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "來吧，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "請至奴家身邊。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "still",
    "still_id": "138200402"
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "呼，",
    "voice": "vo_adv_1382004_021",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "呼……♪",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "background",
    "bg_id": "510081"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "若合恁口味實便是無上榮幸，",
    "voice": "vo_adv_1382004_022",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "粗茶淡飯招待不周。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "與恁一同度過",
    "voice": "vo_adv_1382004_023",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "這剎那。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n像這般一同用膳，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "實在",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "幸福如夢。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "時間流逝，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "令人依依不捨。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "哦？",
    "voice": "vo_adv_1382004_024",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "無論何時──",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "是嗎？",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "那麼騎士閣下呀，",
    "voice": "vo_adv_1382004_025",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "奴家欲再次任性要求。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n恁能答應奴家嗎？",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "坦白而言，",
    "voice": "vo_adv_1382004_026",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "奴家仍感意猶未盡。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "光陰似箭一詞",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "實在形容巧妙，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "於奴家這副老身而言，轉瞬即逝。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "既如此，",
    "voice": "vo_adv_1382004_027",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "於此夢幻之境，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "即便是片刻之時……",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n能否請恁陪伴奴家，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "至心滿意足為止？",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "恁這番話。",
    "voice": "vo_adv_1382004_028",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n奴家",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "不勝感激。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "如此一來，",
    "voice": "vo_adv_1382004_029",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "奴家便真的獨佔恁了。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "然而",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "無須擔心。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n奴家會作為柔順",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "貞淑的妻室，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "為夫君奉獻……♪",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "background",
    "bg_id": "510090"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──一個禮拜後。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "騎士閣下呀，",
    "voice": "vo_adv_1382004_030",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "請恁起身。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n天已亮，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "亦能聽得鳥鳴聲。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "雖是湊合的粗茶淡飯，",
    "voice": "vo_adv_1382004_031",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "奴家已備好早膳",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "於廳中。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "奴家保證，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "能為恁帶來整日活力。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "雖學識淺薄，",
    "voice": "vo_adv_1382004_032",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "但仍盼望",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "能合恁喜好。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "若有欲吃之菜餚，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "還請",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "儘管吩咐。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "background",
    "bg_id": "510082"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──兩個月後。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "膳食已備妥，",
    "voice": "vo_adv_1382004_033",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "請恁務必品嚐。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "歷經連日磨練，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "今日晚膳，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "奴家使出了渾身解數。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "實在善哉。",
    "voice": "vo_adv_1382004_034",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n奴家此次配合恁的口味精心烹製。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "為了能投恁所好，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "奴家定會每日精進不斷。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "background",
    "bg_id": "510290"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──三年後。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "騎士閣下呀，",
    "voice": "vo_adv_1382004_035",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "恁可有",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "想用之膳食？",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "按「超市傳單」上記載……",
    "voice": "vo_adv_1382004_036",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n魚鋪",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "備有時令活魚，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "能以合算價格",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "取得。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "製成生魚片如何？",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "……哦？",
    "voice": "vo_adv_1382004_037",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n騎士閣下呀，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "恁瞧瞧。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "彼間店家羅列之果實及根菜類，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "實在五彩繽紛。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "便將其用作晚膳配菜吧。",
    "voice": "vo_adv_1382004_038",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "奴家盼恁",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "能永保康健，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "是以飲食之均衡",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "萬不能馬虎。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──●●年後。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "510080"
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "騎士閣下呀。",
    "voice": "vo_adv_1382004_039",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n奴家今日購得了良質白米。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "今日午膳",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "為恁捏製飯糰如何？",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "……恁說",
    "voice": "vo_adv_1382004_040",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "要與奴家一同備膳？",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "實在令人萬分欣喜。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "能於廚房",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "與恁並肩備膳，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "總令奴家",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "心頭雀躍。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "鹽和水",
    "voice": "vo_adv_1382004_041",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "已備妥於此。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n還請多加小心，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "別燙傷恁的貴手。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "…………",
    "voice": "vo_adv_1382004_042",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "奴家可真是。",
    "voice": "vo_adv_1382004_043",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n似乎",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "玩得過頭了些呢。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "……聽著，",
    "voice": "vo_adv_1382004_044",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "假妖精？",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n想必是一如往常，",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "正豎著耳",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "窺探吧？",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "夢境過頭了。",
    "voice": "vo_adv_1382004_045",
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "\\n快引領騎士閣下",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "dialogue",
    "name": "禰羅",
    "words": "甦醒過來。",
    "voice": null,
    "unit_id": 129731
  },
  {
    "type": "background",
    "bg_id": "501640"
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "……咬。",
    "voice": "vo_adv_1382004_046",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n…………",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "嚼嚼。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "……啊～",
    "voice": "vo_adv_1382004_047",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "這個啊。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n是你變成步履蹣跚的老爺爺時捏的飯糰。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "我順手拿來吃了，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "就當作被使喚的報酬～",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "感覺好像不夠鹹？",
    "voice": "vo_adv_1382004_048",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "而且還沒有料？",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "米飯也太軟了。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "不過～",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "也不至於無法入口？",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "待會再來慢慢享用。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n比起這個──",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "……涅妃‧涅羅。",
    "voice": "vo_adv_1382004_049",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "雖然知道不能把常識套用在她身上。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "但是那也太離譜了～",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n時間觀念再怎麼偏差也要有個限度啊。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "這也說明了，",
    "voice": "vo_adv_1382004_050",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "跟你相處的時光是多麼開心呢。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "居然能讓那樣的存在動心，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n你取悅人的技術",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "到底多厲害啊。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "事到如今說這個也晚了就是。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "不過。",
    "voice": "vo_adv_1382004_051",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n那個。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "根本就不是人。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "誰曉得～？",
    "voice": "vo_adv_1382004_052",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n我可不知道。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n就算我知道",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "也不會告訴你。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "別看我這樣，",
    "voice": "vo_adv_1382004_053",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "現在",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "我可是很煩躁。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n像是被當作掃地機器人般使喚。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n這不是缺鐵，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "是缺鈣，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "你懂嗎？",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "……",
    "voice": "vo_adv_1382004_054",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "嗯～",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "不過。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "給個提示。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "看在這個飯糰的分上，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "特別優待。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "根據我的調查，",
    "voice": "vo_adv_1382004_055",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n不論是現實",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "或是VR，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "那傢伙都是怪物。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "是鋼鐵的化身。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n「意識」",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "並沒有誕生非常久，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "但「身體」的部分呢。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "年齡，",
    "voice": "vo_adv_1382004_056",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "是四十",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "六──",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "等等，",
    "voice": "vo_adv_1382004_057",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "開什麼玩笑！？",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "強制結束太犯規了吧！",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "──啊～！",
    "voice": "vo_adv_1382004_058",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "把我的飯糰",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "還來～！",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "background",
    "bg_id": "502301"
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "……恁回來了呢，",
    "voice": "vo_adv_1382004_059",
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "騎士閣下呀。",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "不必勉強回想。",
    "voice": "vo_adv_1382004_060",
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "承蒙恁陪奴家胡鬧，",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "實在難表感激之情。",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "雖是如此，",
    "voice": "vo_adv_1382004_061",
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "與恁共度的愉快時光，",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "確實存在。",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "其佐證……",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "伴手亦在此處。",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "喜愛窺探的假妖精，",
    "voice": "vo_adv_1382004_062",
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "竟想順手牽羊，",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "成何體統。",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n此乃恁傾注真心，",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "為奴家捏製之飯糰……",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "其中真心，",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "可要細細品味。",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "……",
    "voice": "vo_adv_1382004_063",
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "唔……！",
    "voice": "vo_adv_1382004_064",
    "unit_id": 138211
  },
  {
    "type": "still",
    "still_id": "138200404"
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "……入口剎那，",
    "voice": "vo_adv_1382004_065",
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "米粒散發之",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "甘甜香氣，",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "充斥鼻中，",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "愈是咀嚼，",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "穀物本身甜味愈是擴散……",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "其滋味，",
    "voice": "vo_adv_1382004_066",
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "宛如舞妓於舌上",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "翩然起舞一般。",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n然而",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "表象美味並非其真髓所在。",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n真正動人之處，",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "乃是製作者傾注於粒粒米中",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "的真心。",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "柔如雲霧間灑落之日光，",
    "voice": "vo_adv_1382004_067",
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "令內心感到安寧。",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n全心投入，",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "伴隨體貼之意",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "所捏出的滋味，",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n體恤、",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "撫慰他人之心，",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "乃是騎士閣下的體現……",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "background",
    "bg_id": "502301"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "……手藝實在出色。",
    "voice": "vo_adv_1382004_068",
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家拙口鈍辭，",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "難以想出更多讚美之詞。",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "然而……",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "無論嚐過何等珍味佳餚，",
    "voice": "vo_adv_1382004_069",
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "這般溫暖，",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n直擊心扉的盛宴，",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "想必是獨一無二。",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "不料，",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "非人奴家，",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "竟有欲與人傾訴之時呢。",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "正因如此。",
    "voice": "vo_adv_1382004_070",
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n無論面臨何種困局，",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "恁",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "定能克服吧。",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n並非孤身一人，",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "而是與萬物建立羈絆，",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "定能抵達那尚未知曉之解。",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家",
    "voice": "vo_adv_1382004_071",
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "亦欲參與其中。",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "直至星球",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "終結為止，",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "願能伴恁左右，",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "永久守護恁……",
    "voice": null,
    "unit_id": 138211
  }
]
