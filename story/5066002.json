[
  {
    "type": "background",
    "bg_id": "501290"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "回到時光隧道的{0}、祈梨、嘉夜三人",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n為了返回原本的時間，正等待著時空之門開啟。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "時間管理員",
    "words": "時間儀啟動中。",
    "voice": "vo_adv_5066002_000",
    "unit_id": 14611
  },
  {
    "type": "dialogue",
    "name": "時間管理員",
    "words": "\\n返回原始點的時空之門……",
    "voice": null,
    "unit_id": 14611
  },
  {
    "type": "dialogue",
    "name": "時間管理員",
    "words": "無法開啟。",
    "voice": null,
    "unit_id": 14611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "無法開啟……",
    "voice": "vo_adv_5066002_001",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "所以",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我們回不去了？",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "怎怎怎、",
    "voice": "vo_adv_5066002_002",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "怎麼回事？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "時間管理員",
    "words": "檢查時間座標中……",
    "voice": "vo_adv_5066002_003",
    "unit_id": 14611
  },
  {
    "type": "dialogue",
    "name": "時間管理員",
    "words": "\\n因先前產生的時間矛盾，",
    "voice": null,
    "unit_id": 14611
  },
  {
    "type": "dialogue",
    "name": "時間管理員",
    "words": "原始點已損壞。",
    "voice": null,
    "unit_id": 14611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……所以狀況很糟嗎？",
    "voice": "vo_adv_5066002_004",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "時間管理員",
    "words": "檢查損壞中……",
    "voice": "vo_adv_5066002_005",
    "unit_id": 14611
  },
  {
    "type": "dialogue",
    "name": "時間管理員",
    "words": "\\n根據檢查到的毀損狀況，",
    "voice": null,
    "unit_id": 14611
  },
  {
    "type": "dialogue",
    "name": "時間管理員",
    "words": "可勉強修復。",
    "voice": null,
    "unit_id": 14611
  },
  {
    "type": "dialogue",
    "name": "時間管理員",
    "words": "\\n是否執行原始點修復？",
    "voice": null,
    "unit_id": 14611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "看來沒問題吧。",
    "voice": "vo_adv_5066002_006",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n那就趕快回去囉！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……",
    "voice": "vo_adv_5066002_007",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "真的沒問題嗎？",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "時間管理員",
    "words": "若修復成功便沒有問題。",
    "voice": "vo_adv_5066002_008",
    "unit_id": 14611
  },
  {
    "type": "dialogue",
    "name": "時間管理員",
    "words": "\\n是否執行原始點修復？",
    "voice": null,
    "unit_id": 14611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "知道了。",
    "voice": "vo_adv_5066002_009",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "拜託了。",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "時間管理員",
    "words": "原始點修復中……",
    "voice": "vo_adv_5066002_010",
    "unit_id": 14611
  },
  {
    "type": "dialogue",
    "name": "時間管理員",
    "words": "原始點修復中……",
    "voice": null,
    "unit_id": 14611
  },
  {
    "type": "dialogue",
    "name": "時間管理員",
    "words": "修復",
    "voice": null,
    "unit_id": 14611
  },
  {
    "type": "dialogue",
    "name": "時間管理員",
    "words": "成功。",
    "voice": null,
    "unit_id": 14611
  },
  {
    "type": "dialogue",
    "name": "時間管理員",
    "words": "\\n已確認通往修復後的原始點的連結。",
    "voice": null,
    "unit_id": 14611
  },
  {
    "type": "dialogue",
    "name": "時間管理員",
    "words": "\\n即將開啟時空之門。",
    "voice": null,
    "unit_id": 14611
  },
  {
    "type": "background",
    "bg_id": "500890"
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這裡是……",
    "voice": "vo_adv_5066002_011",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "蘭德索爾",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "對吧？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "時間管理員",
    "words": "正確。",
    "voice": "vo_adv_5066002_012",
    "unit_id": 14611
  },
  {
    "type": "dialogue",
    "name": "時間管理員",
    "words": "\\n因之前產生的時間矛盾",
    "voice": null,
    "unit_id": 14611
  },
  {
    "type": "dialogue",
    "name": "時間管理員",
    "words": "而損壞的原始點已修復，\\n目前處於修復後的時間軸。",
    "voice": null,
    "unit_id": 14611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "也就是說",
    "voice": "vo_adv_5066002_013",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我們偏離了原本的時間是吧？",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那是差了幾分鐘呀？",
    "voice": "vo_adv_5066002_014",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "時間管理員",
    "words": "自修復前的原始點的時間算起，",
    "voice": "vo_adv_5066002_015",
    "unit_id": 14611
  },
  {
    "type": "dialogue",
    "name": "時間管理員",
    "words": "\\n這裡是四萬三千兩百分後的未來。",
    "voice": null,
    "unit_id": 14611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "是哦，",
    "voice": "vo_adv_5066002_016",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "四萬……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "四萬！？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "那是幾天啊！？",
    "voice": "vo_adv_5066002_017",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "時間管理員",
    "words": "若換算成天數則為三十天。",
    "voice": "vo_adv_5066002_018",
    "unit_id": 14611
  },
  {
    "type": "dialogue",
    "name": "時間管理員",
    "words": "\\n現在分析時間矛盾影響的連續性。",
    "voice": null,
    "unit_id": 14611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "啊啊啊啊？",
    "voice": "vo_adv_5066002_019",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那不就是一個月嗎！？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n大有問題呀！！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "真的假的啊……",
    "voice": "vo_adv_5066002_020",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "祈梨，",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "怎麼辦？",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "總之先看看公會小屋的狀況吧……",
    "voice": "vo_adv_5066002_021",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "妳等一下。",
    "voice": "vo_adv_5066002_022",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n萬一又像剛才那樣",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "遇到這個時間的我們\\n不就慘了嗎？",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "對、",
    "voice": "vo_adv_5066002_023",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "對喔！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n怎怎怎、",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "怎麼辦才好呀？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "時間管理員",
    "words": "由於原始點已修復，",
    "voice": "vo_adv_5066002_024",
    "unit_id": 14611
  },
  {
    "type": "dialogue",
    "name": "時間管理員",
    "words": "因此於該時間軸未查出\\n主人及陪同者的同位存在。",
    "voice": null,
    "unit_id": 14611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "總之",
    "voice": "vo_adv_5066002_025",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不必擔心會撞見自己是嗎？",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "既然確定沒事了就事不宜遲啦！",
    "voice": "vo_adv_5066002_026",
    "unit_id": 106611
  },
  {
    "type": "background",
    "bg_id": "500040"
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "喂喂喂──！",
    "voice": "vo_adv_5066002_027",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "小子們！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "大幹部祈梨大人回來了唷！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "奇怪？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "沒有人耶……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "真稀奇啊。",
    "voice": "vo_adv_5066002_028",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "發生什麼事了嗎？",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "background",
    "bg_id": "501320"
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "也好。",
    "voice": "vo_adv_5066002_029",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "現在是大好機會！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我記得要把這個書架的開關……",
    "voice": "vo_adv_5066002_030",
    "unit_id": 106611
  },
  {
    "type": "background",
    "bg_id": "501330"
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "好，",
    "voice": "vo_adv_5066002_031",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "開了。",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n壺呢……",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "啊啊啊啊啊！",
    "voice": "vo_adv_5066002_032",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "怎麼了？",
    "voice": "vo_adv_5066002_033",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "祈梨！？",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "還在！",
    "voice": "vo_adv_5066002_034",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這個壺！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "沒事！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "還好好的！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "什麼啊，",
    "voice": "vo_adv_5066002_035",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "別亂嚇人啦……",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "唉，",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這下可以鬆口氣了。",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n祕密房間的魔導具也都還在……",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "啊、",
    "voice": "vo_adv_5066002_036",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "啊啊啊啊啊！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "祈梨，",
    "voice": "vo_adv_5066002_037",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "妳又怎麼了？",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不見了……",
    "voice": "vo_adv_5066002_038",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "嗯？",
    "voice": "vo_adv_5066002_039",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "時間儀不就在這……",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我不是說那個……",
    "voice": "vo_adv_5066002_040",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那時候",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n我拿走的魔杖不見了……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這也不奇怪吧。",
    "voice": "vo_adv_5066002_041",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "因為妳那時候把它拿走……",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "咦，妳、",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "該不會……",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我好像把魔杖忘在那邊了啦啊啊啊啊！",
    "voice": "vo_adv_5066002_042",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
