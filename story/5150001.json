    "name": "愛梅斯",
    "words": "嚮導小妖精啊。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "……嚮導小妖精，",
    "voice": "vo_adv_5150001_064",
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "是嗎。",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "background",
    "bg_id": "501070"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "愛梅斯等人",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "為了捕抓涅比亞而換上泳裝。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n同一時刻──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……什麼？",
    "voice": "vo_adv_5150001_065",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不好意思，純小姐，",
    "voice": "vo_adv_5150001_066",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n可以請妳",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "再報告一次嗎？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……是，",
    "voice": "vo_adv_5150001_067",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "了解了。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n陛下，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "容我再報告一次。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "現在",
    "voice": "vo_adv_5150001_068",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "在蘭德索爾的街巷中",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "發生了異常現象。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n城鎮各處因不明原因出現了水道，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n水道中流動的水",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "似乎會飛來跳去的。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "那個景色",
    "voice": "vo_adv_5150001_069",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "就有如夏日度假村",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "一樣。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……語氣說得很沉重，",
    "voice": "vo_adv_5150001_070",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "報告內容卻很歡樂呢。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不不不，",
    "voice": "vo_adv_5150001_071",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不是這樣吧。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n城鎮的構造發生改變",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不是很糟糕嗎！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n城鎮的居民不要緊嗎？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "是的。",
    "voice": "vo_adv_5150001_072",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n居民似乎都換上了泳裝，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "享受著夏天的樣子。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "享受、",
    "voice": "vo_adv_5150001_073",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "夏天……",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這個國家的人民",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "適應力真強呢。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "可是，",
    "voice": "vo_adv_5150001_074",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "既然發生那種事情，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我也不能坐著不管！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n請幫我準備服裝！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我要泳裝！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n請幫我準備泳裝！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我絕對",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不是要去玩哦！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "請等一下，",
    "voice": "vo_adv_5150001_075",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "陛下。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n畢竟",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "城鎮構造發生變化，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這是不可大意的異常狀況。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n還請陛下在此",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "擬定對策。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "咦？",
    "voice": "vo_adv_5150001_076",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "請陛下",
    "voice": "vo_adv_5150001_077",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "好好工作。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "怎麼這樣～～～～～～～！",
    "voice": "vo_adv_5150001_078",
    "unit_id": 105812
  }
]
