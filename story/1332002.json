    "name": "莫妮卡",
    "words": "\\n不管是國家還是點心",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "肯定都會越變越好的。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "是嗎，",
    "voice": "vo_adv_1332002_072",
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "原來是這樣呀。",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "那麼，",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "為了慶祝蘭德索爾與吉歐‧格黑納之間的交流，",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "\\n這個點心就給妳吧！",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "妳",
    "voice": "vo_adv_1332002_073",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "只是單純想把它塞給別人而已吧……",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "不過我說你，",
    "voice": "vo_adv_1332002_074",
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "居然能在那麼短的時間裡，",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "配合莫妮卡演那齣亂來的小短劇呢。",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "是啊。",
    "voice": "vo_adv_1332002_075",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "不過，",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "正因為我相信如果是閣下的話",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "一定能辦到，",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n才會使出那種策略的。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "幹得漂亮啊。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "哼～",
