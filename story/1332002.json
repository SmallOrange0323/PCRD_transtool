    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "感覺真像是一對好搭檔呢。",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "工作人員1",
    "words": "現場的各位～！",
    "voice": "vo_adv_1332002_077",
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "工作人員1",
    "words": "\\n豆沙包蒸好囉～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "工作人員1",
    "words": "\\n請趁熱享用吧～",
