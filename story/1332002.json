    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "吉歐‧格黑納的男性",
    "words": "來比相撲吧比相撲。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "吉歐‧格黑納的男性",
    "words": "\\n",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "吉歐‧格黑納的男性",
    "words": "把豆粒餡派的傢伙全都給丟出去！",
    "voice": null,
    "unit_id": null
  },
