  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "拿了藥後就趕快回去，多補充水分和營養，好好休息。",
