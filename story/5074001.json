[
  {
    "type": "background",
    "bg_id": "500651"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "接下黑道男子的委託數天後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n深月與{0}一同造訪了大江戶町。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "呵呵，",
    "voice": "vo_adv_5074001_000",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這城鎮獨樹一格，真是有趣呢。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "東國文化獨有的技術與素材，",
    "voice": "vo_adv_5074001_001",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "還有思想，都令人十分感興趣，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "上次拿到的中藥也很有研究價值呢。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "每次我來大江戶町大多都是有麻煩要處理，",
    "voice": "vo_adv_5074001_002",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "真希望有機會可以來這裡悠哉漫遊一下。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "哎呀，",
    "voice": "vo_adv_5074001_003",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "你在發什麼愣呢？",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "到時候你當然也要陪我一起來囉。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "你是這城鎮的英雄不是嗎？",
    "voice": "vo_adv_5074001_004",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n只要帶著你，應該很吃得開吧。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "請多指教囉，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "將軍大人♪",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "話說回來，",
    "voice": "vo_adv_5074001_005",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "鎮上似乎出現了一些凶神惡煞呢。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n上次來的時候沒看過那些人。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "八成是吧。",
    "voice": "vo_adv_5074001_006",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "以前應該都是來道一家",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "在抑制那些不良分子，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n暗中嚇阻他們不四處作亂。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "來委託我的那個男人說他們重情重義，",
    "voice": "vo_adv_5074001_007",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n看來並非隨便說說的呢。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我知道這令人不安，",
    "voice": "vo_adv_5074001_008",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "但我們現在還有其他事情該處理。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n不可以誤判情勢的優先順序。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這狀況應該是由於頭目不在造成的。",
    "voice": "vo_adv_5074001_009",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "所以我們現在該努力解決委託的問題。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這就是讓鎮上恢復原樣最快的方法。",
    "voice": "vo_adv_5074001_010",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "鎮上龍蛇雜處，毫無情調可言，也別想觀光了。",
    "voice": "vo_adv_5074001_011",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "所以這也是為了以後可以開心漫遊大江戶，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "讓我們好好解決這件事吧。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "好啦，",
    "voice": "vo_adv_5074001_012",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "總算抵達目的地，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "聖阿弗萊特醫院了。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "喔～",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "還挺壯觀的嘛。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "鎮上有這麼大型的醫院，",
    "voice": "vo_adv_5074001_013",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "居民想必都很開心吧。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "那個男人也說啦，",
    "voice": "vo_adv_5074001_014",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "外觀毫無疑問是間氣派的醫院。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "越是奸詐的傢伙就越是會擦脂抹粉呀。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "所以眼下應該把這間醫院視做龍潭虎穴呢。",
    "voice": "vo_adv_5074001_015",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n千萬不要忘了。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這個嘛，",
    "voice": "vo_adv_5074001_016",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我是很想入鄉隨俗，\\n化身忍者華麗潛入院裡調查啦，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "只可惜我對忍者沒研究。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不過相對地，我花許多時間做好準備了，",
    "voice": "vo_adv_5074001_017",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "所以我們光明正大地從大門進去吧。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "background",
    "bg_id": "501390"
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "哎呀呀，",
    "voice": "vo_adv_5074001_018",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "門庭若市呢。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "看來風評好不是騙人的。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不過，",
    "voice": "vo_adv_5074001_019",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "也因此要等很久才輪得到就是了。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "讓身體有狀況的患者一直等，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這對心理健康可不好喔。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這件事情先放一邊，",
    "voice": "vo_adv_5074001_020",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我們先去櫃台吧。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "打擾了，",
    "voice": "vo_adv_5074001_021",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我是今天來上任的醫師。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "啊，",
    "voice": "vo_adv_5074001_022",
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "是，",
    "voice": null,
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "直美醫生對吧？",
    "voice": null,
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "院長有告訴我了。",
    "voice": null,
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "\\n",
    "voice": null,
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "請多多指教。",
    "voice": null,
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "……不過，",
    "voice": "vo_adv_5074001_023",
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "另外一位是？",
    "voice": null,
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "他是我的助手。",
    "voice": "vo_adv_5074001_024",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "要一併請你們多多關照了。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "你先別多嘴，配合一下吧。",
    "voice": "vo_adv_5074001_025",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "那麼先請兩位",
    "voice": "vo_adv_5074001_026",
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "去向院長打聲招呼──",
    "voice": null,
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "可以先帶我參觀一下診察室嗎？",
    "voice": "vo_adv_5074001_027",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我想盡快確認自己接下來的工作場所。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "這、",
    "voice": "vo_adv_5074001_028",
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "這樣嗎？",
    "voice": null,
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "好的，",
    "voice": null,
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "我帶兩位參觀。",
    "voice": null,
    "unit_id": 412
  },
  {
    "type": "background",
    "bg_id": "501380"
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "直美醫生，這裡就是妳的診察室。",
    "voice": "vo_adv_5074001_029",
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "\\n請妳自由使用吧。",
    "voice": null,
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "對了，",
    "voice": "vo_adv_5074001_030",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我剛剛看到候診室，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "來了好多患者呢。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "真高興能來到這麼好的醫院。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這麼棒的醫療環境，來道一家的頭目也能安心住院療養了。",
    "voice": "vo_adv_5074001_031",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "……不好意思，",
    "voice": "vo_adv_5074001_032",
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "我不知道妳是在哪邊聽說的，",
    "voice": null,
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "\\n但是本院並沒有收治妳說的患者。",
    "voice": null,
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……這樣啊。",
    "voice": "vo_adv_5074001_033",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "看來謠言真是不能隨便相信呢。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "那麼事不宜遲，",
    "voice": "vo_adv_5074001_034",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我這就開始診察吧。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n護理師，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "把候診室那些患者全都轉來我這邊吧。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "咦？",
    "voice": "vo_adv_5074001_035",
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "全、",
    "voice": null,
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "全部嗎！？",
    "voice": null,
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "這再怎麼說都太亂來了吧！",
    "voice": null,
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "但是讓患者一直等也不好吧？",
    "voice": "vo_adv_5074001_036",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "放心，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我很優秀的♪",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "我、",
    "voice": "vo_adv_5074001_037",
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "我知道了。",
    "voice": null,
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "那麼就麻煩妳了。",
    "voice": null,
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "呵呵，",
    "voice": "vo_adv_5074001_038",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "進行得很順利呢。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "哎呀，",
    "voice": "vo_adv_5074001_039",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不用這麼客氣，",
