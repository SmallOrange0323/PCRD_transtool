    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "兩人獨處時叫我深月就好♪",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不開玩笑了，我先說明吧。",
    "voice": "vo_adv_5074001_040",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n直美其實是真正該來這裡報到的醫師。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "簡單說呢，",
    "voice": "vo_adv_5074001_041",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "就是我假扮成她混進醫院裡面來了。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "因為要先找出假冒的對象，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "還有竄改文件等等的事前準備要做，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "所以我們才會在接到委託後那麼多天後才出發。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "放心。",
    "voice": "vo_adv_5074001_042",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "她還活得好好的啦。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "現在應該在其他醫院勤奮工作吧。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "所以我接下來",
    "voice": "vo_adv_5074001_043",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "就是要準備到時候的對策囉。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "那個護理師聽到頭目時的反應，",
    "voice": "vo_adv_5074001_044",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "你應該也看到了吧？",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不只是謝絕會客，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "他們就連頭目住院這件事都隱瞞了起來。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這簡直就是在大聲說我們醫院很可疑喔。",
    "voice": "vo_adv_5074001_045",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "既然嫌疑加重了，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "那我們也要有所對策。",
    "voice": null,
    "unit_id": 105111
  },
