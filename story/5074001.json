    "voice": "vo_adv_5074001_067",
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "\\n她說要替所有患者看診，我就轉給了她……",
    "voice": null,
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "醫師",
    "words": "所有患者……",
    "voice": "vo_adv_5074001_068",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "醫師",
    "words": "這怎麼可能！？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "醫師",
    "words": "\\n首先，這樣根本不可能好好替每一個人診察──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "外來患者2",
    "words": "哎呀～",
    "voice": "vo_adv_5074001_069",
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "外來患者2",
    "words": "新來的醫生真是太棒了！",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "外來患者2",
    "words": "\\n",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "外來患者2",
    "words": "平常總是要等上半天，",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "外來患者2",
    "words": "新醫生又快又細心，真是太好了。",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "外來患者2",
    "words": "而且那位醫生的針灸治療",
    "voice": "vo_adv_5074001_070",
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "外來患者2",
    "words": "十分有效啊。",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "外來患者2",
    "words": "\\n",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "外來患者2",
    "words": "原本明明很痛的，現在看完診簡直健步如飛啊！",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "外來患者1",
    "words": "我很怕上醫院，",
    "voice": "vo_adv_5074001_071",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "外來患者1",
    "words": "不過有那麼棒的醫生，我就完全不怕啦。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "就像那樣，",
    "voice": "vo_adv_5074001_072",
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "那位新醫師不只看得快，也看得確實，",
    "voice": null,
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "\\n已經深受患者們青睞……",
    "voice": null,
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "醫師",
    "words": "真不敢相信，",
    "voice": "vo_adv_5074001_073",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "醫師",
    "words": "居然有如此名醫來到我們醫院……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "這件事情，",
    "voice": "vo_adv_5074001_074",
    "unit_id": 512
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "可以詳細說給我聽聽嗎？",
    "voice": null,
    "unit_id": 512
  },
  {
    "type": "background",
    "bg_id": "501381"
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "哎呀，",
    "voice": "vo_adv_5074001_075",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "已經這麼晚了。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "以第一天來說，成果豐碩呢。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "院長",
    "words": "打擾了。",
    "voice": "vo_adv_5074001_076",
    "unit_id": 512
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "抱歉，",
    "voice": "vo_adv_5074001_077",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "今天已經休診囉。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "院長",
    "words": "別在意。",
    "voice": "vo_adv_5074001_078",
    "unit_id": 512
  },
  {
    "type": "dialogue",
    "name": "院長",
    "words": "我只是來看看才剛上任也不來向我打聲招呼，",
    "voice": null,
    "unit_id": 512
  },
  {
    "type": "dialogue",
    "name": "院長",
    "words": "\\n就自作主張的無禮醫師長什麼樣子罷了。",
    "voice": null,
    "unit_id": 512
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "哎呀，",
    "voice": "vo_adv_5074001_079",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這麼說你就是院長囉。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "聽說你手腕高明，重振了這間有如風中殘燭的醫院。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n我叫做直美。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不好意思，現在才跟你打招呼。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "院長",
    "words": "哼，",
    "voice": "vo_adv_5074001_080",
    "unit_id": 512
  },
  {
    "type": "dialogue",
    "name": "院長",
    "words": "我可不是來說這些無聊的客套話的，",
    "voice": null,
    "unit_id": 512
  },
  {
    "type": "dialogue",
    "name": "院長",
    "words": "妳這個冒牌貨。",
    "voice": null,
    "unit_id": 512
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "哎呀，",
    "voice": "vo_adv_5074001_081",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "太令人心寒了。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我──",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "院長",
    "words": "妳認為我會沒事先確認過僱用醫師的來歷嗎？",
    "voice": "vo_adv_5074001_082",
    "unit_id": 512
  },
  {
    "type": "dialogue",
    "name": "院長",
    "words": "\\n妳如此大費周章，",
    "voice": null,
    "unit_id": 512
  },
  {
    "type": "dialogue",
    "name": "院長",
    "words": "究竟有何目的？",
    "voice": null,
    "unit_id": 512
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "好吧，",
    "voice": "vo_adv_5074001_083",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "反正我本來就覺得只瞞得了一時。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我的目的就是想被這家醫院僱用。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "院長",
    "words": "而妳就為了這個不惜做了這麼多事情，是吧？",
    "voice": "vo_adv_5074001_084",
    "unit_id": 512
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "是的。",
    "voice": "vo_adv_5074001_085",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "大型醫院的慢性問題，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "就是總是會令患者久候。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "而我能解決這個問題，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "也已經證明我並非紙上談兵了。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "況且，",
    "voice": "vo_adv_5074001_086",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "院長你手腕高明，好不容易才將這間醫院重振得有聲有色，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "卻讓患者不斷久候，損害風評也不太好吧？",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "院長",
    "words": "……好吧，",
    "voice": "vo_adv_5074001_087",
    "unit_id": 512
  },
  {
    "type": "dialogue",
    "name": "院長",
    "words": "如妳所願，從明天起就來這間診察室上班。",
    "voice": null,
    "unit_id": 512
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "感謝。",
    "voice": "vo_adv_5074001_088",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我會誠心誠意工作的。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "院長",
    "words": "但是，",
    "voice": "vo_adv_5074001_089",
    "unit_id": 512
  },
  {
    "type": "dialogue",
    "name": "院長",
    "words": "妳可別多管閒事啊。",
    "voice": null,
    "unit_id": 512
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "多管什麼閒事呢？",
    "voice": "vo_adv_5074001_090",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "院長",
    "words": "真是明知故問。",
    "voice": "vo_adv_5074001_091",
    "unit_id": 512
  },
  {
    "type": "dialogue",
    "name": "院長",
    "words": "希望妳別聰明反被聰明誤啊。",
    "voice": null,
    "unit_id": 512
  },
  {
    "type": "dialogue",
    "name": "院長",
    "words": "\\n",
    "voice": null,
    "unit_id": 512
  },
  {
    "type": "dialogue",
    "name": "院長",
    "words": "好好工作吧，",
    "voice": null,
    "unit_id": 512
  },
  {
    "type": "dialogue",
    "name": "院長",
    "words": "優秀的大醫師。",
    "voice": null,
    "unit_id": 512
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "啊，對了對了，",
    "voice": "vo_adv_5074001_092",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "忘記自我介紹，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我叫做深月。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "請多關照囉，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "院長♪",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就這樣，成功與院長見到面的深月，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n順利潛入醫院之中了。",
    "voice": null,
    "unit_id": null
  }
]
