    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n運動前自然不用說，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "運動之後的伸展操也很重要喔。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "要是擔心自己運動不足，",
    "voice": "vo_adv_5074001_060",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "在膝蓋治好之前可以做些肌力訓練。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n我教你一些輕鬆又有效的鍛鍊動作吧。",
