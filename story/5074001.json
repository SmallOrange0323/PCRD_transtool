  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "嗯～",
    "voice": "vo_adv_5074001_050",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "看得出來你有咳嗽，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "還有其他症狀嗎？",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "外來患者1",
    "words": "呃、",
    "voice": "vo_adv_5074001_051",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "外來患者1",
    "words": "啊、",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "外來患者1",
    "words": "那個，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "外來患者1",
    "words": "我還有一點發燒、全身也有點無力，",
