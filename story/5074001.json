    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "那麼你今天是哪裡不舒服呢？",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "外來患者2",
    "words": "那、",
    "voice": "vo_adv_5074001_058",
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "外來患者2",
    "words": "那個，",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "外來患者2",
    "words": "我最近為了維持健康而開始跑步，",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "外來患者2",
    "words": "\\n但似乎太勉強了，導致膝蓋疼痛……",
    "voice": null,
    "unit_id": 1412
  },
  {
