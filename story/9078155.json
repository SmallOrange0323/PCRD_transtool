    "words": "呀啊啊啊啊啊啊啊──────！！",
    "voice": "vo_adv_9078155_000",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n那、",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "那邊的人快逃啊～～！！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "咦咦咦！？！？！？",
    "voice": "vo_adv_9078155_001",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n為什麼有人從天而降──",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "哦、哦哦。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "接得好♪",
    "voice": "vo_adv_9078155_002",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "雖然不太清楚事情的經過，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "但沒事吧？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n妳們兩位，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "有沒有受傷？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "謝謝您",
    "voice": "vo_adv_9078155_003",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "接住在下等人，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n素昧平生的好心人。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我們",
    "voice": "vo_adv_9078155_004",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "迷路了……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "所以想說爬到高聳的岩石上或許就能認清路……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "真的、",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "真的很抱歉～～！",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "而且還讓妳接住我們……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "真不知該如何感謝妳才好……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "啊哈哈，",
    "voice": "vo_adv_9078155_005",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "不用在意啦！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n反正大家都沒事！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "不過",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "大姐姐我的確是",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "很有力氣啦♪",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "話說回來，",
    "voice": "vo_adv_9078155_006",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "嚇了我一跳！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n沒想到會有女孩子從天而降！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "還以為又是日和呢！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "啊哈哈。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "可可蘿、鈴莓",
    "words": "「您是日和小姐的熟人啊。」\\n「妳是日和小姐的熟人嗎！？」",
    "voice": "vo_adv_9078155_007",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "嗯？",
    "voice": "vo_adv_9078155_008",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "嗯♪",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "我叫埃拉。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "跟日和算是熟人、朋友、",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "也是自己人，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "或者該說是更～密切的關係？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "所以，",
    "voice": "vo_adv_9078155_009",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "能在這樣的地方",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n遇到認識日和的人，我很高興呢！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n幸好我有忍著寒冷走過來～！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "啊，",
    "voice": "vo_adv_9078155_010",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "那個啊，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "大姐姐我，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "經歷了很多事。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "現在有～點算是，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "正值冒險的年紀啦。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n但其實我也迷路了呢……",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "哈啾！",
