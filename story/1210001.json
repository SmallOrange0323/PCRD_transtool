[
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "──這是",
    "voice": "vo_adv_1210001_000",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "思念你的少女的故事。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n是與你一起被困在",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "「人工世界」的",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "貪吃佩可的故事。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "仔細看看她有多麼",
    "voice": "vo_adv_1210001_001",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "思念著你吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不要錯過她們的身影，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好好體會她們的思念。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這是現在的我",
    "voice": "vo_adv_1210001_002",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "傾盡全力能給你的禮物，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "拜託你了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "某一天，貪吃佩可從幸福的夢中醒來──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "呼嚕呼嚕……",
    "voice": "vo_adv_1210001_003",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "漢堡和壽司……",
    "voice": "vo_adv_1210001_004",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n肉醬直麵和",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "特大份的特製軟泥怪蓋飯……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嗯……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "510124"
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我已經吃不下了～～～！！！！",
    "voice": "vo_adv_1210001_005",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……咦？",
    "voice": "vo_adv_1210001_006",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這裡是……？",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我為什麼會在長椅上……",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "難道",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我還在作夢嗎？",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "咕嚕嚕嚕嚕嚕嚕～～！！",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嗚嗚……",
    "voice": "vo_adv_1210001_007",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這股飢餓是真實的……",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我好像不是在作夢……",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是說仔細想想，",
    "voice": "vo_adv_1210001_008",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我昨天應該是睡在王宮中的寢室。",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n吃過宵夜後，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我刷了牙",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "就鑽進棉被裡……",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊！",
    "voice": "vo_adv_1210001_009",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我是在睡覺時被綁架了嗎！？",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "老人1",
    "words": "我說老爺爺，",
    "voice": "vo_adv_1210001_010",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老人1",
    "words": "今天的天氣也很不錯啊～",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老人2",
    "words": "就是說啊～",
    "voice": "vo_adv_1210001_011",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老人2",
    "words": "\\n好，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老人2",
    "words": "就再",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老人2",
    "words": "散步一會兒吧～",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嗯……",
    "voice": "vo_adv_1210001_012",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但以綁架案來說，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "總覺得好和平啊……",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "哇～！",
    "voice": "vo_adv_1210001_013",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "等我等我──！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "嗚哇～！",
    "voice": "vo_adv_1210001_014",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "不要過來──！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "說到底，",
    "voice": "vo_adv_1210001_015",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這裡",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是蘭德索爾嗎……？",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這些建築物和附近的人們身上的衣服……",
    "voice": "vo_adv_1210001_016",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我好像有在哪裡看過……",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "對",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "了！",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "still",
    "still_id": "201201401"
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "在愛梅斯大人帶領我們",
    "voice": "vo_adv_1210001_017",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "進入的小凱留心裡，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n就是這樣的風景……",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我記得",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是叫「現實世界」吧……？",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那時候",
    "voice": "vo_adv_1210001_018",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小可蘿跟{0}也一起來了，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但現在我身旁沒有其他人……",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "background",
    "bg_id": "510124"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "也就是說，",
    "voice": "vo_adv_1210001_019",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這並不是愛梅斯大人帶領我",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "進入的某個人的內心嗎……？",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "在不認識的地方，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "就只有我自己一個人……",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嗯～",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "該怎麼辦呢……",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……不過，",
    "voice": "vo_adv_1210001_020",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "坐在這裡思考",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "也不是辦法啊。",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "為了找出回到蘭德索爾的線索，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "就來四處走走吧～！",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "background",
    "bg_id": "510350"
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "哇哇！？",
    "voice": "vo_adv_1210001_021",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "駕駛員",
    "words": "這個笨蛋！",
    "voice": "vo_adv_1210001_022",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "駕駛員",
    "words": "走路要看路啊！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "駕駛員",
    "words": "\\n現在",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "駕駛員",
    "words": "是紅燈耶！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "對、",
    "voice": "vo_adv_1210001_023",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "對不起～～！！",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "唉……",
    "voice": "vo_adv_1210001_024",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "剛才的交通工具",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是什麼啊……？",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n既不是馬車，也不是古代兵器……",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我沒在蘭德索爾看過那個耶。",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "它行駛的速度非常驚人，",
    "voice": "vo_adv_1210001_025",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "如果撞上去，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那可就不好了。",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不過，",
    "voice": "vo_adv_1210001_026",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "撞上去的衝擊說不定能讓我飛到蘭德索爾……",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我說說的，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "天底下哪有這麼剛好的事情。",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊哈哈……",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "唉～",
    "voice": "vo_adv_1210001_027",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這裡果然",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "和蘭德索爾完全不一樣啊……",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我的衣服和平常不同，",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "身上也沒有皇家裝備。",
    "voice": null,
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這個世界有一堆我不懂的事情，",
    "voice": "vo_adv_1210001_028",
    "unit_id": 105831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
