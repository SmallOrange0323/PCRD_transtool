    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]為什麼你總是、",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]總是被美女包圍著啊！",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n[FFFFFFFF]有什麼內情！",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]到底是有什麼內情啊～！！",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]",
    "voice": "vo_adv_6124401_001",
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]你說總是順勢就變成這樣！？",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n[FFFFFFFF]以統計數據來說太奇怪了！",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]這世界上可是男女各半喔！",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n[FFFFFFFF]把你的運氣給我啊小伙子～～～！！",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]",
    "voice": "vo_adv_6124401_002",
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]原來如此，",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]你就是這樣裝成人畜無害的樣子去拐騙人家啊！",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n[FFFFFFFF]真是個超乎想像的好色之徒！",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n[FFFFFFFF]給我去死吧小伙子～～～！！",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]咦……",
    "voice": "vo_adv_6124401_003",
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]也、",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]也想跟我……？",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n[FFFFFFFF]你雖然",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]看起來像好色之徒，",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]但其實就只是個天真無邪的好人啊……",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n",
    "voice": null,
    "unit_id": 2415
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "[FFFFFFFF]你以為我會這樣說嗎小伙子～～～！！",
    "voice": null,
    "unit_id": 2415
  }
]
