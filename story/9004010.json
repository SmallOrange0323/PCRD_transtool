    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "不過這樣一來，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "婆婆的店就會生意興隆，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "所以我們覺得很開心！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "喔～呵呵呵！",
    "voice": "vo_adv_9004010_004",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n這裡就是優花梨和咲戀",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "推薦的點心店嗎？",
