    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "是呀。",
    "voice": "vo_adv_9004010_005",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "只不過說要來買這間店的點心，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n我們家的孩子們就會興奮不已，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "這間店就是這麼地廣受好評哦。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "這裡有賣就算每天吃也不會吃膩的",
    "voice": "vo_adv_9004010_006",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n美味蛋糕唷！",
    "voice": null,
    "unit_id": 102311
