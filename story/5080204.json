    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "畢竟以它的立場來看，",
    "voice": "vo_adv_5080204_001",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n我們就跟搶了它的食物沒兩樣。",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "怨恨與怨恨間的衝突……",
    "voice": "vo_adv_5080204_002",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "得早點中止這種聖誕節才行。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子要擊潰你──！",
    "voice": "vo_adv_5080204_003",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "哇哇，",
    "voice": "vo_adv_5080204_004",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "請等一下！",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我們和平一點！",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
