  {
    "type": "dialogue",
    "name": "旁白",
    "words": "明天就是聖誕節了，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n貪吃佩可來到蘭德索爾的一間雜貨店選購禮物。",
