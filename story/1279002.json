    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不愧是現在蘭德索爾最受歡迎的店，",
