  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "已經有30場了……",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我們和小棉花糖玩",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "夠多了。",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "將軍，",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "多虧有你助我們一臂之力，",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "實在感激涕零，",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "萬分感謝",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "是也！",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "和牠盡情玩過才知道，",
    "voice": "vo_adv_5076425_001",
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "雖然變得那麼大隻，",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n小棉花糖",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "果然還是",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "小棉花糖！",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "嗯！",
    "voice": "vo_adv_5076425_002",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "小棉花糖是地獄犬……",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n擁有吞食這世界的能力～",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "既然牠那麼厲害，",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "應該可以輕鬆地打倒我們吧～？",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "可是，",
    "voice": "vo_adv_5076425_003",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "小棉花糖並沒有這麼做～！",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "牠還是",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "那個最喜歡點心和玩耍的",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "溫柔小棉花糖～♪",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "話雖如此，",
    "voice": "vo_adv_5076425_004",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "要是放任橫衝直撞的小棉花糖不管，",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n肯定會造成危害吧～？",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "所以，各位，",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我們還得繼續陪小棉花糖玩耍喔──！",
    "voice": null,
    "unit_id": 117711
  }
]
