  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "……！",
    "voice": "vo_adv_9500045_000",
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "吉格魯特，",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "那句話……",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n我可以當成你堅定的心意嗎？",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n就等同於，",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "要和我這個疾風之冥姬締結永恆的契約……",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "不過，",
    "voice": "vo_adv_9500045_001",
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我是被輪迴之鎖囚禁的",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "暗黑騎士……",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "若要與我同行，",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "你也將",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "背負殘酷的命運──",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "這樣啊……",
    "voice": "vo_adv_9500045_002",
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "仔細想想，",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "吉格魯特早就接受了我的話語……",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n接受了我那近乎",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "愛之告白的吶喊。",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "看來我不必",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "再次確認你的覺悟了呢。",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我們是靈魂伴侶……",
    "voice": "vo_adv_9500045_003",
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n像這樣交換誓言，",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "也可以說是命中注定吧。",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "但即便如此，",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我還是想跟你說，",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "謝謝",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "你……",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "終於找回",
    "voice": "vo_adv_9500045_004",
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "與我長久分離的半身……",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "這就是我的心情。",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n我們",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "再也不會分開。",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我們約定好，",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "要一起度過未來的每一天……",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "……嗯？",
    "voice": "vo_adv_9500045_005",
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "啊啊，",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "對喔。",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "接下來是……",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "……咦，",
    "voice": "vo_adv_9500045_006",
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "奇怪？",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "接、",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "接下來是……",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "要做什麼才好？",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "熱烈地擁抱彼此，",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "還是",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "互許終身的親吻……？",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "還是說，該不會",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "是更進一步的……？",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "不，",
    "voice": "vo_adv_9500045_007",
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "但、",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "但是……",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我還沒做好心理準備！",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "糟糕了，",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "就連冥風戰記也沒有寫到這種地步，",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n我也沒有設想過……！",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我、",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我我我我我該怎麼辦……",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "啊……",
    "voice": "vo_adv_9500045_008",
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "說、",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "說的也是！！",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "仇敵",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "幻境龍后……",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "若不消滅那傢伙，",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "這個世界就沒有明天了！",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我絕對沒有因為太過開心，",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "一時忘了這件事喔！！",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "走吧，",
    "voice": "vo_adv_9500045_009",
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "閃光的吉格魯特！",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "讓我們在冥風戰記中",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "刻下新的歷史吧！",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我的心中",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "已經沒有一絲迷惘！",
    "voice": null,
    "unit_id": 100941
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "哈哈哈哈！！！",
    "voice": null,
    "unit_id": 100941
  }
]
