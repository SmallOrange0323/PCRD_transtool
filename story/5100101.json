  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "欸欸，",
    "voice": "vo_adv_5100101_000",
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "哥哥，",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "和我們一起去旅行吧♪",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「唔呃，",
    "voice": "vo_adv_5100101_001",
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "綾音！",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "喂喂，妳這樣太突然了吧！？」",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "咱們",
    "voice": "vo_adv_5100101_002",
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "決定要去一個",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "很遠的地方旅行喔。",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "以小時候聽到的一個故事作為依據，",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "到遙遠的地方去旅行。",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n由於地圖上也沒有記載，",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "也不曉得",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "能否真的",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "成功抵達目的地……",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "或許路上會有危險的魔物在呢。",
    "voice": "vo_adv_5100101_003",
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "又或者是，",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "猛獸……？",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生，",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "請您來陪咱們一起旅行吧。",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n畢竟有備無患，",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "可得確實做好萬全準備才行哪！",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "嗯嗯♪",
    "voice": "vo_adv_5100101_004",
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n便當、伴手禮，",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "還有點心！",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n旅行該帶的物品全都完美準備好囉！",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「聽好了，綾音，先冷靜一下。",
    "voice": "vo_adv_5100101_005",
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "妳是要去旅行！",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n不是去野餐啊！」",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "這個我知道啦！",
    "voice": "vo_adv_5100101_006",
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "可是，",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "噗吉你自己不是也一副滿心期待的樣子嗎！",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「確實是這樣沒錯",
    "voice": "vo_adv_5100101_007",
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "啦……」",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "好擔心呀。",
    "voice": "vo_adv_5100101_008",
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "不曉得能否成功抵達目的地？",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "綾音小姐、",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "噗吉先生。",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "還有……",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生。",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "人家，",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "會盡全力加油的！",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "啊！",
    "voice": "vo_adv_5100101_009",
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "吶吶，",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "目的地是在",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "哪個方向啊！？",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "怎麼辦，",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "該不會馬上就迷路了吧！？",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「關於這個，",
    "voice": "vo_adv_5100101_010",
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "就包在我身上吧！」",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "真步＆綾音",
    "words": "下回，",
    "voice": "vo_adv_5100101_011",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真步＆綾音",
    "words": "\\n「真步真步的神奇旅程！　",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
