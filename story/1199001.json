  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "爸爸！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "剛剛幽靈說了，",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "\\n她在床上放了什麼東西對吧！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "我",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "去看一下！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "background",
    "bg_id": "500952"
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "啊──！！",
    "voice": "vo_adv_1199001_078",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "這個玩偶！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "\\n",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "是我一～直很想要的玩偶！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "\\n",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "好棒、",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "好棒喔～！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "剛才那個聲音，",
    "voice": "vo_adv_1199001_079",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "\\n原來不是幽靈，",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "而是喜歡布丁的聖誕老人啊！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "嘿嘿嘿……♪",
    "voice": "vo_adv_1199001_080",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "謝謝妳，",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "聖誕老人！",
