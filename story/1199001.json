    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "\\n說有個奇怪的聖誕老人，",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "\\n",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "只要給她布丁，就能收到禮物！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "後來，便有提供布丁才能拿到禮物的布丁聖誕老人，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n成為了都市傳說，在蘭德索爾廣為流傳，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n孩子們為了禮物，到處去搶購布丁。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在那之後，蘭德索爾每年到聖誕季的時候，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n布丁經常會賣得精光，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n使得宮子相當痛苦……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "但這又是另一個故事了。",
    "voice": null,
    "unit_id": null
  }
]
