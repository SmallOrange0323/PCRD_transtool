[
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "……終於來了嗎。",
    "voice": "vo_adv_9006719_000",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "索爾龍",
    "words": "「「「──嘎喔喔喔喔喔！！！」」」",
    "voice": null,
    "unit_id": 20411
  },
  {
    "type": "dialogue",
    "name": "小飯糰",
    "words": "嗶咕！？",
    "voice": "vo_adv_9006719_001",
    "unit_id": 9611
  },
  {
    "type": "dialogue",
    "name": "小飯糰",
    "words": "\\n",
    "voice": null,
    "unit_id": 9611
  },
  {
    "type": "dialogue",
    "name": "小飯糰",
    "words": "……嗶、",
    "voice": null,
    "unit_id": 9611
  },
  {
    "type": "dialogue",
    "name": "小飯糰",
    "words": "嗶咕……",
    "voice": null,
    "unit_id": 9611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "飯糰先生，",
    "voice": "vo_adv_9006719_002",
    "unit_id": 139512
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "謝謝你帶我們到這裡……！",
    "voice": null,
    "unit_id": 139512
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 139512
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "剩下的就交給我們，",
    "voice": null,
    "unit_id": 139512
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "請你先回去吧……！",
    "voice": null,
    "unit_id": 139512
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "小樂。",
    "voice": "vo_adv_9006719_003",
    "unit_id": 139712
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n再見囉。",
    "voice": null,
    "unit_id": 139712
  },
  {
    "type": "dialogue",
    "name": "小樂",
    "words": "噗……！",
    "voice": "vo_adv_9006719_004",
    "unit_id": 9514
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "立足點",
    "voice": "vo_adv_9006719_005",
    "unit_id": 137612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就由在下來準備。",
    "voice": null,
    "unit_id": 137612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n各位，",
    "voice": null,
    "unit_id": 137612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請盡情地戰鬥吧！",
    "voice": null,
    "unit_id": 137612
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "謝謝妳，",
    "voice": "vo_adv_9006719_006",
    "unit_id": 128911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "可可蘿！",
    "voice": null,
    "unit_id": 128911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 128911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "但、",
    "voice": null,
    "unit_id": 128911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "但是……",
    "voice": null,
    "unit_id": 128911
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "像這樣靠近看，",
    "voice": "vo_adv_9006719_007",
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "真的好巨大啊……！",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "不管是龍，",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "還是幻境龍后……！",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是啊。",
    "voice": "vo_adv_9006719_008",
    "unit_id": 128811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n這不僅僅是單純的巨大，",
    "voice": null,
    "unit_id": 128811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "還真是驚人的壓迫感……！",
    "voice": null,
    "unit_id": 128811
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "在你們抵達這裡之前，",
    "voice": "vo_adv_9006719_009",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n我又餵了更多的　[rub:資源]飼料[/rub]　給牠呢。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n看來，芙蕾雅她們的奮戰，",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "也不算白費了。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "但是──",
    "voice": "vo_adv_9006719_010",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我絕不會再讓妳",
    "voice": "vo_adv_9006719_011",
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "奪走這個世界的資源了。",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n幻境龍后。",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "哦，",
    "voice": "vo_adv_9006719_012",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "還真是可怕呢。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "迷宮女王。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n要是妳能在立方體裡，",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "永遠沉睡下去就好了。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "首先，",
    "voice": "vo_adv_9006719_013",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "為了擊敗妳。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n看來只能動用這邊的資源，",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "正面迎擊了呢。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "啊哈哈。",
    "voice": "vo_adv_9006719_014",
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "雖然論資源的儲備量，",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我似乎贏不過肚子吃得那麼飽的妳。",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "不過，",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "妳是不是搞錯了什麼？",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "不是",
    "voice": "vo_adv_9006719_015",
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "「妳」──",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "而是",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "「你們」。",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n在這裡的少年，",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "以及夥伴們之間的羈絆，",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n肯定比七冠之類的，",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "還要可怕得多喔。",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "當然是對妳而言啦。",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "是啊，",
    "voice": "vo_adv_9006719_016",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "確實是。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n可怕到讓我不禁顫抖。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n明明聚集在這裡的勢力，",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "僅僅只是地球人的億分之一而已。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "[rub:・]現[/rub][rub:・]在[/rub][rub:・]的[/rub][rub:・]我[/rub]，",
    "voice": "vo_adv_9006719_017",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "[rub:・]明[/rub][rub:・]明[/rub][rub:・]只[/rub][rub:・]需[/rub][rub:・]一[/rub][rub:・]人[/rub][rub:・]一[/rub][rub:・]龍[/rub]",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "[rub:・]就[/rub][rub:・]足[/rub][rub:・]以[/rub][rub:・]壓[/rub][rub:・]倒[/rub][rub:・]所[/rub][rub:・]有[/rub][rub:・]的[/rub][rub:・]地[/rub][rub:・]球[/rub][rub:・]人[/rub]。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "[rub:・]即[/rub][rub:・]便[/rub][rub:・]如[/rub][rub:・]此[/rub][rub:・]，[/rub][rub:・]居[/rub][rub:・]然[/rub][rub:・]聚[/rub][rub:・]集[/rub][rub:・]了[/rub][rub:・]這[/rub][rub:・]麼[/rub][rub:・]多[/rub]，",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "[rub:・]擁[/rub][rub:・]有[/rub][rub:・]勇[/rub][rub:・]氣[/rub][rub:・]向[/rub][rub:・]我[/rub][rub:・]挑[/rub][rub:・]戰[/rub][rub:・]的[/rub][rub:・]人[/rub]。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "我也一樣。",
    "voice": "vo_adv_9006719_018",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n必須鼓起所有勇氣，不過──",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "索爾龍",
    "words": "「「「──嘎喔喔喔喔喔！！！」」」",
    "voice": null,
    "unit_id": 20411
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "你是想保護我吧，",
    "voice": "vo_adv_9006719_019",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "索爾龍。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "我真的很高興。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "那麼，",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "我就恭敬不如從命了。",
    "voice": null,
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這裡就是",
    "voice": "vo_adv_9006719_020",
    "unit_id": 138312
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "決勝時刻了！",
    "voice": null,
    "unit_id": 138312
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n為了守護美味的料理，",
    "voice": null,
    "unit_id": 138312
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "守護大家的餐桌──",
    "voice": null,
    "unit_id": 138312
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n讓我們齊心協力",
    "voice": null,
    "unit_id": 138312
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "戰鬥到最後吧！",
    "voice": null,
    "unit_id": 138312
  }
]
