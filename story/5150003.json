[
  {
    "type": "background",
    "bg_id": "500390"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "涅比亞在蘭德索爾的城鎮中到處逃竄。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n除了有愛梅斯、帆稀、{0}在追趕著她外，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n再加上──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "居民１",
    "words": "喂，",
    "voice": "vo_adv_5150003_000",
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "居民１",
    "words": "妳聽說了嗎！？",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "居民１",
    "words": "\\n有小妖精在城鎮裡到處飛耶！",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "居民２",
    "words": "不是說抓到她的話，",
    "voice": "vo_adv_5150003_001",
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "居民２",
    "words": "王宮會賜予獎賞嗎？",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "居民２",
    "words": "\\n聽說是",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "居民２",
    "words": "「招待享用王宮晚餐☆」哦！",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "我",
    "voice": "vo_adv_5150003_002",
    "unit_id": 5312
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "剛才有看到妖精哦～！",
    "voice": null,
    "unit_id": 5312
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "好～",
    "voice": "vo_adv_5150003_003",
    "unit_id": 5412
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "我們這就呼朋引伴一起去抓她吧！",
    "voice": null,
    "unit_id": 5412
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "\\n得先準備好",
    "voice": null,
    "unit_id": 5412
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "捕蟲網才行！",
    "voice": null,
    "unit_id": 5412
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "呵呵，",
    "voice": "vo_adv_5150003_004",
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "變得好像是在舉辦團體活動呢～",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "受不了……",
    "voice": "vo_adv_5150003_005",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "貪吃佩可竟然把騷動鬧得更大。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這樣不是舉國都在慶祝狂歡嗎？",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "王宮晚餐啊～",
    "voice": "vo_adv_5150003_006",
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "真是有貪吃佩可的作風，",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "又聰明的好方法呢。",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "這樣子不光是公會，",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "又能請城鎮居民他們幫忙，",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n況且",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "還能讓這個狀況變得很有趣～",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "能增加人手，我非常歡迎。",
    "voice": "vo_adv_5150003_007",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "畢竟可以減少涅比亞逃脫的退路。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不過，",
    "voice": "vo_adv_5150003_008",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "要抓住她的可是我們哦。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n不能搶在任何人前面先唸她個幾句",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "就讓我無法氣消啊！",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "愛梅斯，",
    "voice": "vo_adv_5150003_009",
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "原來妳也會那樣子發飆啊～♪",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "咦？",
    "voice": "vo_adv_5150003_010",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "啊……",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "讓妳見笑了。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我不小心就",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "情緒化起來了……",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我覺得表現出情緒起伏比較好哦～♪",
    "voice": "vo_adv_5150003_011",
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "對吧，",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "你也是這麼認為的吧～？",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "哦，",
    "voice": "vo_adv_5150003_012",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "是這樣嗎？",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "……不過，",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "事到如今我也沒辦法改變已經扭曲的個性了。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "假如你硬是想看的話，",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "下次我就在夢中",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "只讓你一個人看吧。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "好心機哦～",
    "voice": "vo_adv_5150003_013",
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "說得我好像平時很聒噪一樣呢。",
    "voice": "vo_adv_5150003_014",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "該不會",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你還隱約記得",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我在夢裡對你嘮叨的模樣？",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "……我就多加注意一下吧。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這不重要，",
    "voice": "vo_adv_5150003_015",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "現在要緊的是涅比亞啊。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n我們得快點抓到她才行。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "帆稀，",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那孩子現在在哪裡？",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我看看哦～",
    "voice": "vo_adv_5150003_016",
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "她人在鬧區。",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n不過，",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "竟然會在這麼空曠的地方……",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n奇怪？",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "而且只有這裡景觀沒改變耶～",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這很明顯是在引誘我們。",
    "voice": "vo_adv_5150003_017",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "她肯定弄了一堆惡作劇，",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "準備就緒了吧。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "畢竟靠龍眼沒辦法連她設了什麼機關也看清啊～",
    "voice": "vo_adv_5150003_018",
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n啊，",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "她笑得好開心哦。",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n看來她也知道我們在看她呢～",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "看來她對自己的惡作劇很有信心吧。",
    "voice": "vo_adv_5150003_019",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "如果單純這樣和她玩起你追我跑，",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n也只是飛蛾撲火，",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "落入她設計好的惡作劇之中嗎……",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "……既然如此。",
    "voice": "vo_adv_5150003_020",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "妳要用什麼方法呢？",
    "voice": "vo_adv_5150003_021",
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "帆稀──",
    "voice": "vo_adv_5150003_022",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我想請妳去找一個人。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "找到了！",
    "voice": "vo_adv_5150003_023",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n這次妳休想逃，",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "涅比亞！",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "菲歐，妳可終於來了啊。",
    "voice": "vo_adv_5150003_024",
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n妳讓我等太久啦。",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "害我無聊到設了一堆機關♪",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "就照事前討論的，",
    "voice": "vo_adv_5150003_025",
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我們三個一口氣上～！",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好的！",
    "voice": "vo_adv_5150003_026",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "哼哼！",
    "voice": "vo_adv_5150003_027",
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "這就是所謂的",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "夏日妖精撲火！",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "這裡就用亂流──",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "──嘿",
    "voice": "vo_adv_5150003_028",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "咻。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "真的猜中了呢。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "什麼？",
    "voice": "vo_adv_5150003_029",
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n避開亂流了！？",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "還沒結束呢！",
