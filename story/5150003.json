  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "……菲歐……！",
    "voice": "vo_adv_5150003_037",
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n這是怎麼回事？",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "簡直就像是能看透我在想什麼一樣！",
