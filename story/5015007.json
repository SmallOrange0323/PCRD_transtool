    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "喂、",
    "voice": "vo_adv_5015007_036",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "喂，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "你會不會加油添醋的太過火了！？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我最初的一擊被擋下了啊，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "而且",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "小試身手時天空驟裂，閃光一現什麼的，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n我到底什麼時候能夠放出閃光了啊！？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "鎮長",
    "words": "身著有如天女羽衣般",
    "voice": "vo_adv_5015007_037",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "鎮長",
    "words": "美麗衣裳的空花大人……",
