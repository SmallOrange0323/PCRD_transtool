    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "鎮長",
    "words": "\\n其他還有",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "鎮長",
    "words": "讚頌將軍一行人",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "鎮長",
    "words": "活躍表現的英雄奇談，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "鎮長",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "鎮長",
    "words": "就讓我來說給大家聽！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "咦，",
    "voice": "vo_adv_5015007_032",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "英雄奇談！？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n還有那種東西嗎！？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "鎮長",
    "words": "那麼，",
    "voice": "vo_adv_5015007_033",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "鎮長",
    "words": "就從事件的起源開始。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "鎮長",
    "words": "\\n在平日壞事做盡的",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "鎮長",
    "words": "惡代官面前，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "鎮長",
    "words": "\\n將軍大人英勇的出現。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "從、",
    "voice": "vo_adv_5015007_034",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "從一開始感覺就不太一樣……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "鎮長",
    "words": "將軍大人帶領著一群",
    "voice": "vo_adv_5015007_035",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "鎮長",
    "words": "毫不遜色於他的英雄們。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "鎮長",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "鎮長",
    "words": "一開始，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "鎮長",
    "words": "在惡代官和莫妮卡大人小試身手時，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "鎮長",
    "words": "天空驟裂，閃光一現――",
