    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "話說，",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "把我那副模樣放到英雄奇談裡實在太丟臉了，",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n拜託別說了……",
