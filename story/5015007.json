[
  {
    "type": "background",
    "bg_id": "500040"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "打倒了惡代官後，\\n大家在公會小屋渡過了和平常一樣的時光，\\n此時【純白之翼 蘭德索爾分部】收到了一封信。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "各位，",
    "voice": "vo_adv_5015007_000",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這封信上的內容，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "是大江戶町給我們的邀請函。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n因為想要再次向各位道謝，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "希望各位務必再來遊玩。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "是邀請函嗎！？",
    "voice": "vo_adv_5015007_001",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n那就是說，",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我們還能",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "再去大江戶町囉！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "嗯，",
    "voice": "vo_adv_5015007_002",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "事情就是這樣呢。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "原來如此，",
    "voice": "vo_adv_5015007_003",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "他們想要看到美麗的我，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "還送了邀請函來啊。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n才一下子",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我竟然就奪走了城鎮上居民的心，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我偶爾也會",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "對自己的美貌感到害怕呢……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "不，",
    "voice": "vo_adv_5015007_004",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我想不是那樣的……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "打倒惡代官之後，",
    "voice": "vo_adv_5015007_005",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n大江戶町",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "變成怎樣了呢。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "關於那個，",
    "voice": "vo_adv_5015007_006",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這張邀請函上寫了。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n惡代官死後，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "與它共謀的王宮成員也遭逮捕，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n從那之後",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "城鎮好像就恢復了原本的和平。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "不需要繳交上納金給惡代官後，",
    "voice": "vo_adv_5015007_007",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "也不會有像之前那樣的強行推銷了吧。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "既然如此，",
    "voice": "vo_adv_5015007_008",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我們就去看看吧！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "應該已經恢復成",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "原本開心的大江戶町了！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我開玩笑的……",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "――也是，",
    "voice": "vo_adv_5015007_009",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "不如就玩個過癮吧。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "咦……！？",
    "voice": "vo_adv_5015007_010",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "可、",
    "voice": "vo_adv_5015007_011",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "可以嗎……！？",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我、",
    "voice": "vo_adv_5015007_012",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我只是",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "抱著輕鬆的心情\\n想說看看而已，",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "沒想到竟然OK……",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "那個……",
    "voice": "vo_adv_5015007_013",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "莫妮卡，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "妳該不會是",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "吃了剛才\\n我買的鯛魚燒",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "吃太飽了，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n然後有點",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "呆滯了吧……？",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "你、",
    "voice": "vo_adv_5015007_014",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "你們那是什麼反應啊！？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我說了什麼很奇怪的話嗎？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "那是……",
    "voice": "vo_adv_5015007_015",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "嗯，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "是沒錯啦。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……那樣說",
    "voice": "vo_adv_5015007_016",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "好像我平常都很不溫柔一樣。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "今次的事件",
    "voice": "vo_adv_5015007_017",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "大家真的都辛苦了呢。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "偶爾",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這樣也不錯吧。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "而且那個……",
    "voice": "vo_adv_5015007_018",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這次的事件",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n感覺讓夥伴之間的羈絆更堅固了呢……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我、",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我也",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "感到很開心……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "莫妮卡……",
    "voice": "vo_adv_5015007_019",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "好、",
    "voice": "vo_adv_5015007_020",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "好了，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "就別說這些了！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "比起那個，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我們前往大江戶町吧！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "background",
    "bg_id": "500651"
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "每、",
    "voice": "vo_adv_5015007_021",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "每次來都覺得街上好美……",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n真的是很棒的地方呢。",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "鎮民1",
    "words": "喂！",
    "voice": "vo_adv_5015007_022",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鎮民1",
    "words": "\\n看那個！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鎮民2",
    "words": "那些人該不會……！！",
    "voice": "vo_adv_5015007_023",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "怎、",
    "voice": "vo_adv_5015007_024",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "怎麼回事啊？",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "民眾的目光",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "好像都集中在這裡……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "竟然這樣子盯著我看，",
    "voice": "vo_adv_5015007_025",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n果然我的美貌",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不管在哪裡都會引人注目呢……！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "鎮長",
    "words": "歡迎光臨，",
    "voice": "vo_adv_5015007_026",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "鎮長",
    "words": "將軍一行人！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "啊，",
    "voice": "vo_adv_5015007_027",
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "是町長！",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "鎮長",
    "words": "謝謝您接受我的邀請……",
    "voice": "vo_adv_5015007_028",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "鎮長",
    "words": "還有更重要的是",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "鎮長",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "鎮長",
    "words": "謝謝您救了這個町，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "鎮長",
    "words": "真的是太感激您了！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "鎮長",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "鎮長",
    "words": "……事不宜遲，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "鎮長",
    "words": "請您看看這個，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "鎮長",
    "words": "這是我們感激的證明！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "那是……",
    "voice": "vo_adv_5015007_029",
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "將軍的人像！",
    "voice": null,
    "unit_id": 109611
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "真的耶……",
    "voice": "vo_adv_5015007_030",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我有點",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "想要呢……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "鎮長",
    "words": "這是我們感激的證明，",
    "voice": "vo_adv_5015007_031",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "鎮長",
    "words": "特地請專家製作出來的！",
