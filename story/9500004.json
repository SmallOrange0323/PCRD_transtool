[
  {
    "type": "background",
    "bg_id": "509040"
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "{0}……你要選擇我？",
    "voice": "vo_adv_9500004_000",
    "unit_id": 106441
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106441
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "真的嗎？",
    "voice": null,
    "unit_id": 106441
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "……好開心……！　",
    "voice": "vo_adv_9500004_001",
    "unit_id": 106441
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我非常高興，",
    "voice": null,
    "unit_id": 106441
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "真的……",
    "voice": null,
    "unit_id": 106441
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106441
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "高興到都不知道",
    "voice": null,
    "unit_id": 106441
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "該說些什麼了……",
    "voice": null,
    "unit_id": 106441
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106441
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "沒想到，",
    "voice": null,
    "unit_id": 106441
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "居然會像這樣被你選擇。",
    "voice": null,
    "unit_id": 106441
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "感覺真不可思議……",
    "voice": "vo_adv_9500004_002",
    "unit_id": 106441
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106441
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "說到底，",
    "voice": null,
    "unit_id": 106441
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我能夠在這裡，",
    "voice": null,
    "unit_id": 106441
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "本身就是奇蹟般的事情了。",
    "voice": null,
    "unit_id": 106441
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "經歷了消失，",
    "voice": "vo_adv_9500004_003",
    "unit_id": 106441
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "在面臨生死關頭時被你拯救。",
    "voice": null,
    "unit_id": 106441
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106441
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "甚至還能和你一起並肩",
    "voice": null,
    "unit_id": 106441
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "面對一切的元兇。",
    "voice": null,
    "unit_id": 106441
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106441
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "這樣的未來……",
    "voice": null,
    "unit_id": 106441
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我想都沒想過。",
    "voice": null,
    "unit_id": 106441
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "不會。",
    "voice": "vo_adv_9500004_004",
    "unit_id": 106441
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n……因為",
    "voice": null,
    "unit_id": 106441
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "有你在啊。",
    "voice": null,
    "unit_id": 106441
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "做任何重要決定時，",
    "voice": "vo_adv_9500004_005",
    "unit_id": 106441
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "你總是會待在我身邊。",
    "voice": null,
    "unit_id": 106441
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106441
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "所以一定",
    "voice": null,
    "unit_id": 106441
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "沒問題的。",
    "voice": null,
    "unit_id": 106441
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "不會再像之前那樣做出讓人感到悲傷的事，",
    "voice": "vo_adv_9500004_006",
    "unit_id": 106441
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "也不會讓它發生。",
    "voice": null,
    "unit_id": 106441
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n我就是為了這個才變強的。",
    "voice": null,
    "unit_id": 106441
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "……謝謝你，",
    "voice": "vo_adv_9500004_007",
    "unit_id": 106441
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "{0}。",
    "voice": null,
    "unit_id": 106441
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "絕對要帶著所有人，",
    "voice": "vo_adv_9500004_008",
    "unit_id": 106441
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "平安回去。",
    "voice": null,
    "unit_id": 106441
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106441
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "包括我們，",
    "voice": null,
    "unit_id": 106441
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "少了誰都不行。",
    "voice": null,
    "unit_id": 106441
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106441
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "這次要迎接",
    "voice": null,
    "unit_id": 106441
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "最棒的幸福結局！",
    "voice": null,
    "unit_id": 106441
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "還有，",
    "voice": "vo_adv_9500004_009",
    "unit_id": 106441
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "至少要說這句話才行。",
    "voice": null,
    "unit_id": 106441
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "至今如此，",
    "voice": "vo_adv_9500004_010",
    "unit_id": 106441
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "今後亦然──",
    "voice": null,
    "unit_id": 106441
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106441
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我",
    "voice": null,
    "unit_id": 106441
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "最喜歡你了。",
    "voice": null,
    "unit_id": 106441
  }
]
