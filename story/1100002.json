    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "看我這邊――！",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "這樣嗎～？",
    "voice": "vo_adv_1100002_004",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "啊，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "太陽好耀眼～！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "嗯，",
    "voice": "vo_adv_1100002_005",
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "很好很好――！",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "\\n好，",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "就保持這種燦爛笑容！",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "呵呵♪",
    "voice": "vo_adv_1100002_006",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n話說，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "為什麼秀才也跟著一起笑呢～！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n真是有趣～！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "很完美唷，",
    "voice": "vo_adv_1100002_007",
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "鈴奈！",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "\\n謝謝妳！",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "今天的鈴奈，",
    "voice": "vo_adv_1100002_008",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "比平常的狀態更好呢。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n果然",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "因為男朋友在旁邊看的關係嗎♪",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n男朋友",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "看到鈴奈的拍攝覺得如何？",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "等等，",
    "voice": "vo_adv_1100002_009",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "那是什麼～！　",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "普通會說很可愛之類的吧～？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "咦？　",
    "voice": "vo_adv_1100002_010",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "因為我很認真所以讓人覺得很酷？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "哎呀，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "不要這樣誇獎我啦――",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家會害羞――！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "那是什麼，",
    "voice": "vo_adv_1100002_011",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "好過分～",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n應該還有其他該說的評語吧～？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "咦？　",
    "voice": "vo_adv_1100002_012",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "因為我平常就很酷嗎？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "哎呀～",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家會害羞別這麼說～！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "還有！",
    "voice": "vo_adv_1100002_013",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n秀才才不是我的男朋友啦～！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "好的好的，",
    "voice": "vo_adv_1100002_014",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "我明白的沒問題啦。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n快點，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "專心拍照吧～！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "討厭～",
    "voice": "vo_adv_1100002_015",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "不要逗人家啦～！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "啊哈哈哈。",
    "voice": "vo_adv_1100002_016",
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "\\n很好有拍到鈴奈自然的樣子！",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "\\n",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "接下來換成帥氣的表情，",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "好嗎？",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "background",
    "bg_id": "500160"
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "帥氣？",
    "voice": "vo_adv_1100002_017",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "沒錯。",
    "voice": "vo_adv_1100002_018",
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "\\n感覺好像等下要跟魔物戰鬥的表情！　",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "麻煩妳了！",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "跟魔物戰鬥的感覺嗎……？",
    "voice": "vo_adv_1100002_019",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "現場沒有魔物的話感覺有點難呢～",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "咦？　",
    "voice": "vo_adv_1100002_020",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "你說交給你？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n秀才要做什麼？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才，",
    "voice": "vo_adv_1100002_021",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "你好適合穿魔物裝唷！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n超好笑～！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "噢，",
    "voice": "vo_adv_1100002_022",
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "不錯呢――！",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "\\n能不能模仿一下魔物的叫聲呢？",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "哇！　",
    "voice": "vo_adv_1100002_023",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "好像真的一樣！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "你有演魔物的才華呢！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "好像開始有感覺了！",
    "voice": "vo_adv_1100002_024",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "謝謝你，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "那麼，",
    "voice": "vo_adv_1100002_025",
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "保持這樣繼續拍攝唷！",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "好――！",
    "voice": "vo_adv_1100002_026",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "那麼秀才，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "扮演魔物的角色就麻煩你了～♪",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "――吼吼吼吼吼！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "哇啊！　",
    "voice": "vo_adv_1100002_027",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "比起剛剛的模仿，這一次的叫聲更像呢！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "真的太有才了！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "咦？",
    "voice": "vo_adv_1100002_028",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n剛剛的不是秀才嗎……？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "哇啊啊啊啊！！",
    "voice": "vo_adv_1100002_029",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n從海中冒出魔物啦！？",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "――吼吼吼吼吼！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "魔物向他的方向前進！？",
    "voice": "vo_adv_1100002_030",
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "\\n",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "該不會，",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "對剛剛的叫聲有了反應吧！？",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "鈴奈，",
    "voice": "vo_adv_1100002_031",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "不趕快逃的話很危險的！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "不可以放著秀才不管！",
    "voice": "vo_adv_1100002_032",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n秀才！　",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "快來我這裡！！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "咦！？",
    "voice": "vo_adv_1100002_033",
    "unit_id": 110011
  },
  {
