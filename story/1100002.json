    "name": "鈴奈",
    "words": "好――！",
    "voice": "vo_adv_1100002_002",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "那麼人家要過去了，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才也請多指教唷～♪",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "攝影師",
