[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "蘭德索爾的街市道路被年底忙碌的氣氛包圍。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}在其中一處，發現了正在購物的怜。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "要帶去的東西",
    "voice": "vo_adv_1089005_000",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "差不多就這些吧。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n有什麼需要的去那邊也可以買……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "啊啊，",
    "voice": "vo_adv_1089005_001",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是你啊。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是準備要去工作嗎？",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "辛苦了，",
    "voice": "vo_adv_1089005_002",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你還是一樣勤奮呢。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我也是，",
    "voice": "vo_adv_1089005_003",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "昨天結束了",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "公會接取的工作。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n現在正為",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "新年假期",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "做各種準備。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我還有",
    "voice": "vo_adv_1089005_004",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "其他",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "想要買齊",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "的東西。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "難得碰上了，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我們稍微邊走",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "邊聊吧。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "準備迎接新年，",
    "voice": "vo_adv_1089005_005",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "大家都興奮得心情浮躁的這氛圍……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "真不錯呢。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n如祭典前夕般的期待感",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "一直持續著。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "和家人一同悠閒度過，",
    "voice": "vo_adv_1089005_006",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "或是和好友一同出遊。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n大家都會各自度過不同的新年吧。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……",
    "voice": "vo_adv_1089005_007",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那麼，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你年底",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "有什麼計畫嗎？",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n像是要去哪裡，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "或是要和誰一起過。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這樣啊……",
    "voice": "vo_adv_1089005_008",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……其實，",
    "voice": "vo_adv_1089005_009",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我打算",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "暫時到大江戶去過年。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "並非有什麼特別的要事，",
    "voice": "vo_adv_1089005_010",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n偶爾離開蘭德索爾悠然度過",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "應該也不錯，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n就是有這樣的想法罷了。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "而且……",
    "voice": "vo_adv_1089005_011",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "待在蘭德索爾的話，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n無論如何都會受到父親的干涉。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n至少新年假期中，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我希望能忘掉家裡的束縛。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "啊啊，",
    "voice": "vo_adv_1089005_012",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我也不是要抱著消極的心情去的。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "在那邊有各式各樣想嘗試的事，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n旅館也已經預約完成了。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不過，",
    "voice": "vo_adv_1089005_013",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "獨自一人旅行這種經驗",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "也不常有，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n也不能說沒有不安的地方……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那個……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "嗯，",
    "voice": "vo_adv_1089005_014",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我會的。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不，",
    "voice": "vo_adv_1089005_015",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我不是這個意思，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那個……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n雖然我突然說這種話，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "可能會讓你感到困惑……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "啊啊，",
    "voice": "vo_adv_1089005_016",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "謝謝你的關心。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不過",
    "voice": "vo_adv_1089005_017",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不是煩惱，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "其實是有",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "想拜託你的事情，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那個……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "如果可以，",
    "voice": "vo_adv_1089005_018",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你要不要也一起去？",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你想想，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "在大江戶過年聽起來很有趣對吧？",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "啊啊，",
    "voice": "vo_adv_1089005_019",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你會覺得驚訝也很正常。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我也覺得這有點突然。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "當然不會勉強你。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "畢竟提案得很臨時，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你想拒絕也沒關係──",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "可、",
    "voice": "vo_adv_1089005_020",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "可以嗎？",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "太、",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "太好了……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "咳……",
    "voice": "vo_adv_1089005_021",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "看到你這麼興致勃勃，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不枉費我這樣約你了。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "嗯……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "鼓起勇氣來問真是太好了。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我們會搭馬車過去，",
    "voice": "vo_adv_1089005_022",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "當天就在馬車轉運站集合吧。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n你的房間我會向那邊的旅館說一聲，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "麻煩你準備好自己的行李。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那麼，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "再見了。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……可以再次和他一起，",
    "voice": "vo_adv_1089005_023",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "度過新年了，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "嗎……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "呵呵。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "background",
    "bg_id": "500890"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "到了隔天。怜動身前往和{0}約好集合的",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n馬車轉運站。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "事前準備花了點時間，",
    "voice": "vo_adv_1089005_024",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "稍微晚了一些呢。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不過動作快一點的話應該還趕得上……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "怜小姐，",
    "voice": "vo_adv_1089005_025",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "您是要去哪裡呢。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你們是……",
    "voice": "vo_adv_1089005_026",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "父親的僕人啊。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "女追兵",
    "words": "要說前面有什麼的話，",
    "voice": "vo_adv_1089005_027",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女追兵",
    "words": "應該就是要離開王都的馬車轉運站了。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女追兵",
    "words": "\\n難道您在這個時期要去旅行？",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你都明白了，",
    "voice": "vo_adv_1089005_028",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就讓我過去吧。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "恕我辦不到。",
    "voice": "vo_adv_1089005_029",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "\\n",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "怜小姐也需要出席",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "新年舉辦的聚會，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "\\n老爺應該有通知您了。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "聚會的事，",
    "voice": "vo_adv_1089005_030",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我應該已經拒絕過了。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "女追兵",
    "words": "這樣的話，",
    "voice": "vo_adv_1089005_031",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女追兵",
    "words": "您應該也知道老爺沒有准許您不參加吧？",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就算你這麼說，",
    "voice": "vo_adv_1089005_032",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我也有我自己的規劃──",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "如果您期望獲得更多答覆，",
    "voice": "vo_adv_1089005_033",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "請直接向老爺詢問。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "\\n您願意的話，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "現在就能帶您回宅邸。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那可不行。",
    "voice": "vo_adv_1089005_034",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n你能再次替我傳達，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我沒有打算要出席嗎？",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "非常抱歉。",
    "voice": "vo_adv_1089005_035",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "\\n",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "唯獨這次",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "不可容忍您的任性，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "老爺有",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "事先如此囑咐我們了。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "\\n",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "……你們幾個，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "要執行任務了。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "把怜小姐帶回宅邸。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……",
    "voice": "vo_adv_1089005_036",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "原來如此，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是打算強行帶我走嗎。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "有好幾名看來功力不錯的劍士……",
    "voice": "vo_adv_1089005_037",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是父親特別雇來的嗎。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不過，",
    "voice": "vo_adv_1089005_038",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我也無法退讓。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n因為在這前方，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "有他在等待著我……！　",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "既然如此，那我也",
    "voice": "vo_adv_1089005_039",
    "unit_id": 100312
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "要靠武力強行突破！",
    "voice": null,
    "unit_id": 100312
  },
  {
    "type": "background",
    "bg_id": "500890"
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "唔……",
    "voice": "vo_adv_1089005_040",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "好、",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "好快……！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "background",
    "bg_id": "500890"
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "雖然我有收斂，",
    "voice": "vo_adv_1089005_041",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "但你們還是回城鎮治療一下比較好。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "麼，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我走了。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "花了不少時間啊。",
    "voice": "vo_adv_1089005_042",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "得快點過去才行。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n可不能讓他等……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "女追兵",
    "words": "至少",
    "voice": "vo_adv_1089005_043",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女追兵",
    "words": "請告訴我您的目的地……！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女追兵",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女追兵",
    "words": "我需要向老爺報告！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "抱歉。",
    "voice": "vo_adv_1089005_044",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "想要避開父親的干涉，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "也是我的理由之一。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "可惡，",
    "voice": "vo_adv_1089005_045",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "這個人數也無法阻止她嗎……！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "\\n沒想到怜小姐，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男追兵",
    "words": "竟然變得如此強大……",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "…",
    "voice": "vo_adv_1089005_046",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "…當然了。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這就是，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "愛的力量啊。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "background",
    "bg_id": "500020"
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "抱歉，",
    "voice": "vo_adv_1089005_047",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "稍微遲到了。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "馬車還沒出發吧？",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是啊，",
    "voice": "vo_adv_1089005_048",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "但不是需要擔心的事。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n就是處理了一些小事而已。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "車夫",
    "words": "你的同伴，",
    "voice": "vo_adv_1089005_049",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "車夫",
    "words": "已經來了嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "車夫",
    "words": "\\n差不多到出發時間了，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "車夫",
    "words": "要搭的話就快上車吧。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "喔，",
    "voice": "vo_adv_1089005_050",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "時間快到了嗎。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "沒問題，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我們馬上上車。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那麼，",
    "voice": "vo_adv_1089005_051",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我們出發吧。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "愉快的大江戶旅行要開始了！",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "background",
    "bg_id": "500320"
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "還真是久違了呢，",
    "voice": "vo_adv_1089005_052",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "像這樣乘著馬車前往大江戶。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "而且那時候，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "也沒有像這樣和你兩人獨處……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……怎麼回事。",
    "voice": "vo_adv_1089005_053",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "心跳一直在加快，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "無法平靜下來。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是因為剛剛擊退了追兵嗎，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "還是說……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就如同充滿了蘭德索爾的雀躍氣氛一般……",
    "voice": "vo_adv_1089005_054",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我也對於和他的旅行",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "期待得不能自已呢。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "呵呵，",
    "voice": "vo_adv_1089005_055",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你也和我有同樣的想法呢。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那麼這次旅行，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我們兩人",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就盡情享受吧。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "對我來說，",
    "voice": "vo_adv_1089005_056",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這是能夠忘掉家裡束縛的",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "難得機會。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n一直忙於工作的你，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "也能趁這次旅行好好放鬆一番。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不用擔心。",
    "voice": "vo_adv_1089005_057",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n就算遇到了什麼問題，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "只要和你一起就能度過難關。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "此刻我打從心底如此認為。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……老實說，",
    "voice": "vo_adv_1089005_058",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我當時並不確定能順利地擊退他們。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不過，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我能感受到，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "身體比平時要更加輕盈。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "雖然自己這麼說有點不好意思，",
    "voice": "vo_adv_1089005_059",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "但原因",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我想一定是……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "愛的力量、",
    "voice": "vo_adv_1089005_060",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "嗎……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "呵呵。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "啊，",
    "voice": "vo_adv_1089005_061",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "什麼事都沒有。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是我自己的事……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "也不對，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "雖然",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "確實是我們兩人的事，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n但你不需要在意。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "比起那個，",
    "voice": "vo_adv_1089005_062",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我們在抵達之前決定好要做什麼吧。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我可不想浪費了寶貴的時間……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在離開蘭德索爾的馬車中，怜和{0}",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n談笑著討論旅行的規劃……",
