[
  {
    "type": "background",
    "bg_id": "500170"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在日和一行人成立公會「破曉之星」後，\\n他們接下了搬運貨物的委託，朝著精靈之森前進。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "騎士先生，謝謝你今天一起來喔！",
    "voice": "vo_adv_3007002_000",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "嘻嘻……真的謝謝喔！",
    "voice": "vo_adv_3007002_001",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "讓人覺得很放心呢！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "才不是小事呢！",
    "voice": "vo_adv_3007002_002",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "一定會好好的回報恩情，敬請期待喔！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "能接到委託雖然很好，",
    "voice": "vo_adv_3007002_003",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n但這可不是只靠我們就能處理的數量吧。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "真是的，日和太輕易答應了。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "對不起……",
    "voice": "vo_adv_3007002_004",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "可是呀，託日和的福我們的委託才能毫不間斷，",
    "voice": "vo_adv_3007002_005",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我和怜呀，",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n真的很感謝妳呢。",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "優衣……",
    "voice": "vo_adv_3007002_006",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "謝謝～！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "真是的，優衣太寵她了……",
    "voice": "vo_adv_3007002_007",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……請停一下。前面好像有什麼。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "盯……",
    "voice": "vo_adv_3007002_008",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "糟糕了！　有老婆婆倒在那裡！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n得去幫她才行！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "日和等一下！",
    "voice": "vo_adv_3007002_009",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "怜，騎士先生，我們快追上去吧！",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "優衣！",
    "voice": "vo_adv_3007002_010",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……唉唉，就知道會變成這樣。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我們也跟上去吧。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "嗚嗚嗚…",
    "voice": "vo_adv_3007002_011",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "…",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "老婆婆！妳沒事吧?",
    "voice": "vo_adv_3007002_012",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "你、你們是……？",
    "voice": "vo_adv_3007002_013",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我們是因為受人之託而正在運送貨物的途中喔。",
    "voice": "vo_adv_3007002_014",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "老婆婆妳呢？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "我在旅途中跟我的兒子們走散了……",
    "voice": "vo_adv_3007002_015",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n不知道他們能否安全到達精靈之森呢……",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "精靈之森？　和我們的目的地一樣呢！",
    "voice": "vo_adv_3007002_016",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "老婆婆，我們帶妳一起去吧！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "日和。如果這樣下去的話抵達精靈之森的時間會有延遲。",
    "voice": "vo_adv_3007002_017",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "替老婆婆療傷後我們應該和她分道揚鑣才對。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "這孩子說得對呀！",
    "voice": "vo_adv_3007002_018",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n你們也有自己的計劃吧？",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n所以……",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "那樣是不可以的！",
    "voice": "vo_adv_3007002_019",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n見到有困難的人而棄之不管，我辦不到。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "拜託了！　不會造成大家困擾的！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我是沒有關係啦……",
    "voice": "vo_adv_3007002_020",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這裡就交給公會長判斷吧。",
    "voice": "vo_adv_3007002_021",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "會有什麼妖魔鬼怪出現，不前進的話也不曉得啊。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "說的也是。",
    "voice": "vo_adv_3007002_022",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "如果有為人子女的把老婆婆拋棄在這個森林中，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n那傢伙也不會是什麼好東西啊。保持警戒謹慎前進吧。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……今天有很多魔物出沒呢。",
    "voice": "vo_adv_3007002_023",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n明明這條路線不應該有那麼多魔物出沒的……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "怜妳看。那個魔物，會不會是……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "優衣也查覺到了嗎？　",
    "voice": "vo_adv_3007002_024",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那個恐怕是人類披著魔物的皮。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n是野賊們常用的手法。那個老婆婆，感覺很不對勁啊……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "我、我兒子就在那裡！",
    "voice": "vo_adv_3007002_025",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "真的嗎！？ ",
    "voice": "vo_adv_3007002_026",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我去看看狀況！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "――嘠喔喔～！",
    "voice": "vo_adv_3007002_027",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "\\n（到底是怎樣啊媽媽！這群人很強耶！）",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "又有魔物嗎？",
    "voice": "vo_adv_3007002_028",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "不管來多少隻都是一樣喔！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "background",
    "bg_id": "500170"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "――嘠喔～",
    "voice": "vo_adv_3007002_029",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "！\\n（竟然一擊就把我打倒了！！）",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "啊、",
    "voice": "vo_adv_3007002_030",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "啊啊……！",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "真是千鈞一髮呢……",
    "voice": "vo_adv_3007002_031",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "老婆婆，妳沒事吧？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "這、這樣的話……！",
    "voice": "vo_adv_3007002_032",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "糟糕了！　似乎想對日和不利！",
    "voice": "vo_adv_3007002_033",
    "unit_id": 100312
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "日和！　快逃呀！",
    "voice": "vo_adv_3007002_034",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "不要靠近我喔！",
    "voice": "vo_adv_3007002_035",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "老、老婆婆，請冷靜下來！",
    "voice": "vo_adv_3007002_036",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n現在附近沒有魔物了！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "魔物？",
    "words": "――嘠喔喔～！！",
    "voice": "vo_adv_3007002_037",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物？",
    "words": "\\n（上吧你們！）",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物？",
    "words": "――嘠喔喔～！！",
    "voice": "vo_adv_3007002_038",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物？",
    "words": "\\n（這次輪到我們了！）",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "被包圍了嗎……！",
    "voice": "vo_adv_3007002_039",
    "unit_id": 100312
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "騎士先生，我們怎麼辦……！",
    "voice": "vo_adv_3007002_040",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "遵命！　",
    "voice": "vo_adv_3007002_041",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "老婆婆請留在這裡！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "等、等一下！",
    "voice": "vo_adv_3007002_042",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "OK！　",
    "voice": "vo_adv_3007002_043",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "老婆婆妳不用拿什麼武器之類的沒關係！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n請躲在我身後就好！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "啊！",
    "voice": "vo_adv_3007002_044",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "不要拿走我的刀啦！",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "絕不會讓魔物傷害老婆婆的！",
    "voice": "vo_adv_3007002_045",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n衝啊～！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "糟糕！！",
    "voice": "vo_adv_3007002_046",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "日和離開了老婆婆！",
    "voice": "vo_adv_3007002_047",
    "unit_id": 100312
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n先收拾周圍的小卒吧！",
    "voice": null,
    "unit_id": 100312
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "嗯！　",
    "voice": "vo_adv_3007002_048",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我們上吧，騎士先生！",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "魔物？",
    "words": "――嘠喔～",
    "voice": "vo_adv_3007002_049",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物？",
    "words": "！\\n（噫～！！）",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這是最後一匹了！　喝啊！！",
    "voice": "vo_adv_3007002_050",
    "unit_id": 100111
  },
  {
    "type": "background",
    "bg_id": "500170"
  },
  {
    "type": "dialogue",
    "name": "魔物？",
    "words": "――嘠喔～！",
    "voice": "vo_adv_3007002_051",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物？",
    "words": "\\n（哇啊啊！！）",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "很意外地輕鬆解決掉了啊……",
    "voice": "vo_adv_3007002_052",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "嘛，這也是多虧了日和吧。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "即使沒有我們，",
    "voice": "vo_adv_3007002_053",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n也能一個人不斷地打倒魔物呢……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "魔物？",
    "words": "請妳原諒我！饒我一命吧！",
    "voice": "vo_adv_3007002_054",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "魔物居然會說人類的語言！？",
    "voice": "vo_adv_3007002_055",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "可惡！我投降啦！是我們輸了！",
    "voice": "vo_adv_3007002_056",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "老婆婆，妳怎麼了!?",
    "voice": "vo_adv_3007002_057",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我們打敗魔物了喔？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我說日和啊……那個老婆婆，",
    "voice": "vo_adv_3007002_058",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "似乎是與扮成魔物的人一夥，",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n打算欺騙我們的呢。",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "嗯嗯……",
    "voice": "vo_adv_3007002_059",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n……",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "咦咦咦咦咦！？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n是真的嗎！？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "真的嗎真的嗎！？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "如果是開玩笑的話，那個老婆婆不會在這時候向我們投降吧。",
    "voice": "vo_adv_3007002_060",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "居然是這樣……我，被人欺騙了呀……",
    "voice": "vo_adv_3007002_061",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "被騙的只有日和妳喔。我們從一開始",
    "voice": "vo_adv_3007002_062",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n就懷疑了。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……嘛話雖如此，能平安解決也都是多虧日和啊。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我也認為，正因為日和很真誠地相信老婆婆，",
    "voice": "vo_adv_3007002_063",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n所以才能突破所有的埋伏呢。",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "優衣，怜……！",
    "voice": "vo_adv_3007002_064",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "如果真的是這樣就好了……",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "求求妳……我把這個送給妳，請放過我吧！",
    "voice": "vo_adv_3007002_065",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n這是我費盡千辛萬苦才得到的東西……",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "就是這顆寶石喔！",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "欸！我把這個送給妳！",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……這個是！索爾魔珠！　與夢中所見一模一樣……！",
    "voice": "vo_adv_3007002_066",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那這個我們就收下了。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "那麼……",
    "voice": "vo_adv_3007002_067",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "！",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "話雖如此，也不可能就這樣放他們一馬吧？",
    "voice": "vo_adv_3007002_068",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我想這些肯定也是不曉得從誰手上偷來的東西。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "大家分工合作把這些人全員給綁好吧。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "優衣・日和",
    "words": "遵命！",
    "voice": "vo_adv_3007002_069",
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……在自衛團時有聽說過，那群野賊",
    "voice": "vo_adv_3007002_070",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n似乎是在那一帶做盡壞事的集團。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "原來如此……",
    "voice": "vo_adv_3007002_071",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "提起精神吧，日和。",
    "voice": "vo_adv_3007002_072",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……要再吃一個鯛魚燒嗎？",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "要是認為用食物可以讓我打起精神就大錯特錯了喔……？",
    "voice": "vo_adv_3007002_073",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n……那我不客氣了。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "嚼，嚼……",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "嗯～！　好好吃喔～！",
    "voice": "vo_adv_3007002_074",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……咦？　怜妳看。那個袋子，好像在發光？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "真的耶……我都沒注意到。",
    "voice": "vo_adv_3007002_075",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "沒記錯的話這裡頭是那個老婆婆所說的……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "在森林中的時候沒有發光過對吧……？",
    "voice": "vo_adv_3007002_076",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "而且這個光，感覺好像在夢中看過……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是啊……然後當我們把它拿到塔的底下來，",
    "voice": "vo_adv_3007002_077",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n就發出這麼強的光芒……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "也就是說……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這個，是真正的索爾魔珠喔！　好厲害～",
    "voice": "vo_adv_3007002_078",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "噓－！　別大聲嚷嚷！",
    "voice": "vo_adv_3007002_079",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "換言之在這個世界裡，除了這個以外也有其它索爾魔珠存在。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n如果將它們全部拿到手，就能夠登到塔上了！",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "那麼那麼，今後就得去更多的地方冒險，",
    "voice": "vo_adv_3007002_080",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n把所有的索爾魔珠找出來才行呢！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "果然那個夢，真的不只是一個夢……！",
    "voice": "vo_adv_3007002_081",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是啊，一點都沒錯……！",
    "voice": "vo_adv_3007002_082",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "親眼目睹了索爾魔珠光芒的日和、優衣和怜3人，\\n對於在前方等待著的冒險，心中雀躍不已──",
    "voice": null,
    "unit_id": null
  }
]
