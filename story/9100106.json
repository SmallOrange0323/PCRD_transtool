  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "快看，",
    "voice": "vo_adv_9100106_000",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "姐姐！",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "那個",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "是拉菲的弓箭～！",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "它、",
    "voice": "vo_adv_9100106_001",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "它接收了名叫彌勒的壞蛋的力量，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "又失控了啊……！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "得快點去幫助它才行！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "弓箭",
    "words": "──！",
    "voice": null,
    "unit_id": 13811
  },
  {
    "type": "dialogue",
    "name": "兩人",
    "words": "呀啊啊！？",
    "voice": "vo_adv_9100106_002",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "這道光",
    "voice": "vo_adv_9100106_003",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "我有印象……！？",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "這該不會是……",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "兩人",
    "words": "果然",
    "voice": "vo_adv_9100106_004",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "兩人",
    "words": "交換身體了～！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "宮子？",
    "words": "這是……！",
    "voice": "vo_adv_9100106_005",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子？",
    "words": "\\n宮子的",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子？",
    "words": "靈體……？",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子？",
    "words": "\\n靈媒師",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子？",
    "words": "成了靈體……",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "忍？",
    "words": "唔！？",
    "voice": "vo_adv_9100106_006",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍？",
    "words": "這身體沒有尖牙，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍？",
    "words": "妾身不就無法吸血了嗎？",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍？",
    "words": "\\n你啊，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍？",
    "words": "稍微讓妾身試一下！",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "伊莉亞？",
    "words": "不對，",
    "voice": "vo_adv_9100106_007",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞？",
    "words": "等一下！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞？",
    "words": "\\n和那比起來，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞？",
    "words": "應該先讓我變成巨乳才對！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞？",
    "words": "\\n喂！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞？",
    "words": " 現在立刻抱緊我──！！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸？",
    "words": "不可以喲～！",
    "voice": "vo_adv_9100106_008",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸？",
    "words": "和那比起來，重要的是布丁喲！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸？",
    "words": "\\n把布丁交出來～！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "不好了～！",
    "voice": "vo_adv_9100106_009",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "\\n不能像之前一樣，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "靠茜里和姐姐的力量變回來嗎？",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "沒、",
    "voice": "vo_adv_9100106_010",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "沒辦法……！",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n我們現在",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "並沒有接收拉菲的力量……",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "只能直接這樣戰鬥了！",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "大家",
    "voice": "vo_adv_9100106_011",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "冷靜下來！",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "\\n大家或許不習慣目前的身體，",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "變成茜里的依里",
    "words": "但現在也只能這樣戰鬥了！",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "忍？",
    "words": "現在重要的是",
    "voice": "vo_adv_9100106_012",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍？",
    "words": "先讓妾身吸血！",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "伊莉亞？",
    "words": "不對，",
    "voice": "vo_adv_9100106_013",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞？",
    "words": "是巨乳優先才對！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸？",
    "words": "絕對是布丁喲～！！",
    "voice": "vo_adv_9100106_014",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "嗯～",
    "voice": "vo_adv_9100106_015",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "\\n照這情況來看，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "要讓他們冷靜下來",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "變成依里的茜里",
    "words": "好像有點難～？",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "宮子？",
    "words": "真沒辦法……",
    "voice": "vo_adv_9100106_016",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子？",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子？",
    "words": "不好意思，",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子？",
    "words": "請你讓爸爸他們冷靜下來。",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子？",
    "words": "\\n這裡就先靠我們來堅持住……！",
    "voice": null,
    "unit_id": 100711
  }
]
