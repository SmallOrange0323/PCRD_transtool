  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──在蘭德索爾的醫院裡其中一個房間。\\n美冬剛做完健康檢查，在病房中等待著。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "……呼，",
    "voice": "vo_adv_1048010_000",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "換好衣服了。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "果然鎧甲穿起來才讓人安心呢～♪",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "不過話又說回來，",
    "voice": "vo_adv_1048010_001",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "秋乃那傢伙……",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "說什麼",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "「我是不懂妳那究極的效率還是什麼的，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "但妳太亂來了！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n明天去休息一天！」",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "嘛。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "而且",
    "voice": "vo_adv_1048010_002",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我一說我摧毀了強盜集團，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "連珠希和優花梨她們",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n也默默地拿了健康檢查手冊給我。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "真是的，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "大家都太愛操心了啦。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "……算了，",
    "voice": "vo_adv_1048010_003",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "感覺是不差啦。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "反正公會好像也會把這視為有薪假，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n偶爾就悠哉地",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "度過自己的時間吧。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "──沒錯！",
    "voice": "vo_adv_1048010_004",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n來度過這享受家庭代工的時間吧！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "……啊啊～～",
    "voice": "vo_adv_1048010_005",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "感覺真平靜～～♪",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "不但能活動身體，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "還能鍛鍊精神，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "而且居然還會賺到錢……",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "果然",
    "voice": "vo_adv_1048010_006",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "做家庭代工真是太棒了！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n我好想",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "就這樣一直做下去～♪",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "美冬小姐～",
    "voice": "vo_adv_1048010_007",
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "檢查看起來是沒什麼大問題，",
    "voice": null,
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "\\n但是，",
    "voice": null,
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "姑且還是請妳暫時等到",
    "voice": null,
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "所有結果都出來為止。",
    "voice": null,
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "\\n不然，",
    "voice": null,
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "妳也可以在那邊的床上睡覺……",
    "voice": null,
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "咦……",
    "voice": "vo_adv_1048010_008",
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "妳為什麼要穿鎧甲？",
    "voice": null,
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "\\n而、",
    "voice": null,
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "而且還在做家庭代工？",
    "voice": null,
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "咦……",
    "voice": "vo_adv_1048010_009",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這樣很普通吧？",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "不，那個……",
    "voice": "vo_adv_1048010_010",
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "我想可能不太普通。",
    "voice": null,
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "就是",
    "voice": "vo_adv_1048010_011",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "因為我正在靜養，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "才會穿這樣做家庭代工啊。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n想一下就知道了吧？",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "那個……",
    "voice": "vo_adv_1048010_012",
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "我完全不懂妳的意思，",
    "voice": null,
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "\\n可以請妳說明一下嗎？",
    "voice": null,
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "待在醫院裡要好好靜養。",
    "voice": "vo_adv_1048010_013",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n所以",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "不可能讓人穿著鎧甲，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "做需要活動身體的家庭代工。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "妳想說的就是這些吧。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "是、",
    "voice": "vo_adv_1048010_014",
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "是啊。",
    "voice": null,
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "首先",
    "voice": "vo_adv_1048010_015",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "是關於活動身體這部分，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n我要",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "活動雙手才會感到放心。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n所以這樣做",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "對我來說就是休息。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "原、",
    "voice": "vo_adv_1048010_016",
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "原來如此。",
    "voice": null,
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "接著是家庭代工……",
    "voice": "vo_adv_1048010_017",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這是",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n為了",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "替剛才說的活動雙手這項行為",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "賦予一個目的才做的。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "別看我這樣，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我一邊在靜養，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "一邊還有在賺錢喔。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "也不是不能理解……",
    "voice": "vo_adv_1048010_018",
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "吧？",
    "voice": null,
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "並且，",
    "voice": "vo_adv_1048010_019",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "想完美地進行這種家庭代工，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n需要轉換心態……",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "正因如此，我才會",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "穿上鎧甲",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "來做家庭代工啊！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "只有這點我無法理解～～！！",
    "voice": "vo_adv_1048010_020",
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "算、",
    "voice": "vo_adv_1048010_021",
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "算了，",
    "voice": null,
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "我就睜一隻眼閉一隻眼吧。",
    "voice": null,
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "\\n",
    "voice": null,
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "對了，",
    "voice": null,
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "還有事必須通知美冬小姐。",
    "voice": null,
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "唉呀，",
    "voice": "vo_adv_1048010_022",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "是什麼事？",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "剛才櫃台",
    "voice": "vo_adv_1048010_023",
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "來了一個男生說要探訪美冬小姐妳。",
    "voice": null,
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "\\n他說是來看檢查的情況的，",
    "voice": null,
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "\\n所以我想應該很快就會過來了。",
    "voice": null,
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "…………！？",
    "voice": "vo_adv_1048010_024",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "怎、",
    "voice": "vo_adv_1048010_025",
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "怎怎、",
    "voice": null,
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "怎麼了嗎，美冬小姐！？",
    "voice": null,
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "護理師",
    "words": "\\n妳把家庭代工做的人偶給捏碎了耶！",
    "voice": null,
    "unit_id": 412
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "男、",
    "voice": "vo_adv_1048010_026",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "男男、",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "男生……？",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "那個男生……",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "是什麼樣的人……？",
    "voice": null,
