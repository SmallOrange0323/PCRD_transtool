[
  {
    "type": "background",
    "bg_id": "500371"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}被花凜叫了出來，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n造訪了公會管理協會。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "{0}先生，您好。",
    "voice": "vo_adv_1257001_000",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "謝謝您",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "在百忙之中撥冗赴約。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "這次找您的理由嗎？",
    "voice": "vo_adv_1257001_001",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "那當然是",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "有一份希望您務必接下的委託。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "首先，請看這裡。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "是的，",
    "voice": "vo_adv_1257001_002",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "如您所見……",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "這是",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "一份約一百年前的委託書。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "這是我在整理資料保管庫時發現的，",
    "voice": "vo_adv_1257001_003",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n它似乎在尚未解決的情況下被遺忘，",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "經過了一百年的時間。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "更重要的是……",
    "voice": "vo_adv_1257001_004",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "您有察覺到嗎？",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "是的，沒錯！",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "請看這個目的的部分！",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "「希望得到沉眠於瀑潭迷宮的",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "鍊金術秘傳書」──",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "這次會找您來，",
    "voice": "vo_adv_1257001_005",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我就直說了！",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n就是希望您能完成",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "這份委託。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "話雖如此，",
    "voice": "vo_adv_1257001_006",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "原本的委託人已經身分不明，",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n委託本身也在尚未完成的情況下被作廢。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "所以，",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "這是屬於我個人的委託……",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "您願意接下嗎？",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "謝謝您。",
    "voice": "vo_adv_1257001_007",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n我就知道您會這麼說。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "咦？",
    "voice": "vo_adv_1257001_008",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "請、",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "請等一下！",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n難不成……",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "您現在打算獨自一人前往嗎？",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "單獨前往不是很危險嗎？",
    "voice": "vo_adv_1257001_009",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n我認為至少應該帶一名支援者。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "例如……",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "沒錯，",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "熟知鍊金術的人",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "或許是個不錯的人選。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "況且，",
    "voice": "vo_adv_1257001_010",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "您看來也沒有帶上地圖……",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n不先調查瀑潭迷宮的詳細地點沒問題嗎？",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我已經背下地圖，",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "記住全部路線了……",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "不是，",
    "voice": "vo_adv_1257001_011",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我是公會管理協會的人……",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n……什麼？",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "您說，",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "一個人前往果然有難度？",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "自己也不知道路該怎麼走……",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "這樣啊！",
    "voice": "vo_adv_1257001_012",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n如果是這樣的話，",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "那就沒辦法了……",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "呃……",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "您在笑什麼呢？",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "……對不起。",
    "voice": "vo_adv_1257001_013",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "原來您已經看穿了啊。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "其實，",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我也很想去現場看看……",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "很抱歉，",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "讓您費心了。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "那麼，再重來一次……",
    "voice": "vo_adv_1257001_014",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "這次的冒險，",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "請務必",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "讓我同行。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "……可以嗎？",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "謝謝您的許可！",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "那麼，",
    "voice": "vo_adv_1257001_015",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我還有很多準備要做，",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n我們明天在前往現場吧！",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "請記得事先做好準備喔。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "background",
    "bg_id": "501370"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "隔天，{0}和花凜來到了",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n委託書上記載的瀑潭。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我們平安無事地來到附近了呢。",
    "voice": "vo_adv_1257001_016",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "但是，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "這裡開始才是重頭戲！",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我們不要鬆懈，繼續加油吧！",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "是的。",
    "voice": "vo_adv_1257001_017",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我認為需要有關鍊金術的專業知識和技能，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n就穿這身衣服來了。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "您怎麼了嗎？",
    "voice": "vo_adv_1257001_018",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "您在四處東張西望……",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n咦？",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "您說，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "雖然有瀑布，但沒看到迷宮入口。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "請您放心。",
    "voice": "vo_adv_1257001_019",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "關於這件事，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我已經事先調查完畢了。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "請往這邊走。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "background",
    "bg_id": "500240"
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "來，",
    "voice": "vo_adv_1257001_020",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "這裡",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "就是瀑潭迷宮的入口。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "您怎麼了？",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "露出一副不可思議的表情……",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "啊，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "明明沒有瀑潭，怎麼會有迷宮。您是在意這點啊。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "那是因為",
    "voice": "vo_adv_1257001_021",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "這裡",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "在一百年前",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "原本有一座瀑潭。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "因為數十年前的惡劣天氣改變了河川流向，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n連帶改變了瀑布的位置。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我看了過去冒險者們的報告書。",
    "voice": "vo_adv_1257001_022",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我想您也知道，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "報告書是情報的寶庫。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "整理冒險者拚命留下來的情報，",
    "voice": "vo_adv_1257001_023",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n讓下一位冒險者能夠加以活用，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "就是我們的工作。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我們會把記載的情報",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "一字不漏地記錄下來。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "所以，",
    "voice": "vo_adv_1257001_024",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "請確實提交報告書喔。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "說不定",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "能幫助到一百年後的冒險者們。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "您怎麼了？",
    "voice": "vo_adv_1257001_025",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "您說，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "牆壁上有東西……",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n嗯，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "上頭刻有一些文字呢。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "「想要吾之財寶者。",
    "voice": "vo_adv_1257001_026",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "挑戰吾之測驗，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "展現其睿智吧。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n鍊金術師‧",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "霍拉弗基」……",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "上頭是這麼寫的……",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "鍊金術師‧霍拉弗基……",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "是我沒聽過的名字呢。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我在公會管理協會的紀錄中，也不曾見過他的名字……",
    "voice": "vo_adv_1257001_027",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n表示他可能是隱居的天才，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "或是被流放的異端人士……",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我的興趣",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "突然湧了上來！",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我們繼續前進吧！",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "哎呀，",
    "voice": "vo_adv_1257001_028",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "是岔路啊。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n這裡同樣也寫了些什麼……",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "是「第一道測驗」啊。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "下方還有個",
    "voice": "vo_adv_1257001_029",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "陌生的圖形。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "不對……",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我記得這個好像是……",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "文字……？",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "嗯嗯……",
    "voice": "vo_adv_1257001_030",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "原來如此。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我知道了，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "「正確答案是右邊」",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "這樣就突破",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "第一道測驗了。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我們繼續前進吧。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "哎呀，",
    "voice": "vo_adv_1257001_031",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "這個並不是圖形。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "這是在阿斯特賴亞大陸以外的地方所使用的文字。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我偶爾",
    "voice": "vo_adv_1257001_032",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "也會收到外籍冒險者的報告書，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n我是在那時學到的。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我是時隔許久才又見到，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "不過我有確實看懂喔。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "又是岔路呢。",
    "voice": "vo_adv_1257001_033",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "也就是說……",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "有了，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "「第二道測驗」。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "這是",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "劍士的胸像……吧。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n什麼什麼……",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "「朝劍指的方向前進」，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "上頭是這麼寫的。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我好像在哪裡看過這個胸像……",
    "voice": "vo_adv_1257001_034",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "原來如此原來如此。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n也就是說，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "正確答案是左邊。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "您的表情像在說",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "妳為什麼會知道啊？",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "這座雕像是",
    "voice": "vo_adv_1257001_035",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "在數百年前赫赫有名的",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "著名冒險家，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n留下來的紀錄有提到",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "他是個左撇子。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "也就是說，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "他的劍會指向左邊。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "不……",
    "voice": "vo_adv_1257001_036",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我所知道的，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "都只是留在資料中的事情。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "沒有留下資料的事情，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我當然不知道。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "再說，",
    "voice": "vo_adv_1257001_037",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "只是擁有知識沒有用，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n活用智慧，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "才能漸漸轉為睿智，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "前人也曾說過這番話。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "這番話用在這場測驗再貼切不過了。",
    "voice": "vo_adv_1257001_038",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "好了，",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我們照這個步調",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "繼續前進吧！",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "兩人之後也通過了數道的測驗，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n終於抵達洞窟最深處。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "看來已經走到盡頭了呢。",
    "voice": "vo_adv_1257001_039",
    "unit_id": 125711
  },
  {
