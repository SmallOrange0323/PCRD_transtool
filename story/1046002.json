    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "你說結果是優惠啊？ ",
    "voice": "vo_adv_1046002_043",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "嗯―……",
