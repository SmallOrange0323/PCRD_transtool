[
  {
    "type": "background",
    "bg_id": "500430"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "往塔頂繼續前進的一行人，於某個樓層稍作休息。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "怎麼會如此美麗動人呢……",
    "voice": "vo_adv_7017003_000",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n真想",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "永遠注視著",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "完美無缺的",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我……♪",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "整天盯著那面鏡子看，",
    "voice": "vo_adv_7017003_001",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "真虧妳不膩啊。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "就算是自己的臉，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "看久了也是會厭倦的。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "因為我是世界上最美麗的人。",
    "voice": "vo_adv_7017003_002",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "而且每分每秒",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我的美麗",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "都在與時俱進唷。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "妳的外貌出眾這點，",
    "voice": "vo_adv_7017003_003",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "確實不可否認。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n而資質上呢，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "看起來魅惑魔物是沒問題。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "只要讓我打磨一番，",
    "voice": "vo_adv_7017003_004",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "一定能更加出色。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "如果妳有意願的話，我來幫助你出道吧？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "出道？",
    "voice": "vo_adv_7017003_005",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "沒錯。",
    "voice": "vo_adv_7017003_006",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "別看我這樣，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我涉足的領域可廣著呢。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n我曾著手支撐公會財政的大型事業，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "也曾將某個牧場打造為觀光景點。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "而且，",
    "voice": "vo_adv_7017003_007",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我也正擔任著時下當紅偶像",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n的製作人。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "妳意下如何呢？",
    "voice": "vo_adv_7017003_008",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "只要交給我，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我保證",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n一定能將妳打造成比鑽石還耀眼的明星。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "讓我成為明星……？",
    "voice": "vo_adv_7017003_009",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "意思是",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "成為偶像出道嗎？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "沒錯。",
    "voice": "vo_adv_7017003_010",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不得不承認，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n妳那不為他人所動、忠於自我的色彩，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "讓妳相當地惹人注目。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "在旁人看來",
    "voice": "vo_adv_7017003_011",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "也許太獨樹一格……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "但換言之，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這也代表妳的個性絕無僅有，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n不會被他人所取代。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "想像一下。",
    "voice": "vo_adv_7017003_012",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "妳身處聚光燈照耀的舞台上，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n有",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "成千上百的人們，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n正屏息凝神的望著妳。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "有很多的人",
    "voice": "vo_adv_7017003_013",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "沉醉於我的魅力……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n這個情景",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "真不錯，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我有點感興趣呢。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不過",
    "voice": "vo_adv_7017003_014",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "克莉絲提娜小姐，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n妳能否提供與我的美貌相襯的舞台呢？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "什麼意思？",
    "voice": "vo_adv_7017003_015",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "雖然很高興妳這麼醉心於我……",
    "voice": "vo_adv_7017003_016",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "但我有點擔心，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "妳能否提供得出，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n能與我的美貌互相匹敵，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "甚至更加烘托的舞台。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "假如",
    "voice": "vo_adv_7017003_017",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "本應照亮我的聚光燈，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n因為舞台上太過耀眼的我，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "反而",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "黯然失色的話",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "怎麼行呢？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "如果舞台不能襯托出我的美貌，",
    "voice": "vo_adv_7017003_018",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n那不管在哪裡不都一樣嗎？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "因為不論身處何方，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我的美麗都無懈可擊呢♪",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "克莉絲提娜小姐，",
    "voice": "vo_adv_7017003_019",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "妳有辦法將我的美貌",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "發揮得比現在還要淋漓盡致嗎？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "看來我還真是被小覷了啊？",
    "voice": "vo_adv_7017003_020",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n妳想像的事情",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "根本不值一提。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "何止是那種程度。",
    "voice": "vo_adv_7017003_021",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n如果不能",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "把妳提升到妳原本絕對無法到達的高度，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n我來打造的意義不就沒了嗎？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不過，",
    "voice": "vo_adv_7017003_022",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "既然是交給我負責，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n就不會允許半吊子的成果。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我會用克莉絲提娜式的斯巴達教育──",
    "voice": "vo_adv_7017003_023",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n從早到晚、徹頭徹尾的訓練妳唷。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "嚴苛程度保證連【王宮騎士團】的新兵都會落荒而逃呢☆",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不要露出那麼擔心的表情嘛，",
    "voice": "vo_adv_7017003_024",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "小子。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n你大可放心，我自有分寸。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "要精準地控制在讓新兵們勉強死不了的程度，",
    "voice": "vo_adv_7017003_025",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n可不是件易事喔？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "連士兵們都會感動到",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "在訓練的最後一天痛哭流涕呢☆",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "當然該有的福利也不會忘。",
    "voice": "vo_adv_7017003_026",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n休假時",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "就安排到冠以我之名的度假SPA",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n去做保養及美體吧。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不僅如此，",
    "voice": "vo_adv_7017003_027",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "還會動用我所有的人脈，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n以各種資源及設施",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "打造最棒的環境，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n來讓妳",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "登上頂點。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "在最棒的環境中，",
    "voice": "vo_adv_7017003_028",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "最美麗的我",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n在世界的舞台上展翅高飛……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "嗯，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我彷彿也看見了那種光景……！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "為什麼",
    "voice": "vo_adv_7017003_029",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我會生得如此可愛又帥氣呢？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "原來是因為",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "要讓我的美麗",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "造福整個世界啊……！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "沒錯！",
    "voice": "vo_adv_7017003_030",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "就用妳的那副美貌！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "那美麗的雙眸、",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "蠱惑人心的嗓音，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n來讓蘭德索爾的……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "全世界的人們為你著迷吧！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不過，",
    "voice": "vo_adv_7017003_031",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我有個條件。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "呵呵，",
    "voice": "vo_adv_7017003_032",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "如果能將我那無止境的魅力……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n更加琢磨的話，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不管什麼條件都可以唷。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "來吧，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "讓我聽聽妳的要求。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "好……",
    "voice": "vo_adv_7017003_033",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我會負起培育妳的責任。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n相對的，妳的出道方式到服裝都得讓我一手打造。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n也就是說，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "條件是必須絕對聽從我的指令。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "什麼啊，",
    "voice": "vo_adv_7017003_034",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "那就算了。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這麼好的條件竟然拒絕，",
    "voice": "vo_adv_7017003_035",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我實在",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "難以理解……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "姑且",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "聽聽妳的想法，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "可以吧？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "嗯。",
    "voice": "vo_adv_7017003_036",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "因為",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我的存在本身就很美。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "雖然我並不討厭",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "將這份美麗更加琢磨，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n也不排斥要將之傳遞給全世界……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我只想要",
    "voice": "vo_adv_7017003_037",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "穿我自己覺得美麗的衣服。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "就算旁人如何奉承，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我自己",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不覺得適合的話，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不就沒意義了嗎？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "衣服這種東西，",
    "voice": "vo_adv_7017003_038",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不是任人擺布的事物。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我的衣服",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "由我自己所選。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "…………",
    "voice": "vo_adv_7017003_039",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "好吧，",
    "voice": "vo_adv_7017003_040",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "就當我沒提過這件事。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "如果她是新兵，",
    "voice": "vo_adv_7017003_041",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n這時我會追加海量的地獄特訓，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n並且愉悅地欣賞他們的悲鳴……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "就算強迫人做不感興趣的事，",
    "voice": "vo_adv_7017003_042",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n將來也不會成大器。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "本來",
    "voice": "vo_adv_7017003_043",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這個小姑娘就是被劍所指也不以為意的人物。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n我知道她不為蠻力所屈服、",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "也不會為財富及權力所動。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n那麼就算施加再多的壓力，也不會改變她的回答吧。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "傻瓜才會繼續做無用功。",
    "voice": "vo_adv_7017003_044",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "此時靜待良機才是王道……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "而且……",
    "voice": "vo_adv_7017003_045",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我想確認看看，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這個小姑娘",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "是否能夠靠自己破蛹而出。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n觀察她",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "也別有一番樂趣……♪　",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "對了，克莉絲提娜小姐。",
    "voice": "vo_adv_7017003_046",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n剛才",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "妳提到的各種人脈及資源……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "怎麼了。",
    "voice": "vo_adv_7017003_047",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這跟妳有什麼關係嗎？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "嗯，",
    "voice": "vo_adv_7017003_048",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "想說難得有這個機會，不如就讓我物盡其用吧。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "妳有聽到我剛剛說的嗎？",
    "voice": "vo_adv_7017003_049",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n我說要把這件事化為白紙。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "因為",
    "voice": "vo_adv_7017003_050",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這可是能為我的美貌做出貢獻唷。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "當然",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "會讓我使用的吧？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "吶，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "可以吧？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "果然還是",
    "voice": "vo_adv_7017003_051",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "搞不懂這傢伙……",
    "voice": null,
    "unit_id": 107111
  },
  {
