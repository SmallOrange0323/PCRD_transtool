[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在【公會管理協會】送來魔力探測器前，\\n古蕾婭等人決定四處逛逛蘭德索爾。\\n就在某天――",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "吶吶，{0}！",
    "voice": "vo_adv_1094001_000",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n因為之前大家陪我去過我想去的地方了……",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n今天可以帶我們去古蕾婭想去的地方嗎？",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "謝謝你！",
    "voice": "vo_adv_1094001_001",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "那麼，古蕾婭，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "妳想去哪裡？",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "我、",
    "voice": "vo_adv_1094001_002",
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "我嗎……？　",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "嗯―……",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "我沒什麼特別想去的地方……",
    "voice": "vo_adv_1094001_003",
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "今天還是",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "去安想去的地方吧。",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "我",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "在一旁陪著妳就很開心了。",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "咦！？　",
    "voice": "vo_adv_1094001_004",
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "對、對不起，",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "我不是那個意思……",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "那個……",
    "voice": "vo_adv_1094001_005",
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "我",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "本來就不是那種",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "常外出的人。",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "所以，",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "雖然才說我沒什麼特別想去的地方……",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "但我……",
    "voice": "vo_adv_1094001_006",
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "其實是個",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "離群的人。",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "\\n在故鄉龍之國時，",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "完全無法融入周遭的人……",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "\\n和朋友一起外出",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "之類的經驗",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "也完全沒有。",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "古蕾婭……",
    "voice": "vo_adv_1094001_007",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "即使來到馬納歷亞，",
    "voice": "vo_adv_1094001_008",
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "還是不太敢和大家互動……",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "\\n擔心因為我的外表和力量，",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "是否會感到畏懼",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "因此而討厭我，",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "而感到不安。",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "所以，",
    "voice": "vo_adv_1094001_009",
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "我總是待在音樂塔裡，",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "\\n一個人彈奏著鋼琴。",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "但是但是，",
    "voice": "vo_adv_1094001_010",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "我們",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "最近還滿常出來玩的不是嗎！？",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "之前，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "我們不是還在馬納歷亞的街上一起吃冰淇淋嗎，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "妳還記得吧！？",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "呵呵……",
    "voice": "vo_adv_1094001_011",
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "嗯。",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "能夠和安一起出來玩，",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "我很開心唷。",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "我能感受到這份快樂的心情，",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "都是因為安教會我的。",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "不過，",
    "voice": "vo_adv_1094001_012",
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "現在",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "光是陪著安",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "\\n去想去的地方",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "就已經竭盡全力了……",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "唔。",
    "voice": "vo_adv_1094001_013",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "的確，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "我好像老是拉著妳陪我到處跑……！？",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "因為陪著妳真的很開心，",
    "voice": "vo_adv_1094001_014",
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "我完全不介意喔？",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "只是，",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "要說有沒有",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "想去哪裡玩，",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "我倒是還想不到……",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "對不起。",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "這樣啊……",
    "voice": "vo_adv_1094001_015",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "那樣的話，",
    "voice": "vo_adv_1094001_016",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "我們今天就不出門，悠閒地度過一天，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "妳覺得怎麼樣？",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "咦？　",
    "voice": "vo_adv_1094001_017",
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "但是……",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "這樣好嗎？",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "我們",
    "voice": "vo_adv_1094001_018",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "自從來到這個世界後，就一直到處遊玩，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n所以，偶爾度過這種悠閒的日子也沒什麼不好啊？",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "然後，",
    "voice": "vo_adv_1094001_019",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "悠閒途中如果古蕾婭想到要去哪裡的話，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n我們再",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "出發就好了！　",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "覺得這樣如何？",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "{0}、安……",
    "voice": "vo_adv_1094001_020",
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "謝謝。",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "background",
    "bg_id": "500110"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "於是，安一行人決定在暫居的\\n【咲戀育幼院】裡，悠悠哉哉地度過這天。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "接著，中午過後――",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "啊、{0}！",
    "voice": "vo_adv_1094001_021",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n你有看到古蕾婭嗎？",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "我",
    "voice": "vo_adv_1094001_022",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "對育幼院裡的書很感興趣，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n一不小心就埋頭閱讀了……",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "原本在我身旁的古蕾婭，",
    "voice": "vo_adv_1094001_023",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n一回過神來才發現不見人影。",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "咦？　",
    "voice": "vo_adv_1094001_024",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "要陪我一起找嗎……？",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "太好了，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "{0}，謝謝你！",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "background",
    "bg_id": "500351"
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "嗯―",
    "voice": "vo_adv_1094001_025",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "並不在屋子裡呢。",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n到底去哪裡了啊……？",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "該不會",
    "voice": "vo_adv_1094001_026",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "跑到蘭德索爾的街上了……？",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "但是",
    "voice": null,
    "unit_id": 109211
  },
  {
