    "type": "dialogue",
    "name": "茉莉",
    "words": "好～！",
    "voice": "vo_adv_1141004_060",
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "今天就這樣盡情地享受萬聖節吧！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n出發囉，",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "大哥！",
    "voice": null,
    "unit_id": 100531
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好，辛苦了。",
    "voice": "vo_adv_1141004_061",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "哎呀，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "真是當了個好大哥呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "拍下來的照片，",
    "voice": "vo_adv_1141004_062",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "後來變成了當地自製情報雜誌的封面呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n比起變裝大會，這應該是更好的回憶吧？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "話說回來，",
    "voice": "vo_adv_1141004_063",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "茉莉的正義感真強，令人欽佩呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n還為了比自己小的小孩子這麼忍耐。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不過",
    "voice": "vo_adv_1141004_064",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "就算她說憧憬英雄，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "也還是個女孩子嘛。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n你可要好好地支持她才行喔？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "之後",
    "voice": "vo_adv_1141004_065",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "也要當個她眼中的好大哥喔。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n就這樣啦。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "501132"
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "哇！",
    "voice": "vo_adv_1141004_066",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "怎麼",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "不小心睡著了！",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "是因為任務結束",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "放鬆下來的關係嗎……",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "不過",
    "voice": "vo_adv_1141004_067",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "多虧如此，我現在完全清醒了喔！",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "好，",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "就這樣輕鬆地在萬聖節樂園逛一逛……",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "白虎英雄秀",
    "voice": "vo_adv_1141004_068",
    "unit_id": 112
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "超逼真的耶～",
    "voice": null,
    "unit_id": 112
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "\\n雖然很快就結束了。",
    "voice": null,
    "unit_id": 112
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "嗯，",
    "voice": "vo_adv_1141004_069",
    "unit_id": 212
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "還想多看一下子的說～",
    "voice": null,
    "unit_id": 212
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "好，",
    "voice": "vo_adv_1141004_070",
    "unit_id": 112
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "那我們來玩白虎扮家家酒吧！",
    "voice": null,
    "unit_id": 112
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "我要當白虎～！",
    "voice": "vo_adv_1141004_071",
    "unit_id": 212
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "那我當那個黑色盔甲！",
    "voice": "vo_adv_1141004_072",
    "unit_id": 112
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "喝啊！",
    "voice": null,
    "unit_id": 112
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "那些孩子們……",
    "voice": "vo_adv_1141004_073",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "能在不被發現的情況下救了他們",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "真是太好了！",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "不過",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "救了他們的是",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "純就是了……",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "不對啦！",
    "voice": "vo_adv_1141004_074",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n就像超級英雄與搭檔那樣，",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n這是我和你",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "兩個人的功勞！",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "今後也要拜託你了！",
    "voice": "vo_adv_1141004_075",
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "嘿嘿……",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "好！",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "首先，",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "先開始萬聖節樂園的巡邏吧！",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n白虎與她的夥伴，",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "出擊囉！",
    "voice": null,
    "unit_id": 114111
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "萬聖節樂園中，迴盪著茉莉那滿懷正義的聲音。",
