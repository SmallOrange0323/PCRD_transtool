[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "從大間回到蘭德索爾的{0}，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n享受著悠閒的新年。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "啊啊，",
    "voice": "vo_adv_1150002_000",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "太好了。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "終於找到你了。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "你好，",
    "voice": "vo_adv_1150002_001",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "能打擾一下嗎？",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "啊，",
    "voice": "vo_adv_1150002_002",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "不好意思。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n這麼突然，嚇了你一跳吧。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "這裡有封要給你的信。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "能麻煩你現在就讀嗎？",
    "voice": "vo_adv_1150002_003",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "「──我是似似花。",
    "voice": "vo_adv_1150002_004",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n我在郊外等你。」",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "那麼，",
    "voice": "vo_adv_1150002_005",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "我就告辭了。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n請你快點去大人的身邊吧♪",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……你真慢。",
    "voice": "vo_adv_1150002_006",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n竟然讓女性在這麼冷的雪中等待，",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "真差勁呢。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "嗯，",
    "voice": "vo_adv_1150002_007",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "新年快樂。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "竟然學會拜年了，",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你也有所成長了呢。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "學會拜年是很值得慶幸，",
    "voice": "vo_adv_1150002_008",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n但你還需要多學學如何應對玩笑話喔。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n你總是太過相信別人了。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "那麼，",
    "voice": "vo_adv_1150002_009",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "快點出發吧。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……你在發什麼呆呢？",
    "voice": "vo_adv_1150002_010",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n該不會，",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你以為我找你的目的，",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n就只是為了拜個年吧？",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "放心吧，",
    "voice": "vo_adv_1150002_011",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我不會對你不利的。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n不如說，",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你應該感恩戴德才對。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "在出發前先交給你好了。",
    "voice": "vo_adv_1150002_012",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "收下它吧。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "本來在大間就該給你，",
    "voice": "vo_adv_1150002_013",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "但錯過時機了。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n是壓歲錢。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "謙遜固然是美德，",
    "voice": "vo_adv_1150002_014",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "但那也要選對場合。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "像個十幾歲的小孩般雀躍地收下壓歲錢，",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n才是你現在的最佳選擇喔。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "難道說，",
    "voice": "vo_adv_1150002_015",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你在跟我客氣嗎？",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n只是壓歲錢而已，坦率地收下就行了……",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "身為大人的我，",
    "voice": "vo_adv_1150002_016",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "給小孩的你壓歲錢，",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n是再正常不過的事了喔？",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……",
    "voice": "vo_adv_1150002_017",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這樣吧。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "換個思考方式。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n你就把它當成",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "一種學習。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "接觸名為壓歲錢的習俗、",
    "voice": "vo_adv_1150002_018",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "理解這種文化，",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n仔細思考要如何運用",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這筆有限的預算。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這是",
    "voice": "vo_adv_1150002_019",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "光看書桌上的教科書",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n所學不到的知識。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你好像能接受了呢。",
    "voice": "vo_adv_1150002_020",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我喜歡理解力強的孩子。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "那麼，",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你有想買的東西嗎？",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……真是的。",
    "voice": "vo_adv_1150002_021",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我就料到你會這麼說……",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "不行。",
    "voice": "vo_adv_1150002_022",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n壓歲錢只能用在自己身上。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "比起自己，",
    "voice": "vo_adv_1150002_023",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你總是優先想到別人呢。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n過度的自我犧牲，",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n絕不是什麼值得誇獎的事喔？",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "將我希望你為自己而用的壓歲錢，",
    "voice": "vo_adv_1150002_024",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n用在其他人身上，",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n你有考慮到我的感受嗎？",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這筆",
    "voice": "vo_adv_1150002_025",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "壓歲錢是給你的。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n你打算無視",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "贈與者的心意嗎？",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我可沒有要你道歉喔。",
    "voice": "vo_adv_1150002_026",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "但是，",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我能理解你想這麼做的心情。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "聽好了，",
    "voice": "vo_adv_1150002_027",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n學會面對自己的欲望，",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "也能成為一種經驗。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "那麼，",
    "voice": "vo_adv_1150002_028",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "盡快往鬧區出發吧。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n就讓我來見證",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n你將如何使用這筆壓歲錢。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這絕對",
    "voice": "vo_adv_1150002_029",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "不是基於好奇的行為。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n這點還請你別誤會，",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "知道了嗎？",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你會做出什麼選擇……",
    "voice": "vo_adv_1150002_030",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我非常期待呢。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "果然到了新年，",
    "voice": "vo_adv_1150002_031",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "人真的很多呢。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "為了避免走散，",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你能跟緊我吧？",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "小孩１",
    "words": "欸欸，",
    "voice": "vo_adv_1150002_032",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩１",
    "words": "你今天要買什麼？",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩１",
    "words": "\\n",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩１",
    "words": "我要買年底新出的遊戲！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩２",
    "words": "我",
    "voice": "vo_adv_1150002_033",
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "小孩２",
    "words": "想買書！",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "小孩２",
    "words": "\\n也想",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "小孩２",
    "words": "買漫畫。",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "小孩１",
    "words": "那剩下的錢就拿來買零食和果汁，",
    "voice": "vo_adv_1150002_034",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩１",
    "words": "\\n到我家玩吧！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩１",
    "words": "\\n",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩１",
    "words": "順便把漫畫借給我看！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩２",
    "words": "好哇！",
    "voice": "vo_adv_1150002_035",
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "小孩２",
    "words": "我贊成！",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "小孩２",
    "words": "\\n我也想玩新出的遊戲！",
    "voice": null,
    "unit_id": 5311
  },
  {
    "type": "dialogue",
    "name": "小孩１",
    "words": "好，",
    "voice": "vo_adv_1150002_036",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩１",
    "words": "那我們快去買吧！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你看，",
    "voice": "vo_adv_1150002_037",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "那些孩子們，",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n也懂得拿壓歲錢去買自己想要的東西喔。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "而且是十分有計畫性地使用方式。",
    "voice": "vo_adv_1150002_038",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "請你向他們學習，",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "去買自己想要的東西吧。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "找到想買的東西了嗎？",
    "voice": "vo_adv_1150002_039",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n你似乎東張西望了好一陣子……",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……居然還沒買任何東西，",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我有點吃驚呢。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "比如說……",
    "voice": "vo_adv_1150002_040",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這個嘛，",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n趁這個機會",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "買件衣服怎麼樣？",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你很常和女性一起行動，",
    "voice": "vo_adv_1150002_041",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "那怕在外觀上，",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "稍微試著打扮一下也不錯吧。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "或是說，",
    "voice": "vo_adv_1150002_042",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "逛逛攤販，\\n來場美食之旅",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "或許也不賴。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你在【美食殿堂】的經驗，",
    "voice": "vo_adv_1150002_043",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n或許幫助拓展了美食領域上的見聞，",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "但食用的內容有些太過來者不拒呢。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這是",
    "voice": "vo_adv_1150002_044",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "福袋嗎……",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "既有新年的風格、",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n偶爾試著聽天由命",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "也很有趣呢。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "哪怕",
    "voice": "vo_adv_1150002_045",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "裡面都是些微不足道的小東西，\\n",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "也能成為很好的談資喔。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……這樣啊。",
    "voice": "vo_adv_1150002_046",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n我不小心",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "干涉太多了呢……",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你雙眼放光地看著各種東西的畫面實在太過有趣，",
    "voice": "vo_adv_1150002_047",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n我本來只想觀察的，",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "卻也忍不住給出了意見。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我會重整心情，",
    "voice": "vo_adv_1150002_048",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n見證你自己",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "做出的選擇。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "……這位客人。",
    "voice": "vo_adv_1150002_049",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "您已經看很久了，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "\\n請問決定好要買什麼了嗎？",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "唉……",
    "voice": "vo_adv_1150002_050",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "再怎麼優柔寡斷",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "也該有個限度喔。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "看起來不像是因為想要的東西太多而苦惱呢。",
    "voice": "vo_adv_1150002_051",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……他會這樣，",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "是因為沒有任何欲望嗎？　",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你終於決定了啊。",
    "voice": "vo_adv_1150002_052",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n結帳……",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "已經能自己去了呢。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n看到你有所成長的一面真是太好了。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "謝謝惠顧──！",
    "voice": "vo_adv_1150002_053",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "歡迎再來──！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你買了什麼？",
    "voice": "vo_adv_1150002_054",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這是……",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "撲克牌啊。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……原來如此。",
    "voice": "vo_adv_1150002_055",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "很有你風格的選擇呢。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "儘管預算充足，",
    "voice": "vo_adv_1150002_056",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我也多次提出",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n要你以自我為中心考量，",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你最終還是選擇了能與他人",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "一同玩樂的事物。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "乍看之下只是個老好人做出的決定……",
    "voice": "vo_adv_1150002_057",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "但我卻能感受到",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "除此之外的巧思。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你這個人真的",
    "voice": "vo_adv_1150002_058",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "十分有趣呢。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n在這一點上，",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "完全不亞於七冠。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你今年又會向我展示什麼呢。",
    "voice": "vo_adv_1150002_059",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n真是讓我無比期待啊。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "那麼，",
    "voice": "vo_adv_1150002_060",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "等你買東西",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "等到肚子都餓了。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n這餐我請客，",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "去吃點好吃的東西吧。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "吃完飯後，",
    "voice": "vo_adv_1150002_061",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "就輪到你陪我買東西了。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "看著你買東西，",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "就連我也開始有些手癢了。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "就讓我告訴你，",
    "voice": "vo_adv_1150002_062",
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "什麼才叫真正的購物吧。",
    "voice": null,
    "unit_id": 115011
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "心情極好的似似花",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n帶著{0}繼續逛街。",
    "voice": null,
    "unit_id": null
  }
]
