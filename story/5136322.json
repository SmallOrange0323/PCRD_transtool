[
  {
    "type": "dialogue",
    "name": "紅霧精靈",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 10712
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "！",
    "voice": "vo_adv_5136322_000",
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n分裂了！？",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "小心不要被附身了！",
    "voice": "vo_adv_5136322_001",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n就像我們剛才那樣子！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "妳們的話，",
    "voice": "vo_adv_5136322_002",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "應該不至於被它排除……",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "頂多",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "會變得無法自由活動！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n藉此來奪走妳們的攻擊能力吧！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "奪走攻擊能力……",
    "voice": "vo_adv_5136322_003",
    "unit_id": 128811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 128811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "意思就是讓我們失去力量嗎！",
    "voice": null,
    "unit_id": 128811
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……或許吧。",
    "voice": "vo_adv_5136322_004",
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n從效率上來看，",
    "voice": null,
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "它應該會鎖定最需要警戒的對手。",
    "voice": null,
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "意思就是它會以最強的人當作目標是吧！",
    "voice": "vo_adv_5136322_005",
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "要是攻擊的主力被牽制了，",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "會很傷呢……！",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……不過，",
    "voice": "vo_adv_5136322_006",
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n就算被附身還是可以把它趕出去的。",
    "voice": null,
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n就像我們剛才一樣。",
    "voice": null,
    "unit_id": 135613
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "它一定還會使出其他招式……",
    "voice": "vo_adv_5136322_007",
    "unit_id": 128911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 128911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "妳們也要小心喔！",
    "voice": null,
    "unit_id": 128911
  }
]
