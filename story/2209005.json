  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "……【蠻賊三姊妹】。",
    "voice": "vo_adv_2209005_002",
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n妳們退下。",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "啥～？",
    "voice": "vo_adv_2209005_003",
    "unit_id": 130213
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n少命令我們了～",
    "voice": null,
    "unit_id": 130213
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "……哼。",
    "voice": "vo_adv_2209005_004",
    "unit_id": 130013
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n真的好嗎？",
    "voice": null,
    "unit_id": 130013
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "妳們留在這裡的話，",
    "voice": "vo_adv_2209005_005",
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "也只會火上加油而已。",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n快走。",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "……妳們兩個，",
    "voice": "vo_adv_2209005_006",
    "unit_id": 130013
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "走吧。",
    "voice": null,
    "unit_id": 130013
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "失、",
    "voice": "vo_adv_2209005_007",
    "unit_id": 130113
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "失陪了……",
    "voice": null,
    "unit_id": 130113
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "…………",
    "voice": "vo_adv_2209005_008",
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "……",
    "voice": "vo_adv_2209005_009",
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "……那個。",
    "voice": "vo_adv_2209005_010",
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "女士──",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "──呵。",
    "voice": "vo_adv_2209005_011",
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "呵呵呵……",
    "voice": "vo_adv_2209005_012",
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n哈哈、",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "哈哈哈……",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "──喝啊！！",
    "voice": "vo_adv_2209005_013",
    "unit_id": 136013
  },
  {
    "type": "still",
    "still_id": "220900403"
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "…………",
    "voice": "vo_adv_2209005_014",
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n居然能從不同的世界，",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "發動如此強大的防禦魔法。",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n即使是和這丫頭有關係的人，",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "也不可能隨便就做到。",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "……我有同感，",
    "voice": "vo_adv_2209005_015",
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "女士──",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "still",
    "still_id": "220900501"
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "別敷衍吾，",
    "voice": "vo_adv_2209005_016",
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "傳令……！",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n妳的世界",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "居然有實力如此高強的人──",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n吾可不許妳說妳不知道這個情報……！",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "您會生氣也是理所當然……",
    "voice": "vo_adv_2209005_017",
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n但是，",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "能請您聽我說嗎，",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "女士。",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "那位女性是過去，",
    "voice": "vo_adv_2209005_018",
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "被視為世界管理者的存在。",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n曾經占據了本應由您來登上的王座。",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "……只是。",
    "voice": "vo_adv_2209005_019",
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n她原本",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "應該已經消逝了才對……",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "消逝？",
    "voice": "vo_adv_2209005_020",
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n哼……",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "吾看她",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "倒是活得很好啊。",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "不……",
    "voice": "vo_adv_2209005_021",
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "恕我直言，",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n她原本的性能",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "並非是那種程度。",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n她在那邊的世界，",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "正是擁有宛如神一般權能的人。",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "……妳的意思是她原本是在吾之上",
    "voice": "vo_adv_2209005_022",
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "的人？",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "…………",
    "voice": "vo_adv_2209005_023",
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "……呵呵、",
    "voice": "vo_adv_2209005_024",
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "呵哈哈……",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "……有意思。",
    "voice": "vo_adv_2209005_025",
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n真是太有意思了。",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "吾的願望",
    "voice": "vo_adv_2209005_026",
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "是支配將吾關禁起來的這個吉歐‧格黑納。",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n並破壞隔絕",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "世界與世界之間的「牆壁」。",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "在未來等著的世界，",
    "voice": "vo_adv_2209005_027",
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n若真有妳所說的那般權能、",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "那般光芒存在──",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n吾絕對要將其奪取，",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "並納為己有。",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "……一切如您所願，",
    "voice": "vo_adv_2209005_028",
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "女士。",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "那麼，",
    "voice": "vo_adv_2209005_029",
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "我們再次開始",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "攻略鬼岩城塞──",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "慢著，",
    "voice": "vo_adv_2209005_030",
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "妳這愚蠢之徒。",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "……",
    "voice": "vo_adv_2209005_031",
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "真是何等地粗心輕率。",
    "voice": "vo_adv_2209005_032",
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n那座城塞遲早是屬於吾的，",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "就算現在攻下來又如何。",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n鐵皇女已經動彈不得，",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "吾怎麼可能放過這個好機會。",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "……好機會？",
    "voice": "vo_adv_2209005_033",
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "那麼……",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "妳跟那群盜賊",
    "voice": "vo_adv_2209005_034",
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "和小蜘蛛們一起，",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n去阻擋尤絲蒂亞娜公主的襲擊。",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n這段時間，",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "吾──",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "就像隻蜘蛛般，",
    "voice": "vo_adv_2209005_035",
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "準備進行蛻皮吧。",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "…………\\n……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "502300"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "另一方面。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n「鬼岩城塞」附近的避難所──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男蜥蜴人",
    "words": "痛痛痛……",
    "voice": "vo_adv_2209005_036",
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "男蜥蜴人",
    "words": "\\n可惡，",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "男蜥蜴人",
    "words": "那個絲線究竟是怎麼回事啊……",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "巴西利斯克男",
    "words": "如果不是皇女大人出手相助，",
    "voice": "vo_adv_2209005_037",
    "unit_id": 50711
  },
  {
    "type": "dialogue",
    "name": "巴西利斯克男",
    "words": "我們就會自相殘殺而亡了……",
    "voice": null,
    "unit_id": 50711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "那個，",
    "voice": "vo_adv_2209005_038",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "要是不介意，",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "請讓我替你包紮。",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "雖然只是簡單的處置……",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "男蜥蜴人",
    "words": "真抱歉呢，",
    "voice": "vo_adv_2209005_039",
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "男蜥蜴人",
    "words": "小姐……",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "男蜥蜴人",
    "words": "\\n妳們明明是其他地方來的客人，",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "男蜥蜴人",
    "words": "卻害妳們捲了進來。",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "我們",
    "voice": "vo_adv_2209005_040",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "不要緊的。",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "可是……",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……老姊。",
    "voice": "vo_adv_2209005_041",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n妳又在想「要是自己有力量──」之類的事？",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "沒有的東西就是沒有，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "這也是沒有辦法的。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "…",
    "voice": "vo_adv_2209005_042",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "…可是……",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n烏爾姆難道不會想要幫上萊拉耶爾大人",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n和騎士先生他們嗎！？",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……我",
    "voice": "vo_adv_2209005_043",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "當然想。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "可是妳也看到了吧，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "那個巨大的蜘蛛魔物。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "像我或姊姊這樣的小角色，",
    "voice": "vo_adv_2209005_044",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n就算稍微變得比較能戰鬥了。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n但要是對上那種對手，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "有一百條命也不夠用。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "……就算如此。",
    "voice": "vo_adv_2209005_045",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "即便敵不過、",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "即便有危險。",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n非戰鬥不可的時候也遲早會到來……",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "我是這麼想的。",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "老姊……",
    "voice": "vo_adv_2209005_046",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "巴西利斯克男",
    "words": "沒錯沒錯！",
    "voice": "vo_adv_2209005_047",
    "unit_id": 50711
  },
  {
    "type": "dialogue",
    "name": "巴西利斯克男",
    "words": "\\n妳說了句好話呢～",
    "voice": null,
    "unit_id": 50711
  },
  {
    "type": "dialogue",
    "name": "巴西利斯克男",
    "words": "藍色的小姐。",
    "voice": null,
    "unit_id": 50711
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……不好意思，",
    "voice": "vo_adv_2209005_048",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "可以請你別插嘴嗎。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n這是我們自家人的事。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "巴西利斯克男",
    "words": "喔！",
    "voice": "vo_adv_2209005_049",
    "unit_id": 50711
  },
  {
    "type": "dialogue",
    "name": "巴西利斯克男",
    "words": "\\n喔好……",
    "voice": null,
    "unit_id": 50711
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "烏爾姆！",
    "voice": "vo_adv_2209005_050",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n妳別那樣對人家說話啊！",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……吵死了，",
    "voice": "vo_adv_2209005_051",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "笨老姊……",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "根本就不懂我的心情……",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "真是的！",
    "voice": "vo_adv_2209005_052",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n妳說誰是笨蛋──",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "不可以吵架～！",
    "voice": "vo_adv_2209005_053",
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "琳德、烏爾姆",
    "words": "唔……",
    "voice": "vo_adv_2209005_054",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "我能明白妳們因為自己的力量不足",
    "voice": "vo_adv_2209005_055",
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "而感到焦躁！",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n但現在可不是姊妹吵架的時候啊！",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "妳們有聽懂吧，",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "琳德、",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "烏爾姆！",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "琳德、烏爾姆",
    "words": "……對不起。",
    "voice": "vo_adv_2209005_056",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "而且──",
    "voice": "vo_adv_2209005_057",
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "嗚嗚、",
    "voice": "vo_adv_2209005_058",
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "嗚嗚……",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "\\n嗚嗚嗚……",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "拿娜也是！",
    "voice": "vo_adv_2209005_059",
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n妳要窩在角落哭到什麼時候！",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "嗚、",
    "voice": "vo_adv_2209005_060",
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "嗚嗚……",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "拿娜，",
    "voice": "vo_adv_2209005_061",
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "不行了……",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "\\n已經不行了啦……",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "一看到……",
    "voice": "vo_adv_2209005_062",
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "一看到那個絲線，",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "\\n雙、",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "雙腳就發軟了……",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "\\n身體",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "變得",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "動彈不得……",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "still",
    "still_id": "220700503"
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "──去死吧！",
    "voice": "vo_adv_2209005_063",
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "華音♪",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "background",
    "bg_id": "502300"
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "拿娜受夠了！",
    "voice": "vo_adv_2209005_064",
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "拿娜不想要，",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "再被操縱了……",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "與其……",
    "voice": "vo_adv_2209005_065",
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "\\n又像那時候一樣",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "再次傷害朋友……",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "\\n拿娜……",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "拿娜，",
    "voice": "vo_adv_2209005_066",
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "還不如",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "去死算了……",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "拿娜小姐……",
    "voice": "vo_adv_2209005_067",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "──給我振作一點！！",
    "voice": "vo_adv_2209005_068",
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "咿咿！？",
    "voice": "vo_adv_2209005_069",
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "妳就算死了，",
    "voice": "vo_adv_2209005_070",
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "也沒有任何人會開心！",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n再說妳在精神上都認輸了，",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "這樣要怎麼辦啊！",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "可是，",
    "voice": "vo_adv_2209005_071",
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "小鳳……",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "\\n拿娜，",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "非常地",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "弱小……",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "我不會要求妳戰鬥！",
    "voice": "vo_adv_2209005_072",
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "可是，",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "妳應該也有妳自己的長處。",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n否則的話，",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "不可能在這個世界中生存下去吧！",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "而且拿娜……",
    "voice": "vo_adv_2209005_073",
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n華音",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "有對妳說過吧？",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "她叫妳",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "替她報仇。",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "嗚嗚……",
    "voice": "vo_adv_2209005_074",
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "\\n華音……",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "我也一樣，靠現在的神力",
    "voice": "vo_adv_2209005_075",
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "別說是復仇了，",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n甚至連正常戰鬥都沒有辦法……",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "但我也不打算就這麼坐視不管。",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "怎麼會……",
    "voice": "vo_adv_2209005_076",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "這很危險啊，",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "鳳凰小姐！",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……這話輪得到剛才還想要戰鬥的老姊來說嗎……？",
    "voice": "vo_adv_2209005_077",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "我非常清楚這很危險……",
    "voice": "vo_adv_2209005_078",
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "不對。",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n只靠我自己的話，",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "馬上就會被那個絲線給抓住。",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "所以……",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "妳願意協助我嗎，",
    "voice": "vo_adv_2209005_079",
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "拿娜。",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "如果妳也把我，",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "和華音一樣當成是妳的朋友。",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "小鳳……",
    "voice": "vo_adv_2209005_080",
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "唔，",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "可、",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "可是……",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "該……",
    "voice": "vo_adv_2209005_081",
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "怎麼做",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "才好？",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "有拿娜……",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "也能辦到",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "的事情嗎……？",
    "voice": null,
    "unit_id": 136212
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "呵呵呵。",
    "voice": "vo_adv_2209005_082",
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "拿娜，",
