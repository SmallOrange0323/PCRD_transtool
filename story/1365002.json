[
  {
    "type": "background",
    "bg_id": "502630"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "靜流和{0}",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "今天也享受著新婚生活。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n兩人走在街上的時候，\\n璃乃勢不可擋地衝了過來。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "你們好！",
    "voice": "vo_adv_1365002_000",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "哥哥、姐姐，",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我有話要說～！",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "璃乃，",
    "voice": "vo_adv_1365002_001",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "妳怎麼了？",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "要我給妳新年第一發的頭錘嗎？",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我才不要！",
    "voice": "vo_adv_1365002_002",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "比起施展頭錘，",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n請先做出",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "聆聽可愛妹妹說話的姿態！",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "被罵了。",
    "voice": "vo_adv_1365002_003",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "欸嘿☆",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "……其實我，",
    "voice": "vo_adv_1365002_004",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "有【拉比林斯】的任務在身，",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n現在正在為任務做準備。",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "獨自一人。",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "當妹妹正在獨自努力的時候，",
    "voice": "vo_adv_1365002_005",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n姐姐",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "卻和哥哥待在一起喔。",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "吸",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "……",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "吐……",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "這樣不是很奇怪嗎！？",
    "voice": "vo_adv_1365002_006",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n有任務在身沒關係！",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "要我獨自準備也沒關係！",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n但是！",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "可是！",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "然而！",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我們明明是手足，",
    "voice": "vo_adv_1365002_007",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "卻只有我獨自一人，好寂寞～！",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "你們兩個還卿卿我我的！",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "也就是說，",
    "voice": "vo_adv_1365002_008",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "璃乃是……",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我想跟你們一起玩！",
    "voice": "vo_adv_1365002_009",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n我勉強擠出了時間，",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "所以一起來玩吧！",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "應該說",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "請跟我玩！",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "嗯嗯♪",
    "voice": "vo_adv_1365002_010",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "那樣的話，妳來得正好喔。",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n我今天也準備了要來玩新年遊戲♪",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n正想說要找璃乃一起玩呢！",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "background",
    "bg_id": "502660"
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "就是這樣……",
    "voice": "vo_adv_1365002_011",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n我想來玩經典的新年遊戲，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "也就是放風箏！",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "風箏上畫了圖……",
    "voice": "vo_adv_1365002_012",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n這該不會是……",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "沒錯，",
    "voice": "vo_adv_1365002_013",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "就是弟弟喔！",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我想透過展現在空中翱翔的弟弟，",
    "voice": "vo_adv_1365002_014",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n讓東國的人們也了解",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "弟弟的可愛與帥氣。",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我想東國的人們看見弟弟後，",
    "voice": "vo_adv_1365002_015",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n一定也能",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "帶著幸福的心情度過這一年！",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "而且，",
    "voice": "vo_adv_1365002_016",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "藉由在新年的空中飛翔，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n弟弟將會一飛沖天！",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n我也對風箏寄託著這樣的心願！",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "原來如此！",
    "voice": "vo_adv_1365002_017",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "……原來如此？",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "嗯，",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "都好啦。",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n反正放風箏感覺很好玩！",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "那就，",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "要放囉……",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我放～！",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "哼哼♪",
    "voice": "vo_adv_1365002_018",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n我要就這樣讓風箏線延伸到極限，",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n讓風箏飛得更高更遠！",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "控制得很穩定……",
    "voice": "vo_adv_1365002_019",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "璃乃真拿手！",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n風箏上的弟弟",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "看來也很開心呢♪",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "嘿嘿♪",
    "voice": "vo_adv_1365002_020",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "被人稱讚",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "果然很高興呢～♪",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "也順利讓風箏線拉長到最極限了！",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n就像是景上天飛一樣！",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "妳想說的是「錦上添花」，",
    "voice": "vo_adv_1365002_021",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "喜上加喜的意思吧。",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "璃乃居然",
    "voice": "vo_adv_1365002_022",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "能讓弟弟飛到空中極限……",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "那麼接下來，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "輪到姐姐了！",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n換手吧，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "璃乃！",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "好，",
    "voice": "vo_adv_1365002_023",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "給妳♪",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "謝謝♪",
    "voice": "vo_adv_1365002_024",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "那麼那麼，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "在這裡要拿出來的是……",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "新的風箏線～！",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n把這條線綁上去……",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "嗯，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "很好！",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "就用這條線跟姐姐的愛，",
    "voice": "vo_adv_1365002_025",
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n把弟弟帶到更高的地方去！",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n去吧，",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "弟弟～！",
    "voice": null,
    "unit_id": 136511
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "真不愧是",
    "voice": "vo_adv_1365002_026",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "姐姐！",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n風箏上的哥哥，",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "變得越來越小了喔！",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "因為姐姐的愛",
    "voice": "vo_adv_1365002_027",
    "unit_id": 136511
  },
  {
