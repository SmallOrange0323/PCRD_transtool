  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "はぁ……",
    "voice": "vo_adv_5040704_000",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "はぁ……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "なんなの……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\nもうクタクタだよ……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\n追い払えたからいいけど……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "あの大きさ、",
    "voice": "vo_adv_5040704_001",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "ねずみの親玉だったのかな？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "親玉を追い払ったんだから",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "もう大丈夫だよね。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "大丈夫だと思いたい。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "この子たちは……",
    "voice": "vo_adv_5040704_002",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "よかった～",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\n傷一つないね。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "ん？　",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "むしろさっきよりツヤツヤになってない？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "そんなすぐに熟成されるものなのかな？",
    "voice": "vo_adv_5040704_003",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "まぁ、",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "あたしも短時間でねずみ追い払うのうまくなったし、",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\nこの子たちがあっという間に育ってもおかしくないよね。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "心なしか",
    "voice": "vo_adv_5040704_004",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "匂いもおいしく感じてきた……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "気がする。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "おかしいな。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "ドングリと比べたら全然だったのに。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "これは確かに",
    "voice": "vo_adv_5040704_005",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "エリザベスパーク印の製品が人気なのもうなずけるね。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\nまっひ～はすごいよ。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "改めて見直しちゃう。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "まっひ～の期待に応えるためにも",
    "voice": "vo_adv_5040704_006",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "このままチーズを守り続け……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "あれ？　",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "あそこになんか穴が開いてる。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "ひょっとしてねずみの巣！？　",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "ここから湧いて出てたの？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "あ～もう！　",
    "voice": "vo_adv_5040704_007",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "これまたねずみ出てくるパターンじゃん！",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\nいいよ！　",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "何度でも撃退するよ！",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "リン",
    "words": "\\n掛かってきな！！",
    "voice": null,
    "unit_id": 102611
  }
]
