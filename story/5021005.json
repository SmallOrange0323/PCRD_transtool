  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "為了尋找玩偶們而分散行動的{0}等人，\\n回到了集合地點的沙灘上。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "{0}、",
    "voice": "vo_adv_5021005_000",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "真琴，",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "歡迎回來～",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "喔！",
    "voice": "vo_adv_5021005_001",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我們回來了。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n妳們那邊狀況如何？",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我們這裡沒看到呀～",
    "voice": "vo_adv_5021005_002",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "這樣啊……",
    "voice": "vo_adv_5021005_003",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我們奪回兩隻，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "但看來路途還很漫長。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "天色要變暗了，",
    "voice": "vo_adv_5021005_004",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "今天就在這附近",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "過一晚吧～",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我剛才順便",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "把一些柴火之類的東西帶回來了～♪",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "哦，",
    "voice": "vo_adv_5021005_005",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "想得很周到嘛，香織。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "是說，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我們怎麼不在那個漁村找地方借住啊？",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "這是真步的決定～",
    "voice": "vo_adv_5021005_006",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n因為說不定",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "玩偶們隨時會跑回來呀～",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "……原來如此。",
    "voice": "vo_adv_5021005_007",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "海邊露營也滿有夏日的感覺，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "挺好的。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "那",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "公主現在人呢？",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "　沒看到她在啊。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "她說想去看看大海～",
    "voice": "vo_adv_5021005_008",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "抱著亞瑟就",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "往那邊走去了～",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "嗯～",
    "voice": "vo_adv_5021005_009",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n希望她不會感到太沮喪……",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "{0}{0}～",
    "voice": "vo_adv_5021005_010",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n可以拜託你一件事嗎～？",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "能請你",
    "voice": "vo_adv_5021005_011",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "去鼓勵真步嗎～？",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "她現在失去重要的東西",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "一定很難過～",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "{0}一定有辦法",
    "voice": "vo_adv_5021005_012",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "平撫她失落的心情～",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "就像你對我那樣～♪",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "不愧是{0}～♪",
    "voice": "vo_adv_5021005_013",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "什麼都不用說就知道我想講什麼，",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n充滿男子氣概～",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "好迷人呀～♪",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "那麼",
    "voice": "vo_adv_5021005_014",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "真步的事就交給你了～！",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我們就在這裡做好露營的準備。",
    "voice": "vo_adv_5021005_015",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n天色馬上就要變暗了，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "記得在那之前回來啊？",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "……",
    "voice": "vo_adv_5021005_016",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "啊，",
    "voice": "vo_adv_5021005_017",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生。",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "你是來叫我回去的嗎？",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "對不起，",
    "voice": "vo_adv_5021005_018",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "居然把您",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "捲入麻煩的事情裡了。",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "still",
    "still_id": "502100501"
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "……蘭斯洛特和高文！",
    "voice": "vo_adv_5021005_019",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "您把它們帶回來了。",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "謝謝您。",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "……",
    "voice": "vo_adv_5021005_020",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "其實人家",
    "voice": "vo_adv_5021005_021",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "沒有感到沮喪唷。",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "只是在稍微",
    "voice": "vo_adv_5021005_022",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "思考一些事。",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "香織不是說過嗎？",
    "voice": "vo_adv_5021005_023",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "只要是被珍惜的事物，",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "就會有善良的靈魂寄宿其中。",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "這樣是不是表示，",
    "voice": "vo_adv_5021005_024",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "人家給予它們的愛",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "還是不夠呢。",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "人家",
    "voice": "vo_adv_5021005_025",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "每天和它們說話、",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "照顧它們，",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "還以為這樣已經注入許多愛了……",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "這些",
    "voice": "vo_adv_5021005_026",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "所做的一切",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "該不會完全沒傳達給它們吧。",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "難道不是嗎？",
    "voice": "vo_adv_5021005_027",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "　如果它們體內寄宿著善良的靈魂，",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n就不會被壞心的惡靈……",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "奄美魔物給",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "附身了不是嗎？",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "人家從以前到現在",
    "voice": "vo_adv_5021005_028",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "做的這一切",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "全都……",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "咦……",
    "voice": "vo_adv_5021005_029",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生……？",
    "voice": "vo_adv_5021005_030",
    "unit_id": 110611
  },
  {
    "type": "still",
    "still_id": "502100502"
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "好神奇。",
    "voice": "vo_adv_5021005_031",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "直到剛剛都還在想很多事，",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "感到那麼不安。",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "被王子先生",
    "voice": "vo_adv_5021005_032",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "摸頭後，",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n腦中",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "混亂的思緒",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "彷彿受到舒服的微風吹拂。",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "就連胸口",
    "voice": "vo_adv_5021005_033",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "揪心刺痛的那種感覺，",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "也跟著淡化去了，",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "心中充滿溫暖。",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "謝謝您。",
    "voice": "vo_adv_5021005_034",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "果然，",
    "voice": "vo_adv_5021005_035",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生是……",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "人家",
    "voice": "vo_adv_5021005_036",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "非常重要的",
    "voice": null,
