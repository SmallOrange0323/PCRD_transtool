[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "騎士先生？ ",
    "voice": "vo_adv_1002008_000",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "早安呢。今天也是去工作嗎？",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……總覺得太陽很刺眼呢。",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……不對勁呀，不可能這麼刺眼的。",
    "voice": "vo_adv_1002008_001",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "這道光，的確之前也……！",
    "voice": "vo_adv_1002008_002",
    "unit_id": 100211
  },
  {
    "type": "background",
    "bg_id": "510220"
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "（──鐘聲應該還沒響吧……？",
    "voice": "vo_adv_1002008_003",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我還想在最後關頭，把小考的範圍內容重新複習一遍呢……）",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "啊，響了……",
    "voice": "vo_adv_1002008_004",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "（首先看看題目……咦？）",
    "voice": "vo_adv_1002008_005",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "（……我絕對沒看錯。",
    "voice": "vo_adv_1002008_006",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n他，好像沒帶橡皮擦）",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "（真想助他一臂之力……",
    "voice": "vo_adv_1002008_007",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n但現在是考試中，如果被老師發現的話會被罵的呀……）",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "（……不對。這種想法是不行的）",
    "voice": "vo_adv_1002008_008",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "（如果是他的話，",
    "voice": "vo_adv_1002008_009",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n當看到正在煩惱的人的時候，一定會借給那個人的……！）",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "still",
    "still_id": "100200801"
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "吶，{0}……",
    "voice": "vo_adv_1002008_010",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "如果不介意的話……請用這個。",
    "voice": "vo_adv_1002008_011",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "噓……",
    "voice": "vo_adv_1002008_012",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……給你。小心不要被老師發現，靜悄悄地拿走呦。",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "不用在意我。",
    "voice": "vo_adv_1002008_013",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n我還有多一塊橡皮擦。",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "嗯……考試要努力加油呦……",
    "voice": "vo_adv_1002008_014",
    "unit_id": 100231
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "（太好了……）",
    "voice": "vo_adv_1002008_015",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "（……咦？　剛剛給他的橡皮擦，是我平常用的那一塊……？）",
    "voice": "vo_adv_1002008_016",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "（怎……",
    "voice": "vo_adv_1002008_017",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "怎麼辦！　那塊、在那塊橡皮擦上……！）",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "（寫著我喜歡的人的名字……！）",
    "voice": "vo_adv_1002008_018",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "（之前相信網路上的占卜而寫下來的，",
    "voice": "vo_adv_1002008_019",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n之後卻完全忘了啊……！）",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "（明明是我的橡皮擦，如果他發現了上面寫著自己的名字的話",
    "voice": "vo_adv_1002008_020",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n絕對會覺得很奇怪……",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "要想點辦法才行……！）",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "那個……我想跟你，交換那個橡皮擦。",
    "voice": "vo_adv_1002008_021",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "你看，",
    "voice": "vo_adv_1002008_022",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我這邊這個橡皮擦更好用的喔……？",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "沒關係！？",
    "voice": "vo_adv_1002008_023",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……我、",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我這裡可是很有關係呀……！",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "（如果更大聲講話的話會被老師注意到的……",
    "voice": "vo_adv_1002008_024",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "為什麼我會借了那塊橡皮擦給他呢……",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "）",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "不行！別看裡面呀！",
    "voice": "vo_adv_1002008_025",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "（啊……不小心大叫了……",
    "voice": "vo_adv_1002008_026",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "這樣會被老師罵然後要補考了吧……",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……不過沒有被他看到真是太好了呢）",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我給你的禮物，你覺得如何呢？",
    "voice": "vo_adv_1002008_027",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n你有好好的做了個好『夢』嗎？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這是我依照以前的你和優衣的記憶所創造的『夢』……",
    "voice": "vo_adv_1002008_028",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你這種遲鈍個性如果不稍微改一改的話，\\n總有一天會吃大虧的喔？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那麼，就下次再見囉～♪",
    "voice": "vo_adv_1002008_029",
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "嗯嗯……",
    "voice": "vo_adv_1002008_030",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n又是那個夢……？",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "騎士先生……",
    "voice": "vo_adv_1002008_031",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我們兩人，又再次做了同一個夢呢……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "真抱歉，突然發出了那麼大的叫聲……",
    "voice": "vo_adv_1002008_032",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "那塊叫做橡皮擦？的東西裡面的樣子，",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "絕不想被人看到的……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "至於上面寫了些什麼東西呀……",
    "voice": "vo_adv_1002008_033",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "對不起，我也不太記得了……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "但無論如何不想被人看見的這點，我記得很清楚。",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "（嗚嗚……「上面寫著你的名字呀」這種話，怎麼可能說得出口……）",
    "voice": "vo_adv_1002008_034",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……那個占卜，我也來試試看吧。",
    "voice": "vo_adv_1002008_035",
    "unit_id": 100211
  }
]
