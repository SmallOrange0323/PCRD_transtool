    "name": "實況",
    "words": "已經陸續進入4區，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "\\n但是純選手和鈴選手還是",
    "voice": null,
    "unit_id": null
  },
