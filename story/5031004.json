    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "哦，",
    "voice": "vo_adv_5031004_022",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "優花梨選手",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "似乎耐不住酷熱，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "要前往補水站了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "……",
    "voice": "vo_adv_5031004_023",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "不行！　",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "這麼乏味的飲料",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "無法滋潤喉嚨！",
