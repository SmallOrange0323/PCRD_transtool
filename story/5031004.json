    "words": "哇――！　",
    "voice": "vo_adv_5031004_061",
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "好快好快呀――。",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n美美要和小小格里芬先生",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "一起拿下第一名！",
    "voice": null,
    "unit_id": 102011
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "沒想到，美美選手！　",
    "voice": "vo_adv_5031004_062",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "竟然騎著小小格里芬先生",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "衝上山坡了！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "等等！　",
    "voice": "vo_adv_5031004_063",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那樣子犯規了吧！？",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "少女和魔物的友情……",
    "voice": "vo_adv_5031004_064",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "真棒呢……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "聽我說話啦！",
    "voice": "vo_adv_5031004_065",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "只有鈴莓選手一個人被前面的選手拉開了距離，",
    "voice": "vo_adv_5031004_066",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "\\n究竟她還有沒有機會獲勝呢──！？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "唔……",
    "voice": "vo_adv_5031004_067",
    "unit_id": 112111
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "不好意思。",
    "voice": "vo_adv_5031004_068",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "讓您久等了。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "不會不會，",
    "voice": "vo_adv_5031004_069",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "勞駕您過來，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "實在抱歉。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "前幾天洽談時，",
    "voice": "vo_adv_5031004_070",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "鈴莓她……",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "不，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我們的服務員對您失禮了――",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "啊哈哈。",
    "voice": "vo_adv_5031004_071",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "無論是誰都有失敗的時候呢。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "她也盡她所能地努力過了，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n還請轉告她",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "不用介意。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "話說回來，",
    "voice": "vo_adv_5031004_072",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "競速賽的氣氛很熱烈呢。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "是啊。",
    "voice": "vo_adv_5031004_073",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "好像有不少我認識的人也去參加了，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n我也聽了不少實況轉播，聽得很開心呢。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "妳不去加油沒關係嗎？",
    "voice": "vo_adv_5031004_074",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n現在比賽已經進行到4區了……",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "不、",
    "voice": "vo_adv_5031004_075",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "不了。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我得把該做的事做好才行……",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "只有鈴莓選手一個人被前面的選手拉開了距離，",
    "voice": "vo_adv_5031004_076",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "\\n究竟她還有沒有機會獲勝呢──！？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "…………",
    "voice": "vo_adv_5031004_077",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "……那位女僕小姐",
    "voice": "vo_adv_5031004_078",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "好像也參加了呢。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "哈哈，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我每年都很期待競速賽的轉播，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n有認識的人參加的話",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "總覺得很開心。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "前幾天",
    "voice": "vo_adv_5031004_079",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "多虧有像她那樣的人在，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n我才能",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "平靜的和妳進行洽談。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "看到她一心一意的樣子，",
    "voice": "vo_adv_5031004_080",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "就回憶起我的初衷，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n感覺自己也還得多加油一點才行。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n我今天是想告訴妳這些……",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "這麼說……",
    "voice": "vo_adv_5031004_081",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "是的。",
    "voice": "vo_adv_5031004_082",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "關於向育幼院出資一事，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n請務必讓我參與。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "所以，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "妳就快點去幫她加油吧。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "……非常感謝您！",
    "voice": "vo_adv_5031004_083",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "……先失陪了！",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "為了去幫鈴莓加油，咲戀全力地奔跑了起來。",
    "voice": null,
    "unit_id": null
  }
]
