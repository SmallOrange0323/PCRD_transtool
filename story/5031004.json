    "type": "dialogue",
    "name": "實況",
    "words": "沒有出現在中繼站！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "\\n4區選手在準備",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "先行出發了！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "茉莉",
