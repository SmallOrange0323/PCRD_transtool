  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "美美選手",
    "voice": "vo_adv_5031004_018",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "受到火山的熱氣和上坡的影響，",
