  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這種事就是競速賽的樂趣不是嗎？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "在純選手體貼入微的行動下，",
