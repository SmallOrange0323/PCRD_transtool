[
  {
    "type": "background",
    "bg_id": "500200"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "兩個人組成騎空團持續進行活動的吉塔與{0}，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n因為逐漸闖出了名堂，\\n開始過起了忙碌的日子──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "委託的貨物都在這裡了。",
    "voice": "vo_adv_1057009_000",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n可以幫我確認一下",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "有沒有遺漏嗎？",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "我看看……",
    "voice": "vo_adv_1057009_001",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "嗯，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "沒問題。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "\\n謝謝你們。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "來，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "收下這個吧。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "謝謝！",
    "voice": "vo_adv_1057009_002",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "我才該道謝，",
    "voice": "vo_adv_1057009_003",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "你們不只收拾了盤踞在路上的魔物，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "\\n還平安將貨物送達……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "王都傳聞中的騎空團，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "\\n我已經見識到你們有多能幹啦。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "村人",
    "words": "真是令人佩服。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "嘿嘿……",
    "voice": "vo_adv_1057009_004",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "有什麼需要的話，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "可以再委託我們喔。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n那麼就再見啦！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "background",
    "bg_id": "500141"
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "嗯──！",
    "voice": "vo_adv_1057009_005",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "今天又順利完成一件工作了！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "辛苦啦！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "嗯！",
    "voice": "vo_adv_1057009_006",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "因為是高報酬的急件，過程有點辛苦，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "但對方似乎很欣賞我們的表現，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "努力也有代價了。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "最近的",
    "voice": "vo_adv_1057009_007",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "客人幾乎都是直接指名我們的，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n也因此",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "更容易接到高難度的委託了，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n我們要小心別搞砸了。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "回到城鎮後去吃頓大餐，",
    "voice": "vo_adv_1057009_008",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "好好休息吧！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "咦……？",
    "voice": "vo_adv_1057009_009",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "那片雲……",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n還有，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "是我的錯覺嗎……",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "風好像有點……",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "不對，",
    "voice": "vo_adv_1057009_010",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "不是我的錯覺。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "西北方那片雲",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "是雨雲。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "現在風向是東南風，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我們往北走的話，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "就勢必得從那片雨雲下通過。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "雖然會走些遠路，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "但我們能不能從東邊繞回鎮上呢？",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "謝謝。",
    "voice": "vo_adv_1057009_011",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我想說總有一天要上天空飛翔，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n就開始用功研讀氣候相關的知識，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n畢竟這些事情在地上也用得到嘛。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "幸好我有記起來～！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "對啊！",
    "voice": "vo_adv_1057009_012",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "是因為和你一起努力的關係嗎？",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n比起自己一個人讀書，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "跟別人一起讀",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "比較容易記起來呢。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我總有一天要上天空旅行的，",
    "voice": "vo_adv_1057009_013",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n在那之前得好好記住這些知識才行……",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "咦……？",
    "voice": "vo_adv_1057009_014",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "喂、",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "喂！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n你看那邊！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "那該不會是……！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "果然沒錯！",
    "voice": "vo_adv_1057009_015",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "是飛空艇……！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n又可以在這片大陸上",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "飛行了呢……！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "不知道上面載了什麼人……",
    "voice": "vo_adv_1057009_016",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我也好想搭搭看喔。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "真的嗎！？",
    "voice": "vo_adv_1057009_017",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "呃～呃……！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "……等一下！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "剛剛不是我聽錯吧……！？",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "你說請他們讓我們上去，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "是什麼意思……！？",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}向吉塔解釋，\\n最近在開發新型飛空艇的商會，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n跟他有些緣分。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "……太讓我驚訝了！",
    "voice": "vo_adv_1057009_018",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n我本來只覺得你是有點不可思議的人，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n想不到你還認識紫藤商會的人……！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "……我問你喔？",
    "voice": "vo_adv_1057009_019",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "方便的話，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n可以去幫我問一下，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "能不能讓我搭乘看看飛空艇嗎……？",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "不行的話，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "讓我近距離看一下也沒關係……！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "拜託了！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "謝謝！",
    "voice": "vo_adv_1057009_020",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我知道這是強人所難的要求，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我會誠心祈禱",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "奇蹟發生的。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "background",
    "bg_id": "500040"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "之後過了幾天，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}前來拜訪吉塔。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "你好！",
    "voice": "vo_adv_1057009_021",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "莫非是要談",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "上次那件事嗎？",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "……結果，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "如何呢……？",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "不過……？",
    "voice": "vo_adv_1057009_022",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "抱歉突然插嘴，",
    "voice": "vo_adv_1057009_023",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "\\n接下來的事情，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "我想要親自與妳談，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "\\n兩位不介意吧？",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "呃，",
    "voice": "vo_adv_1057009_024",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "請問你是……？",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "忘了先自我介紹，",
    "voice": "vo_adv_1057009_025",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "我是紫藤商會的成員。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "目前負責執掌",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "使用飛空艇的相關貿易。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "你是負責人！？",
    "voice": "vo_adv_1057009_026",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "你、",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "你好！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "嗯，",
    "voice": "vo_adv_1057009_027",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "妳好。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "今天也是個做生意的好日子呢。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "喂，",
    "voice": "vo_adv_1057009_028",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "真是的！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n你怎麼沒先跟我說負責人會過來啊～！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "那麼我們繼續談吧。",
    "voice": "vo_adv_1057009_029",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "關於兩位提出的要求，我有聽大小姐……",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "\\n我是說，跟我們商會關係匪淺的人提起過。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "一開始我以為只是年輕人想要來學習觀摩，",
    "voice": "vo_adv_1057009_030",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "\\n仔細一問才發現，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "居然是最近",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "時常耳聞的騎空團成員要過來啊。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "你們是",
    "voice": "vo_adv_1057009_031",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "為了擁有自己的騎空艇，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "\\n而積極進行活動的對吧？",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "是的！",
    "voice": "vo_adv_1057009_032",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我知道這是條漫長的道路。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "……即使如此，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "總有一天我一定要實現它。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "……妳的眼神十分不錯。",
    "voice": "vo_adv_1057009_033",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "難得有騎空團上門相談，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "\\n對於靠天空做生意的我們來說，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "真是天賜良機。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "於是我們決定……",
    "voice": "vo_adv_1057009_034",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "趁這機會，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "\\n試著讓你們接下",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "飛空艇相關的工作。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "會長也很中意你們的毅力，",
    "voice": "vo_adv_1057009_035",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "並要求我們為",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "大有前途的年輕人提供助力。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "請、",
    "voice": "vo_adv_1057009_036",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "請問……",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "你的意思是！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "既然你們以騎空團為志業，",
    "voice": "vo_adv_1057009_037",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "那麼在空中留下一些成果，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "\\n我想也不是什麼壞事，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "兩位意下如何呢？",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "當然沒問題！",
    "voice": "vo_adv_1057009_038",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我們很樂意接受！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "那真是太感謝了。",
    "voice": "vo_adv_1057009_039",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "只是，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "有一個條件。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "你說條件，",
    "voice": "vo_adv_1057009_040",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "是嗎？",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "是的。",
    "voice": "vo_adv_1057009_041",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "你們兩位必須和我們另外聘請來，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "\\n擔任護衛的飛空艇船員交手，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "展現一下實力。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "航行在空中遭遇魔物襲擊時，",
    "voice": "vo_adv_1057009_042",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "我希望你們不僅要自保，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "\\n還需要保護其他船員。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "若是你們能證明，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "\\n自己擁有這樣的實力，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "這次協議就成立了。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "你們願意接受這條件嗎？",
    "voice": "vo_adv_1057009_043",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "……我們沒有理由拒絕。",
    "voice": "vo_adv_1057009_044",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "請多指教了！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "很好。",
    "voice": "vo_adv_1057009_045",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "那麼就約在明天，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "勞駕兩位前往此處。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "\\n我們會在那裡等候。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "明天……？",
    "voice": "vo_adv_1057009_046",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "明天嗎！？",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "那當然囉。",
    "voice": "vo_adv_1057009_047",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "談生意是越快越有好處。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "那麼，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "我先告辭了。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "……哇～",
    "voice": "vo_adv_1057009_048",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "事情來得太突然，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n我想到什麼就說什麼了……",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "腦袋到現在都還沒轉過來。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "謝謝你去幫我問。",
    "voice": "vo_adv_1057009_049",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "該怎麼說呢，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "才沒幾下功夫就決定了好重要的事……",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "不過現在機會就在眼前，",
    "voice": "vo_adv_1057009_050",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n只能盡全力做好能力所及的事情了吧。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "反正今天也沒有工作，",
    "voice": "vo_adv_1057009_051",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "好好休息以備明天的戰鬥吧。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "你也要調整好身體的狀態喔。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "明天",
    "voice": "vo_adv_1057009_052",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我們倆一起加油吧！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "background",
    "bg_id": "500020"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "隔天，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}與吉塔前往商人他們等候的地點赴約。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "我們已經恭候多時了。",
    "voice": "vo_adv_1057009_053",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "\\n以防萬一，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "最後再讓我提醒兩位一次，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "我們船員頗具實力。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "即使如此，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "你們還是要打嗎？",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "……是的。",
    "voice": "vo_adv_1057009_054",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我們已經下定決心了。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "我明白了。",
    "voice": "vo_adv_1057009_055",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "看樣子你們已經做好萬全準備了。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "商人",
    "words": "喂──！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
