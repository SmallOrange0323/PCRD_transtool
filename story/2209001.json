    "name": "觀眾席的凱留",
    "words": "啊好痛……",
    "voice": "vo_adv_2209001_029",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "觀眾席的凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "觀眾席的凱留",
    "words": "……",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "觀眾席的凱留",
    "words": "不會痛？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "觀眾席的可可蘿",
    "words": "萊拉耶爾殿下的落雷，",
    "voice": "vo_adv_2209001_030",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "觀眾席的可可蘿",
    "words": "\\n能做到只攻擊敵方呢。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "觀眾席的可可蘿",
    "words": "\\n多虧如此……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "觀眾席的普蕾西亞",
    "words": "絲線。",
    "voice": "vo_adv_2209001_031",
    "unit_id": 126111
  },
  {
    "type": "dialogue",
    "name": "觀眾席的普蕾西亞",
    "words": "\\n焦掉了。",
    "voice": null,
    "unit_id": 126111
  },
  {
    "type": "dialogue",
    "name": "觀眾席的可璃亞",
    "words": "萊拉耶爾小姐，",
    "voice": "vo_adv_2209001_032",
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "觀眾席的可璃亞",
    "words": "謝謝妳……！",
    "voice": null,
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "拿娜、鳳凰",
    "words": "得、",
    "voice": "vo_adv_2209001_033",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "拿娜、鳳凰",
    "words": "得救了……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "「──哼。」",
    "voice": "vo_adv_2209001_034",
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "蟲類之輩。",
    "voice": "vo_adv_2209001_035",
    "unit_id": 126512
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n對吾友人，",
    "voice": null,
    "unit_id": 126512
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "以及吾之同盟飛濺出那汙穢的絲線──",
    "voice": null,
    "unit_id": 126512
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n罪該萬死。",
    "voice": null,
    "unit_id": 126512
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "吉歐‧提格尼亞的公主，",
    "voice": "vo_adv_2209001_036",
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "「萊拉耶爾公主」……",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "面對阿剌克涅女士強化過的絲線，",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "有著直接將其燒盡的威力是嗎。",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "不過，",
    "voice": "vo_adv_2209001_037",
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "沒有問題。",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n「傲慢」很消耗能量這點已經調查過了。",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "而且──",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "「別得意忘形，",
    "voice": "vo_adv_2209001_038",
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "傲慢。",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n不過是燒掉數條絲線，",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "就想鄙視吾，真是可笑至極。」",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "「抬頭看吧。",
    "voice": "vo_adv_2209001_039",
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n覆蓋天際的天網，",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "可是毫髮無傷呢。」",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……！",
    "voice": "vo_adv_2209001_040",
    "unit_id": 126512
  },
  {
    "type": "dialogue",
    "name": "被操縱的拿娜",
    "words": "咿咿咿～～！？",
    "voice": "vo_adv_2209001_041",
    "unit_id": 136211
  },
  {
    "type": "background",
    "bg_id": "502180"
  },
  {
    "type": "dialogue",
    "name": "觀眾席的鳳凰",
    "words": "呀──",
    "voice": "vo_adv_2209001_042",
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "觀眾席的鳳凰",
    "words": "呀──！！？",
    "voice": null,
    "unit_id": 134712
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "即便不同世界，",
    "voice": "vo_adv_2209001_043",
    "unit_id": 126512
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "天空一切皆歸吾所有。",
    "voice": null,
    "unit_id": 126512
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126512
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "膽敢撒網築巢，",
    "voice": null,
    "unit_id": 126512
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "無禮至極。",
    "voice": null,
    "unit_id": 126512
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "「崩雷──",
    "voice": "vo_adv_2209001_044",
    "unit_id": 126512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不好意思！",
    "voice": "vo_adv_2209001_045",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n萊拉耶爾請等一下！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "騎士。",
    "voice": "vo_adv_2209001_046",
    "unit_id": 126512
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n以及貪吃佩可公主。",
    "voice": null,
    "unit_id": 126512
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n即便是你們，",
    "voice": null,
    "unit_id": 126512
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "若要阻止吾之神意──",
    "voice": null,
    "unit_id": 126512
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……",
    "voice": "vo_adv_2209001_047",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "是可以的。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "你們果然，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "是為了那座冰像的少女是嗎……？",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "──這種時候，",
    "voice": "vo_adv_2209001_048",
    "unit_id": 129613
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "可沒時間說這些了。",
    "voice": null,
    "unit_id": 129613
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n在被打敗前，",
    "voice": null,
    "unit_id": 129613
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "得先下手為強──",
    "voice": null,
    "unit_id": 129613
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "唔──",
    "voice": "vo_adv_2209001_049",
    "unit_id": 129613
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "──既然如此。",
    "voice": "vo_adv_2209001_050",
    "unit_id": 129613
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n別的手段，",
    "voice": null,
    "unit_id": 129613
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "你有嗎？",
    "voice": null,
    "unit_id": 129613
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n狀況十萬火急喔。",
    "voice": null,
    "unit_id": 129613
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "滿天都是垂下來的絲線，",
    "voice": "vo_adv_2209001_051",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n被操控的大家也正在胡鬧！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n陷入大危機了啦～！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "唔……",
    "voice": "vo_adv_2209001_052",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n怎麼辦才好……",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "「呵呵。",
    "voice": "vo_adv_2209001_053",
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n無需煩惱──",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "去死就好了吧？",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n要是辦不到，",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "就讓吾之絲線來助陣。」",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "大家",
    "words": "──唔！！",
    "voice": "vo_adv_2209001_054",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "…………",
    "voice": "vo_adv_2209001_055",
    "unit_id": 129711
  },
  {
    "type": "still",
    "still_id": "220900102"
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "「萬化‧",
    "voice": "vo_adv_2209001_056",
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "槍鞭。」",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "涅妃‧涅羅小姐！？",
    "voice": "vo_adv_2209001_057",
    "unit_id": 105812
  },
  {
    "type": "still",
    "still_id": "220900103"
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "──萬分抱歉。",
    "voice": "vo_adv_2209001_058",
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n但奴家無法坐視",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "那絲線所致之亂",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "繼續擴大。",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "……涅妃‧涅羅公主。",
    "voice": "vo_adv_2209001_059",
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n竟然能輕易地切斷那絲線……",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "難怪阿剌克涅女士會如此警戒。",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "不過……",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "請稍等一下，",
    "voice": "vo_adv_2209001_060",
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "女士。",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "still",
    "still_id": "220900104"
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "「──怎麼了，",
    "voice": "vo_adv_2209001_061",
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "傳令。",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n要吾稍等，",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "等什麼？」",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "與稍早的建議相同。",
    "voice": "vo_adv_2209001_062",
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n是將那座冰像，",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "以及封在裡面的靈魂破壞一事。",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "可可蘿、凱留",
    "words": "！！",
    "voice": "vo_adv_2209001_063",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "「先前也說過了吧？",
    "voice": "vo_adv_2209001_064",
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n別想指使吾。」",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "那是……",
    "voice": "vo_adv_2209001_065",
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "甘拜下風、",
    "voice": "vo_adv_2209001_066",
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "甘拜下風啊。",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n蜘蛛──",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "汝這番惡毒卑劣，",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家可招架不住。",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n縱有萬般不願，",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "還是得屈身降服呢。",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "與那位姑娘交換，",
    "voice": "vo_adv_2209001_067",
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n要奴家說出",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "城塞之「柱」的封印解法",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "亦可。",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "汝意下如何？",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "「……」",
    "voice": "vo_adv_2209001_068",
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "想當然耳，",
    "voice": "vo_adv_2209001_069",
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "汝之絲線對奴家不管用。",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n若欲掌控鬼岩城塞，",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "要令奴家坦白，可無他法啊？",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "「真意外。",
    "voice": "vo_adv_2209001_070",
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n像妳這般冷血的人，",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "沒想到會提出這種交涉。」",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家對騎士閣下等人，",
    "voice": "vo_adv_2209001_071",
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "欠著還不清的恩情。",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "並且……",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n屆時，",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "便讓汝一併承接",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家的職責吧。",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "「……哼。",
    "voice": "vo_adv_2209001_072",
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n確實，",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "吾對妳背負的事也不是沒有興趣──」",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "…………",
    "voice": "vo_adv_2209001_073",
    "unit_id": 193711
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "background",
    "bg_id": "502180"
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "「……【蠻賊三姊妹】。",
    "voice": "vo_adv_2209001_074",
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n這邊的狀況，",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "就交給妳們處理了。」",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "「……什麼？",
    "voice": "vo_adv_2209001_075",
    "unit_id": 130013
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n妳是要上哪去──」",
    "voice": null,
    "unit_id": 130013
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "「受絲線所操控的魔物和人類，",
    "voice": "vo_adv_2209001_076",
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "不會對妳們出手。",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n請在這裡盡可能地",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "削減公主等人的戰力。」",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "「別無視我的問題啦……",
    "voice": "vo_adv_2209001_077",
    "unit_id": 130013
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "嘖。」",
    "voice": null,
    "unit_id": 130013
  },
  {
    "type": "still",
    "still_id": "220900104"
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "「……哼。",
    "voice": "vo_adv_2209001_078",
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n雖因是未料之事，",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "吾有些許躊躇……」",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "觀眾席的莉莉",
    "words": "……！",
    "voice": "vo_adv_2209001_079",
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "觀眾席的莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "觀眾席的莉莉",
    "words": "如雨般的絲線，",
    "voice": null,
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "觀眾席的莉莉",
    "words": "又來了……",
    "voice": null,
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "觀眾席的可璃亞",
    "words": "要是直接被碰到，",
    "voice": "vo_adv_2209001_080",
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "觀眾席的可璃亞",
    "words": "就大事不妙了……！",
    "voice": null,
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "觀眾席的可璃亞",
    "words": "\\n必須盡可能閃避，",
    "voice": null,
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "觀眾席的可璃亞",
    "words": "或是將其彈開！",
    "voice": null,
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "觀眾席的普蕾西亞",
    "words": "大事不妙。",
    "voice": "vo_adv_2209001_081",
    "unit_id": 126111
  },
  {
    "type": "dialogue",
    "name": "觀眾席的普蕾西亞",
    "words": "\\n危險。",
    "voice": null,
    "unit_id": 126111
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "「……單是用想的，",
    "voice": "vo_adv_2209001_082",
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "就令人光火呢。",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n一想到要吾",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "對妳的提議言聽計從。」",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "…………",
    "voice": "vo_adv_2209001_083",
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "「若妳身為皇女，",
    "voice": "vo_adv_2209001_084",
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "卻無法割捨這些累贅──",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n吾之優勢可說是毫無動搖。",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n吾就操控妳那些化為傀儡的累贅們，",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "將妳粉身碎骨吧。」",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "……與奴家切斷絲線之舉相比，",
    "voice": "vo_adv_2209001_085",
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n汝增加傀儡的速度，",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "要快上些許……",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "不僅如此。",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n不須絲線，",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "竟亦能使人化為汝手中棋子。",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "background",
    "bg_id": "502180"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "呀哈哈哈！！",
    "voice": "vo_adv_2209001_086",
    "unit_id": 130213
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 130213
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "──好了嗎！？",
    "voice": null,
    "unit_id": 130213
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n已經可以攻擊了嗎！？",
    "voice": null,
    "unit_id": 130213
  },
  {
    "type": "dialogue",
    "name": "觀眾席的凱留",
    "words": "糟糕！",
    "voice": "vo_adv_2209001_087",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "觀眾席的凱留",
    "words": "\\n連【蠻賊三姊妹】也……！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "觀眾席的可璃亞",
    "words": "若菜小姐！",
    "voice": "vo_adv_2209001_088",
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "觀眾席的可璃亞",
    "words": "\\n請聽我們說……！",
    "voice": null,
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "……對不起……",
    "voice": "vo_adv_2209001_089",
    "unit_id": 130113
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n……對不起……",
    "voice": null,
    "unit_id": 130113
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "實在是",
    "voice": "vo_adv_2209001_090",
    "unit_id": 130013
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "令人火大……",
    "voice": null,
    "unit_id": 130013
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130013
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "但是。",
    "voice": null,
    "unit_id": 130013
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n可以削弱那些公主們的話……",
    "voice": null,
    "unit_id": 130013
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "我就上吧！",
    "voice": null,
    "unit_id": 130013
  },
  {
    "type": "background",
    "bg_id": "502180"
  },
  {
    "type": "dialogue",
    "name": "公主們",
    "words": "唔",
    "voice": "vo_adv_2209001_091",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "公主們",
    "words": "……！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "唔……",
    "voice": "vo_adv_2209001_092",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "菫……",
    "voice": "vo_adv_2209001_093",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "……我、",
    "voice": "vo_adv_2209001_094",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "我沒事。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "只是",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "手稍微擦到……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n專注精神",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "彈開絲線吧。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "……貪吃佩可公主。",
    "voice": "vo_adv_2209001_095",
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "萊拉耶爾公主。",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "薇歐莉特公主。",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n此等過失，",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "皆乃",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家無德所致。",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "千言萬語不足表達奴家歉意──",
    "voice": "vo_adv_2209001_096",
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "但奴家必會負責了斷。",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "還請趁此空檔，",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "招集觀眾席等人，",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n奴家在此請託了。",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "大家",
    "words": "……！",
    "voice": "vo_adv_2209001_097",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "公主們",
    "words": "「大家！請過來這邊！」\\n「琳德、烏爾姆！來這裡！」",
    "voice": "vo_adv_2209001_098",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "大家",
    "words": "「好！」\\n「是！」\\n「知道了！」「嗯。」",
    "voice": "vo_adv_2209001_099",
    "unit_id": null
  },
  {
