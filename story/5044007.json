    "type": "dialogue",
    "name": "流夏",
    "words": "她、",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "她突然間",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "寫些什麼啊？",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "啊、",
    "voice": "vo_adv_5044007_057",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "啊啊，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "是這樣啊！",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "她或許是在指【暮光流星群】的事吧。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這麼一想",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我就能理解了，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "嗯。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "…………",
    "voice": "vo_adv_5044007_058",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……那、",
    "voice": "vo_adv_5044007_059",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那個啊，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "並沒有",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "什麼",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "奇怪的意思。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n不過我說你……",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你",
    "voice": "vo_adv_5044007_060",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "會有……",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n想和我",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "一直",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "在一起",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "的想法嗎……？",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "兩人",
    "words": "找到啦──！",
    "voice": "vo_adv_5044007_061",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "唔哇啊啊啊！？",
    "voice": "vo_adv_5044007_062",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "咦，",
    "voice": "vo_adv_5044007_063",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "流夏姐！？",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "妳怎麼會在這！？",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那話是我要說的，",
    "voice": "vo_adv_5044007_064",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "麻煩妳們",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "別突然嚇人好嗎！",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n真受不了，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "妳們不是有東西要找嗎？",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "沒有啦，",
    "voice": "vo_adv_5044007_065",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "應該說剛好找到了……",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "妳說剛好找到……",
    "voice": "vo_adv_5044007_066",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "是指這個",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "發光的竹子？",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n妳們到底",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "是為什麼要找這種東西？",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "那個～",
    "voice": "vo_adv_5044007_067",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我們是想找來送給流夏姐當禮物。",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n這個啊，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "似乎是一種叫作「祈願竹」",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "的特別竹子。",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我們弄壞了釣竿，",
    "voice": "vo_adv_5044007_068",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "妳拿這個去做一把新的吧。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n我們無論如何",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "都想為那件事賠罪……",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "所以，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "那個……",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "兩人",
    "words": "對不起～！！",
    "voice": "vo_adv_5044007_069",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我不是說過不用介意了嗎？",
    "voice": "vo_adv_5044007_070",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "難道說，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這趟度假也是為了這個……？",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "嗯。",
    "voice": "vo_adv_5044007_071",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "是為了得到「祈願竹」",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "才來這裡的～",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我們想",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "送給流夏姐當驚喜呀☆",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "明明不需要這麼大費周章啊。",
    "voice": "vo_adv_5044007_072",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……不過，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我覺得這次有來度假",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "真的太好了。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "也讓我看到了妳們可靠的一面，",
    "voice": "vo_adv_5044007_073",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n我心裡",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "對妳們印象稍微改觀了。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "真的！？",
    "voice": "vo_adv_5044007_074",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "妳明白七七香是正義的超級無敵可愛天才魔法少女了！？",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "原來如此！",
    "voice": "vo_adv_5044007_075",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n也就是說，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "流夏也要加入我的",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n熾炎戰鬼煉獄血盟暗黑團是吧！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "要是妳們不會像這樣得寸進尺就更好了，",
    "voice": "vo_adv_5044007_076",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "真是的。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……以後若是，",
    "voice": "vo_adv_5044007_077",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我又遇到只憑自己也束手無策的問題，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n屆時",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就讓我依靠妳們吧。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "請多指教。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "嗯，",
    "voice": "vo_adv_5044007_078",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "交給我吧！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n妳就儘管來依靠",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "本人安妮羅潔‧馮‧修特帕魯吧！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "不管是什麼大小事，",
    "voice": "vo_adv_5044007_079",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "全都交給七七香吧☆",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "啊，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "當然也要麻煩流夏姐",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "讓我依靠囉～",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "哈哈，",
    "voice": "vo_adv_5044007_080",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "可別太愛向我撒嬌喔？",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……好，",
    "voice": "vo_adv_5044007_081",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "七夕也開始了。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我們也去參加祭典，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "盡情地大玩一番吧！",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "流夏、杏奈與七七香快樂的笑聲，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n迴盪在七夕的星空下。",
    "voice": null,
    "unit_id": null
  },
