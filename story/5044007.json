  {
    "type": "dialogue",
    "name": "旁白",
    "words": "面對面站在銀河上的織女與牛郎，牽起了彼此的手──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "越過了橫渡宇宙的銀河，",
    "voice": "vo_adv_5044007_000",
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "我倆於此相見。",
    "voice": null,
    "unit_id": 4811
  },
