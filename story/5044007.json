    "type": "dialogue",
    "name": "牛郎",
    "words": "真的非常謝謝你們。",
    "voice": "vo_adv_5044007_006",
    "unit_id": 4711
  },
  {
    "type": "dialogue",
    "name": "牛郎",
    "words": "\\n若只靠我們，",
    "voice": null,
    "unit_id": 4711
  },
