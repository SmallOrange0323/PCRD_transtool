    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "妳今後也要作為宿星之星姬",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "認真精進喔。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "若是感到迷惘時，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "就向真正的「自己」",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "述說便是。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "嗯，",
    "voice": "vo_adv_5044007_009",
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "那當然。",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "\\n杏奈大人教導的這份信念，",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "織女",
    "words": "我絕不會忘記。",
    "voice": null,
    "unit_id": 4811
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "某種意義上，",
    "voice": "vo_adv_5044007_010",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "感覺多虧了花心星，",
