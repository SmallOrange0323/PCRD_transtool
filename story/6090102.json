  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "雖然我是像這樣成為怪盜了……",
    "voice": "vo_adv_6090102_000",
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "但、",
    "voice": null,
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "但老實說，",
    "voice": null,
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我沒什麼自信……",
    "voice": null,
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "對怪盜而言，",
    "voice": null,
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "重要的是什麼事呢……？",
    "voice": null,
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "是、",
    "voice": "vo_adv_6090102_001",
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "是這樣嗎？",
    "voice": null,
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "像是鋼索槍",
    "voice": null,
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "或煙霧彈，",
    "voice": null,
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n帆稀小姐她有幫我準備了各式各樣的道具……",
    "voice": null,
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "但我不覺得自己能熟練使用那些道具……",
    "voice": null,
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我",
    "voice": null,
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "能夠做得下去嗎……",
    "voice": null,
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "就是說呢……",
    "voice": "vo_adv_6090102_002",
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "如果被人發現自己潛入，",
    "voice": null,
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n要偷寶物就會變得非常困難了……",
    "voice": null,
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "希、",
    "voice": null,
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "希望能夠在這裡好好發揮……",
    "voice": null,
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我不引人注目的能力……",
    "voice": null,
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "嘉夜小姐、",
    "voice": "vo_adv_6090102_003",
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "帆稀小姐、",
    "voice": null,
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "前輩……",
    "voice": null,
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "還有",
    "voice": null,
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "祈梨……",
    "voice": null,
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我有這些",
    "voice": null,
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "非常值得信任的夥伴……！",
    "voice": null,
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我雖然很沒用……",
    "voice": null,
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "但如果和夥伴一起……",
    "voice": null,
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "或許總會有辦法的……！",
    "voice": null,
    "unit_id": 121511
  }
]
