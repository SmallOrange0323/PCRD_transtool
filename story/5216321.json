[
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "呀啊！？",
    "voice": "vo_adv_5216321_000",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n突然有砲彈飛過來是怎樣！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……嗯。",
    "voice": "vo_adv_5216321_001",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n是擅長砲擊的魔物們呢。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "真穗",
    "words": "原來如此，",
    "voice": "vo_adv_5216321_002",
    "unit_id": 139311
  },
  {
    "type": "dialogue",
    "name": "真穗",
    "words": "是小型的自走砲啊。",
    "voice": null,
    "unit_id": 139311
  },
  {
    "type": "dialogue",
    "name": "真穗",
    "words": "\\n看起來沒有人為操控，",
    "voice": null,
    "unit_id": 139311
  },
  {
    "type": "dialogue",
    "name": "真穗",
    "words": "\\n是自動型的嗎？",
    "voice": null,
    "unit_id": 139311
  },
  {
    "type": "dialogue",
    "name": "艾麗卡",
    "words": "看來敵人打算以量取勝呢。",
    "voice": "vo_adv_5216321_003",
    "unit_id": 139411
  },
  {
    "type": "dialogue",
    "name": "艾麗卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 139411
  },
  {
    "type": "dialogue",
    "name": "艾麗卡",
    "words": "以火力壓制對手",
    "voice": null,
    "unit_id": 139411
  },
  {
    "type": "dialogue",
    "name": "艾麗卡",
    "words": "可是黑森峰的拿手好戲。",
    "voice": null,
    "unit_id": 139411
  },
  {
    "type": "dialogue",
    "name": "艾麗卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 139411
  },
  {
    "type": "dialogue",
    "name": "艾麗卡",
    "words": "就讓你們好好體會一下，",
    "voice": null,
    "unit_id": 139411
  },
  {
    "type": "dialogue",
    "name": "艾麗卡",
    "words": "半吊子的作戰方式是行不通的！",
    "voice": null,
    "unit_id": 139411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好的！",
    "voice": "vo_adv_5216321_004",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我們是不會輸的！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "真穗",
    "words": "只需不斷前進。",
    "voice": "vo_adv_5216321_005",
    "unit_id": 139311
  },
  {
    "type": "dialogue",
    "name": "真穗",
    "words": "\\n以短期決戰為目標吧。",
    "voice": null,
    "unit_id": 139311
  },
  {
    "type": "dialogue",
    "name": "真穗",
    "words": "殲滅對方！",
    "voice": null,
    "unit_id": 139311
  }
]
