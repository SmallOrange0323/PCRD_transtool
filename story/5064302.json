[
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "找到了～！",
    "voice": "vo_adv_5064302_000",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "是神祕暗黑組織憂妮們！",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "這可是大發現！",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "話說也太好笑。",
    "voice": "vo_adv_5064302_001",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n憂妮們",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "完全復活了嘛。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "哼，",
    "voice": "vo_adv_5064302_002",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "區區的小垃圾還會自我修復，還真是令人不快。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n該說是不愧能四處逃跑到現在嗎。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "魔力的流動甚至比剛才都還要流暢。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "講白一點就是很強嗎？",
    "voice": "vo_adv_5064302_003",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "是啊，",
    "voice": "vo_adv_5064302_004",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "講白一點就是很強。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "那個～",
    "voice": "vo_adv_5064302_005",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "打倒之後就復活又變強，",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n不覺得這個套路很眼熟嗎？",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "確實。",
    "voice": "vo_adv_5064302_006",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n滿滿都是又來了的感覺。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "具體來說合計第三次。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "就是啊。",
    "voice": "vo_adv_5064302_007",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n如同被世界的既定法則玩弄一樣，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "真是無趣。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "那我們就必須要",
    "voice": "vo_adv_5064302_008",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n脫離這名為套路的命運輪迴才行。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "各位，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "要連半點碎片都不留，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "徹底擊潰！",
    "voice": null,
    "unit_id": 116411
  }
]
