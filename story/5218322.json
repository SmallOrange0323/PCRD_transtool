  },
  {
    "type": "dialogue",
    "name": "鮫肌牙之丞",
    "words": "\\n和我交往吧，",
    "voice": null,
    "unit_id": 13711
  },
  {
    "type": "dialogue",
    "name": "鮫肌牙之丞",
    "words": "露易絲瑪莉！！！",
    "voice": null,
    "unit_id": 13711
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "我就說了不要……",
    "voice": "vo_adv_5218322_001",
    "unit_id": 139911
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "呀啊！！",
    "voice": null,
    "unit_id": 139911
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "雖然說愛情就像颶風，",
    "voice": "vo_adv_5218322_002",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "但像這樣無差別的四處作亂，",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n還真令人受不了呢……！",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "現在只能撐住等待反擊的機會了……",
    "voice": "vo_adv_5218322_003",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "露易絲瑪莉小姐，",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "那邊沒問題嗎！？",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "哼……",
    "voice": "vo_adv_5218322_004",
    "unit_id": 139911
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "我可是無法觸碰達令，",
    "voice": null,
    "unit_id": 139911
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n一～",
    "voice": null,
    "unit_id": 139911
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "直在忍著呢！",
    "voice": null,
    "unit_id": 139911
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n對這忍耐的集合體，",
    "voice": null,
    "unit_id": 139911
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "露易絲瑪莉大人問這個真是太愚蠢了！",
    "voice": null,
    "unit_id": 139911
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……呵呵，",
    "voice": "vo_adv_5218322_005",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "又創造奇怪的頭銜了！",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "來吧來吧，",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "要上囉──！！",
    "voice": null,
    "unit_id": 140011
  }
