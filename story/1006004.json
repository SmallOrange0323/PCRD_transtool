  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "來到平原的茜里與{0}，\\n被突如其來的光芒包圍。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "什、什麼，這個光是什麼！？",
    "voice": "vo_adv_1006004_000",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "哥哥！",
    "voice": "vo_adv_1006004_001",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n茜里很害怕……呀啊啊啊！",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "？",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "background",
    "bg_id": "510070"
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "呼、呼，哥哥，太激烈了啦。",
    "voice": "vo_adv_1006004_002",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n茜里",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "已經……喘、喘不過氣了！",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "對、對不起……",
    "voice": "vo_adv_1006004_003",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n茜里稍、稍微休息一下喔……",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "呼……呼……",
    "voice": "vo_adv_1006004_004",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "哥哥，這真是太猛了啦……",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "雖然很高興哥哥能陪茜里",
    "voice": "vo_adv_1006004_005",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n練習薩克斯風。",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "因為哥哥很會教人，",
    "voice": "vo_adv_1006004_006",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "所以茜里也變得這麼會吹了喔。",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "這樣的話，下個禮拜的儀隊公開演奏，",
    "voice": "vo_adv_1006004_007",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n茜里搞不好能順利表演……",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "可是，那個……",
    "voice": "vo_adv_1006004_008",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n茜里還是不太有自信……",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "……而且，演奏最高潮的地方",
    "voice": "vo_adv_1006004_009",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里還不太熟……",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "因為這邊……",
    "voice": "vo_adv_1006004_010",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "手指頭的動作非常激烈……",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里還不太能駕馭……",
    "voice": "vo_adv_1006004_011",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n所以無法持續到最後。",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "要茜里現在在這裡做一次嗎？",
    "voice": "vo_adv_1006004_012",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n在哥哥面前？",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "可、可是，我會害羞啊。",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里很討厭失敗……",
    "voice": "vo_adv_1006004_013",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n而且……",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n這、這樣硬來……",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里會害怕。",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "……欸？",
    "voice": "vo_adv_1006004_014",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n若是我的話，沒問題嗎……？",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "……真、真的嗎？",
    "voice": "vo_adv_1006004_015",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "……我知道了。",
    "voice": "vo_adv_1006004_016",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "既然哥哥都這麼說了……",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "在哥哥面前會心跳加速，",
    "voice": "vo_adv_1006004_017",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n所以很難冷靜呢……",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "我知道了。",
    "voice": "vo_adv_1006004_018",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "我會加油的 ♪",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "………………",
    "voice": "vo_adv_1006004_019",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "太……太厲害了！",
    "voice": "vo_adv_1006004_020",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里照著哥哥說的話做，就能吹到最後了！",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "能吹到最後……是第一次。",
    "voice": "vo_adv_1006004_021",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "如果是茜里一個人的話，就算到正式演出，",
    "voice": "vo_adv_1006004_022",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n我想我還是沒有自信……",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "可是多虧了哥哥，",
    "voice": "vo_adv_1006004_023",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "讓我知道我也能吹到最後！",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "所以真的很",
    "voice": "vo_adv_1006004_024",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n謝謝哥哥。",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "可是只用說的，好像不太能表達",
    "voice": "vo_adv_1006004_025",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n茜里的謝意……",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "如果有什麼好方法就好了……",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "有了，哥哥！",
    "voice": "vo_adv_1006004_026",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n這次的回禮，",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里就用身體來支付！",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里要為哥哥，",
    "voice": "vo_adv_1006004_027",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n演奏一曲喔！",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "呵呵 ♪",
    "voice": "vo_adv_1006004_028",
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "請好好地聽茜里的演奏喔？",
    "voice": null,
    "unit_id": 100631
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "如何呢？這是我給你的禮物！你做了個好「夢」嗎？",
    "voice": "vo_adv_1006004_029",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "剛剛的情景，是我依照你和茜里的「記憶碎片」",
    "voice": "vo_adv_1006004_030",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n創造出來的「夢」唷。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n很懷念嗎？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "嗯，還不清楚啊。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "如果你收集到更多的「記憶碎片」，",
    "voice": "vo_adv_1006004_031",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n我就會再讓你做「夢」的。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你和許多女孩在一起的「夢」做得越多……",
    "voice": "vo_adv_1006004_032",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n就可以藉此還原世界的真實面貌。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "要加油喔♪",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那麼，下次見囉～ ♪",
    "voice": "vo_adv_1006004_033",
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500140"
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "嗯……？",
    "voice": "vo_adv_1006004_034",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里該不會是睡著了吧……？",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "怎麼覺得好像夢見了不可思議的夢……",
    "voice": "vo_adv_1006004_035",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "……咦？",
    "voice": "vo_adv_1006004_036",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n哥哥也夢到跟茜里一起練習薩克斯風的夢了？",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "我們能夢到相同的夢，",
    "voice": "vo_adv_1006004_037",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "真是不可思議的事情呢。",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "哥哥一直以來教了茜里很多事情，",
    "voice": "vo_adv_1006004_038",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n就連在夢中也被哥哥教導……",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "如果沒有哥哥的話，",
    "voice": "vo_adv_1006004_039",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n茜里應該是活不下去呢 ♪",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "嘿嘿，茜里說真的喔？",
    "voice": "vo_adv_1006004_040",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "對了，所以說哥哥！",
    "voice": "vo_adv_1006004_041",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "趕快繼續多教茜里一些事情吧？",
    "voice": null,
    "unit_id": 100611
  }
]
