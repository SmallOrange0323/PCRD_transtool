[
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "閒得發慌的{0}無所事事地漫步於街上時，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在路的前方發現了朝自己走來的嘉夜。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "受不了，",
    "voice": "vo_adv_1065009_000",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "該怎麼辦才好……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "唉……",
    "voice": "vo_adv_1065009_001",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "是你啊……",
    "voice": "vo_adv_1065009_002",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "要怎麼說才好咧？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我想想……",
    "voice": "vo_adv_1065009_003",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "就……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我剛剛在想點事情啦。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "那麼，",
    "voice": "vo_adv_1065009_004",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我要去那邊了。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n再見啦。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "唔～呣……",
    "voice": "vo_adv_1065009_005",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不用啦，",
    "voice": "vo_adv_1065009_006",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你不需要這麼替我操心……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "喂！",
    "voice": "vo_adv_1065009_007",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "別推我！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n好啦，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我會讓你送的！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "所以你不必那樣子推我！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "background",
    "bg_id": "500890"
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我說啊，",
    "voice": "vo_adv_1065009_008",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "雖然我剛才沒講，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n不過回到地盤這點小事，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我一個人也是能做到的喔……？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不，",
    "voice": "vo_adv_1065009_009",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這一點算是",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你的優點",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "吧。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "送了我一程，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "真是多謝你啦。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……",
    "voice": "vo_adv_1065009_010",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "那個，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你現在有空嗎？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n我有一件事想跟你聊聊。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "其實啊……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "最近",
    "voice": "vo_adv_1065009_011",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "完全沒有架可以打啊。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "之前",
    "voice": "vo_adv_1065009_012",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不是用上覺醒的力量，打了一場架嗎？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "拜那場架所賜，我聲名大噪，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "但同時間也讓周遭的人怕我怕得要死。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "再加上，幫派那邊",
    "voice": "vo_adv_1065009_013",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "也完全安定下來了。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "世界",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "非常和平。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "當然",
    "voice": "vo_adv_1065009_014",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "也是會有小紛爭之類的事情喔？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "只不過，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我可不能特地出馬去處理那種小事，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n而且底下那些傢伙也需要點能活躍的場面，不是嗎？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "就結果而言，",
    "voice": "vo_adv_1065009_015",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我失去了大顯身手的揮拳擂臺。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "好不容易快要掌握到的覺醒感受，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "也感覺要消失得無影無蹤了。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "畢竟我除了鍛鍊自己以外，就沒其他事可做了，",
    "voice": "vo_adv_1065009_016",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n到了空閒時間，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我就會像飢渴的魔物一樣徘徊在城鎮裡。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "唉……",
    "voice": "vo_adv_1065009_017",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "真是沒轍啊。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這樣下去的話，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "感覺不管對象是誰，我都會揍下去。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "是啊是啊，",
    "voice": "vo_adv_1065009_018",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "經由你介紹的工作也沒了喔？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "所以說，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "「走到窮途末路」就是我的現況……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "謝謝你",
    "voice": "vo_adv_1065009_019",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "願意聽我說這些。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n我今天會在城鎮裡多晃一下看看的。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你回家時可要注意安全啊。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這樣好嗎？",
    "voice": "vo_adv_1065009_020",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你自己也有事要忙吧？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你的好意我就心領了……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這樣啊……",
    "voice": "vo_adv_1065009_021",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "呵呵。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n你這位死黨果然是",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "最棒的！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……說是",
    "voice": "vo_adv_1065009_022",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這麼說啦，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n但我們現在能做的事",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "跟之前沒什麼兩樣吧。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "就是到處露個臉，",
    "voice": "vo_adv_1065009_023",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n找找看哪邊可能會發生騷動。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "總之，",
    "voice": "vo_adv_1065009_024",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "呆站在這裡也無濟於事。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "有句俗話叫",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "滴水",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "什麼石的，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "那我們",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "就出發吧！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在那之後，兩人在蘭德索爾漫步而行，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n向許多人搭了話。但是──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "哦～",
    "voice": "vo_adv_1065009_025",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "是嘉夜！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "嗯？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "麻煩事？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "託你的福，那些事已經被處理得乾乾淨淨啦！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n這也要感謝嘉夜喔！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "之後又發生什麼事的話，就再麻煩你們了！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "打手",
    "words": "呃！",
    "voice": "vo_adv_1065009_026",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "打手",
    "words": "嘉夜！",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "打手",
    "words": "妳有什麼事？",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "打手",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "打手",
    "words": "……",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "打手",
    "words": "妳問我有沒有什麼困擾！？",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "打手",
    "words": "我當然很困擾啊！",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "打手",
    "words": "我這邊啊，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "打手",
    "words": "\\n因為輸給了妳，生意都做不起來了！",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "打手",
    "words": "快給我走開！",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "最近完全沒聽說過",
    "voice": "vo_adv_1065009_027",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "有誰陷入了麻煩之中呢。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n要是一直都這麼和平就好了……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "嗯？",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "怎麼了嗎？",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "對了，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "你們要是碰上麻煩隨時和我說啊。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我會幫忙的。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "好、",
    "voice": "vo_adv_1065009_028",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "好的……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "謝謝你。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "唉……",
    "voice": "vo_adv_1065009_029",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "還真是什麼事都沒發生呢。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我已經束手無策了。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "至於你……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "呃，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "連問都不用問了啊。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不過",
    "voice": "vo_adv_1065009_030",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "試著實際走過一遭，你就明白了吧？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "最近都是這個樣子啊。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "就算知道這樣不好，",
    "voice": "vo_adv_1065009_031",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我還是希望能發生點事件。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "畢竟在這裡主動引發事端，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我覺得有點不太對……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "──很痛耶！",
    "voice": "vo_adv_1065009_032",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "妳連走路要看路這點小事都做不到嗎！",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "今天搞不好中獎了喔！",
    "voice": "vo_adv_1065009_033",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我們過去看看吧！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "對、",
    "voice": "vo_adv_1065009_034",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "對不起，",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "我剛剛在想一點事情……",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "所以就可以撞人嗎！",
    "voice": "vo_adv_1065009_035",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "\\n",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "我還真是被妳看扁了啊！",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "喂喂喂，",
    "voice": "vo_adv_1065009_036",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "她都道歉了，你就原諒她吧。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n她又不是抱著惡意去撞你的，對吧？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "嘉夜！？",
    "voice": "vo_adv_1065009_037",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "是、",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "是啊，",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "妳說得對。",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "\\n好了，",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "既然妳已經道歉了，妳就走吧。",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "咦……？",
    "voice": "vo_adv_1065009_038",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "啊，",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "好、",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "好的……",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "\\n對不起……",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你在幹什麼啊！",
    "voice": "vo_adv_1065009_039",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "妳說幹什麼……",
    "voice": "vo_adv_1065009_040",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "就是照妳說的放她走啊。",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我是要你不要照著我的話去做啊！",
    "voice": "vo_adv_1065009_041",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "為啥啊！？",
    "voice": "vo_adv_1065009_042",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "\\n",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "……",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "哼哼──",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "我猜",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "妳是想做打手的工作對吧？",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "是啊，沒錯。",
    "voice": "vo_adv_1065009_043",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你有意見嗎？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "不，",
    "voice": "vo_adv_1065009_044",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "沒什麼。",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "但在事情演變成那樣之前，",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "就由我退讓一步吧。",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "\\n",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "畢竟我可不是妳的對手。",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "話是這麼說沒錯……",
    "voice": "vo_adv_1065009_045",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "但惡人可以輕易地放低身段嗎？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "在妳是對手的情況下，哪能去在意面子啊。",
    "voice": "vo_adv_1065009_046",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "\\n打架不挑對手，",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "那只是個笨蛋而已。",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "我有說錯嗎？",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……",
    "voice": "vo_adv_1065009_047",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "說得對。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這樣的話，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我就只是個笨蛋而已。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "我知道啊。",
    "voice": "vo_adv_1065009_048",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "像我們這種狡猾的人啊，",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "\\n最怕的就是那樣子的笨蛋，",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "所以才沒辦法和妳打。",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "\\n",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "就這樣啦。",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "下次就讓我在妳不在的地方",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "做壞事吧。",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "小心別鬧到讓人要叫打手來喔──！",
    "voice": "vo_adv_1065009_049",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "算了，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "就是會變成這樣呢。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "background",
    "bg_id": "500021"
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "唉～",
    "voice": "vo_adv_1065009_050",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "要是哪裡有",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n和我差不多程度的笨蛋在就好了。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……打手這工作，",
    "voice": "vo_adv_1065009_051",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "或許是時候可以到此為止了吧。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "畢竟這或許也是時代的潮流，",
    "voice": "vo_adv_1065009_052",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "還是把心思花在幫派上吧……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "就說你不用在意了啦。",
    "voice": "vo_adv_1065009_053",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "光是你有心想幫忙，就讓我很開心了。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "要是沒有你在身邊，",
    "voice": "vo_adv_1065009_054",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n我就會那樣一直獨自煩惱。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "所以……",
    "voice": "vo_adv_1065009_055",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "謝謝你。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我總是受到你幫助。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……要是",
    "voice": "vo_adv_1065009_056",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
