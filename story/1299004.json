    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n好像在對{0}大人送秋波呢。",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "恐怕是她對機器動了手腳，",
    "voice": "vo_adv_1299004_028",
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "打算讓我蒙羞吧。",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n既然妳打算這麼做，",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "那我就徹底毀了妳……",
