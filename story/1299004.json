    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "是指這個吧……",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "打中了！",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n您看到了嗎？",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我打倒那個討厭的活死人了！",
