    "voice": "vo_adv_1299004_029",
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "…失禮了。",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "有點興奮過頭了。",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n很抱歉，",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "能請您從頭開始教我嗎？",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "準心？",
    "voice": "vo_adv_1299004_030",
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "原來如此，",
