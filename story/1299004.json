    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "background",
    "bg_id": "510120"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "──從格鬥遊戲玩到賽車遊戲，",
    "voice": "vo_adv_1299004_043",
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "接著是節奏遊戲和夾娃娃機。",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "最後，",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "兩人在回家路上買了可麗餅來吃。",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "若是沒有和您相遇，",
    "voice": "vo_adv_1299004_044",
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "這些事我永遠不會了解。",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n實在太開心了。",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我啊，",
    "voice": "vo_adv_1299004_045",
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "通常自己一個人就能完成大部分的事，",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n所以很少有機會向別人請教。",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "但是，",
    "voice": "vo_adv_1299004_046",
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "向別人學習會讓世界更開闊。",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n也是有這種事的呢。",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "一直以來，",
    "voice": "vo_adv_1299004_047",
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "不管您的意願如何，",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n為了您好，",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我一直都在指導您。",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我一點也不覺得那樣是錯的，",
    "voice": "vo_adv_1299004_048",
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "也沒有感到後悔。",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "但現在我發現到，",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "這樣的行動，",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "有點太片面了。",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "既然自稱是伴侶，",
    "voice": "vo_adv_1299004_049",
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "就不能只有我自己感到開心。",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "必須也讓您學得開心才行。",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "……",
    "voice": "vo_adv_1299004_050",
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "您真的",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "是很溫柔的人呢。",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "但是，",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "如果是真正相愛的兩人，",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "互相學習各種事情，",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n並加深對彼此的理解，",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "一定也是必要的。",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "因為，",
    "voice": "vo_adv_1299004_051",
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "今天能向您學習，",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n真的讓我非常非常開心。",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "好，",
    "voice": "vo_adv_1299004_052",
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "當然了。",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "不過──",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "為了不讓好不容易拉上來的成績又掉下去，",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n有必要定期來讀書。",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "剛好明天開始是連假，",
    "voice": "vo_adv_1299004_053",
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "正適合兩個人一起度過呢。",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我會既深入",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "又甜蜜地",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "徹底指導您的。",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "敬請期待。",
    "voice": "vo_adv_1299004_054",
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "嘻嘻，",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "嘻嘻嘻。",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好的好的，",
    "voice": "vo_adv_1299004_055",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "辛苦了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "看到了很有意思的東西呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "惠理子啊，",
    "voice": "vo_adv_1299004_056",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "看她平常既兇狠，能力又好，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n所以很容易忘了她其實也只是個十幾歲的女孩子呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "無論她多強、多優秀，",
    "voice": "vo_adv_1299004_057",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "也絕對不是完美的。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "知道惠理子的強大與恐怖，",
    "voice": "vo_adv_1299004_058",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "同時也曉得她的弱點，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n卻還願意待在她身邊的人",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "應該並不多。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我本以為這是盲目的信仰所產生的瘋狂之愛，",
    "voice": "vo_adv_1299004_059",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "但看來，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那孩子還是相當地",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "有眼光呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我想你今後還會遇到很多折騰的事，",
    "voice": "vo_adv_1299004_060",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "就好好加油吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "下次見～",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "嗯……",
    "voice": "vo_adv_1299004_061",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "唉呀，",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我竟然在外面",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "打瞌睡了，",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "看來我不知不覺間似乎累積了很多疲勞呢。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "但是，",
    "voice": "vo_adv_1299004_062",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "夢境裡真是太美好了。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "因為夢中的您教會了我很多事情！",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "嘻嘻，",
    "voice": "vo_adv_1299004_063",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "您這番話可真奇怪呢。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "完全偏離重點了喔，",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "大人。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我很不擅長與人交流。",
    "voice": "vo_adv_1299004_064",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n能稱得上是夥伴的就只有公會的大家而已。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "不過這並沒有什麼好困擾的，",
    "voice": "vo_adv_1299004_065",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n因為一直以來我都是靠自己去解決各種事情。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "然而，",
    "voice": "vo_adv_1299004_066",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我遇見了您，",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "並選擇為您盡心盡力，",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n結果讓我累積了很多的經驗。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "而您之前說過，",
    "voice": "vo_adv_1299004_067",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "希望我多與人交流。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n這句話的意思，",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我現在也明白了。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "藉由接觸您和公會夥伴以外的人，",
    "voice": "vo_adv_1299004_068",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "會讓我產生新的想法，",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "能得到過去的我",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "無法想像的意外體悟。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "在指導他人的同時，",
    "voice": "vo_adv_1299004_069",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我自己也學到了很多。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n讓我注意到這點的，",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "不是他人，正是您啊。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "也就是說，",
    "voice": "vo_adv_1299004_070",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "您不僅是我最愛的人，",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n更是最優秀的教官。",
    "voice": null,
