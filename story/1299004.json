    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "就是要攻擊敵人對吧？",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "就讓我親手發射禮炮，",
    "voice": "vo_adv_1299004_026",
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "開創我們的未來吧！",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "still",
    "still_id": "129900401"
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "……奇、",
    "voice": "vo_adv_1299004_027",
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "奇怪？",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "完全",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "射不中呢……？",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n看來好像是壞掉了……",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "對了，現在想起來，",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
