    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "原來如此，",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "只要往畫面外射擊就能裝填子彈了呀。",
