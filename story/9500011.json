    "words": "那個，",
    "voice": null,
    "unit_id": 102941
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "{0}。",
    "voice": null,
    "unit_id": 102941
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n你願意等我嗎？",
    "voice": null,
    "unit_id": 102941
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "等我成為名副其實的頂尖偶像，",
    "voice": null,
    "unit_id": 102941
  },
