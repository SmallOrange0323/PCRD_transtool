[
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "對手明明非～常強大，",
    "voice": "vo_adv_5152323_000",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "但是我意外地不覺得會輸呢。",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "因為在這個海邊，",
    "voice": "vo_adv_5152323_001",
    "unit_id": 132111
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "有跟我們一起戰鬥的夥伴們。",
    "voice": null,
    "unit_id": 132111
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "打擾拉姆休息的你死期到了呢，",
    "voice": "vo_adv_5152323_002",
    "unit_id": 109812
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "白島鯨。",
    "voice": null,
    "unit_id": 109812
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "莉雅，",
    "voice": "vo_adv_5152323_003",
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "妳來發號施令吧！",
    "voice": null,
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "帕克，",
    "voice": "vo_adv_5152323_004",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "那不是要由我來的──",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "──昴。",
    "voice": "vo_adv_5152323_005",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "拜託你了！",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "雖然我也沒有做什麼事──",
    "voice": "vo_adv_5152323_006",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "但是既然指名我了，",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "愛蜜莉雅醬！",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "好啦，小子們！",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "呃……這群人裡男的也太少了吧！？",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "算、",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "算了！",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "所有人──",
    "voice": "vo_adv_5152323_007",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "打倒牠吧！",
    "voice": null,
    "unit_id": 2713
  }
]
