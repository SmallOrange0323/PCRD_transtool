[
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "以四季為主題的能力，",
    "voice": "vo_adv_5201321_000",
    "unit_id": 133811
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "是吧。",
    "voice": null,
    "unit_id": 133811
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n還真是花費心思製作出來的魔物呢。",
    "voice": null,
    "unit_id": 133811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "因為是真那用心特製的呀～",
    "voice": "vo_adv_5201321_001",
    "unit_id": 133711
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n當然不可能會放水的。",
    "voice": null,
    "unit_id": 133711
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "強度的部分也格外精緻。",
    "voice": "vo_adv_5201321_002",
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我想起教授打算做多餘調整的時候",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n兩人之間那股一觸即發的氣氛了。",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……教授這個人，",
    "voice": "vo_adv_5201321_003",
    "unit_id": 133811
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "就是喜歡調整戰鬥平衡呢。",
    "voice": null,
    "unit_id": 133811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "但他的強度基準太奇怪，",
    "voice": "vo_adv_5201321_004",
    "unit_id": 133711
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "多半都會被重新調整就是了。",
    "voice": null,
    "unit_id": 133711
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133711
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "不對，",
    "voice": null,
    "unit_id": 133711
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "回憶時間就到此為止，",
    "voice": null,
    "unit_id": 133711
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "要趕快解決掉才行。",
    "voice": null,
    "unit_id": 133711
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "哼，",
    "voice": "vo_adv_5201321_005",
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不需要妳們出手。",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "看我用壓倒性的力量制伏牠……！",
    "voice": null,
    "unit_id": 133911
  }
]
