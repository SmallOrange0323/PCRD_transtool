[
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嗚、",
    "voice": "vo_adv_9052156_000",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嗚嗚…………",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "貪吃佩可小姐，",
    "voice": "vo_adv_9052156_001",
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "妳沒事吧？",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n有哪裡",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "受傷了嗎……！？",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嗚嗚嗚，",
    "voice": "vo_adv_9052156_002",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "在剛才戰鬥的忙亂之中，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n難得拿到的肉好像被魔物偷走了的樣子……",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n而且最關鍵的魔物也逃走了……",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "抽泣。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那個……",
    "voice": "vo_adv_9052156_003",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "還、",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "還真可惜啊～？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "但是",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "既然不見了也沒辦法了嘛，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗯。",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n……我我、",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我才沒有覺得高興哦？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊──",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "真的好可惜啊～♪",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "──那個，",
    "voice": "vo_adv_9052156_004",
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "可可蘿小姐，",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "既然這樣，",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "就表示並非",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n祭壇的精靈",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "在發狂或是生氣對嗎？",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是的。",
    "voice": "vo_adv_9052156_005",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "此處的精靈",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "自古以來，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n似乎一直守護著村莊不被魔物侵襲。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但是，",
    "voice": "vo_adv_9052156_006",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "因為剛才的魔物阻撓，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "使得參拜者減少，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n作為精靈食糧的祈禱",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "以及供奉都無法進行……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "那麼，",
    "voice": "vo_adv_9052156_007",
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "它剛才襲擊我們、",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "還有盯上貪吃佩可小姐的肉也是……",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "恐怕",
    "voice": "vo_adv_9052156_008",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是要讓人無法供奉食物、",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n以妨礙為目的吧。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n為了不讓衰弱的精靈",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "取回力量。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "呃，",
    "voice": "vo_adv_9052156_009",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "也就是說……",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n精靈餓得肚子空空",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "而使不上力的意思嗎？",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "正是如此。",
    "voice": "vo_adv_9052156_010",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n村民們的供奉……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下認為只要有能給精靈的供品，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n精靈就能恢復力量了。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "供品啊……",
    "voice": "vo_adv_9052156_011",
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "但是",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我們目前手邊有的食物",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "看來似乎完全不夠。",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n畢竟好像很久",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "都沒有人來供奉它了。",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那麼，",
    "voice": "vo_adv_9052156_012",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "回村莊",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "重新準備應該比較好吧。",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "但若是雪菲想成為供品的話",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就沒差了──",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "咦？",
    "voice": "vo_adv_9052156_013",
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我、",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我才不要。",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "那種事就交給凱留了。",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小凱留成為供品太浪費了啦～！",
    "voice": "vo_adv_9052156_014",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "對了，小可蘿，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "精靈",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "也會吃魔物之類的嗎？",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n雖然沾滿沙子了，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但至少還剩下一點……",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "哇噗！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "咳",
    "voice": "vo_adv_9052156_015",
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "咳！",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "好、",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "好強的",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "沙塵……！",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "看來似乎不合它胃口的樣子。",
    "voice": "vo_adv_9052156_016",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這是當然的吧！",
    "voice": "vo_adv_9052156_017",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "真是的──",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "在我們再繼續",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n把精靈惹火之前，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "先回村莊吧！",
    "voice": null,
    "unit_id": 106011
  }
]
