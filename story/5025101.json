  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 111211
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "說不定可以拿到很高級的點心唷？",
    "voice": null,
    "unit_id": 111211
  },
