    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "最喜歡{0}先生的手……",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n最喜歡",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "{0}先生了。",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我也想守護這份溫暖的心意……",
    "voice": "vo_adv_9500031_012",
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我們走吧，{0}先生！",
