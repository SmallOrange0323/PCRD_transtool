  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "嗎？",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不是其他人嗎……？",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "咦……",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "咦咦咦咦咦咦！？",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不、",
    "voice": "vo_adv_9500031_001",
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不！",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我完全沒有討厭的意思！",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "雖然並不討厭，",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "但真的讓我嚇了一跳……",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "因為",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我只是個女僕啊！？",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "而且我",
    "voice": "vo_adv_9500031_002",
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "總是冒冒失失的，",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n剛才",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "魔法還失控了……",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "將世界的命運",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "託付給這樣的我，",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "真的沒問題嗎！？",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "冒冒失失、",
    "voice": "vo_adv_9500031_003",
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "又是個普通女孩子的",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我嗎……？",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "……其實",
    "voice": "vo_adv_9500031_004",
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "呢，",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n沒想到除了女僕的工作以外，",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我還能幫上忙，",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我真的很開心。",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我以前",
    "voice": "vo_adv_9500031_005",
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "一直認為，",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "能夠拯救世界的，",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n都是像大小姐那樣",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "了不起的人。",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不過，",
    "voice": "vo_adv_9500031_006",
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "像我這樣的冒失女僕，",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n和重要的人一起",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "拯救世界……",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "就算偶爾出現這樣的故事，",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "也挺好的吧？",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "那個，",
    "voice": "vo_adv_9500031_007",
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "{0}先生……",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n可以請你握住我的手嗎？",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "雖然我會盡全力加油，",
    "voice": "vo_adv_9500031_008",
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "但果然還是有點緊張……",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "要是我不小心搞砸了，",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不就大事不妙了嗎！",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不過，",
    "voice": "vo_adv_9500031_009",
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "只要你能握著我的手，",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我就覺得自己能努力下去！",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n所以……",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "所以……！",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "哇哇！",
    "voice": "vo_adv_9500031_010",
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "謝謝你！",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "……呵呵，",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "好溫暖呢。",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我",
    "voice": null,
    "unit_id": 102541
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "總是受到這雙手的幫助。",
    "voice": null,
    "unit_id": 102541
  },
  {
