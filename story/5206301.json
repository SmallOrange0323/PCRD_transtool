[
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "厄莉絲小姐的闇影……",
    "voice": "vo_adv_5206301_000",
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n真有氣勢啊……",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "面具。",
    "voice": "vo_adv_5206301_001",
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n好可怕。",
    "voice": null,
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n很嚇人。",
    "voice": null,
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……唯獨在這個空間裡，",
    "voice": "vo_adv_5206301_002",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "力量被增強了呢。",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "妳們後退一點。",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n這裡，",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "就由我來──",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "不，",
    "voice": "vo_adv_5206301_003",
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我們也要戰鬥。",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "雖然發生過很多事，",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "但如今也成為能談心的夥伴了。",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "嗯。",
    "voice": "vo_adv_5206301_004",
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n合作。",
    "voice": null,
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n沒問題。",
    "voice": null,
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "是嗎……",
    "voice": "vo_adv_5206301_005",
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 135011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "要來了。",
    "voice": null,
    "unit_id": 135011
  }
]
