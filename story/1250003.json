    "words": "真不可思議……！",
    "voice": "vo_adv_1250003_093",
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "大家都變得樂觀積極了。",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n我明明沒有親眼見到，",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "卻有這樣的感覺！",
