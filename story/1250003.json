[
  {
    "type": "background",
    "bg_id": "500031"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在「幸福的卡里斯瑪」事件結束之後，矛依未依舊精力充沛地",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n為了解放浮現樂園餘波的居民而四處奔走。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "唔哇～",
    "voice": "vo_adv_1250003_000",
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "天都已經黑了！",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n時間未免過得太快了！",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "雖說嘉夜和望同樣也有所行動……",
    "voice": "vo_adv_1250003_001",
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "但樂園的餘波還是一直出現，",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "光是四處奔走，今天一天就結束了。",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "讓我再次",
    "voice": "vo_adv_1250003_002",
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "體會到",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "人們無法從回憶中逃離",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "笨蛋，",
    "voice": "vo_adv_1250003_003",
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我怎麼可能會在這種地方放棄！",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n別小看壞蛋了！",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "不過啊，",
    "voice": "vo_adv_1250003_004",
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "照這樣下去真的會沒完沒了……",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "只要人們持續放不下回憶，",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我們的活動永遠無法結束。",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "要是就這樣持續把時間耗在解放上，",
    "voice": "vo_adv_1250003_005",
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我成為世界第一大壞蛋的未來，",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "也會漸行漸遠。",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我到底",
    "voice": "vo_adv_1250003_006",
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "該如何是好……",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "那麼，",
    "voice": "vo_adv_1250003_007",
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "今天也開始進行解放吧──",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "主婦",
    "words": "妳聽說了嗎？",
    "voice": "vo_adv_1250003_008",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "主婦",
    "words": "食堂的老闆",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "主婦",
    "words": "已經康復了。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "哎呀，是這樣嗎？",
    "voice": "vo_adv_1250003_009",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "聽說那個人也像道具店老闆那樣",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n變得無法工作，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "我一直很擔心他。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "主婦",
    "words": "他那裡還有一個年幼的孩子，",
    "voice": "vo_adv_1250003_010",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "主婦",
    "words": "真是太好了。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "具有相同症狀的人似乎還有很多，",
    "voice": "vo_adv_1250003_011",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "希望大家都能早日康復。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……喂，",
    "voice": "vo_adv_1250003_012",
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你有聽到剛才的對話吧？",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n我記得食堂的老闆",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "應該還沒解放……",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "有可能！",
    "voice": "vo_adv_1250003_013",
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n我們去看一下情況吧！",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "background",
    "bg_id": "500020"
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "爸爸～",
    "voice": "vo_adv_1250003_014",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "快點快點！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "我要丟下你了喔！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "喂喂，",
    "voice": "vo_adv_1250003_015",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "妳不要太興奮了。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "這樣會跌倒吧？",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "因為",
    "voice": "vo_adv_1250003_016",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "我很高興爸爸恢復健康了嘛！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "……啊，",
    "voice": "vo_adv_1250003_017",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "原來是這樣啊。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "抱歉，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "爸爸",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "太丟臉了……",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "爸爸，",
    "voice": "vo_adv_1250003_018",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "你是生病了吧？",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "這也是沒辦法的事。",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "……不對，",
    "voice": "vo_adv_1250003_019",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "那才不是生病。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "\\n爸爸我之前啊，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "無法從自己所珍視的回憶中",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "脫身。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "我想要永遠待在這裡。",
    "voice": "vo_adv_1250003_020",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "\\n",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "那是個會讓我產生這種想法，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "非常幸福的時光。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "那麼，",
    "voice": "vo_adv_1250003_021",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "為什麼你能夠回來呢？",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "這是因為啊，",
    "voice": "vo_adv_1250003_022",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "有妳在我的身邊喔。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "我？",
    "voice": "vo_adv_1250003_023",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "是啊。",
    "voice": "vo_adv_1250003_024",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "我想要看見妳長大成人的未來，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "我想要和妳一起創造新的回憶。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "\\n",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "我產生這個想法後，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "就自然而然地從回憶中成功脫身了。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "原來是這樣啊。",
    "voice": "vo_adv_1250003_025",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "那我會永遠待在爸爸的身邊，",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "\\n",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "爸爸要永～",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "遠",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "看著我喔♪",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "好，",
    "voice": "vo_adv_1250003_026",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "當然沒問題。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……原來那個大叔",
    "voice": "vo_adv_1250003_027",
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "真的是自行從回憶中脫身的。",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "不對，",
    "voice": "vo_adv_1250003_028",
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "因為我們得到了特別的力量，",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n感覺似乎有點麻痺了……",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "說起來，人類",
    "voice": "vo_adv_1250003_029",
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "就算沒有什麼特別的力量，",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n也都擁有",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "開拓未來的力量。",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "即使",
    "voice": "vo_adv_1250003_030",
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "獨自一人前行會有困難，",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n和他人一起的話，說不定就能辦到。",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我有",
    "voice": "vo_adv_1250003_031",
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "尾狗刀這個夥伴，",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n他的存在",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "成了我邁向未來的力量。",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "對那個大叔來說",
    "voice": "vo_adv_1250003_032",
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "是自己的孩子，",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n其他還有",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "兄弟姊妹、",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "朋友和",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "戀人，",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "不對，",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "說不定並不侷限於人類。",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "寵物、興趣和",
    "voice": "vo_adv_1250003_033",
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "工作，",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "因為珍視的事物",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "因人而異嘛。",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "人類",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "為了邁向未來，",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "某樣珍視的事物",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "是不可或缺的。",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "和某位珍視的人，",
    "voice": "vo_adv_1250003_034",
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "或者是，",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "和某樣事物一起邁向未來。",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我認為",
    "voice": "vo_adv_1250003_035",
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "讓大家都能普通做到",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這種理所當然的事情，",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n才是我們必須要做的",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "真正的解放吧。",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "但是現在，",
    "voice": "vo_adv_1250003_036",
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "樂園的力量和",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "回憶",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "正在阻撓這份力量。",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "因為回憶無法消除，",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這件事才難以解決……",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……就是這個，",
    "voice": "vo_adv_1250003_037",
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "就是這個！",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你，",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這句話說得對極了！",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這份力量是將人從樂園中解放與",
    "voice": "vo_adv_1250003_038",
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "抵抗樂園的力量吧？",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "所以，",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "只要大家同樣擁有抵抗力，",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "應該就能邁向未來！",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "但是，",
    "voice": "vo_adv_1250003_039",
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我們得到力量時的做法",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "已經不能用了。",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n這麼一來……",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "總之，",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "別無選擇了吧。",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我說，{0}，能幫我一個忙嗎？",
    "voice": "vo_adv_1250003_040",
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n幫我把嘉夜和望找來。",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "background",
    "bg_id": "500020"
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "呦，",
    "voice": "vo_adv_1250003_041",
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "矛依未。",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n好久不見了，",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這是自祭典結束以來，第一次見面吧？",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n不過，",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我也有聽聞妳的活躍表現喔。",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我們聽說",
    "voice": "vo_adv_1250003_042",
    "unit_id": 124812
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "矛依未也",
    "voice": null,
    "unit_id": 124812
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "很努力進行樂園的解放後，",
    "voice": null,
    "unit_id": 124812
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n也都充滿了幹勁呢。",
    "voice": null,
    "unit_id": 124812
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這點我也一樣！",
    "voice": "vo_adv_1250003_043",
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n我要是一個人肯定束手無策，",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "妳們真是幫了大忙！",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "話說回來，",
    "voice": "vo_adv_1250003_044",
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "妳們找到",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "解決現狀的方法了嗎？",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……很遺憾。",
    "voice": "vo_adv_1250003_045",
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "目前為止，",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我好像",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "一直忙於應付眼前的狀況。",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我也一樣。",
    "voice": "vo_adv_1250003_046",
    "unit_id": 124812
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "雖然心想有什麼好主意就好了，",
    "voice": null,
    "unit_id": 124812
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n但遲遲想不出方法……",
    "voice": null,
    "unit_id": 124812
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我們也是偶然獲得這份力量。",
    "voice": "vo_adv_1250003_047",
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n現在還是有很多不清楚的事情。",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "那麼，",
    "voice": "vo_adv_1250003_048",
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "要是我說",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我有妙計解決，",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "妳們會怎麼做？",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n解決由亞斯來和未菈起頭的，",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這個「樂園」的所有一切。",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……原來如此，",
    "voice": "vo_adv_1250003_049",
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這就是妳找我們來的理由吧。",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "如果真的辦得到的話，",
    "voice": "vo_adv_1250003_050",
    "unit_id": 124812
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我當然願意幫忙！",
    "voice": null,
    "unit_id": 124812
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "就算是要",
    "voice": "vo_adv_1250003_051",
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "放棄這份解放之力，",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "妳也願意嗎？",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "咦？",
    "voice": "vo_adv_1250003_052",
    "unit_id": 124812
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "妳說",
    "voice": "vo_adv_1250003_053",
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "放棄……",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "矛依未，",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "妳打算做什麼？",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我要將我們的力量",
    "voice": "vo_adv_1250003_054",
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "分給鎮上居民。",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這麼一來，",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "大家都會擁有抵抗樂園的力量，",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n就能預防再次",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "被囚禁在回憶中！",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "只不過，",
    "voice": "vo_adv_1250003_055",
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我一個人可能無法顧及鎮上的所有居民。",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "所以，我也要拜託妳們。",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "妳們覺得如何？",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "矛依未，",
    "voice": "vo_adv_1250003_056",
    "unit_id": 124812
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這真是一個驚人的點子呢。",
    "voice": null,
    "unit_id": 124812
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 124812
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不過，",
    "voice": null,
    "unit_id": 124812
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這種事根本用不著猶豫吧。",
    "voice": null,
    "unit_id": 124812
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "沒錯，",
    "voice": "vo_adv_1250003_057",
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "矛依未、望，",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "就這麼辦吧。",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n我們和他們的因緣",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "也要在此劃下句點。",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "嗯，",
    "voice": "vo_adv_1250003_058",
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "雖然很感謝妳們……",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "但這麼乾脆地答應好嗎？",
    "voice": null,
    "unit_id": 125012
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "因為這份力量",
    "voice": "vo_adv_1250003_059",
    "unit_id": 124812
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "本來就像是矛依未給我們的東西呢。",
    "voice": null,
    "unit_id": 124812
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n我想要尊重矛依未的想法，",
    "voice": null,
    "unit_id": 124812
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 124812
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "而且如果是為了拯救鎮上居民，",
    "voice": null,
    "unit_id": 124812
  },
  {
