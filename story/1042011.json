[
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "那一天{0}",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n看到獨自走在街上的千歌。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "唉……",
    "voice": "vo_adv_1042011_000",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "該怎麼辦才好呢？",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "呀！",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "對、",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "對不起……",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n咦？",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "啊……",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "你好，{0}。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "啊……",
    "voice": "vo_adv_1042011_001",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "你聽到",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我的自言自語了啊……",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "那個，",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "能請你聽我聊聊嗎？",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "最近慈樂之音的人氣上升，",
    "voice": "vo_adv_1042011_002",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n音響盤的銷量和",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "演唱會的來場人數",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "也很穩定提升。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "但受到這個影響，",
    "voice": "vo_adv_1042011_003",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "除了過去的唱歌和演唱會活動外，",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n像演戲",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "拍寫真之類的工作邀約，",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "也開始變多了。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "慈樂之音是偶像，",
    "voice": "vo_adv_1042011_004",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n所以會有這類的工作",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "也是理所當然的。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "這些工作如果能有助於慈樂之音的發展，",
    "voice": "vo_adv_1042011_005",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n我認為應該去做才對。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "而且粉絲們也應該會很高興……",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "啊，",
    "voice": "vo_adv_1042011_006",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "陽光照下來了。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "奇怪？",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "怎麼莫名地耀眼……",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "奇怪？",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "這不是太陽光……！？",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "呀～！",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "background",
    "bg_id": "510150"
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "歡迎光臨，{0}。",
    "voice": "vo_adv_1042011_007",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n現在立刻替你準備座位，",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "請你稍等一下。",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "今天稍晚",
    "voice": "vo_adv_1042011_008",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "會有定期演唱會，",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "所以客人很多。",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "如果不介意，也請你聽聽看喔。",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "呼……",
    "voice": "vo_adv_1042011_009",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "啊，",
    "voice": "vo_adv_1042011_010",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "對不起。",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "讓你久等了，",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "請坐這邊的位子。",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "你要點……",
    "voice": "vo_adv_1042011_011",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "咖啡對吧。",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我明白了。",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "唉……",
    "voice": "vo_adv_1042011_012",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "對、",
    "voice": "vo_adv_1042011_013",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "對不起！",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我在發呆……",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "不小心盯著",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "今天表演的海報看得出神了。",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "今天唱歌的人是",
    "voice": "vo_adv_1042011_014",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我很憧憬的歌手。",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "所以我",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "有點小興奮……",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "很、",
    "voice": "vo_adv_1042011_015",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "很高興能聽你這麼說，",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n但我還差得遠了……",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "不過……",
    "voice": "vo_adv_1042011_016",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "希望總有一天自己也能",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "站上那個舞台……",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "對不起，",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我立刻去準備咖啡過來。",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "background",
    "bg_id": "510150"
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "……久等了，",
    "voice": "vo_adv_1042011_017",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "這是你的咖啡。",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "咦？",
    "voice": "vo_adv_1042011_018",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我的表情很嚴肅？",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "……其實這是我剛才聽店長說的，",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n預定要上台表演的歌手，",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "因為突然生病而無法到場了。",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "現在也很難找到人代演……",
    "voice": "vo_adv_1042011_019",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n不曉得",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "演唱會該怎麼辦……",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "你、",
    "voice": "vo_adv_1042011_020",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "你在說什麼啊！",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我怎麼可能有辦法",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "代替那位歌手上台唱歌。",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "這、",
    "voice": "vo_adv_1042011_021",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "這個我也……",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我也、",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "很想",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "讓你看。",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n可是……",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "……",
    "voice": "vo_adv_1042011_022",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "真不可思議。",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "聽到你這麼說以後，",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我就覺得自己應該做得到。",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n你總是能用真誠的話語",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "來打動我。",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "很高興",
    "voice": "vo_adv_1042011_023",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "你願意相信我和",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我唱的歌……",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我也想回應",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "你的話語，",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "不對，",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是必須回應才對！　",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "謝謝你，{0}。",
    "voice": "vo_adv_1042011_024",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "要試試看。",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "老實說",
    "voice": "vo_adv_1042011_025",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
