    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "在做什麼啊！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你們也來游泳啊！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "現在明明是觀光旺季，不曉得為何沒有其他遊客～",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n這裡被我們包場囉！",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "一個人孤零零地漂浮在寬廣的大海中，",
    "voice": "vo_adv_1078002_036",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n讓人感到莫名地寂寞，所以你們快點過來！",
