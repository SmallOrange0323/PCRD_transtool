    "voice": "vo_adv_1078002_050",
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我的手環裡已經放了幾樣應該會需要的東西，",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n只要有需要，就能使用魔法取出來啦。",
    "voice": null,
    "unit_id": 107811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嘿……",
