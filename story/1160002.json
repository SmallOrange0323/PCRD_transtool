  {
    "type": "dialogue",
    "name": "旁白",
    "words": "為了製作花祭用的花冠，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}與真步再次來到了",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n真步真步王國的庭園。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "今天也是",
    "voice": "vo_adv_1160002_000",
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "好天氣呢。",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "走出公會小屋，",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "到真步真步王國的庭園來",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "真是正確的選擇♪",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "今天",
    "voice": "vo_adv_1160002_001",
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "終於要用摘的花",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "來做花冠了。",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "編法",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "人家會教您，",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "不用擔心。",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "就先把",
    "voice": "vo_adv_1160002_002",
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "上次摘的花排在這邊……",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生，",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "人家先編給您看。",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "就請您照人家的做法",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "來編。",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "首先是",
    "voice": "vo_adv_1160002_003",
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "拿起兩枝花，",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "讓它們交錯。",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "然後",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "把其中一枝的莖",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "捲在另一枝花上……",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "說得也是，",
    "voice": "vo_adv_1160002_004",
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "面對面",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "的確不好懂呢。",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "那",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "人家就坐到王子先生的旁邊吧。",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "……呵呵，",
    "voice": "vo_adv_1160002_005",
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "離王子先生這麼近，",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n讓人有點",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "害羞起來了呢。",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "但是",
    "voice": "vo_adv_1160002_006",
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "春天也才剛到來，",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "像這樣靠在一起，",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n應該比較溫暖才對……",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "說笑的♪",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生，",
    "voice": "vo_adv_1160002_007",
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "您很厲害呢♪",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "已經完成",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "目標的一半了呢。",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "呵呵，",
    "voice": "vo_adv_1160002_008",
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "說什麼老師，太誇張了啦。",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "那接下來",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "就把剩下的一半……",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "哎呀？",
    "voice": "vo_adv_1160002_009",
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "那個呀，",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生……",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n那個正在走過來的人，",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "不是",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "上次那位獸人少年嗎？",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "……",
    "voice": "vo_adv_1160002_010",
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "看你那麼沮喪的樣子，",
    "voice": "vo_adv_1160002_011",
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "是怎麼了嗎？",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "今天",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "朋友沒有跟著一起來，",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "發生什麼事了？",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "……我",
    "voice": "vo_adv_1160002_012",
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "好像再也",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "沒辦法見到她了。",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "咦！？",
    "voice": "vo_adv_1160002_013",
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "到底",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "是發生了什麼事？",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "……我們吵架了。",
    "voice": "vo_adv_1160002_014",
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "她的爸爸是",
    "voice": "vo_adv_1160002_015",
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "商人。",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "\\n之所以來蘭德索爾也是為了做生意，",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "\\n接下來",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "又要去別的城市了。",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "我",
    "voice": "vo_adv_1160002_016",
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "原本以為",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "她會一直待在這裡。",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "\\n",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "所以她跟我說這些的時候，我大受打擊……",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "就吵起來了。",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "但是",
    "voice": "vo_adv_1160002_017",
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "我馬上就覺得後悔，",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "跑去她家想道歉，",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "\\n",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "卻被她爸",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "趕了出來……",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "這樣啊……",
    "voice": "vo_adv_1160002_018",
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "果然是",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "「羅密歐與茱麗葉」呢。",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n面對悄悄培育出愛的兩人，",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n命運之神",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "是不會",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "放過他們的呢……",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "這樣下去的話，",
    "voice": "vo_adv_1160002_019",
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "他們明明就互有心意，",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "卻錯身而過",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "就此永別。",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n直到在天國重逢，",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "才終於能夠廝守……",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "不行。",
    "voice": "vo_adv_1160002_020",
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "那可不行啊。",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n在人家仍活在這世上的期間，",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "絕不允許",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "那種悲傷的結局！",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "雖、",
    "voice": "vo_adv_1160002_021",
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "雖然不太明白……",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "\\n",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "我",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "也討厭不能和好就分開。",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "但是，",
    "voice": "vo_adv_1160002_022",
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "她爸",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "真的很恐怖耶。",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "\\n",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "……還有她，",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "她搞不好也不想見到我……",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "如果",
    "voice": "vo_adv_1160002_023",
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "不去向本人確認，",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n就無法明白吧。",
    "voice": null,
    "unit_id": 116011
  },
  {
