[
  {
    "type": "background",
    "bg_id": "501610"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "正在挑戰「爆紅之夏」中的{0}和班比。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n兩人天天過著和裝置螢幕大眼瞪小眼的日子──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "哎唷～～",
    "voice": "vo_adv_1402003_000",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "討厭！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "好煩喔！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n班比受夠了！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "最近",
    "voice": "vo_adv_1402003_001",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "一直都在操作這個小板子，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比已經膩了啦！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "人家暫時不想再碰這東西了──！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "誰叫這陣子",
    "voice": "vo_adv_1402003_002",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "早上一起來就得看裝置，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "中午也是，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "晚上也一樣……",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n根本一整天都在盯著它嘛！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "看得眼睛都乾乾的了！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "真的嗎？",
    "voice": "vo_adv_1402003_003",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "太棒了！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "謝謝僕從──！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "那麼，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "就久違地把貝斯也叫來，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "一起去泳池玩♡",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "走吧♪",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "background",
    "bg_id": "502920"
  },
  {
    "type": "dialogue",
    "name": "貝斯",
    "words": "呀嗚──！",
    "voice": "vo_adv_1402003_004",
    "unit_id": 8312
  },
  {
    "type": "dialogue",
    "name": "貝斯",
    "words": "呀噗──♪",
    "voice": null,
    "unit_id": 8312
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "嘿嘿。",
    "voice": "vo_adv_1402003_005",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "貝斯看起來非常興奮呢。",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n今天決定來玩真是太好了──！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "立刻就一起去游泳吧♪",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "監視員",
    "words": "啊──",
    "voice": "vo_adv_1402003_006",
    "unit_id": 1413
  },
  {
    "type": "dialogue",
    "name": "監視員",
    "words": "我說",
    "voice": null,
    "unit_id": 1413
  },
  {
    "type": "dialogue",
    "name": "監視員",
    "words": "你們幾個。",
    "voice": null,
    "unit_id": 1413
  },
  {
    "type": "dialogue",
    "name": "監視員",
    "words": "\\n不要帶寵物",
    "voice": null,
    "unit_id": 1413
  },
  {
    "type": "dialogue",
    "name": "監視員",
    "words": "進泳池啊，這樣我們很困擾。",
    "voice": null,
    "unit_id": 1413
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "咦？",
    "voice": "vo_adv_1402003_007",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "貝斯不是寵物呀？",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "貝斯可是班比的朋友──！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "監視員",
    "words": "唔～嗯，",
    "voice": "vo_adv_1402003_008",
    "unit_id": 1413
  },
  {
    "type": "dialogue",
    "name": "監視員",
    "words": "就算妳這麼說，我也沒辦法啊。",
    "voice": null,
    "unit_id": 1413
  },
  {
    "type": "dialogue",
    "name": "監視員",
    "words": "\\n雖然很可憐，",
    "voice": null,
    "unit_id": 1413
  },
  {
    "type": "dialogue",
    "name": "監視員",
    "words": "但規定就是規定。",
    "voice": null,
    "unit_id": 1413
  },
  {
    "type": "dialogue",
    "name": "監視員",
    "words": "就麻煩",
    "voice": null,
    "unit_id": 1413
  },
  {
    "type": "dialogue",
    "name": "監視員",
    "words": "遵守一下囉。",
    "voice": null,
    "unit_id": 1413
  },
  {
    "type": "dialogue",
    "name": "貝斯",
    "words": "呀嗚……",
    "voice": "vo_adv_1402003_009",
    "unit_id": 8312
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "還想說好不容易可以大家一起玩的……",
    "voice": "vo_adv_1402003_010",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n這下怎麼辦呀……",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "僕從，",
    "voice": "vo_adv_1402003_011",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "這邊這邊～",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "去森林散步了。",
    "voice": "vo_adv_1402003_012",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "牠說想去找些水果摘回來。",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "畢竟就算待在這裡",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "也沒辦法游泳，想必很無聊吧。",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "在等牠回來的這段時間，",
    "voice": "vo_adv_1402003_013",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "要不要和班比一起游泳？",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n……",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "咦？",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "僕從，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "你不太擅長游泳呀？",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "這樣的話，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "唔～嗯……",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "啊，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "漂在那邊的東西",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "是什麼呀？",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "對吧，",
    "voice": "vo_adv_1402003_014",
    "unit_id": 1013
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "甜心，",
    "voice": null,
    "unit_id": 1013
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "跟我說的一樣吧？",
    "voice": null,
    "unit_id": 1013
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "\\n現在這年頭",
    "voice": null,
    "unit_id": 1013
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "已經不流行來泳池游泳了啦。",
    "voice": null,
    "unit_id": 1013
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "真的耶，達令！",
    "voice": "vo_adv_1402003_015",
    "unit_id": 51311
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "\\n像這樣悠哉地漂浮在水上，",
    "voice": null,
    "unit_id": 51311
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "感覺可以把日常都拋在腦後呢。",
    "voice": null,
    "unit_id": 51311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "欸欸！",
    "voice": "vo_adv_1402003_016",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "你們坐的那個",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "可以浮在水上的東西是什麼呀～？",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "這個嗎？",
    "voice": "vo_adv_1402003_017",
    "unit_id": 1013
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "這個叫漂浮泳圈。",
    "voice": null,
    "unit_id": 1013
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "\\n",
    "voice": null,
    "unit_id": 1013
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "泳圈有各種造型，",
    "voice": null,
    "unit_id": 1013
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "可以在那邊的店家租借喔。",
    "voice": null,
    "unit_id": 1013
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "漂浮泳圈……！",
    "voice": "vo_adv_1402003_018",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "原來還有這種東西呀！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "這樣的話不會游泳也沒關係了呢！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比要趕快去借♪",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "那就",
    "voice": "vo_adv_1402003_019",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "開始吧♪",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n先讓泳圈漂浮在泳池上，然後再──",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "嘿！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "哇──♪",
    "voice": "vo_adv_1402003_020",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比成功坐上去囉，僕從！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n……",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "咦，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "奇怪？",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "總覺得",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "不太像是在「漂浮」，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "更像是「晃來晃去」……",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "呀啊！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "這個泳圈的",
    "voice": "vo_adv_1402003_021",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "形狀感覺好怪……",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "好難坐穩耶──？",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "這樣沒辦法在泳池裡漂來漂去呀──",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "哦？",
    "voice": "vo_adv_1402003_022",
    "unit_id": 1013
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "小妹妹。",
    "voice": null,
    "unit_id": 1013
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "妳立刻就跑去借泳圈啦？",
    "voice": null,
    "unit_id": 1013
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "\\n……",
    "voice": null,
    "unit_id": 1013
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "噢，",
    "voice": null,
    "unit_id": 1013
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "妳選了涅普堤利昂造型啊。",
    "voice": null,
    "unit_id": 1013
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "這款平衡不太穩，評價不太好喔。",
    "voice": null,
    "unit_id": 1013
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "今天遊客很多，",
    "voice": "vo_adv_1402003_023",
    "unit_id": 51311
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "其他造型的泳圈似乎都被借光了啊──",
    "voice": null,
    "unit_id": 51311
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "\\n",
    "voice": null,
    "unit_id": 51311
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "幾乎只剩",
    "voice": null,
    "unit_id": 51311
  },
  {
