    "unit_id": 8312
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "那麼，",
    "voice": "vo_adv_1402003_045",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "我們就來開個蘋果派對吧！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "啊，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "不過得先從泳池裡面出來才行……",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "監視員",
    "words": "喔，",
    "voice": "vo_adv_1402003_046",
    "unit_id": 1413
  },
  {
    "type": "dialogue",
    "name": "監視員",
    "words": "有了有了。",
    "voice": null,
    "unit_id": 1413
  },
  {
    "type": "dialogue",
    "name": "監視員",
    "words": "我找你們好久啦。",
    "voice": null,
    "unit_id": 1413
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "是剛才的監視員！",
    "voice": "vo_adv_1402003_047",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "那個，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比並沒有違反規定喔？",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n貝斯他不是想跑進泳池，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "只是想把蘋果……",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "監視員",
    "words": "不，",
    "voice": "vo_adv_1402003_048",
    "unit_id": 1413
  },
  {
    "type": "dialogue",
    "name": "監視員",
    "words": "我不是來制止你們的……",
    "voice": null,
    "unit_id": 1413
  },
  {
    "type": "dialogue",
    "name": "監視員",
    "words": "白天的時候很抱歉。",
    "voice": null,
    "unit_id": 1413
  },
  {
    "type": "dialogue",
    "name": "監視員",
    "words": "\\n雖說是規定，",
    "voice": null,
    "unit_id": 1413
  },
  {
    "type": "dialogue",
    "name": "監視員",
    "words": "但我覺得自己的態度可能有些太冷淡了。",
    "voice": null,
    "unit_id": 1413
  },
  {
    "type": "dialogue",
    "name": "監視員",
    "words": "\\n",
    "voice": null,
    "unit_id": 1413
  },
  {
    "type": "dialogue",
    "name": "監視員",
    "words": "這是",
    "voice": null,
    "unit_id": 1413
  },
  {
    "type": "dialogue",
    "name": "監視員",
    "words": "剛才其他客人還回來的泳圈。",
    "voice": null,
    "unit_id": 1413
  },
  {
    "type": "dialogue",
    "name": "監視員",
    "words": "不介意的話拿去玩吧。",
    "voice": null,
    "unit_id": 1413
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "咦，",
    "voice": "vo_adv_1402003_049",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "謝謝你！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "……",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "哇哇！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "好大的泳圈呀！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n這樣一來即使坐兩個人，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "也不會「晃來晃去」呢！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "監視員",
    "words": "畢竟待會就是關園時間，也沒有其他遊客，",
    "voice": "vo_adv_1402003_050",
    "unit_id": 1413
  },
  {
    "type": "dialogue",
    "name": "監視員",
    "words": "\\n所以若是在泳池角落，那隻粉紅色寵物一起進泳池也沒關係。",
    "voice": null,
    "unit_id": 1413
  },
  {
    "type": "dialogue",
    "name": "監視員",
    "words": "\\n",
    "voice": null,
    "unit_id": 1413
  },
  {
    "type": "dialogue",
    "name": "監視員",
    "words": "我會幫忙去和",
    "voice": null,
    "unit_id": 1413
  },
  {
    "type": "dialogue",
    "name": "監視員",
    "words": "主管說明的。",
    "voice": null,
    "unit_id": 1413
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "真的嗎！？",
    "voice": "vo_adv_1402003_051",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "謝謝──！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "太棒了呢，僕從！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "貝斯！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "整個泳池被我們全包下來了耶！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "貝斯",
    "words": "呀嗚呀──！",
    "voice": "vo_adv_1402003_052",
    "unit_id": 8312
  },
  {
    "type": "dialogue",
    "name": "監視員",
    "words": "咦？",
    "voice": "vo_adv_1402003_053",
    "unit_id": 1413
  },
  {
    "type": "dialogue",
    "name": "監視員",
    "words": "你想也分一顆蘋果給我嗎？",
    "voice": null,
    "unit_id": 1413
  },
  {
    "type": "dialogue",
    "name": "監視員",
    "words": "\\n……",
    "voice": null,
    "unit_id": 1413
  },
  {
    "type": "dialogue",
    "name": "監視員",
    "words": "哈哈，",
    "voice": null,
    "unit_id": 1413
  },
  {
    "type": "dialogue",
    "name": "監視員",
    "words": "對不起啊，剛才還說你是寵物。",
    "voice": null,
    "unit_id": 1413
  },
  {
    "type": "dialogue",
    "name": "監視員",
    "words": "\\n你確確實實",
    "voice": null,
    "unit_id": 1413
  },
  {
    "type": "dialogue",
    "name": "監視員",
    "words": "是他們的朋友呢。",
    "voice": null,
    "unit_id": 1413
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "嘿嘿。",
    "voice": "vo_adv_1402003_054",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "總算是能大家一起下水玩了呢！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "僕從♡",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "夜間泳池",
    "voice": "vo_adv_1402003_055",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "有著很多閃亮亮的燈光，真的很漂亮呢！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "而且水面反射著許多光芒，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "看起來就像水裡也有星星一樣！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比",
    "voice": "vo_adv_1402003_056",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "現在挺滿意這裡的呢♪",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n只要和僕從、",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "貝斯，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "三個人一起待在這地方，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n就感覺什麼都可以辦得到！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "嘿嘿，",
    "voice": "vo_adv_1402003_057",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "就是這樣沒錯♡",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "──聽好了，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "不管是夜晚！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "還是黑暗！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n全都得乖乖聽班比的話！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}和班比暫時逃離收集愛心對決的束縛，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n充分地享受了自由的夜晚──",
    "voice": null,
    "unit_id": null
  }
]
