  },
  {
    "type": "dialogue",
    "name": "伊莉亞的眷屬",
    "words": "別說這麼愚蠢的話！",
    "voice": null,
    "unit_id": 2011
  },
  {
    "type": "dialogue",
    "name": "伊莉亞的眷屬",
    "words": "\\n不、不可能",
    "voice": null,
    "unit_id": 2011
  },
  {
    "type": "dialogue",
    "name": "伊莉亞的眷屬",
    "words": "那麼做吧！",
    "voice": null,
    "unit_id": 2011
  },
  {
    "type": "dialogue",
    "name": "伊莉亞的眷屬",
    "words": "進、進去",
    "voice": "vo_adv_1117001_009",
    "unit_id": 2011
  },
  {
    "type": "dialogue",
    "name": "伊莉亞的眷屬",
    "words": "適齡的男性房間什麼的，",
    "voice": null,
    "unit_id": 2011
  },
  {
    "type": "dialogue",
    "name": "伊莉亞的眷屬",
    "words": "\\n那樣……",
    "voice": null,
