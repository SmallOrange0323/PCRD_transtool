  {
    "type": "dialogue",
    "name": "旁白",
    "words": "――進入聖誕季之後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}在幫忙跟打工之中度過了忙碌的日子。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n正準備要在房裡睡覺的時候，從某處傳來了模糊的聲音……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "呵呵呵，",
    "voice": "vo_adv_1117001_000",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n居然這麼輕易地就能夠侵入房間……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n警戒心還真是不足啊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……不過，",
    "voice": "vo_adv_1117001_001",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "以妾身現在的力量，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n就算是戒備森嚴的城堡",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "也能輕易侵入呢。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "怎麼了？",
    "voice": "vo_adv_1117001_002",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n露出那麼驚訝的表情……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "該不會，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n被這種姿態搞混",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "而認不出妾身吧？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "伊莉亞的眷屬",
    "words": "是妾身啊。",
    "voice": "vo_adv_1117001_003",
    "unit_id": 2011
  },
  {
    "type": "dialogue",
    "name": "伊莉亞的眷屬",
    "words": "\\n是你侍奉的主人，",
    "voice": null,
    "unit_id": 2011
  },
  {
    "type": "dialogue",
    "name": "伊莉亞的眷屬",
    "words": "伊莉亞‧奧恩斯坦啊！",
    "voice": null,
    "unit_id": 2011
  },
  {
    "type": "dialogue",
    "name": "伊莉亞的眷屬",
    "words": "呵呵呵，",
    "voice": "vo_adv_1117001_004",
    "unit_id": 2011
  },
  {
    "type": "dialogue",
    "name": "伊莉亞的眷屬",
    "words": "在這種狀況下也沒有",
    "voice": null,
    "unit_id": 2011
  },
  {
    "type": "dialogue",
    "name": "伊莉亞的眷屬",
    "words": "忘記主人的聲音嗎。",
    "voice": null,
    "unit_id": 2011
  },
  {
    "type": "dialogue",
    "name": "伊莉亞的眷屬",
    "words": "\\n這種態度值得稱讚呢，",
    "voice": null,
    "unit_id": 2011
  },
  {
    "type": "dialogue",
    "name": "伊莉亞的眷屬",
    "words": "就讓妾身褒獎你一下吧♪",
    "voice": null,
    "unit_id": 2011
  },
  {
    "type": "dialogue",
    "name": "伊莉亞的眷屬",
    "words": "什……",
