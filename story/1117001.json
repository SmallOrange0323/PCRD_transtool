  },
  {
    "type": "dialogue",
    "name": "伊莉亞的眷屬",
    "words": "妾身有事要找你啊。",
    "voice": "vo_adv_1117001_006",
    "unit_id": 2011
  },
  {
    "type": "dialogue",
    "name": "伊莉亞的眷屬",
    "words": "\\n所以才把吾之眷屬",
    "voice": null,
    "unit_id": 2011
  },
  {
    "type": "dialogue",
    "name": "伊莉亞的眷屬",
    "words": "派來這裡的。",
    "voice": null,
    "unit_id": 2011
  },
  {
    "type": "dialogue",
    "name": "伊莉亞的眷屬",
    "words": "呵呵呵，",
    "voice": "vo_adv_1117001_007",
    "unit_id": 2011
  },
  {
    "type": "dialogue",
    "name": "伊莉亞的眷屬",
    "words": "你大可感到高興。",
    "voice": null,
    "unit_id": 2011
  },
  {
    "type": "dialogue",
    "name": "伊莉亞的眷屬",
    "words": "\\n今天可是要給你啊，",
