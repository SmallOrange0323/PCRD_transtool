  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嘿！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "　",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "哈啊！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "　",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "喝啊啊啊啊啊！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "background",
    "bg_id": "500240"
  },
  {
    "type": "dialogue",
    "name": "巨靈",
    "words": "――咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 11211
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "……",
    "voice": "vo_adv_5013005_012",
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "好厲害。",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "之前我就這麼覺得了，",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "貪吃佩可她……",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "嗯，",
    "voice": "vo_adv_5013005_013",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "沒錯！",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "該說是",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "優雅嗎？",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "簡直就像是禮儀課的老師一樣。",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是這樣嗎？",
    "voice": "vo_adv_5013005_014",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我沒那麼了不起啦～！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "話說回來，",
    "voice": "vo_adv_5013005_015",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "馬納歷亞魔法學院",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "連禮儀課都有嗎？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "啊啊，",
    "voice": "vo_adv_5013005_016",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "禮儀課不是在學院上的，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "那是在城堡裡學的。",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n因為禮法是一定要學習的",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "修養課程之一。",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "城堡？",
    "voice": "vo_adv_5013005_017",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "　修養……？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n難道安小姐",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是位出身非常高貴的人？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "露",
    "words": "這是當然的囉―！",
    "voice": "vo_adv_5013005_018",
    "unit_id": 109311
  },
  {
    "type": "dialogue",
    "name": "露",
    "words": "\\n",
    "voice": null,
    "unit_id": 109311
  },
  {
    "type": "dialogue",
    "name": "露",
    "words": "安前輩是",
    "voice": null,
    "unit_id": 109311
  },
  {
    "type": "dialogue",
    "name": "露",
    "words": "馬納歷亞王國的公主！",
    "voice": null,
    "unit_id": 109311
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "哦～……",
    "voice": "vo_adv_5013005_019",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不過，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "現在才說她是公主，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我們的態度或用字遣詞，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "也很難在一時之間改變。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "啊，",
    "voice": "vo_adv_5013005_020",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "你們完全不用介意那種事！",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "只要像平常那樣與我相處就可以了！",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那麼，",
    "voice": "vo_adv_5013005_021",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我就這麼做吧。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不過安是公主啊……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這麼說來，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "確實很有氣質……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "still",
    "still_id": "501300501"
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "嗯～……",
    "voice": "vo_adv_5013005_022",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "嚴格說起來，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "貪吃佩可比較有氣質吧？",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "討厭〜！",
    "voice": "vo_adv_5013005_023",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "　安真是的，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "突然間胡說些什麼啊～！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我有的充其量不過是對美食的好奇心而已！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "是這樣嗎？",
    "voice": "vo_adv_5013005_024",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "　",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "話雖如此，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "貪吃佩可",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n該不會其實是某個王國的公主吧～？",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不是不是，",
    "voice": "vo_adv_5013005_025",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我只是個隨處可見，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n肚子餓得咕嚕咕嚕叫的貪吃佩可！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "對了！",
    "voice": "vo_adv_5013005_026",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "　",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "公主",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "都過著什麼樣的生活？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n果然，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "一天到晚都有護衛在身邊保護自己嗎！？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "當然不可能二十四小時都在一起，",
    "voice": "vo_adv_5013005_027",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n不過確實有一位",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "名叫歐文的護衛喔。",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "基本上他是一位值得信賴的人……",
    "voice": "vo_adv_5013005_028",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "但是該說他小題大作嗎？",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n總之他常常做得太過頭。",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "遠足的時候，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "還做了奇怪的點心……",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "會做點心給你的護衛！？",
    "voice": "vo_adv_5013005_029",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好令人羨慕啊！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "　",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "真好〜☆",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "啊哈哈！",
    "voice": "vo_adv_5013005_030",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "　",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "如果歐文是貪吃佩可的護衛，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n他一定會現場製作",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "魔物料理給妳吃！",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "background",
    "bg_id": "500240"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不過身邊有護衛，",
    "voice": "vo_adv_5013005_031",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "似乎很麻煩。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不覺得很拘束嗎？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "嗯～",
    "voice": "vo_adv_5013005_032",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "身為王族的我必須全盤接受，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n我很明白這個道理……",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "可是我討厭一昧地被別人保護！",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "　",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "的這種感覺。",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "所以你才從王宮跑出來，",
    "voice": "vo_adv_5013005_033",
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "進入馬納歷亞魔法學院就讀吧？",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "呵呵……",
    "voice": "vo_adv_5013005_034",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "嗯。",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "我不想當弱小的公主，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n希望自己強大到能為守護別人而戰。",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "原來如此。",
    "voice": "vo_adv_5013005_035",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "真是了不起的想法！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "如果我也能成為這樣的公主，",
    "voice": "vo_adv_5013005_036",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這個國家一定也……",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "貪吃佩可小姐？",
    "voice": "vo_adv_5013005_037",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您怎麼了？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊啊，",
    "voice": "vo_adv_5013005_038",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那個，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "關於馬納歷亞的事，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我還想知道得更多！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "真的嗎！？",
    "voice": "vo_adv_5013005_039",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "　",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "妳有興趣真是太好了！",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n如果貪吃佩可能到馬納歷亞來，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "一定會玩得很開心吧～",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "說得也是。",
    "voice": "vo_adv_5013005_040",
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "雖然多多少少有點危險……",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "危險？",
    "voice": "vo_adv_5013005_041",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "　",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "例如，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "異世界的門突然出現，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n魔物們紛紛從那裡面湧現，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "導致學院在戰鬥中半毀……？",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "或者",
    "voice": "vo_adv_5013005_042",
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "受到封印的墮天使突然復活，",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "\\n到處施放禁忌術式……？",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好可怕！",
    "voice": "vo_adv_5013005_043",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "　",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這哪算「多多少少」啊！？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "露",
    "words": "在學院這種事",
    "voice": "vo_adv_5013005_044",
    "unit_id": 109311
  },
  {
    "type": "dialogue",
    "name": "露",
    "words": "只是家常便飯",
    "voice": null,
    "unit_id": 109311
  },
  {
    "type": "dialogue",
    "name": "露",
    "words": "而已唷～",
    "voice": null,
    "unit_id": 109311
  },
  {
    "type": "dialogue",
    "name": "露",
    "words": "\\n",
    "voice": null,
    "unit_id": 109311
  },
  {
    "type": "dialogue",
    "name": "露",
    "words": "而且，",
    "voice": null,
    "unit_id": 109311
  },
  {
    "type": "dialogue",
    "name": "露",
    "words": "這些問題現在都已經解決了，",
    "voice": null,
    "unit_id": 109311
  },
  {
    "type": "dialogue",
    "name": "露",
    "words": "沒問題的！",
    "voice": null,
    "unit_id": 109311
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我覺得重點應該",
    "voice": "vo_adv_5013005_045",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不在那個地方吧……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "還有……",
    "voice": "vo_adv_5013005_046",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "對了！",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "　馬納歷亞魔法學院裡，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n有一座非常古老的魔法圖書館喔。",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "裡頭有許多魔導書、",
    "voice": "vo_adv_5013005_047",
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "或是被稱為禁書的藏書，",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "不過偶爾也會引發一些問題……",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "聽起來有點嚇人……",
    "voice": "vo_adv_5013005_048",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "到底",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "發生了什麼事呢？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "圖書館的主人大發雷霆，",
    "voice": "vo_adv_5013005_049",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "將其封印……",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "我記得當時",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "漢娜因此感到很自責。",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "啊，",
    "voice": "vo_adv_5013005_050",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "漢娜是",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "馬納歷亞魔法學院的學生會長。",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n她是一位做事可靠，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "認真負責的好孩子。",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "歐文和漢娜，",
    "voice": "vo_adv_5013005_051",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "現在應該很擔心我們吧……",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "……是啊。",
    "voice": "vo_adv_5013005_052",
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "一定是這樣的……",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "露",
    "words": "嗯～……",
    "voice": "vo_adv_5013005_053",
    "unit_id": 109311
  },
  {
    "type": "dialogue",
    "name": "露",
    "words": "\\n露",
    "voice": null,
    "unit_id": 109311
  },
  {
    "type": "dialogue",
    "name": "露",
    "words": "突然覺得胸口一陣刺痛。",
    "voice": null,
    "unit_id": 109311
  },
  {
    "type": "dialogue",
    "name": "露",
    "words": "\\n為什麼會這樣呢……？",
    "voice": null,
    "unit_id": 109311
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "露……",
    "voice": "vo_adv_5013005_054",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "為了能見到大家，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "我們一定要打倒巨靈，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n回到密斯塔爾西亞！",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "密斯塔爾西亞嗎……",
    "voice": "vo_adv_5013005_055",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "唉，",
    "voice": "vo_adv_5013005_056",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "光之裂縫與世界的毀滅什麼的、",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n都是些令人摸不著頭緒的事情啊……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "或許真的存在著呢。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "包含那個叫做密斯塔爾西亞的地方。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "真是的，",
    "voice": "vo_adv_5013005_057",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
