    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "　這就是通往山頂的洞窟！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我們出發吧！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "background",
    "bg_id": "500240"
  },
  {
    "type": "dialogue",
    "name": "露",
    "words": "哇――",
    "voice": "vo_adv_5013005_004",
    "unit_id": 109311
  },
  {
    "type": "dialogue",
    "name": "露",
    "words": "\\n洞窟裡好寬敞喔？",
    "voice": null,
    "unit_id": 109311
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "……",
    "voice": "vo_adv_5013005_005",
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "小心點。",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "\\n這附近，",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "充滿了殺氣……",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "巨靈",
    "words": "――咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 11211
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這裡也躲藏著巨靈。",
    "voice": "vo_adv_5013005_006",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人！",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "　請您務必多加小心！",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "background",
    "bg_id": "500240"
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "啊，",
    "voice": "vo_adv_5013005_007",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人！",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "得救了，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "謝謝您。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "有主人的保護，",
    "voice": "vo_adv_5013005_008",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "可可蘿真的很幸運。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "background",
    "bg_id": "500240"
  },
  {
    "type": "dialogue",
    "name": "露",
    "words": "咿呀啊啊啊啊啊！",
    "voice": "vo_adv_5013005_009",
    "unit_id": 109311
  },
  {
    "type": "dialogue",
    "name": "露",
    "words": "\\n露一點都不好吃啊！",
    "voice": null,
    "unit_id": 109311
  },
  {
    "type": "dialogue",
    "name": "露",
    "words": "咦，",
    "voice": "vo_adv_5013005_010",
    "unit_id": 109311
  },
  {
    "type": "dialogue",
    "name": "露",
    "words": "你保護了露嗎！？",
    "voice": null,
    "unit_id": 109311
  },
  {
    "type": "dialogue",
    "name": "露",
    "words": "\\n",
    "voice": null,
    "unit_id": 109311
  },
  {
    "type": "dialogue",
    "name": "露",
    "words": "哇，",
    "voice": null,
    "unit_id": 109311
  },
  {
    "type": "dialogue",
    "name": "露",
    "words": "謝謝你！",
    "voice": null,
    "unit_id": 109311
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這裡交給我來解決！",
    "voice": "vo_adv_5013005_011",
