  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "正月はどんな風に過ごすのかって？",
    "voice": "vo_adv_6056404_000",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "アタシは今まで、",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "あんまり正月って気にしてなかったからな……",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "そんなに楽しいものなのか？　",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "なんかやることあるのか？",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "おせちって食べ物だったのか！？",
    "voice": "vo_adv_6056404_001",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "正月だけの特別な物を食べられるのは、",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "確かに楽しいかもな。",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "そんなにうまいならアタシも食べてみたいぞ！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "お参りぃ？　",
    "voice": "vo_adv_6056404_002",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "……お金を投げて、",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "神様にお願いごとをするのか？",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "それで願いが叶うなんて思えないけどな……",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "どんなことをするのかは気になるぞ。",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "今度アタシも連れてってくれよな！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "羽子板？　",
    "voice": "vo_adv_6056404_003",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "なんだっけ……",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "板で玉みたいなのを打つやつか？",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "ああ、",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "やっぱりそれだ！　",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "それならアタシでも楽しめそうだな！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "\\n",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "ボッコボコにしてやるから、",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "ムイミ",
    "words": "早く遊びに行くぞ！",
    "voice": null,
    "unit_id": 114711
  }
]
