[
  {
    "type": "dialogue",
    "name": "初音",
    "words": "肚子也吃飽了，",
    "voice": "vo_adv_5134204_000",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "感覺開始睏起來了呢～",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n這次的預知夢，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "如果可以夢到像是預演的內容就好了。",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "事到如今",
    "voice": "vo_adv_5134204_001",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "也很難大幅改變作戰計畫呢……",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "再說了，",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "許願的數量也是有限的。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n要把全部人都送上宇宙是不可能的。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "而且穿越大氣層的時候應該會很熱，",
    "voice": "vo_adv_5134204_002",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "難得的新年和服可能會燒焦呢。",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "總而言之，",
    "voice": "vo_adv_5134204_003",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "能請妳再睡一次嗎？",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "既然作戰內容無法改變，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那就只能請妳作原本的夢了。",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "沒問題，",
    "voice": "vo_adv_5134204_004",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我這次一定可以的！",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n在夢到圓滿的結局之前，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n我會繼續努力，不會放棄的！",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "就是這股氣勢，拜託妳了。",
    "voice": "vo_adv_5134204_005",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "那麼",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "妳準備好要再睡一次了嗎？",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "當然！",
    "voice": "vo_adv_5134204_006",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "那麼",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "就再一次鼓起幹勁……！",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "……呼嚕♪",
    "voice": "vo_adv_5134204_007",
    "unit_id": 128411
  }
]
