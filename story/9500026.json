    "voice": null,
    "unit_id": 103741
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103741
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我得趁現在好好「防守反擊」才行呢。",
