    "name": "智",
    "words": "是女孩子的敵人！",
    "voice": null,
    "unit_id": 103741
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "你應該知道吧，",
    "voice": null,
    "unit_id": 103741
  },
