  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "你剛才",
    "voice": null,
    "unit_id": 103741
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "說什麼？",
    "voice": null,
    "unit_id": 103741
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103741
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我沒聽清楚，",
    "voice": null,
    "unit_id": 103741
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "可以再說一次嗎？",
    "voice": null,
    "unit_id": 103741
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "大聲一點。",
    "voice": null,
    "unit_id": 103741
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……哈哈。",
    "voice": "vo_adv_9500026_001",
    "unit_id": 103741
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "哈哈哈哈哈♪",
    "voice": null,
    "unit_id": 103741
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n好有趣啊。",
    "voice": null,
    "unit_id": 103741
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "你真的要用這樣的話",
    "voice": null,
    "unit_id": 103741
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "來告白嗎？",
    "voice": null,
    "unit_id": 103741
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "既然你想讓我聽你說，",
    "voice": "vo_adv_9500026_002",
    "unit_id": 103741
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "那也得聽聽我的願望呢。",
    "voice": null,
    "unit_id": 103741
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103741
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我可是有點不開心喔。",
    "voice": null,
    "unit_id": 103741
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103741
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "因為──",
    "voice": null,
    "unit_id": 103741
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我",
    "voice": null,
    "unit_id": 103741
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "向你告白的機會",
    "voice": null,
    "unit_id": 103741
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "被你搶走了。",
    "voice": null,
    "unit_id": 103741
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "你知道",
    "voice": "vo_adv_9500026_003",
    "unit_id": 103741
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我有多煩惱嗎？",
    "voice": null,
    "unit_id": 103741
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103741
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我一直不知道……",
    "voice": null,
    "unit_id": 103741
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "這份心意",
    "voice": null,
    "unit_id": 103741
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "要怎麼傳達給你才好。",
    "voice": null,
    "unit_id": 103741
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "究竟有多少個夜晚",
    "voice": "vo_adv_9500026_004",
    "unit_id": 103741
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "輾轉難眠，",
    "voice": null,
    "unit_id": 103741
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "又獨自",
    "voice": null,
    "unit_id": 103741
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "哭了多少次……",
    "voice": null,
    "unit_id": 103741
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103741
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "但是，",
    "voice": null,
    "unit_id": 103741
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "你真的很過分，",
    "voice": null,
    "unit_id": 103741
  },
