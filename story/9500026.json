    "type": "dialogue",
    "name": "智",
    "words": "我",
    "voice": null,
    "unit_id": 103741
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "對你──",
    "voice": null,
    "unit_id": 103741
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n……",
    "voice": null,
    "unit_id": 103741
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……",
    "voice": null,
    "unit_id": 103741
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "捉弄你的啦～",
