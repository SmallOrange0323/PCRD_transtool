    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103741
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "為了今後",
    "voice": null,
    "unit_id": 103741
