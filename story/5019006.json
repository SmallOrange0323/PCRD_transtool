  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "海水浴開幕活動當天。\\n聚集在會場海灘上的觀光客們，\\n一直期待著鈴奈出場。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女觀光客",
    "words": "能在這麼美麗的海灘上看到鈴奈，實在太棒了！",
    "voice": "vo_adv_5019006_000",
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "男觀光客",
    "words": "是啊，",
    "voice": "vo_adv_5019006_001",
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男觀光客",
    "words": "就是啊！",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男觀光客",
    "words": "\\n",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男觀光客",
    "words": "活動怎麼還不快點開始！",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "女觀光客",
    "words": "以鈴奈開啟的夏天，",
    "voice": "vo_adv_5019006_002",
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "女觀光客",
    "words": "實在棒極了～！",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "女觀光客",
    "words": "\\n",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "女觀光客",
    "words": "呀～",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "女觀光客",
    "words": "鈴奈",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "女觀光客",
    "words": "怎麼還不出來呀～！",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "聚集了很多來支持鈴奈的觀光客呢。",
    "voice": "vo_adv_5019006_003",
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "就算是待在舞台旁邊的待機區，",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "也能感受到熱情～",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "有這麼多人一起祈禱的話，",
    "voice": "vo_adv_5019006_004",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "晴神大人也能甦醒過來了吧！",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n一定",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "會成功的！",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "這個人數",
    "voice": "vo_adv_5019006_005",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "真的很不得了……！",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "鈴奈，",
    "voice": "vo_adv_5019006_006",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "沒事吧？　　",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "緊不緊張？",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "只要和平常一樣，",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "放輕鬆",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "就行了？",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "當然！",
    "voice": "vo_adv_5019006_007",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "是說，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "美咲妳在緊張什麼啊？　　",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "真好笑～",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "因、",
    "voice": "vo_adv_5019006_008",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "因為～",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "又還沒開始下雨，",
    "voice": "vo_adv_5019006_009",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "還好吧？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n我會很快的表演完，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "喚醒晴吉的！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "有各位粉絲在下面，",
    "voice": "vo_adv_5019006_010",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n還有島上的人們的支持，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我好像比平時還要有活力！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "離活動開演，",
    "voice": "vo_adv_5019006_011",
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "還有一點時間。",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "只要天氣依然保持這樣就――",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "background",
    "bg_id": "500681"
  },
  {
    "type": "dialogue",
    "name": "女觀光客",
    "words": "咦，什麼？　",
    "voice": "vo_adv_5019006_012",
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "女觀光客",
    "words": "突然下起雨了！",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "女觀光客",
    "words": "\\n",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "女觀光客",
    "words": "剛才明明還是大晴天的？",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "男觀光客",
    "words": "欸，",
    "voice": "vo_adv_5019006_013",
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男觀光客",
    "words": "快看啊！",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男觀光客",
    "words": "\\n那裡有東西！",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "女觀光客",
    "words": "好可愛！",
    "voice": "vo_adv_5019006_014",
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "女觀光客",
    "words": "\\n是這座海灘的吉祥物嗎？",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "啊啊！　",
    "voice": "vo_adv_5019006_015",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "就只差一點點了說～！",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n雖然時間還沒到，",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我們要不要先開始啊？",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "趕快弄一弄，",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "讓天氣放晴吧！",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "是啊！　",
    "voice": "vo_adv_5019006_016",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "我們開始活動吧！",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "鈴奈小姐，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "請準備――",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "觀光客們",
    "words": "呀啊――！！",
    "voice": "vo_adv_5019006_017",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "有人尖叫！？",
    "voice": "vo_adv_5019006_018",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "該不會……？　",
    "voice": "vo_adv_5019006_019",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我去看一下！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "果然是雨吉！",
    "voice": "vo_adv_5019006_020",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "欸，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "你冷靜點！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "見不到朋友，",
    "voice": "vo_adv_5019006_021",
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "\\n都是你們",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "人類的錯……！",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "你在聽我說話嗎～？",
    "voice": "vo_adv_5019006_022",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "為什麼",
    "voice": "vo_adv_5019006_023",
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "\\n我見不到晴吉……！",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "不會吧？　",
    "voice": "vo_adv_5019006_024",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "他好像聽不到人家的聲音。",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "怎麼辦！？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "雨神大人！",
    "voice": "vo_adv_5019006_025",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n請平靜下來！　",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "再忍耐一下！",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "現在在這裡的所有人會進行祈禱！",
    "voice": "vo_adv_5019006_026",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "為了晴神大人，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "有很多人從島外聚集至此！",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "……！",
    "voice": "vo_adv_5019006_027",
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "\\n從島外……？",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "沒錯！",
    "voice": "vo_adv_5019006_028",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "我聽說了……！",
    "voice": "vo_adv_5019006_029",
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "\\n從島外來的人……",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "鈴奈的友情也被破壞……！",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "咦！？",
    "voice": "vo_adv_5019006_030",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "你們又想這樣去破壞誰的友情！",
    "voice": "vo_adv_5019006_031",
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "\\n這座島上的人",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "全部都不能相信！",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "\\n饒不了你們！",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "如果見不到晴吉，",
    "voice": "vo_adv_5019006_032",
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "這座島也沒有存在的意義！",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "等一下！　",
    "voice": "vo_adv_5019006_033",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "雨吉！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n我們",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "已經和好了！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "你看，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "她就是之前說過",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家的朋友，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "美咲！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "是、",
    "voice": "vo_adv_5019006_034",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "是～的？　",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我就是",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "美咲。",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n是鈴奈的朋友。",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "請多指教？",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "請不要生氣，",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "和我們兩位淑女",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "好好聊一下吧？",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "好嗎？",
    "voice": "vo_adv_5019006_035",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "所以，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "你先冷靜一下～？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "我想見晴吉，",
    "voice": "vo_adv_5019006_036",
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "我想見",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "晴吉……！！",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "討厭，",
    "voice": "vo_adv_5019006_037",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "風勢也變得越來越強了！",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "真是的，",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "那副胡鬧的模樣，",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "簡直就是任性的小孩呢。",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我這個成熟的淑女，",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "會想辦法的！",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "唔，",
    "voice": "vo_adv_5019006_038",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "啊啊！",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n活動舞台好像要被吹走了！",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "絕對不可以！",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "雨吉！　",
    "voice": "vo_adv_5019006_039",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我知道你見不到朋友很難過！",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你不安的心情，",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我也非常理解……",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "可是啊，",
    "voice": "vo_adv_5019006_040",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "這個舞台",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n對我重視的朋友來說，",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "是非常重要的地方！",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n所以，",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我不會讓你破壞這裡的！",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "不要礙事！",
    "voice": "vo_adv_5019006_041",
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "呀啊――――！？",
    "voice": "vo_adv_5019006_042",
    "unit_id": 110211
  },
  {
    "type": "still",
    "still_id": "501900601"
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "嘿嘿嘿，",
    "voice": "vo_adv_5019006_043",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "接得好！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "嘿？　　",
    "voice": "vo_adv_5019006_044",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "鈴、",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "鈴奈？",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "聽妳那樣說，",
    "voice": "vo_adv_5019006_045",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我真的很開心。",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "讓我覺得美咲是人家",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "第一名的粉絲！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "才、",
    "voice": "vo_adv_5019006_046",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "才不是！",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "剛才那個該怎麼說……",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "對，",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "是我捏造的，",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "只是不小心",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "就說溜嘴了……",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "哈哈哈！",
    "voice": "vo_adv_5019006_047",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "咦，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "妳不是人家的粉絲嗎～？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "討厭！",
    "voice": "vo_adv_5019006_048",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n這種時候別捉弄我了！",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "啊，",
    "voice": "vo_adv_5019006_049",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "啊啊……！",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n看到妳們兩位感情如此和睦，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n簡直像是看到雨神大人和晴神大人一樣。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "看著妳們相處，讓我的臉上也滿是笑容……",
    "voice": "vo_adv_5019006_050",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n有種晴空萬里的感覺……！",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "妳們兩個沒事吧？",
    "voice": "vo_adv_5019006_051",
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n沒有哪裡痛或是受傷吧？",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我沒事！",
    "voice": "vo_adv_5019006_052",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n因為鈴奈救了我！",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "太好了！",
    "voice": "vo_adv_5019006_053",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "接下來，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "也要拯救雨吉才行呢！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "他看起來好難過啊……！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "呵呵，",
    "voice": "vo_adv_5019006_054",
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "妳們兩個感情變得比之前還要融洽，",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n我也很開心。",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "雨吉和晴吉，",
    "voice": "vo_adv_5019006_055",
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n就像他們兩個一樣啊。",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n我們快點幫他們重逢吧！",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "background",
    "bg_id": "500681"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "啊！　",
    "voice": "vo_adv_5019006_056",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "這樣啊，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "原來如此……！",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "我們在不知不覺間，",
    "voice": "vo_adv_5019006_057",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "變得只考慮到遊玩，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "好像遺忘了真正該祈禱的事情是什麼……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "這座島上的人們真心期盼的是……",
    "voice": "vo_adv_5019006_058",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n雨神大人和晴神大人",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "能在這座島上開心玩樂……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "那就是",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "這島的心願！",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "這件事",
    "voice": "vo_adv_5019006_059",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "得告訴鈴奈小姐！",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "那個……",
    "voice": "vo_adv_5019006_060",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "你是說真的沒錯吧？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "好！　",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "交給人家吧！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "拜託妳了！",
    "voice": "vo_adv_5019006_061",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "各位，",
    "voice": "vo_adv_5019006_062",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "請冷靜下來聽我說！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "――就是這樣，",
    "voice": "vo_adv_5019006_063",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n為了讓雨吉和晴吉",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "能夠開心玩樂。",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n想請大家",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "一面想著重要的朋友的臉，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "一面祈禱。",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "各位，",
    "voice": "vo_adv_5019006_064",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "拜託了～！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "女觀光客",
    "words": "既然鈴奈都這麼說了！",
    "voice": "vo_adv_5019006_065",
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "男觀光客",
    "words": "雖然不知道是怎麼回事，",
    "voice": "vo_adv_5019006_066",
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男觀光客",
    "words": "我會一起做的！",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "各位，",
    "voice": "vo_adv_5019006_067",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "謝謝你們～！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "夏天一定會到來的，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n現在就和我們一起",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "加油吧～！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "在祈禱的時候，",
    "voice": "vo_adv_5019006_068",
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "請到遠離海灘的地方避難！",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "請大家遵從島民的引導。",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "我想見晴吉，",
    "voice": "vo_adv_5019006_069",
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "我想見晴吉……",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "\\n我只是想見晴吉，為什麼不讓我見他……！！",
    "voice": null,
    "unit_id": 11611
  },
  {
    "type": "dialogue",
    "name": "雨吉",
    "words": "――咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 11811
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "雨吉，",
    "voice": "vo_adv_5019006_070",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "好像到極限了……？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "嗯！",
    "voice": "vo_adv_5019006_071",
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n趁大家在祈禱的時候，",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我們得去阻止他。",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "是啊！",
    "voice": "vo_adv_5019006_072",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "大家是為了你和晴吉",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "才聚集至此的，",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n要胡鬧也要適可而止！",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "雨吉，",
    "voice": "vo_adv_5019006_073",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我會救你的！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "現在的我們，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n一定什麼都做得到！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "交給我吧！",
    "voice": "vo_adv_5019006_074",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "給我老實一點！",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "background",
    "bg_id": "500681"
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "美咲的攻擊無效！？",
    "voice": "vo_adv_5019006_075",
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "他好像展開了雨之屏障！",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "真是的！",
    "voice": "vo_adv_5019006_076",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n聽我們說話啦！",
    "voice": null,
    "unit_id": 110211
  },
