  {
    "type": "dialogue",
    "name": "旁白",
    "words": "某一天。\\n當{0}正自己一人在散步時……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "{0}大人……{0}大人……",
    "voice": "vo_adv_1027006_000",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "是我……",
    "voice": "vo_adv_1027006_001",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "惠理子喔。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "您問我",
    "voice": "vo_adv_1027006_002",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "為什麼會變成這副模樣……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "嗎？",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n果然還是會令人在意呢……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "……不是的，",
    "voice": "vo_adv_1027006_003",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我並沒加入【王宮騎士團】呢。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n而且",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我也不算是穿著鎧甲……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "其實呢，",
    "voice": "vo_adv_1027006_004",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "是我在鍊金術的實驗途中，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n不小心將自己的靈魂固定在這副鎧甲上……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n結果就變成這個樣子了……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "您看……",
    "voice": "vo_adv_1027006_005",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "正如您眼前所見，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n鎧甲內部是空的。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "……嘻嘻。",
    "voice": "vo_adv_1027006_006",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n我被{0}大人看光光身體內部了呢……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "該怎麼說，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "這樣子……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "也算是相當美好的經驗呢。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "請您不要慌張……",
    "voice": "vo_adv_1027006_007",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n實驗失敗是常有的事呢。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "……那麼，",
    "voice": "vo_adv_1027006_008",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我還有接下來的實驗……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 711
  },
  {
