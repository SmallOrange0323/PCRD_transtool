  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "為了尋找海底城的魔具，{0}等人突破了第一道關卡，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n邁向下一個考驗──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "根據店長的說法，",
    "voice": "vo_adv_1132002_000",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "第二道關卡應該就在這附近啊……",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "喲，",
    "voice": "vo_adv_1132002_001",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "歡迎光臨。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "要不要來點冰冰涼涼的西瓜呀？",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "……「海底城的邀請」。",
    "voice": "vo_adv_1132002_002",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "……！",
    "voice": "vo_adv_1132002_003",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "那張通行證，",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "你們已經通過第一關卡了啊。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "這倒是來了個挺有意思的對手呢。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "嘻嘻嘻……！",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "第二道關卡是羈絆的考驗。",
    "voice": "vo_adv_1132002_004",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "也就是打西瓜！",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "雖然只要一次擊中就算過關了，",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "但你們做得到嗎？",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "呵，",
    "voice": "vo_adv_1132002_005",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "就只是打西瓜而已嗎？",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n在疾風之冥姬面前，形同兒戲！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n這種程度的考驗真令人笑掉大牙！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "口氣真大。",
    "voice": "vo_adv_1132002_006",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "好，",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "那小姑娘妳就負責打西瓜吧。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "\\n那邊的小哥負責指揮。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "來，",
    "voice": "vo_adv_1132002_007",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "小姑娘，妳把眼睛蒙上……",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "然後原地",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "轉個10圈吧！",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "什麼！？",
    "voice": "vo_adv_1132002_008",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n居然使用強制擾亂魔法，太卑鄙了！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "妳都算計好了！？",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "嘻嘻嘻，",
    "voice": "vo_adv_1132002_009",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "誰叫妳不認真把話聽完呢！",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "來吧，",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "快開始吧！",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "唔，",
    "voice": "vo_adv_1132002_010",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "呼……呼……",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n不行了……",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "完全搞不清楚哪裡有什麼……！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "哈哈哈！",
    "voice": "vo_adv_1132002_011",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "看來妳也只是耍耍嘴皮子而已嘛！",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "讓我看看，",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "妳能打中西瓜嗎！",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "……在這樣的黑暗之中，",
    "voice": "vo_adv_1132002_012",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我只能仰賴你了。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n吉格魯特，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "讓你這道光引領我的方向吧……！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "你起碼也表現出一點合作的意願吧！",
    "voice": "vo_adv_1132002_013",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n聽好了，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "你要負責下達指令！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "明白了嗎！？",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "……直、",
    "voice": "vo_adv_1132002_014",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "直走嗎？",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "好！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "妳走偏了啦，",
    "voice": "vo_adv_1132002_015",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "右邊！",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "右邊！",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "啊～",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "走過頭了，",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "再左邊一點！",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "後面啦！",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我才不聽妳的聲音！",
    "voice": "vo_adv_1132002_016",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "說吧，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "吉格魯特！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n告訴我，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我這一劍，該往何處揮下！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "喝！",
    "voice": "vo_adv_1132002_017",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "……",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "好耶，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "有擊中的手感！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "嘖，",
    "voice": "vo_adv_1132002_018",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "做得還不賴嘛……",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "你們合格了。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "\\n想不到你們連羈絆的考驗也突破了。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "不過下一道關卡才是關鍵考驗！",
    "voice": "vo_adv_1132002_019",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "你們有辦法克服嗎？",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "哈哈哈哈哈！",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "啊，",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "去第三道關卡之前，",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "阿姨",
    "words": "先吃個西瓜吧。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "background",
    "bg_id": "501030"
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "下一關是武鬥考驗，",
    "voice": "vo_adv_1132002_020",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "沙灘排球啊。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n好像會有魔具的看守人阻擋我們的去路，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "要以2對2和他們決勝負。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "吉格魯特，",
    "voice": "vo_adv_1132002_021",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "你對沙灘排球有信心嗎？",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "什麼！？",
    "voice": "vo_adv_1132002_022",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "前世的你和我歷經了許多生死一線的驚險瞬間，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n居然不知道「沙岸之球戲」──",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "沙灘排球！？",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "咦……",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "真的嗎？",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "連規則都不懂！？",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "怎麼會這樣……",
    "voice": "vo_adv_1132002_023",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "都走到這一步了，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "命運卻在這個時候對我們露出獠牙…！！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "不，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "要向命運低頭還太早了。",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n現在開始還不算遲，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我們去取回前世的記憶吧！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "……好，",
    "voice": "vo_adv_1132002_024",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "特訓開始！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
