[
  {
    "type": "background",
    "bg_id": "500020"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "和鏡華吵架之後的隔天，心浮氣躁的禊\\n無法好好唸書準備考試，也完全無法集中精神。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "啊啊，看了教科書也根本看不懂啊！",
    "voice": "vo_adv_5002002_000",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n為什麼一定要唸書呢……",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "話說回來，要是沒有考試這種事",
    "voice": "vo_adv_5002002_001",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n也不會和鏡華吵架了嘛！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n全都是考試的錯！禊是無辜的！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "……嗯……不過還是去道歉比較好吧……",
    "voice": "vo_adv_5002002_002",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n但是該說些什麼才好呢……",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "話雖然這麼說，說不定道歉也不會原諒我！",
    "voice": "vo_adv_5002002_003",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n畢竟鏡華很生氣啊！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "要是一直這樣下去怎麼辦～！",
    "voice": "vo_adv_5002002_004",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "唔──，一直這樣心浮氣躁真是討厭～",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "其實昨天本來也是想唸完書後和大家一起玩的……",
    "voice": "vo_adv_5002002_005",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n會不會再也見不到鏡華了呢……畢竟都說要和我絕交了……",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "咦？哥哥？",
    "voice": "vo_adv_5002002_006",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n怎麼了……",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "啊，對了！請哥哥幫忙好了！",
    "voice": "vo_adv_5002002_007",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n說不定哥哥會教我和好的辦法！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "喂──咿！哥哥～～――！",
    "voice": "vo_adv_5002002_008",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哥哥不見了！",
    "voice": "vo_adv_5002002_009",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n……啊，對了，是禊挖了一個陷阱啦。",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "真是的，哥哥還是一樣粗心耶──",
    "voice": "vo_adv_5002002_010",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n跑過來的時候，禊還覺得像是救命英雄呢！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n這種時候拜託看看氣氛嘛。",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "啊，啊哈哈……因為吵架覺得很煩就……",
    "voice": "vo_adv_5002002_011",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "可是哥哥啊，",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n不要連禊在失落的時候都掉到陷阱裡嘛～",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "background",
    "bg_id": "500020"
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "嘿，嘿呀！啊哈哈，髒兮兮，",
    "voice": "vo_adv_5002002_012",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "不多注意一下週遭是不行的哦？",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "咦？找禊有事嗎？",
    "voice": "vo_adv_5002002_013",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "現在什麼事都先別管，禊要跟你商量一下",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊昨天不是和鏡華吵架了嗎？",
    "voice": "vo_adv_5002002_014",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n說真的，鏡華的教學方法完全聽不懂，",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n又光出些困難的問題，真的讓人火大……",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "可是，拜託她教禊唸書的也是我自己，",
    "voice": "vo_adv_5002002_015",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n半途而廢是禊不好，這我也明白……",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "而且，吵完架就算惡作劇也高興不起來，",
    "voice": "vo_adv_5002002_016",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n不管做什麼都無法集中精神呢……",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "那個，所以啊……禊想和鏡華和好啦！",
    "voice": "vo_adv_5002002_017",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n想要好好說聲對不起！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "可是……鏡華一定還在生氣……畢竟都絕交了……",
    "voice": "vo_adv_5002002_018",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n哥哥，要怎麼做才能和好呢？",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "鏡華喜歡的東西？嗯，是杯子蛋糕吧。",
    "voice": "vo_adv_5002002_019",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "以前她好像說過，只要吃了杯子蛋糕，",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n不開心的事就會煙消雲散……",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "如果是杯子蛋糕的話，說不定禊也做得出來……",
    "voice": "vo_adv_5002002_020",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "啊啊，可是鏡華喜歡的應該是",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n街上賣的那種做得很漂亮的啊！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "只要心意到了就好了？",
    "voice": "vo_adv_5002002_021",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "……說的也是，不愧是哥哥！說的真不錯！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "嗯，那禊也要做杯子蛋糕送給鏡華了！",
    "voice": "vo_adv_5002002_022",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n然後藉此和鏡華和好！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "那好！既然決定那麼做，就趕快來做杯子蛋糕吧！",
    "voice": "vo_adv_5002002_023",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哥哥也會幫忙對吧！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "background",
    "bg_id": "500110"
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "呃……攪拌奶油和砂糖，再加入蛋……",
    "voice": "vo_adv_5002002_024",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n做好之後，再用篩籃倒進這種粉",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "？",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "唔……咳、咳……",
    "voice": "vo_adv_5002002_025",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n為什麼杯子蛋糕會爆炸啊～！？",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "奇怪耶……應該已經照食譜寫的放進材料了……",
    "voice": "vo_adv_5002002_026",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "原來！哎呀！這根本不是麵粉，",
    "voice": "vo_adv_5002002_027",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n是禊的惡作劇道具爆裂粉啊！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "啊啊……要是知道會發生這種事，",
    "voice": "vo_adv_5002002_028",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n平時多幫忙媽媽就好了",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "可是，現在後悔也太遲了……",
    "voice": "vo_adv_5002002_029",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "與其這樣，不如現在讓禊用全部精力",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n為鏡華做出杯子蛋糕吧",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "就算不能像店裡賣的那麼漂亮，只要有心意……",
    "voice": "vo_adv_5002002_030",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "（絕對能和好的！禊能夠一直開玩笑胡鬧，",
    "voice": "vo_adv_5002002_031",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n也是因為有非常認真的鏡華在啊！)",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "（雖然料理和唸書差不多都不拿手，可是，可是……",
    "voice": "vo_adv_5002002_032",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "不會再半途而廢了！就算是禊，只要願意做還是做得到的！)",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "份量……大概是這些……",
    "voice": "vo_adv_5002002_033",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n倒入材料的順序是……時間大概是這樣……",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "放進烤箱……",
    "voice": "vo_adv_5002002_034",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "拜託了！這次一定要順利完成哦！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哥哥哥哥哥哥！好香的氣味！",
    "voice": "vo_adv_5002002_035",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n我有預感這次大成功了！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "那要打開烤箱囉……來吧",
    "voice": "vo_adv_5002002_036",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "still",
    "still_id": "500200401"
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "嗚哇！順利膨發起來了！",
    "voice": "vo_adv_5002002_037",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n好棒好棒！禊順利完成了唷！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "也要謝謝哥哥借我廚房！",
    "voice": "vo_adv_5002002_038",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n在家裡做的話就會被媽媽罵，叫我去唸書了！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "咿嘻嘻，這樣鏡華也會高興了吧！",
    "voice": "vo_adv_5002002_039",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "……啊啊──！可，可是要怎麼交給鏡華才好！？",
    "voice": "vo_adv_5002002_040",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "要是跑去送給她的時候，",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n「都已經絕交了還來做什麼？」說不定會這麼說，那怎麼辦……",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "嗯？什麼？突然拿出信來……",
    "voice": "vo_adv_5002002_041",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "蛤？難道是哥哥要給我的情書！？",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n禊還只是小孩子哦！？",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "嗯？什麼什麼……「探險邀請函」……",
    "voice": "vo_adv_5002002_042",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "這，這是鏡華寫的信嗎！？",
    "voice": "vo_adv_5002002_043",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "這樣啊！原來哥哥是特地把這個送來給禊的呢！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "在這一天把杯子蛋糕送給鏡華的話……",
    "voice": "vo_adv_5002002_044",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "謝謝！哥哥！好極了，那準備出發探險了！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "禊收到鏡華的來信之後，\\n就迫不急待地想把杯子蛋糕送給她了。",
    "voice": null,
    "unit_id": null
  }
]
