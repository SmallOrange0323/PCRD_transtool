    "unit_id": 106715
  },
  {
    "type": "dialogue",
    "name": "假帆稀",
    "words": "背面世界啊。",
    "voice": null,
    "unit_id": 106715
  },
  {
    "type": "dialogue",
    "name": "假帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106715
  },
  {
    "type": "dialogue",
    "name": "假帆稀",
    "words": "這真是令人興味盎然呢……",
    "voice": null,
    "unit_id": 106715
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "嗯……",
