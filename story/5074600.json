[
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "はて……",
    "voice": "vo_adv_5064600_000",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "何だね、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "これは。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "テレフェスのプログラムです。",
    "voice": "vo_adv_5064600_001",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "\\n",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "え、",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "逆になんで知らないんですか？",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "\\n生徒全員に配られてるはずですけど。",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ああ、",
    "voice": "vo_adv_5064600_002",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "そういえば昨日",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "『象牙の塔』に教員が何か届けに来たな。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "どうせ遅れている論文の催促状だろうと、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "とくに封は解かなかったが。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "ま、いんじゃないすか。",
    "voice": "vo_adv_5064600_003",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "それキホン来賓向けだし。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "\\n実際そこに載ってないシークレット地味競技とかも若干あるし。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "そういう問題じゃないんですよ！",
    "voice": "vo_adv_5064600_004",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "\\n",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "これは貴重な学園生活を刻んだモニュメントなんです。",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "\\nのちに振りかえって記憶の扉を開くための鍵なんです。",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "さあ先輩方！",
    "voice": "vo_adv_5064600_005",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "\\n",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "チエル",
    "words": "祭りの記憶を掘りおこしてわーわー言うやつをやりましょう！",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "おお、",
    "voice": "vo_adv_5064600_006",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "青春っぽい！",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "テレフェスねえ……",
    "voice": "vo_adv_5064600_007",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "\\n",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "クロエ",
    "words": "あんまロクな記憶ないんだけど大丈夫か？",
    "voice": null,
    "unit_id": 116211
  }
]
