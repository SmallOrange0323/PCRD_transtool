    "name": "愛梅斯",
    "words": "關於妳的動機和其他考量……",
    "voice": "vo_adv_5150007_035",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "嗯，",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我都理解囉。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n畢竟這是妳想體恤我而做的。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "……不過撇開這部分不談。",
    "voice": "vo_adv_5150007_036",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n妳做過的事情還是必須要處罰對吧？",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "……唔。",
    "voice": "vo_adv_5150007_037",
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "雖然說蘭德索爾的居民都很樂在其中，",
    "voice": "vo_adv_5150007_038",
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n但妳也同樣地",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "造成了大家的麻煩啊～",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "嗚唔……",
    "voice": "vo_adv_5150007_039",
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "不、",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "不要……",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "拜託，",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "唯獨當奶嘴的懲罰……！",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "妳放心。",
    "voice": "vo_adv_5150007_040",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n就看在妳的心意上，",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不罰妳當奶嘴。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "但是，",
    "voice": "vo_adv_5150007_041",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "除了我們之外還有許多人想跟妳抱怨哦。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n我們請了那群人的代表過來了。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "是要我跟那個代表賠不是嗎？",
    "voice": "vo_adv_5150007_042",
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "嗯，",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "那樣的話倒是無所謂。",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "所以，",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "那個代表是誰啊？",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "…………",
    "voice": "vo_adv_5150007_043",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "咦？",
    "voice": "vo_adv_5150007_044",
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "貪吃佩可？",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "什麼嘛～",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "原來是妳啊。",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n害我白擔心了！",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我是尤絲蒂亞娜‧F‧阿斯特賴亞。",
    "voice": "vo_adv_5150007_045",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "……嗯？",
    "voice": "vo_adv_5150007_046",
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n妳、",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "妳怎麼了啊，",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "貪吃佩可？",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我是尤絲蒂亞娜‧F‧阿斯特賴亞。",
    "voice": "vo_adv_5150007_047",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "妳幹嘛用全名稱呼自己！？",
    "voice": "vo_adv_5150007_048",
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那個啊。",
    "voice": "vo_adv_5150007_049",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n這位是貪吃……",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "尤絲蒂亞娜‧F‧阿斯特賴亞陛下，",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "陛下因為這次的事件",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "忙著處理城鎮的狀況，",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "幾乎沒空好好用餐。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "城鎮傳來開心的玩鬧聲，",
    "voice": "vo_adv_5150007_050",
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "自己卻被關在王宮裡，",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n穿著泳裝處理公務也只是徒增空虛。",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "也就是說，",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "她已經瀕臨",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "不滿的極限了～♪",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "啊，",
    "voice": "vo_adv_5150007_051",
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "該不會",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "接下來",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "她會拿公主的權威來責備我？",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "貪、",
    "voice": "vo_adv_5150007_052",
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "貪吃佩可～？",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "妳、",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "妳的表情很可怕哦～",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n妳雖然面帶笑容，",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "卻皮笑肉不笑的哦……",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "來，",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "快說",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "「太讚了吧☆」，",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "就像平常那樣，",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "好嗎？",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "太讚了。",
    "voice": "vo_adv_5150007_053",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "拜託妳別不帶感情地說啦！？",
    "voice": "vo_adv_5150007_054",
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n語尾沒加「吧」的話",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "就只是一般的表態句啊！",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那麼，",
    "voice": "vo_adv_5150007_055",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "涅比亞小姐先暫時借我一下☆",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好～的。",
    "voice": "vo_adv_5150007_056",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n請竭盡全力懲罰吧。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "等等，我要被帶去哪裡！？",
    "voice": "vo_adv_5150007_057",
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n在外面等的騎士們是怎麼搞的！？",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "菲歐，救救我，",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "換成帆稀來救也好～～～！",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我會去",
    "voice": "vo_adv_5150007_058",
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "會面室見妳的～♪",
    "voice": null,
    "unit_id": 131811
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "是監獄嗎！？",
    "voice": "vo_adv_5150007_059",
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "對、",
    "voice": "vo_adv_5150007_060",
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "對不起～！",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n這次是我做得太過頭了！",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "求你們行行好！",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "background",
    "bg_id": "500520"
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "我不會再惡作劇了啦～～～！",
    "voice": "vo_adv_5150007_061",
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在氣溫炎熱，卻有著涼爽氣候的蘭德索爾裡，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n喜歡惡作劇的嚮導小妖精的謝罪之言，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n響徹了整個夏季的晴空。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "一段時日過後──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "本來是為了",
    "voice": "vo_adv_5150007_062",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "紀念涅比亞獲釋……",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "才來海邊的……",
    "voice": "vo_adv_5150007_063",
    "unit_id": 131813
  },
  {
    "type": "background",
    "bg_id": "500681"
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "這不是在下著雨嗎！",
    "voice": "vo_adv_5150007_064",
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "還是大雨呢～",
    "voice": "vo_adv_5150007_065",
    "unit_id": 131813
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "什麼嘛～！",
    "voice": "vo_adv_5150007_066",
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "我可是忍住了連日來貪吃……",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "尤絲蒂亞娜陛下",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n她在說了「我明明也好想去玩的～～～！」",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "這句話後",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "開始哭哭啼啼的說教耶！？",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "為什麼會下雨啊！",
    "voice": "vo_adv_5150007_067",
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "一般應該要放晴才對吧！",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "我可是很期待充滿夏季風情的舞台活動耶！",
    "voice": null,
    "unit_id": 190912
