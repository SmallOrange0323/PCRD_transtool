[
  {
    "type": "background",
    "bg_id": "500872"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "馴鹿們在聖誕夜發起的造反行動",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在{0}等人的努力之下結束了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n城裡的人們變回原形後也紛紛回家，然後――",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "好了～",
    "voice": "vo_adv_5029007_000",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "你們打算怎麼贖罪。",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "是啊。",
    "voice": "vo_adv_5029007_001",
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "畢竟你們都反抗主人了。",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這可不是一句抱歉就可以饒恕的。",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯……",
    "voice": "vo_adv_5029007_002",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "先看看馴鹿先生牠們\\n怎麼說吧？",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "精英馴鹿1",
    "words": "噗、",
    "voice": "vo_adv_5029007_003",
    "unit_id": 4011
  },
  {
    "type": "dialogue",
    "name": "精英馴鹿1",
    "words": "噗喔喔喔！\\n（那個，我們幾個，覺得很煩躁……）",
    "voice": null,
    "unit_id": 4011
  },
  {
    "type": "dialogue",
    "name": "精英馴鹿2",
    "words": "噗喔噗噗！\\n（每年都只會被胡亂使喚……）",
    "voice": "vo_adv_5029007_004",
    "unit_id": 4011
  },
  {
    "type": "dialogue",
    "name": "精英馴鹿3",
    "words": "噗喔噗喔！\\n（而且也沒有收過禮物……）",
    "voice": "vo_adv_5029007_005",
    "unit_id": 4011
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜、伊莉亞",
    "words": "嗯。",
    "voice": "vo_adv_5029007_006",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜、伊莉亞",
    "words": "完全聽不懂。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "雖、",
    "voice": "vo_adv_5029007_007",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "雖然聽不懂他們在說什麼！",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不過，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "能感覺到他們想要表達的事情……",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我說，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "{0}你也這麼覺得吧？",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "雖然你的眼神看起來很誠懇，",
    "voice": "vo_adv_5029007_008",
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n不過",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "{0}，你不是隨便亂講的吧？",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "喔？",
    "voice": "vo_adv_5029007_009",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "沒想到你會說馴鹿語。",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "既然這樣，",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "小子你願不願意做我的馴鹿呢？",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "什麼？　",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不用了？　",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "嗯，",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "真可惜……☆",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "等一下，",
    "voice": "vo_adv_5029007_010",
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "小姐們。",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "聖誕老人……",
    "voice": "vo_adv_5029007_011",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "能不能",
    "voice": "vo_adv_5029007_012",
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "\\n讓老夫和牠們說幾句話呢……",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "精英馴鹿們",
    "words": "…………",
    "voice": "vo_adv_5029007_013",
    "unit_id": 4011
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "……",
    "voice": "vo_adv_5029007_014",
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "抱歉。",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "你們。",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "\\n",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "你們一直在協助我，",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "\\n可是老夫卻完全沒有察覺到你們的感受。",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "當老夫變成馴鹿的時候，",
    "voice": "vo_adv_5029007_015",
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "聽見了你們的心聲。",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "\\n",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "不只是哀傷、",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "憤怒、",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "還有對於自己無法享受聖誕節的不甘心……",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "原來是這樣……",
    "voice": "vo_adv_5029007_016",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "馴鹿先生，真的很抱歉。",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n我們幾個，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "一直做一些任性的事……",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "精英馴鹿們",
    "words": "……噗喔……\\n（……主人……）",
    "voice": "vo_adv_5029007_017",
    "unit_id": 4011
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "真的很抱歉。",
    "voice": "vo_adv_5029007_018",
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "\\n馴鹿明明是聖誕老人",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "無可取代的搭檔……",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "\\n老夫身為一個分送喜悅的人，",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "怎麼會這麼愚蠢。",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "請你們……",
    "voice": "vo_adv_5029007_019",
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "請你們，",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "原諒我吧……！",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "\\n",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "若沒有你們，",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "老夫就沒有辦法繼續當聖誕老人了。",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "\\n有了馴鹿的幫忙，",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "聖誕老人才能是聖誕老人啊……！",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "精英馴鹿們",
    "words": "噗喔……",
    "voice": "vo_adv_5029007_020",
    "unit_id": 4011
  },
  {
    "type": "dialogue",
    "name": "精英馴鹿們",
    "words": "噗喔～……！\\n（我們也是……我們都忘了如果沒有主人，別說是菁英了，\\n我們根本就只是普通的馴鹿而已……對不起……！）",
    "voice": null,
    "unit_id": 4011
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……太好了。",
    "voice": "vo_adv_5029007_021",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n馴鹿先生牠們，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "好像原諒我們了……！",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "所以，",
    "voice": "vo_adv_5029007_022",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "有共識了嗎？",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "那我們走吧。",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "咦？",
    "voice": "vo_adv_5029007_023",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "精英馴鹿們",
    "words": "噗？",
    "voice": "vo_adv_5029007_024",
    "unit_id": 4011
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "喂喂。",
    "voice": "vo_adv_5029007_025",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n你們該不會以為攻擊我以後，",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "還能全身而退吧？",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯嗯。",
    "voice": "vo_adv_5029007_026",
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n造反的這筆債，",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你們得親自來還啊？",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "咦？",
    "voice": "vo_adv_5029007_027",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "妳們是認真的嗎！？",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "抱歉！　",
    "voice": "vo_adv_5029007_028",
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "這次這件事，",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "都是因為老夫思慮不周而引起的！",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "\\n可以請妳們",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "原諒",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "聖誕老人",
    "words": "這些孩子嗎……！",
    "voice": null,
    "unit_id": 3911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "就是啊！製作人！　",
    "voice": "vo_adv_5029007_029",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "伊莉亞！",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "好不容易快要達成共識了！",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "哼。",
    "voice": "vo_adv_5029007_030",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n別說這麼多，跟我來。",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "是啊。",
    "voice": "vo_adv_5029007_031",
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n不快一點，聖誕節就要結束了。",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "啊真是的！",
    "voice": "vo_adv_5029007_032",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "等一下嘛！",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n妳們太我行我素了啦……！",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "咦？　",
    "voice": "vo_adv_5029007_033",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這裡是……",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "妳在幹嘛？　",
