  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "喔～",
    "voice": "vo_adv_5029007_070",
    "unit_id": 111712
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這麼說起來，",
    "voice": null,
    "unit_id": 111712
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n新一任的聖誕老人這事，最後的結果是怎麼樣啊？",
    "voice": null,
    "unit_id": 111712
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "啊！",
    "voice": "vo_adv_5029007_071",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這麼說起來……？",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "對耶。",
    "voice": "vo_adv_5029007_072",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這種事情可不能就這樣含糊帶過。",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n我絕對要把那個袋子弄到手……",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "嗯？　",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "那個袋子……？",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……克莉絲提娜，",
    "voice": "vo_adv_5029007_073",
    "unit_id": 111712
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妳剛剛",
    "voice": null,
    "unit_id": 111712
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n是不是把那個袋子，",
    "voice": null,
    "unit_id": 111712
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "豪邁地切碎了啊……",
    "voice": null,
    "unit_id": 111712
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那個袋子很稀有，",
    "voice": "vo_adv_5029007_074",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n聖誕老人好像這麼說過耶……",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……嗯。",
    "voice": "vo_adv_5029007_075",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "克莉絲提娜……",
    "voice": "vo_adv_5029007_076",
    "unit_id": 111712
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "製作人……",
    "voice": "vo_adv_5029007_077",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "難得能這樣泡溫泉，",
    "voice": "vo_adv_5029007_078",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "其他事情就",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "讓它過去吧？",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "伊莉亞、望",
    "words": "……唉～",
    "voice": "vo_adv_5029007_079",
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "end"
  }
]
