  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "想不太起來了呢……",
    "voice": "vo_adv_5128085_000",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "但再怎麼說，",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "也不可能會有那種事吧……",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "啊啊，",
    "voice": "vo_adv_5128085_001",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "來得正好。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n我想跟你確認一下……",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我們到底",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "是怎麼締結婚約的呀？",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不，",
    "voice": "vo_adv_5128085_002",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "因為我想來想去，",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "都沒有被求婚的記憶。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你記得當時的事嗎？",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n……果然，",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你也不記得自己有求過婚啊。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "雖然覺得有點奇怪，",
    "voice": "vo_adv_5128085_003",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不過算了。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n不記得有求過婚的話，",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "只要現在再求一次就好了對吧？",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "所以，",
    "voice": "vo_adv_5128085_004",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "拜託你",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "再重新對我做一次",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n令人動心的",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "俐落告白吧♪",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……什麼？",
    "voice": "vo_adv_5128085_005",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你說你沒有告白過，所以不知道怎麼做？",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n要我",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "先示範給你看……？",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "沒、",
    "voice": "vo_adv_5128085_006",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "沒想到竟然來這招……",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "真是傷腦筋……",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n我也不可能",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "會有求婚的經驗吧？",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n不過，",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "明明我比較年長，",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "要是說出這種沒面子的事感覺也有點……",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……我知道了。",
    "voice": "vo_adv_5128085_007",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n我不喜歡拐彎抹角的，",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "要是聽起來很平淡也不准抱怨唷？",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n那麼……",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "咳咳！",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小哥，",
    "voice": "vo_adv_5128085_008",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我愛你。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你願意……",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "跟我",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "結婚嗎……？",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "流夏不安地牽起{0}的手，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n不發一語。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "啊……",
    "voice": "vo_adv_5128085_009",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "呵呵♪",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n謝謝你……",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "真的……",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "要不要再稍微……",
    "voice": "vo_adv_5128085_010",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "接著繼續下去呢？",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我現在終於",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "對彼此的心意有信心了……",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我",
    "voice": "vo_adv_5128085_011",
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "愛你。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "比世界上",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "的任何人……",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "都還要更喜歡你唷。",
    "voice": null,
    "unit_id": 127612
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就這樣，兩人彼此相擁，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n直到心滿意足為止。",
    "voice": null,
    "unit_id": null
  }
]
