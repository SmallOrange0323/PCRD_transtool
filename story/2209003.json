[
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "──騎士先生……！",
    "voice": "vo_adv_2209003_000",
    "unit_id": 133111
  },
  {
    "type": "still",
    "still_id": "220900301"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "靠著格蕾斯與{0}通力合作，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n成功破壞了闖入居住區的蠻賊貪鯊號。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n然而倭的反擊卻斬碎了格蕾斯與薇歐莉特──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "background",
    "bg_id": "502112"
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "…………",
    "voice": "vo_adv_2209003_001",
    "unit_id": 130013
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "啊、",
    "voice": "vo_adv_2209003_002",
    "unit_id": 130113
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "啊啊……",
    "voice": null,
    "unit_id": 130113
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n……",
    "voice": null,
    "unit_id": 130113
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "死、",
    "voice": null,
    "unit_id": 130113
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "死掉了……",
    "voice": null,
    "unit_id": 130113
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "嗚哇～",
    "voice": "vo_adv_2209003_003",
    "unit_id": 130213
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "屍體四分五裂耶～",
    "voice": null,
    "unit_id": 130213
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n有夠血腥～",
    "voice": null,
    "unit_id": 130213
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "不如說，",
    "voice": "vo_adv_2209003_004",
    "unit_id": 130213
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n妳們竟敢打壞我的小鯊鯊──！",
    "voice": null,
    "unit_id": 130213
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n我絕不原諒妳們！",
    "voice": null,
    "unit_id": 130213
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "不過不過，",
    "voice": "vo_adv_2209003_005",
    "unit_id": 130213
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n現在人也死掉了──！",
    "voice": null,
    "unit_id": 130213
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 130213
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "呀哈，呀哈哈！",
    "voice": null,
    "unit_id": 130213
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "就算是女人跟小孩──",
    "voice": "vo_adv_2209003_006",
    "unit_id": 130013
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "在賭局中輸掉也是會喪命的。",
    "voice": null,
    "unit_id": 130013
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n你連這種事都不懂嗎？",
    "voice": null,
    "unit_id": 130013
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "既然都學到一課了──",
    "voice": "vo_adv_2209003_007",
    "unit_id": 130013
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "你也去死吧。",
    "voice": null,
    "unit_id": 130013
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n我記得",
    "voice": null,
    "unit_id": 130013
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "是叫做「陪葬」。",
    "voice": null,
    "unit_id": 130013
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n當有大人物死掉時，",
    "voice": null,
    "unit_id": 130013
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "身邊的人不是就該追隨一起死嗎。",
    "voice": null,
    "unit_id": 130013
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "姊、",
    "voice": "vo_adv_2209003_008",
    "unit_id": 130113
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "姊姊……",
    "voice": null,
    "unit_id": 130113
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n再這樣下去……",
    "voice": null,
    "unit_id": 130113
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "這次……",
    "voice": "vo_adv_2209003_009",
    "unit_id": 130113
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "一定要說出口，",
    "voice": null,
    "unit_id": 130113
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 130113
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "阻止姊姊才行……",
    "voice": null,
    "unit_id": 130113
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "……動手吧，姊姊。",
    "voice": "vo_adv_2209003_010",
    "unit_id": 130113
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n把他砍得四分五裂。",
    "voice": null,
    "unit_id": 130113
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "啊，",
    "voice": "vo_adv_2209003_011",
    "unit_id": 130113
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "又來了……！　",
    "voice": null,
    "unit_id": 130113
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "呀哈哈！",
    "voice": "vo_adv_2209003_012",
    "unit_id": 130213
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n笨菜姊",
    "voice": null,
    "unit_id": 130213
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "好可怕～！",
    "voice": null,
    "unit_id": 130213
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "哼。",
    "voice": "vo_adv_2209003_013",
    "unit_id": 130013
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130013
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "再見了──",
    "voice": null,
    "unit_id": 130013
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "之後可別變成鬼跑出來啊。",
    "voice": null,
    "unit_id": 130013
  },
  {
    "type": "background",
    "bg_id": "502112"
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "──什麼！？",
    "voice": "vo_adv_2209003_014",
    "unit_id": 130013
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "我趕上了。",
    "voice": "vo_adv_2209003_015",
    "unit_id": 133013
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n對吧，",
    "voice": null,
    "unit_id": 133013
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "騎士氏。",
    "voice": null,
    "unit_id": 133013
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "你好，",
    "voice": "vo_adv_2209003_016",
    "unit_id": 133013
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n我變成鬼跑出來了。",
    "voice": null,
    "unit_id": 133013
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "這當然只是個玩笑。",
    "voice": "vo_adv_2209003_017",
    "unit_id": 133013
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "妳、",
    "voice": "vo_adv_2209003_018",
    "unit_id": 130113
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "妳的腳……",
    "voice": null,
    "unit_id": 130113
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "不如說",
    "voice": null,
    "unit_id": 130113
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "全身都有點透明……！",
    "voice": null,
    "unit_id": 130113
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 130113
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "難不成",
    "voice": null,
    "unit_id": 130113
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "真的是幽靈……！？",
    "voice": null,
    "unit_id": 130113
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "應該說",
    "voice": "vo_adv_2209003_019",
    "unit_id": 133013
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "是亡靈才對。",
    "voice": null,
    "unit_id": 133013
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 133013
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "不過，",
    "voice": null,
    "unit_id": 133013
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "兩者也差不了多少。",
    "voice": null,
    "unit_id": 133013
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "嘖……！",
    "voice": "vo_adv_2209003_020",
    "unit_id": 130013
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n原本以為已經贏了的賭局，後來才說不算數……",
    "voice": null,
    "unit_id": 130013
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n沒有比這更讓人火大的了！",
    "voice": null,
    "unit_id": 130013
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "第二回合──",
    "voice": "vo_adv_2209003_021",
    "unit_id": 130013
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "不，",
    "voice": null,
    "unit_id": 130013
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "我要「加碼」！",
    "voice": null,
    "unit_id": 130013
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n管妳是亡靈還是幽靈，",
    "voice": null,
    "unit_id": 130013
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "我要殺到妳死為止！",
    "voice": null,
    "unit_id": 130013
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "……",
    "voice": "vo_adv_2209003_022",
    "unit_id": 133013
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "「──【蠻賊三姊妹】，",
    "voice": "vo_adv_2209003_023",
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n請稍等一下。」",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "妳、",
    "voice": "vo_adv_2209003_024",
    "unit_id": 130113
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "妳是……",
    "voice": null,
    "unit_id": 130113
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "呃！",
    "voice": "vo_adv_2209003_025",
    "unit_id": 130213
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n這不是老土眼鏡女嗎～",
    "voice": null,
    "unit_id": 130213
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "「……",
    "voice": "vo_adv_2209003_026",
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "抱歉忙碌之中打擾。",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n不過，",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "能請妳們過來一趟嗎？」",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "啊啊！？",
    "voice": "vo_adv_2209003_027",
    "unit_id": 130013
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n究竟有什麼事，",
    "voice": null,
    "unit_id": 130013
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "接下來才要一決勝負耶！",
    "voice": null,
    "unit_id": 130013
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "「阿剌克涅女士",
    "voice": "vo_adv_2209003_028",
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "說有東西想讓妳們看，",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n接下來會由我帶路。」",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "……",
    "voice": "vo_adv_2209003_029",
    "unit_id": 130013
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "「……我就當作妳同意了。",
    "voice": "vo_adv_2209003_030",
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "話說回來──」",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "「……公主‧薇歐莉特",
    "voice": "vo_adv_2209003_031",
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "跟她的隨從，",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n我還以為當時的暗殺失敗了……",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "但原來是這麼一回事。」",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "「算了，",
    "voice": "vo_adv_2209003_032",
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "也不用在意。",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "如果只有這點程度，",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "算不上什麼威脅。",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n隨時都能抹殺──",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "不對，",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "應該說『超渡』比較恰當。」",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "……呼。",
    "voice": "vo_adv_2209003_033",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "得救了。",
    "voice": "vo_adv_2209003_034",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "老實說，",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "我的體力已經被消耗得差不多了。",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "她也……",
    "voice": "vo_adv_2209003_035",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "雖然",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "算不上沒事。",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "公主，",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n妳能動嗎？",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "……格蕾斯。",
    "voice": "vo_adv_2209003_036",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n那個……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n我的左手",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "不曉得掉到哪裡去了……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "──來，",
    "voice": "vo_adv_2209003_037",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "這是妳的左手。",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "還有需要幫忙的事嗎？",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "然後……",
    "voice": "vo_adv_2209003_038",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "不好意思，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n可以用力",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "壓緊我的身體嗎……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "嘿咻。",
    "voice": "vo_adv_2209003_039",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n我順便用魔法",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "修補妳的衣服喔。",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "讓妳費心了。",
    "voice": "vo_adv_2209003_040",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n嗚嗚……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "……呼……",
    "voice": "vo_adv_2209003_041",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "……騎士先生，",
    "voice": "vo_adv_2209003_042",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "不好意思……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n讓你嚇到了。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "……嗯。",
    "voice": "vo_adv_2209003_043",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "那個……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "我是",
    "voice": "vo_adv_2209003_044",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "不死生物……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n也就是",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "會動的屍體……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "所幸，",
    "voice": "vo_adv_2209003_045",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "我和格蕾斯由於這副外表，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n可以表現得像個人類……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "然而在不死生物中，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "有些則跟魔物沒有兩樣。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "考量到是第一次見面，",
    "voice": "vo_adv_2209003_046",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "要是讓大家格外恐懼，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n反而會不利於對話……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "才一直",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "保密到現在。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "真的非常抱歉。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "騎士先生……",
    "voice": "vo_adv_2209003_047",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "……話說，",
    "voice": "vo_adv_2209003_048",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n騎士氏就不在意我的狀況嗎？",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "你看。",
    "voice": "vo_adv_2209003_049",
    "unit_id": 133014
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n我可是幽靈喔，幽靈。",
    "voice": null,
    "unit_id": 133014
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n全身透明喔。",
    "voice": null,
    "unit_id": 133014
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "…………這樣啊。",
    "voice": "vo_adv_2209003_050",
    "unit_id": 133014
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "……格蕾斯？",
    "voice": "vo_adv_2209003_051",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "看來",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "妳也傷得不輕呢……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n身體",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "比平時還要來得透明呀。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "……是我大意了。",
    "voice": "vo_adv_2209003_052",
    "unit_id": 133014
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n讓公主跟騎士氏面臨險境，",
    "voice": null,
    "unit_id": 133014
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "真的非常抱歉。",
    "voice": null,
    "unit_id": 133014
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "你是在安慰我嗎？",
    "voice": "vo_adv_2209003_053",
    "unit_id": 133014
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n果真會泡妞……",
    "voice": null,
    "unit_id": 133014
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "果真很溫柔呢。",
    "voice": null,
    "unit_id": 133014
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n騎士氏。",
    "voice": null,
    "unit_id": 133014
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "先不說了……",
    "voice": "vo_adv_2209003_054",
    "unit_id": 133014
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "照這樣下去，",
    "voice": null,
    "unit_id": 133014
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n可能很難護送公主",
    "voice": null,
    "unit_id": 133014
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "到吉歐‧尼布爾黑爾的城堡。",
    "voice": null,
    "unit_id": 133014
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n不但有很多魔物，",
    "voice": null,
    "unit_id": 133014
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "空中還降下了能操控他人的絲線。",
    "voice": null,
    "unit_id": 133014
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "不論是我",
    "voice": "vo_adv_2209003_055",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "還是格蕾斯，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n都得休養一下才行。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "沒錯。",
    "voice": "vo_adv_2209003_056",
    "unit_id": 133014
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n就算死掉了，",
    "voice": null,
    "unit_id": 133014
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "也不能不休息。",
    "voice": null,
    "unit_id": 133014
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "……那麼，",
    "voice": "vo_adv_2209003_057",
    "unit_id": 133014
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n雖然慚愧，",
    "voice": null,
    "unit_id": 133014
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "但我們悄悄撤退吧。",
    "voice": null,
    "unit_id": 133014
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "…………\\n……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "501790"
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "傳令，",
    "voice": "vo_adv_2209003_058",
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n妳回來啦。",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "……是的。",
    "voice": "vo_adv_2209003_059",
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n如您所願，",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "我將【蠻賊三姊妹】帶回來了。",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "嘖──",
    "voice": "vo_adv_2209003_060",
    "unit_id": 130013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "不用露出",
    "voice": "vo_adv_2209003_061",
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "那麼高興的表情。",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n吾只是",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "想讓妳們也看點有趣的東西。",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "妳說什麼……？",
    "voice": "vo_adv_2209003_062",
    "unit_id": 130013
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "……那麼，",
    "voice": "vo_adv_2209003_063",
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n開始執行",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "下一道命令──",
    "voice": null,
    "unit_id": 193711
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "……另一方面，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n待在鬼岩城塞的貪吃佩可等人……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "502170"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──轟隆隆！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "這是",
    "voice": "vo_adv_2209003_064",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "蠻賊貪鯊號的砲擊……！",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "兄長大人",
    "voice": "vo_adv_2209003_065",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "說不定會被捲進去……！",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那個笨蛋！",
    "voice": "vo_adv_2209003_066",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n貪吃佩可！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "可蘿仔！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我們走吧！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可、可可蘿",
    "words": "好──",
    "voice": "vo_adv_2209003_067",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "「──請恁們",
    "voice": "vo_adv_2209003_068",
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "稍待片刻。」",
    "voice": null,
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "涅妃‧涅羅小姐？",
    "voice": "vo_adv_2209003_069",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳現在",
    "voice": "vo_adv_2209003_070",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "在哪裡啊！？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n雖然有聽說妳在切除空中降下的「絲線」──",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "still",
    "still_id": "220900103"
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "「就在恁們的正上方……",
    "voice": "vo_adv_2209003_071",
    "unit_id": 129712
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n這座城塞的",
