[
  {
    "type": "dialogue",
    "name": "步未",
    "words": "有種",
    "voice": "vo_adv_5090204_000",
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "討厭的感覺……",
    "voice": null,
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n皮膚隱隱作痛，",
    "voice": null,
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "不停地起雞皮疙瘩……",
    "voice": null,
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "賭場王那個渾蛋……",
    "voice": "vo_adv_5090204_001",
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n都離這麼遠了，",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "還是能感受到他強大的壓力……",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "也就是說，剛剛他還沒有拿出真本事嗎……！",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "正好……！",
    "voice": "vo_adv_5090204_002",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n不管他用「龍之卵」強化到什麼程度，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n我們都要揍扁他！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "對吧，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "祈梨、",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "步未！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "說的沒錯！",
    "voice": "vo_adv_5090204_003",
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "就由我們",
    "voice": "vo_adv_5090204_004",
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "來打倒賭場王吧……！",
    "voice": null,
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "為了",
    "voice": null,
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "結束這一切……！",
    "voice": null,
    "unit_id": 121511
  }
]
