[
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "出現了呢，",
    "voice": "vo_adv_9006602_000",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "【蠻賊三姊妹】……！",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "若菜、布武機",
    "words": "「呀哈哈哈☆」\\n「……各、各位好……」",
    "voice": "vo_adv_9006602_001",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "來了啊，",
    "voice": "vo_adv_9006602_002",
    "unit_id": 130013
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "貪吃公主一夥人──",
    "voice": null,
    "unit_id": 130013
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n這次絕對",
    "voice": null,
    "unit_id": 130013
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "要跟你們分出勝負！",
    "voice": null,
    "unit_id": 130013
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "倭小姐！",
    "voice": "vo_adv_9006602_003",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我是不會把皇家裝備",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "交給妳的！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "嘖……",
    "voice": "vo_adv_9006602_004",
    "unit_id": 130013
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "事到如今也不需要那種東西了。",
    "voice": null,
    "unit_id": 130013
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130013
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "我要說的是，",
    "voice": null,
    "unit_id": 130013
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n除了擋下你們，還要順便收下你們的性命……！",
    "voice": null,
    "unit_id": 130013
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "……璃亞，",
    "voice": "vo_adv_9006602_005",
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "競技場那時候也是，",
    "voice": null,
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "妳不認為……",
    "voice": null,
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n這樣果然不像倭小姐她們的作風嗎？",
    "voice": null,
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "……是的。",
    "voice": "vo_adv_9006602_006",
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "如果她們並沒有被阿剌克涅的絲線控制，",
    "voice": null,
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n那是為什麼……",
    "voice": null,
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "要來了。",
    "voice": "vo_adv_9006602_007",
    "unit_id": 126111
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "總覺得",
    "voice": "vo_adv_9006602_008",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這些傢伙的力量",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "比之前戰鬥時提升不少！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳們可別鬆懈了啊！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "莉莉、可璃亞",
    "words": "「……是！」",
    "voice": "vo_adv_9006602_009",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "──皇家裝備～？",
    "voice": "vo_adv_9006602_010",
    "unit_id": 130213
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n就算倭姊不需要──",
    "voice": null,
    "unit_id": 130213
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "我也會收下的啦──",
    "voice": null,
    "unit_id": 130213
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 130213
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "就拿來當作小鯊鯊的修理費！",
    "voice": null,
    "unit_id": 130213
  }
]
