[
  {
    "type": "background",
    "bg_id": "501630"
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "咦……！",
    "voice": "vo_adv_9100103_000",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "那是",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "黑之王！？",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "牠竟然復活了……！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那個彌勒還是勒彌什麼的，",
    "voice": "vo_adv_9100103_001",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n未免太多管閒事了！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n既然如此，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那我就再次把牠打得落花流水！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "怎麼？",
    "voice": "vo_adv_9100103_002",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n你們",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "曾和那傢伙對戰過嗎？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "希望之力……？",
    "voice": "vo_adv_9100103_003",
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "這是什麼意思？",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "黑之王的弱點",
    "voice": "vo_adv_9100103_004",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "正是我們心中所懷抱的希望。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n那時，大家將希望全都灌注到我的弓箭上，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n用這種方式打倒牠。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "不過，",
    "voice": "vo_adv_9100103_005",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "那個……",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n我們是在繪本故事中",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "使用這股力量的。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "在這邊的世界能不能比照運用，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "老實說，我不知道……",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "唔……",
    "voice": "vo_adv_9100103_006",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "說得也是……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n繪本與現實是不一樣的……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "真是的！",
    "voice": "vo_adv_9100103_007",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "妳們兩個",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "在那邊碎念些什麼啊！？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n既然之前曾用這種方式打倒過牠，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "總之我們就先試試看啊！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n好啦，各位。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "如果大家都明白的話，那就快心懷希望吧！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "妳說希望嗎～",
    "voice": "vo_adv_9100103_008",
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "這包在我身上♪",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n姐姐",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "今後還有很多事想和弟弟一起做呢！",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n像是一起約會啦～",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "一起泡澡",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "一起耍懶啦～",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "還有很多很多喔～♪",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "啊！",
    "voice": "vo_adv_9100103_009",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "姐姐太狡猾了！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我、",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我可沒有說",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "要捨棄這些希望喔！？",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "等生活恢復平靜，我要叫哥哥多陪我一點！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "向姐姐撒嬌的前輩，",
    "voice": "vo_adv_9100103_010",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "還有照顧妹妹的前輩……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "為了當作",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "日後的參考，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我想我也再多觀察一下好了……！",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "唔哇……",
    "voice": "vo_adv_9100103_011",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "看、",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "看來你",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "還真辛苦……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n下次我請你吃頓飯吧……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "呵呵呵。",
    "voice": "vo_adv_9100103_012",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "大家都很順利地懷抱起希望！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那麼，就將這些希望化為力量，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n用來打倒黑之王吧──！",
    "voice": null,
    "unit_id": 106611
  }
]
