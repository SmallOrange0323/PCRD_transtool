[
  {
    "type": "background",
    "bg_id": "501470"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}及日和總算趕在天色變暗前回到蘭德索爾，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n兩人前往委託人老奶奶身旁。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我們回來了～！",
    "voice": "vo_adv_1087008_000",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "但不是那種凱旋歸來！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "的感覺呢。",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "趕快去老奶奶等我們的地方吧。",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "雖說老奶奶被騙了，",
    "voice": "vo_adv_1087008_001",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n但她好像很期待",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "能寄信給她的孫子，",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "希望她不會覺得很失望……",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "background",
    "bg_id": "500371"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "然而，等著兩人的是滿面笑容的老奶奶。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "啊",
    "voice": "vo_adv_1087008_002",
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "啊，",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "太好了！",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n你們平安回來了啊。",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "我等很久了！",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "奶奶，",
    "voice": "vo_adv_1087008_003",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "在那之前要先向他們道歉……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我們趕忙回來了！",
    "voice": "vo_adv_1087008_004",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "然後，",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "呃……",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "那位是？",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "……啊，",
    "voice": "vo_adv_1087008_005",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "不好意思。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "\\n我還沒自我介紹吧。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "我是奶奶的孫子。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "呵呵，",
    "voice": "vo_adv_1087008_006",
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "你們前腳剛走，孫子就傳來了聯絡，",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "發現事情不對勁，",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "孫子也急急忙忙跑來這了呢。",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "真的很抱歉呀。",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我才要道歉，",
    "voice": "vo_adv_1087008_007",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "雖然利用了妳的信，",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "但多虧如此",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我們才抓到了壞人！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "不過，",
    "voice": "vo_adv_1087008_008",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "太好了……",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n老奶奶",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "並沒有因此很消沉。",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "當我發現被騙時",
    "voice": "vo_adv_1087008_009",
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "的確很震驚……",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "但是，",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "孫子已經了不起到會讓人認錯了，",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n所以沒發現被騙也是沒辦法的事。",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "我才沒有",
    "voice": "vo_adv_1087008_010",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "變得多了不起呢。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "我還只是初出茅廬而已。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "啊，",
    "voice": "vo_adv_1087008_011",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我把這封信和行囊",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "還給妳。",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "還是說，",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "要交給真正的孫子呢？",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "也對呢，",
    "voice": "vo_adv_1087008_012",
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "把這份行囊當作是我的賀禮交給他吧。",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n而信的話，",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "我下次會",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "好好重新寫一封的。",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "是啊。",
    "voice": "vo_adv_1087008_013",
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n這孩子，",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "這次好像要在蘭德索爾辦個展呢。",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n會聯絡我也是為了這件事。",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "個展！？",
    "voice": "vo_adv_1087008_014",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "好厲害～！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "他是藝術家嗎？",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "沒那麼誇張啦，",
    "voice": "vo_adv_1087008_015",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "我是剛獨立的攝影師。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "所以，",
    "voice": "vo_adv_1087008_016",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "雖說我也想給你們一些謝禮，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "但很丟臉的是",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "我現在很窮。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "\\n怎麼辦呢……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "那麼，",
    "voice": "vo_adv_1087008_017",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "能請你替我們拍照嗎？",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我們兩人，",
    "voice": "vo_adv_1087008_018",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "正好想拍賀年卡用的照片！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n其實",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這次委託，",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "也是抱著想趁機",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n到各地尋找拍攝景點的想法才接下的……",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "唉呀，",
    "voice": "vo_adv_1087008_019",
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "那不是正好嗎？",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "就幫他們拍吧。",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "讓專家來拍",
    "voice": "vo_adv_1087008_020",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "會讓人很放心，",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "請務必",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "幫我們拍！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "既然是這種事，",
    "voice": "vo_adv_1087008_021",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "那我很樂意替兩位拍了。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "不過，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "我的器材都不在這裡呢。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "可以改天拍的話請到我的攝影棚……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "但賀年卡用的還是該趕快拍吧。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "這是你的相機嗎？",
    "voice": "vo_adv_1087008_022",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "剛好跟我用的是同個型號，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "\\n那就借我用一下吧。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "那",
    "voice": "vo_adv_1087008_023",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "麼，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "借這背景一角來拍吧。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "好的！",
    "voice": "vo_adv_1087008_024",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "麻煩你了！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "拍攝了一會兒後……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "好，",
    "voice": "vo_adv_1087008_025",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "這樣差不多就行了吧。",
