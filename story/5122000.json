  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "\\n才不是什麼客人呢。",
    "voice": null,
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "──討厭！",
    "voice": "vo_adv_5122000_082",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "你們突然",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "冒出來是要做什麼啊！",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "這可真是粗暴的歡迎呢……？",
    "voice": "vo_adv_5122000_083",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "就是說啊，",
    "voice": "vo_adv_5122000_084",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "這片大海的異變",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "你們不覺得困擾嗎？",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "還是說有什麼",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "理由……",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "漁協的人",
    "words": "不要做多餘的打探。",
    "voice": "vo_adv_5122000_085",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁協的人",
    "words": "好了，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁協的人",
    "words": "快滾出去。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "呀",
    "voice": "vo_adv_5122000_086",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "啊──！",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "好了等一下。",
    "voice": "vo_adv_5122000_087",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n別對生活在陸上的人",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "那麼粗暴啊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "漁協的人們",
    "words": "──！？",
    "voice": "vo_adv_5122000_088",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "好久不見了，",
    "voice": "vo_adv_5122000_089",
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "似似仔、",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "披風小伙子。",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "\\n",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "你們看起來很有精神呢。",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……和正先生！",
    "voice": "vo_adv_5122000_090",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "這傢伙",
    "voice": "vo_adv_5122000_091",
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "是這裡的漁協協會長。",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "\\n",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "明明是出自好學校的知識分子，",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "卻選擇回來家鄉的怪人。",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "漁協協會長",
    "words": "……你認識他們嗎？",
    "voice": "vo_adv_5122000_092",
    "unit_id": 7511
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "沒錯。",
    "voice": "vo_adv_5122000_093",
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "這些人可以信任。",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "\\n把一切都交代清楚吧，",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "\\n",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "關於那些",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "我們無法逃避的",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "和正",
    "words": "「來龍去脈」。",
    "voice": null,
    "unit_id": 6411
  }
]
