    "name": "真陽",
    "words": "今天真的是糟糕的一天～",
    "voice": "vo_adv_5029004_005",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n明明是聖誕節，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "卻發生一堆慘事……",
    "voice": null,
    "unit_id": 103311
