  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "這才是真正的慘誕節，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "……",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "一點也不好笑的啦……",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "比妾身想像中的還要有餘裕呢！",
    "voice": "vo_adv_5029004_006",
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "那邊的小牛姑娘，",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這裡到底發生了什麼事？",
