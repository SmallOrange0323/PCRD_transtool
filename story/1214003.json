    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "因為我是總是懷著廣闊心胸的淑女啊，",
