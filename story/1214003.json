[
  {
    "type": "background",
    "bg_id": "500110"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "美咲獨自一人在咲戀育幼院的廚房中煩惱著。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "嗯～",
    "voice": "vo_adv_1214003_000",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "要做什麼好呢……",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我被拜託負責看家，",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "原本還想說現在育幼院沒有其他人，",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "正是大好機會！的說……",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "果然還是",
    "voice": "vo_adv_1214003_001",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "做媽媽教我做的手工蛋糕好了？",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "那個蛋糕，",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我和胡桃一起做的時候，大家都很喜歡呢。",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "不過",
    "voice": "vo_adv_1214003_002",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "感覺不太夠呢，",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "還是應該說不夠華麗吧。",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "這種時候，",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我希望能展現自己的風格，把東西弄得很豪華。",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "咦？",
    "voice": "vo_adv_1214003_003",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "是有客人來了嗎？",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "來了～",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我馬上過去～！",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "原來是你啊，",
    "voice": "vo_adv_1214003_004",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你來得正是時候呢。",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "啊，",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你帶了好多東西。",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "那些東西",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "是怎麼了？",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "原來是要配送的包裹啊，",
    "voice": "vo_adv_1214003_005",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "辛苦了。",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "欸欸，",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你送完包裹後，來這裡一趟。",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我現在非常煩惱，",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "所以需要你的意見。",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "為了在煩惱的淑女，",
    "voice": "vo_adv_1214003_006",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你也一起來動腦筋想解決的辦法！",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "……就是這樣，",
    "voice": "vo_adv_1214003_007",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我想要感謝",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "育幼院的大家平時對我的照顧。",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "對吧～！？",
    "voice": "vo_adv_1214003_008",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "身為成熟的淑女，",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n就是要認真想這方面的事情才行呢！",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "所以，",
    "voice": "vo_adv_1214003_009",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我想以很多當季水果，",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n做出時尚甜點，",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "來舉辦一場派對！",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "滿滿的奶油",
    "voice": "vo_adv_1214003_010",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "配上烤得鬆鬆軟軟的迷你蛋糕，",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "然後在閃閃發亮的果凍上，",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "裝飾寶石般的水果！",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "酥脆的派皮",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "配上奶油的千層酥也令人難以取捨呢……",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "雖然會有點孩子氣，",
    "voice": "vo_adv_1214003_011",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "但是經典的草莓鮮奶油蛋糕也不能少呢。",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "畢竟育幼院",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "還有很多年幼的小孩子呀。",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "欸，",
    "voice": "vo_adv_1214003_012",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你怎麼想？",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "既然都來到這一步了，",
    "voice": "vo_adv_1214003_013",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n就請一流的甜點師",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "幫我們配送過來啊♪",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n這還用說嗎！",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "這可是要表達我的感謝之意，",
    "voice": "vo_adv_1214003_014",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "如果還做和平時一樣的事，",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "不就沒意義了嗎？",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "而且……",
    "voice": "vo_adv_1214003_015",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "身為成熟的淑女，",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n還是少不了當季水果。",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "這是我昨天讀的時尚雜誌上頭寫的。",
    "voice": "vo_adv_1214003_016",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "「春天頂級的水果是",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "淑女的愛好」",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "喔！",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "裝飾了蛋糕、花和水果……",
    "voice": "vo_adv_1214003_017",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "這感覺",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "就是最頂級的",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "奢華了！",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "欸",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "欸，",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "很棒對吧！？",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你也想吃吃看對吧！？",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "咦？",
    "voice": "vo_adv_1214003_018",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "什麼？",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n做自己能力範圍內的事……？",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "真是的～！",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我不想聽你和媽媽一樣在那裡嘮叨啦！",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我是想做平常不會做的事情，",
    "voice": "vo_adv_1214003_019",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "然後給大家一個驚喜。",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "……不、",
    "voice": "vo_adv_1214003_020",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "不過，",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你說的話",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "也的確有道理。",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "可是，",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我一個人又做不了什麼大不了的東西……",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "對了！",
    "voice": "vo_adv_1214003_021",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你也來幫我做吧。",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n比起一個人，兩個人能做的事更多呀！",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我就任命你當我的助手吧♪",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "既然說定了，",
    "voice": "vo_adv_1214003_022",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "就該來決定要做什麼了！",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "說到草莓和奶油，",
    "voice": "vo_adv_1214003_023",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "的確就是草莓鮮奶油蛋糕。",
