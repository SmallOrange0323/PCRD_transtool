  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "是什麼？　",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "學禊做的驚嚇箱？",
