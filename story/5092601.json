[
  {
    "type": "background",
    "bg_id": "500370"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "海盜島的冒險結束後，霞等人返回蘭德索爾。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n然後過了一段時間──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "唉……",
    "voice": "vo_adv_5092601_000",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這是接下海盜島那份大案子的後遺症嗎？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n回到這裡以後，我整個人都提不起勁……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "雖說工作沒有好壞之分，",
    "voice": "vo_adv_5092601_001",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我也都沒有偷工減料，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "但完全感受不到",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "成就感跟充實感呢。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "而且在那之後，",
    "voice": "vo_adv_5092601_002",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我也沒有見到杏奈、忍",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "還有助手先生……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "雖然明白大家都很忙，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "但還是會覺得有點寂寞啊。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "回想著島上的時光，",
    "voice": "vo_adv_5092601_003",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "就這樣走進了古物道具店，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n我還真是病得不輕啊……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "該好好調整心態了……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "嗯？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這是……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "──事情就是這樣，",
    "voice": "vo_adv_5092601_004",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "既然我拿到了藏寶圖，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n接下來就讓我們去尋寶吧！",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "嗯，",
    "voice": "vo_adv_5092601_005",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我明白。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "可是，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "只要看了這份地圖就會明白我為什麼止不住興奮吧。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "……確實。",
    "voice": "vo_adv_5092601_006",
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這份地圖雖然很舊，",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "但反而",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "很有氛圍呢。",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "對啊，",
    "voice": "vo_adv_5092601_007",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "可以理解平時冷靜的霞為什麼會那麼興奮了。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n繼海盜島之後，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "又是一個可以獲得寶藏的機會！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "妳就盡情使用",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "「熾炎戰鬼煉獄血盟暗黑團」團長的力量吧！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "呵呵，",
    "voice": "vo_adv_5092601_008",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "明明就是杏奈最興奮。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "那我們趕緊",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "出發去尋寶吧！",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "請等一下。",
    "voice": "vo_adv_5092601_009",
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "妳突然說要去尋寶，",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n但我們完全沒準備",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "旅途要用的東西啊。",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "沒關係，",
    "voice": "vo_adv_5092601_010",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這是蘭德索爾的地圖喔。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "妳看，圖上寫著深淵樹界的地方。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這裡應該就是神秘森林。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "如此一來，在這裡的是──",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "冥狂斷崖……",
    "voice": "vo_adv_5092601_011",
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這個令人困惑的浮誇地名，",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "就是布里薩溪谷吧。",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "確實",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "跟蘭德索爾的地形吻合。",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "故意標記成與現實不同的地名，",
    "voice": "vo_adv_5092601_012",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "來讓人推理嗎？",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "製作這份地圖的人",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "還真有本事呢。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "這下",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "愈來愈有趣了──",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "唔，",
    "voice": "vo_adv_5092601_013",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "突然起風了……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "啊！",
    "voice": "vo_adv_5092601_014",
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "地、",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "地圖飛走了……",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "助手先生，",
    "voice": "vo_adv_5092601_015",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "快追啊！",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "呼、",
    "voice": "vo_adv_5092601_016",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "呼……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "終、",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "終於追到了……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "唔啊……",
    "voice": "vo_adv_5092601_017",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "掉進水窪裡溼掉了啦。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n要小心別弄破了……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "奇怪？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n地圖變了？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "沒錯。",
    "voice": "vo_adv_5092601_018",
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "多虧如此，原本看不見的地方",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "終於能看清了。",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "啊，",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "背面有簽名耶。",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "是繪製者的名字嗎？",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我看看……",
    "voice": "vo_adv_5092601_019",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "安妮、",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "羅潔‧馮……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "修特帕魯……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "咦，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "是我？",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "呃，",
    "voice": "vo_adv_5092601_020",
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這會是某種暗號嗎……？",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "不，",
    "voice": "vo_adv_5092601_021",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這只是單純寫上了杏奈的名字吧。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n所以……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "嗯～",
    "voice": "vo_adv_5092601_022",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "啊，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我想起來了！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n我小時候",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "畫了好幾張這種地圖。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "那些地圖幾乎都弄丟了，",
    "voice": "vo_adv_5092601_023",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我也忘得一乾二凈。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "沒想到會以這種形式再次見到。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "霞、",
    "voice": "vo_adv_5092601_024",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "忍。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我們之間",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "果然有著奇妙的緣分呢。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "哈哈哈哈！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "啊……",
    "voice": "vo_adv_5092601_025",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "仔細想想，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這些地名完全就是杏奈的品味啊。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "害我還這麼興奮，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "好丟臉……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "沒關係。",
    "voice": "vo_adv_5092601_026",
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我也完全被這張地圖",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "的精緻度給騙過去了。",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "可是",
    "voice": "vo_adv_5092601_027",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我們好不容易有幹勁，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "卻如字面上地被潑了一盆冷水呢。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n如何？",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "今天就這樣解散嗎？",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "……不。",
    "voice": "vo_adv_5092601_028",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "機會難得，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我希望妳可以教我繪製藏寶圖。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "雖然真相讓人覺得惋惜，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "但那張地圖本身就像是寶藏呢。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "是的，",
    "voice": "vo_adv_5092601_029",
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我也想要收藏一張。",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n然後",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "拿給公會的夥伴看，",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "告訴她們這是我的寶藏。",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "……這樣啊。",
    "voice": "vo_adv_5092601_030",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "那",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我就來教你們",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "完美藏寶圖的繪製方法吧！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "要不了多久大家就會察覺吧。和夥伴度過的輕鬆日常，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n才是連那個大海盜都無法獲得的最佳寶藏。",
    "voice": null,
    "unit_id": null
  }
]
