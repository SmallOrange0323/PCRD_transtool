[
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "雖說是冒牌貨，",
    "voice": "vo_adv_5029322_000",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "但還真是給我大鬧了一番啊。",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "一想到馴鹿們是這樣看待我的，",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n我克莉絲提娜還真有點心痛。",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "喔喔！",
    "voice": "vo_adv_5029322_001",
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "　克莉絲提娜在反省耶！",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "那個克莉絲提娜！",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "　竟然在反省自己耶！",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "太好了……",
    "voice": "vo_adv_5029322_002",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "馴鹿牠們的感受\\n也傳達給製作人了！",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……我是什麼妖魔鬼怪嗎？",
    "voice": "vo_adv_5029322_003",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "先不管這個了，",
    "voice": "vo_adv_5029322_004",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "馴鹿們似乎還打算繼續打的樣子。",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n就讓牠們來療癒我受傷的內心吧。",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身可不覺得這是什麼療癒。",
    "voice": "vo_adv_5029322_005",
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "那隻馴鹿，",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "牠的力量好像又更加強大了。",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "盡可能不要被正面擊中比較好。",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "沒問題！",
    "voice": "vo_adv_5029322_006",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "只要我們大家同心協力，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n不論是怎樣的攻擊都不成問題！",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "馴鹿先生！",
    "voice": "vo_adv_5029322_007",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我們是不會輸的！",
    "voice": null,
    "unit_id": 111611
  }
]
