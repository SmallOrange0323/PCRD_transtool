[
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "唔……！？",
    "voice": "vo_adv_9006527_000",
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "太好了！",
    "voice": "vo_adv_9006527_001",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n破壞掉",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "演算無效化了……！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "發生奇蹟",
    "voice": "vo_adv_9006527_002",
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "到這種程度……",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "也真讓人笑不出來啊。",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "……但是。",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "唔、",
    "voice": "vo_adv_9006527_003",
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "唔唔……！",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可、可可蘿",
    "words": "「雪菲小姐！」\\n「小雪菲！？」",
    "voice": "vo_adv_9006527_004",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我、",
    "voice": "vo_adv_9006527_005",
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我沒事……",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n畢竟",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "就差一點了。",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我可不能",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "在這裡倒下……！",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我們方的況狀",
    "voice": "vo_adv_9006527_006",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "也是滿身瘡痍。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n不能再繼續拖下去……！",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "這樣的話……",
    "voice": "vo_adv_9006527_007",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "騎士先生！",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n拜託你了！",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "……好啊。",
    "voice": "vo_adv_9006527_008",
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "既然如此……",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "既然如此，",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "我現在就將此身捕獲的眾多靈魂作為階梯，",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n來引發所謂的奇蹟吧……！",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "唔！",
    "voice": "vo_adv_9006527_009",
    "unit_id": 180111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 180111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "對方似乎",
    "voice": null,
    "unit_id": 180111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "也要徹底使出真本事了……！",
    "voice": null,
    "unit_id": 180111
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "啊啊──",
    "voice": "vo_adv_9006527_010",
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "神啊神啊神啊！",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n奇蹟的根源啊！",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n人智不可觸及的理外之混沌啊！",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "人類史上獨一無二的",
    "voice": "vo_adv_9006527_011",
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "奇蹟與神祕的聚集地──",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n在此化為靈魂坩堝的",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "阿斯特朗傳奇！",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n在我面前",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "顯現其身姿吧！",
    "voice": null,
    "unit_id": 192613
  }
]
