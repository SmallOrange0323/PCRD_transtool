  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "咦……？",
    "voice": "vo_adv_9500029_000",
    "unit_id": 102141
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n這是要選我嗎？",
    "voice": null,
    "unit_id": 102141
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "哥哥……！",
    "voice": "vo_adv_9500029_001",
    "unit_id": 102141
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102141
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "一直以來都……",
    "voice": null,
    "unit_id": 102141
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我",
    "voice": null,
    "unit_id": 102141
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "真的好開心……！",
    "voice": null,
    "unit_id": 102141
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "那、",
    "voice": "vo_adv_9500029_002",
    "unit_id": 102141
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "那個……！",
    "voice": null,
    "unit_id": 102141
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102141
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "你還記得",
    "voice": null,
    "unit_id": 102141
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我之前說過的話嗎？",
    "voice": null,
    "unit_id": 102141
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102141
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "那句「以後，能說出口了，",
    "voice": null,
    "unit_id": 102141
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我會好好說出來的」",
    "voice": null,
    "unit_id": 102141
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "……",
    "voice": null,
    "unit_id": 102141
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "現在，",
    "voice": "vo_adv_9500029_003",
    "unit_id": 102141
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "請",
    "voice": null,
    "unit_id": 102141
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "讓我說出那句話。",
    "voice": null,
    "unit_id": 102141
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102141
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "不是舞台上的……",
    "voice": null,
    "unit_id": 102141
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "不是戲劇的台詞，",
    "voice": null,
    "unit_id": 102141
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "而是我用自己的話語。",
    "voice": null,
    "unit_id": 102141
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "吸……",
    "voice": "vo_adv_9500029_004",
    "unit_id": 102141
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "呼………",
    "voice": null,
    "unit_id": 102141
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "嗚……",
    "voice": "vo_adv_9500029_005",
    "unit_id": 102141
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "果然還是好緊張啊……",
    "voice": null,
    "unit_id": 102141
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102141
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "不過……",
    "voice": null,
    "unit_id": 102141
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "正式演出從不等人。",
    "voice": null,
    "unit_id": 102141
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n既然哥哥選擇了我，",
    "voice": null,
    "unit_id": 102141
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我就必須現在說出來才行！　",
    "voice": null,
    "unit_id": 102141
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我，",
    "voice": "vo_adv_9500029_006",
    "unit_id": 102141
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "喜歡哥哥……！",
    "voice": null,
    "unit_id": 102141
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n哥哥總是",
    "voice": null,
    "unit_id": 102141
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "守護著膽小的我，",
    "voice": null,
    "unit_id": 102141
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "給我加油打氣。",
    "voice": null,
    "unit_id": 102141
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n我最喜歡",
    "voice": null,
    "unit_id": 102141
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "這樣的哥哥了。",
    "voice": null,
    "unit_id": 102141
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "所以，",
    "voice": "vo_adv_9500029_007",
    "unit_id": 102141
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我也要一起戰鬥。",
    "voice": null,
    "unit_id": 102141
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102141
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我們好不容易才心意相通，",
    "voice": null,
    "unit_id": 102141
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n我才不想就這樣結束。",
    "voice": null,
    "unit_id": 102141
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "因為我想和哥哥，",
    "voice": "vo_adv_9500029_008",
    "unit_id": 102141
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "永遠在一起……！",
    "voice": null,
    "unit_id": 102141
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "好！",
    "voice": "vo_adv_9500029_009",
    "unit_id": 102141
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n雖然我還是第一次站上",
    "voice": null,
    "unit_id": 102141
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "攸關世界命運的大舞台……",
    "voice": null,
    "unit_id": 102141
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n不過，",
    "voice": null,
    "unit_id": 102141
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我會堅持到最後的。",
    "voice": null,
    "unit_id": 102141
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "為了像故事一樣的",
    "voice": "vo_adv_9500029_010",
    "unit_id": 102141
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "幸福結局！",
    "voice": null,
    "unit_id": 102141
  }
]
