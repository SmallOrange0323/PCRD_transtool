    "unit_id": 191615
  },
  {
    "type": "dialogue",
    "name": "冒險者1",
    "words": "可惡！",
    "voice": "vo_adv_1233001_019",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "冒險者1",
    "words": "這傢伙動作真靈活！",
