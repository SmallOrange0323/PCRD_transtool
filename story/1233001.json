  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}等人和霸瞳皇帝展開激戰後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n蘭德索爾剛恢復和平不久時。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}等人致力於城鎮復興的背後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n有一名少女入侵了阿斯特朗……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "嗯、",
    "voice": "vo_adv_1233001_000",
