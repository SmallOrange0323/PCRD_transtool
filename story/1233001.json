    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n沒辦法，",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "只能逃了～",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "background",
    "bg_id": "500170"
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "啊～",
    "voice": "vo_adv_1233001_022",
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "碰上倒霉事了～",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "原來這邊的人類要是見到魔物，",
