  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "……咦？",
    "voice": "vo_adv_9500075_000",
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n姑丈",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "要選彩羽嗎……？",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n真的……？",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "嗚嗚……",
    "voice": "vo_adv_9500075_001",
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "彩羽超開心的，",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "姑丈。",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n因為這也就是說，",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "姑丈",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "今後的人生，",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n無論是健康",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "或疾病，",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "只要還有一口氣，",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "就是彩羽……",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "最棒的玩伴了吧！？",
    "voice": "vo_adv_9500075_002",
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n太好了太好了！",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "太好了～～～！！",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n這對彩羽來說，",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "就像是一場夢♪",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "啊，",
    "voice": "vo_adv_9500075_003",
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "但好煩惱啊。",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "姑丈是小苑的理想對象，",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n如果老跟彩羽玩，",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "跟小苑一起度過的時間",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n就會減少。",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "嗯～～",
    "voice": "vo_adv_9500075_004",
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "傷腦筋啊～",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "不過只要住在同一個屋簷下，",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "就會有很多時間了，",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n這種煩惱也",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "沒有意義吧……",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "該怎麼辦……",
    "voice": "vo_adv_9500075_005",
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "偷瞄",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "偷瞄。",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "或許不需要那個吧……",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "偷瞄",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "偷瞄。",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n姑丈跟",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "小苑的、",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "以「ㄐ」開頭，",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "「ㄏ」結尾的那個……",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "咦，",
    "voice": "vo_adv_9500075_006",
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "什麼，",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "結婚！？！？",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "什──麼嘛，",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "姑丈真性急。",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n就那麼等不及了嗎，",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "這個色狼♪",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "好──！",
    "voice": "vo_adv_9500075_007",
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "等一起打倒那位龍姐姐後，",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n就直接去戶政事務所交",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "「結婚登記申請書」吧♪",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "戰鬥後，",
    "voice": "vo_adv_9500075_008",
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "小苑一定精疲力盡了，",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n按那個樣子，",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "戶政事務所應該也會拒絕受理，",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "所以就讓彩羽像這樣",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "代替她吧。",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "嘿咻嘿咻……",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "你好～",
    "voice": "vo_adv_9500075_009",
    "unit_id": 132741
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "我們是恩愛的新婚夫妻──♡",
    "voice": null,
    "unit_id": 132741
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n我們會一起獲得幸福的，",
    "voice": null,
    "unit_id": 132741
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "請受理這份",
    "voice": null,
    "unit_id": 132741
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "「結婚登記申請書」♡",
    "voice": null,
    "unit_id": 132741
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n",
    "voice": null,
    "unit_id": 132741
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "來",
    "voice": null,
    "unit_id": 132741
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "來來，姑丈也用",
    "voice": null,
    "unit_id": 132741
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "嚴肅的表情",
    "voice": null,
    "unit_id": 132741
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "說「我會讓她幸福的」。",
    "voice": null,
    "unit_id": 132741
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "嗯嗯，",
    "voice": "vo_adv_9500075_010",
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "準備也很完美♪",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "好──",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "既然這麼決定了，",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "最強的彩羽",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n就要趕緊打倒壞人，",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "讓大家幸福！",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "好了，",
    "voice": "vo_adv_9500075_011",
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "我們走，姑丈！",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n快點快點♪",
    "voice": null,
    "unit_id": 132441
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n時間是不等人的──！",
    "voice": null,
    "unit_id": 132441
  }
]
