    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "再來就是……",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "如果送那個女生以她為形象的玩偶，",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n心意也能傳達給對方，",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "應該會更棒。",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "不過像茜里這年紀的女生，",
    "voice": "vo_adv_1240004_022",
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "有點正值青春期……",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n所以送再成熟一點的禮物，",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "對方也許會更開心。",
    "voice": null,
    "unit_id": 100632
  },
  {
