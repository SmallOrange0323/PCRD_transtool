    "voice": "vo_adv_1240004_023",
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "小小的……",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "美妝產品？",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "化、",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "化妝品之類的……",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "再來像是",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "飾品那類的也不錯。",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "啊，",
    "voice": "vo_adv_1240004_024",
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "那個……",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "那、",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "那種東西茜里也",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "沒怎麼試過──",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "不、",
    "voice": "vo_adv_1240004_025",
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "不對──",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "哥哥，",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "你問得很好～！",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n美妝產品有很多種類，",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n所以男生特別會不知道該怎麼挑對吧？",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "呵呵，",
    "voice": "vo_adv_1240004_026",
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "是啊，",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里也這麼覺得。",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "每個名字看起來都像是會出現在姊姊在看的動畫裡……",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "上面印著一堆難懂的英文，",
    "voice": "vo_adv_1240004_027",
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n茜里偶爾也會被搞得暈頭轉向的。",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "──呵呵。",
    "voice": "vo_adv_1240004_028",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "……咦？",
    "voice": "vo_adv_1240004_029",
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "店、",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "店員小姐？",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n請問，",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "是說了什麼奇怪的話嗎……？",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "不，",
    "voice": "vo_adv_1240004_030",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "沒有。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "只是我有時候用一用，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "也的確會這麼想……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "\\n不好意思笑出聲了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "嘿、",
    "voice": "vo_adv_1240004_031",
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "嘿嘿。",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "是吧。",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "啊，",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "對了……",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "像這種時候去拜託店員小姐，",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n問她推薦什麼也不錯！",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里覺得傷腦筋的時候也會那麼做。",
    "voice": "vo_adv_1240004_032",
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "……店員小姐，",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "能請妳推薦一下嗎？",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "嗯～",
    "voice": "vo_adv_1240004_033",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "我想想。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "\\n既不會太貴重也不會太隨便，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "然後還要很實用的東西……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "\\n那你們覺得香膏怎麼樣？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "哇啊，",
    "voice": "vo_adv_1240004_034",
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "包裝得好時尚，真棒！",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "……話說回來，",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "香膏是什麼東西啊？",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n是像……",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "會有香香味道的橡皮擦嗎？",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "我想想，",
    "voice": "vo_adv_1240004_035",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "所謂的香膏就是……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "\\n像軟膏一樣塗抹來使用的香水。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "它味道比香水還持久，",
    "voice": "vo_adv_1240004_036",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "香氣也很柔和。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "\\n它也不會從容器裡灑出來，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "所以最近還挺受歡迎的。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "哇哇，",
    "voice": "vo_adv_1240004_037",
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "感覺好成熟……",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "啊，",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "沒有，",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里不怎麼用這種東西，",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "但打算改天來試試看……",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "咦、",
    "voice": "vo_adv_1240004_038",
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "如果是茜里的話嗎……？",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n茜里是覺得",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "這個香膏也很成熟很棒沒錯啦。",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "但",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "如果是茜里的話──",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "……擺在店裡桌子上的",
    "voice": "vo_adv_1240004_039",
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "那條項鍊。",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n我從進到這間店開始，就一直很在意它……",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "不、",
    "voice": "vo_adv_1240004_040",
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "不過……",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "價格吊牌上寫著我幾乎沒見過的價碼，",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n滿滿都是數字！　",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "如果要那個的話，",
    "voice": "vo_adv_1240004_041",
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n茜里",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "一定會被當成任性的女生──",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "……難道是",
    "voice": "vo_adv_1240004_042",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "那條項鍊嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "\\n呵呵，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "妳從剛才開始感覺就一直對它很好奇。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "咦？",
    "voice": "vo_adv_1240004_043",
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "啊……",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "對不起，",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里的眼睛",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "忍不住會去看它……！",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "……嗯。",
    "voice": "vo_adv_1240004_044",
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n它就像茜里的薩克斯風一樣，",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "有著非常漂亮的金色……",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "不、",
    "voice": "vo_adv_1240004_045",
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "不過，",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "那個……",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n它的價格有點……",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "沒關係！",
    "voice": "vo_adv_1240004_046",
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "只要是哥哥送的，",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n不管是什麼禮物，茜里都會覺得很開心的♪",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "而、",
    "voice": "vo_adv_1240004_047",
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "而且",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "像這種成熟的禮物，",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n感覺對茜里還有點早……",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "──那個，",
    "voice": "vo_adv_1240004_048",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "不好意思。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "\\n雖然說它可能",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "沒辦法打折，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "\\n但如果不介意的話，",
    "voice": null,
