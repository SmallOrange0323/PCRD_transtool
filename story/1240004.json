[
  {
    "type": "background",
    "bg_id": "500036"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}的照顧有所成效，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n茜里很快地恢復健康，並一邊眺望著蘭德索爾的雪景，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n一邊進行著第二次的獎勵約會。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "哇啊，",
    "voice": "vo_adv_1240004_000",
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "好冷喔～",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "哥哥",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "，",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "來嘛來嘛，",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n請再跟茜里貼緊一點♪",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "你今天一整天",
    "voice": "vo_adv_1240004_001",
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "都要陪茜里約會對吧？",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n這樣的話要是不讓身體暖一點，",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "哥哥也會感冒的。",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "嘿嘿，",
    "voice": "vo_adv_1240004_002",
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "感覺好久沒有像這樣，",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n跟哥哥悠哉度日了。",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "明明我們應該都一直待在一起才對，",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "真是奇妙。",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "沒錯，",
    "voice": "vo_adv_1240004_003",
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "忙到茜里",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "都以為自己要壞掉了……",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n而且實際上身體也撐不住了……",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "……不過回過頭來看，",
    "voice": "vo_adv_1240004_004",
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "今年冬天成功挑戰了很多事情，",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n感覺是段非常棒的時光。",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "去挑戰第一次做的事情，",
    "voice": "vo_adv_1240004_005",
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "雖然辛苦但也讓人很興奮，",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n越是努力",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "也越令人覺得更靠近成熟大人了──",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里想成為的那種世界第一可愛女孩，",
    "voice": "vo_adv_1240004_006",
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n就是需要那種",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "成熟大人的魅力♪",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "所以不管是明年，",
    "voice": "vo_adv_1240004_007",
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "還是再下一年的聖誕節……",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n茜里",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "都要努力成為，",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "世界第一可愛的女孩子♪",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "咦？",
    "voice": "vo_adv_1240004_008",
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "你要送什麼禮物給茜里嗎？",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "哇啊，",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "哥哥你真是",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "慷慨！",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "嘿嘿，",
    "voice": "vo_adv_1240004_009",
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "要什麼好呢……",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "既然是哥哥要送的禮物，",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "就挑特別的禮物好了。",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "今年都顧著在想送人禮物的事情，",
    "voice": "vo_adv_1240004_010",
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n所以",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里沒有特別去想自己要什麼東西。",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "唔嗯，",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "好難抉擇喔……",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "啊。",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "沒有，",
    "voice": "vo_adv_1240004_011",
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "我並沒有想要它。",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n只是覺得莫名在意這條項鍊……",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "非常亮麗的金色……",
    "voice": "vo_adv_1240004_012",
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n就像是有經常保養的管樂器一樣，",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "閃閃發亮──",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "閃、",
    "voice": "vo_adv_1240004_013",
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "閃閃發亮到，",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "感覺刺眼的程度。",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "應該說，",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "它好像真的在發光……？",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n啊嗚，",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "什、",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "什麼都看不見了～！",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "background",
    "bg_id": "510330"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "雜貨店正在進行聖誕特賣。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}找茜里商量了某件事，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n而來到這裡隨意逛街。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "哥哥，",
    "voice": "vo_adv_1240004_014",
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "這間雜貨店你覺得如何呀？",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n這裡有很多可愛的小東西喔～！",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "哎呀，",
    "voice": "vo_adv_1240004_015",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "歡迎光臨。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "請慢慢看啊～",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "好的～",
    "voice": "vo_adv_1240004_016",
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "打擾了♪",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "話說回來，",
    "voice": "vo_adv_1240004_017",
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "哥哥竟然會找茜里幫忙……",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "該不會，",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "你是第一次這麼做吧？",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "這就包在茜里身上♪",
    "voice": "vo_adv_1240004_018",
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "再怎麼說",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里可是世界第一可愛的女孩子……",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "以這個為",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "目標在努力的。",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "居然會找茜里商量挑選禮物的事……",
    "voice": "vo_adv_1240004_019",
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "嘿嘿，",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "不愧是哥哥，眼光真好呢！",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "平常都是哥哥當茜里的教練……",
    "voice": "vo_adv_1240004_020",
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "但今天就由茜里",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "來當哥哥的教練吧♪",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "哇，",
    "voice": "vo_adv_1240004_021",
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "好可愛～",
    "voice": null,
    "unit_id": 100632
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里也覺得不錯唷♪",
