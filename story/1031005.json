  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "唔唔唔……",
    "voice": "vo_adv_1031005_001",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n喂，忍！差不多該回家了！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "等一下，爸爸。",
    "voice": "vo_adv_1031005_002",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我和{0}還沒聊完。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "妳說還沒聊完……",
    "voice": "vo_adv_1031005_003",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n從剛剛就一直聊個不停不是嘛！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "咕唔唔唔…………",
    "voice": "vo_adv_1031005_004",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n最近忍和小伙子實在太要好了……",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n該、該不會……忍對小伙子……！？",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "不、不會的，不可能有那種事！",
    "voice": "vo_adv_1031005_005",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n忍還是個離不開爸爸的孩子嘛。",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n真令人煩惱呀。嗯嗯……",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "然後啊……",
    "voice": "vo_adv_1031005_006",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "呀！",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "什麼！！！？？？",
    "voice": "vo_adv_1031005_007",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "抱、抱歉，{0}！",
    "voice": "vo_adv_1031005_008",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n我稍微絆到腳了……",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "忍和小伙子、忍和小伙子、忍和小伙子……！！！",
    "voice": "vo_adv_1031005_009",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "嘎喔喔喔喔────！",
    "voice": "vo_adv_1031005_010",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "爸、爸爸！？",
    "voice": "vo_adv_1031005_011",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "呀──！房子被魔法給摧毀了！",
    "voice": "vo_adv_1031005_012",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "快、快逃──！",
    "voice": "vo_adv_1031005_013",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "住、",
    "voice": "vo_adv_1031005_014",
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "住手！爸爸！",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n不要在城鎮裡使出魔法！！",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "嘎喔喔喔喔────！",
    "voice": "vo_adv_1031005_015",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "父、父親失控了！",
    "voice": "vo_adv_1031005_016",
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n他好像失去了自我……怎、怎麼會變成這樣？",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "王宮騎士A",
    "words": "在大鬧的魔物就是那個骷髏頭嗎！？",
    "voice": "vo_adv_1031005_017",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士B",
    "words": "目標是擊退骷髏頭！全軍突擊────！！！",
    "voice": "vo_adv_1031005_018",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "嘎喔喔喔喔────！",
    "voice": "vo_adv_1031005_019",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "王宮騎士A",
    "words": "哇――――――！！！",
    "voice": "vo_adv_1031005_020",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "連王宮騎士都被打倒了！？",
    "voice": "vo_adv_1031005_021",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n這樣下去蘭德索爾會毀滅的！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "那是惡魔使者……古戰場的火焰……這世界要崩壞了……",
    "voice": "vo_adv_1031005_022",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "怎、怎麼辦……",
    "voice": "vo_adv_1031005_023",
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n父親是傑出的靈媒，魔力強大到非比尋常。",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n根本沒有方法可以阻止失控的父親……",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "只是……為什麼父親會失控到如此地步呢？",
    "voice": "vo_adv_1031005_024",
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n要說父親喜歡的東西，",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n我只能想到女人、女人和女人而已了……",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "……咦？你說我嗎？",
    "voice": "vo_adv_1031005_025",
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n父親的確非常溺愛我……",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "啊！該不會是剛剛我……",
    "voice": "vo_adv_1031005_026",
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那、那個……",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n因為我一把抱、抱住了{0}你……",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "爸爸真是的，竟然因為那種事情而失控……",
    "voice": "vo_adv_1031005_027",
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "可是那樣的話就沒有辦法阻止了……",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "也、也是。",
    "voice": "vo_adv_1031005_028",
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "爸爸！不要再破壞城鎮了！",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我和{0}，",
    "voice": "vo_adv_1031005_029",
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n不是像爸爸你誤會的那種關係！",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我對{0}……那個……該怎麼說……",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "咦！？",
    "voice": "vo_adv_1031005_030",
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n我做不出那種事情的！",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "……要讓我父親看到我討厭你的樣子？",
    "voice": "vo_adv_1031005_031",
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "沒、沒辦法！",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "因為我、我對{0}你……那、那個……",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "呀――――！",
    "voice": "vo_adv_1031005_032",
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "―――――――――――啾―――――――――――",
    "voice": "vo_adv_1031005_033",
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "哇！",
    "voice": "vo_adv_1031005_034",
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "對對對、對不起！",
    "voice": "vo_adv_1031005_035",
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n因、因為我跌倒了，結果碰到{0}的………！",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我、我我我、我！！！？？？",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "什什什什麼────────！",
    "voice": "vo_adv_1031005_036",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "可、可是，這是碰巧的！是個意外！",
    "voice": "vo_adv_1031005_037",
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n而、而且是碰到臉頰！",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n請、請你不要在意！！！",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "小小小小小、小伙子――――――！！！",
    "voice": "vo_adv_1031005_038",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n饒不了你饒不了你饒不了你！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n我絕對饒不了你――――――――！！！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "爸爸你安靜一點────！",
    "voice": "vo_adv_1031005_039",
    "unit_id": 103112
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "嘎喔―――！！！！",
    "voice": "vo_adv_1031005_040",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "太、",
    "voice": "vo_adv_1031005_041",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "太好了！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n那個女孩打倒魔物了！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "這、這樣子，這個城鎮……這個世界就得救了！！！",
    "voice": "vo_adv_1031005_042",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "抱、抱歉，{0}！",
    "voice": "vo_adv_1031005_043",
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n我、我現在幫你把臉頰擦乾淨，不要亂動喔！",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "……欸？我父親不再失控真是太好了？",
    "voice": "vo_adv_1031005_044",
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那一點都不重要！",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n我、我……！",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "該怎麼辦好……！",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "可以向你們問一下話嗎？",
    "voice": "vo_adv_1031005_045",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n我們收到了證詞說這個魔物和你們有關係……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "比起那件事，{0}，",
    "voice": "vo_adv_1031005_046",
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n請、",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "請不要誤會喔！",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "剛、剛剛那個只是個意外而已……",
    "voice": null,
    "unit_id": 103112
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "結果，{0}和心慌意亂的忍一起，\\n受到了騎士團漫長的例行盤問……",
    "voice": null,
    "unit_id": null
  }
]
