  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}一行人，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n到了被不明魔物破壞的吉歐‧提格尼亞遊樂園，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n也就是大夢想樂園，來幫忙收拾瓦礫堆。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "皇家裝備，",
    "voice": "vo_adv_2204001_000",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "三分飽力量！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嘿咻──☆",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "啊哈哈♪",
    "voice": "vo_adv_2204001_001",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n我也不能輸呢，",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "嘿唷──！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "那麼大的碎片，",
    "voice": "vo_adv_2204001_002",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "輕輕鬆鬆就……",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "貪吃佩可小姐跟克蘿茜小姐，",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "真的是怪力無雙呢。",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "好有力氣。",
    "voice": "vo_adv_2204001_003",
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好了好了，我說你們，",
    "voice": "vo_adv_2204001_004",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "稍微過去一點──",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n那邊的磚塊，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我也要用飛行魔法搬走。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "啊。",
    "voice": "vo_adv_2204001_005",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "真的非常抱歉，",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "凱留小姐……",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "細小的碎片跟灰塵，",
    "voice": "vo_adv_2204001_006",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下請風之精靈收集。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n……吉歐‧提格尼亞的各位精靈，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n真是非常聽話呢。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "不只是貪吃佩可小姐，",
    "voice": "vo_adv_2204001_007",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "可可蘿小姐跟凱留小姐也是，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n還有哥哥也是，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "都很進行得很快呢。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n總覺得你們，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "好像對這種事滿熟練的……？",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是的。",
    "voice": "vo_adv_2204001_008",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n我們時常幫忙",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n收拾壞掉的建築物等類的事。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "雖然最好的情況是不要讓它壞掉啦──",
    "voice": "vo_adv_2204001_009",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嗚……",
    "voice": "vo_adv_2204001_010",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我好慚愧……",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "是啊。",
    "voice": "vo_adv_2204001_011",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n有錯的是，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "來攻擊的人吧……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "不只擊敗惡勢力，",
    "voice": "vo_adv_2204001_012",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "連事後收拾都積極參與，",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "不愧是兄長大人……！",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好了好了，我說你們，",
    "voice": "vo_adv_2204001_013",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不要顧著說話，手要動起來啊──",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這個遊樂園，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "可是大到莫名其妙啊。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "真、",
    "voice": "vo_adv_2204001_014",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "真的非常抱歉，",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "凱留小姐……",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "糰──",
    "voice": "vo_adv_2204001_015",
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "搬得動嗎？",
    "voice": null,
    "unit_id": 126112
  },
  {
    "type": "dialogue",
    "name": "小飯糰",
    "words": "嗶咕！",
    "voice": "vo_adv_2204001_016",
    "unit_id": 9611
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "哦哦～！",
    "voice": "vo_adv_2204001_017",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n小飯糰也",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "搬得有模有樣的呢！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "我也不會輸喔～♪",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在庫露露小姐",
    "voice": "vo_adv_2204001_018",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "回收及修補",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "魔寶石的期間，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n至少想把入口前面的這個廣場",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n盡可能收拾乾淨呢。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "是啊！",
    "voice": "vo_adv_2204001_019",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "雖然沒辦法修理",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "遭到破壞的遊樂設施之類的東西……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "但看到這裡變乾淨的話，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "庫露露一定會很開心吧♪",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好，",
    "voice": "vo_adv_2204001_020",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "一起加油吧♪",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n為了看見庫露露的笑容！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "background",
    "bg_id": "501730"
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "哈嗚啊啊啊～～～～！！",
    "voice": "vo_adv_2204001_021",
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "\\n庫露露要跳進那邊的暖爐了！！",
    "voice": null,
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "\\n琳德、沃爾加諾先生，",
    "voice": null,
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "請不要阻止我～！！",
    "voice": null,
    "unit_id": 130912
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "真是的！",
    "voice": "vo_adv_2204001_022",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n請不要說這種蠢話，庫露露小姐！",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "沃爾先生，",
    "voice": "vo_adv_2204001_023",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "請你要確實壓制好她喔。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "沃爾加諾",
    "words": "那當然，",
    "voice": "vo_adv_2204001_024",
    "unit_id": 193511
  },
  {
    "type": "dialogue",
    "name": "沃爾加諾",
    "words": "不管庫露露小妹再怎麼亂來，",
    "voice": null,
    "unit_id": 193511
  },
  {
    "type": "dialogue",
    "name": "沃爾加諾",
    "words": "\\n我的力氣也不會輸給她。",
    "voice": null,
    "unit_id": 193511
  },
  {
    "type": "dialogue",
    "name": "沃爾加諾",
    "words": "\\n不過，我到底要維持這樣多久啊──",
    "voice": null,
    "unit_id": 193511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "琳德你們聽我說，",
    "voice": "vo_adv_2204001_025",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "我們回來囉～！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "遊樂園的收拾，",
    "voice": "vo_adv_2204001_026",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "已經告一段落囉♪",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嘿嘿，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我肚子已經餓扁了～☆",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "啊，",
    "voice": "vo_adv_2204001_027",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "各、",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "各位，歡迎回來……",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "……？",
    "voice": "vo_adv_2204001_028",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n各位，",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "正在忙嗎……？",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "與其說是在忙……",
    "voice": "vo_adv_2204001_029",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "不如說是",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "在阻止吧。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "庫露露小姐她，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "正打算讓自己變成一隻烤全兔。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "可璃亞、莉莉",
    "words": "咦咦！？",
    "voice": "vo_adv_2204001_030",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "嗚嗚嗚嗚嗚！",
