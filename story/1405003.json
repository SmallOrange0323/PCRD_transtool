    "voice": "vo_adv_1405003_007",
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "……烏爾姆。",
    "voice": "vo_adv_1405003_008",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n我已經沒事了，",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "可以把手鬆開一點喔。",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "still",
    "still_id": "140500301"
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "老姊……",
    "voice": "vo_adv_1405003_009",
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "老姊……",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "姊姊……！",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n要是妳又變得冰冷，",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "就這樣消失不見怎麼辦……！",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n妳還活著，",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "真是太好了……！",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "即使長這麼大了，",
    "voice": "vo_adv_1405003_010",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "妳還是那個愛哭鬼烏爾姆呢。",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "我",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "確實沒什麼力量，",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "但也不代表我很弱喔？",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "……嘛，",
    "voice": "vo_adv_1405003_011",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "雖然只是因為騎士先生幫我強化，",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n我才來得及恢復自己就是了……",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……對不起。",
    "voice": "vo_adv_1405003_012",
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n我差點犯下",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "無法挽回的錯誤。",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "妳有好好反省了吧？",
    "voice": "vo_adv_1405003_013",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "那麼──",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n下一次就不要再獨自煩惱、",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "不要再獨自下定論，",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "也不要再獨自行動了喔。",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "就像烏爾姆珍惜我們一樣，",
    "voice": "vo_adv_1405003_014",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n我們也",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "很珍惜烏爾姆啊。",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "──如果妳受傷了，",
    "voice": "vo_adv_1405003_015",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "我也會一起承擔痛苦。",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "所以，",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "不要再獨自戰鬥了。",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n我們",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "可是雙胞胎姊妹，對吧？",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "姊姊……",
    "voice": "vo_adv_1405003_016",
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "好！",
    "voice": "vo_adv_1405003_017",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "我們上吧！",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "「我們上」……？",
