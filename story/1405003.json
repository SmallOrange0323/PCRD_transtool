    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "這個世界的嘛。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……所以，",
    "voice": "vo_adv_1405003_032",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "如果騎士先生願意的話……",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n一直在這裡生活，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "應該也不錯吧？",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "background",
    "bg_id": "501710"
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……怎麼了？",
    "voice": "vo_adv_1405003_033",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n突然看向我這邊。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "background",
    "bg_id": "501720"
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我是烏爾姆。",
    "voice": "vo_adv_1405003_034",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n是琳德的妹妹。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我就直說了。",
    "voice": "vo_adv_1405003_035",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "騎士先生、",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "貪吃佩可小姐──",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "各位",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "究竟是為了什麼，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n才來到「吉歐‧提格尼亞」？",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "still",
    "still_id": "220410701"
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "意思是",
    "voice": "vo_adv_1405003_036",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我們得負責照顧騎士先生囉？",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……唉。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "事情為何會變成這樣。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "background",
    "bg_id": "501710"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "啊──",
    "voice": "vo_adv_1405003_037",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我當時的態度很冷淡嗎？",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n嘛，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "畢竟你超～可疑的啊。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "結果實際上就是個很好搞定的人，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "真是令人失望。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……剛才的話",
    "voice": "vo_adv_1405003_038",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "沒有別的意思喔。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "如果騎士先生不再是「客人」，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n我想萊拉耶爾殿下、老姊，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "還有克蘿小姐都會很開心吧。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我也覺得",
    "voice": "vo_adv_1405003_039",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "多個一起偷懶的夥伴不是什麼壞事呢，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n而且還能交換各種情報嘛。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……",
    "voice": "vo_adv_1405003_040",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "這樣啊。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "如果你決定要來這裡的話，請第一時間告訴我。",
    "voice": "vo_adv_1405003_041",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n這次就讓我自告奮勇，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "負責照顧騎士先生吧。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n應該沒有問題吧，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "「主人」？",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "吉歐‧提格尼亞的居民１",
    "words": "喂！",
    "voice": "vo_adv_1405003_042",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "吉歐‧提格尼亞的居民１",
    "words": "\\n聽說那邊出現了群聚的魔物──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "吉歐‧提格尼亞的居民２",
    "words": "聽說萊拉耶爾殿下正在阻擋魔物入侵──",
    "voice": "vo_adv_1405003_043",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "魔物……",
    "voice": "vo_adv_1405003_044",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "為什麼！？",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我去打聽一下，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "騎士先生就在這等──",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "啊！",
    "voice": "vo_adv_1405003_045",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "找到了！！",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n烏爾姆！",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "騎士先生！",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "不好了！",
    "voice": "vo_adv_1405003_046",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n西門遭到魔物襲擊！",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n現在萊拉耶爾殿下和沃爾加諾先生正在應對！",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我知道了，",
    "voice": "vo_adv_1405003_047",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我馬上過去！",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "等等！",
    "voice": "vo_adv_1405003_048",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n我有萊拉耶爾殿下的話要轉達！",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "聽說，其實直到剛剛，",
    "voice": "vo_adv_1405003_049",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "[rub:那邊]現實[/rub]世界都在對這邊",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n發動大規模攻擊。",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "多虧回到「顛倒之塔」的克蘿茜小姐，",
    "voice": "vo_adv_1405003_050",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "成功抵禦了襲擊，",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n但這也導致",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "連結世界的位置發生偏移。",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "結果，這邊的門偏偏",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "和魔物的棲息地連結在一起了。",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "不只西門，",
    "voice": "vo_adv_1405003_051",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "東門也傳來",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "目擊魔物的消息。",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "這樣的話，",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "萊拉耶爾殿下她們不在的東側恐怕就危險了。",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "因為克蘿茜小姐正在進行重建作業，",
    "voice": "vo_adv_1405003_052",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n在重建完成前，",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "殿下希望烏爾姆能幫忙守住那邊！",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "萊拉耶爾殿下……？",
    "voice": "vo_adv_1405003_053",
    "unit_id": 127812
  },
  {
    "type": "background",
    "bg_id": "501720"
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "烏爾姆……",
    "voice": "vo_adv_1405003_054",
    "unit_id": 126511
  },
  {
    "type": "background",
    "bg_id": "501710"
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "萊拉耶爾殿下……",
    "voice": "vo_adv_1405003_055",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "依賴了我。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我想要回應",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "她的信任──",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "以那位大人忠誠的家臣身分。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我這次一定要……！　",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……東門的守備就交給我。",
    "voice": "vo_adv_1405003_056",
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "老姊和騎士先生就在這裡──",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "好！",
    "voice": "vo_adv_1405003_057",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n那我們就",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "同心協力一起上吧！",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……什麼？",
    "voice": "vo_adv_1405003_058",
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "妳說的「一起上」，",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "是要做什麼……？",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "still",
    "still_id": "140500303"
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "什麼做什麼？",
    "voice": "vo_adv_1405003_059",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "妳不也說了嗎？",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "東門的守備啊！",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n這次要一起",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "守護我們的世界喔！",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "就像烏爾姆珍惜我們一樣，",
    "voice": "vo_adv_1405003_060",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n我們也",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "很珍惜烏爾姆啊。",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "──如果妳受傷了，",
    "voice": "vo_adv_1405003_061",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "我也會一起承擔痛苦。",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n所以，",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "不要再獨自戰鬥了。",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n我們",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "可是雙胞胎姊妹，對吧？",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "still",
    "still_id": "140500304"
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……",
    "voice": "vo_adv_1405003_062",
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "這樣啊。",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "background",
    "bg_id": "501710"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "可以是可以，",
    "voice": "vo_adv_1405003_063",
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "但老姊要待在最後面喔。",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n無論如何都千萬別跑到前面去喔？",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "……！！",
    "voice": "vo_adv_1405003_064",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "那後方支援就交給我吧！",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n而且，",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "烏爾姆說不定又會掉下來，",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n我會隨時待命♪",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "不愧是姊姊大人～",
    "voice": "vo_adv_1405003_065",
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "真可靠啊。",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "還有──",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "騎士先生也是。",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……拜託了，",
    "voice": "vo_adv_1405003_066",
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "請把力量借給我。",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "為了守護……",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "重要的人們。",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "為什麼",
    "voice": "vo_adv_1405003_067",
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "只有我擁有這股力量呢？",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我一直對此感到恐懼。",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "不過──",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "現在不一樣了。",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我能守護重要的人。",
    "voice": "vo_adv_1405003_068",
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "現在，我覺得這是最棒的禮物。",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n所以，總有一天──",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我也想對畫出我的[rub:那傢伙]帆稀[/rub]說……",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "或許我一開始只是個「塗鴉」，",
    "voice": "vo_adv_1405003_069",
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "但就算是這樣的我，",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "也能感受得到。",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我能感受到因思念某個人而產生的痛楚、",
    "voice": "vo_adv_1405003_070",
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "苦楚，",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n還有……",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "令人融化般的幸福。",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "這從一開始，",
    "voice": "vo_adv_1405003_071",
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "就是我的故事。",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n所以今後，",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我也會繼續創造自己所描繪的未來。",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "──和老姊一起，",
    "voice": "vo_adv_1405003_072",
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n跳脫",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "妳想像的框架。",
    "voice": null,
    "unit_id": 140511
  }
