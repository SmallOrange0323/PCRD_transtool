    "words": "像學生時期一樣聚集到某個人的家，",
    "voice": "vo_adv_1245004_043",
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n大家閒話家常地度過吧，",
    "voice": null,
    "unit_id": 106731
  },
  {
