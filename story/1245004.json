[
  {
    "type": "background",
    "bg_id": "501470"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "帆稀與{0}結束了新年參拜。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n兩人之後在新年的鬧區中，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n漫無目的到處閒晃。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "雖然",
    "voice": "vo_adv_1245004_000",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "這是理所當然的，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n但果然因為是新年，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "大部分的店家都關店了呢～",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "不過",
    "voice": "vo_adv_1245004_001",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "也多虧如此，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "路上才沒什麼行人……",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n可以相當悠閒地度過呢♪",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "畢竟新年一年只有一次呀，",
    "voice": "vo_adv_1245004_002",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "讓我們悠閒地度過吧☆",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "啊，",
    "voice": "vo_adv_1245004_003",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "你在擔心我啊？",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "嗯，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我的確很忙。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "目前正在構思各種計畫……",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n也希望讓嘉夜和祈梨繼續成長。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "而且，",
    "voice": "vo_adv_1245004_004",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "還有漫畫必須要畫……",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我有很多",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "想去做，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "以及必須做的事。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "不過，",
    "voice": "vo_adv_1245004_005",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "因為定下了某個約定……",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "所以，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我已經決定了",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "至少在新年",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "要好好放鬆。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "呵呵，",
    "voice": "vo_adv_1245004_006",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "這個呀……",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "是祕密☆",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n隨你想像囉♪",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "……咦？",
    "voice": "vo_adv_1245004_007",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "你那道光……",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "原來如此，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "是愛梅斯做的對吧？",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "大新年的，",
    "voice": "vo_adv_1245004_008",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "她就想讓我們做什麼夢呢？",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n某種程度上，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我是已經能猜想到了。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "那麼，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "先暫時晚安。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我們在夢裡再會吧……♪",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "background",
    "bg_id": "510290"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "新年的椿丘。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n當{0}在去新年參拜前，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在路上散步順道隨便逛逛商店街時……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "……咦？",
    "voice": "vo_adv_1245004_009",
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "真奇怪～",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n每家店都關起來了。",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "人家難得出來買食材的說……",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "……啊，",
    "voice": "vo_adv_1245004_010",
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "才想說有個人在，",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "原來是你啊。",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n沒想到會在這種地方見面，真巧呢☆",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "新年快樂……？",
    "voice": "vo_adv_1245004_011",
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n……該不會",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "今天是新年？",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "原來如此，",
    "voice": "vo_adv_1245004_012",
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "難怪每家店都關了。",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n我的時間感徹底失常了呢。",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "……我本來想去參加",
    "voice": "vo_adv_1245004_013",
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "除夕舉辦的同人誌販售會呢。",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "真沒辦法，",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "只能透過網路來買了。",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "是啊，",
    "voice": "vo_adv_1245004_014",
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我這一週左右",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "一直在進行駭客。",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n主要是",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "為了調查與阿斯特朗相關的情報♪",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我首先",
    "voice": "vo_adv_1245004_015",
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "試著調查了一位",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n也有參與開發mimi，",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "名叫宵濱的人。",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "公主騎士的mimi，",
    "voice": "vo_adv_1245004_016",
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "是七冠準備的",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "特別東西……",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "因此我認為",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "只要對其專用mimi有所了解，",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n或許能成為",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "有效對抗七冠的線索。",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "雖這麼說，",
    "voice": "vo_adv_1245004_017",
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "但如果直接調查七冠中的某人，",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "怎麼想應該都會很花時間……",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n因此，",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我才先著手調查了",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "宵濱身邊的事情……",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "但我似乎猜錯了。",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "至少我目前",
    "voice": "vo_adv_1245004_018",
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "沒有找到任何",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n宵濱",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "與公主騎士專用mimi有關的線索。",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "雖然，",
    "voice": "vo_adv_1245004_019",
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我也認為她要跟那種東西扯上關係的可能性很低，",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n所以心裡也只有",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "「果然是這樣」的想法呢。",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "在進行各種調查時，",
    "voice": "vo_adv_1245004_020",
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我反而對她本人產生興趣了♪",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n希望有機會",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "能和她在阿斯特朗中一起玩☆",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "還有……",
    "voice": "vo_adv_1245004_021",
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我姑且問一下，",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "你在用的mimi，",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "能暫時",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "借我一段時間嗎？",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n如果可以借我一個月左右，",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
