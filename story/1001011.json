    "type": "dialogue",
    "name": "日和",
    "words": "竟然能碰到學長，",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n跑來公園",
    "voice": null,
    "unit_id": 100131
  },
