    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "只剩我孤單一人……",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……原來是學長呢。",
    "voice": "vo_adv_1001011_056",
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "那時候你幫助了正在哭泣的我。",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "沒辦法想起來也是正常的事呢。",
    "voice": "vo_adv_1001011_057",
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "因為學長，",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "在那之後也陸續幫過很多人吧？",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "still",
    "still_id": "100101101"
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……謝謝你，",
    "voice": "vo_adv_1001011_058",
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "學長。",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n還有，",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "雖然有些遲了，",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這隻小貓，",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "要還給學長呢。",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "因為這隻小貓一直陪伴在我身旁。",
    "voice": "vo_adv_1001011_059",
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n因為學長",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "幫助了我，",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "所以我才能變成現在的我。",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "對學長來說，",
    "voice": "vo_adv_1001011_060",
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我是眾多幫助過的其中一個。",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n雖然如此，",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "但對那時候的我來說，",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "你就是唯一的英雄。",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……那時候謝謝你。",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "大哥哥。",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "still",
    "still_id": "100101102"
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "可以嗎……？　",
    "voice": "vo_adv_1001011_061",
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "那麼",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我今後也會",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "一直、",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "一直",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "一直",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "一～直",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "好好珍惜的！",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "still",
    "still_id": "100101102"
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "真的嗎？　",
    "voice": "vo_adv_1001011_062",
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "謝謝！　",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "就像那時候一樣，",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n如果我感到寂寞或痛苦時，",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "就會讓這孩子來幫我！",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……那個學長。",
    "voice": "vo_adv_1001011_063",
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我啊，",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "因為很憧憬那時候的學長，",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n所以想跟學長一樣，",
