  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……那位媽媽能夠跟孩子團聚，",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "真是太好了―",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……",
    "voice": "vo_adv_1001011_054",
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "那個，",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "學長。",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "剛剛回憶起",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n收到這個小貓鑰匙圈",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "的事呢。",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "與那孩子同樣年紀的時候，",
    "voice": "vo_adv_1001011_055",
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我和媽媽走散，",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "那時我覺得這個世上",
