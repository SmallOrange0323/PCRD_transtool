  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "學長！　",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我們一起去幫她吧！",
    "voice": null,
    "unit_id": 100131
  },
  {
    "type": "dialogue",
