  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "沒想到小時候你幫她的行動，",
    "voice": "vo_adv_1001011_069",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n竟對日和產生那麼重大的影響，真讓人吃驚呢。",
