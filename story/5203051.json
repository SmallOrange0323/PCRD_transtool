[
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "那一天──",
    "voice": "vo_adv_5203051_000",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "光芒燒盡了整個世界。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500135"
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "所有的一切，",
    "voice": "vo_adv_5203051_001",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "都燒成了一片火紅，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "化為灰燼。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n家人、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "朋友……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "甚至是那些重要的人們。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "在那座城鎮裡，",
    "voice": "vo_adv_5203051_002",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "只有一個少女。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "存活了下來。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "在燒熔成赤紅的世界裡、",
    "voice": "vo_adv_5203051_003",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "被灰燼掩埋的此處──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n唯有一樣事物，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "未被燃燒殆盡。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n那就是在胸口焦黑的復仇之心。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "在火星飛舞的平原上、",
    "voice": "vo_adv_5203051_004",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n在染上紅蓮色彩的陰鬱天空下，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n她以殘破的身體和生命為燃料",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "奮力向前奔馳。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "已經沒有任何人了──",
    "voice": "vo_adv_5203051_005",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "孤身一人少女。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n她成為了唯有一人的旅團中──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n唯一的士兵。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "下回，",
    "voice": "vo_adv_5203051_006",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "「Bocchi Battle Brigade",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n　～邊緣人的最後一天～」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "──沒錯。",
    "voice": "vo_adv_5203051_007",
    "unit_id": 53013
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n果然，",
    "voice": null,
    "unit_id": 53013
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我就是「邊緣人」──",
    "voice": null,
    "unit_id": 53013
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n因為，",
    "voice": null,
    "unit_id": 53013
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我的朋友全部都死了啊。",
    "voice": null,
    "unit_id": 53013
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "──向害我成為孤身一人的所有敵人，",
    "voice": "vo_adv_5203051_008",
    "unit_id": 53013
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "展開復仇──",
    "voice": null,
    "unit_id": 53013
  }
]
