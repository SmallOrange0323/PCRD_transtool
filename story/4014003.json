    "words": "\\n不死生物",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "還有幽靈……？",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "\\n",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "蘭德索爾",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "是個怎樣的地方啊……？",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "雖然",
    "voice": "vo_adv_4014003_061",
    "unit_id": 180411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "看到頭突然掉下來，",
    "voice": null,
    "unit_id": 180411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "還是會嚇一跳的……",
    "voice": null,
    "unit_id": 180411
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "稍微。",
    "voice": "vo_adv_4014003_062",
    "unit_id": 126111
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n嚇一跳。",
    "voice": null,
    "unit_id": 126111
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126111
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "不過。",
    "voice": null,
    "unit_id": 126111
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "是朋友。",
    "voice": null,
    "unit_id": 126111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "大家……",
    "voice": "vo_adv_4014003_063",
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "比起這個，",
    "voice": "vo_adv_4014003_064",
    "unit_id": 180411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "櫻……",
    "voice": null,
    "unit_id": 180411
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "是、",
    "voice": "vo_adv_4014003_065",
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "是的……",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "怎麼了……",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "吞口水。",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "一起吃我們打倒了的品牌魔物牛吧♪",
    "voice": "vo_adv_4014003_066",
    "unit_id": 180411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我的肚子",
    "voice": null,
    "unit_id": 180411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "已經餓到",
    "voice": null,
    "unit_id": 180411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "極限了♪",
    "voice": null,
    "unit_id": 180411
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "吃",
    "voice": "vo_adv_4014003_067",
    "unit_id": 126111
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n燒烤。",
    "voice": null,
    "unit_id": 126111
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n很多。",
    "voice": null,
    "unit_id": 126111
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好──！",
    "voice": "vo_adv_4014003_068",
    "unit_id": 180411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n那就",
    "voice": null,
    "unit_id": 180411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "趕快切一切處理好，",
    "voice": null,
    "unit_id": 180411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n大家一起吃燒烤吧♪",
    "voice": null,
    "unit_id": 180411
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "咦，",
    "voice": "vo_adv_4014003_069",
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "也就是說，",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "\\n比起我是喪屍這件事，",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "\\n品牌魔物牛那邊才是更重要的消息？",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "……………………",
    "voice": "vo_adv_4014003_070",
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "……啊、",
    "voice": "vo_adv_4014003_071",
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "啊哈哈♪",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "明明在佐賀也要小心不要被人發現是喪屍，",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "\\n在王都竟然有接受喪屍的人，",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "\\n我真的沒想到。",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "而且，",
    "voice": "vo_adv_4014003_072",
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "在蘭德索爾的話",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "喪屍也不特別對吧？",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "\\n",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "明明我幹勁十足來到蘭德索爾，",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "這會不會",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "太厲害了？",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "\\n啊哈哈！",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "總覺得，",
    "voice": "vo_adv_4014003_073",
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "有像大家這樣的人在的話，",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "\\n我就能努力進行",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "在王都的個人活動了！",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "\\n啊，",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "當然之後也要",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "小心不要被發現我是喪屍就是了。",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "謝謝你！",
    "voice": "vo_adv_4014003_074",
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "\\n",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "既然在蘭德索爾失去了我的特色，",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "\\n那就再一次作為「一無所有的我」挑戰吧，",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "說不定這是個好機會。",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "在蘭德索爾的偶像活動，",
    "voice": "vo_adv_4014003_075",
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "\\n",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "我",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "會努力的！",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "我是櫻。",
    "voice": "vo_adv_4014003_076",
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "總算是打倒了魔物，",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "太好了太好了♪",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "\\n雖然被人發現了我是喪屍，",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "但因為都是些不拘小節的人，",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "結果沒問題！",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "\\n偶像的個人活動也要努力囉──",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "喔──！",
    "voice": null,
    "unit_id": 136111
  },
  {
    "type": "dialogue",
    "name": "櫻",
    "words": "待續！",
    "voice": null,
    "unit_id": 136111
  }
]
