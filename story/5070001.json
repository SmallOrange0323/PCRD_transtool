  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "暑假第一天。{0}",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在惠理子跟靜流的邀請之下來到海邊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "說到夏天就會想到大海。",
    "voice": "vo_adv_5070001_000",
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "說到大海就會想到海水浴。",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "首先是由我呈上",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "為您想好的暑假計畫。",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "嗚嗚……",
    "voice": "vo_adv_5070001_001",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "明明我想搶先讓弟弟開心一下的。",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "這是用抽籤公平決定的，所以是沒辦法的事。",
    "voice": "vo_adv_5070001_002",
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "更重要的是，靜流，",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "妳忘了重要的事情囉。",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "對喔！",
    "voice": "vo_adv_5070001_003",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "來，",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "這是給你的禮物。",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "請收下吧♪",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "是暑假的指南，",
    "voice": "vo_adv_5070001_004",
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "更正，",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "是計畫書。",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "為了讓你享受最棒的暑假時光，",
    "voice": "vo_adv_5070001_005",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n我昨天跟惠理子一起製作了這個。",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "從今天開始到暑假結束為止，",
    "voice": "vo_adv_5070001_006",
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我們全都為您規劃好了。",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "您覺得如何呢？",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "真的嗎！？",
    "voice": "vo_adv_5070001_007",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "太好了。",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "這是我跟惠理子一起拼命想出來的。",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "因為您的暑假不容許有任何疏漏……",
    "voice": "vo_adv_5070001_008",
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "好了，",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "這下就能毫無牽掛地",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "進行今天的預定了。",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n首先",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "要在海邊欣賞您的泳技……",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "慢死了！",
    "voice": "vo_adv_5070001_009",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n你這混蛋是要讓我等多久！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "非、",
    "voice": "vo_adv_5070001_010",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "非常抱歉！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "是幻聽嗎……",
    "voice": "vo_adv_5070001_011",
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n難得快樂的暑假正要開始，",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n我卻好像有聽見什麼不識相的噪音……",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "這位先生……",
    "voice": "vo_adv_5070001_012",
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "啥？",
    "voice": "vo_adv_5070001_013",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "妳要幹嘛？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "難得都來到海邊了，",
    "voice": "vo_adv_5070001_014",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n不好好享受會很可惜喔？",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "吵死了！",
    "voice": "vo_adv_5070001_015",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "干你們什麼事！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "海之家的店員",
    "words": "客、",
    "voice": "vo_adv_5070001_016",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "海之家的店員",
    "words": "客人。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "海之家的店員",
    "words": "請冷靜一點。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "再說，這全都要怪你慢吞吞",
    "voice": "vo_adv_5070001_017",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "的！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "海之家的店員",
    "words": "噫！？",
    "voice": "vo_adv_5070001_018",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "啊啊，",
    "voice": "vo_adv_5070001_019",
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "好痛……",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我柔弱的手掌被你打得",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "好痛……",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "我聽妳在鬼扯！",
    "voice": "vo_adv_5070001_020",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "\\n是妳自己擅自闖進來的吧！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "靜流。",
    "voice": "vo_adv_5070001_021",
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "怎麼了嗎，",
    "voice": "vo_adv_5070001_022",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "惠理子？",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我",
    "voice": "vo_adv_5070001_023",
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "剛才",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "被這位先生",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "施加暴力了對吧？",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "對啊。",
    "voice": "vo_adv_5070001_024",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n他剛才用力揮下的拳頭",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "命中了惠理子呢。",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "說什麼命中，",
    "voice": "vo_adv_5070001_025",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "她明明就用手接下了！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "喂！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "可惡，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "快放開我！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "王八蛋！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "根本拔不出來！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "既然是他先使用暴力，",
    "voice": "vo_adv_5070001_026",
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "那無論我做什麼都算是正當防衛，",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n是這樣沒錯吧？",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "不可以做得太過火喔？",
    "voice": "vo_adv_5070001_027",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "適度地懲罰他就好。",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "就說",
    "voice": "vo_adv_5070001_028",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "是妳擅自……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "呃，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "咦？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "\\n我好像在哪看過妳……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "啊！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "\\n妳不是",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "破壞者嗎……！！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "哼！！",
    "voice": "vo_adv_5070001_029",
    "unit_id": 117011
  },
  {
    "type": "background",
    "bg_id": "500160"
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "咕嘿！？",
    "voice": "vo_adv_5070001_030",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "敢打擾我跟{0}大人快樂時光的人，",
    "voice": "vo_adv_5070001_031",
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n我絕不會原諒。",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "別忘了！",
    "voice": "vo_adv_5070001_032",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "姐姐我也在喔！",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "海之家的店員",
    "words": "那、",
    "voice": "vo_adv_5070001_033",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "海之家的店員",
    "words": "那個，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "海之家的店員",
    "words": "非常感謝您在我危險時",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "海之家的店員",
    "words": "出手幫忙。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我只是趕走不識相的人，",
    "voice": "vo_adv_5070001_034",
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n免得妨礙{0}大人享受快樂暑假而已。",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "他怎麼會氣成那樣啊？",
    "voice": "vo_adv_5070001_035",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "海之家的店員",
    "words": "那是……",
    "voice": "vo_adv_5070001_036",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "海之家的客人們",
    "words": "…………",
    "voice": "vo_adv_5070001_037",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "海之家的店員",
    "words": "因為有職員突然生病請假，",
    "voice": "vo_adv_5070001_038",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "海之家的店員",
    "words": "\\n導致人手不足，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "海之家的店員",
    "words": "上菜速度變慢……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "不愧是弟弟！",
    "voice": "vo_adv_5070001_039",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "真是溫柔！",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "姐姐我",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "當然也會幫忙！",
    "voice": null,
    "unit_id": 117111
  },
