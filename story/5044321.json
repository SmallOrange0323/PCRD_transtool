    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "什麼花心星，根本不足為敵！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n要上囉，吉格魯特，",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "與我一同出擊吧！！",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "還有我還有我～！",
    "voice": "vo_adv_5044321_001",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "七七香也要使出全力囉～♪",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "來，",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "你也一起上吧上吧！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "真是的，",
    "voice": "vo_adv_5044321_002",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "真是一群",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "吵吵鬧鬧的傢伙呢。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小哥，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就麻煩你關照到最後囉。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "覺醒‧花心星",
    "words": "本、",
    "voice": "vo_adv_5044321_003",
    "unit_id": 13511
  },
  {
    "type": "dialogue",
    "name": "覺醒‧花心星",
    "words": "本大爺追尋的後宮就在眼前……",
    "voice": null,
    "unit_id": 13511
  },
  {
    "type": "dialogue",
    "name": "覺醒‧花心星",
    "words": "\\n好、",
    "voice": null,
    "unit_id": 13511
  },
  {
    "type": "dialogue",
    "name": "覺醒‧花心星",
    "words": "好羨慕……！！",
    "voice": null,
    "unit_id": 13511
  },
  {
    "type": "dialogue",
    "name": "覺醒‧花心星",
    "words": "喂喂，",
    "voice": "vo_adv_5044321_004",
    "unit_id": 13511
  },
  {
    "type": "dialogue",
    "name": "覺醒‧花心星",
    "words": "那邊的小妞們！",
    "voice": null,
    "unit_id": 13511
  },
  {
    "type": "dialogue",
    "name": "覺醒‧花心星",
    "words": "\\n要不要來這裡",
    "voice": null,
    "unit_id": 13511
  },
  {
    "type": "dialogue",
    "name": "覺醒‧花心星",
    "words": "和本大爺銀河約會一場啊～？",
    "voice": null,
    "unit_id": 13511
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "咦？",
    "voice": "vo_adv_5044321_005",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "不好意思～！",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n我沒什麼興趣耶──♪",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "恕我鄭重拒絕。",
    "voice": "vo_adv_5044321_006",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "覺醒‧花心星",
    "words": "唔唔唔！",
    "voice": "vo_adv_5044321_007",
    "unit_id": 13511
  },
  {
    "type": "dialogue",
    "name": "覺醒‧花心星",
    "words": "怎麼這麼難攻陷……！",
    "voice": null,
    "unit_id": 13511
  },
  {
    "type": "dialogue",
    "name": "覺醒‧花心星",
    "words": "\\n但本大爺並不討厭、",
    "voice": null,
    "unit_id": 13511
  },
  {
    "type": "dialogue",
    "name": "覺醒‧花心星",
    "words": "不討厭這種型的喔……！",
    "voice": null,
    "unit_id": 13511
  },
  {
    "type": "dialogue",
    "name": "覺醒‧花心星",
    "words": "\\n那邊那位帶刀的小妞意下如何！？",
    "voice": null,
    "unit_id": 13511
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "受不了，",
    "voice": "vo_adv_5044321_008",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "真是學不會教訓的傢伙。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "回答的話就不用說了。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……像你這種輕浮的傢伙，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我可敬謝不敏。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "覺醒‧花心星",
    "words": "哦哦～",
    "voice": "vo_adv_5044321_009",
    "unit_id": 13511
  },
  {
    "type": "dialogue",
    "name": "覺醒‧花心星",
    "words": "真是銳利的眼神！",
    "voice": null,
    "unit_id": 13511
  },
  {
    "type": "dialogue",
    "name": "覺醒‧花心星",
    "words": "\\n身體一震酥麻",
    "voice": null,
    "unit_id": 13511
  },
  {
    "type": "dialogue",
    "name": "覺醒‧花心星",
    "words": "……本、",
    "voice": null,
    "unit_id": 13511
  },
  {
    "type": "dialogue",
    "name": "覺醒‧花心星",
    "words": "本、",
    "voice": null,
    "unit_id": 13511
  },
  {
    "type": "dialogue",
    "name": "覺醒‧花心星",
    "words": "本大爺興奮起來啦──！",
    "voice": null,
    "unit_id": 13511
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "怎、",
    "voice": "vo_adv_5044321_010",
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "怎麼了！？",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n這傢伙的力量增強了……！？",
    "voice": null,
    "unit_id": 113211
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "難道說，",
    "voice": "vo_adv_5044321_011",
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "他被流夏姐拒絕後，情緒反而更高漲了！？",
    "voice": null,
    "unit_id": 113311
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "為什麼會變成這樣！？",
    "voice": "vo_adv_5044321_012",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "拜託饒了我吧……",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "總之，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "也只能迎擊了。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n要來了，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "杏奈、",
    "voice": null,
    "unit_id": 113111
  },
  {
