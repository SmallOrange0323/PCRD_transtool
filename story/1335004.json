    "voice": "vo_adv_1335004_033",
    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n我為什麼",
    "voice": null,
    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "會想把心裡話全部說出來啊……",
    "voice": null,
    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n這樣",
