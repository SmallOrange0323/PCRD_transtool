    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n聽到你這麼說，",
    "voice": null,
    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我很高興。",
    "voice": null,
    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "呵呵，",
    "voice": "vo_adv_1335004_040",
    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "什麼啦。",
