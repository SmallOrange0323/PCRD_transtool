    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "很幸運呢。",
    "voice": null,
    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n我們都有了能夠聊天的對象，",
    "voice": null,
    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "算是雙贏？",
