    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "都要和我一起去參拜嗎？",
    "voice": null,
    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "那樣的話，",
    "voice": "vo_adv_1335004_041",
    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "已經不是青梅竹馬……",
    "voice": null,
    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n反而",
    "voice": null,
    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "更像是家人了吧。",
    "voice": null,
    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "不過，",
    "voice": "vo_adv_1335004_042",
    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "一直在一起",
    "voice": null,
    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "啊……",
    "voice": null,
    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "如果那樣的日常能夠到來，",
    "voice": null,
    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "一定……",
    "voice": null,
    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "會非常",
    "voice": null,
    "unit_id": 102832
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "幸福呢……",
    "voice": null,
    "unit_id": 102832
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好～",
    "voice": "vo_adv_1335004_043",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "辛苦你了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "有種「新年特殊活動！」",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "的感覺呢？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n你也做得很不錯嘛♪",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "因為變成自己一人而感到不安呢，",
    "voice": "vo_adv_1335004_044",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "咲戀。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "也許有時候，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n越是在人潮中越會感到孤單呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不過能將這些說給你聽，",
    "voice": "vo_adv_1335004_045",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n就是那孩子並不孤單的證據呢～",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "有好好按照籤上寫的建議行動真是了不起啊♪",
    "voice": "vo_adv_1335004_046",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n為了讓那坦率的孩子變得更加幸福，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n你可要拚命努力喔？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那麼在最後……",
    "voice": "vo_adv_1335004_047",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "因為在夢中沒能抽到籤，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n作為代替我就幫你占卜一下運勢吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我看看，",
    "voice": "vo_adv_1335004_048",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "結果是大吉。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n戀愛運是，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "要珍惜身邊的緣分。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "要好好實踐喔？",
    "voice": "vo_adv_1335004_049",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那就這樣囉，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "掰掰～",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500320"
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "嗯……",
    "voice": "vo_adv_1335004_050",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "奇怪？",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我們兩個",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "睡著了？",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "馬車的晃動讓人感覺很舒適，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "不小心就……",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "哎呀，",
    "voice": "vo_adv_1335004_051",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "對面能看到的",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "是蘭德索爾的街道？",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "已經回到這麼近的地方了啊。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "也就是說……",
    "voice": "vo_adv_1335004_052",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n和{0}兩人獨處的旅行，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "也馬上要結束了呢……",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "是啊。",
    "voice": "vo_adv_1335004_053",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "新年假期結束後，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "有很多事情要做呢。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n要回到一如往常的每一天，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "並且今後也會",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "持續下去。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "明天、後天，",
    "voice": "vo_adv_1335004_054",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "或是更遙遠的未來。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "雖然不知道",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "會發生什麼事，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "即使如此……",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "不管發生什麼事，",
    "voice": "vo_adv_1335004_055",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我們都會一起跨越困難，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n將那些化作我們兩人的回憶。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "只有這點，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我是",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "深信不疑的。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "……這麼說來，",
    "voice": "vo_adv_1335004_056",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "總覺得",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我們兩個……",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "呵呵，",
    "voice": "vo_adv_1335004_057",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "沒事。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "特地說出口的話，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "就太不解風情了。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "而且……",
    "voice": "vo_adv_1335004_058",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "答案我已經",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "在夢中收到了。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n謝謝你，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "{0}……♪",
    "voice": null,
    "unit_id": 102811
  }
