    "name": "女性２",
    "words": "咦咦咦？",
    "voice": "vo_adv_1056004_037",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "這是怎麼回事？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你們誤會了，這孩子不是小偷！",
    "voice": "vo_adv_1056004_038",
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n他是來幫我一起抓",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這隻貓的！",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "如你們所見，貓已經找到了。",
    "voice": "vo_adv_1056004_039",
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "剛剛發生的事情，",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "能不能就當作沒有發生過呢。",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "既然是魚店小姐都這麼說了，",
    "voice": "vo_adv_1056004_040",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性１",
    "words": "那就不會錯。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "原來不是變態啊……",
    "voice": "vo_adv_1056004_041",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性２",
    "words": "太好了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這樣一來你的誤會也解開了。",
    "voice": "vo_adv_1056004_042",
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "接下來剩這些貓……",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "哎呀呀，該怎麼辦呢……",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "咦？",
    "voice": "vo_adv_1056004_043",
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "大姐頭？",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "妳好！",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "流夏大姐頭！",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "是你啊……",
    "voice": "vo_adv_1056004_044",
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "喂，",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不准叫我大姐頭。",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "抱歉，",
    "voice": "vo_adv_1056004_045",
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "一不小心就……",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "嘿嘿嘿。",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "啊～你問他是誰？",
    "voice": "vo_adv_1056004_046",
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "之前我遇到他在做壞事，把他訓了一頓以後，",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n就混熟了。",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "大姐頭，",
    "voice": "vo_adv_1056004_047",
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "有什麼煩心事嗎？",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就說不准叫我大姐頭……",
    "voice": "vo_adv_1056004_048",
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "唉，算了。",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你能不能",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "幫我替這些貓咪找飼主啊？",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我家不是魚商嗎？",
    "voice": "vo_adv_1056004_049",
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n怕牠們會打商品的主意，",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "沒辦法養。",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n不然在找到飼主之前，",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "先寄放你那裡也行。",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "既然是大姐頭的吩咐，",
    "voice": "vo_adv_1056004_050",
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "我會全力幫忙！",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你明明知道還故意這樣叫是吧……",
    "voice": "vo_adv_1056004_051",
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "算了。",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n最好是能找到",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "有人願意全部收養呢。",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "我去找死黨，問看看有沒有人可以養！",
    "voice": "vo_adv_1056004_052",
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "\\n",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "我也會請他們問認識的人，",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "\\n不用擔心！",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "謝啦。",
    "voice": "vo_adv_1056004_053",
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n……不過，如果是他們的話應該能馬上找到吧。",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "總之事情圓滿落幕。",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小哥你也辛苦了。",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不過你還真了不起啊，",
    "voice": "vo_adv_1056004_054",
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小哥。",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n事發突然你卻願意來幫我的忙，",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n被人誤會了也毫不在意。",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "哦……",
    "voice": "vo_adv_1056004_055",
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這年頭這種人已經不多了呢。",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n願意這麼為了助人而採取行動。",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小哥，",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你真是個了不起的男人！",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "下次到商店街的時候，記得來我店裡露個臉。",
    "voice": "vo_adv_1056004_056",
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我家的招牌商品可以算你便宜喔。",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n……今天謝謝你啦。",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好的，",
    "voice": "vo_adv_1056004_057",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "辛苦了。 ",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "怎麼樣呢，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我讓你看的夢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "流夏真是個瀟灑，又很熱心的人呢。",
    "voice": "vo_adv_1056004_058",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "打起架來也很厲害。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "難怪會有這麼多人仰慕她。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "只是有時做得太過頭，還真希望她能改進一下……",
    "voice": "vo_adv_1056004_059",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我也曾經因為她而吃過苦頭呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "……不過現在回想起來也是一樁令人懷念的往事。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "但你要記得，",
    "voice": "vo_adv_1056004_060",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "她也是一個人。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n總有一天會遇到無法獨自跨越的難關。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "到時還請你在身旁支持她。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那麼，",
    "voice": "vo_adv_1056004_061",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "下次見囉。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500020"
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "嗯……",
    "voice": "vo_adv_1056004_062",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "嗯？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "看樣子我好像是睡著了……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "呼……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你也睡著了嗎？",
    "voice": "vo_adv_1056004_063",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我也是。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n沒想到竟然會做夢。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "原來如此，",
    "voice": "vo_adv_1056004_064",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你做了一個尋找貓的夢啊……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我也是呢。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "剛好夢裡有個跟你一樣，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "會為了助人而採取行動的人。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "如果是你的話，",
    "voice": "vo_adv_1056004_065",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我相信就算不是夢裡，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n你也會採取一樣的行動吧。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "有小偷～！",
    "voice": "vo_adv_1056004_066",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "快幫我抓住他～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "什麼，有小偷？",
    "voice": "vo_adv_1056004_067",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你打算怎麼辦……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "看來是不必問呢。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "走囉，小哥！",
    "voice": "vo_adv_1056004_068",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就讓我們兩個一起",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "去捉小偷吧！",
    "voice": null,
    "unit_id": 105611
