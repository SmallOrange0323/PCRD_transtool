[
  {
    "type": "background",
    "bg_id": "500550"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "除夕當天。{0}到達了\\n從日和那邊拿到的地圖上所紀錄的會面點。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "騎士先生！",
    "voice": "vo_adv_5010001_000",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "　這裡這裡！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "呀。",
    "voice": "vo_adv_5010001_001",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "沒有遲到真是太好了。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "騎士先生。",
    "voice": "vo_adv_5010001_002",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "你會不會口渴？",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "　\\n",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我們有帶飲料和便當過來，",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n肚子餓的話就說一聲唷。",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你說這件嗎？",
    "voice": "vo_adv_5010001_003",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "　這叫做和服，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n是這附近年底年初或慶典之類的時節會穿的衣服。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "原本",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "好像是從其他大陸傳過來的服裝。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "你看你看，騎士先生！",
    "voice": "vo_adv_5010001_004",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "　不錯吧〜！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我的和日和的，",
    "voice": "vo_adv_5010001_005",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "都是怜幫我們穿上的喔。",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "還適合……",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "嗎？",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "謝、",
    "voice": "vo_adv_5010001_006",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "謝謝……",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "呵呵，",
    "voice": "vo_adv_5010001_007",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "能被你誇獎真榮幸。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "欸嘿嘿。！",
    "voice": "vo_adv_5010001_008",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "　謝謝囉，",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "騎士先生！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "――不好意思打斷你們講話。",
    "voice": "vo_adv_5010001_009",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "\\n你們幾位，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "是【破曉之星】的成員嗎？",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "正是。",
    "voice": "vo_adv_5010001_010",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "您是這裡的祭司嗎？",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "沒錯。",
    "voice": "vo_adv_5010001_011",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "這次能接受我們的委託，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "\\n真的非常感謝。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "請別在意！",
    "voice": "vo_adv_5010001_012",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "有困難的時候",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "就要互相幫助幫助",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "剛剛那句話是公會的基本方針，",
    "voice": "vo_adv_5010001_013",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不需要客氣。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "我明白了。",
    "voice": "vo_adv_5010001_014",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "哎呀，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "好像比聽說的人數",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "多了一位……？",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "難道，",
    "voice": "vo_adv_5010001_015",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "不行嗎……？",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "他會幫忙支援我們，",
    "voice": "vo_adv_5010001_016",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是很可靠的夥伴。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "希望這次的委託",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "能讓他一起同行。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "原來是這樣啊。",
    "voice": "vo_adv_5010001_017",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "當然非常歡迎。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "\\n我們也會多準備一人份的報酬。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "非常謝謝你！",
    "voice": "vo_adv_5010001_018",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "　",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "太好了，騎士先生！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "不不，我們才是。",
    "voice": "vo_adv_5010001_019",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "那麼馬上",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "來針對今天的委託",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "做比較詳細的說明吧。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "再麻煩您了！",
    "voice": "vo_adv_5010001_020",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "那麼首先",
    "voice": "vo_adv_5010001_021",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "從這座神殿的由來開始……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "這裡是自古以來就存在於蘭德索爾，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "祭祀古老神明的神殿。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我記得文獻上說，",
    "voice": "vo_adv_5010001_022",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這裡可能比索爾之塔還要古老……",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "妳很了解呢。",
    "voice": "vo_adv_5010001_023",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "而且據說這座神殿直到現在，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "\\n都受到職掌願望的古老神明的庇佑。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "庇佑，",
    "voice": "vo_adv_5010001_024",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "指的是什麼呢？",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "這是很好的問題。",
    "voice": "vo_adv_5010001_025",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "\\n就是……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "獻給這座神殿的願望會成真",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "的意思。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "原來是這樣……",
    "voice": "vo_adv_5010001_026",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "很棒呢。",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "然後如大家所知，",
    "voice": "vo_adv_5010001_027",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "\\n這座神殿",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "會在除夕時進行焚燒儀式。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "在紙上寫下那一年沒實現的願望，",
    "voice": "vo_adv_5010001_028",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n一邊默念著希望明年可以實現，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "一邊投入火焰中。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "以這樣的方式",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "讓願望回到天上。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "大家都說在這裡焚燒的願望，",
    "voice": "vo_adv_5010001_029",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n常常會在隔年實現呢。",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "是啊。",
    "voice": "vo_adv_5010001_030",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "藉由淨化讓它蛻變，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "\\n願望會變得比過去更容易實現。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "我們是這麼想的。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "好厲害——……",
    "voice": "vo_adv_5010001_031",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "原來真的可以",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "做到這種事啊！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "當然實現與否",
    "voice": "vo_adv_5010001_032",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "也會因人而異。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "也是呢……",
    "voice": "vo_adv_5010001_033",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "覺得有點可惜。",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "可惜……",
    "voice": "vo_adv_5010001_034",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "就是這樣。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "留下來的思念、",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "願望。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "這正是今天請大家過來的原因。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "只憑著焚燒儀式，",
    "voice": "vo_adv_5010001_035",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "是無法完全淨化願望的。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "殘留在焚燒的紙張或物品上的願望和思念未被淨化，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "\\n充斥著這座神殿，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "最終將會化為實體。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你說什麼……！？",
    "voice": "vo_adv_5010001_036",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "一開始會呈現像是碰不到的薄霧的樣子。",
    "voice": "vo_adv_5010001_037",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "\\n但是接近新年願望殘渣增加的話，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "就會附身於物品，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "最糟糕的狀況會化為實體開始暴動，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "襲擊來參拜的客人。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "怎麼會……",
    "voice": "vo_adv_5010001_038",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "我想大家都已經了解，",
    "voice": "vo_adv_5010001_039",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "需要麻煩你們幫忙戒備神殿和參拜道路，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "以及淨化在那裡實體化的願望。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我知道了！",
    "voice": "vo_adv_5010001_040",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "　",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "大家沒被淨化而困擾著的願望，",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n就由我們來拯救！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "拯救願望……",
    "voice": "vo_adv_5010001_041",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "嗯。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "是這樣呢。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "就是這樣。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "\\n委託各位幫忙，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "果然是正確的決定。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "謝謝你。",
    "voice": "vo_adv_5010001_042",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我們會努力不辜負您的期待，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n盡所有成員",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "的全力。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "快到開放神殿，",
    "voice": "vo_adv_5010001_043",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "開始焚燒儀式的時候了。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "因此，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "要請大家趁現在做好準備。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "\\n那麼在新年之前，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "祭司",
    "words": "就麻煩各位了。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我們才是，",
    "voice": "vo_adv_5010001_044",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "今後請多多指教！",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……",
    "voice": "vo_adv_5010001_045",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "淨化願望啊。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "雖然有聽說要幫忙神殿，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n但竟然是被交付如此重要的任務。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "沒問題……",
    "voice": "vo_adv_5010001_046",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "對吧？",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "沒問題的！",
    "voice": "vo_adv_5010001_047",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "　騎士先生也在！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "也是呢。",
    "voice": "vo_adv_5010001_048",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "雖然是偶然，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不過當時有叫住你真的太好了呢。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "其實本來是想",
    "voice": "vo_adv_5010001_049",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "和大家一起過新年的，",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "只是時間談不攏……",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "不過年底大家都有時間，",
    "voice": "vo_adv_5010001_050",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "就想說和大家一起",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n創造今年最後的回憶！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "順帶一提",
    "voice": "vo_adv_5010001_051",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "日和會邀請你，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是因為這次的工作報酬金額還不錯。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "騎士先生，",
    "voice": "vo_adv_5010001_052",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "你不是說想發紅包嗎？",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "所以就想說一起的話如何！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "突然邀請你，",
    "voice": "vo_adv_5010001_053",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "會不會給你添麻煩……？",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我們才想說謝謝呢。",
    "voice": "vo_adv_5010001_054",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "今天一起加油吧！",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不用在意喔。",
    "voice": "vo_adv_5010001_055",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "有困難的時候",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就要互相幫助幫助。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "怜！？",
    "voice": "vo_adv_5010001_056",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "那是我想說的話～！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "呵呵。",
    "voice": "vo_adv_5010001_057",
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "被搶先了呢。",
    "voice": null,
    "unit_id": 108811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "抱歉抱歉。",
    "voice": "vo_adv_5010001_058",
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那麼，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就先聊到這裡，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我們也去準備吧。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n每年這裡都有非常多人來訪，",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不拿出幹勁是不行的呢。",
    "voice": null,
    "unit_id": 108911
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "好～！",
    "voice": "vo_adv_5010001_059",
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "　",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "很好，",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "要加油囉——！",
    "voice": null,
    "unit_id": 108711
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "於是{0}和日和他們一起，\\n開始準備迎接來參拜的客人。",
    "voice": null,
    "unit_id": null
  }
]
