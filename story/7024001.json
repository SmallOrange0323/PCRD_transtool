  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "哎呀，",
    "voice": "vo_adv_7024001_058",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "時機正好呢。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
