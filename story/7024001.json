    "voice": "vo_adv_7024001_063",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "……",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "呼……",
    "voice": "vo_adv_7024001_064",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "呼……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n居然能躲開那個，還挺有本事的……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "克蕾琪塔小姐。",
    "voice": "vo_adv_7024001_065",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n可以拜託您認真一點嗎？",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "你、",
    "voice": "vo_adv_7024001_066",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "你說什麼！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我一直都很認真啊！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "那為什麼會一直打偏……",
    "voice": "vo_adv_7024001_067",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n您比平常還糟糕耶。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "什麼叫比平常還糟糕！",
    "voice": "vo_adv_7024001_068",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "這種東西",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "只要好好瞄準……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "就是現在！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "……",
    "voice": "vo_adv_7024001_069",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n看來，",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "您因為急著立功",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "而用力過頭了呢。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "這也沒辦法吧！？",
    "voice": "vo_adv_7024001_070",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n就算身體再怎麼強化，我還是一名商人啊！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "戰鬥這種野蠻的行為本來就不是我的工作！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "那您就安分點不就好了……",
    "voice": "vo_adv_7024001_071",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我怎麼可能讓那個魔法師在我面前擺架子呢！",
    "voice": "vo_adv_7024001_072",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我必須以隊長的身分",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "掌握主導權啊！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "唉，",
    "voice": "vo_adv_7024001_073",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "原來如此。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "先不說這個了……",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "小心後面。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "咿咿咿！？",
    "voice": "vo_adv_7024001_074",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "真、",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "真是太危險了……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "光看是滿有趣的，",
    "voice": "vo_adv_7024001_075",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "但您要是在這裡倒下去我也會很困擾。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n克蕾琪塔小姐，",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "請把眼睛閉上。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "你在說什麼蠢話啊，秘書一號！",
    "voice": "vo_adv_7024001_076",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n我要是閉眼，不就看不見敵人了嗎！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n會沒辦法進行攻擊耶！？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "您就算看見了",
    "voice": "vo_adv_7024001_077",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "打不中也是一樣。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "來，",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "快點吧。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "啊啊啊啊！",
    "voice": "vo_adv_7024001_078",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "討厭！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我知道了啦！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "這樣就行了吧！？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "就這樣把弩往右移15度左右……",
    "voice": "vo_adv_7024001_079",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n維持高度，",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "然後射擊。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "到底要做什麼啦……",
    "voice": "vo_adv_7024001_080",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "討厭！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "哎呀？",
    "voice": "vo_adv_7024001_081",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "原地不動，",
    "voice": "vo_adv_7024001_082",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "腰部以上往左90度回頭……",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n伸直手臂發射。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "哎呀哎呀哎呀？",
    "voice": "vo_adv_7024001_083",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "最後往正上方瞄準……",
    "voice": "vo_adv_7024001_084",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "就是現在！",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "喝！",
    "voice": "vo_adv_7024001_085",
    "unit_id": 118011
  },
  {
    "type": "background",
    "bg_id": "500430"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "好了。",
    "voice": "vo_adv_7024001_086",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n您可以睜開眼睛了。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……？",
    "voice": "vo_adv_7024001_087",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n這、",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "這是……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "打、",
    "voice": "vo_adv_7024001_088",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "打贏了！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n大家看見了嗎？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我大顯身手的樣子！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "呵呵呵呵，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "秘書一號也做得很好呢。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "是啊。",
    "voice": "vo_adv_7024001_089",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n真是了不起的才能呢。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "似似花",
    "voice": "vo_adv_7024001_090",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "對吧對吧。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n這就是我的……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我說的是",
    "voice": "vo_adv_7024001_091",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "那邊那位。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "…………",
    "voice": "vo_adv_7024001_092",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "以立體的視角俯瞰戰場，",
    "voice": "vo_adv_7024001_093",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "並給予準確的指示。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "身經百戰的將領也做不到這種程度吧。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "……不敢當。",
    "voice": "vo_adv_7024001_094",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "給我等一下！",
    "voice": "vo_adv_7024001_095",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n關鍵在於我才對吧！？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n實際上打倒敵人的是我耶！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "雖然秘書一號確實有提供協助，",
    "voice": "vo_adv_7024001_096",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n但能充分發揮部下才能的卻是隊長的資質啊！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "只是按照那位部下的指示去做的人，",
    "voice": "vo_adv_7024001_097",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n我不覺得會有隊長的資質呢。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "妳所擁有的，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "只有扮演魁儡的才能吧。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "什麼！！",
    "voice": "vo_adv_7024001_098",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "妳什麼意思～！？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你是",
    "voice": "vo_adv_7024001_099",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "秘書吧。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "希望你可以在今後的戰鬥，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "幫忙關注敵人的動向。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n請從最後方給我們建言。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "我明白了。",
    "voice": "vo_adv_7024001_100",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "你好像也沒有受傷。",
    "voice": "vo_adv_7024001_101",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我們就繼續前進吧。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "好的，",
    "voice": "vo_adv_7024001_102",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "似似花小姐。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "給我等一下，",
    "voice": "vo_adv_7024001_103",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "秘書一號！？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n你為什麼要那麼老實地服從她啊！？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n她是個可疑的魔法師耶！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "因為我覺得，",
    "voice": "vo_adv_7024001_104",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "這種時候",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "服從似似花小姐，",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n工作起來會比較有效率。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "有什麼問題嗎？",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "沒錯……",
    "voice": "vo_adv_7024001_105",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "你就是這種人……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "那麼，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "你為什麼要叫她似似花小姐！？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n要不是週末陪你喝一杯，你還不會稱呼我為小姐耶！？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "再拖下去我們就丟下妳先走了喔？",
    "voice": "vo_adv_7024001_106",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n克蕾琪塔。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "喂！",
    "voice": "vo_adv_7024001_107",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "居然連稱呼都沒了！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n你這樣沒有違反契約嗎！？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "給、",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "給我等一下啦～！！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就這樣，眾人之間的權力關係一點一滴地成形，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n克蕾琪塔的呼喊聲傳遍整座露娜之塔。",
    "voice": null,
    "unit_id": null
  }
]
