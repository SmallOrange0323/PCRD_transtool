  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "請等一下！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n我還沒做好心理準備……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "事、",
    "voice": "vo_adv_7024001_060",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "事已至此只能拚了……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n看招！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "克蕾琪塔小姐？",
    "voice": "vo_adv_7024001_061",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "還沒完！",
    "voice": "vo_adv_7024001_062",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "秘書",
