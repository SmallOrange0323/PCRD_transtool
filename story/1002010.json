  {
    "type": "dialogue",
    "name": "旁白",
    "words": "那天，{0}和優衣結束工作後，\\n徒步從山的另一端的村莊回蘭德索爾途中——",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "——都到這邊了",
    "voice": "vo_adv_1002010_000",
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "應該很快就會看到",
