[
  {
    "type": "background",
    "bg_id": "500560"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "結束參拜的貪吃佩可和{0}，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n悠閒地走在參拜路上。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "吃了許多美味的東西，",
    "voice": "vo_adv_1118004_000",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "還去求了籤，",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n充分享受了新年，",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "真是太滿足了☆",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "總覺得眼前明亮了許多，",
    "voice": "vo_adv_1118004_001",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n就像是在觀賞元旦日出一樣……",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "哇哇！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n是真的在發光耶！？",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這道光是……！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "background",
    "bg_id": "510100"
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "「新年快樂！」",
    "voice": "vo_adv_1118004_002",
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "「哎呀呀？",
    "voice": "vo_adv_1118004_003",
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "真奇怪。",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "還以為你會因為我在日本",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "而大吃一驚呢……」",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "「這就叫做命運吧！",
    "voice": "vo_adv_1118004_004",
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好浪漫喔，真棒☆」",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "「我也覺得來這裡",
    "voice": "vo_adv_1118004_005",
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "或許就能遇見你，",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n就趁著公務空檔跑過來了。」",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "「啊哈哈，",
    "voice": "vo_adv_1118004_006",
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "說得也是。",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "新聞有報導呢。",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "就是如此。",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我被邀請來參加新年慶祝會，",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "所以又到日本了。」",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "「話說回來，",
    "voice": "vo_adv_1118004_007",
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "你就像平時見面一般和我自然相處，",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這樣也很讓人開心呢。",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "真是新發現。」",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "「那麼那麼，",
    "voice": "vo_adv_1118004_008",
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "新年問候也說完了……",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "你有沒有注意到",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我有什麼不同呢？」",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "「欸嘿嘿，",
    "voice": "vo_adv_1118004_009",
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "謝謝誇獎。",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我一直很想讓你看看這套打扮呢。」",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "「聽說日本的新年",
    "voice": "vo_adv_1118004_010",
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "家家戶戶都會在家裡度過，",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "大街上空無一人，",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我本來還有點擔心會見不到你呢。」",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "「然而我們卻像現在這樣見到面了，",
    "voice": "vo_adv_1118004_011",
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這果然是命運呢☆」",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "「話說回來，",
    "voice": "vo_adv_1118004_012",
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "你手上提著的塑膠袋裡裝了什麼？",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是新年料理嗎？",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "日本的新年",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "會吃年菜對吧？」",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "「啊！",
    "voice": "vo_adv_1118004_013",
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這不是杯麵嗎！",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "它或許算是日本的傳統食物沒錯啦……」",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "「難不成，",
    "voice": "vo_adv_1118004_014",
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "你已經吃過年菜了……？」",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "「太好了！",
    "voice": "vo_adv_1118004_015",
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "既然如此，",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "要不要一起吃年菜呢？",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊，",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不是啦，",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我手裡也沒有現成的料理。",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "只是想說",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "能去買年菜來",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "和你一起吃。」",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "「咦？",
    "voice": "vo_adv_1118004_016",
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "對耶，",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "年菜要在年末就先買好。",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是我沒做好功課……」",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "「啊！",
    "voice": "vo_adv_1118004_017",
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那麼，",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "有哪裡會賣年菜食材嗎？",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我聽說年菜中的",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "每一道配菜，",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n都蘊含著人們對幸福的期盼呢。」",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "「我們要不要試著做做看",
    "voice": "vo_adv_1118004_018",
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "兩個人能做的菜色呢？",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "和你一起做有著美好寓意的年菜，",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "再一同享用，",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n感覺就能度過充滿幸福的一年呢。」",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "「謝謝！",
    "voice": "vo_adv_1118004_019",
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n那我們就快點",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "去找食材吧！」",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "background",
    "bg_id": "510040"
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "「哇──！",
    "voice": "vo_adv_1118004_020",
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這就是日本的超市啊！",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "賣的東西和我們完全不一樣，",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "真有趣！」",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "「那就先去挑配料吧！",
    "voice": "vo_adv_1118004_021",
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我看看……",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊！",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "魚板！",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "有魚板耶！」",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "「紅白兩色的很喜氣呢。",
    "voice": "vo_adv_1118004_022",
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "對日本人來說是很常見的食材，",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n但對我來說卻很新鮮。」",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "「還有什麼呢……",
    "voice": "vo_adv_1118004_023",
    "unit_id": 111831
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我記得，",
    "voice": null,
    "unit_id": 111831
  },
  {
    "type": "dialogue",
