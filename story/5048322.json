[
  {
    "type": "dialogue",
    "name": "依里",
    "words": "這、",
    "voice": "vo_adv_5048322_000",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "這是什麼……",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "長、",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "長得跟我還有茜里一模一樣耶！",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "到底是從哪裡冒出來的呀……",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "這也是受到弓箭失控的影響嗎？",
    "voice": "vo_adv_5048322_001",
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n不管怎麼說，",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "我從它們身上感受不到什麼善意，",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "我們快點收拾掉它們吧，",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "姊姊。",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "就、",
    "voice": "vo_adv_5048322_002",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "就算妳那麼說，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "看見自己出現在眼前的感覺",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n好不舒服啊……",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "那雙眼睛",
    "voice": "vo_adv_5048322_003",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "彷彿能夠看穿我們的一切……",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "真是的，",
    "voice": "vo_adv_5048322_004",
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "姊姊你就是太愛操心了。",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "確實外表和我們一模一樣，",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "但也僅止於此呀。",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "畢竟它們沒有心，",
    "voice": "vo_adv_5048322_005",
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "肯定是我們兩個比較強呀！",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "……",
    "voice": "vo_adv_5048322_006",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "說得對。",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "不管再怎麼模仿我們的外貌，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n沒有心的冒牌貨之間",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "是萌生不出親姊妹的羈絆的。",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "抱歉我剛才說了喪氣話。",
    "voice": "vo_adv_5048322_007",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "就讓它們見識一下",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我們無敵羈絆的力量！",
    "voice": null,
    "unit_id": 113811
  }
]
