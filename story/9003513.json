[
  {
    "type": "dialogue",
    "name": "嘉夜、祈梨",
    "words": "喝啊！\\n嘿──！",
    "voice": "vo_adv_9003513_000",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "唔……！",
    "voice": "vo_adv_9003513_001",
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "呵呵。",
    "voice": "vo_adv_9003513_002",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n你差不多沒有退路了呢～♪",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "……哎呀哎呀。",
    "voice": "vo_adv_9003513_003",
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "\\n",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "本沒打算捲入消耗戰的……",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "真無奈啊。",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "萬能人偶",
    "words": "「嗡──嗡──」",
    "voice": null,
    "unit_id": 191912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "哇哇！",
    "voice": "vo_adv_9003513_004",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n它們",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "又出現了！？",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "萬能人偶──",
    "voice": "vo_adv_9003513_005",
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "耗費了我這麼多心血，",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "應該能爭取到一些時間吧。",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "\\n且讓我重整旗鼓囉。",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "喂喂，大叔！",
    "voice": "vo_adv_9003513_006",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "明明才打到一半，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你是想逃嗎？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "剛才",
    "voice": "vo_adv_9003513_007",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "已經說了要做個了斷吧……！？",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "我當然",
    "voice": "vo_adv_9003513_008",
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "也想分出勝負。",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "\\n但戰鬥",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "比預期的延長了許多……",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "\\n",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "所以我想",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "先用餐休息片刻。",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "哇，",
    "voice": "vo_adv_9003513_009",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那很不錯呢……☆",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "純、智",
    "words": "陛下！",
    "voice": "vo_adv_9003513_010",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "開、",
    "voice": "vo_adv_9003513_011",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "開玩笑的啦～！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "呵呵。",
    "voice": "vo_adv_9003513_012",
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "容我先失陪了。",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "呵呵♪",
    "voice": "vo_adv_9003513_013",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n不會讓你逃走的唷～",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "唔……！？",
    "voice": "vo_adv_9003513_014",
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "\\n……才一瞬間就阻止了傳送……！",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "不放過虛弱的獵物，",
    "voice": "vo_adv_9003513_015",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "確實地取其性命……",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "這是狩獵的基本喔～♪",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "唷呼♪",
    "voice": "vo_adv_9003513_016",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "老大看出大叔的意圖了啊！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不愧是老大！",
    "voice": "vo_adv_9003513_017",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n作風老是這麼陰險啊～！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "在教訓祈梨之前……",
    "voice": "vo_adv_9003513_018",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "差不多該束手就擒了吧？",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "【憤怒‧軍團】♪",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "我不會",
    "voice": "vo_adv_9003513_019",
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "讓妳稱心如意……！",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "唔……！？",
    "voice": "vo_adv_9003513_020",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n沒想到",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "他還保留了這麼多力量……！",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "別大意！",
    "voice": "vo_adv_9003513_021",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n接下來可是關鍵時刻……！",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好的！",
    "voice": "vo_adv_9003513_022",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n這是最後的對決了！",
    "voice": null,
    "unit_id": 105811
  }
]
