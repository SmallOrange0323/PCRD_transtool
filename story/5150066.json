  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "妳不熱嗎？",
    "voice": "vo_adv_5150066_000",
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "還真突然呢……",
    "voice": "vo_adv_5150066_001",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n小涅比亞，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "妳理解自己現在正在被人追趕嗎？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "我當然知道啦。",
    "voice": "vo_adv_5150066_002",
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "但妳看，",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n我的天性就是無法讓在意的事只停在在意的階段而置之不理呢。",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "天性啊……",
    "voice": "vo_adv_5150066_003",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "借那個詞一用的話，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我會像這樣身穿鎧甲也是",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "類似於天性喔。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "所以，",
    "voice": "vo_adv_5150066_004",
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "會熱嗎？",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "…………這",
    "voice": "vo_adv_5150066_005",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我算是不否認。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "原來如此呢～♪",
    "voice": "vo_adv_5150066_006",
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "好，",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "那那身鎧甲",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "就由我幫妳脫下來！",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "啊？",
    "voice": "vo_adv_5150066_007",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n不，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "別這樣，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我──",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "展開環境系統！",
    "voice": "vo_adv_5150066_008",
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n我按～♪",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這、",
    "voice": "vo_adv_5150066_009",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這是……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "暴風！？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n是要把鎧甲剝下來嗎……！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "但這種程度的風暴，",
    "voice": "vo_adv_5150066_010",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "對於因訓練而徹底鍛鍊過的我而言是不管用的。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我一天二十四小時穿著鎧甲，可不是白穿的……！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "妳知道《北風與太陽》嗎？",
    "voice": "vo_adv_5150066_011",
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "知道的吧？",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "咦？",
    "voice": "vo_adv_5150066_012",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "話說，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "該不會……！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "我按～♪",
    "voice": "vo_adv_5150066_013",
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "好燙",
    "voice": "vo_adv_5150066_014",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不是熱，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "而是燙……！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n鎧甲",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "在發燙……！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "好了好了，",
    "voice": "vo_adv_5150066_015",
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "要是不趕快脫下來，",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "就要被鎧甲燒成煎蛋了喔～♪",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……唔，",
    "voice": "vo_adv_5150066_016",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "好燙……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "但是！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n地獄之盾！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "什……",
    "voice": "vo_adv_5150066_017",
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "撐住了嗎！？",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "看好了，",
    "voice": "vo_adv_5150066_018",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這就是",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n【王宮騎士團】團長的驕傲……！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "還真了不起呢……",
    "voice": "vo_adv_5150066_019",
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "是我輸了。",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "作為賠罪，",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "我來讓妳涼快一下。",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "唔哇……",
    "voice": "vo_adv_5150066_020",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "好涼……！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n嗯，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "身體好涼爽……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "真舒服呢。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "──嗯？",
    "voice": "vo_adv_5150066_021",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n總覺得",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這水",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "滑溜溜的……？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "等一下，小涅比亞？",
    "voice": "vo_adv_5150066_022",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n妳在我身上施加了什麼？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n身體",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "滑溜溜的……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "鎧甲要──！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "呀哈哈♪",
    "voice": "vo_adv_5150066_023",
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n中招了呢！",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n很舒服吧？",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "滑溜溜的史萊姆果凍♪",
    "voice": null,
    "unit_id": 190912
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "好、",
    "voice": "vo_adv_5150066_024",
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "好過分……！",
    "voice": null,
    "unit_id": 113611
  }
]
