  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "羅塞塔的狀況？",
    "voice": "vo_adv_6038310_000",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "　啊～原來如此，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "因為之前跟優妮升機一起燒起來了，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n所以你很在意那之後它是否平安嗎？",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "放心吧，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "它是石頭，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "燒不起來的。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "來吧，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "就當作是打招呼，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "隨便試著跟它說些什麼吧。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "砰～！",
    "voice": "vo_adv_6038310_001",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "　♪啵啵嘎啵",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "（喝呀）",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "　♪啵啵嘎啵",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "（嘿咻）",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "\\n表情很恐怖喔克蘿依",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "　腦袋切嚕了的琪愛兒",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "　才貌雙全的優妮學姐",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "\\n三人聚在一起就是優妮們",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "　優妮帶頭唱太陽大放晴",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "（耶～）",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "砰～！",
    "voice": "vo_adv_6038310_002",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "　該筆資訊",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "「管理者的3圍」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "受到嚴密的保護，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "\\n取得相關情報，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "克蘿依小姐的數據！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "\\n順序由上而下為，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "80――",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "OK羅塞塔快停止。",
    "voice": "vo_adv_6038310_003",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "會被殺掉的！",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "就算你沒事，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我跟他也會被殺掉。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "心跳加速！",
    "voice": "vo_adv_6038310_004",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "　剛剛的指令",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "使我發現了少女的脆弱！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "\\n我們已經沒辦法再做朋友了！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "　這石頭的心跳聲，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "難道",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "羅塞塔",
    "words": "這就是愛情嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "羅塞塔，",
    "voice": "vo_adv_6038310_005",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "原來你是母的啊……",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "話說回來，你有雌雄之分嗎……",
    "voice": null,
    "unit_id": 111011
  }
]
