    "name": "旁白",
    "words": "她對貪吃佩可的看法產生變化──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n那是還需要一些時日才會發生的事了。",
    "voice": null,
    "unit_id": null
  }
