    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "想到什麼了嗎？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "胸部，",
    "voice": "vo_adv_1180001_071",
    "unit_id": 106414
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "很大～！",
    "voice": null,
    "unit_id": 106414
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "要論胸部我的比她大啦──！！！",
    "voice": "vo_adv_1180001_072",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n接下來一段時間，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n克蕾琪塔不斷試圖從{0}兩人身上打聽出情報……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……呼、",
    "voice": "vo_adv_1180001_073",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "呼……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n看、",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "看來完全就是",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "徒勞無功呢……",
