    "name": "旁白",
    "words": "受貴族議會所委託，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n擔起復興蘭德索爾大任，視錢如命的女商人──克蕾琪塔。",
    "voice": null,
    "unit_id": null
  },
  {
