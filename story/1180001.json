[
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我的克蕾琪塔之塔啊啊啊──！！！？",
    "voice": "vo_adv_1180001_000",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──自【憤怒‧軍團】的少年卡里莎，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n進行第一次襲擊後，過了數日。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "由克蕾琪塔‧凱許擔任公會長的【里士滿工商會】，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n正在著手進行把被破壞的建築物及瓦礫清除的工程。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "工作人員們",
    "words": "嘿咻──！",
    "voice": "vo_adv_1180001_001",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "各位，",
    "voice": "vo_adv_1180001_002",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "那邊的大石柱碎塊",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "請搬到石頭工匠那邊。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n鐵材則請",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "搬到鍛冶場去。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n我已經事先做好安排，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "盡可能將這些資源回收再利用。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "工作人員們",
    "words": "了解──！！",
    "voice": "vo_adv_1180001_003",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……唉……",
    "voice": "vo_adv_1180001_004",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "……",
    "voice": "vo_adv_1180001_005",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "克蕾琪塔小姐？",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "…………",
    "voice": "vo_adv_1180001_006",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "唉唉唉…………",
    "voice": "vo_adv_1180001_007",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "克蕾琪塔小姐。",
    "voice": "vo_adv_1180001_008",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n若您想要唉聲嘆氣，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "還麻煩回辦公室進行。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n您這只會妨礙清除工程。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "給我等一下，我說妳呀！",
    "voice": "vo_adv_1180001_009",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n竟把雇主當成礙事者，是什麼意思！？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "就算您問我",
    "voice": "vo_adv_1180001_010",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "什麼意思……",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n我不過是陳述事實罷了。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "且看。",
    "voice": "vo_adv_1180001_011",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n因為克蕾琪塔小姐擋住了通路，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n導致作業人員現在都無所適從。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "…………",
    "voice": "vo_adv_1180001_012",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "工作人員們",
    "words": "感恩！",
    "voice": "vo_adv_1180001_013",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "工作人員們",
    "words": "\\n抱歉借過──！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……",
    "voice": "vo_adv_1180001_014",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……唉……",
    "voice": "vo_adv_1180001_015",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……剛才他們搬的是……",
    "voice": "vo_adv_1180001_016",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n克蕾琪塔之塔",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "裡的水晶吊燈吧……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "正確來說，",
    "voice": "vo_adv_1180001_017",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "是水晶吊燈的殘骸。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "不用特地糾正我的用詞啦！",
    "voice": "vo_adv_1180001_018",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……唉……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "克蕾琪塔之塔……",
    "voice": "vo_adv_1180001_019",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "克蕾琪塔之塔……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "總共傾注了10億盧幣建造費，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我心心念念的新公會小屋啊……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "啊啊，",
    "voice": "vo_adv_1180001_020",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "真是的……！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n為什麼會變成現在這樣！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "那個臭小鬼，",
    "voice": "vo_adv_1180001_021",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "真是不可饒恕！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n他好像是什麼【憤怒‧軍團】對吧！？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n還有那個，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "超級胡來的公主殿下一行人！！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "呃……",
    "voice": "vo_adv_1180001_022",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n不只【憤怒‧軍團】，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "您連尤絲蒂亞娜陛下也要怪罪嗎？",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "是呀，",
    "voice": "vo_adv_1180001_023",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "沒錯！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n沒錯沒錯沒錯！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "妳仔細想想看？",
    "voice": "vo_adv_1180001_024",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "正因為王宮負責的警備體制沒有徹底做好，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n才會讓那種慘無人道的恐怖攻擊有機得逞吧！？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "這已經可以說是",
    "voice": "vo_adv_1180001_025",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "國家執政不力了吧！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n換句話說，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "完全就是那個公主殿下的責任呀！！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n真是令人氣憤哪，不可原諒！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "……",
    "voice": "vo_adv_1180001_026",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "維持國家治安的中心──",
    "voice": "vo_adv_1180001_027",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "【王宮騎士團】被冒牌尤絲蒂亞娜給利用，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n並且在經歷對其的鎮壓戰後戰力大幅削弱……",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "但在約兩個月前，",
    "voice": "vo_adv_1180001_028",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "【王宮騎士團】原本打算擴增軍備，\\n最後該項預算卻遭到削減。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n我記得這可是豪紳議長",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "和克蕾琪塔小姐您所下的決定哪。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "唔唔",
    "voice": "vo_adv_1180001_029",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n那、",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "那是……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我、",
    "voice": "vo_adv_1180001_030",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我也只不過是，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n遵照議長的命令作帳而已！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n我可不想聽妳說什麼",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "因果報應之類的字眼喔！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "總～而～言～之！！",
    "voice": "vo_adv_1180001_031",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n不找個機會給那個公主殿下一點顏色瞧瞧，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n我不甘心！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "有沒有什麼好點子……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "葛～格～♪",
    "voice": "vo_adv_1180001_032",
    "unit_id": 106414
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n呀哈哈～♪",
    "voice": null,
    "unit_id": 106414
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "嗯嗯？",
    "voice": "vo_adv_1180001_033",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n那是……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "克蕾琪塔小姐？",
    "voice": "vo_adv_1180001_034",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n那邊的人",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "有哪裡令您在意嗎？",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n……看起來只是一對感情很好的兄妹啊。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……之前妳人不在場，",
    "voice": "vo_adv_1180001_035",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n所以可能不知道。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n他們就是我剛提到的",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "「超級胡來公主一行人」成員。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……唉，",
    "voice": "vo_adv_1180001_036",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "真受不了。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "公主殿下也真是的……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n為什麼要跟那種明顯家教不好的傢伙混在一起呢？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "實在是沒有身為一國之主的自覺哪……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……！",
    "voice": "vo_adv_1180001_037",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "哼、",
    "voice": "vo_adv_1180001_038",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "哼哼哼……！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n我想到～一個好主意了♪",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "給我等一下！",
    "voice": "vo_adv_1180001_039",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n那邊的兩個人！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n快過來這裡！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "嗚～？",
    "voice": "vo_adv_1180001_040",
    "unit_id": 106414
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "哼──",
    "voice": "vo_adv_1180001_041",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "還真就這樣傻傻地",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "跑到我面前來了呀。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n之前你們可給我",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "徹底地大鬧了一場哪。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n本小姐衣服的清潔費，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "可不是筆小數目唷？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "妳～誰～？",
    "voice": "vo_adv_1180001_042",
    "unit_id": 106414
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "啊啊！？",
    "voice": "vo_adv_1180001_043",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n竟然……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "忘了我是誰！？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "……噢……",
    "voice": "vo_adv_1180001_044",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "作業人員",
    "words": "秘書小姐，",
    "voice": "vo_adv_1180001_045",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "作業人員",
    "words": "老闆她怎麼了嗎？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "總之……",
    "voice": "vo_adv_1180001_046",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n不管她應該也沒關係。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "……就當作她是",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "「很想使壞病」發作吧。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "好了，",
    "voice": "vo_adv_1180001_047",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "各位，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n用不著理會那位可悲的雇主。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n努力趕在今天內，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "完成這一區的瓦礫清除工程吧。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "工作人員們",
    "words": "了解──！",
    "voice": "vo_adv_1180001_048",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……呵呵……",
    "voice": "vo_adv_1180001_049",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n沒料到",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "你們竟然會不記得我。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n既然如此……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "聽好囉，",
    "voice": "vo_adv_1180001_050",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "你們兩個？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n我要特別告訴",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "你們一個……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "可以發大財的好消息唷。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n要不要一起加入呀？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "發……？",
    "voice": "vo_adv_1180001_051",
    "unit_id": 106414
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "唔",
    "voice": "vo_adv_1180001_052",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n搞、搞什麼，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "竟都露出一臉茫然的表情！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "該不會，",
    "voice": "vo_adv_1180001_053",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "得把話講得更簡單一點，他們才聽得懂……？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "那麼……！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "要是幫我的忙，",
    "voice": "vo_adv_1180001_054",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "就給你們零用錢喔！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n有聽懂嗎？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "可以拿錢喔，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "錢‧",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "錢",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "錢錢～？",
    "voice": "vo_adv_1180001_055",
    "unit_id": 106414
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "呵呵……",
    "voice": "vo_adv_1180001_056",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "「錢很重要」",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "嗎。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n確實，這觀念非常正確。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "沒錯。",
    "voice": "vo_adv_1180001_057",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n人為了錢，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "什麼都肯做。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n……欺騙、",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "背叛、",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "甚至是骯髒事……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "所以說呢！",
    "voice": "vo_adv_1180001_058",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n我要出錢",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "跟你們買！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n買公主殿下的祕密！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "佩可的～？",
    "voice": "vo_adv_1180001_059",
    "unit_id": 106414
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "沒錯，",
    "voice": "vo_adv_1180001_060",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "就是這樣！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n僅公主殿下身邊的人才有機會得知的那些缺點！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "弱點！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "壞毛病！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "而我願意花大筆錢",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "買這個情報！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "嗯～嗯……",
    "voice": "vo_adv_1180001_061",
    "unit_id": 106414
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "吃很多～很多～！",
    "voice": "vo_adv_1180001_062",
    "unit_id": 106414
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "哈！",
    "voice": "vo_adv_1180001_063",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "這件事我早就明白得很了。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……要是她能夠稍微克制點，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n王宮的恩格爾係數也能獲得些改善……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "還有呢？",
    "voice": "vo_adv_1180001_064",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n我先說清楚，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "如果是那種我早就知道的資訊，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n可是換不到報酬的喔。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "唔嗯……",
    "voice": "vo_adv_1180001_065",
    "unit_id": 106414
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "一、",
    "voice": "vo_adv_1180001_066",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "一百個！？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "雖然早就知道公主殿下吃很多，",
    "voice": "vo_adv_1180001_067",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n但這未免也太多了吧……！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "如此的量，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "是要怎麼塞進那身軀裡……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "不對！",
    "voice": "vo_adv_1180001_068",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n總、",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "總之不是這種的！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n我要的是更……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "更派得上用場的情報，快說！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "嗯……",
    "voice": "vo_adv_1180001_069",
    "unit_id": 106414
  },
  {
    "type": "dialogue",
