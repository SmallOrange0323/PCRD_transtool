    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "突老～？",
    "voice": "vo_adv_1180001_074",
    "unit_id": 106414
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……我已經問夠了。",
    "voice": "vo_adv_1180001_075",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "好啦，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "你們可以走了。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "掰掰～！",
