    "name": "秘書",
    "words": "是的。",
    "voice": "vo_adv_1180001_086",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n狀況很順利。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "那很好。",
    "voice": "vo_adv_1180001_087",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "既然如此，",
