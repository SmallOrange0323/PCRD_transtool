[
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "那個……我很困擾。",
    "voice": "vo_adv_1018005_000",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "搭訕男子",
    "words": "有什麼關係？",
    "voice": "vo_adv_1018005_001",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "搭訕男子",
    "words": "\\n妳一個人吧？",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "搭訕男子",
    "words": "\\n",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "搭訕男子",
    "words": "和我一起去玩吧。",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "搭訕男子",
    "words": "其實妳很希望男生來約妳吧？",
    "voice": "vo_adv_1018005_002",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "搭訕男子",
    "words": "\\n",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "搭訕男子",
    "words": "打扮成這樣～",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "（誰、誰來救救我～！）",
    "voice": "vo_adv_1018005_003",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "咦？　{0}？",
    "voice": "vo_adv_1018005_004",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "搭訕男子",
    "words": "搞什麼啊你？",
    "voice": "vo_adv_1018005_005",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "搭訕男子",
    "words": "\\n少管閒事。",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "搭訕男子",
    "words": "\\n你是這女孩的朋友嗎？",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "戀、",
    "voice": "vo_adv_1018005_006",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "戀人！？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "搭訕男子",
    "words": "是你的女友，所以不要亂約？",
    "voice": "vo_adv_1018005_007",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "搭訕男子",
    "words": "\\n",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "搭訕男子",
    "words": "可是很可疑呢。",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "搭訕男子",
    "words": "\\n你們真的是戀人關係嗎？",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "欸、",
    "voice": "vo_adv_1018005_008",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "欸欸！？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n為什麼說我們是戀人――",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "欸……讓他誤會比較好？",
    "voice": "vo_adv_1018005_009",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "的、的確是……",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "對啊！",
    "voice": "vo_adv_1018005_010",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我們是……",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "戀、戀、戀人喔！",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "搭訕男子",
    "words": "……好像在說謊。",
    "voice": "vo_adv_1018005_011",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "怎、",
    "voice": "vo_adv_1018005_012",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "怎麼辦……",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n他不相信耶……",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "也、也對！",
    "voice": "vo_adv_1018005_013",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "可是……像戀人的事是什麼呀？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n我沒有談過戀愛……",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "欸……少女漫畫的話……",
    "voice": "vo_adv_1018005_014",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n好像有什麼『壁咚』的？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "喂，快點『壁咚』！",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "搭訕男子",
    "words": "哇！ ",
    "voice": "vo_adv_1018005_015",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "搭訕男子",
    "words": "要做什麼啊！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "不、不是對他，",
    "voice": "vo_adv_1018005_016",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "是對我做呀！",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "也、也對！",
    "voice": "vo_adv_1018005_017",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "可是戀人之間都說些什麼呀……？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "欸……少女漫畫的話……",
    "voice": "vo_adv_1018005_018",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "告、告白之類的嗎……？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n像是「我喜歡妳！」？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "可、可是、我、我沒有被那麼說過……！",
    "voice": "vo_adv_1018005_019",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "雖然一直很憧憬……",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "如、如果你對我說的話……",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "……欸？已經是戀人了，告白很奇怪？",
    "voice": "vo_adv_1018005_020",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "對、對喔！已經在交往了，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n這樣順序會顛倒呢！",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "嗯～該怎麼辦才好呢……",
    "voice": "vo_adv_1018005_021",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n真難呢。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "喂！",
    "voice": "vo_adv_1018005_022",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n都只有我在認真想……",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n你也要一起想！",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "你想和戀人做哪些事情呢？",
    "voice": "vo_adv_1018005_023",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "……不知道？",
    "voice": "vo_adv_1018005_024",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "嗯～看來不只是念書，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n也得教你各種事情才行呢。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "像是少女漫畫、戀愛小說……",
    "voice": "vo_adv_1018005_025",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "下次我會帶很多來給你的！",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "搭訕男子",
    "words": "喂、喂！",
    "voice": "vo_adv_1018005_026",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "搭訕男子",
    "words": "\\n竟然無視我的存在，兩個人聊起來了！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "啊，抱歉。",
    "voice": "vo_adv_1018005_027",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "和他聊天很開心，一不小心就……",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "搭訕男子",
    "words": "可惡……",
    "voice": "vo_adv_1018005_028",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "搭訕男子",
    "words": "\\n在那裡打情罵俏！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "搭訕男子",
    "words": "\\n",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "搭訕男子",
    "words": "竟然真的是戀人……",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "呼，太好了～",
    "voice": "vo_adv_1018005_029",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "總算讓他相信了呢。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "欸？為什麼你要道歉呀？",
    "voice": "vo_adv_1018005_030",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n因為你說我們是戀人？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "你不需要道歉呀。",
    "voice": "vo_adv_1018005_031",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n我很開心你來幫我。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "而且你說我們是戀人……",
    "voice": "vo_adv_1018005_032",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "沒、沒事！什麼事也沒有！",
    "voice": "vo_adv_1018005_033",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "謝謝你的幫忙。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "又讓你救了我，",
    "voice": "vo_adv_1018005_034",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n得要好好答謝才行。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "啊！那裡有一間很好吃的蛋糕店！",
    "voice": "vo_adv_1018005_035",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "一起去吧！",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n我請你吃！\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "這……好像約會耶。",
    "voice": "vo_adv_1018005_036",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "呵呵呵，好期待喔♪",
    "voice": null,
    "unit_id": 101811
  }
]
