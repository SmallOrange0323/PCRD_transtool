[
  {
    "type": "background",
    "bg_id": "509040"
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "騎士先生……",
    "voice": "vo_adv_9500090_000",
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "真",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "的嗎？",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n你說",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "想跟我締結特別的羈絆……",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n你真的",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "這麼想嗎……？",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "啊啊……",
    "voice": "vo_adv_9500090_001",
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "怎麼會這樣……！",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n沒想到這件事竟是真的……",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "簡直",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "就像是做夢一樣……！",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "騎士先生。",
    "voice": "vo_adv_9500090_002",
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "我……",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n一直",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "傾慕著您。",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "一開始，",
    "voice": "vo_adv_9500090_003",
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "是那對為夥伴著想的真摯眼眸。",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "然後，",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "是不顧危險，",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "想要幫助我。",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "你鼓勵",
    "voice": "vo_adv_9500090_004",
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "無法完全駕馭力量的我。",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "不光如此──",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "還包容了",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "當時內心脆弱的我。",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "「一點都不醜陋」……",
    "voice": "vo_adv_9500090_005",
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "你當時的話",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "不知拯救了我多少。",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "騎士先生",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "一定沒察覺到吧。",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "我過去其實",
    "voice": "vo_adv_9500090_006",
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "總感到不安。",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n像我這樣的人，",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "或許不適合站在你身側。",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n會覺得只要在遠處想著",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "身在光明世界下的你，",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "就很幸福了、",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "這樣。",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "但是……",
    "voice": "vo_adv_9500090_007",
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n既然你想著我，",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "我便",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "沒有什麼好怕的了。",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "即使生死",
    "voice": "vo_adv_9500090_008",
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "在哪天分開我們兩人，",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n我也想",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "跟你一起活下去──",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "讓這條命繼續延續下去。",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "我可以",
    "voice": "vo_adv_9500090_009",
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "祈求，",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "你的心",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "永遠屬於我嗎？",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "謝謝你……！",
    "voice": "vo_adv_9500090_010",
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "……沒想到經過漫長歲月，",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "還能遇見如此理想的人。",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "我是",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "多麼幸運啊。",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "我們走吧，",
    "voice": "vo_adv_9500090_011",
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "騎士先生。",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n今後的未來，",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "也要手牽手共行。",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "為了能一同",
    "voice": null,
    "unit_id": 133141
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "邁向永遠……",
    "voice": null,
    "unit_id": 133141
  }
]
