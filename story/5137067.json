[
  {
    "type": "background",
    "bg_id": "500520"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}一行人前往厄莉絲的所在之處。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n為了節省時間，他們乘著志那都所操控的風來進行移動。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "哇啊～！",
    "voice": "vo_adv_5137067_000",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n好厲害喔，大家！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n我們",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "正在天上飛耶！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "日和，",
    "voice": "vo_adv_5137067_001",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這樣很危險，不要亂動。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "優衣，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "手再握緊一點也沒關係喔。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "嗯、",
    "voice": "vo_adv_5137067_002",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "嗯！",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……怜。",
    "voice": "vo_adv_5137067_003",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n妳要好好記住這陣風的感覺。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n這對之後的修行會有幫助。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "不愧是志那都！",
    "voice": "vo_adv_5137067_004",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n連這種時候都不忘修行呢♪",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "大家，",
    "voice": "vo_adv_5137067_005",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不要慌張，保持冷靜！",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n只要不亂動就不會有問題的。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這句話從菲歐口中說出來",
    "voice": "vo_adv_5137067_006",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "感覺好有說服力呢……！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不過……",
    "voice": "vo_adv_5137067_007",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "為什麼不用傳送水晶呢？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n如果用那個，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "就能更輕鬆地移動了不是嗎？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……因為我們並不知道厄莉絲的確切位置。",
    "voice": "vo_adv_5137067_008",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n而且",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "傳送水晶的數量也有限。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n要是優衣每次探測都使用的話，",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "馬上就會用盡。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "早知道這樣，",
    "voice": "vo_adv_5137067_009",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "我就帶一些過來了～",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n因為我平常都沒在用，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "所以完全忘記有這東西存在了。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……咦？",
    "voice": "vo_adv_5137067_010",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n騎士先生，",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "你的臉色",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "看起來有點差耶……？",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是暈風了嗎！？",
    "voice": "vo_adv_5137067_011",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n志那都，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "先休息一下！",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我們休息一下吧！",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "我知道了。",
    "voice": "vo_adv_5137067_012",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "這樣啊……",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "因為我操控得不夠好…………",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "唉……",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "啊哈哈，",
    "voice": "vo_adv_5137067_013",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "要每天精進自己呢。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n有能夠鍛鍊的地方是好事喔♪",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "background",
    "bg_id": "500540"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就這樣穿插著適當的休息，以及優衣的探測……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n一行人來到了泰美斯銀嶺。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "日和、埃拉",
    "words": "哈啾！",
    "voice": "vo_adv_5137067_014",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "呵呵，",
    "voice": "vo_adv_5137067_015",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "這裡很冷呢。",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n手指",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "要變冰了……",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "呼……",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "確實是遠離人煙的地方呢。",
    "voice": "vo_adv_5137067_016",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n厄莉絲就在這裡嗎？",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "嗯。",
    "voice": "vo_adv_5137067_017",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n雖然還要再調查看看才能確定……",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "但這裡所散發出來的存在感，",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "是目前為止最強烈的。",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}對於前往「背面世界」的洞窟做了說明……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "那麼，",
    "voice": "vo_adv_5137067_018",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "從這裡就可以前往「背面世界」囉！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "還真是湊巧耶？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "甚至連往返蘭德索爾的魔法陣都有……",
    "voice": "vo_adv_5137067_019",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "真想早點知道呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這也沒辦法呢。",
    "voice": "vo_adv_5137067_020",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不過，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "會有這種巧合嗎……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "「背面世界」啊……",
    "voice": "vo_adv_5137067_021",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n我沒聽過耶。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n志那都有聽過嗎？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……沒有，",
    "voice": "vo_adv_5137067_022",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "我是第一次聽到。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "「這個世界」",
    "voice": "vo_adv_5137067_023",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "是所有世界的基礎。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n我跟埃拉的世界是以這裡來創造的。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……正因如此，",
    "voice": "vo_adv_5137067_024",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "正因為是基礎，",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "所以也留下了世界被創造出來的",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n過程資訊，可以這麼說吧。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "在「模擬實驗」中被視為不必要的東西，",
    "voice": "vo_adv_5137067_025",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "就存在於這裡。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……果然，",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "這個世界真是深不可測啊。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "本來要是時間允許，",
    "voice": "vo_adv_5137067_026",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "我會想調查得更仔細──",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……",
    "voice": "vo_adv_5137067_027",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "剛才，",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "丟雪球過來的是誰……？",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "不知道耶～？",
    "voice": "vo_adv_5137067_028",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "會是誰呢～？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "這樣啊，",
    "voice": "vo_adv_5137067_029",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "是埃拉吧。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "完全沒有一點猶豫！？",
    "voice": "vo_adv_5137067_030",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n雖然是猜對了啦！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "因為，",
    "voice": "vo_adv_5137067_031",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "這裡可是有這麼多的雪耶？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n這樣不打一場雪仗就太失禮了！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "是對誰失禮……",
    "voice": "vo_adv_5137067_032",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "啊，",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "對雪嗎。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……埃拉說的話，",
    "voice": "vo_adv_5137067_033",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我也有點能體會。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "總",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "覺得這雪……",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "就讓人很想摸摸看對吧？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "畢竟雪又冰涼又美麗呢。",
    "voice": "vo_adv_5137067_034",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "如果要打雪仗，",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "就有點可怕了……",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "不過玩玩雪倒是可以。",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……志那都，",
    "voice": "vo_adv_5137067_035",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n大家都這麼說了，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就稍微玩一下吧？",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "連怜都這樣……",
    "voice": "vo_adv_5137067_036",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這不是很好嗎？",
    "voice": "vo_adv_5137067_037",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n接下來應該又會變得很忙，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "就當作是留下最後的回憶。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "留下回憶……",
    "voice": "vo_adv_5137067_038",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "嗎……",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "雖然一起戰鬥也是一種回憶啦。",
    "voice": "vo_adv_5137067_039",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "不過增加一些悠～閒的回憶也不錯吧？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "所以說，",
    "voice": "vo_adv_5137067_040",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "好嘛？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "…………",
    "voice": "vo_adv_5137067_041",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "只能一下下喔。",
    "voice": "vo_adv_5137067_042",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "就是要這樣才對♪",
    "voice": "vo_adv_5137067_043",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "好──",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "首先來打雪仗吧──！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n想參戰的人舉手～？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "在那之前，",
    "voice": "vo_adv_5137067_044",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "埃拉，",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n我要先回敬妳剛剛的雪球。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "等等，",
    "voice": "vo_adv_5137067_045",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "志那都！？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "用風來做雪球太犯規了！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n是說，根本沒變成球啊！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "就只是個龍捲風而已啊！？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "看我的。",
    "voice": "vo_adv_5137067_046",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "嘴上毫無感情地說著，還同時捲起一股好強的風──！？",
    "voice": "vo_adv_5137067_047",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "快、",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "快逃啊～！！！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……呵呵。",
    "voice": "vo_adv_5137067_048",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就這樣，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n一行人休息了一下後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n便繼續前往厄莉絲的所在之處……",
    "voice": null,
    "unit_id": null
  }
]
