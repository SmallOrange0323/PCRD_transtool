    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n人家當然也是會緊張的呀～！",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "想著「一定要加油──」",
    "voice": "vo_adv_1179001_056",
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "但卻努力過頭時，",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n就會有種一個人空轉，",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "怎麼做都不順利的感覺對吧？",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "在這種時候，",
    "voice": "vo_adv_1179001_057",
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "稍微休息一下對人家來說超──級重要的～",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "這麼做之後",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "通常就會覺得順利多了！",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "而且",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "妳要是有煩惱之類的，",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家，",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "隨時都可以聽妳說喔！",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "……嗯，",
    "voice": "vo_adv_1179001_058",
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "這種感覺如何呢？",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "後輩",
    "words": "哇啊……",
    "voice": "vo_adv_1179001_059",
    "unit_id": 1214
  },
  {
    "type": "dialogue",
    "name": "後輩",
    "words": "超級可愛的！",
    "voice": null,
    "unit_id": 1214
  },
  {
    "type": "dialogue",
    "name": "後輩",
    "words": "\\n而且也很有整體感……！",
    "voice": null,
    "unit_id": 1214
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家想說這麼一來，",
    "voice": "vo_adv_1179001_060",
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "留下的一點破損處看起來也像是一種特色。",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "啊哈哈，",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "時間很趕讓人家真的超著急的～",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "後輩",
    "words": "非常謝謝妳，",
    "voice": "vo_adv_1179001_061",
    "unit_id": 1214
  },
  {
    "type": "dialogue",
    "name": "後輩",
    "words": "鈴奈前輩。",
    "voice": null,
    "unit_id": 1214
  },
  {
    "type": "dialogue",
    "name": "後輩",
    "words": "\\n我",
    "voice": null,
    "unit_id": 1214
  },
  {
    "type": "dialogue",
    "name": "後輩",
    "words": "這就上場登台！",
    "voice": null,
    "unit_id": 1214
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "嗯！",
    "voice": "vo_adv_1179001_062",
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "讓大家清楚地看看",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n妳最最可愛的模樣吧～！",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "小後輩，",
    "voice": "vo_adv_1179001_063",
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "看她那樣子，應該是沒問題了？",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才，",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "幫了忙",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "真的很謝謝你！",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "剛剛雖然對小後輩說了很帥氣的話，",
    "voice": "vo_adv_1179001_064",
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n但人家也是總是失敗連連呢。",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "也經常",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "受秀才你的幫助。",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "所以，",
    "voice": "vo_adv_1179001_065",
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "即使不能說是報答，",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n但要是有人遇到困難，",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家也想要幫助他。",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "還有，",
    "voice": "vo_adv_1179001_066",
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "雖然同事務所也是原因之一……",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "看著她感覺就好像看到家裡的弟弟一樣，",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "實在無法放下她不管。",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家啊，",
    "voice": "vo_adv_1179001_067",
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "不是對後輩說了",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "轉換心情也很重要嗎？",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "那麼，",
    "voice": "vo_adv_1179001_068",
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "對人家來說，",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n轉換心情最好的方法，",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "你覺得是什麼呢？",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "那就是……",
    "voice": "vo_adv_1179001_069",
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "和秀才一起玩！",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n今天從現在起",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "你一整天都要陪著人家喔，",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "請多指教囉♪",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "鈴奈握住{0}的手，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n以輕快的步伐走向萬聖節的熱鬧大街。",
    "voice": null,
    "unit_id": null
  }
]
