  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}與班比為了尋找貝斯的下落，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在城鎮周邊搜索。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "僕從──？",
    "voice": "vo_adv_1223002_000",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n你那邊有找到貝斯嗎──？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "……沒有啊。",
    "voice": "vo_adv_1223002_001",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "跟你說喔，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比和貝斯到城鎮入口處都還在一起的。",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "但人實在太多，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "推擠之下，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "就走散了……",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "咦？",
    "voice": "vo_adv_1223002_002",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n在那裡的是……",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "女性精靈族",
    "words": "………………",
    "voice": "vo_adv_1223002_003",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "吶吶！",
    "voice": "vo_adv_1223002_004",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "那個女生，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "是精靈族對吧！？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n真漂亮呢……",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "是第一次看到精靈族。",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "嗯！",
    "voice": "vo_adv_1223002_005",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "不過，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "不只是精靈族唷。",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n在這之前，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比也沒看過人族和獸人呀。",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "就連收僕從也是，",
    "voice": "vo_adv_1223002_006",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "{0}是第一個♪",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "吶吶！",
    "voice": "vo_adv_1223002_007",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "僕從你呀，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n成為班比的僕從開心嗎？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "光榮？",
    "voice": "vo_adv_1223002_008",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "那是開心的意思嗎？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "嘿嘿，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比也覺得很光榮唷♪",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "真是的，",
    "voice": "vo_adv_1223002_009",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "這時候，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "你要說開心才對呀！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "你不說，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比就咬你唷？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "……嗯嗯？",
    "voice": "vo_adv_1223002_010",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n這個感覺……",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "有人往這裡來了。",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "呼……",
    "voice": "vo_adv_1223002_011",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "呼……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "找、",
    "voice": "vo_adv_1223002_012",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "找到了！！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身因為在意同族的氣息而試著找來，結果……",
    "voice": "vo_adv_1223002_013",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "{0}！！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你有搞清楚狀況嗎！？",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你身邊的人……",
    "voice": "vo_adv_1223002_014",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n跟妾身一樣是吸血鬼啊！！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "竟然說你有猜到！？",
    "voice": "vo_adv_1223002_015",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n都已經有妾身了，你竟然──！！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你這呆板的語氣是什麼意思！",
    "voice": "vo_adv_1223002_016",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n喂！你！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不准撇開視線！！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你，",
    "voice": "vo_adv_1223002_017",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "應該還沒成為真的眷屬……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你們還沒締結需要交換彼此血液的「羈絆契約」吧！？",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "明明連和妾身都還沒有締結到那一步的契約！",
    "voice": "vo_adv_1223002_018",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n讓妾身看看你的脖子！！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "那個～？",
    "voice": "vo_adv_1223002_019",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "這孩子，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "是誰～？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n是僕從認識的人嗎？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身名為",
    "voice": "vo_adv_1223002_020",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "伊莉亞‧奧恩斯坦！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n是傳說的吸血鬼，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "統御黑夜之人！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "吸血鬼？",
    "voice": "vo_adv_1223002_021",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "和班比一樣嗎！？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "哇──♪",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "請多指教囉，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "伊莉亞！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "唉唉！",
    "voice": "vo_adv_1223002_022",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "別黏上來！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身可不是小孩子啊！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n現在是有些理由才會變這副模樣，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "真正的模樣是──",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯嗯？",
    "voice": "vo_adv_1223002_023",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妳的魔力……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n妳難道是真祖譜系的繼承者嗎！？",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "…………也就是說，",
    "voice": "vo_adv_1223002_024",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n或許未來會擁有可與妾身匹敵的力量，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "是稀有的存在！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "可能因為妳還是個孩子，不懂事，",
    "voice": "vo_adv_1223002_025",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身就趁此機會跟妳說明白！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "聽好了？",
    "voice": "vo_adv_1223002_026",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這個人是妾身的頭號眷屬！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n奪走別人的眷屬是不合規矩的！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "是這樣嗎？",
    "voice": "vo_adv_1223002_027",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "別說這個了伊莉亞，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "妳有沒有看到貝斯？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "貝斯？",
    "voice": "vo_adv_1223002_028",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "那是誰？",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n妳在找誰嗎？",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……不對吧！",
    "voice": "vo_adv_1223002_029",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身說的話妳要──",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "嗯……",
    "voice": "vo_adv_1223002_030",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n牠到底是",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "跑到哪裡去了呢……？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "…………根本沒在聽。",
    "voice": "vo_adv_1223002_031",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "現在的年輕吸血鬼真的是……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "喂。{0}。",
    "voice": "vo_adv_1223002_032",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n你代替她說明一下吧……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……原來如此。",
    "voice": "vo_adv_1223002_033",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "那麼妾身",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "也不是不能幫忙尋找那隻貝斯。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "真的嗎──！？",
    "voice": "vo_adv_1223002_034",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n伊莉亞",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "妳真溫柔──！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身幫妳可不是基於好意。",
    "voice": "vo_adv_1223002_035",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n只是想早點解決問題而已。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "照理說，",
    "voice": "vo_adv_1223002_036",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "真祖的血緣關係者，會如寶物般被藏匿起來，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n在血族的守護下生活。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……公主殿下離家出走，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "應該會引起大騷動才是。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "離家出走？",
    "voice": "vo_adv_1223002_037",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n班比",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "沒有離家出走唷──？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "說起來班比，",
    "voice": "vo_adv_1223002_038",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n根本不曉得自己",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "為什麼會在外面……",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……那是什麼意思？",
    "voice": "vo_adv_1223002_039",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "嗯……",
    "voice": "vo_adv_1223002_040",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比呀，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "原本是在家和貝斯一起沉睡的。",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "但貝斯硬把班比叫起來……",
    "voice": "vo_adv_1223002_041",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "那時班比已經",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "在不認識的叔叔們的馬車上了。",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "然、",
    "voice": "vo_adv_1223002_042",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "然後呢！？",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "因為貝斯說「一定要逃走」，",
    "voice": "vo_adv_1223002_043",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "所以班比跟貝斯就偷偷溜出馬車了唷。",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "本來想直接回家的……",
    "voice": "vo_adv_1223002_044",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "可是班比",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "不認得路……",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "於是貝斯就說了「去鎮上吧」，",
    "voice": "vo_adv_1223002_045",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n牠說「只要到那裡，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "一定能找到願意幫忙的人」。",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "然後班比就在城鎮入口處和貝斯走散了……",
    "voice": "vo_adv_1223002_046",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "正在找牠時就遇見了僕從♪",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "………咦？",
    "voice": "vo_adv_1223002_047",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "你們兩個",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "怎麼了？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妳、",
    "voice": "vo_adv_1223002_048",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妳這笨蛋！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n妳啊，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這是被綁架了，竟然還這麼悠哉！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……妳沒被怎麼樣吧？",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "被怎麼樣……？",
    "voice": "vo_adv_1223002_049",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "完全沒有唷！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n畢竟班比可是最強的～♪",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……現在不是跟這孩子爭論的時候了。",
    "voice": "vo_adv_1223002_050",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身還是",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "也來幫忙找貝斯吧。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n找到牠後，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妳就找到自己的領地回去。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "嗯！",
    "voice": "vo_adv_1223002_051",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n謝謝妳，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "伊莉亞！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "找到貝斯後，",
    "voice": "vo_adv_1223002_052",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比就請你們兩人喝湯！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比會煮得很好喝的，要期待唷！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n……",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "嘿嘿～♪",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "喂、",
    "voice": "vo_adv_1223002_053",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "喂！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妳在向那傢伙撒什麼嬌啊！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n都說了他是妾身的眷屬了！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "不對唷──",
    "voice": "vo_adv_1223002_054",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n是班比的僕從才對唷？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "是妾身的眷屬！！！！",
    "voice": "vo_adv_1223002_055",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "僕從喜歡什麼樣的湯？",
    "voice": "vo_adv_1223002_056",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n班比呀……",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "稍微聽一下長輩的話啊──！！",
    "voice": "vo_adv_1223002_057",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "然而班比依舊我行我素，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n伊莉亞最後讓了步，大大地嘆了口氣。",
    "voice": null,
    "unit_id": null
  }
]
