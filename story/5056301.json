  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "非常新鮮又活蹦亂跳的！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "光看就讓人肚子餓了起來！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "太讚了吧☆",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "真虧妳在這種危機之中",
    "voice": "vo_adv_5056301_001",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "還湧現得出食慾耶……！？",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "即使我們被吃掉也不奇怪，",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n妳要當心啊……！",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "巨大的魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 14312
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "噫！？",
    "voice": "vo_adv_5056301_002",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "牠、",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "牠感覺",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好像很生氣！",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "喂，貪吃佩可，",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n是不是牠感受到妳想吃人家啦！？",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……看來似乎很難直接釣起來，",
    "voice": "vo_adv_5056301_003",
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "唯有戰鬥一途了。",
