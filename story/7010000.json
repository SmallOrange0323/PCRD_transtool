  {
    "type": "dialogue",
    "name": "旁白",
    "words": "通往露娜之塔途中的祠堂，有一對男女的身影。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n女性將一隻手，伸向男性的頭上——",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "雖然路程有點遠，",
    "voice": "vo_adv_7010000_000",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "但還是努力走過來了呢。",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "好孩子好孩子～",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "話說回來，",
    "voice": "vo_adv_7010000_001",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "真是個不可思議的地方呢。",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "這裡生長的植物們，",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "和精靈族之村完全不同呢～",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀？　",
    "voice": "vo_adv_7010000_002",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "是誰在這種地方呢？",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "嗯啊～！　",
    "voice": "vo_adv_7010000_003",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "好癢喔～！",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "……啊！　",
    "voice": "vo_adv_7010000_004",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "{0}，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "來得正好！",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "葉子掉進了衣服裡……",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "能幫我拿出來嗎？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "啊！　",
    "voice": "vo_adv_7010000_005",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "不是那裡啦～",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n好像掉進了更深的地方。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "還有，",
    "voice": "vo_adv_7010000_006",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "你的手也弄得我癢的受不了啦！",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n快點拿出來～！",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀哎呀哎呀～",
    "voice": "vo_adv_7010000_007",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "晴朗的天氣，",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "在這樣的森林裡～",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "太好了～",
    "voice": "vo_adv_7010000_008",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "好像拿出來了呢。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "謝謝你！",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n……",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "話說回來，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "你為什麼會在這裡呢？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "那位是？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "初次見面，",
    "voice": "vo_adv_7010000_009",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我是",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "在精靈族之村擔任幼教老師的美里。",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "聽說",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "這裡有與他的記憶相關的線索，",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n散步時順便繞過來的～",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "哎呀，",
    "voice": "vo_adv_7010000_010",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "原來如此呢！",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "這裡居然是那樣的地方……",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我是",
    "voice": "vo_adv_7010000_011",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "在【月光學院】擔任教師的伊緒。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "是{0}的導師。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "今天是",
    "voice": "vo_adv_7010000_012",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "為了尋找適合校外教學的場地。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "說來慚愧，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "因為途中迷了路",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "所以才到了這裡……",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "總感覺，",
    "voice": "vo_adv_7010000_013",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "這裡看起來是十分古老的建築物，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "或許正好能作為歷史課的教材。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "美里老師，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "能讓我也一起行動嗎？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "不只為了校外教學，",
    "voice": "vo_adv_7010000_014",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "也為了{0}，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n作為老師",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我也想幫上一些忙……",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "當然沒問題～",
    "voice": "vo_adv_7010000_015",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n對{0}來說，",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "導護的老師有兩位的話，",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "心裡也會更踏實吧。",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "……？　",
    "voice": "vo_adv_7010000_016",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "有兩位老師是…",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "美里老師是幼教老師對吧？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n為什麼會是{0}的老師呢？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "他在村子的幼稚園裡，",
    "voice": "vo_adv_7010000_017",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "和其他的孩子一起",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "被我照顧的呦～",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "因為是最年長的哥哥，",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n不用我費太多心力，",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "是個非常好的孩子呢～",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "咦？　",
    "voice": "vo_adv_7010000_018",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "也在幼稚園上學嗎？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "{0}，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "你今年是幾歲來著？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "好了，",
    "voice": "vo_adv_7010000_019",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "就別站著閒聊了，",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "先往前進吧～",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "{0}不用擔心任何事呦。",
    "voice": "vo_adv_7010000_020",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "來吧",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "伊緒老師也一起走囉～",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "咦咦～！？　",
    "voice": "vo_adv_7010000_021",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "兩位等等我～！",
    "voice": null,
    "unit_id": 101811
  }
]
