[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "克蘿依放學後，受學院的同學們邀請，\\n列隊走在蘭德索爾的街上，度過了開心短暫的時光。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊，",
    "voice": "vo_adv_1108008_000",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "可麗餅好好吃。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我還有打工，就先到這裡。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊，",
    "voice": "vo_adv_1108008_001",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不是打工，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "是志工呢。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "有酬勞的。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "克蘿依，",
    "voice": "vo_adv_1108008_002",
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "\\n今天謝謝妳陪我們。",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "嗯，",
    "voice": "vo_adv_1108008_003",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n不嫌棄的話，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "再隨時找我。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "我啊，",
    "voice": "vo_adv_1108008_004",
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "\\n今天是我第一次，",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "一邊走路一邊吃東西呢。",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "呵呵，",
    "voice": "vo_adv_1108008_005",
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "\\n如果被父親和老師知道的話",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "應該會被罵吧。",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "\\n",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "這下子我們也成了",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "了不起的不良少女吧？",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不，我也不清楚。",
    "voice": "vo_adv_1108008_006",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "嗯，雖然我不知道，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "但自己覺得怎樣就是怎樣吧。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "好、",
    "voice": "vo_adv_1108008_007",
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "好帥……",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "不顧他人眼光的生存方式，",
    "voice": "vo_adv_1108008_008",
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "簡直就是不良少女啊……",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "所――以說啊，",
    "voice": "vo_adv_1108008_009",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我說了我不是不良少女啊。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "再說這些難聽的話，我就要因為毀謗而揍妳喔。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "啊，",
    "voice": "vo_adv_1108008_010",
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "沒來由的暴力！",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "\\n",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "這才是真正的，",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "不良界的象徵啊！",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "出現了！",
    "voice": "vo_adv_1108008_011",
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "　",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "終於呢！",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "好帥……",
    "voice": "vo_adv_1108008_012",
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生1",
    "words": "太帥了啊……",
    "voice": null,
    "unit_id": 2911
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "甚至",
    "voice": "vo_adv_1108008_013",
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "女學生2",
    "words": "好想被打啊……",
    "voice": null,
    "unit_id": 3111
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "咦――？",
    "voice": "vo_adv_1108008_014",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "　我是不是交錯朋友了",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "background",
    "bg_id": "500050"
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "那麼。",
    "voice": "vo_adv_1108008_015",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n盡情的玩完之後，就盡情的工作吧",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "話說，",
    "voice": "vo_adv_1108008_016",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "照慣例到晚上應該都很閒……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "呼～啊……",
    "voice": "vo_adv_1108008_017",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "對了{0}，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "今天會來嗎……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "哦――",
    "voice": "vo_adv_1108008_018",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "果然……",
    "voice": "vo_adv_1108008_019",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "開始頭暈了。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "最近太忙了，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "一直沒睡飽呢――",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n等等休息時間",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "小睡一下吧――",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "呼啊～呼……",
    "voice": "vo_adv_1108008_020",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "喵啊啊啊！？",
    "voice": "vo_adv_1108008_021",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊，",
    "voice": "vo_adv_1108008_022",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊啊……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "是{0}啊。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我說啊。",
    "voice": "vo_adv_1108008_023",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "就是啊。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n不要在我毫無防備的瞬間出聲好嗎。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n因為會不小心發出像小貓的喵喵聲。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "話說，",
    "voice": "vo_adv_1108008_024",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "對了，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "你來得正好。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n我，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "一直在等著你來呢。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊啊不，",
    "voice": "vo_adv_1108008_025",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我說的等，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "也不是",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "那個意思啦。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "就是，",
    "voice": "vo_adv_1108008_026",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "之前的事情啊……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n你看，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "之前在這裡快被老師發現打工的時候，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n你不是救了我嗎？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "雖然很感激，多虧了你我才沒被退學，",
    "voice": "vo_adv_1108008_027",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不、",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不過在那之後見不到你，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "沒辦法和你道謝，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "對，",
    "voice": "vo_adv_1108008_028",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "所以……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "嗯？",
    "voice": "vo_adv_1108008_029",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "　咦？　",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "咦，等等。",
    "voice": "vo_adv_1108008_030",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n為什麼我，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "現在有點緊張呢。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "這是什麼……",
    "voice": "vo_adv_1108008_031",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "是錯覺嗎，心臟些許地錯拍，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "也太莫名了。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "咦，騙人的吧，",
    "voice": "vo_adv_1108008_032",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "該不會我…………",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "很在意他？　",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不不，為什麼啊。",
    "voice": "vo_adv_1108008_033",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "無法理解啊。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "總之簡單說聲謝謝，然後回去工作才行。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我說啊。",
    "voice": "vo_adv_1108008_034",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n前陣子的那件事――",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊？",
    "voice": "vo_adv_1108008_035",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "　這道光是怎麼回事？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "哇哇哇，",
    "voice": "vo_adv_1108008_036",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "漸漸擴散開來了，這是什麼……！",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "background",
    "bg_id": "510150"
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "咦，",
    "voice": "vo_adv_1108008_037",
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "{0}。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "什麼，",
    "voice": "vo_adv_1108008_038",
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "怎麼了。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n短期打工不是已經結束了嗎。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "啊啊，",
    "voice": "vo_adv_1108008_039",
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "是以客人身分來的意思吧。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n歡迎光臨",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n我已經要回去了，",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "你慢用――",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "啊，",
    "voice": "vo_adv_1108008_040",
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "嗯……",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "其實就是早退。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "不，今天好像，",
    "voice": "vo_adv_1108008_041",
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "頭有一點點暈暈的。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "沒問題――",
    "voice": "vo_adv_1108008_042",
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n應該說，還是能工作。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "不過不小心說溜嘴的話，",
    "voice": "vo_adv_1108008_043",
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "會讓店長擔心的。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "可能說今天不早退就不給你薪水之類的，",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n這種不知算體貼還是職權騷擾的話。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "啊？",
    "voice": "vo_adv_1108008_044",
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n不，沒關係。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "而且那樣有點噁心。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "不，",
    "voice": "vo_adv_1108008_045",
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "真的沒事。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "這種小問題只是因為沒睡飽。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "因為念書啊打工啊還有家事啊，有點太忙了呢。",
    "voice": "vo_adv_1108008_046",
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n換成大人的講法就是過勞吧？",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n蓋上棉被稍微睡一下就沒事了。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "嗯那麼掰掰，",
    "voice": "vo_adv_1108008_047",
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "先走了。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "剛剛的話題就……",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "嗯，下次，在遊戲裡說就好――",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "哦……",
    "voice": "vo_adv_1108008_048",
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "抱歉，有點暈……",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "好難纏……",
    "voice": "vo_adv_1108008_049",
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "啊討厭，",
    "voice": "vo_adv_1108008_050",
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "我知道了啦。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "隨便你吧。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "background",
    "bg_id": "510360"
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "嗯嗯……！",
    "voice": "vo_adv_1108008_051",
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n這種時候，",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "外面的空氣很有療效呢。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n總覺得在走路的時候，",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "就好很多了唷。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "咦？",
    "voice": "vo_adv_1108008_052",
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "怎、",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "怎麼突然……",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "好噁心。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "咦，而且還一臉正經？",
    "voice": "vo_adv_1108008_053",
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n那什麼直率的眼神……",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "快停下來快停下來，",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "會害羞的啦。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n我其實是個很好攻略的人，所以你能不能停下來。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "話說你是要說那個吧。",
    "voice": "vo_adv_1108008_054",
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n你想說的是「臉色很好看呢」對吧。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "雖然你剛剛只是少了一個字，但意思就完全不同了呢？",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "果然？",
    "voice": "vo_adv_1108008_055",
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "嗯，",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "多虧了你呢",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "腦袋忽然變清醒了。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "噗……",
    "voice": "vo_adv_1108008_056",
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "好，",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "已經沒事了。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n回去煮飯念書好了",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "咦，阿斯特朗？",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "　",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "嗯，",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "今天先不了。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "啊，",
    "voice": "vo_adv_1108008_057",
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "對了。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "你啊，",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "在之前的遊戲裡，",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n叫了我花子對吧。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "可以注意一下嗎。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "我也不是",
    "voice": "vo_adv_1108008_058",
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "不喜歡自己的名字，",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n畢竟是從父母那邊得到的，非常的珍貴。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "只是，",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "該怎麼說，",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "就是……",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "稱呼克蘿依，",
    "voice": "vo_adv_1108008_059",
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "感覺比較帥。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "嗯，就是這樣。",
    "voice": "vo_adv_1108008_060",
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n{0}，今天謝謝你。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n到這裡就行囉，",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "我家就在這附近――",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "――啊。",
    "voice": "vo_adv_1108008_061",
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "弟弟們在玩。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子的弟弟1",
    "words": "啊！",
    "voice": "vo_adv_1108008_062",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "花子的弟弟1",
    "words": "　是姐姐！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "花子的弟弟2",
    "words": "耶～！",
    "voice": "vo_adv_1108008_063",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "花子的弟弟2",
    "words": "　姐姐歡迎回來！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "嗯，",
    "voice": "vo_adv_1108008_064",
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "我回來了。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子的弟弟1",
    "words": "……？",
    "voice": "vo_adv_1108008_065",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "花子的弟弟1",
    "words": "\\n姐姐，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "花子的弟弟1",
    "words": "這個人是誰？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "喂。",
    "voice": "vo_adv_1108008_066",
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n好孩子的話要好好打招呼。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "不，不是在說你。",
    "voice": "vo_adv_1108008_067",
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子的弟弟1",
    "words": "你好！",
    "voice": "vo_adv_1108008_068",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "花子的弟弟1",
    "words": "\\n姐姐平常",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "花子的弟弟1",
    "words": "受你照顧了！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "嗯，",
    "voice": "vo_adv_1108008_069",
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "真要說的話，",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n都是我在照顧他，",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "不過算了。",
