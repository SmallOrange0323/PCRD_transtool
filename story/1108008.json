    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "啊――",
    "voice": "vo_adv_1108008_071",
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "嗯……",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "對，呢……",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "哈哈。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n那麼要玩些什麼好呢？",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子的弟弟2",
    "words": "鬼抓人！",
    "voice": "vo_adv_1108008_072",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "雖然是這樣……",
    "voice": "vo_adv_1108008_073",
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n說的出口嗎？",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "　我真的很難抵抗這種純真的眼神。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n平常也很少陪他們玩……",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "……什麼？",
    "voice": "vo_adv_1108008_074",
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "喵啊啊啊！？",
    "voice": "vo_adv_1108008_075",
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "怎喵突然！？",
    "voice": "vo_adv_1108008_076",
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "你、",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "你在碰哪裡――",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子的弟弟1",
    "words": "哇～！",
    "voice": "vo_adv_1108008_077",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "花子的弟弟1",
    "words": "　怎麼能被你抓住！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "花子的弟弟2",
    "words": "呀，",
    "voice": "vo_adv_1108008_078",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "花子的弟弟2",
    "words": "這裡這裡！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "啊啊，",
    "voice": "vo_adv_1108008_079",
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "那個是……",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n代替我",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "和那些孩子們玩呢。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "嚇了一跳。",
    "voice": "vo_adv_1108008_080",
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n我還以為腦袋終於壞掉了呢。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "哈……",
    "voice": "vo_adv_1108008_081",
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "真好笑。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n那傢伙，",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "還是個大好人呢。",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "still",
    "still_id": "110800801"
  },
  {
    "type": "dialogue",
    "name": "花子的弟弟1",
    "words": "哇，",
    "voice": "vo_adv_1108008_082",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "花子的弟弟1",
    "words": "好狡猾！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "花子的弟弟1",
    "words": "　那個鬼，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "花子的弟弟1",
    "words": "拿起劍了喔！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "花子的弟弟2",
    "words": "也太幼稚了吧！",
    "voice": "vo_adv_1108008_083",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "花子的弟弟2",
    "words": "　那傢伙，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "花子的弟弟2",
    "words": "還真是不妙的傢伙！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "不……",
    "voice": "vo_adv_1108008_084",
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "話說，{0}……",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n根本就超認真的拼命在玩吧……？",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子的弟弟1",
    "words": "可惡！",
    "voice": "vo_adv_1108008_085",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "花子的弟弟1",
    "words": "\\n不會輸給你的唷，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "花子的弟弟1",
    "words": "你這個墮落的黑暗騎士！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "花子的弟弟2",
    "words": "就是啊就是啊！",
    "voice": "vo_adv_1108008_086",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "花子的弟弟2",
    "words": "\\n我們和姐姐那種馬上就被秒掉的超廢女不一樣唷！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "啊？",
    "voice": "vo_adv_1108008_087",
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "　說誰是超廢女，",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "可惡――！",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子的弟弟1",
    "words": "呀啊啊啊！",
    "voice": "vo_adv_1108008_088",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "花子的弟弟1",
    "words": "\\n姐姐變成殭屍復活了！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "花子的弟弟2",
    "words": "呀哈哈哈！",
    "voice": "vo_adv_1108008_089",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "花子的弟弟2",
    "words": "　我們一定可以逃掉的！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "站――住！",
    "voice": "vo_adv_1108008_090",
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "\\n",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "哈哈、",
    "voice": null,
    "unit_id": 110832
  },
  {
    "type": "dialogue",
    "name": "花子",
    "words": "啊哈哈哈！",
    "voice": null,
    "unit_id": 110832
  },
