    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "花子的弟弟2",
    "words": "今天很早呢！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "花子的弟弟2",
    "words": "\\n太好了，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "花子的弟弟2",
    "words": "可以一起玩！",
