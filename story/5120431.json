    "name": "雪",
    "words": "大家有好好享受",
    "voice": "vo_adv_5120431_001",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我的美麗了嗎？",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "時間還很充裕，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "就好好欣賞我",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "直到最後一刻吧♪",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "比起伊莉亞，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我的魅力",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "更應該留下來成為傳說……！",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……吶，",
    "voice": "vo_adv_5120431_002",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "雪啊。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n妾身一直很在意一件事。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "伊莉亞，是什麼事呢？",
    "voice": "vo_adv_5120431_003",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "是我的美麗祕訣？",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "真拿妳沒辦法，我就告訴妳吧。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "總之，",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "妳先空出個幾天的時間來吧。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不是這個！",
    "voice": "vo_adv_5120431_004",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "別自顧自地說下去啊。",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……妳",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "基本上在稱呼別人的時候",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "都會加稱謂吧？",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "嗯，",
    "voice": "vo_adv_5120431_005",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "是啊。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "莫妮卡小姐、",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "妮諾小姐、",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "空花小姐、",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "步未小姐。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "因為我",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "也有留意在用字遣詞上要很優美呀♪",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "那妾身呢？",
    "voice": "vo_adv_5120431_006",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "伊莉亞。",
    "voice": "vo_adv_5120431_007",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "為什麼啊！？",
    "voice": "vo_adv_5120431_008",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n妳這樣",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "實在太奇怪了吧！？",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "究竟為何",
    "voice": "vo_adv_5120431_009",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "只對統御黑夜之人的妾身",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "直呼名字！？",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "話說，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "以前見面的時候，",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妳對妾身是稱伊莉亞小姐吧！",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n為何變了！？",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妳的心境上到底是起了什麼變化！？",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "就算妳這麼問……",
    "voice": "vo_adv_5120431_010",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妳",
    "voice": "vo_adv_5120431_011",
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "果然是瞧不起妾身吧……！？　",
    "voice": null,
    "unit_id": 126211
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "……因為伊莉亞",
    "voice": "vo_adv_5120431_012",
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "跟我差不多美呀。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n我只是覺得競爭對手",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不需要加敬稱啊。",
    "voice": null,
    "unit_id": 126311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……竟然是這樣！",
    "voice": "vo_adv_5120431_013",
    "unit_id": 126211
  }
]
