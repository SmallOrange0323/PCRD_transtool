    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "ハロウィンの定番っていたずらですよね。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "トリックオアトリート、",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "って。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "騎士さんはどんないたずらしてみたいですか？",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "…………いきなりなんですか？",
    "voice": "vo_adv_6050108_001",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "ああ、",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "それがいたずらのつもりだったんですね。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "ずいぶんとかわいらしいいたずらで済ませるんですね。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "ふふっ。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "それ別にハロウィンっぽくないですけど……",
    "voice": "vo_adv_6050108_002",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "よく落ちてるから？",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "\\n騎士さんには猟師の知り合いでもいるんですか？",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "あんまり猟の邪魔しちゃダメですよ。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "それはいたずらされないためにすることですよ。",
    "voice": "vo_adv_6050108_003",
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "はぁ……",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "いたずらするって考えが最初から無いんですね。",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "\\n",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "まったく、",
    "voice": null,
    "unit_id": 113911
  },
  {
    "type": "dialogue",
    "name": "ツムギ",
    "words": "筋金入りのお人よしですね。",
    "voice": null,
    "unit_id": 113911
  }
]
