  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這種敵人",
    "voice": null,
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "最麻煩了啦！！",
    "voice": null,
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
