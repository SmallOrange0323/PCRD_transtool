    "name": "贊恩",
    "words": "喔喔喔喔喔……！！",
    "voice": "vo_adv_9003518_001",
    "unit_id": 191712
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "他的傷勢應該還沒痊癒……",
    "voice": "vo_adv_9003518_002",
    "unit_id": 180511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n卻有如此驚人的氣勢……！",
    "voice": null,
    "unit_id": 180511
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那傢伙是靠著氣勢跟情感在行動的吧！",
