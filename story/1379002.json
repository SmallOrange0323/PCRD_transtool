  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "「他」嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "妳、",
    "voice": "vo_adv_1379002_044",
    "unit_id": 101111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "妳是誰！？",
    "voice": null,
    "unit_id": 101111
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "放心吧，",
    "voice": "vo_adv_1379002_045",
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我不是敵人喔。",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我也",
    "voice": "vo_adv_1379002_046",
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "只是想保護",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "妳的「哥哥」而已。",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "──璃乃？",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "唔……",
    "voice": "vo_adv_1379002_047",
    "unit_id": 101111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "妳為什麼會知道",
    "voice": null,
    "unit_id": 101111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我的名字……！？",
    "voice": null,
    "unit_id": 101111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n不對，",
    "voice": null,
    "unit_id": 101111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "比起這個……",
    "voice": null,
    "unit_id": 101111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "妳認識哥哥？",
    "voice": null,
    "unit_id": 101111
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "嗯。",
    "voice": "vo_adv_1379002_048",
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "但是……",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n這話題現在這聊",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "有點危險。",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n畢竟也不曉得誰會偷聽……",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "更重要的是，",
    "voice": "vo_adv_1379002_049",
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "妳的哥哥──",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n似乎跟我所追求的",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "「世界之謎」有關。",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "「世界之謎」……？",
    "voice": "vo_adv_1379002_050",
    "unit_id": 101111
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "嗯，",
    "voice": "vo_adv_1379002_051",
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我正在尋找它。",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n隱藏在這個世界中的",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "巨大謎團……",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n我也渴求著查清它的夥伴。",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "璃乃，",
    "voice": "vo_adv_1379002_052",
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我現在把自己知道的情報都告訴妳。",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "所以，",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "要不要去個安靜的地方──",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n聊聊",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "妳重要的「哥哥」？",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "這個人",
    "voice": "vo_adv_1379002_053",
    "unit_id": 101111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "不管怎麼看都很可疑……",
    "voice": null,
    "unit_id": 101111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n全身",
    "voice": null,
    "unit_id": 101111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "打扮得紅通通的，又很浮誇。",
    "voice": null,
    "unit_id": 101111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "……不過服裝很適合，",
    "voice": null,
    "unit_id": 101111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "有點帥氣。",
    "voice": null,
    "unit_id": 101111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "但是，",
    "voice": "vo_adv_1379002_054",
    "unit_id": 101111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "她知道我的名字，",
    "voice": null,
    "unit_id": 101111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "也知道哥哥的事……",
    "voice": null,
    "unit_id": 101111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "那麼。",
    "voice": null,
    "unit_id": 101111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n關於現在的哥哥",
    "voice": null,
    "unit_id": 101111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "「失去記憶的理由」，",
    "voice": null,
    "unit_id": 101111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "她是不是也知道什麼？",
    "voice": null,
    "unit_id": 101111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "…………",
    "voice": "vo_adv_1379002_055",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我知道了。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n如果只是一下下、",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "的話……",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我、",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我願意聽。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "可是，",
    "voice": "vo_adv_1379002_056",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "媽媽跟我說過，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n不能跟著不知姓名的人走。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "哦，",
    "voice": "vo_adv_1379002_057",
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "是我失禮了。",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n我還沒報上名字吧──",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "──我名叫",
    "voice": "vo_adv_1379002_058",
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "拉比林斯達。",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n是公會【拉比林斯】的首領……",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n也是試圖解開世界之謎的人。",
    "voice": null,
    "unit_id": 106813
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就這樣，與拉比林斯達相遇的璃乃，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n以公會【拉比林斯】的一員，\\n踏出嶄新的一步──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500560"
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "嗯，",
    "voice": "vo_adv_1379002_059",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "像那樣",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "加入【拉比林斯】後，",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n我其實很常在哥哥沒注意時，",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n暗中守著你喔。",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "呵呵，",
    "voice": "vo_adv_1379002_060",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "因為我非常小心，",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "避免被你發現啊。",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "據說，我跟姐姐過度接觸，",
    "voice": "vo_adv_1379002_061",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n或許會對哥哥失去的記憶有不好的影響，",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "公會長這麼說。",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "所以，",
    "voice": "vo_adv_1379002_062",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "一直都沒辦法當面，",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n跟你說上話……",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "可即便如此，",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我還是一直想著哥哥。",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "因為，",
    "voice": "vo_adv_1379002_063",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "哥哥是我很重要的──",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "哇啊！？",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "嗯，",
    "voice": "vo_adv_1379002_064",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "還好……",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "啊！",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n鞋帶斷了……！",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "嗚嗚……",
    "voice": "vo_adv_1379002_065",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "對不起，",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "哥哥。",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "……話說回來，",
    "voice": "vo_adv_1379002_066",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "之前也",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "發生過這樣的事吧。",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "在我還更小的時候，",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "木屐的鞋帶斷掉。",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "那個時候，",
    "voice": "vo_adv_1379002_067",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "哥哥也實在修不好鞋帶。",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "最終",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "是你背著我回家的。",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "你記得嗎？",
    "voice": "vo_adv_1379002_068",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "你還跟我說",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "「我來背妳，所以別哭！」。",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我非常高興……",
    "voice": "vo_adv_1379002_069",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n直到現在，",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我都還記得你當時的後背。",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "但是，",
    "voice": "vo_adv_1379002_070",
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我現在也成長了不少。",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "這次換我把哥哥",
    "voice": null,
    "unit_id": 137912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "帶到山頂上了喔♪",
    "voice": null,
    "unit_id": 137912
  },
