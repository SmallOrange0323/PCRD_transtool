[
  {
    "type": "background",
    "bg_id": "500040"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "仍帶著一點濕氣的午後。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n可璃亞結束了短暫的假期，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n正準備與{0}一起踏上下一段冒險。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "……嘿",
    "voice": "vo_adv_1353004_000",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "咻。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n這樣就收拾得差不多了。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "……這件泳衣",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "也要留待明年的夏天呢。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "這件充滿了",
    "voice": "vo_adv_1353004_001",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "哥哥相關回憶的泳衣，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "要好好放到櫃子裡收起來。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "……欸，哥哥。",
    "voice": "vo_adv_1353004_002",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n明年的夏天，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我們再一起──",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "background",
    "bg_id": "510171"
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "……唉。",
    "voice": "vo_adv_1353004_003",
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "……對不起，",
    "voice": "vo_adv_1353004_004",
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "奶奶。",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "\\n今年的夏天還是不行呢……",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "──誰來……",
    "voice": "vo_adv_1353004_005",
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "誰來，",
    "voice": "vo_adv_1353004_006",
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "把我從這裡……",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "──咦？",
    "voice": "vo_adv_1353004_007",
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "\\n哥哥！！？",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "什麼妳好……！？",
    "voice": "vo_adv_1353004_008",
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "這裡是禁止進入的，",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "不可以隨便進來……！",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "呼……",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "嚇了我一大跳……",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "所以……",
    "voice": "vo_adv_1353004_009",
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "有什麼事情嗎？",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "……唔！",
    "voice": "vo_adv_1353004_010",
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "……沒、",
    "voice": "vo_adv_1353004_011",
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "沒有那種事，",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "我才沒有",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "一臉寂寞的樣子。",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "\\n是哥哥誤會了吧……？",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "啊……！",
    "voice": "vo_adv_1353004_012",
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "\\n不、",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "不是，",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "這個是……！！",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "……算了。",
    "voice": "vo_adv_1353004_013",
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "\\n什麼事都瞞不了哥哥呢。",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "我知道了……",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "雖然有點害羞，",
    "voice": "vo_adv_1353004_014",
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "不過……",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "這是泳衣。",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "……謝謝誇獎。",
    "voice": "vo_adv_1353004_015",
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "我",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "也這麼覺得……",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "……那個，",
    "voice": "vo_adv_1353004_016",
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "這件泳衣，",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "是奶奶……",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "是祖母送我的禮物。",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "我之前有說過，",
    "voice": "vo_adv_1353004_017",
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "你還記得嗎？",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "祖母是唯一",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "會把我當作普通女孩子看待，",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "\\n我最喜歡的人……",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "但是，",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "她去年",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "出了意外……",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "嗯，",
    "voice": "vo_adv_1353004_018",
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "這部分也有。",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "但……",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "更多的",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "是感到抱歉。",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "……去年夏天，",
    "voice": "vo_adv_1353004_019",
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "祖母找我去海邊。",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "\\n說要一起",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "去海邊旅行",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "過夜。",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "\\n這件泳衣就是她為此",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "買給我的。",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "說是",
    "voice": "vo_adv_1353004_020",
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "在百貨公司為我挑泳衣",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "真的很開心。",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "她看起來非常地高興……",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "但是，",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "\\n我卻沒有",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "穿過這件泳衣。",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "結果那個夏天，",
    "voice": "vo_adv_1353004_021",
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "我們沒辦法去海邊……",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "\\n因為",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "家裡的緣故。",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "……唔……",
    "voice": "vo_adv_1353004_022",
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "我",
    "voice": "vo_adv_1353004_023",
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "早就知道了。",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "我",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "是重要的「聖女大人」……",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "\\n不可能會得到",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "自行外出的許可。",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "所以",
    "voice": "vo_adv_1353004_024",
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "那件事就變成我和奶奶的祕密……",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "但是，",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "\\n小孩子的祕密，",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "根本瞞不過大人……",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "所以……",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "……這件泳衣。",
    "voice": "vo_adv_1353004_025",
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "\\n到明年尺寸可能就不合了。",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "\\n如果要穿的話，",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "今年是最後的機會……",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "雖然這樣說，",
    "voice": "vo_adv_1353004_026",
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "結果還是什麼都做不到。",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "\\n時間轉眼就過去。",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126031
  },
  {
    "type": "dialogue",
    "name": "璃亞",
    "words": "夏天也快要結束了呢……",
    "voice": null,
    "unit_id": 126031
