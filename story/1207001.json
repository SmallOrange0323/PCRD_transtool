[
  {
    "type": "background",
    "bg_id": "501480"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "新年隔天早上──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n雪菲等人出現在",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "【美食殿堂】的玄關前。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "……嗯。",
    "voice": "vo_adv_1207001_000",
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "和服穿這樣就行了。",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我們去逛祭典吧。",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "但是",
    "voice": "vo_adv_1207001_001",
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "媽媽……",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "不",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "對……",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "可可蘿小姐真的不一起去嗎？",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……雖然兩位難得邀請在下，",
    "voice": "vo_adv_1207001_002",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但是年末沒做的家事和洗衣服等等，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下必須要完成這些工作才行。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "……這樣啊。",
    "voice": "vo_adv_1207001_003",
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "貪吃佩可小姐和凱留也都回王宮了。",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n大家一起過的時間",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "只有除夕呢……",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "雪菲小姐……",
    "voice": "vo_adv_1207001_004",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "後",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "天的話，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就能大家一起參加祭典了。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在下",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "會期待那天到來的。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "……嗯，",
    "voice": "vo_adv_1207001_005",
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "馬上就能再和大家見面了呢。",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "今天我就和這個人",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "一起去逛祭典吧。",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n我們也會確實去領收",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "可可蘿小姐訂購的金槍鮪！",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "好的。",
    "voice": "vo_adv_1207001_006",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "交給擅長跑腿的雪菲小姐去辦，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下也很放心。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在下會期待",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "兩位回來分享逛祭典時的趣事。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n請兩位路上小心。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "background",
    "bg_id": "501470"
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "這就是",
    "voice": "vo_adv_1207001_007",
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "新年的祭典……",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "大家都穿著和服走在路上，",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "氣氛好熱鬧。",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "媽媽！",
    "voice": "vo_adv_1207001_008",
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "那邊在打太鼓耶！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "喂，",
    "voice": "vo_adv_1207001_009",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "別突然跑起來！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "\\n要是走丟就不好了，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "母親",
    "words": "來牽好媽媽的手吧。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "嗯♪",
    "voice": "vo_adv_1207001_010",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "……而且，",
    "voice": "vo_adv_1207001_011",
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "很多都是跟著家人一起來呢。",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "「喪失記憶之前的我」，",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "是不是也像那樣和某人一起度過呢……",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "咦？",
    "voice": "vo_adv_1207001_012",
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我們也要牽手嗎？",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n你說為了防止走失……",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "真是的，",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我可不是小孩子啊。",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "不過，",
    "voice": "vo_adv_1207001_013",
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "也是呢。",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "畢竟風也很冷……",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n就稍微",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "借一下你的手好了。",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "……嗯，",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "那我們走吧。",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "話說回來，",
    "voice": "vo_adv_1207001_014",
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "祭典是要做些什麼？",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n咦？",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "邊走邊吃？",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n又、",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "又要吃東西……？",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "我是不討厭吃東西……",
    "voice": "vo_adv_1207001_015",
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n但新年都已經吃這麼多了，",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "竟然還要再吃。",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "那個，",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "感覺會變胖……",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "攤販大叔",
    "words": "哦，",
    "voice": "vo_adv_1207001_016",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "攤販大叔",
    "words": "在那裡的……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "攤販大叔",
    "words": "\\n不是【美食殿堂】的雪菲嗎！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "攤販阿姨",
    "words": "哎呀？",
    "voice": "vo_adv_1207001_017",
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "攤販阿姨",
    "words": "真的耶！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "攤販阿姨",
    "words": "\\n妳過來這裡一下！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "咦？",
    "voice": "vo_adv_1207001_018",
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "呃……",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "攤販大叔",
    "words": "前陣子",
    "voice": "vo_adv_1207001_019",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "攤販大叔",
    "words": "多虧妳幫我們從小偷那裡拿回食材，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "攤販大叔",
    "words": "\\n我們才能順利迎接新年喔！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "攤販阿姨",
    "words": "也讓我向妳道謝。",
    "voice": "vo_adv_1207001_020",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "攤販阿姨",
    "words": "\\n能像這樣順利做成生意，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "攤販阿姨",
    "words": "真不知叫人有多放心！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "攤販阿姨",
    "words": "\\n妳是我們的恩人！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "攤販阿姨",
    "words": "謝謝囉！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "不會……",
    "voice": "vo_adv_1207001_021",
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "別這麼說……",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "攤販大叔",
    "words": "對了！",
    "voice": "vo_adv_1207001_022",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "攤販大叔",
    "words": "\\n說到【美食殿堂】，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "攤販大叔",
    "words": "就是邊走邊吃的公會對吧？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "攤販大叔",
    "words": "\\n不然",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "攤販大叔",
    "words": "來喝喝我們店的甜酒吧！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "攤販大叔",
    "words": "這是謝禮，免費請妳喝！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "攤販阿姨",
    "words": "也來吃我們店的紅豆湯吧！",
    "voice": "vo_adv_1207001_023",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "攤販阿姨",
    "words": "我們的紅豆很好吃喔！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "攤販阿姨",
    "words": "\\n如果吃了喜歡，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "攤販阿姨",
    "words": "請務必要幫我們宣傳！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "攤販阿姨",
    "words": "\\n……啊，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "攤販阿姨",
    "words": "旁邊的男朋友也請用！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "男、",
    "voice": "vo_adv_1207001_024",
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "男朋友……！？",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "不是，那個……！",
