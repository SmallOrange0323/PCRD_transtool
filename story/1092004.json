[
  {
    "type": "background",
    "bg_id": "500110"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}在咲戀育幼院休息時，\\n安走了過來。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "啊、{0}！",
    "voice": "vo_adv_1092004_000",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n吶吶，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "你現在有沒有聽到一陣很美的聲音？",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "嗓音純淨清澈，",
    "voice": "vo_adv_1092004_001",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "沁入心底深處的動人旋律……",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "那個",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "是歌聲對吧？",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "不曉得",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "是誰在唱歌呢……？",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "咦，",
    "voice": "vo_adv_1092004_002",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "是嗎！？",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n原來可可蘿",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "這麼會唱歌嗎……！",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "啊……",
    "voice": "vo_adv_1092004_003",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "有了。",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "我想到一個好主意了！",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n我",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "去一下可可蘿那裡唷！",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "欸，",
    "voice": "vo_adv_1092004_004",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "{0}也要一起來嗎？",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "欸嘿嘿，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "謝謝。",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "那我們走吧！",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "background",
    "bg_id": "500351"
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "啊……",
    "voice": "vo_adv_1092004_005",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "還有安小姐也來了。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請問有什麼事嗎？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "可可蘿，",
    "voice": "vo_adv_1092004_006",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "妳的歌聲相當優美呢！",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "我被妳感動到了！",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "咦……",
    "voice": "vo_adv_1092004_007",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "謝、",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "謝謝您的讚美。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "被稱讚了有點害羞，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不過在下很開心。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "超級超級好聽～！",
    "voice": "vo_adv_1092004_008",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "那麼優美的旋律，我還是第一次聽到！",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "可可蘿，",
    "voice": "vo_adv_1092004_009",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "妳喜歡唱歌嗎？",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "沒錯呢。",
    "voice": "vo_adv_1092004_010",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n那當然",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是因為喜歡",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "所以才會唱歌……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但是，",
    "voice": "vo_adv_1092004_011",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "由於在下是精靈族，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n這大概也是從小養成的習慣吧。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "原來如此，",
    "voice": "vo_adv_1092004_012",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "精靈族……！",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "我也有一位",
    "voice": "vo_adv_1092004_013",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "名叫漢娜的精靈族朋友，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "她也和妳一樣非常擅長音樂……",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "阿斯特賴亞",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "看來也是一樣的呢。",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您所在的世界",
    "voice": "vo_adv_1092004_014",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "也同樣存在著精靈族呢。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "順帶一提，",
    "voice": "vo_adv_1092004_015",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "特別是",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下的村子裡，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n有著各式各樣",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "流傳千古的歌曲，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n從遙遠的上古時代便不斷地歌詠傳承至今。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "哇……",
    "voice": "vo_adv_1092004_016",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "這樣呀，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "阿斯特賴亞的歌曲……",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "……吶，可可蘿。",
    "voice": "vo_adv_1092004_017",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n方便的話，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "希望妳也能教我一些歌曲。",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "歌曲",
    "voice": "vo_adv_1092004_018",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "嗎？　",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "由在下",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "教安小姐……？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "嗯。",
    "voice": "vo_adv_1092004_019",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "不行嗎……？",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "雖然也不是不行……",
    "voice": "vo_adv_1092004_020",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "只是為何",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您突然想學呢？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "因為古蕾婭",
    "voice": "vo_adv_1092004_021",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "很喜歡音樂啊。",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "要是我記住這個世界的歌曲，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "我想她應該會很高興。",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "然後，",
    "voice": "vo_adv_1092004_022",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "回到原本的世界後，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "如果能和古蕾婭一起\\n邊彈奏鋼琴邊唱著這裡的歌，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "我想那一定會很開心……",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n欸嘿嘿。",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "原來如此……",
    "voice": "vo_adv_1092004_023",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那真是個美好的想法呢。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下明白了，",
    "voice": "vo_adv_1092004_024",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這件事就交給可可蘿。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n如果是在下知道的歌，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下非常樂意協助您。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "謝謝妳，可可蘿！",
    "voice": "vo_adv_1092004_025",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "好，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "我要努力學～！",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "呵呵，",
    "voice": "vo_adv_1092004_026",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "那當然！",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "古蕾婭對我來說，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "是個很重要的存在唷。",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "是嗎？　",
    "voice": "vo_adv_1092004_027",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "連{0}也看得出來\\n這種事嗎，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "總覺得有點開心呢！",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "……之前，",
    "voice": "vo_adv_1092004_028",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "學校裡的同學們",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "認為『公主和我們不同』，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n這我之前提過",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "對吧？",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "從那之後",
    "voice": "vo_adv_1092004_029",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "我漸漸開始感受到和大家的距離感。",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "大家還是",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "像往常一樣對我很好……",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "但聽到『好厲害』",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "或是『不愧是公主』這種話時，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "總覺得彼此間有著隔閡。",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "但是，",
    "voice": "vo_adv_1092004_030",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "就在之後的某一天……",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n我一個人在校園裡閒晃時，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "聽到了音樂聲。",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "是鋼琴聲。",
    "voice": "vo_adv_1092004_031",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "一道非常溫柔……",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "卻又",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "摻了些許揪心落寞的……",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "鋼琴聲。",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "因為太好奇那陣鋼琴聲",
    "voice": "vo_adv_1092004_032",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "究竟是從哪裡傳來的，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n我尋著聲音，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "上到了音樂塔……",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "那就是，",
    "voice": "vo_adv_1092004_033",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "我和",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "古蕾婭的相遇。",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "總覺得。",
    "voice": "vo_adv_1092004_034",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就好像是，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "命運般的邂逅。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "呵呵，",
    "voice": "vo_adv_1092004_035",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "是嗎？",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "命運嗎……",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "也許",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "真的是那樣唷。",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "我啊，",
    "voice": "vo_adv_1092004_036",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "見到她",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "的那一瞬間，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "就覺得無論如何都要當她的朋友！",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "　所以……",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "總是跑去找她聊天，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "一起度過兩人時光。",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "不久後，古蕾婭也",
    "voice": "vo_adv_1092004_037",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "開始慢慢地",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "願意敞開心扉！",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "原來如此。",
    "voice": "vo_adv_1092004_038",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "兩位的關係從此，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "變得像現在一樣要好了呢。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "欸嘿嘿……",
    "voice": "vo_adv_1092004_039",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "對啊。",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n雖然古蕾婭",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "不是一個愛說話的人，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "但是她心思細膩又很溫柔……",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "是一個非常為朋友著想的好孩子唷。",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "我每次",
    "voice": "vo_adv_1092004_040",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "和古蕾婭在一起時，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "總是不由自主地想要依賴她。",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "我平時",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "都告訴自己要成為一個可靠的人。",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "但待在她身邊",
    "voice": "vo_adv_1092004_041",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "讓我感到安心……",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "一不小心",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "就鬆懈下來了。",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "古蕾婭總是",
    "voice": "vo_adv_1092004_042",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "一次又一次地支持著我……",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n所以，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "如果有任何我能夠為古蕾婭做的事，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "無論是什麼事我都願意去做。",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "我想對她說謝謝妳一直陪伴在我身旁，",
    "voice": "vo_adv_1092004_043",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "還有",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "非常感謝……",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "我想要將這份心意傳達給她。",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "原來如此。",
    "voice": "vo_adv_1092004_044",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n……安小姐對古蕾婭小姐的那份心意，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "深深地",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "打動了可可蘿的心。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "為此，",
    "voice": "vo_adv_1092004_045",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下有個拙見……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不只是學會歌曲，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "直接在古蕾婭小姐面前獻唱給她聽，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n作為送給她的禮物，您覺得如何呢？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "欸……",
    "voice": "vo_adv_1092004_046",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "當作禮物",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "唱給古蕾婭聽？",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是的。",
    "voice": "vo_adv_1092004_047",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下所學的",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "精靈族之歌中，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n正好有一首",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "表達感謝與親愛之情的歌曲。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "如果您願意的話……",
    "voice": "vo_adv_1092004_048",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "安小姐，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n要不要",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "試著將這首歌學起來，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "獻唱給古蕾婭小姐呢？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "可可蘿……！",
    "voice": "vo_adv_1092004_049",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "嗯，",
    "voice": "vo_adv_1092004_050",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "我要學！",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "我",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "想要將那首歌獻給古蕾婭……！",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下明白了。",
    "voice": "vo_adv_1092004_051",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "除了歌曲以外，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下就先從唱歌方式開始教起。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "好的！",
    "voice": "vo_adv_1092004_052",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n可可蘿老師，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "一切就拜託您了！",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呵呵，",
    "voice": "vo_adv_1092004_053",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "沒錯，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下是可可蘿老師。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "啊，",
    "voice": "vo_adv_1092004_054",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "對了，{0}。",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "聽完後我也會試著唱唱看，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n到時候你也仔～細地聽一下唷！",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
