  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "…………咦？",
    "voice": "vo_adv_9500076_000",
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n要選",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "我？",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "為何、",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "為什麼……？",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "因為我",
    "voice": "vo_adv_9500076_001",
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "雖然外表是小孩子，",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n內在卻是非常成熟的大人喔……？",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "呃，",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "如果你是因為外表而選我，那也很糟……",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "…",
    "voice": "vo_adv_9500076_002",
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "…是說，",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "你突然跟我說這種話，",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "很害羞耶。",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "受不了，",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "別吊大人的胃口啦，",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "這個早熟的小鬼。",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "不過，",
    "voice": "vo_adv_9500076_003",
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "原來如此……",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "你有在",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "看著我呢。",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "原來如此……",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "呵呵。",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "……唔！",
    "voice": "vo_adv_9500076_004",
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "……唔",
    "voice": "vo_adv_9500076_005",
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "…",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "…啊？",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "我才沒哭！",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n是說，",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "根本沒有半點催淚的要素吧？",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "這眼淚是怎樣？",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "真是太奇怪了……",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "……唔。",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "啊──",
    "voice": "vo_adv_9500076_006",
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "好好好，",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "我哭了",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "我哭了。",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n那個，",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "話先說在前頭，",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "因為大人的淚腺是壞的，",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n光是看到寶寶笑就會哭。",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "真的",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "只是這樣。",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "所……",
    "voice": "vo_adv_9500076_007",
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "所以，",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "不是那樣啦！",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n是說，",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "為什麼要說那種話啦……",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "真是的。",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "你真的是",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "人小鬼大。",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "……但是，",
    "voice": "vo_adv_9500076_008",
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "我知道",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "那是你純粹的告白。",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n不是謊言、假話",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "或讓自己顯得高人一等的吹牛。",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "所以……",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "才能觸動心靈。",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "呵呵……",
    "voice": "vo_adv_9500076_009",
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "好了，",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "看來還不能悠哉呢。",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n那",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "就再努力一下吧。",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "為了不愧對",
    "voice": "vo_adv_9500076_010",
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "被你選上的我──",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "唔",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "哦哦！！？",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "……腳、",
    "voice": "vo_adv_9500076_011",
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "腳",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "抽筋了。",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "你先",
    "voice": null,
    "unit_id": 132541
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "轉過去一下……",
    "voice": null,
    "unit_id": 132541
  }
]
