[
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "終於把敵人逼到絕境了！",
    "voice": "vo_adv_5011323_000",
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "雖然經過了這麼辛苦的戰鬥，",
    "voice": "vo_adv_5011323_001",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "但這次終於是『善惡到頭必自爆』了！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "妳想說的是",
    "voice": "vo_adv_5011323_002",
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "『多行不義必自斃』吧，",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "璃乃。",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "啊、",
    "voice": "vo_adv_5011323_003",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "這樣啊！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "醜陋可愛",
    "words": "――咕哦哦哦哦哦！",
    "voice": null,
    "unit_id": 11011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "還不能夠太大意呢。",
    "voice": "vo_adv_5011323_004",
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n敵人被逼上死路時，",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "也是會拼了命的反抗的。",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "這將是最後的戰鬥了。",
    "voice": "vo_adv_5011323_005",
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "好，",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "三人合力",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
