[
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "靜流餵了{0}吃巧克力後，\\n望著他高興的表情沉浸於幸福之中。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "呵呵呵，",
    "voice": "vo_adv_1091004_000",
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "{0}弟弟果然很可愛呢。",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "姐姐我",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "能和{0}弟弟\\n一起過情人節，感到很幸福喔。",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "哎呀，",
    "voice": "vo_adv_1091004_001",
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "吃得太急了，噎到了嗎？",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我去拿水過來，你稍等一下喔。",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我看看……",
    "voice": "vo_adv_1091004_002",
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n記得這裡應該有裝水的水瓶……",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "啊，",
    "voice": "vo_adv_1091004_003",
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "找到了找到了！",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "奇怪，",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "水在發光？",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "簡直就像是反射了太陽光一樣――",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "background",
    "bg_id": "510090"
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "（……盯）",
    "voice": "vo_adv_1091004_004",
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "啊，",
    "voice": "vo_adv_1091004_005",
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "{0}弟弟終於起床了！",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "差不多到了該起床的時間，所以要來叫醒你，",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n不過睡臉太可愛，讓我看得入迷了〜",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "嗯，",
    "voice": "vo_adv_1091004_006",
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "一轉眼已經一小時了？",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "其實今天要給{0}弟弟",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "一個意外的驚喜！",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "讓人很在意吧〜",
    "voice": "vo_adv_1091004_007",
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "那你就快點換好衣服下樓吧。",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n我先過去等你！",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "background",
    "bg_id": "510080"
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "喂，{0}弟弟，",
    "voice": "vo_adv_1091004_008",
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我在這裡喔〜",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "still",
    "still_id": "109100401"
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "你總算下來了，",
    "voice": "vo_adv_1091004_009",
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "姐姐等得要累死了啊。",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "開玩笑啦〜",
    "voice": "vo_adv_1091004_010",
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "騙你的騙你的。",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "其實我還在準備中。",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n你可以再等我一下下嗎？",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "……嗯？",
    "voice": "vo_adv_1091004_011",
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n你為什麼要這樣子",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n盯著姐姐看呢？",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "咦〜",
    "voice": "vo_adv_1091004_012",
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "難道是看姐姐穿圍裙，",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n讓你心動了嗎？",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "該不會覺得",
    "voice": "vo_adv_1091004_013",
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我是你的新娘吧？",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "真可惜，",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我是姐姐♪",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "姐姐現在呢，",
    "voice": "vo_adv_1091004_014",
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n正在幫{0}弟弟做便當喔。",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "還差一點就完成了，",
    "voice": "vo_adv_1091004_015",
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "你要聽話的等喔！",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "嗯？　",
    "voice": "vo_adv_1091004_016",
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "但你說我在做的是巧克力？",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "那當然囉！",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n因為今天是情人節嘛。",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "男孩子在學校裡，",
    "voice": "vo_adv_1091004_017",
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n都會比較誰收到最多巧克力吧？",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "所以姐姐要送給{0}弟弟",
    "voice": "vo_adv_1091004_018",
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n很〜多的巧克力呢。",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "在學校就算{0}弟弟沒有收到女孩子送的\\n巧克力，",
    "voice": "vo_adv_1091004_019",
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "只要有這些就不丟臉了吧？",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "你又說這種話來逞強了〜",
    "voice": "vo_adv_1091004_020",
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n難道是叛逆期到了？",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "可是你這種個性實在很可愛呢〜",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "等你能收到很多巧克力的時候，",
    "voice": "vo_adv_1091004_021",
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n我就承認你是個能獨當一面的男孩，",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "在那之前就吃姐姐的巧克力長大吧！",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "啊哈哈，",
    "voice": "vo_adv_1091004_022",
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "你真老實呢〜{0}弟弟。",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n真不愧是姐姐的弟弟呢！",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "老實的{0}弟弟真可愛呢。",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "嗯嗯，",
    "voice": "vo_adv_1091004_023",
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "{0}弟弟的魅力，",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n姐姐非常了解的，所以不要緊喔！",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n你要一直是我最喜歡的{0}弟弟喔♪",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "background",
    "bg_id": "510080"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "啊，",
    "voice": "vo_adv_1091004_024",
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "對了！　",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "早餐要吃的巧克力已經準備好了。",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n我放在桌子上，",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "你快去嚐嚐看吧。",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "還是說，",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "你想讓姐姐餵你吃啊？",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "……唔，",
    "voice": "vo_adv_1091004_025",
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "不過實在是沒時間了。",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "餵你吃這件事，",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "就等下次吧，",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "好嗎。",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "background",
    "bg_id": "510220"
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "來，",
    "voice": "vo_adv_1091004_026",
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "請吃這個巧克力〜。",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "男學生１",
    "words": "唔喔喔喔喔喔喔喔！　",
    "voice": "vo_adv_1091004_027",
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "男學生１",
    "words": "謝謝你！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男學生１",
    "words": "\\n加上老媽送的，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男學生１",
    "words": "我今年收到兩個了！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "來，",
    "voice": "vo_adv_1091004_028",
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "也送給你喔！",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "男學生２",
    "words": "謝、",
    "voice": "vo_adv_1091004_029",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男學生２",
    "words": "謝謝！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男學生２",
    "words": "\\n謝謝你！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男學生２",
    "words": "\\n太好了，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男學生２",
    "words": "這樣今年就不是一個都沒收到了！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "還有你，",
    "voice": "vo_adv_1091004_030",
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "那位也是！　",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "還有……",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "……嗯，",
    "voice": "vo_adv_1091004_031",
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "這樣就全部的人都發過了吧。",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "有人沒拿到嗎？",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "應該沒有吧――",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "……啊，",
    "voice": "vo_adv_1091004_032",
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "早安啊，{0}弟弟！",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n來我的教室做什麼啊？　",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "你一臉這樣想的表情呢。",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "看就知道了，",
    "voice": "vo_adv_1091004_033",
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n我是來給平日照顧{0}弟弟的同學們",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n送巧克力的喔。",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "男學生１",
    "words": "姐姐！！",
    "voice": "vo_adv_1091004_034",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男學生１",
    "words": "\\n謝謝妳，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男學生１",
    "words": "謝謝妳！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男學生２",
    "words": "多虧有妳，今年",
    "voice": "vo_adv_1091004_035",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男學生２",
    "words": "我總算不用自己買巧克力了……！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "嗯嗯，",
    "voice": "vo_adv_1091004_036",
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "能讓你們高興這樣最好了。",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "啊，",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "當然我送各位的都是人情巧克力啦。",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n不過也都是姐姐親手做的呢。",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "再來最後是……",
    "voice": "vo_adv_1091004_037",
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "這個給你，",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "是要送給{0}弟弟的本命巧克力！",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "你說明明早上已經收過了，",
