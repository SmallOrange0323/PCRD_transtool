[
  {
    "type": "background",
    "bg_id": "500570"
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呼、",
    "voice": "vo_adv_2011004_000",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呼……！",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "真是強悍！",
    "voice": "vo_adv_2011004_001",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n這個人",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "，口氣明明如此平穩，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "動作卻非常的迅速！",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "只要一個不小心，",
    "voice": "vo_adv_2011004_002",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就馬上會敗下陣來了……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n但是，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "如果在這裡敗下陣來，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "所有的計畫就都前功盡棄了。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "為了未來！　",
    "voice": "vo_adv_2011004_003",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "為了伙伴！",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n為了，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "能夠再次和最喜歡的人們",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "一起圍在餐桌旁！",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "絕不會在這裡輸掉……！",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "意外地挺能撐呢。",
    "voice": "vo_adv_2011004_004",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "看來，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "是真的很想救出妳的友人呢。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我實在不想繼續欺凌一個乖孩子了，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n希望妳能早點放棄",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "趕緊去睡覺了呢。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不！",
    "voice": "vo_adv_2011004_005",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n就寢的時間還早得很，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n正因為是乖孩子所以不會就此睡去！",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "就算這樣也得逼妳去睡，",
    "voice": "vo_adv_2011004_006",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "儘管難過但這是我的職責。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "雖然很可憐。",
    "voice": "vo_adv_2011004_007",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "妳再繼續掙扎下去的話，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n察覺到這騷動",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "的其他衛兵們也會趕到。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n是一群對妳們沒有任何想法的傢伙們，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "會毫不猶豫的把妳們殺了吧。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "畢竟入侵『王宮』可是大罪，",
    "voice": "vo_adv_2011004_008",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "像那樣的應對可是極為正常的。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n而我的意思是時間已經到囉，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我不會再手下留情了。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "咦？",
    "voice": "vo_adv_2011004_009",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n到剛才為止，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "竟然都只是",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "手下留情……？",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "抱歉了呢。",
    "voice": "vo_adv_2011004_010",
    "unit_id": 104711
  },
  {
    "type": "background",
    "bg_id": "500570"
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "呀啊……！？",
    "voice": "vo_adv_2011004_011",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……",
    "voice": "vo_adv_2011004_012",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "哎呀，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "糟了。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n出手的方向有點弄錯了呢，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n結果讓那孩子往地下監獄的方向滾下去了啊。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "下去回收她，",
    "voice": "vo_adv_2011004_013",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "然後再把她綁起來。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n這樣，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "任務就完成了。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "background",
    "bg_id": "500340"
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……。",
    "voice": "vo_adv_2011004_014",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……嗚，",
    "voice": "vo_adv_2011004_015",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "嗚咕。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n從樓梯上摔落後，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "有幾秒的時間",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "失去意識的樣子。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不妙！　",
    "voice": "vo_adv_2011004_016",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "腳步聲慢慢接近了，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n是名為純的那位騎士追過來了吧！",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n得趕緊起身擺好架勢，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "做出應對才行！",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "還沒",
    "voice": "vo_adv_2011004_017",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "完全失去希望！",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在下等人在這廣大的世界裡相遇，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n才不是為了在這種地方迎來終結！",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是這樣沒錯吧，",
    "voice": "vo_adv_2011004_018",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "【美食殿堂】的各位！",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "可……",
    "voice": "vo_adv_2011004_019",
    "unit_id": 105813
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "蘿",
    "voice": null,
    "unit_id": 105813
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "醬……？",
    "voice": null,
    "unit_id": 105813
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……",
    "voice": "vo_adv_2011004_020",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "貪吃佩可小姐！",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "原來如此，",
    "voice": "vo_adv_2011004_021",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下從那樓梯上摔落……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不知道是福是禍，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "掉進了地下的監獄裡頭了呢？",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n而在一旁的，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就是囚禁著貪吃佩可小姐的牢房！",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "啊啊、",
    "voice": "vo_adv_2011004_022",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "貪吃佩可小姐，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下一直都好想見您……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "多麼狼狽不堪，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您竟然會變成這副模樣。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您美麗的長髮、",
    "voice": "vo_adv_2011004_023",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "衣物，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "都已如此髒亂不堪了……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這是天地不容的惡行，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "絕對誓死抗議到底！",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "謝謝。",
    "voice": "vo_adv_2011004_024",
    "unit_id": 105813
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "雖然從似似花那裡，",
    "voice": "vo_adv_2011004_025",
    "unit_id": 105813
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "有簡單的聽說過了。",
    "voice": null,
    "unit_id": 105813
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105813
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "妳們大家，",
    "voice": null,
    "unit_id": 105813
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "真的來救我了呢。",
    "voice": null,
    "unit_id": 105813
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105813
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這麼亂來……",
    "voice": null,
    "unit_id": 105813
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小可蘿才是，",
    "voice": null,
    "unit_id": 105813
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "妳這不是傷痕累累了嗎？",
    "voice": null,
    "unit_id": 105813
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這樣不行唷～",
    "voice": "vo_adv_2011004_026",
    "unit_id": 105813
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "要更愛護自己一點呢。",
    "voice": null,
    "unit_id": 105813
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105813
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "如果身體有哪裡傷到了，",
    "voice": null,
    "unit_id": 105813
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "可是沒有辦法打從心底去享受美食的喔。",
    "voice": null,
    "unit_id": 105813
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105813
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那才是最悲慘的唷，",
    "voice": null,
    "unit_id": 105813
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "遠比我現在這樣還要慘喔。",
    "voice": null,
    "unit_id": 105813
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "明明那樣就好了，",
    "voice": "vo_adv_2011004_027",
    "unit_id": 105813
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "把我的事情全部忘記了也沒關係呀。",
    "voice": null,
    "unit_id": 105813
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105813
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我可是連想都沒想就衝了出去，",
    "voice": null,
    "unit_id": 105813
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "傻傻的被人家給抓到了喔。",
    "voice": null,
    "unit_id": 105813
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "對我無言以對，",
    "voice": "vo_adv_2011004_028",
    "unit_id": 105813
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "放著不管，",
    "voice": null,
    "unit_id": 105813
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "最後再把我忘記就好了。",
    "voice": null,
    "unit_id": 105813
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105813
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不對。",
    "voice": null,
    "unit_id": 105813
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "如果妳們還願意偶爾想起我，",
    "voice": null,
    "unit_id": 105813
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "就覺得很幸福了。",
    "voice": null,
    "unit_id": 105813
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊啊，以前",
    "voice": "vo_adv_2011004_029",
    "unit_id": 105813
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好像有一起吃過飯的那個，",
    "voice": null,
    "unit_id": 105813
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105813
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "名字記得好像是，",
    "voice": null,
    "unit_id": 105813
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "念起來好記又可愛的那個，",
    "voice": null,
    "unit_id": 105813
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105813
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "總是肚子餓得咕嚕咕嚕叫的",
    "voice": null,
    "unit_id": 105813
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那個小貪吃佩可……",
    "voice": null,
    "unit_id": 105813
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這樣。",
    "voice": null,
    "unit_id": 105813
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這綽號是小可蘿替我取的呢。",
    "voice": "vo_adv_2011004_030",
    "unit_id": 105813
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105813
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我，",
    "voice": null,
    "unit_id": 105813
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "非常喜歡喔……♪",
    "voice": null,
    "unit_id": 105813
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "貪吃佩可小姐……",
    "voice": "vo_adv_2011004_031",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n別、",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "別再勉強自己說話了。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "現在就讓您從裡面出來，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就算要把這鐵柵欄破壞掉。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "很遺憾，",
    "voice": "vo_adv_2011004_032",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "那是不可能的唷。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "抱歉呢。",
    "voice": "vo_adv_2011004_033",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n就順便連妳一起捉起來，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n然後和{0}少年一同扔進大牢裡吧。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "哇呀？　",
    "voice": "vo_adv_2011004_034",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人？",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n到處都沒見到主人的身影，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "難不成……？",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "啊，",
    "voice": "vo_adv_2011004_035",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我忘了我還把他丟在路上呀……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n這樣可不行～",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n這陣子",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "似乎莫名的迷糊，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "總是做些迷糊的事。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人他，",
    "voice": "vo_adv_2011004_036",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "似乎還保有一命……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "的樣子呢。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這樣就安心了，",
    "voice": "vo_adv_2011004_037",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不過眼前的現況依舊不樂觀。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n主人他因失去意識倒地不起，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "而在下又滿身瘡痍，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "貪吃佩可小姐則",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "還在牢中。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "而【拉比林斯】，",
    "voice": "vo_adv_2011004_038",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "與食客的大家……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n則是為了破壞那個洗腦魔法裝置，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n正努力不懈、奮勇向前吧。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不會像是童話故事一般，",
    "voice": "vo_adv_2011004_039",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n於在下等人處於危機之際，正巧現身救援吧。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "洗腦？　",
    "voice": "vo_adv_2011004_040",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "啊啊這麼說來，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "的確還有那樣的裝置呢……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "『王宮』勢力的那些人，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n看來很有可能是被洗腦了。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "因此純小姐，",
    "voice": "vo_adv_2011004_041",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n她才會連對主人，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "也絲毫不留情面的嗎？",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不……",
    "voice": "vo_adv_2011004_042",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "或許只是",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "相當看重",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "自身職責的人",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "也說不定。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "純小姐",
    "voice": "vo_adv_2011004_043",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就算受到洗腦，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n依舊是對在下等人的性命，有所顧慮的",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "一位溫柔之人。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "可以的話，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "真不想在這種情況與您相遇。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "好了。",
    "voice": "vo_adv_2011004_044",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我想妳們也都已理解現況",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "，雖然都講了很多次",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "但就在這裡結束吧。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "上頭……",
    "voice": "vo_adv_2011004_045",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "從長廊上",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "傳來著大量的腳步聲，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我想大概是我的部下們，察覺到了騷動",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "正火速趕來呢。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n不會再讓妳繼續拖延下去了，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "讓我趕緊收拾吧。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "still",
    "still_id": "201100401"
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……不！",
    "voice": "vo_adv_2011004_046",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在下直到最後一刻為止，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "絕不會放棄！",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不論是多麼絕望的狀況，",
    "voice": "vo_adv_2011004_047",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n只要發生了奇蹟就有辦法解決！",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n而在下的主人，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就是能夠引發那種奇蹟的人！",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下如此深信著，",
    "voice": "vo_adv_2011004_048",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "為此侍奉於主人左右！",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n儘管最初是因為愛梅斯大人所託付，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但是現在……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是出於真心！",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "真是不明事理的孩子呢。",
    "voice": "vo_adv_2011004_049",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n……那麼就沒辦法了，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "講不聽的孩子，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "只能動手來教訓了。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小可蘿！",
    "voice": "vo_adv_2011004_050",
    "unit_id": 105813
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n拜託妳快逃吧，",
    "voice": null,
    "unit_id": 105813
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "就算只有妳一個人也好！",
    "voice": null,
    "unit_id": 105813
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我的事就不用管了，",
    "voice": null,
    "unit_id": 105813
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我怎樣都沒關係了啦！",
    "voice": null,
    "unit_id": 105813
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "才不是怎樣都沒關係！",
    "voice": "vo_adv_2011004_051",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n每次每次您都像這樣淨說些傻話！",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請您就別再說了，貪吃佩可小姐！",
    "voice": "vo_adv_2011004_052",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n就算是在下",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "偶爾也是會生氣的呀！",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "呀啊！",
    "voice": "vo_adv_2011004_053",
    "unit_id": 105813
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "總是很溫柔的小可蘿",
    "voice": null,
    "unit_id": 105813
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "竟然發火了……！？",
    "voice": null,
    "unit_id": 105813
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "感情還真好呢。",
    "voice": "vo_adv_2011004_054",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n但妳們真的，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "搞清楚狀況了嗎？",
