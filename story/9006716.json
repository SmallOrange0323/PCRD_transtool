    "words": "\\n既然如此──",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "屁股相撲！",
    "voice": "vo_adv_9006716_034",
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n讓我們用屁股相撲一決勝負吧──",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "巨型臀部墜擊──！！！",
    "voice": "vo_adv_9006716_035",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "……噗啾。",
    "voice": "vo_adv_9006716_036",
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "克蘿茜小姐！？",
    "voice": "vo_adv_9006716_037",
    "unit_id": 139811
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "沒錯，",
    "voice": "vo_adv_9006716_038",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "我是克蘿茜！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "聽說有屁股相撲，所以我就來參加了。",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n是我多此一舉了嗎……？",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "並沒有，",
    "voice": "vo_adv_9006716_039",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "克蘿茜。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n妳做得非常出色喔。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "一心追求解開神祕之謎的傢伙，",
    "voice": "vo_adv_9006716_040",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n最後竟然被凝聚人類技術結晶的",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "機器人親手打倒……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "真是因果報應呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "雖然不是用手，",
    "voice": "vo_adv_9006716_041",
    "unit_id": 139811
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "是屁股就是了……",
    "voice": null,
    "unit_id": 139811
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "……說、",
    "voice": "vo_adv_9006716_042",
    "unit_id": 139811
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "說的也是。",
    "voice": null,
    "unit_id": 139811
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 139811
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "彌勒倒下之後，",
    "voice": null,
    "unit_id": 139811
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "「世界資源化」應該也會停止才對。",
    "voice": null,
    "unit_id": 139811
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 139811
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "繼續前進吧！",
    "voice": null,
    "unit_id": 139811
  }
]
