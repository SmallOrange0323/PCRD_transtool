    "name": "彌勒",
    "words": "…………倒地。",
    "voice": "vo_adv_9006716_004",
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "──成、",
    "voice": "vo_adv_9006716_005",
    "unit_id": 139811
  },
  {
    "type": "dialogue",
    "name": "雪菲",
