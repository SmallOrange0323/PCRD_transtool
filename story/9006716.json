    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "……！",
    "voice": "vo_adv_9006716_018",
    "unit_id": 139811
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n雖然不懂為什麼，",
    "voice": null,
    "unit_id": 139811
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "但他抱著頭很痛苦的樣子……！？",
