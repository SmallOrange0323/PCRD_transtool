[
  {
    "type": "dialogue",
    "name": "大家",
    "words": "「「高貴之炎！！」」\\n「「聖神之雨！！」」",
    "voice": "vo_adv_9006716_000",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "唔咕嘎嗶呀巴拉嘎呀",
    "voice": "vo_adv_9006716_001",
