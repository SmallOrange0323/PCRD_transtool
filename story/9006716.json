    "unit_id": 139811
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "親眼目睹超出理解範圍的存在，",
    "voice": "vo_adv_9006716_019",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n似乎會對精神造成傷害呢……！",
    "voice": null,
    "unit_id": 190011
  },
  {
