  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "──不！",
    "voice": "vo_adv_9006716_006",
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "不不布布噗噗！",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n還沒結束啊啊啊啊……！",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這傢伙！",
    "voice": "vo_adv_9006716_007",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n也太耐打了吧……！？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "寄宿於全新的[rub:角色]化身[/rub]之中，",
    "voice": "vo_adv_9006716_008",
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "我的靈魂永恆不變！",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "在徹底解明遍及萬象的真理之前，",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "我的巡禮之途",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n將跨越現實",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "和幽世，",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "甚至更遙遠的彼方──",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "永不止息啊啊啊",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "啊啊……！",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "唔……！",
    "voice": "vo_adv_9006716_009",
    "unit_id": 139811
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n難不成，",
    "voice": null,
    "unit_id": 139811
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "比起肉體，",
    "voice": null,
    "unit_id": 139811
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "連心靈──",
    "voice": null,
    "unit_id": 139811
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n連靈魂都必須屈服才行嗎……！？",
    "voice": null,
    "unit_id": 139811
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "那、",
    "voice": "vo_adv_9006716_010",
    "unit_id": 135811
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "那麼……",
    "voice": null,
    "unit_id": 135811
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "\\n又要拜託璐璐伊了嗎……？",
    "voice": null,
    "unit_id": 135811
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "嗚啾……",
    "voice": "vo_adv_9006716_011",
    "unit_id": 136911
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n但素，",
    "voice": null,
    "unit_id": 136911
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "偶的觸手",
    "voice": null,
    "unit_id": 136911
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n好像也漸漸沒效果了……",
    "voice": null,
    "unit_id": 136911
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "貧僧可不會被同一招一再得逞！",
    "voice": "vo_adv_9006716_012",
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "這可是常識！",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "……不過，",
    "voice": "vo_adv_9006716_013",
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "老實說只是習慣了而已喔？",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "只是因為被妳的老爸？",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "只是因為他造成[rub:心靈創傷]心靈創傷[/rub]而觸發了創傷反應罷了。",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "跟那種超乎常理的神話級存在比起來，",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "妳根本還差得遠呢。",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "如此這般。",
    "voice": "vo_adv_9006716_014",
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n現在的我實質上是不死之身的特別存在。",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n還請各位做好覺悟──",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "公主們",
    "words": "「需要助你一臂之力嗎，騎士。」\\n「吾等特來相助，騎士閣下呀。」\\n「您在呼喚我嗎？騎士先生。」",
    "voice": "vo_adv_9006716_015",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "─",
    "voice": "vo_adv_9006716_016",
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "─噫！！",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n習合天使！",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "Inner Core！",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "巫女巫女殭屍……！？",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "住……",
    "voice": "vo_adv_9006716_017",
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "住手！",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n別、",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "別、別靠近我！",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "\\n",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "你們這群超越了人類技術，",
    "voice": null,
    "unit_id": 192613
  },
  {
    "type": "dialogue",
    "name": "彌勒",
    "words": "跳脫科學框架的魑魅魍魎啊啊啊……！！",
