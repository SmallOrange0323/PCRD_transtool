  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "你、",
    "voice": "vo_adv_9500056_000",
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "你說什麼！？",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……我剛剛",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "可能",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "聽錯了……",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "什麼……",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "啊，",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "不！",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "你沒必要再說一次喔！",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "事出突然，",
    "voice": "vo_adv_9500056_001",
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我都懷疑起自己的耳朵了，",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n但我應該",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "不可能聽錯閣下聲音。",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n但是……",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "是……",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "是我嗎？",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "選我",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "真的可以嗎！？",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……請、",
    "voice": "vo_adv_9500056_002",
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "請原諒我變得如此多疑。",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n對我而言，",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這就是",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "該如此驚訝的事。",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "因為、",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "因為……",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "算了。",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……",
    "voice": "vo_adv_9500056_003",
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我好高興啊。",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n能被自己一直想與之相伴的人，",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "當作唯一的人選中。",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我的願望實現了，",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "感覺就像在做夢一樣。",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "事到如今，我",
    "voice": "vo_adv_9500056_004",
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "覺得已經不適合",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "再稱閣下為我的朋友了，",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "但話雖如此，",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "稱為搭檔好像也不對啊。",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "那、",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "那麼就──",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "戀、",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "戀、",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "戀人……",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "之類的！",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "伴侶……",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "會太超過嗎！？",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我與閣下",
    "voice": "vo_adv_9500056_005",
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "將友情、",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "戀慕、",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "信賴全部加在一起，",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "成為共度人生的",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "獨一無二的存在──",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……也就是說，",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "是命運共同體！",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "就像飛空艇與",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "提督那樣呢！",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "從今以後，",
    "voice": "vo_adv_9500056_006",
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我就一直在閣下",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "身邊支持閣下吧！",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "怎麼樣，",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "很高興吧……？",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……唔、",
