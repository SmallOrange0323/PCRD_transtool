    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "喂！",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "你用那麼直率的眼神點頭，",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n會害說出口的我都不好意思起來了吧！",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我可是也",
    "voice": "vo_adv_9500056_008",
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "鼓起了相當大的勇氣喔！",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "所以，",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "那個……",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "今後",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "也請多指教了！",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "來，",
    "voice": "vo_adv_9500056_009",
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "走吧。",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n向和平的未來！",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n──全速",
    "voice": null,
    "unit_id": 105341
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
