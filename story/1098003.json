[
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "再一次，那是發生在某天的午後――",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人，",
    "voice": "vo_adv_1098003_000",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n請把臉轉向這裡。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "好，",
    "voice": "vo_adv_1098003_001",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下來幫您擦嘴巴。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "擦",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "擦",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "好、",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "變得非常乾淨了。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "……",
    "voice": "vo_adv_1098003_002",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那麼，",
    "voice": "vo_adv_1098003_003",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下來幫您拿掉餐巾。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "可以",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "像這樣",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "把手舉高嗎？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "好，",
    "voice": "vo_adv_1098003_004",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "做得非常好。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n就算說您是",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "把手舉高的專家",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "也不為過。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "……",
    "voice": "vo_adv_1098003_005",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那麼，",
    "voice": "vo_adv_1098003_006",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n請問這之後要怎麼辦？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "原來如此，",
    "voice": "vo_adv_1098003_007",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "肚子吃得很飽了。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那樣的話，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請在在下的大腿上",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "午睡……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "……等一下。",
    "voice": "vo_adv_1098003_008",
    "unit_id": 109811
  },
  {
    "type": "background",
    "bg_id": "500050"
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "嗯？",
    "voice": "vo_adv_1098003_009",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n請問怎麼了，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "拉姆小姐。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "才不是什麼",
    "voice": "vo_adv_1098003_010",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "「請問怎麼了」吧。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "妳以為這裡是哪裡？",
    "voice": "vo_adv_1098003_011",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n是一般",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "用餐的店裡面喔。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "在這裡面，",
    "voice": "vo_adv_1098003_012",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n到底是怎麼做才能變得這麼寵人啊。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "就算是看到雷姆的可愛和為姊姊著想的地方，\\n而不停寵愛她的拉姆，看到妳的溺愛也為之感到戰慄了。",
    "voice": "vo_adv_1098003_013",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "再怎麼說，",
    "voice": "vo_adv_1098003_014",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n可可蘿也有點太寵過頭了吧？",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "沒、",
    "voice": "vo_adv_1098003_015",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "沒有，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "絕對沒有那回事。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "而且",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "照顧主人",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就是在下的使命。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "當然，",
    "voice": "vo_adv_1098003_016",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在下並不是只因為使命",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "而去侍奉的。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "拉姆小姐",
    "voice": "vo_adv_1098003_017",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "也是女僕對吧？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "侍奉主人的心情，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您應該也能明白不是嗎？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "……",
    "voice": "vo_adv_1098003_018",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "是啊，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "也不是不能明白。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n拉姆也",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "向羅茲瓦爾大人宣示了忠誠。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "但是，",
    "voice": "vo_adv_1098003_019",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "羅茲瓦爾大人\\n是個身邊的事物都能自己處理的人。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "以這大前提來看，\\n就與這位{0}有著很大的不同。",
    "voice": "vo_adv_1098003_020",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "根本無法參考。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "拉姆小姐的想法在下明白了，",
    "voice": "vo_adv_1098003_021",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n但主人",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "現在暫時",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "還需要時間。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "所以，",
    "voice": "vo_adv_1098003_022",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是否能請您",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "暫時在旁看著我們就好呢？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "為什麼妳要做到這種地步……",
    "voice": "vo_adv_1098003_023",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "不，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "說到底這並不是拉姆能夠插嘴的事情。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "只是，",
    "voice": "vo_adv_1098003_024",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "這點先和妳說好了。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n要是太過寵溺，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "對雙方都不是好事。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "那麼做，",
    "voice": "vo_adv_1098003_025",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "一定會成為{0}，\\n這個男人成長的阻礙。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "拉姆小姐……",
    "voice": "vo_adv_1098003_026",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "……",
    "voice": "vo_adv_1098003_027",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "啊，",
    "voice": "vo_adv_1098003_028",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人……！",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "居然不借用在下的大腿，",
    "voice": "vo_adv_1098003_029",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n揉著昏昏欲睡的眼睛",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "站起來了……！",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您真是太了不起了，",
    "voice": "vo_adv_1098003_030",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n讓在下深深",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "感動到為之顫抖了……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "看這樣子，\\n暫時是不行了呢……",
    "voice": "vo_adv_1098003_031",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "喂，",
    "voice": "vo_adv_1098003_032",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "小姑娘們。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n妳們是",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "公會【美食殿堂】的人嗎？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "嗯……？",
    "voice": "vo_adv_1098003_033",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是，",
    "voice": "vo_adv_1098003_034",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "我們是",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "【美食殿堂】的成員。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請問有什麼事嗎？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "嗯，",
    "voice": "vo_adv_1098003_035",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "是關於公會小屋的事情，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n我想找相關人員談一下，所以才在找妳們。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "不會耗費妳們太多時間，",
    "voice": "vo_adv_1098003_036",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n如果能現在談談就幫大忙了。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "談事情",
    "voice": "vo_adv_1098003_037",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是嗎。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "明白了。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這件事就由在下來處理。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "現在貪吃佩可小姐",
    "voice": "vo_adv_1098003_038",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "和凱留小姐不在，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n這並不是",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "需要勞煩主人的情況。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就讓在下可可蘿，",
    "voice": "vo_adv_1098003_039",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "毅然地",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "擔任談話的對象。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "喔、",
    "voice": "vo_adv_1098003_040",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "喔喔？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "是嗎？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "那麼，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "跟我到公會小屋來。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下明白了。",
    "voice": "vo_adv_1098003_041",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那麼",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下就過去了。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下這就出發了，但……",
    "voice": "vo_adv_1098003_042",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "……什麼？",
    "voice": "vo_adv_1098003_043",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "妳就去吧。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n為什麼要盯著拉姆看？",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "拉姆小姐，",
    "voice": "vo_adv_1098003_044",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下明白這是非常失禮的請求，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但是否能在在下回來之前，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請您陪著",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人呢？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "拉姆小姐很可靠能幹，",
    "voice": "vo_adv_1098003_045",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n您能陪著主人的話，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下也能感到放心。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "就在剛才",
    "voice": "vo_adv_1098003_046",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n拉姆才說過要妳讓他獨立，妳卻要拜託拉姆？",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "妳以為拉姆會樂意接受，那就大錯特錯了。",
    "voice": "vo_adv_1098003_047",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "拉姆和把善良當作衣服穿在身上的愛蜜莉雅大人不一樣。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "而且，",
    "voice": "vo_adv_1098003_048",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n也和禁不起別人肯求的雷姆不一樣。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "拉姆小姐的意見非常正確。",
    "voice": "vo_adv_1098003_049",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n但是，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "務必懇請",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您能幫忙。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人是",
    "voice": "vo_adv_1098003_050",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下重要的人。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n就連片刻",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "都不能將他置身於危險之中。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "……",
    "voice": "vo_adv_1098003_051",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "片刻都",
    "voice": "vo_adv_1098003_052",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "不希望讓他遭遇危險，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "是嗎。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "……",
    "voice": "vo_adv_1098003_053",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "拉姆可不會寵他。",
    "voice": "vo_adv_1098003_054",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n只是在旁邊看著而已。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "這是條件。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是，",
    "voice": "vo_adv_1098003_055",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這樣就足夠了。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n拉姆小姐，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "非常謝謝您！",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "這不是什麼值得道謝的事情。",
    "voice": "vo_adv_1098003_056",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n因為",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "拉姆真的只會在旁邊看著而已。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "所以，",
    "voice": "vo_adv_1098003_057",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n請別抱有超過這之上的期待。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "等一下，",
    "voice": "vo_adv_1098003_058",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "太危險了。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n那裡是馬車要通行的路吧，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "靠路邊走。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "為什麼你會想橫越馬路？",
    "voice": "vo_adv_1098003_059",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n來這裡",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "……",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "啊啊，真是的，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "到拉姆旁邊來。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "要是跟著那看一眼就知道很可疑的人群走，",
    "voice": "vo_adv_1098003_060",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n可以想見一定會遭到苦頭吧。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "你再多珍惜自己一點如何？",
    "voice": "vo_adv_1098003_061",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n你要是有什麼萬一，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "可可蘿會哭的。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "background",
    "bg_id": "500131"
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "幫老人家搬行李，真了不起。",
    "voice": "vo_adv_1098003_062",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "這不是壞事。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "那是正確的。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "但是，",
    "voice": "vo_adv_1098003_063",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n居然跟著走到蘭德索爾之外來，這就不正常了。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "光是單程就花了數小時，",
    "voice": "vo_adv_1098003_064",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n結果只是坐在走廊邊喝個茶就回來，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "實在不符合勞力成本。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "background",
    "bg_id": "500132"
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "天色完全暗下來了……",
    "voice": "vo_adv_1098003_065",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n明明應該只是在旁邊看著就沒事了才對……",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "嗯，",
    "voice": "vo_adv_1098003_066",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "你還真是挺折騰的呢。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n託你的福，害拉姆足足 3 小時都被耽誤在原地。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "如果抱著大行李走了單程 2 小時的路，",
    "voice": "vo_adv_1098003_067",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n無論是什麼茶都會覺得好喝呢。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "真是讓人步調都亂了。",
    "voice": "vo_adv_1098003_068",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n你平常都是這樣生活的嗎？",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "……",
    "voice": "vo_adv_1098003_069",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "原來如此。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n像這麼無防備的話，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "的確是讓人移不開視線呢。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "難怪在路上的熟人也莫名得多。",
    "voice": "vo_adv_1098003_070",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "也就是說，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "因為無法置之不理，所以熟人也跟著增加。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "而且，",
    "voice": "vo_adv_1098003_071",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n還都是無法對放不下心的人置之不理的善人。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "哈！",
    "voice": "vo_adv_1098003_072",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "拉姆是善人？",
    "voice": "vo_adv_1098003_073",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "你別惹人發笑了。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "拉姆只是剛好",
    "voice": "vo_adv_1098003_074",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n和可可蘿約定好才照顧你而已。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "作為證據，",
    "voice": "vo_adv_1098003_075",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n拉姆回去以後馬上就會卸下這個職務了。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "像現在馬上……",
    "voice": "vo_adv_1098003_076",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "――",
    "voice": "vo_adv_1098003_077",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "啊！",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n主人！",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "拉姆小姐！",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您們兩位",
    "voice": "vo_adv_1098003_078",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "到底去了哪裡？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "見您們始終沒有回來，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下感到非常擔心。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "向街上的人到處打聽後，",
    "voice": "vo_adv_1098003_079",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n才聽說您們抱著大行李",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "朝街外走去了……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "只是和有困擾的老婆婆",
    "voice": "vo_adv_1098003_080",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "坐在走廊邊喝了茶而已。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "比起那種事……",
    "voice": "vo_adv_1098003_081",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "――？",
    "voice": "vo_adv_1098003_082",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n拉姆小姐，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您摸在下的頭",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是怎麼了嗎？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "可可蘿，",
    "voice": "vo_adv_1098003_083",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "拉姆撤回那時在店裡的發言。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "{0}",
    "voice": "vo_adv_1098003_084",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n還很需要有個負責照料的人。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "而",
    "voice": "vo_adv_1098003_085",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "擔任那個職務的人就是可可蘿。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n除了妳，沒有其他人能勝任了。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "拉姆小姐……！",
    "voice": "vo_adv_1098003_086",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n您能明白在下了呢！",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下能侍奉主人，",
    "voice": "vo_adv_1098003_087",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n每天到底",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "有多麼感謝這份幸運的心情。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "可可蘿的感謝我才不管呢。",
    "voice": "vo_adv_1098003_088",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n只是",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "為窺見一部分的辛勞而感到滿足而已。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "總之，",
    "voice": "vo_adv_1098003_089",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "這樣工作就結束了。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n之後就全部交給可可蘿……",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "……",
    "voice": "vo_adv_1098003_090",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "喂，{0}。",
    "voice": "vo_adv_1098003_091",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n你為什麼要拉著拉姆的衣角呢？",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "今天過得很開心，",
    "voice": "vo_adv_1098003_092",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n所以希望能再一起到處去走走……？",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "居然能讓主人",
    "voice": "vo_adv_1098003_093",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "變得這麼親近。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "看來",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "和拉姆小姐一起度過的時間相當開心呢。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "拉姆只記得那是段很累人的時間。",
    "voice": "vo_adv_1098003_094",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "……",
    "voice": "vo_adv_1098003_095",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "……",
    "voice": "vo_adv_1098003_096",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "……",
    "voice": "vo_adv_1098003_097",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "啊、",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "真是的。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n別用那種像是被遺棄的小狗的眼神看著。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "知道了。",
    "voice": "vo_adv_1098003_098",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n要是再有機會，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "之後若有那個心情就陪你吧。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "只是，",
    "voice": "vo_adv_1098003_099",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n下次可可蘿絕對要跟在旁邊才行。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "拉姆絕對不要",
    "voice": "vo_adv_1098003_100",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "再代替像處理毀壞物手法的可疑人士一樣，",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "抱著老人家的大行李走路了。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人，",
    "voice": "vo_adv_1098003_101",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n原來您們還遇到了這種事嗎！？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}像是隱藏害羞般地搔著頭。\\n幫助人真不是憑一朝一夕就能順利做好的呢。",
    "voice": null,
    "unit_id": null
  }
]
