  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "自從解開了真相後過了幾天，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n霞與{0}再次來到了海邊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "115700302"
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "嗯，",
    "voice": "vo_adv_1157004_000",
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "果然很漂亮呢……",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "那兩位煙火師傅，",
    "voice": "vo_adv_1157004_001",
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n雖然看起來非常可疑……",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "但手藝真的很棒呢。",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "……",
    "voice": "vo_adv_1157004_002",
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "助手先生。",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n真的",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "很謝謝你。",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "因為我忙著處理【哞哞自衛隊】跟偵探的工作……",
    "voice": "vo_adv_1157004_003",
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n你才會努力想辦法",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "要讓我輕鬆一下對吧。",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "回想起來，",
    "voice": "vo_adv_1157004_004",
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "那時你一直在找我玩耍呢……",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "啊～",
    "voice": "vo_adv_1157004_005",
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "明明是祕密的驚喜，",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n我卻因為奇怪的誤會",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "而不停地想揭穿它，",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n真的很抱歉。",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "background",
    "bg_id": "500162"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "不過，",
    "voice": "vo_adv_1157004_006",
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n我還是覺得瞞著我偷偷行動實在不太好喔。",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "因為我",
    "voice": "vo_adv_1157004_007",
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "是你的雇主。",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我是偵探，",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "而你是我的助手。",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "你必須跟我仔細報告才對，",
    "voice": "vo_adv_1157004_008",
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "或者該說……",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "唔……",
    "voice": "vo_adv_1157004_009",
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我真是個笨蛋。",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n明明很高興",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "他為了我做了這麼多的說……！　",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "算了，",
    "voice": "vo_adv_1157004_010",
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "看在美麗的煙火份上，",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n這次就原諒你吧……",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "咦，",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "奇怪？",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n總覺得",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "煙火的光好像……！？",
    "voice": null,
    "unit_id": 115711
  },
  {
    "type": "background",
    "bg_id": "510160"
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "欸嘿嘿……",
    "voice": "vo_adv_1157004_011",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這本書",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "非常有趣呢。",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "啊！",
    "voice": "vo_adv_1157004_012",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "學長好……！",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n呃，",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "那個……",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這是",
    "voice": "vo_adv_1157004_013",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "以夏天的大海為舞台的",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "推理小說。",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "雖然是懸疑故事，",
    "voice": "vo_adv_1157004_014",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n但是把大海描寫得很開闊，",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "讀起來很暢快。",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "事件本身也是，",
    "voice": "vo_adv_1157004_015",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "不是以恐怖的結局，",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "而是以一種爽快的方式落幕……",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "啊，",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n對不起，",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "要是說得太多",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "就會破哏了。",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "不過，",
    "voice": "vo_adv_1157004_016",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "讀完這本書後，",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n感覺連內心",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "都變得開闊了呢……",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "讓人不禁……",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "也想要去海邊一趟。",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "咦！？",
    "voice": "vo_adv_1157004_017",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n你問我",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "要不要去……？",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "難不成……",
    "voice": "vo_adv_1157004_018",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "是指",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "去海邊？",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我……",
    "voice": "vo_adv_1157004_019",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "跟學長……",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "一起去海邊？",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "怎、",
    "voice": "vo_adv_1157004_020",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "怎麼辦……！",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n沒想到學長會邀我去海邊……！　",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "去海邊就要穿泳裝，",
    "voice": "vo_adv_1157004_021",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "對吧……",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我只有",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "學校上課用的……",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "還、",
    "voice": "vo_adv_1157004_022",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "還是拒絕",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "比較好吧？",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n說不定我的泳裝會讓學長感到很失望……！　",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "得快點回答才行……！",
    "voice": "vo_adv_1157004_023",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "啊嗚……",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "該怎麼辦才好……！？　",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "可是……",
    "voice": "vo_adv_1157004_024",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "難得學長邀請我，",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n這種機會說不定……",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "不會再有下一次了。",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "像是感到害羞，",
    "voice": "vo_adv_1157004_025",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "或是怕讓他失望之類的……",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n這種事情",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "就算想再多也沒用吧……！　",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "……",
    "voice": "vo_adv_1157004_026",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我要去。",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我想跟學長……",
    "voice": "vo_adv_1157004_027",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "一起去海邊……！",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "嗯……！",
    "voice": "vo_adv_1157004_028",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "必須……",
    "voice": "vo_adv_1157004_029",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "去買泳裝才行……！",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "稍、",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "稍微努力一點",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "挑選看看好了……！　",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "background",
    "bg_id": "510250"
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "──我們到了……",
    "voice": "vo_adv_1157004_030",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "好久沒來海邊了……",
    "voice": "vo_adv_1157004_031",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "忽近忽遠的海浪聲、",
    "voice": "vo_adv_1157004_032",
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "撲面而來的鹹鹹海風，",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "以及蔚藍大海與",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "白色沙灘的色彩對比。",
    "voice": null,
    "unit_id": 101431
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "跟讀書時",
    "voice": "vo_adv_1157004_033",
    "unit_id": 101431
  },
