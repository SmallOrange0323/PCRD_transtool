  {
    "type": "dialogue",
    "name": "靜流",
    "words": "……",
    "voice": "vo_adv_9500009_000",
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "弟弟！",
    "voice": null,
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "真的很謝謝你",
    "voice": null,
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "選擇了我！",
    "voice": null,
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n姐姐",
    "voice": null,
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "開心到快不行了呢！",
    "voice": null,
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我決定",
    "voice": "vo_adv_9500009_001",
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "從今天起再也不忍耐了！",
    "voice": null,
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "所以，",
    "voice": null,
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "弟弟也盡情地跟我撒嬌，",
    "voice": null,
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "多多依賴我吧？",
    "voice": null,
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n不論",
    "voice": null,
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "天涯海角，",
    "voice": null,
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我都會將你的一切擁入懷中♪",
    "voice": null,
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "啊……♪",
    "voice": "vo_adv_9500009_002",
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "愛意要溢出來了……！",
    "voice": null,
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n我已經無法壓抑住",
    "voice": null,
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "想緊緊抱住你的心情了……！",
    "voice": null,
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "要是這份心意",
    "voice": null,
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "能全部傳達給弟弟就好了……！",
    "voice": null,
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "以前……",
    "voice": "vo_adv_9500009_003",
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我經常無法陪伴在弟弟身邊。",
    "voice": null,
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n有時候，也只能在一旁默默守護著你……",
    "voice": null,
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "所以，",
    "voice": "vo_adv_9500009_004",
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我才會說什麼「姐姐的祕密行動」，",
    "voice": null,
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n偷偷照顧你，小心不被你發現。",
    "voice": null,
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "好懷念啊♪",
    "voice": null,
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "不過，",
    "voice": "vo_adv_9500009_005",
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我不會再躲藏了。",
    "voice": null,
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n因為弟弟",
    "voice": null,
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "選擇了姐姐啊。",
    "voice": null,
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "弟弟的",
    "voice": "vo_adv_9500009_006",
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "溫柔、",
    "voice": null,
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "堅強、",
    "voice": null,
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "眼淚，",
    "voice": null,
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "還有笑容，",
    "voice": null,
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n姐姐全部都知道喔。",
    "voice": null,
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "所以，",
    "voice": null,
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我也不會輸給你，我會竭盡全力地去愛你、守護你！",
    "voice": null,
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我現在",
    "voice": "vo_adv_9500009_007",
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "在此發誓。",
    "voice": null,
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "作為姐姐，",
    "voice": null,
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "還有，",
    "voice": null,
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "作為搭檔……",
    "voice": null,
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n無論發生什麼事，",
    "voice": null,
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我都絕對、",
    "voice": null,
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "絕～對",
    "voice": null,
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "會讓你幸福的！",
    "voice": null,
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "來，",
    "voice": "vo_adv_9500009_008",
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "緊緊牽著我的手吧？",
    "voice": null,
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "開心的時候也好，",
    "voice": null,
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "難受的時候也好，",
    "voice": null,
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "今後我們都要一起走下去喔。",
    "voice": null,
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "無論未來會怎樣，",
    "voice": null,
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "只要我們在一起，就一定沒問題！",
    "voice": null,
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "全世界我最喜歡你了，",
    "voice": "vo_adv_9500009_009",
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "弟弟。",
    "voice": null,
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n今後，",
    "voice": null,
    "unit_id": 104941
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "也要一直和姐姐在一起喔♪",
    "voice": null,
    "unit_id": 104941
  }
]
