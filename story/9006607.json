[
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "去死吧──！",
    "voice": "vo_adv_9006607_000",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n格林炸……",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "！？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "大家",
    "words": "！！？",
    "voice": "vo_adv_9006607_001",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "突、",
    "voice": "vo_adv_9006607_002",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "突然就被傳回進到巢穴最深處之前的位置了……！？",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是阿剌克涅在退離的同時……",
    "voice": "vo_adv_9006607_003",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n對我們施加了",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "空間跳躍的陷阱吧。",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "通訊魔法的帆稀",
    "words": "「與其說是陷阱，",
    "voice": "vo_adv_9006607_004",
    "unit_id": 106715
  },
  {
    "type": "dialogue",
    "name": "通訊魔法的帆稀",
    "words": "似乎只是移動用的魔法陣呢～",
    "voice": null,
    "unit_id": 106715
  },
  {
    "type": "dialogue",
    "name": "通訊魔法的帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106715
  },
  {
    "type": "dialogue",
    "name": "通訊魔法的帆稀",
    "words": "因為注意力都在具有攻擊性的陷阱上，",
    "voice": null,
    "unit_id": 106715
  },
  {
    "type": "dialogue",
    "name": "通訊魔法的帆稀",
    "words": "就看漏了，",
    "voice": null,
    "unit_id": 106715
  },
  {
    "type": "dialogue",
    "name": "通訊魔法的帆稀",
    "words": "抱歉～」",
    "voice": null,
    "unit_id": 106715
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那隻臭蜘蛛！",
    "voice": "vo_adv_9006607_005",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n事到如今",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "還想要爭取時間嗎！？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "「呵哈哈哈。",
    "voice": "vo_adv_9006607_006",
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n畢竟你們的攻擊",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "實在太過無趣了──",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n若是這樣，",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "吾還不如來睡個午覺。」",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳說什麼……！？",
    "voice": "vo_adv_9006607_007",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "「吾不是說過了嗎？",
    "voice": "vo_adv_9006607_008",
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "吾正在消化。",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n而你們，",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "就連擔任吾的對手都不配。」",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "！",
    "voice": "vo_adv_9006607_009",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "我們對阿剌克涅造成的傷",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "似乎正在恢復……！",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊啊可惡！",
    "voice": "vo_adv_9006607_010",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n好啊，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不管多少次，我都會轟飛妳的！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "沒錯！",
    "voice": "vo_adv_9006607_011",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n而且──",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不管被傳送回來多少次，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我們都一定會把阿剌克涅女士逼至絕境！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "「呵哈哈哈，",
    "voice": "vo_adv_9006607_012",
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n就好好玩玩吧──",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "在吾消化完畢，",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "\\n將從鳳凰那裡奪取的全部權能",
    "voice": null,
    "unit_id": 136013
  },
  {
    "type": "dialogue",
    "name": "阿剌克涅女士",
    "words": "納為己有之前……！」",
    "voice": null,
    "unit_id": 136013
  }
]
