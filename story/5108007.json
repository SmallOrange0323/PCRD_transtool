    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "才要說謝謝呢。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "這次的溫泉旅行，",
    "voice": "vo_adv_5108007_073",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
