  },
  {
    "type": "dialogue",
    "name": "女接待員2",
    "words": "非常感謝。",
    "voice": null,
    "unit_id": 418
  },
  {
    "type": "dialogue",
    "name": "女接待員3",
    "words": "陽卵旅館的女接待員全員一同，",
    "voice": "vo_adv_5108007_071",
    "unit_id": 1512
  },
  {
    "type": "dialogue",
    "name": "女接待員3",
    "words": "向各位獻上感謝之意。",
