    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "老闆娘",
    "words": "沒錯、",
    "voice": "vo_adv_5108007_082",
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "老闆娘",
    "words": "沒錯。",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "老闆娘",
    "words": "\\n很抱歉這麼晚才露面。",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "老闆娘",
    "words": "\\n我就是本旅館──",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "老闆娘",
    "words": "陽卵旅館的老闆娘。",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "聽說妳身體不適，",
    "voice": "vo_adv_5108007_083",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "現在還好嗎？",
