  {
    "type": "dialogue",
    "name": "旁白",
    "words": "與溫泉旅館相關的所有人在尾牙享受、喧鬧並戰鬥。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n而此宴會也即將接近尾聲。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "祈梨",
    "voice": "vo_adv_5108007_000",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "醒醒。",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n不能在這種地方睡覺喔～",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "咕噥……",
    "voice": "vo_adv_5108007_001",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我才沒睡……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我、",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "很清醒……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "妳平時這個時間早就睡了嘛？",
    "voice": "vo_adv_5108007_002",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n不用這麼逞強吧～？",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "今天、",
    "voice": "vo_adv_5108007_003",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不可以……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "睡啦……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "因為、",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "要跟老大……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "嗯～",
    "voice": "vo_adv_5108007_004",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "跟我？",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "啊，",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "是想跟我一起看元旦日出嗎～？",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "祈梨想的事還真可愛耶～",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "要跟……",
    "voice": "vo_adv_5108007_005",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "老大……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "要紅包……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "…………",
    "voice": "vo_adv_5108007_006",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "為什麼要阻止我呢～？",
    "voice": "vo_adv_5108007_007",
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n我只是打算",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "如她所願給她紅包而已啊～？",
    "voice": null,
    "unit_id": 124511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "嗚嘻嘻……",
    "voice": "vo_adv_5108007_008",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "新年我一定要……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "下剋上……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "拜託～！",
    "voice": "vo_adv_5108007_009",
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n只要再一杯揪好～！",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "優花梨小姐……",
    "voice": "vo_adv_5108007_010",
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "不行哦。",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n這樣大家",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "就沒辦法收拾了。",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "不要不要～！",
    "voice": "vo_adv_5108007_011",
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "小栞也",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "一起喝吧？",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "今晚",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "不浪妳睡～喔～！",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "真傷腦筋，",
    "voice": "vo_adv_5108007_012",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "她完全喝醉了呢。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我說你，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "讓她吞下剛才的醒腦藥吧。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "啊，",
    "voice": "vo_adv_5108007_013",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "只要給她一點點就好。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n給太多的話……",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "量可能有點太少了呢。",
    "voice": "vo_adv_5108007_014",
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "再多給一點點……",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "嘿。",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "啊。",
    "voice": "vo_adv_5108007_015",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "咕嘟…",
    "voice": "vo_adv_5108007_016",
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "…！？",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "都已經是大人了，還讓你們看到這麼沒規矩的模樣，真是不好意思。",
    "voice": "vo_adv_5108007_017",
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我要對這次",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "因我感到困擾的各位",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "深深獻上",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "賠罪。",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "咦？",
    "voice": "vo_adv_5108007_018",
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "優花梨小姐……！？",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……算了，",
    "voice": "vo_adv_5108007_019",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "那沒有毒所以是不要緊啦。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "只不過",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "要是攝取太多，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "意識會在一瞬間清醒過來。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "也就是說，",
    "voice": "vo_adv_5108007_020",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "剛才為止的醜態",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "都會鮮明地記在腦海裡。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "對、",
    "voice": "vo_adv_5108007_021",
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "對不起！",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n優花梨小姐……！",
    "voice": null,
    "unit_id": 103813
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "不，",
    "voice": "vo_adv_5108007_022",
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "該道歉的是我。",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我是總會不小心喝太多麥酒，",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "老是給人添麻煩的窩囊廢。",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "從新年開始，我下次、",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "真的、",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "絕對會……",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "只喝一點點。",
    "voice": null,
    "unit_id": 103412
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "啊～嗯，",
    "voice": "vo_adv_5108007_023",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "身體好～熱……",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀伊緒老師，",
    "voice": "vo_adv_5108007_024",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "妳沒事吧？",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我幫妳拿水來吧？",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "美里老師，",
    "voice": "vo_adv_5108007_025",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "不好意思……",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n我好像喝太多了……",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我說你，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "能稍微幫我把衣服鬆開一點嗎……？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "不、",
    "voice": "vo_adv_5108007_026",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "不行啦……！",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n這樣對教育會有不好的影響……！",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "伊緒老師，",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我來幫妳鬆開吧……！",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "謝謝妳……",
    "voice": "vo_adv_5108007_027",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "美里老師……",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀哎呀哎呀，",
    "voice": "vo_adv_5108007_028",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "妳流了這麼多汗。",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n哪裡有",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "乾淨的手巾呢……",
    "voice": null,
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "……不可以往這邊看喔？",
    "voice": "vo_adv_5108007_029",
    "unit_id": 124611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n這對你來說太刺激了。",
    "voice": null,
    "unit_id": 124611
  },
  {
