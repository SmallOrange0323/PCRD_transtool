  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "收拾好囉。",
    "voice": "vo_adv_5108007_067",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n……",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "可能因為大多穿著和服活動，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n換回平時的服裝，有點不習慣呢。",
