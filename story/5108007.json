    "unit_id": 417
  },
  {
    "type": "dialogue",
    "name": "老闆娘",
    "words": "拯救這間旅館的大恩人就要啟程了，",
    "voice": "vo_adv_5108007_080",
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "老闆娘",
    "words": "\\n我可不能繼續躺著睡覺。",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "妳就是……",
    "voice": "vo_adv_5108007_081",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "老闆娘？",
