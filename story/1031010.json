[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "多管閒事的阿姨所引起的騷動結束後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n過了幾天，忍看到{0}在街上奔跑。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "那傢伙在做什麼啊？",
    "voice": "vo_adv_1031010_000",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "是吃了霸王餐在逃命嗎？",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "他才不會做那種事。",
    "voice": "vo_adv_1031010_001",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "但看起來也不像是",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "接了什麼工作的樣子……",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "你好，{0}。",
    "voice": "vo_adv_1031010_002",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "看你跑得那麼快，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "是怎麼了嗎？",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "鍛鍊",
    "voice": "vo_adv_1031010_003",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "嗎？",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "為何突然想這麼做？",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那、",
    "voice": "vo_adv_1031010_004",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那並不是你的錯！",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "反倒是我太不中用，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "才會讓你遇到那種事，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "真是抱歉……",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我會好好守護你，",
    "voice": "vo_adv_1031010_005",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "絕不再讓這種事發生。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "可、",
    "voice": "vo_adv_1031010_006",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "可是……",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "喔喔，",
    "voice": "vo_adv_1031010_007",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "這樣很好！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "只要你稍微爭氣點，",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n就不必給忍添麻煩了。",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n你就一個人跑到世界的盡頭去吧！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "怎麼辦，",
    "voice": "vo_adv_1031010_008",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "因為我的關係，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "給你增添多餘的操勞……",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那天受到你的幫助，",
    "voice": "vo_adv_1031010_009",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我明明已經發誓下次要好好守護你了。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這樣不行，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我得再更確實地……",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不是這樣。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "多管閒事的阿姨也曾說過，",
    "voice": "vo_adv_1031010_010",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n只想單方面地守護你是不行的。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我也要",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "多依賴你一點。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "啊，",
    "voice": "vo_adv_1031010_011",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那個……",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "如果方便的話，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "要不要一起來趟修行之旅呢？",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "妳、",
    "voice": "vo_adv_1031010_012",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "妳在說什麼啊，忍！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "這種事當然是絕對不行！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我、",
    "voice": "vo_adv_1031010_013",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我似乎說了很大膽的提議吧？",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不過，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這種程度的改變肯定是有必要的。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "鍛鍊身體是件好事，",
    "voice": "vo_adv_1031010_014",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "但若要應付幽靈，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "光只是這樣還不夠。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "重要的是，",
    "voice": "vo_adv_1031010_015",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "靈力與精神力",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "也得想辦法提升才行。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "喂，忍，",
    "voice": "vo_adv_1031010_016",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "這可不行喔？",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "我絕對不會答應的！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我會去找尋可以同時鍛鍊這些能力的修行，",
    "voice": "vo_adv_1031010_017",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "所以，請再給我一點時間吧。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不，",
    "voice": "vo_adv_1031010_018",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這點事本來就是我該做的。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n只要能幫上你的忙，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我就很開心了。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "啊……",
    "voice": "vo_adv_1031010_019",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我、",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "也是。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我們一起加油吧……",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "喂，",
    "voice": "vo_adv_1031010_020",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "忍？",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "妳有在聽嗎？",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n妳有在聽",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "爸爸",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "說的話嗎？",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "過了幾天後──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "讓你久等了。",
    "voice": "vo_adv_1031010_021",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "經過多方調查，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我終於找到最理想的修行方式了。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那就是東國所流傳的",
    "voice": "vo_adv_1031010_022",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "「巡禮」。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "據說",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這種修行方式，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n是走遍東國各地，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "被稱為「寺廟」的神聖場所。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "因為是長距離步行，",
    "voice": "vo_adv_1031010_023",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "有助於增強體力與精神力，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "而巡訪靈氣豐沛的場所，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "相信也有助於提高靈力。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "只不過，",
    "voice": "vo_adv_1031010_024",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "蘭德索爾境內並沒有「寺廟」。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "所以，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我想我們可以去尋訪",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "位於海邊或山上，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n靈力充足的地點來取代「寺廟」。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "確實原本就是很嚴苛的修行。",
    "voice": "vo_adv_1031010_025",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "如果我們可以完成，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "一定會有所成長。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "哼，",
    "voice": "vo_adv_1031010_026",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "就你一個人在修行中曝屍荒野吧。",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n不，",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "你現在就給我死在路邊吧。",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "……爸爸，",
    "voice": "vo_adv_1031010_027",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "你不是已經答應這次的修行了嗎？",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "事到如今，請不要說這種話。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "我的確是答應了。",
    "voice": "vo_adv_1031010_028",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "因為只要小伙子能接受鍛鍊，",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n忍就不用再管他了。",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n但是，",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "我不准妳跟小伙子兩人一起去！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "妳想想看？",
    "voice": "vo_adv_1031010_029",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "就你們兩個人待在杳無人煙的大自然之中？",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n身心都獲得釋放的男女會發生什麼事……",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "啊啊啊──！",
    "voice": "vo_adv_1031010_030",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "我絕對不答應！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n你給我用死來賠罪吧，小伙子──！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n……唔，",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "咦？",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "你、",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "你們別丟下我啊──！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "background",
    "bg_id": "500170"
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "第一個地點是位於",
    "voice": "vo_adv_1031010_031",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這座森林深處的樹木。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "據說那是一棵",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "樹齡超過千年的巨樹喔。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "歷史悠久的樹木，",
    "voice": "vo_adv_1031010_032",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "有時會有神明寄宿當中。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "接觸這類樹木，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "應該有助於靈力的提升。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我們趕快過去吧。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "──說到森林，",
    "voice": "vo_adv_1031010_033",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "你有聽說過這種傳聞嗎？",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "在這世界上，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "存在著只要一踏進去，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "就無法再踏出來，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "充滿怨念的",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "魔之森林……",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "呵呵，",
    "voice": "vo_adv_1031010_034",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "別擔心，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這座森林是安全的。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "只是陰暗了點，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不是那麼好走。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "還請你盡可能待在我身邊。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "惡靈們",
    "words": "──嘎喔喔喔！",
    "voice": "vo_adv_1031010_035",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那是惡靈……？",
    "voice": "vo_adv_1031010_036",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n這裡應該不會有惡靈會出現才對……",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "總之，",
    "voice": "vo_adv_1031010_037",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "由我來除去那個惡靈。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "你先離開這裡……",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不對，",
    "voice": "vo_adv_1031010_038",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不是這樣。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這次的修行",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "是我們兩個人要一起達成。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "如果只有我一個人戰鬥，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這樣什麼都沒有改變。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不好意思，",
    "voice": "vo_adv_1031010_039",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "可以麻煩你像之前那樣，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "在我除靈時幫我強化並給予協助嗎？",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "謝謝你。",
    "voice": "vo_adv_1031010_040",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那麼，我們上吧！",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "……",
    "voice": "vo_adv_1031010_041",
    "unit_id": 2411
  },
  {
    "type": "background",
    "bg_id": "501030"
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "──我們到了。",
    "voice": "vo_adv_1031010_042",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "接下來，就往位在這座海岸的洞窟前進吧。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那裡好像供奉著龍神的神像。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "對了，你知道嗎？",
    "voice": "vo_adv_1031010_043",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "海市蜃樓的產生，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n根據其中一種說法表示，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "似乎是由巨大的蛤蜊所引起的呢。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "巨大的蛤蜊",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "雖然感覺有點恐怖，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "但我還是很想見識一下。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "……不，",
    "voice": "vo_adv_1031010_044",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那不是海市蜃樓，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "是惡靈。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我們一路走到這裡，不知已巡訪過多少個點了，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n卻總是有惡靈來襲。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "雖說在靈氣豐沛的地點附近，",
    "voice": "vo_adv_1031010_045",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "容易有幽靈聚集，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "但像這樣頻繁地遇到惡靈來襲，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "總覺得有點不太自然。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "唔！",
    "voice": "vo_adv_1031010_046",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這次連魔物也出現了……",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "是受到惡靈釋放出的",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不良靈氣的影響嗎？",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "可是──",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "是的。",
    "voice": "vo_adv_1031010_047",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "就是這樣。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "再麻煩你像之前那樣，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n幫我強化並協助我對抗魔物。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "……",
    "voice": "vo_adv_1031010_048",
    "unit_id": 2411
  },
  {
    "type": "background",
    "bg_id": "500213"
  },
  {
    "type": "background",
    "bg_id": "500213"
  },
  {
    "type": "dialogue",
    "name": "惡靈們",
    "words": "──嘎喔喔喔！",
    "voice": "vo_adv_1031010_049",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "呼……",
    "voice": "vo_adv_1031010_050",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "看來這是最後一隻呢。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "辛苦你了。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n你已經很習慣這樣的戰鬥方式，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "行動也變得靈活多了。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n這就是修行的成果──",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "咦……？",
    "voice": "vo_adv_1031010_051",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我們走了遠路，還一路戰鬥到這裡來，這也難怪了。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n目的地的祠堂離這裡不遠，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不過，我們先午休一下吧。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "對了……",
    "voice": "vo_adv_1031010_052",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "其實，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我有做了便當喔。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n希望菜色有合你的胃口……",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "咕、",
    "voice": "vo_adv_1031010_053",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "唔……",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "我原以為只要小伙子受到鍛鍊，",
    "voice": "vo_adv_1031010_054",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "忍自然就會離開他，",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n為何我反而感到他們的默契越來越好，甚至比我與忍之間的默契還要好。",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "不僅如此，是因為他已經習慣戰鬥了嗎？",
    "voice": "vo_adv_1031010_055",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "這趟旅行與其說是修行，",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n現在反倒越來越像是出來野餐的！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n就算我能為修行讓步，",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "也絕不允許他們倆曬恩愛！　",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "我已經看不下去了……",
    "voice": "vo_adv_1031010_056",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "喂，",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "小伙子。既然你那麼愛修行，",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "就由我來鍛鍊你吧！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "爸、",
    "voice": "vo_adv_1031010_057",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "爸爸？",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這麼突然是怎麼了？",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "忍妳不要插嘴！",
    "voice": "vo_adv_1031010_058",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "走吧，小伙子！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n這是你死我活的特別課程！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n給我受死吧──",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "呀",
    "voice": "vo_adv_1031010_059",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "……",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "啊啊！",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "祠、",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "祠堂……",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "什、",
    "voice": "vo_adv_1031010_060",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "什麼？",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "我什麼都還沒有做啊！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "被祭祀的幽靈",
    "words": "打擾吾之沉眠的，是汝等這群無禮之徒嗎……！",
    "voice": "vo_adv_1031010_061",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "被祭祀的幽靈",
    "words": "\\n那好，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "被祭祀的幽靈",
    "words": "殺了汝等！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "被祭祀的幽靈",
    "words": "無禮之者格殺勿論！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "嗚哇，",
    "voice": "vo_adv_1031010_062",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "供奉的幽靈跑出來了……",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n而且這傢伙",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "看起來很強……",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "要強行除靈嗎？",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "當然不行！",
    "voice": "vo_adv_1031010_063",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那個……",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "非常抱歉。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n我們會把祠堂修理好的，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "還請原諒我們。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "被祭祀的幽靈",
    "words": "不成！",
    "voice": "vo_adv_1031010_064",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "被祭祀的幽靈",
    "words": "無禮之徒一律格殺勿論！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "這、",
    "voice": "vo_adv_1031010_065",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "這傢伙還真小心眼……",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n沒辦法了，",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "小伙子，",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "你就成為祭品為我們犧牲吧。",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "爸爸……？",
    "voice": "vo_adv_1031010_066",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "咿！",
    "voice": "vo_adv_1031010_067",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "因、",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "因為不這麼做的話那傢伙根本不願原諒我們啊！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "總之，這裡由我來想辦法，",
    "voice": "vo_adv_1031010_068",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "請爸爸安靜點。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我們一再打擾到您，",
    "voice": "vo_adv_1031010_069",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "真的很抱歉。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "雖然不知這樣是否能獲得您的諒解，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "但請容我",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "為您跳一支舞。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "被祭祀的幽靈",
    "words": "跳舞？",
    "voice": "vo_adv_1031010_070",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "被祭祀的幽靈",
    "words": "吾長久以來在此地接受供奉，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "被祭祀的幽靈",
    "words": "\\n從未見過這類東西。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "被祭祀的幽靈",
    "words": "\\n好吧，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "被祭祀的幽靈",
    "words": "汝就跳來看看吧。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "被祭祀的幽靈",
    "words": "不過，跳完之後一樣要殺了你們！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "這傢伙",
    "voice": "vo_adv_1031010_071",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "應該不是受到供奉，",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "而是被封印在這裡的吧？",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那麼……",
    "voice": "vo_adv_1031010_072",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我要開始跳了。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "～～♪",
    "voice": "vo_adv_1031010_073",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "被祭祀的幽靈",
    "words": "喔、",
    "voice": "vo_adv_1031010_074",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "被祭祀的幽靈",
    "words": "喔……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "被祭祀的幽靈",
    "words": "這是……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "被祭祀的幽靈",
    "words": "好美的舞蹈！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "被祭祀的幽靈",
    "words": "\\n吾之殺意",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "被祭祀的幽靈",
    "words": "已逐漸消散……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "呼……",
    "voice": "vo_adv_1031010_075",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "您覺得滿意嗎？",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "被祭祀的幽靈",
    "words": "太棒了……",
    "voice": "vo_adv_1031010_076",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "被祭祀的幽靈",
    "words": "實在太棒了！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "被祭祀的幽靈",
    "words": "\\n汝等的罪過",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "被祭祀的幽靈",
    "words": "全都一筆勾銷吧。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "非常謝謝您。",
    "voice": "vo_adv_1031010_077",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我們之後",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "也會為您修好祠堂的。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "還請您",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "安穩沉眠於此吧。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "哎呀，",
    "voice": "vo_adv_1031010_078",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "真是吃盡了苦頭呢。",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "你還敢說，",
    "voice": "vo_adv_1031010_079",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "你以為這是誰害的？",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "等、",
    "voice": "vo_adv_1031010_080",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "等一下，",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "我是被冤枉的！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n我想",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "那應該不是我造成的……",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "小伙子，",
    "voice": "vo_adv_1031010_081",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "你",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "願意相信我嗎……？",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n那好，",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "我今天就饒你不死，",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "好好感謝我吧。",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "……既然你這麼說，",
    "voice": "vo_adv_1031010_082",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那我",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "明白了。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "爸爸，",
    "voice": "vo_adv_1031010_083",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "對不起，我懷疑了你。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不過，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "請你不要再突然亂發脾氣了。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "呃，",
    "voice": "vo_adv_1031010_084",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "我知道了……",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
