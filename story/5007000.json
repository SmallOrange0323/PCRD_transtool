[
  {
    "type": "background",
    "bg_id": "500260"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "萬聖節的夜晚。忍感應到街上有一股強大的靈力，\\n於是和宮子一同前往拜訪伊莉亞。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "哈～哈哈哈哈～！！",
    "voice": "vo_adv_5007000_000",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n妾身正是",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "統御黑夜的闇之女王，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n伊莉亞‧奧恩斯坦！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "伊莉亞～",
    "voice": "vo_adv_5007000_001",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "妳在做什麼？",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "喔喔～",
    "voice": "vo_adv_5007000_002",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "是宮子和忍啊。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妳們來得正好。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n我有東西要給妳們看看。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "給我們看？　",
    "voice": "vo_adv_5007000_003",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "要看什麼呢？",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "咳咳……",
    "voice": "vo_adv_5007000_004",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "喉嚨的狀態很完美！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "仔細看清楚囉！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "哈～哈哈哈哈～！！",
    "voice": "vo_adv_5007000_005",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n妾身正是",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "統御黑夜的闇之女王，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n伊莉亞‧奧恩斯坦！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "……妳是不是撞到頭了？",
    "voice": "vo_adv_5007000_006",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妳說什麼！妳這失禮的傢伙！",
    "voice": "vo_adv_5007000_007",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "難得妾身正在為征服世界後",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n的介紹詞做準備呢！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "人家知道了，",
    "voice": "vo_adv_5007000_008",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "伊莉亞很閒來的。",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "一點都不閒！　",
    "voice": "vo_adv_5007000_009",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "只是，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "現在妾身也沒有任何關於取回魔力的線索，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "除此之外根本無事可做！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "關於妳的魔力，",
    "voice": "vo_adv_5007000_010",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我得到了個或許可以當成線索的情報喔。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妳說什麼！？　",
    "voice": "vo_adv_5007000_011",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "忍真是幹得好！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "那麼，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妳說的那個情報是？",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "是的。",
    "voice": "vo_adv_5007000_012",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "其實我今早",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "感應到街上某處有一股強大的靈力……",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "哦哦，",
    "voice": "vo_adv_5007000_013",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "靈力嗎？　",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這可真有意思呢。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n的確，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這可能是取回妾身魔力",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "的一個線索。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "因此，",
    "voice": "vo_adv_5007000_014",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我現在正打算過去調查這件事。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "就算這件事和伊莉亞無關，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n我們也不能放任靈力這樣不斷流出。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子也要一起去來的～！　",
    "voice": "vo_adv_5007000_015",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "人家一定會馬上找到線索來的～！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "怎麼回事？　",
    "voice": "vo_adv_5007000_016",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妳這麼有幹勁還真是稀奇啊。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "因為等調查結束後，",
    "voice": "vo_adv_5007000_017",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n忍就答應人家要辦萬聖節派對來的～！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "如果有這種閒功夫，不如想想怎麼征服世界……",
    "voice": "vo_adv_5007000_018",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "雖然",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "想這麼說，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不過偶爾放鬆一下也好。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n妳們就開心的去玩吧。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身雖然也想跟妳們一起去調查，",
    "voice": "vo_adv_5007000_019",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n但街上祭典吵鬧的氣氛，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "實在很不合妾身的個性。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "有什麼事我會再跟妳報告，",
    "voice": "vo_adv_5007000_020",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n而且宮子也在，沒問題的。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這樣啊。",
    "voice": "vo_adv_5007000_021",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "忍會這麼說，應該就是沒問題。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "宮子，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妳可不要給忍添麻煩喔？",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "唔～",
    "voice": "vo_adv_5007000_022",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "人家難得這麼有幹勁，",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "伊莉亞妳真囉嗦～！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "希望妳的幹勁不要往奇怪的方向發展就好了……",
    "voice": "vo_adv_5007000_023",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不過，",
    "voice": "vo_adv_5007000_024",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "原來已經到……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "萬聖節啦……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "伊莉亞？",
    "voice": "vo_adv_5007000_025",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "沒事……",
    "voice": "vo_adv_5007000_026",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這是身為統御黑夜之人給妳們的忠告，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n萬聖節的夜晚，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "也許會有些邪惡的傢伙潛入祭典……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "請務必小心……",
    "voice": "vo_adv_5007000_027",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n因為今晚",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "是一個會發生不可思議事情的日子呢。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "background",
    "bg_id": "505032"
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "雖然伊莉亞說了些令人不安的話，",
    "voice": "vo_adv_5007000_028",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "但街上卻比平時還要熱鬧，充滿活力。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "伊莉亞擔心過頭了啦～",
    "voice": "vo_adv_5007000_029",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "好想趕快舉辦派對來的～",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "呵呵，",
    "voice": "vo_adv_5007000_030",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "說的也是。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "就好好地期待吧。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n為了派對，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我們一起努力調查吧。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "那當然～！",
    "voice": "vo_adv_5007000_031",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "為了增加幹勁，",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "人家帶了比平常更多的布丁來呢～！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "嚼……",
    "voice": "vo_adv_5007000_032",
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "嚼……",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "調查空閒中吃的布丁特別好吃來的～！",
    "voice": null,
    "unit_id": 108211
  },
  {
    "type": "still",
    "still_id": "500700001"
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "啊，",
    "voice": "vo_adv_5007000_033",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
