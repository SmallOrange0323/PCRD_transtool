[
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "…………",
    "voice": "vo_adv_1047008_000",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "唔嗯。",
    "voice": "vo_adv_1047008_001",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n別一直看著我，少年。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "真令人害羞。",
    "voice": "vo_adv_1047008_002",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "平常被面具跟頭盔所遮住的陽光，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n現在迎面照射到雙眼，好刺眼。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "感覺風撫過臉頰，",
    "voice": "vo_adv_1047008_003",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n颼颼地吹著，讓人無法冷靜下來。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "只、只是脫下了頭盔而已就……",
    "voice": "vo_adv_1047008_004",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n像個普通的女孩子一樣，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n如果穿上可愛的衣服，不知道我會變得如何。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "也許會因為羞恥心而爆炸。",
    "voice": "vo_adv_1047008_005",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不過。",
    "voice": "vo_adv_1047008_006",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n既然已經決定這麼做了，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "騎士是決不食言的。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "好好的展現出原本的面貌……",
    "voice": "vo_adv_1047008_007",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n換裝後，與少年去遊玩吃飯。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "因為是我自己想這麼做的。",
    "voice": "vo_adv_1047008_008",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "所以，我會加油的。",
    "voice": "vo_adv_1047008_009",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n沒問題的。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "但是，稍微讓我深呼吸一下。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "吸氣、吐氣……",
    "voice": "vo_adv_1047008_010",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "好了，沒問題的。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "首先在這家服飾店，",
    "voice": "vo_adv_1047008_011",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n買件普通的衣服。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "然後借用更衣室換裝。",
    "voice": "vo_adv_1047008_012",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n接著把脫下的鎧甲跟頭盔，寄放在保險櫃。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "很簡單。",
    "voice": "vo_adv_1047008_013",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我會把這個任務完美的達成給你看。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我會努力的，希望你為我加油。",
    "voice": "vo_adv_1047008_014",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……少年？",
    "voice": "vo_adv_1047008_015",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你不回答的話我會很困擾，會很不安的。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "難道說。",
    "voice": "vo_adv_1047008_016",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n因為我一直磨磨蹭蹭的，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n所以你發呆了嗎？",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "少年？",
    "voice": "vo_adv_1047008_017",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n怎麼了，這樣蹲坐著……",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n身、身體不舒服嗎？",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這是……",
    "voice": "vo_adv_1047008_018",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n少年，睡著了嗎？",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n之前也有，發生過同樣的事吧？",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "真沒用呢，我……",
    "voice": "vo_adv_1047008_019",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n為了自己的事情就已經忙到不行，",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n沒察覺到少年的不尋常。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "是個不及格的騎士，真是丟臉。",
    "voice": "vo_adv_1047008_020",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "沒事吧，少年？",
    "voice": "vo_adv_1047008_021",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "起來了，在這種路邊睡覺是不行的。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不僅會妨礙通行，",
    "voice": "vo_adv_1047008_022",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n一不留神還會被馬車輾過的。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "唔……",
    "voice": "vo_adv_1047008_023",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n好刺眼。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不行……",
    "voice": "vo_adv_1047008_024",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n為什麼呢，連我也變得昏昏欲睡。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這是什麼？",
    "voice": "vo_adv_1047008_025",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n發生了什麼事？",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "background",
    "bg_id": "510040"
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "…………",
    "voice": "vo_adv_1047008_026",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……咦？",
    "voice": "vo_adv_1047008_027",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這裡是，哪裡？",
    "voice": "vo_adv_1047008_028",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n那個……？",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "真奇怪。",
    "voice": "vo_adv_1047008_029",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n記憶一片混亂。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n就像睡昏頭一樣，頭腦無法好好運轉。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我是，白銀純。",
    "voice": "vo_adv_1047008_030",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n二十五歲。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n職業是變裝演員……",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "最近主要在遊樂園裡，",
    "voice": "vo_adv_1047008_031",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n以表演英雄秀維生。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "父親是蒙面摔角手，",
    "voice": "vo_adv_1047008_032",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n母親是代筆作家。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n姊姊是，有名吉祥物的玩偶演員。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "哥哥是，隱藏來歷的占卜師……",
    "voice": "vo_adv_1047008_033",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n妹妹雖然是普通的國中生，",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n但是經常戴著安全帽。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "因為在這樣的家庭長大。",
    "voice": "vo_adv_1047008_034",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n對我來說，隱藏自己的真面目是理所當然的……",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "即使不是站在舞台上工作時，",
    "voice": "vo_adv_1047008_035",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n也像這樣戴著面具。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我記得。",
    "voice": "vo_adv_1047008_036",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n這就是，我。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "明明應該是如此的……",
    "voice": "vo_adv_1047008_037",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n為什麼呢，這個不協調的感覺是？",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……唔？",
    "voice": "vo_adv_1047008_038",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "怎麼回事，發出了慘叫聲？",
    "voice": "vo_adv_1047008_039",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n咦，這個聲音是……？",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "強盜",
    "words": "啊哈哈哈！",
    "voice": "vo_adv_1047008_040",
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "強盜",
    "words": "所有人，都不准動！",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "強盜",
    "words": "\\n",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "強盜",
    "words": "要是做了多餘的舉動，這個小鬼會受傷的喔！",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "媽媽～！",
    "voice": "vo_adv_1047008_041",
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "\\n救我，好可怕啊～",
    "voice": null,
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "！",
    "voice": null,
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "強盜",
    "words": "吵死了！",
    "voice": "vo_adv_1047008_042",
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "強盜",
    "words": "\\n喂喂店員！",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "強盜",
    "words": "\\n把所有的錢塞到這個包包裡！",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "那是，所、所謂的強盜嗎……",
    "voice": "vo_adv_1047008_043",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n怎麼會有這種事，又不是漫畫。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "怎、怎麼辦。",
    "voice": "vo_adv_1047008_044",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n總之，先打電話給警察。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "強盜",
    "words": "哎呀，說了不准動了吧！",
    "voice": "vo_adv_1047008_045",
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "強盜",
    "words": "\\n所有人，把手機丟到腳下！",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "強盜",
    "words": "\\n可別想聯絡警察！",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "唔……",
    "voice": "vo_adv_1047008_046",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n看來是預謀犯罪呢，",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n雖然幼稚又拙劣，但似乎有好好考慮過應付警察的對策。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "孩子們的安全第一，",
    "voice": "vo_adv_1047008_047",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n不能隨便行動呢。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "又不是特攝節目。",
    "voice": "vo_adv_1047008_048",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n對於實際的犯罪行為，",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我什麼都辦不到。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "嗚哇！",
    "voice": "vo_adv_1047008_049",
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "\\n不要不要不要，媽媽～",
    "voice": null,
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "！",
    "voice": null,
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "強盜",
    "words": "喂、喂！",
    "voice": "vo_adv_1047008_050",
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "強盜",
    "words": "\\n不准胡鬧！",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "強盜",
    "words": "\\n殺了你喔，小鬼",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "強盜",
    "words": "！",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "你、你一點都不可怕唷！",
    "voice": "vo_adv_1047008_051",
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "\\n正義的英雄會來打倒壞蛋的！",
    "voice": null,
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "救命啊，虎虎！",
    "voice": "vo_adv_1047008_052",
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "\\n幫幫我～！",
    "voice": null,
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗚、嗚嗚……",
    "voice": "vo_adv_1047008_053",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n小孩子明明在呼救，我卻無法動彈。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "好可怕……",
    "voice": "vo_adv_1047008_054",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n那個強盜手上有刀，",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n要是被刺到的話會死掉的。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "強盜",
    "words": "……嗚喔！？",
    "voice": "vo_adv_1047008_055",
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "欸……？",
    "voice": "vo_adv_1047008_056",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "那是，少年？",
    "voice": "vo_adv_1047008_057",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n為什麼會在這裡？",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "話說，他在做些什麼，",
    "voice": "vo_adv_1047008_058",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n毫無防備地向強盜衝過去……？",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n會被殺掉的！",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "強盜",
    "words": "搞、搞什麼啊這傢伙！？",
    "voice": "vo_adv_1047008_059",
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "強盜",
    "words": "\\n給我讓開！",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗚哇，少年！？",
    "voice": "vo_adv_1047008_060",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n住、住手！",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n這樣毆打他的話會死掉的！",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "強盜",
    "words": "吵死了！",
    "voice": "vo_adv_1047008_061",
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "強盜",
    "words": "\\n是這傢伙逞英雄跑出來的錯！",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "啊……",
    "voice": "vo_adv_1047008_062",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n少年被揍得面目全非了！",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n為、為什麼要做出那麼危險的舉動？",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "強盜",
    "words": "這傢伙，可惡！",
    "voice": "vo_adv_1047008_063",
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "強盜",
    "words": "\\n真令人鬱悶！",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "強盜",
    "words": "\\n真的把你宰了喔…… ！？",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "怎、怎麼辦？",
    "voice": "vo_adv_1047008_064",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n強盜似乎太過激動而忘記自己握著刀子，",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n就這樣放置不理的話，少年會死掉的！",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "咦咦？",
    "voice": "vo_adv_1047008_065",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n為什麼要向我使眼色？",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n你希望我怎麼做呢……？",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "唔……",
    "voice": "vo_adv_1047008_066",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n不能對少年見死不救。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "多虧了有少年引誘住他，",
    "voice": "vo_adv_1047008_067",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n強盜現在正在注意那邊。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "機會來了！",
    "voice": "vo_adv_1047008_068",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n快動啊，我的手腳！",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n現在不行動的話會後悔的！",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "喝啊啊！",
    "voice": "vo_adv_1047008_069",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "強盜",
    "words": "嗚哇喔喔喔！？",
    "voice": "vo_adv_1047008_070",
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "太好了！",
    "voice": "vo_adv_1047008_071",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n突襲的飛踢成功了！",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n強盜總算離開少年他們的身邊了。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "那、那邊的強盜，給你個勸告！",
    "voice": "vo_adv_1047008_072",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n現在馬上停止作惡，投降吧！",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "強盜",
    "words": "這傢伙……！",
    "voice": "vo_adv_1047008_073",
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "強盜",
    "words": "\\n搞什麼，戴著像笨蛋一樣的面具！",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "跟面具無關吧！",
    "voice": "vo_adv_1047008_074",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n總之，把刀子丟下！",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我現在要叫警察了，不准動！",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "強盜",
    "words": "啊！？",
    "voice": "vo_adv_1047008_075",
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "強盜",
    "words": "\\n開什麼玩笑，瞧不起人嗎你這傢伙！",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "強盜",
    "words": "\\n去死吧……！",
    "voice": null,
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "呀啊……",
    "voice": "vo_adv_1047008_076",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n被、被刺到了！？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不對，刀子刺中的是面具！",
    "voice": "vo_adv_1047008_077",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我毫髮無傷！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "多虧了面具被打飛，",
    "voice": "vo_adv_1047008_078",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n可以好好看清前面了！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "能贏！",
    "voice": "vo_adv_1047008_079",
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "104700801"
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "向天祈禱吧，惡徒！",
    "voice": "vo_adv_1047008_080",
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n接受正義的制裁吧……！",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "強盜",
    "words": "啊啊……！？",
    "voice": "vo_adv_1047008_081",
    "unit_id": 1331
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "好，結束了！",
    "voice": "vo_adv_1047008_082",
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n一擊就打倒了！",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n正義必勝！",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "總之，先把不省人事的強盜給綁起來吧……",
    "voice": "vo_adv_1047008_083",
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n啊啊，真是膽戰心驚啊。",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "謝、謝謝你虎虎！",
    "voice": "vo_adv_1047008_084",
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "\\n",
    "voice": null,
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "好可怕啊～！",
    "voice": null,
    "unit_id": 131
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "background",
    "bg_id": "510040"
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯、嗯。",
    "voice": "vo_adv_1047008_085",
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "雖然我只是戴著面具，",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n並不是真的虎虎",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……算了。",
    "voice": "vo_adv_1047008_086",
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n沒事吧，有沒有受傷？",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "很害怕對吧，好乖好乖",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "。",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "欸嘿嘿，沒事的！",
    "voice": "vo_adv_1047008_087",
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "\\n",
    "voice": null,
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "真的很謝謝你喔，大哥哥♪",
    "voice": null,
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯。",
    "voice": "vo_adv_1047008_088",
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n但我不是「大哥哥」，",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n而是「大姐姐」才對喔",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "而且。",
    "voice": "vo_adv_1047008_089",
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n比起向我道謝，",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n還是去向那邊的少年說吧。",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "因為他可是打算賭上性命保護你的呢。",
    "voice": "vo_adv_1047008_090",
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "他才是，真正的英雄。",
    "voice": "vo_adv_1047008_091",
    "unit_id": 104733
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "……好的，辛苦了",
    "voice": "vo_adv_1047008_092",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "雖然我一直都這麼想。",
    "voice": "vo_adv_1047008_093",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你，真的過著令人不可置信的日常生活呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "在這個和平的國家裡被捲進強盜事件，",
    "voice": "vo_adv_1047008_094",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n機率不是微乎其微吧？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "雖然也沒差。",
    "voice": "vo_adv_1047008_095",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n在旁邊看著，也是很有趣……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "萬幸的是。",
    "voice": "vo_adv_1047008_096",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n除了作惡的強盜以外，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n似乎無人傷亡",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "但是。",
    "voice": "vo_adv_1047008_097",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n太過亂來是不行的喔。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那又不是遊戲，",
    "voice": "vo_adv_1047008_098",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n是不能死而復生的。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "開～玩笑的……",
    "voice": "vo_adv_1047008_099",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "對現在的你說那些也沒用啊",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "比起那些，快點醒來吧。",
    "voice": "vo_adv_1047008_100",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "或許眼前的狀況，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n會比強盜事件更難應付也說不定。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "雖然不知道位於「這邊」的純，",
    "voice": "vo_adv_1047008_101",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n設定是如何……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "看見她的真面目，也就表示，",
    "voice": "vo_adv_1047008_102",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n你深入了她所帶著的問題。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "明明好好地給過你忠告，",
    "voice": "vo_adv_1047008_103",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "但你卻無視並和她扯上關係。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "至少別中途放棄，",
    "voice": "vo_adv_1047008_104",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n請你誠實的面對喔",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "要是純沒有行動的話，",
    "voice": "vo_adv_1047008_105",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n也許你就已經被強盜殺害了呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "因為是救命恩人，",
    "voice": "vo_adv_1047008_106",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n不要忘了感謝的心情……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n要好好的珍惜她喔。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "無論何時。",
    "voice": "vo_adv_1047008_107",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n能夠摘下她的面具，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n觸及其心中深處之人……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "都只有你喔。",
    "voice": "vo_adv_1047008_108",
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "…………",
    "voice": "vo_adv_1047008_109",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……嗯、嗯嗯。",
    "voice": "vo_adv_1047008_110",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "咦，我睡著了嗎？",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯……",
    "voice": "vo_adv_1047008_111",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "早安，少年。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "真是抱歉。",
    "voice": "vo_adv_1047008_112",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n果然，我好像還沒恢復常態。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "在約會中不知不覺睡著，",
    "voice": "vo_adv_1047008_113",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n實在是太不知禮儀了呢。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "啊啊不對，這並不是約會啊……",
    "voice": "vo_adv_1047008_114",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "當然，我明白的。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "只是溫柔善良的你，",
    "voice": "vo_adv_1047008_115",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n陪陪寂寞的大姐姐而已。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "呵呵。",
    "voice": "vo_adv_1047008_116",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n即使這樣也感到很高興、很幸福。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我一直都對這種事情很憧憬。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……振作精神，",
    "voice": "vo_adv_1047008_117",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n再度開始行動吧。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "首先，得先尋找替換的衣服呢。",
    "voice": "vo_adv_1047008_118",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "接著，在你推薦的店吃午餐吧。",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "即使沒有戲劇性的事件……",
    "voice": "vo_adv_1047008_119",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我，也相當滿足了。",
    "voice": null,
    "unit_id": 104712
  }
]
