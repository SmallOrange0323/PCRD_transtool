    "voice": "vo_adv_5204065_016",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "天坂‧露易絲‧真璃與倉石惠理子──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n這就是被稱作一生宿敵的兩人的相遇。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "……前世說不定也曾發生過這種事。",
    "voice": null,
    "unit_id": null
  }
]
