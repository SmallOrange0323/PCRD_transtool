  {
    "type": "dialogue",
    "name": "旁白",
    "words": "某天，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n真璃正在圖書館裡查詢東西。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "……{0}的星座是這個，",
    "voice": "vo_adv_5204065_000",
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "\\n",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "而我則是摩羯座，所以……",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "啊！",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "兩人的契合度很完美！",
    "voice": "vo_adv_5204065_001",
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "結婚指數是90％！",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "\\n呵呵。",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "不過，",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "這是當然的吧，{0}♪",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "…………\\n……？",
    "voice": "vo_adv_5204065_002",
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "……{0}？",
    "voice": "vo_adv_5204065_003",
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n跟那位大人同名……",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "但",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "一定是別人吧，",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "因為那位大人已經有我了。",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "哎呀，",
    "voice": "vo_adv_5204065_004",
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我跟{0}大人的姓名判斷，",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "契合度是最好的呢。",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n果然我跟{0}大人",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "命中注定要結為連理。",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "啊啊，",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "{0}大人、",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "{0}大人。",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "……嗯？",
    "voice": "vo_adv_5204065_005",
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "\\n她說{0}大人，",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "為什麼是叫我家達令的名字？",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "\\n",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "……算了，",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "是別人吧，",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "畢竟我才是他的伴侶♪　",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "…………\\n……",
    "voice": "vo_adv_5204065_006",
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "啊，",
    "voice": "vo_adv_5204065_007",
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "這個品牌的新作品出了。",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "\\n在跟{0}的約會中穿的話，",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "\\n他會不會稱讚我呢♪",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "…………\\n……",
    "voice": "vo_adv_5204065_008",
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "哎呀，",
    "voice": "vo_adv_5204065_009",
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "這件針織品真好看呢，",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n我來為{0}大人親手編織吧♪",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "啊，",
    "voice": "vo_adv_5204065_010",
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "這本參考書真好懂──",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "\\n跟{0}兩人一起單獨學習",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "吧！",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "這道甜點",
    "voice": "vo_adv_5204065_011",
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n必須為{0}大人傾注愛意製作才行！",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "{0}！！",
    "voice": "vo_adv_5204065_012",
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "{0}大人！！",
    "voice": "vo_adv_5204065_013",
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "真璃‧惠理子",
    "words": "「妳是誰啊！？」\\n「妳是哪位！？」",
    "voice": "vo_adv_5204065_014",
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "真璃‧惠理子",
    "words": "…………唔。",
    "voice": "vo_adv_5204065_015",
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "真璃‧惠理子",
