    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "哇，真的嗎？",
    "voice": "vo_adv_1402004_007",
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "總覺得有點在意",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "和同族有關的故事呢……",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "那都來讀讀看吧！",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比問你喔，",
    "voice": "vo_adv_1402004_008",
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "這本漫畫裡的吸血鬼，",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n為什麼要睡在這麼狹窄的木箱裡呀？",
