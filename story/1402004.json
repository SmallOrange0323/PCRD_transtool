  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "有了與布武機合作的經驗後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}和班比對進行直播已相當熟練──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "那麼，",
    "voice": "vo_adv_1402004_000",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比的",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "「來閒聊吧♡」台！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n今天也要活力滿滿地開始囉──♪",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "聽眾們",
    "words": "「等好久啦！」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "聽眾們",
    "words": "\\n",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "聽眾們",
    "words": "「我現在已經不看這直播就睡不著了。」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "聽眾們",
    "words": "\\n",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "聽眾們",
    "words": "「小班今天也好可愛呢──」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "今天要來聊什麼才好呢──？",
    "voice": "vo_adv_1402004_001",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "來聊聊布武機，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "或聊聊貝斯，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "還是聊聊其他朋友也不錯！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "啊，",
    "voice": "vo_adv_1402004_002",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "對了！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "有一個名為「吉歐‧格黑納」的世界，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n在那邊有個叫梅杜莎的女生呀，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "最近──",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "呀啊，",
    "voice": "vo_adv_1402004_003",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "好亮喔！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "夜間泳池怎麼突然變白天了！？",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n可、",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "可是明明是白天，",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "卻總覺得、",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "好想睡喔……",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "聽眾們",
    "words": "「這打光會不會太強了？」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "聽眾們",
    "words": "\\n",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "聽眾們",
    "words": "「奇怪？班比已經想睡覺覺啦？」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "聽眾們",
    "words": "\\n",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "聽眾們",
    "words": "「怎麼好像連僕從都沒有反應……？」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "510370"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "炎炎夏日的某一天。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}和班比在",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n涼爽的店內享受著逛街時光。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "哇──",
    "voice": "vo_adv_1402004_004",
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "這家店有好多種圖畫書喔！",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "僕從，",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "你很常來這裡嗎？",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "哦～",
    "voice": "vo_adv_1402004_005",
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "原來這就是那個知名的",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "「漫畫」啊？",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "幾乎沒有看過這種書呢。",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "這裡有好多不同漫畫，",
    "voice": "vo_adv_1402004_006",
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "感覺看得眼花撩亂呢。",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "欸，僕從，",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "哪一本比較有趣呀？",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "快推薦給班比嘛♪",
