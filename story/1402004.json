  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "不會吧，",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "這樣就沒辦法和僕從一起在床上打滾了呀！",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "啊，",
    "voice": "vo_adv_1402004_010",
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "這本漫畫的吸血鬼",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "一接近大蒜就全身無力了！",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比根本不怕大蒜呀！",
