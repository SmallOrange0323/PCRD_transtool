    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "……咦？",
    "voice": "vo_adv_1402004_009",
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "棺材？",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "這是",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "吸血鬼在「漫畫」中的常見設定？",
