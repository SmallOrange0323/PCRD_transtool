  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "雖然蔬果很好吃，班比也會吃沒錯，",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "但這沒辦法代替血吧？",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "啊，",
    "voice": "vo_adv_1402004_012",
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "對耶！",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "因為都是紅色的關係嗎！",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "漫畫好有趣喔──！",
    "voice": null,
    "unit_id": 122331
  },
  {
    "type": "background",
    "bg_id": "510350"
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "呼～",
