[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "不知該送什麼禮物才好的雪菲，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在蘭德索爾四處徘徊，想要找到一點提示。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "穿戴衣飾、",
    "voice": "vo_adv_9005003_000",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "實用品和",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "可以同樂的東西……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "禮物的形式",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "還真是五花八門呢。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "越想越覺得",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "頭大了……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "嗨，那位愁眉苦臉的小姐。",
    "voice": "vo_adv_9005003_001",
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n要來份可麗餅嗎？",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "咦？",
    "voice": "vo_adv_9005003_002",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n拉比林斯達小姐……？",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "哇，",
    "voice": "vo_adv_9005003_003",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這裡的可麗餅",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "真的好好吃啊。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n好吃到舌頭都要融化啦──！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n也很適合作為紀念日的禮物喔──！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "咦咦？",
    "voice": "vo_adv_9005003_004",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n妳是",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "那個……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "弟弟",
    "voice": "vo_adv_9005003_005",
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "最喜歡可麗餅跟姐姐了呢～",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "送給他當禮物肯定會很開心吧～♪",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "靜流小姐……！",
    "voice": "vo_adv_9005003_006",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n妳知道禮物的事……！？",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "那個，",
    "voice": "vo_adv_9005003_007",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "現在有個特別活動，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n可麗餅店【拉比林斯】",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "將會直接到府製作可麗餅！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "這樣哥哥肯定也會非常開心！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "啊……！",
    "voice": "vo_adv_9005003_008",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "這是",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "在推銷……！",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n妳們是想要我在紀念日那天跟妳們訂購大量的可麗餅……！",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "那麼，",
    "voice": "vo_adv_9005003_009",
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "送給少年的禮物就決定是可麗餅了！",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n我將會親自到府",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "為他製作一份",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "特大號可麗餅喔～！",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "不，",
    "voice": "vo_adv_9005003_010",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "那個……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "喂，晶，",
    "voice": "vo_adv_9005003_011",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我已經配合妳唸台詞了，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n差不多可以吃可麗餅了吧～？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "話說回來，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "妳這做法實在太可疑了，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "她不會",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "上這種當吧。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "欸，雪菲！",
    "voice": "vo_adv_9005003_012",
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n說到紀念日就會想到姐姐，",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "說到姐姐就會想到弟弟！",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我這麼說，",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "妳就知道該送什麼了吧！？",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "……這、",
    "voice": "vo_adv_9005003_013",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "這謎語挺困難的呢……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "……呃……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "…………這個嘛…………",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "抱歉，",
    "voice": "vo_adv_9005003_014",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "雪菲。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n要是不趁這個重要時刻賺錢，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n我們店的業績會一直慘澹下去……",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "不得以才出此下策……",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "喂喂，諾維姆，",
    "voice": "vo_adv_9005003_015",
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "妳要吃得更津津有味的樣子才行吧～？",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n那種照台詞唸的呆板語氣達不到宣傳效果啦～！",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "因為我總覺得晶做的",
    "voice": "vo_adv_9005003_016",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "可麗餅……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "吃起來好普通。",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "好像無法讓我誠心露出好吃的表情……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "欸欸，雪菲，",
    "voice": "vo_adv_9005003_017",
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "準備個大箱子，",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n把姐姐放在裡頭，妳覺得怎麼樣？",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n紀念日那天，姐姐會砰～一聲驚喜現身，",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "身上還塗了香甜鮮奶油！",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "那個……",
    "voice": "vo_adv_9005003_018",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "雪菲。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n我想這裡恐怕毫無參考價值，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "還請",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "別當一回事……",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "呃，",
    "voice": "vo_adv_9005003_019",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "好……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n改天我會",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "來吃可麗餅的……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "拉比林斯達等人構思的巧妙經營策略沒能釣到雪菲。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n重振精神後，雪菲繼續踏上旅程。",
    "voice": null,
    "unit_id": null
  }
]
