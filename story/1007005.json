  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "像平常一樣，\\n{0}正在調查宮子成為幽靈的理由。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "吶～～我們回去吧，已經很晚了喲～",
    "voice": "vo_adv_1007005_000",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "你不用這麼努力調查宮子的事也沒關係的～",
    "voice": "vo_adv_1007005_001",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "比起那些，快買布丁給宮子來的～",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "……你不買給宮子嗎？",
    "voice": "vo_adv_1007005_002",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "噗――！小氣鬼來的──！宮子要回去了喲――――！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "background",
    "bg_id": "500020"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "隔天――",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "{0}────！！",
    "voice": "vo_adv_1007005_003",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "大、大消息喲！",
    "voice": "vo_adv_1007005_004",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n宮子……想起變成幽靈之前的事了喲！！！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "今天早上突然",
    "voice": "vo_adv_1007005_005",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "「蹦！」地",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "想起來了喲！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "因為想趕快告訴你，所以急急忙忙地飄來的！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "其實宮子……",
    "voice": "vo_adv_1007005_006",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "是你老婆來的！！！",
    "voice": "vo_adv_1007005_007",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "你會這麼驚訝也不奇怪的～",
    "voice": "vo_adv_1007005_008",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "但是絕對不會錯的～！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "親愛的老公……",
    "voice": "vo_adv_1007005_009",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子一直都好想你喲～！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "啊！想起來的不只這件事來的！",
    "voice": "vo_adv_1007005_010",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "其實宮子……",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "還是老公的妹妹來的！！！",
    "voice": "vo_adv_1007005_011",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "你是親愛的哥哥老公來的～♪",
    "voice": "vo_adv_1007005_012",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "……宮子是妹妹又是老婆很奇怪？",
    "voice": "vo_adv_1007005_013",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "才沒那回事～這是很常見的～",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "還、還有其他的！",
    "voice": "vo_adv_1007005_014",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "其實宮子……",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "是公主來的！",
    "voice": "vo_adv_1007005_015",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子是堂堂血統高貴的魔族王室公主來的～♪",
    "voice": "vo_adv_1007005_016",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "……明明哥哥是人族？",
    "voice": "vo_adv_1007005_017",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "那、那個～有很多不為人知的背景來的～",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n王室的關係是很錯綜複雜的～",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "咻咻咻――",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "總之，還有別的！其實宮子……",
    "voice": "vo_adv_1007005_018",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "是偶像歌手來的！",
    "voice": "vo_adv_1007005_019",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子是身體虛弱的小魔女偶像歌手來的～",
    "voice": "vo_adv_1007005_020",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "哥哥老公你是宮子的頭號粉絲來的～♪",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "而且宮子，",
    "voice": "vo_adv_1007005_021",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n是哥哥老公的女僕來的～！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "哥哥既是老公也是主人喲～♪",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "哥哥老公不相信也無可奈何來的……",
    "voice": "vo_adv_1007005_022",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "但是哥哥老公可是失去記憶的人來的。",
    "voice": "vo_adv_1007005_023",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "你要相信宮子說的喲～♪",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子是公主、偶像和女僕來的！",
    "voice": "vo_adv_1007005_024",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n是很傑出的人來的！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "你聽宮子的話準沒錯的～♪",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "太好了！",
    "voice": "vo_adv_1007005_025",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n宮子最喜歡哥哥老公了喲～！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "可是……哥哥老公卻不記得宮子的事，",
    "voice": "vo_adv_1007005_026",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n宮子覺得",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "好寂寞來的……",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "哥哥老公……",
    "voice": "vo_adv_1007005_027",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n那個很重要的約定，你也不記得了嗎？",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "……嗯。",
    "voice": "vo_adv_1007005_028",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n非常非常重要的……那個約定。",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "哥哥老公，就是這裡喲。",
    "voice": "vo_adv_1007005_029",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子活著時我們曾經約好「再見面時兩個人要一起去喔」，",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n這裡就是那個地方喲～",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "在我們約定的地方……也就是這間銀行，",
    "voice": "vo_adv_1007005_030",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n快把所有存款全部領出來吧～",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "然後用那筆錢去買布丁來的～♪",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "怎麼了，哥哥老公～？",
    "voice": "vo_adv_1007005_031",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "你的錢就是身兼老婆和妹妹也就是宮子的錢來的～",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "快把錢領出來吧～♪",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "……………………嗚嗚，",
    "voice": "vo_adv_1007005_032",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n{0}，你、你的眼神充滿了懷疑來的……",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "你這傢伙快相信宮子，然後把錢領出來喲，{0}！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "啊啊！",
    "voice": "vo_adv_1007005_033",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "那、那個……宮子只是稍微有點叫錯來的～！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "總之只要從銀行領錢出來，然後買布丁請宮子吃的話，",
    "voice": "vo_adv_1007005_034",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n就會有回饋金來的～",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "超划算來的～♪",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "……………………",
    "voice": "vo_adv_1007005_035",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮、宮子突然想起有急事來的……",
    "voice": "vo_adv_1007005_036",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "先回去了～掰掰喲～！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子詐騙集團失敗了來的～",
    "voice": "vo_adv_1007005_037",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "結果宮子真正的身世，仍舊是一個謎團。",
    "voice": null,
    "unit_id": null
  }
]
