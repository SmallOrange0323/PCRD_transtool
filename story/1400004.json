  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "人、",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "人、",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "人！！",
