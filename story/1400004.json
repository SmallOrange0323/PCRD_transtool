    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "平安和你一起迎接開幕的日子，",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我很幸福。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "呵呵！",
    "voice": "vo_adv_1400004_050",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "話雖這麼說，但這不是終點而是起點！",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n從今天開始要繼續",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "不休息地持續工作了！",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "哎呀哎呀，",
    "voice": "vo_adv_1400004_051",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "謝謝你的關心。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……說得也是，",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "那麼，",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我三週後休個假吧。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n少年，",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "把那天的行程空出來。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "再一起",
    "voice": "vo_adv_1400004_052",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "去吃烤魷魚吧。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "這次讓我來請客♪",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就這樣，克蕾琪塔和{0}的夏天，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n開始了第二章。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "以及，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "這個「R＆A度假村」──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n實際上",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "因為克蕾琪塔想到的完美點子，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n而獨占了這個夏天的熱門話題──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "那又是",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "另外一個故事了。",
    "voice": null,
    "unit_id": null
  }
