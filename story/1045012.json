    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "請不要",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "一直盯著空花看哦……",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "虐待狂先生。",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "background",
    "bg_id": "500253"
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "～♪",
    "voice": "vo_adv_1045012_028",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "虐待狂先生，",
    "voice": "vo_adv_1045012_029",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "空花辦到了……！",
    "voice": null,
    "unit_id": 104511
  },
  {
