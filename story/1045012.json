    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "真……",
    "voice": "vo_adv_1045012_030",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "真高興",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "聽你這麼說……！",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n虐待狂先生",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "也很努力幫空花打氣啊……！",
