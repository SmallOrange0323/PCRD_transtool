    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "呀啊！？",
    "voice": "vo_adv_1045012_024",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "對、",
    "voice": "vo_adv_1045012_025",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "對了……",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "必須快點解開詛咒。",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "雖然戒指給的刺激",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "並不壞啦……",
    "voice": null,
    "unit_id": 104511
  },
