  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "沒聽懂啊。",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "\\n啊，",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "啊哈哈……",
    "voice": null,
    "unit_id": 132331
  },
  {
