  {
    "type": "dialogue",
    "name": "真璃",
    "words": "抱歉，{0}。",
    "voice": "vo_adv_4010234_000",
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "\\n放假還叫你到學校來。",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "其實今天",
    "voice": "vo_adv_4010234_001",
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "是我生日。",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "哎呀，",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "你當然不會知道啊。",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "\\n我搬過來之後都還沒機會告訴你嘛。",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "\\n",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "比起這個，",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "我因為想見你就這麼任性叫你過來……",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "對不起。",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "咦，",
    "voice": "vo_adv_4010234_002",
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "生日禮物？",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "啊哈哈，",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "不用準備啦。",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "\\n",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "光是能像這樣",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "跟你一起過生日，",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "\\n我就",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "非常高興了。",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "……等一下。",
    "voice": "vo_adv_4010234_003",
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "今天的我，",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "是不是有點大膽……？",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "\\n",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "這是為什麼呢？",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "因為我長大了一點嗎……？　",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "該、",
    "voice": "vo_adv_4010234_004",
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "該不會……",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "今天就是命中註定的那一天！？",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "\\n一輩子都不會忘的、",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "兩人第一次的紀念日……！？",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "\\n",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "……好，",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "拿出勇氣來……！　",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "那、",
    "voice": "vo_adv_4010234_005",
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "那個……{0}！",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "\\n我、",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "我從第一次見到你的時候就很喜……！",
    "voice": null,
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "就很喜……！！！",
    "voice": "vo_adv_4010234_006",
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "……I have ",
    "voice": "vo_adv_4010234_007",
    "unit_id": 132331
  },
  {
    "type": "dialogue",
    "name": "真璃",
    "words": "feelings for you.\\n（就很喜歡你。）",
