[
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "唔，",
    "voice": "vo_adv_5104302_000",
    "unit_id": 123911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "它好像",
    "voice": null,
    "unit_id": 123911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "變得更強了？",
    "voice": null,
    "unit_id": 123911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 123911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "感覺比剛才戰鬥的時候",
    "voice": null,
    "unit_id": 123911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "還更難纏了……！",
    "voice": null,
    "unit_id": 123911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "打倒的敵人變強以後復活這種橋段，",
    "voice": "vo_adv_5104302_001",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n在勸善懲惡的超級英雄秀中可說是經典吧？",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "好了，",
    "voice": "vo_adv_5104302_002",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "對方還藏著幾張王牌呢？",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "最好準備得充分一點，",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "畢竟那些手牌很快就會用完了♪",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "說得沒錯，",
    "voice": "vo_adv_5104302_003",
    "unit_id": 123911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "不管敵人變得多強，",
    "voice": null,
    "unit_id": 123911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n最後贏得勝利的仍然是我們！",
    "voice": null,
    "unit_id": 123911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "認命吧！",
    "voice": null,
    "unit_id": 123911
  }
]
