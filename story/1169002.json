  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "某天的工廠，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n美冬在朝會中對著職員們如此宣言。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "人手不夠啊！！！",
    "voice": "vo_adv_1169002_000",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "是啊，",
    "voice": "vo_adv_1169002_001",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "多虧你加入，",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n生產效率提升了很多，但是……",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "訂單增加的速度",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "超越了提升的效率。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "嗯，",
    "voice": "vo_adv_1169002_002",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "因為之前下了大訂單的熟識批發商，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "\\n好像有把他對我們的好評擴散出去。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "休假的人也都回來了，",
    "voice": "vo_adv_1169002_003",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "\\n卻還是缺人，這代表……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "果然還是",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "得增加基礎人員才行吧？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "工廠長，",
    "voice": "vo_adv_1169002_004",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我們快來徵打工人員吧。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "希望能徵到人……",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "能不能來些",
    "voice": "vo_adv_1169002_005",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "很熟悉玩具的人呢～",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "過了一陣子後的某一天──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男子們",
    "words": "………………",
    "voice": "vo_adv_1169002_006",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "各位，",
    "voice": "vo_adv_1169002_007",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "早安！",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n今天",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "有幾位新加入的打工人員。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "今天的工作也要",
    "voice": "vo_adv_1169002_008",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "零事故、",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "無傷亡、",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "效率全開！",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n那麼今天",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "也要請各位多多指教了！",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "是啊，",
    "voice": "vo_adv_1169002_009",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我本來還在煩惱要是沒徵到人該怎麼辦……",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n總之是可以暫時放心了呢。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "從今天開始，你也是前輩了，",
    "voice": "vo_adv_1169002_010",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n要是新人有不懂的地方，你要教他們喔。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "好，",
    "voice": "vo_adv_1169002_011",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我來看看新加入的打工人員情況如何……",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "嘿。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "打工的新人1",
    "words": "呃，",
    "voice": "vo_adv_1169002_012",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "打工的新人1",
    "words": "把這邊的板子壓扁……",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "打工的新人1",
    "words": "\\n製作出飛空艇的船體，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "打工的新人1",
    "words": "結束後再拿出來……",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "怎麼樣？",
    "voice": "vo_adv_1169002_013",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "還可以嗎？",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "打工的新人1",
    "words": "啊，",
    "voice": "vo_adv_1169002_014",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "打工的新人1",
    "words": "領班，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "打工的新人1",
    "words": "\\n",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "打工的新人1",
    "words": "雖然我還有點不習慣……",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "打工的新人1",
    "words": "但勉強還行。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "剛進來時每個人都是新手啊。",
    "voice": "vo_adv_1169002_015",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n你別放在心上。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "慢慢來也沒關係，",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "要動作確實",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "並注意安全喔。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "打工的新人1",
    "words": "好的……！",
    "voice": "vo_adv_1169002_016",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "打工的新人1",
    "words": "動作確實，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "打工的新人1",
    "words": "注意安全……",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "打工的新人1",
    "words": "\\n",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "打工的新人1",
    "words": "啊、",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "打工的新人1",
    "words": "啊啊，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "打工的新人1",
    "words": "歪掉了……！",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "打工的新人1",
    "words": "該、",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "打工的新人1",
    "words": "該怎麼辦……",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "做壞的東西",
    "voice": "vo_adv_1169002_017",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "就放進那邊的廢棄物垃圾桶。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n你不必緊張喔。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "打工的新人1",
    "words": "好、",
    "voice": "vo_adv_1169002_018",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "打工的新人1",
    "words": "好的……！",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "打工的新人1",
    "words": "呃，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "打工的新人1",
    "words": "哇、",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "打工的新人1",
    "words": "哇哇……！",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "嗯～",
    "voice": "vo_adv_1169002_019",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "他是那種一被搭話，就沒辦法保持專注的人嗎？",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "來看看情況時最好不要干擾到他啊。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "打工的新人2",
    "words": "領班，",
    "voice": "vo_adv_1169002_020",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "打工的新人2",
    "words": "可以打擾一下嗎？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "打工的新人2",
    "words": "\\n有人要我去拿印刷用的顏料……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "要顏料的話，",
    "voice": "vo_adv_1169002_021",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "就把堆在那邊的拿過去吧。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "啊，",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "要仔細確認顏色喔！",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "如果搞錯就糟……",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "打工的新人3",
    "words": "領班，",
    "voice": "vo_adv_1169002_022",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "打工的新人3",
    "words": "不好意思～！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "打工的新人3",
    "words": "\\n我有些部分",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "打工的新人3",
    "words": "想請妳教我～！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "好，",
    "voice": "vo_adv_1169002_023",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "知道了知道了～！",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我馬上過去～！",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "打工的新人1",
    "words": "謹慎地……",
    "voice": "vo_adv_1169002_024",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "打工的新人1",
    "words": "謹慎地……",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "打工的新人1",
    "words": "呃！",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "打工的新人1",
    "words": "\\n",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "打工的新人1",
    "words": "啊啊！？",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "打工的新人1",
    "words": "又歪掉了……！",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "打工的新人2",
    "words": "呼，",
    "voice": "vo_adv_1169002_025",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "打工的新人2",
    "words": "呼……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "打工的新人2",
    "words": "再來回一次……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "打工的新人2",
    "words": "\\n搬完這份材料就結束了……！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "打工的新人2",
    "words": "嘿喲，",
    "voice": "vo_adv_1169002_026",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "打工的新人2",
    "words": "呼……！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "打工的新人2",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "打工的新人2",
    "words": "嗚",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "打工的新人2",
    "words": "！？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "打工的新人2",
    "words": "我、",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "打工的新人2",
    "words": "我的腰……！？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "打工的新人3",
    "words": "喂喂，",
    "voice": "vo_adv_1169002_027",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "打工的新人3",
    "words": "從剛剛開始，送過來的就只有瑕疵品耶！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "打工的新人3",
    "words": "\\n慘成這樣根本沒辦法品檢。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "打工的新人3",
    "words": "\\n到底是怎麼了！？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "居然會手忙腳亂成這樣，這稍微超出了我的預測……",
    "voice": "vo_adv_1169002_028",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這次又怎麼了！？",
    "voice": "vo_adv_1169002_029",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n──機械的生產線停下來了！？",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "緊急停止！？",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "總而言之，",
    "voice": "vo_adv_1169002_030",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "現在的首要之務是讓生產線恢復運轉！",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n跟工廠長聯絡機械故障的問題！",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n其他的問題",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "就由我來處理！",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "是你啊，",
    "voice": "vo_adv_1169002_031",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "來得正好！",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "總之先延後你手上的所有工作，",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n跟我一起來吧！",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "拜託你了！",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "唉……",
    "voice": "vo_adv_1169002_032",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "剛才那段時光就像暴風雨一樣……",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "在設定工廠這個禮拜的工作量時，",
    "voice": "vo_adv_1169002_033",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我明明有把新人教育也考慮進去，",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "沒想到卻連預期工作量的一半都沒有達到……",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "而且新人們",
    "voice": "vo_adv_1169002_034",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "非常沮喪啊。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n雖說因為一直失敗，這也沒辦法……",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我是很想改變這逐漸沉重的氣氛……",
    "voice": "vo_adv_1169002_035",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n要等待時間來解決這個問題嗎？",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "但這樣效率就會……",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "哇啊！？",
    "voice": "vo_adv_1169002_036",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "嚇、",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "嚇我一跳。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n你別從背後突然冒出來啦。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這樣不是會嚇到人嗎？",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "對了，",
    "voice": "vo_adv_1169002_037",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "已經中午了啊。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "不過，",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "不好意思，",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我要留下來再處理一點工作。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "如果有時間去外面吃飯的話，",
    "voice": "vo_adv_1169002_038",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n我得盡量完成",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "因為發生問題而延宕的工作才行……",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "啊……",
    "voice": "vo_adv_1169002_039",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "原來如此，",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "的確是這樣……",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n你說得對。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我也真是的，",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這樣不行啊。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "明明保持健康也是工作的一部分。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我好像是因為一直想著工作的事情，",
    "voice": "vo_adv_1169002_040",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "才讓視野變狹隘了。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "就算不停歇地繼續工作，",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "也只會讓效率直線下降啊。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "如果遇到瓶頸，",
    "voice": "vo_adv_1169002_041",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "去轉換一下心情或許也能好轉。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我可以",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "和你一起去吃午餐嗎？",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "background",
    "bg_id": "500050"
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "各位，辛苦了～",
    "voice": "vo_adv_1169002_042",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "啊，",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "服務生，",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "請給我一份今日精選午餐～！",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "你也要點這個嗎？",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "不好意思，",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我要改成兩份！",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "打工的新人1",
    "words": "啊，",
    "voice": "vo_adv_1169002_043",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "打工的新人1",
    "words": "打工領班，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "打工的新人1",
    "words": "\\n",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "打工的新人1",
    "words": "辛苦了。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "打工的新人2",
    "words": "真是不好意思啊，",
    "voice": "vo_adv_1169002_044",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "打工的新人2",
    "words": "\\n讓妳代替我工作……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "你別放在心上。",
    "voice": "vo_adv_1169002_045",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "你的腰沒事了嗎？",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "打工的新人2",
    "words": "雖然還有點痛，",
    "voice": "vo_adv_1169002_046",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "打工的新人2",
    "words": "但不至於完全動不了。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "打工的新人2",
    "words": "\\n只是站著工作的話",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "打工的新人2",
    "words": "應該勉強過得去。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "打工的新人2",
    "words": "\\n──我要炒蔬菜定食，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "打工的新人2",
    "words": "請給我半碗飯就好。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "打工的新人3",
    "words": "我聽說一旦傷到腰，傷勢就會復發喔。",
    "voice": "vo_adv_1169002_047",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "打工的新人3",
    "words": "\\n你最好別再做體力活了吧？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "打工的新人3",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "打工的新人3",
    "words": "嗯～",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "打工的新人3",
    "words": "我要來點烤魚定食嗎……",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "打工的新人1",
    "words": "那我就點",
    "voice": "vo_adv_1169002_048",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "打工的新人1",
    "words": "活力定食吧。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "打工的新人1",
    "words": "\\n我要雙份蔬菜，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "打工的新人1",
    "words": "雙份肉，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "打工的新人1",
    "words": "飯要特大碗的。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "打工的新人3",
    "words": "喂喂，",
    "voice": "vo_adv_1169002_049",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "打工的新人3",
    "words": "我說你啊，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "打工的新人3",
    "words": "長得這副樣子，卻挺能吃的耶……",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "打工的新人1",
    "words": "嗯，",
    "voice": "vo_adv_1169002_050",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "打工的新人1",
    "words": "因為我從事的是農業啊。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "打工的新人1",
    "words": "\\n我從以前就是再怎麼吃都胖不起來。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "打工的新人1",
    "words": "是因為都在做體力活嗎？",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "打工的新人1",
    "words": "\\n我就是那種",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "打工的新人1",
    "words": "很耗能量的瘦子大胃王。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "打工的新人1",
    "words": "在這個已經結束收成的時期，",
    "voice": "vo_adv_1169002_051",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "打工的新人1",
    "words": "\\n會像這樣",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "打工的新人1",
    "words": "出來找其他的工作賺錢。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "打工的新人2",
    "words": "哦，",
    "voice": "vo_adv_1169002_052",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "打工的新人2",
    "words": "我跟你相反啊。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "打工的新人2",
    "words": "\\n長特別大的就只有體格，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "打工的新人2",
    "words": "我的興趣卻是裁縫。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "打工的新人2",
    "words": "我會把自己製作的衣服等等",
    "voice": "vo_adv_1169002_053",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "打工的新人2",
    "words": "拿到市集或跳蚤市場去賣……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "打工的新人2",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "打工的新人2",
    "words": "評價出乎意料地還不錯。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "打工的新人2",
    "words": "\\n來，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "打工的新人2",
    "words": "你們看，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "打工的新人2",
    "words": "這條手帕的刺繡花朵",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "打工的新人2",
    "words": "是我特別自豪的作品喔。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "哇，",
    "voice": "vo_adv_1169002_054",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "好漂亮喔！",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "真是了不起。",
