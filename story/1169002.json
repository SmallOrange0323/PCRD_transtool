  },
  {
    "type": "dialogue",
    "name": "打工的新人1",
    "words": "\\n",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "打工的新人1",
    "words": "我好像學不來啊。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "打工的新人1",
    "words": "\\n我對這種細膩的工作一竅不通。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "打工的新人1",
    "words": "我太太總是會罵我啊，",
