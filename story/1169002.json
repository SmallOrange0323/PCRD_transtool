    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "哦，",
    "voice": "vo_adv_1169002_066",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "很厲害耶！",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n你說自己手很巧，並不是在隨口說說啊。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n速度和品質都很完美喔！",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這樣的效率很棒！",
