  },
  {
    "type": "dialogue",
    "name": "打工的新人2",
    "words": "也挺有趣的啊。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "打工的新人2",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "打工的新人2",
    "words": "怎麼樣？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "打工的新人2",
    "words": "我做得還不錯吧？",
