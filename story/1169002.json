    "name": "打工的新人1",
    "words": "領班，",
    "voice": "vo_adv_1169002_067",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "打工的新人1",
    "words": "\\n把要補充的鐵板放在這裡就好了嗎？",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "對，",
