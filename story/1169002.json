  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "\\n",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "這邊是兩份今日精選午餐定食、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "炒蔬菜定食、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "\\n",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "烤魚定食和",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店員",
    "words": "特大碗白飯的活力定食！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "好！",
    "voice": "vo_adv_1169002_064",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "既然都這麼決定了，",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "在好好享用午餐後就回去吧！",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n各位，",
    "voice": null,
    "unit_id": 116911
  },
