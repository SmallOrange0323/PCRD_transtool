    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "打工的新人1",
    "words": "\\n要我別使怪力弄壞農具。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "打工的新人1",
    "words": "\\n",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "打工的新人1",
    "words": "但我不覺得",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "打工的新人1",
    "words": "自己有特別用力啊……",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "人果然",
    "voice": "vo_adv_1169002_057",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "不能只看外表啊。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n沒想到大家都有這樣的特技。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "打工的新人3",
    "words": "因為在面試時不會特別問這個啊。",
    "voice": "vo_adv_1169002_058",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "打工的新人3",
    "words": "我也一樣，",
    "voice": "vo_adv_1169002_059",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "打工的新人3",
    "words": "特技是能把錢算得很好喔？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "打工的新人3",
    "words": "\\n因為我在老家會幫忙店裡的事，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "打工的新人3",
    "words": "帳務大多都能處理。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "……嗯，",
    "voice": "vo_adv_1169002_060",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "是啊，",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "的確是這樣呢。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n這樣是不可能知道的。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我也真是的，",
    "voice": "vo_adv_1169002_061",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "怎麼會漏掉這麼基礎的地方呢……",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n我竟然做出了這麼沒效率的事情！",
