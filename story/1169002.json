    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "\\n商品也賣得很不錯。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "這真讓人開心啊～！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "所以說，",
    "voice": "vo_adv_1169002_082",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "我要發臨時獎金給大家～！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "\\n雖然只有一點點，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "但如果大家能把這當作鼓勵，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "\\n未來也繼續努力，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "我會很高興的。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "大家",
    "words": "唔喔喔喔────！",
    "voice": "vo_adv_1169002_083",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "謝謝你。",
    "voice": "vo_adv_1169002_084",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "你不是有約我去吃飯嗎？",
    "voice": "vo_adv_1169002_085",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n不只是約我，",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "也約了新來的打工人員。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "是因為有那個機會，",
    "voice": "vo_adv_1169002_086",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n我才能掌握到大家的特色。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "多虧於此，我才沒有把沒效率的工作派給他們，",
    "voice": "vo_adv_1169002_087",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n而是分配了高效率",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "又適合他們的工作。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "比起讓他們做無聊又不擅長的工作，",
    "voice": "vo_adv_1169002_088",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n讓他們去做開心又擅長的工作不是比較好嗎？",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "大家能開心地工作……",
    "voice": "vo_adv_1169002_089",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "帶著笑容迎來現在這一刻，",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這都是你的功勞喔。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "不，",
    "voice": "vo_adv_1169002_090",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這都是因為你有邀請我們。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我認為就算我做了同樣的事情，",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "大家也會畏畏縮縮的，",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n沒辦法聊得那麼自然。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "……嗯，",
    "voice": "vo_adv_1169002_091",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "既然你都這麼說了，",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n我是不是也可以稍微抬頭挺胸一點呢？",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "你真的很厲害呢。",
    "voice": "vo_adv_1169002_092",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n或許就是因為你是這樣的人，",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "大家才會信任你。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "……也包含我在內喔，",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "你懂嗎？",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "但大家",
    "voice": "vo_adv_1169002_093",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "真的成長了很多啊。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "……依這個步調，",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "就算再提高工作量，好像也不會有問題呢！",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "男子們",
    "words": "咦。",
    "voice": "vo_adv_1169002_094",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "因為",
    "voice": "vo_adv_1169002_095",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "大家有所成長，",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "就代表能配合這份成長達到更高的目標，不是嗎？",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n最高效率",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "可是要經歷嚴酷而困難的挑戰",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "才能達到的目標喔！",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "呵呵呵，",
    "voice": "vo_adv_1169002_096",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我的鬥志燃燒起來了！",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n好，",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "大家今天也要以更好的效率……",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n達到前所未見的",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "最高生產效率喔！",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "男子們",
    "words": "請、",
    "voice": "vo_adv_1169002_097",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男子們",
    "words": "請饒了我們吧～～～～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就像這樣，在打工領班美冬的指揮下，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n新來的打工人員們今天也堅強地繼續成長著。",
    "voice": null,
    "unit_id": null
  }
]
