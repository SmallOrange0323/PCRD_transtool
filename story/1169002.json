  },
  {
    "type": "dialogue",
    "name": "打工的新人3",
    "words": "到處都有要交給我的工作，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "打工的新人3",
    "words": "\\n我忙得不可開交啊。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "打工的新人3",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "打工的新人3",
    "words": "不過",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "打工的新人3",
    "words": "這樣不會膩，又很刺激，是沒什麼不好。",
