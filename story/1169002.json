  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "辛苦了。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "\\n這一週是特別辛苦的一週。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "\\n要交出大訂單的貨，",
    "voice": null,
    "unit_id": 1411
  },
