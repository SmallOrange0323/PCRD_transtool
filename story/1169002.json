    "type": "dialogue",
    "name": "美冬",
    "words": "下午要來開作戰會議囉！",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "background",
    "bg_id": "501340"
  },
  {
    "type": "dialogue",
    "name": "打工的新人2",
    "words": "嘿，",
