[
  {
    "type": "background",
    "bg_id": "500037"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "綾音幫助了和自己一模一樣的『闇影』後，過了幾天。\\n等注意到時，『闇影』已經消失了蹤影，\\n結果，依然不清楚她到底是什麼東西――",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "即使覺得心裡還有在意的地方，\\n但因忙於進行平安夜派對的準備，\\n綾音漸漸忘了那個不可思議的『闇影』。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "哼哼哼哼哼～♪",
    "voice": "vo_adv_1086003_000",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "哥哥，",
    "voice": "vo_adv_1086003_001",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "這邊這邊！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n找到玩具店了，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n就在這裡買胡桃和可可蘿的禮物吧！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "嗯。",
    "voice": "vo_adv_1086003_002",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我們要在平安夜派對交換禮物對吧？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我不小心忘了挑選禮物，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n所以想說去買點東西好了～♪",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "咲戀媽媽拜託我們買的東西也都買好了，",
    "voice": "vo_adv_1086003_003",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "稍微繞點路再回去也沒關係吧？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "反正我猜哥哥也還沒有買禮物，",
    "voice": "vo_adv_1086003_004",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我們一起選吧♪",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "background",
    "bg_id": "500370"
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "呵呵。",
    "voice": "vo_adv_1086003_005",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "快看快看，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "這裡擺了好多的玩具！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我已經是姊姊了，所以才不會因為玩具感到高興，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n但我覺得胡桃她們會喜歡這種的呢～♪",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "吶吶，",
    "voice": "vo_adv_1086003_006",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "哥哥覺得要選哪個好？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "先不說胡桃了，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n哥哥和可可蘿相處的時間比較久吧？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "而且你們感情也很好，",
    "voice": "vo_adv_1086003_007",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "所以應該知道買什麼玩具可可蘿會開心吧？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "把那個",
    "voice": "vo_adv_1086003_008",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "跟我說！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n我會以自己的品味來挑選禮物，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "但是參考別人的意見應該沒關係吧？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "哥哥覺得",
    "voice": "vo_adv_1086003_009",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "挑哪個玩具可可蘿會喜歡？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "啊，",
    "voice": "vo_adv_1086003_010",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "她好像會喜歡！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "不愧是哥哥，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "真了解她！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "嘿嘿。",
    "voice": "vo_adv_1086003_011",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "可可蘿她",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "好像很喜歡抱著什麼東西呢。",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "她前陣子吃完晚飯後開始想睡覺，還邊打瞌睡",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n邊抱住噗吉呢。",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "『是啊。",
    "voice": "vo_adv_1086003_012",
    "unit_id": 2112
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "那個小姑娘，",
    "voice": null,
    "unit_id": 2112
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n沒有給人會那樣子撒嬌的印象，",
    "voice": null,
    "unit_id": 2112
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n我滿吃驚的呢。』",
    "voice": null,
    "unit_id": 2112
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "欸嘿嘿。",
    "voice": "vo_adv_1086003_013",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "可可蘿雖然很精明能幹，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n但年紀還小啊……",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "所以偶爾會想和人撒嬌吧。",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "其實，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我並不想讓任何人碰噗吉的。",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "但可可蘿的話沒關係，",
    "voice": "vo_adv_1086003_014",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "因為我們已經是家人了。",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "咦？",
    "voice": "vo_adv_1086003_015",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "是嗎？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "但可可蘿還是小孩子啊，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "不是會喜歡玩具之類的嗎？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "嗯嗯……",
    "voice": "vo_adv_1086003_016",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "哥哥覺得送",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "書本、",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n動物",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "或是植物之類的，可可蘿會比較開心？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "啊啊，",
    "voice": "vo_adv_1086003_017",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "的確，可可蘿很常讀書，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n或是給盆栽澆水呢。",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "嘿嘿。",
    "voice": "vo_adv_1086003_018",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n不愧是哥哥，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "很了解家人的事情呢～♪",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "那麼，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我們就去能買到那些東西的店鋪吧？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "background",
    "bg_id": "500037"
  },
  {
    "type": "dialogue",
    "name": "王宮騎士A",
    "words": "動作快！",
    "voice": "vo_adv_1086003_019",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士A",
    "words": "\\n朝那裡去了，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士A",
    "words": "別働隊迂迴到前方堵住她的去路！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士B",
    "words": "總算是讓她無路可逃了，",
    "voice": "vo_adv_1086003_020",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士B",
    "words": "可惡的『闇影』……！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "咦咦！？",
    "voice": "vo_adv_1086003_021",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n怎、怎麼了？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "　怎麼回事？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "『嗯～？",
    "voice": "vo_adv_1086003_022",
    "unit_id": 2112
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n雖然不是很清楚，",
    "voice": null,
    "unit_id": 2112
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "但感覺氣氛很凝重呢……？』",
    "voice": null,
    "unit_id": 2112
  },
  {
    "type": "dialogue",
    "name": "王宮騎士A",
    "words": "……呣？",
    "voice": "vo_adv_1086003_023",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士A",
    "words": "\\n喂，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士A",
    "words": "那邊的人！　",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士A",
    "words": "不准動！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "欸？　",
    "voice": "vo_adv_1086003_024",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "什、什麼？　",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "好可怕，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我沒有做什麼壞事啊……？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "王宮騎士A",
    "words": "……",
    "voice": "vo_adv_1086003_025",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士A",
    "words": "失禮，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士A",
    "words": "認錯人了。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士A",
    "words": "\\n很抱歉用武器對著妳，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士A",
    "words": "讓妳害怕了。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士B",
    "words": "喂，你在做什麼？",
    "voice": "vo_adv_1086003_026",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士B",
    "words": "\\n別働隊與『闇影』進入交戰狀態了，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士B",
    "words": "快去進行援護！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士A",
    "words": "啊，是！　",
    "voice": "vo_adv_1086003_027",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士A",
    "words": "了解！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士A",
    "words": "\\n我立刻趕往現場！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "……呃？　",
    "voice": "vo_adv_1086003_028",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "到、到底是怎麼回事？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n他們是負責這城鎮警備的",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n【王宮騎士團】吧，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "嚇死我了～！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "『唔～嗯？",
    "voice": "vo_adv_1086003_029",
    "unit_id": 2112
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n他們是不是說『闇影』怎麼了？』",
    "voice": null,
    "unit_id": 2112
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "……啊、",
    "voice": "vo_adv_1086003_030",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "不會吧！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "『唔哇？　",
    "voice": "vo_adv_1086003_031",
    "unit_id": 2112
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "喂，怎麼了，綾音？",
    "voice": null,
    "unit_id": 2112
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n別突然跑起來，",
    "voice": null,
    "unit_id": 2112
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "會跌倒的！』",
    "voice": null,
    "unit_id": 2112
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "不好了！",
    "voice": "vo_adv_1086003_032",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n他把我和『闇影』認錯就表示",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "他們說不定……",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "正在追",
    "voice": "vo_adv_1086003_033",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n我們前陣子遇到的那個和我一模一樣的『闇影』！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "『闇影』就像魔物般的存在，不是嗎？",
    "voice": "vo_adv_1086003_034",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "如果被【王宮騎士團（NIGHTMARE）】發現了，\\n說不定會被他們驅除掉。",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我",
    "voice": "vo_adv_1086003_035",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "沒辦法置之不理！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "因為那孩子，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "那個『闇影』和我一模一樣啊！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n那孩子",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "就是另一個我……！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "background",
    "bg_id": "500024"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "之後，綾音等人全速全力\\n追趕著【王宮騎士團（NIGHTMARE）】――",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "但是當她們抵達目擊到『闇影』的現場時，\\n戰鬥已經結束了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "而詢問在場的\\n【王宮騎士團（NIGHTMARE）】成員後，\\n得知『闇影』似乎已經遭到討伐了……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "…………",
    "voice": "vo_adv_1086003_036",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "『喂、喂。",
    "voice": "vo_adv_1086003_037",
    "unit_id": 2112
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "打起精神來啊，綾音。",
    "voice": null,
    "unit_id": 2112
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n被驅除的『闇影』，",
    "voice": null,
    "unit_id": 2112
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "又還沒確定\\n就是和綾音一模一樣的『闇影』啊。』",
    "voice": null,
    "unit_id": 2112
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "可是……",
    "voice": "vo_adv_1086003_038",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我覺得大概就是她。",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n因為【王宮騎士團（NIGHTMARE）】的人也說了啊，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "那是外表和我很像的『闇影』。",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "那孩子，",
    "voice": "vo_adv_1086003_039",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "被驅除了啊……",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n這也無可奈何，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "因為『闇影』就是類似魔物的存在啊。",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "可是，",
    "voice": "vo_adv_1086003_040",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "那孩子，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我們在一開始見到她的時候，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n她和我的爸爸媽媽牽著手走路。",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "她代替我這個離家出走的壞孩子，",
    "voice": "vo_adv_1086003_041",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "好好地當了爸爸媽媽的『女兒』啊。",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "她代替『家人』、",
    "voice": "vo_adv_1086003_042",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "代替『我』……",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "挑選禮物，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n打算在聖誕節送給爸爸媽媽讓他們開心。",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "她比我",
    "voice": "vo_adv_1086003_043",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "做得更像『我』啊。",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "……比起在某天，",
    "voice": "vo_adv_1086003_044",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "突然",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "說什麼爸爸媽媽看起來像是冒牌貨開始。",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n結果因為害怕，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "而用莫名其妙的理由離開了家裡的我――",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "那孩子，",
    "voice": "vo_adv_1086003_045",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "更像是『我』啊。",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "她愛著爸爸媽媽，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "療癒他們、",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "讓他們幸福。",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "然而，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "不是我這個壞孩子，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "反而卻是那孩子被驅除消失。",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "那樣子",
    "voice": "vo_adv_1086003_046",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "太不公平了。",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "太過份了，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "該消失的人應該是我才對。",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "『綾音……",
    "voice": "vo_adv_1086003_047",
    "unit_id": 2112
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "不是那樣的，",
    "voice": null,
    "unit_id": 2112
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "絕對不是。",
    "voice": null,
    "unit_id": 2112
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n妳如果消失了，",
    "voice": null,
    "unit_id": 2112
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "我會很寂寞的。』",
    "voice": null,
    "unit_id": 2112
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "『{0}和其他的大家，",
    "voice": "vo_adv_1086003_048",
    "unit_id": 2112
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n【咲戀育幼院】的家人們都會悲傷的。",
    "voice": null,
    "unit_id": 2112
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n所以再也不要",
    "voice": null,
    "unit_id": 2112
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "說什麼自己應該消失了。』",
    "voice": null,
    "unit_id": 2112
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "嗯……",
    "voice": "vo_adv_1086003_049",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n謝謝，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "噗吉。",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "可是我，",
    "voice": "vo_adv_1086003_050",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "完全無法接受。",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n我不明白，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "那孩子到底是什麼？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "『闇影』到底是什麼？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "這個世界正在發生什麼可怕的事情，",
    "voice": "vo_adv_1086003_051",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n可是我還是小孩子，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我很笨，所以什麼都無法理解。",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "那讓我覺得有點",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "不甘心呢。",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音？",
    "words": "『…………』",
    "voice": "vo_adv_1086003_052",
    "unit_id": 102321
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "……咦？　",
    "voice": "vo_adv_1086003_053",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "奇、奇怪？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n妳是",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "那個『闇影』？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "妳沒事嗎？　",
    "voice": "vo_adv_1086003_054",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "太好了！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n我",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "還以為妳被驅除了呢……？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音？",
    "words": "『……的』",
    "voice": "vo_adv_1086003_055",
    "unit_id": 102321
  },
  {
    "type": "dialogue",
    "name": "綾音？",
    "words": "『爸爸、媽媽……』",
    "voice": null,
    "unit_id": 102321
  },
  {
    "type": "dialogue",
    "name": "綾音？",
    "words": "『……呢……？』",
    "voice": null,
    "unit_id": 102321
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "咦，什麼？",
    "voice": "vo_adv_1086003_056",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n比起這個，『闇影』，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "是不是在閃爍？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "好像在漸漸消失……",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "怎、怎麼了嗎？　",
    "voice": "vo_adv_1086003_057",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "果然\\n【王宮騎士團（NIGHTMARE）】的人對妳做了很過分的事？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "所以妳才快要死了，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "快要消失……了？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音？",
    "words": "『……喔』",
    "voice": "vo_adv_1086003_058",
    "unit_id": 102321
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "咦？",
    "voice": "vo_adv_1086003_059",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n哇哇！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "『闇影』把什麼東西丟過來了！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "這個是……？",
    "voice": "vo_adv_1086003_060",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n是前陣子，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我替她付錢買的禮物？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n是『闇影』打算買下來",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "送給爸爸媽媽的禮物……？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音？",
    "words": "『……拜託妳』",
    "voice": "vo_adv_1086003_061",
    "unit_id": 102321
  },
  {
    "type": "dialogue",
    "name": "綾音？",
    "words": "『我……』",
    "voice": null,
    "unit_id": 102321
  },
  {
    "type": "dialogue",
    "name": "綾音？",
    "words": "『最喜歡",
    "voice": null,
    "unit_id": 102321
  },
  {
    "type": "dialogue",
    "name": "綾音？",
    "words": "爸爸媽媽了……』",
    "voice": null,
    "unit_id": 102321
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "啊、",
    "voice": "vo_adv_1086003_062",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "啊啊！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "消失了，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "『闇影』！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "她到哪裡去了？",
    "voice": "vo_adv_1086003_063",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n妳別躲起來，快出來！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "回答我！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "這種東西",
    "voice": "vo_adv_1086003_064",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "妳就算把禮物……交給我也很困擾啊！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n把這個",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "交給爸爸媽媽就好了嗎？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "要我代替妳去？　",
    "voice": "vo_adv_1086003_065",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "是這個意思嗎？",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "可是，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我是不行的啊……",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "爸爸媽媽不會開心的，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "因為我是離家出走的壞孩子。",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "這應該要由好孩子的妳去送才對，",
    "voice": "vo_adv_1086003_066",
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "就算妳是『闇影』也一樣！",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "對爸爸媽媽來說，",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n大概妳才是",
    "voice": null,
    "unit_id": 108611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "『真正的孩子』啊……！",
    "voice": null,
    "unit_id": 108611
  }
]
