  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……！",
    "voice": "vo_adv_9500027_000",
    "unit_id": 104742
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n{0}少年，",
    "voice": null,
    "unit_id": 104742
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你真的對我……",
    "voice": null,
    "unit_id": 104742
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n不──",
    "voice": null,
    "unit_id": 104742
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……呵呵，",
    "voice": "vo_adv_9500027_001",
    "unit_id": 104742
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我知道的。",
    "voice": null,
    "unit_id": 104742
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你一定是在開玩笑吧。",
    "voice": null,
    "unit_id": 104742
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n畢竟我和你，",
    "voice": null,
    "unit_id": 104742
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "簡直就像大人和小孩一樣。",
    "voice": null,
    "unit_id": 104742
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n況且我……",
    "voice": null,
    "unit_id": 104742
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "也無法在眾人面前",
    "voice": null,
    "unit_id": 104742
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "脫下這頂粗獷的頭盔……",
    "voice": null,
    "unit_id": 104742
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……少年……",
    "voice": "vo_adv_9500027_002",
    "unit_id": 104742
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我現在",
    "voice": null,
    "unit_id": 104742
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "一定是在聽著……",
    "voice": null,
    "unit_id": 104742
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我一直、一直",
    "voice": null,
    "unit_id": 104742
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "都很想聽見的話……",
    "voice": null,
    "unit_id": 104742
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不過，",
    "voice": "vo_adv_9500027_003",
    "unit_id": 104742
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我真的能夠實現",
    "voice": null,
    "unit_id": 104742
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你所期望的事情嗎？",
    "voice": null,
    "unit_id": 104742
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我是",
    "voice": null,
    "unit_id": 104742
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "【王宮騎士團】的團長。",
    "voice": null,
    "unit_id": 104742
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n已將自己",
    "voice": null,
    "unit_id": 104742
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "奉獻給守護之責。",
    "voice": null,
    "unit_id": 104742
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "恐怕無法時刻陪在你身邊。",
    "voice": null,
    "unit_id": 104742
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "為了",
    "voice": "vo_adv_9500027_004",
    "unit_id": 104742
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "守護國家、",
    "voice": null,
    "unit_id": 104742
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "守護人民，",
    "voice": null,
    "unit_id": 104742
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "以及守護和平……",
    "voice": null,
    "unit_id": 104742
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……",
    "voice": "vo_adv_9500027_005",
    "unit_id": 104742
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n{0}少年……",
    "voice": null,
    "unit_id": 104742
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……好害羞啊。",
    "voice": "vo_adv_9500027_006",
    "unit_id": 104741
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 104741
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這是至今為止最……",
    "voice": null,
    "unit_id": 104741
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我現在一定",
    "voice": null,
    "unit_id": 104741
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "露出了",
    "voice": null,
    "unit_id": 104741
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "宛如普通女孩子的神情吧。",
    "voice": null,
    "unit_id": 104741
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "就彷彿被",
    "voice": "vo_adv_9500027_007",
    "unit_id": 104741
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "自己暗戀已久的",
    "voice": null,
    "unit_id": 104741
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104741
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "男同學告白一樣。",
    "voice": null,
    "unit_id": 104741
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我可以接受",
    "voice": "vo_adv_9500027_008",
    "unit_id": 104741
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "少年的心意嗎？",
    "voice": null,
    "unit_id": 104741
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104741
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我也……",
    "voice": null,
    "unit_id": 104741
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "可以坦率地面對……",
    "voice": null,
    "unit_id": 104741
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "自己的心意嗎？",
    "voice": null,
    "unit_id": 104741
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104741
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我喜歡你──",
    "voice": null,
    "unit_id": 104741
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這樣的心意。",
    "voice": null,
    "unit_id": 104741
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "少年。",
    "voice": "vo_adv_9500027_009",
    "unit_id": 104741
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "希望",
    "voice": null,
    "unit_id": 104741
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你能一直看著",
    "voice": null,
    "unit_id": 104741
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我的",
    "voice": null,
    "unit_id": 104741
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "真容。",
    "voice": null,
    "unit_id": 104741
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n希望你能一直",
    "voice": null,
    "unit_id": 104741
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "在我身邊……",
    "voice": null,
    "unit_id": 104741
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104741
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "陪伴著我……",
    "voice": null,
    "unit_id": 104741
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "直、",
    "voice": null,
    "unit_id": 104741
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "直到永遠……",
    "voice": null,
    "unit_id": 104741
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "然後，",
    "voice": "vo_adv_9500027_010",
    "unit_id": 104741
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我們一起守護吧。",
    "voice": null,
    "unit_id": 104741
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104741
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "握緊彼此的手──",
    "voice": null,
    "unit_id": 104741
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "守護那向前綿延的",
    "voice": null,
    "unit_id": 104741
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "未來。",
    "voice": null,
    "unit_id": 104741
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "那屬於我們兩人的未來。",
    "voice": null,
    "unit_id": 104741
  }
]
