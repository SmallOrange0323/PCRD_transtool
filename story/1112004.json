  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 111211
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哥哥是不想回家到發光了嗎～！？",
