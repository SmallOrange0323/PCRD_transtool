  {
    "type": "dialogue",
    "name": "禊",
    "words": "是什麼啊……",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哇！　",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "裡面有鑰匙！！",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n這個是寶藏的鑰匙吧！？",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "寶箱在哪裡？",
