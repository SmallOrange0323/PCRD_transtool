  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哥哥。",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n把地圖拿出來再看一次嗎？",
