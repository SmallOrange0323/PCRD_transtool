    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "嗯――",
    "voice": "vo_adv_1112004_011",
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哥哥都這麼說的話……",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "啊――！！",
    "voice": "vo_adv_1112004_012",
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n地圖飛走了――！！",
    "voice": null,
