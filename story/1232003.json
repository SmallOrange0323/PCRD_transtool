[
  {
    "type": "background",
    "bg_id": "501850"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "綾音等人跨越無數難關，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n終於抵達夢幻古文明普烏的入口。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "一夥",
    "words": "緊張……",
    "voice": "vo_adv_1232003_000",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「這裡就是……",
    "voice": "vo_adv_1232003_001",
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "自古以來與外界隔絕，",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n發展出獨特文化的",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "夢幻古文明",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "普烏……！」",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "準備好了嗎？",
    "voice": "vo_adv_1232003_002",
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我要把石鑰插進",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "鑰匙孔裡了……！",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "哇，",
    "voice": "vo_adv_1232003_003",
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "打開了……！！",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "background",
    "bg_id": "500403"
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「喔喔喔……！",
    "voice": "vo_adv_1232003_004",
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "這裡就是……！」",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "那是……",
    "voice": "vo_adv_1232003_005",
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "噗吉石像！？",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n和照片上看到的一模一樣。",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "普烏的居民們",
    "words": "窸窸窣窣……！",
    "voice": "vo_adv_1232003_006",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「……喂，",
    "voice": "vo_adv_1232003_007",
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "普烏的居民們……",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "都在看我們這裡耶。」",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "喔喔喔……",
    "voice": "vo_adv_1232003_008",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "喔喔喔",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "喔喔喔！",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "\\n這是……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "這是……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "真是不勝惶恐！",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "大家，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "快低頭行禮！",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "普烏的居民們",
    "words": "遵命────！",
    "voice": "vo_adv_1232003_009",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "哇！",
    "voice": "vo_adv_1232003_010",
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "大家都在向噗吉",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "下跪行禮……！？",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "──咦咦！！",
    "voice": "vo_adv_1232003_011",
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n噗吉……",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "是神明嗎！？",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "沒錯。",
    "voice": "vo_adv_1232003_012",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "祂是我們普烏人民自古以來信仰至今，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "攜手共度苦難的",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "神明。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "\\n祂高貴的身姿，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "喔喔喔……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "現在化為現實，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "出現在這裡……！",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「喂，",
    "voice": "vo_adv_1232003_013",
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "綾音，妳看那裡，",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "放了我的石像的地方。",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n那個地方顯然是座祭壇。",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "看樣子他說的神明",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "是真的。」",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "真的耶……",
    "voice": "vo_adv_1232003_014",
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "雖然石像很古老，卻被擦得閃閃發亮，",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n感覺像是從有點高的地方",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "悠然地守護著大家……",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "不管怎麼看",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "都是神明……",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "普烏的居民",
    "words": "──幾位貴客。",
    "voice": "vo_adv_1232003_015",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "普烏的居民",
    "words": "雖然是粗茶淡飯，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "普烏的居民",
    "words": "但我們已經準備好餐點。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "普烏的居民",
    "words": "\\n要是不合貴客的口味，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "普烏的居民",
    "words": "請不用介意直接吐掉。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "哇，",
    "voice": "vo_adv_1232003_016",
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "好豐盛的大餐！",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "好像",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "還有漂亮的大姐姐敬仰著噗吉……",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n大家非常開心地",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "圍在噗吉身邊。",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "這是當然的……！",
    "voice": "vo_adv_1232003_017",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "\\n我們長年盼望著",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "神明的復活。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "神明既是普烏的文化，",
    "voice": "vo_adv_1232003_018",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "也是歷史，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "說是普烏本身也不為過，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "是尊貴偉大的存在……！",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "喔喔喔，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "神明大人散發的光芒射入",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "我年邁污穢的雙眼……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "來來來，請享用餐點……",
    "voice": "vo_adv_1232003_019",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "大家！",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "立刻著手準備「神明復活祭」──！",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "普烏的居民們",
    "words": "遵命────！",
    "voice": "vo_adv_1232003_020",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「神明復活祭啊。",
    "voice": "vo_adv_1232003_021",
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n演變成不得了的大事了呢。」",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "噗吉，",
    "voice": "vo_adv_1232003_022",
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "太驚人了……！",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "你竟然是神明，我好驚訝……",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "不過，如果你是神明，",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "就難怪",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "你會擁有人心，",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "還會說話了。",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "其實我早就覺得，",
    "voice": "vo_adv_1232003_023",
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "你是一個非比尋常的存在……",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "結果遠遠超出我的想像。",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我感到很驕傲喔，噗吉……！　",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「我說，綾音，",
    "voice": "vo_adv_1232003_024",
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "我可以說實話嗎？",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n我啊……",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "這個狀況……」",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「實在再適合我不過了！",
    "voice": "vo_adv_1232003_025",
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n每當我被尊稱為神明的時候，",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "就像是有人",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "輕柔撫摸我的胸口。",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n我體內的綿毛在大喊",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "『沒錯，",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "這裡肯定就是我的起源』。」",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "噗吉……",
    "voice": "vo_adv_1232003_026",
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "……嗯，",
    "voice": "vo_adv_1232003_027",
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我也是這麼認為。",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n聽你這麼一說，",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "噗吉一直以來給人的感覺",
    "voice": null,
    "unit_id": 123211
  },
  {
