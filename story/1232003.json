  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我們成功了，噗吉！",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n我們只用一擊……",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "就擊倒大群魔物了！",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「呼……",
    "voice": "vo_adv_1232003_081",
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "呼……",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "知道厲害了吧。」",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "普烏的居民們",
    "words": "窸窸窣窣……！",
    "voice": "vo_adv_1232003_082",
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "奇怪，",
    "voice": "vo_adv_1232003_083",
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "普烏的居民們又開始騷動了……",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "他們該不會更生氣了吧……？",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "什麼……",
    "voice": "vo_adv_1232003_084",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "剛才的力量是什麼……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "\\n只用一擊",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "就把數量驚人的魔物……？",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "他不是一般人……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "不對，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "這是",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "神明所為……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "……新的……",
    "voice": "vo_adv_1232003_085",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "神明……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "新的神明！",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "新",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "長老",
    "words": "的神明駕到了────！",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "……咦？",
    "voice": "vo_adv_1232003_086",
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「喂喂喂，",
    "voice": "vo_adv_1232003_087",
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "你說新的神明。",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n神明的存在意外地隨便啊。",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n欸你們這群人，",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "不要態度突然轉變還跪拜我啊！」",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "──噗、",
    "voice": "vo_adv_1232003_088",
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "呵呵呵。",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「綾音，現在不是笑的時候吧～」",
    "voice": "vo_adv_1232003_089",
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "抱歉。",
    "voice": "vo_adv_1232003_090",
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "不過，",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我覺得啊，",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "這表示不管是不是神明，",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "噗吉都是特別的存在喔。",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「……哼。",
    "voice": "vo_adv_1232003_091",
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "總之，",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "妳說的沒錯。",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "這表示不管我是什麼人，",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n我都是世界上獨一無二的",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "噗吉！」",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "……",
    "voice": "vo_adv_1232003_092",
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "嗯！",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "雖然自己並非神明，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n但噗吉提升了對自身存在的自信和驕傲。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "然後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在綾音等人耐心解釋他大概不是新的神明之後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n終於得到了普烏人民的理解。",
    "voice": null,
    "unit_id": null
  }
]
