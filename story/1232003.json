    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "遭到背叛時的傷害也就越深。",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n……只不過……",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "該說是我也有點",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "受到打擊嗎……」",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "噗吉……",
    "voice": "vo_adv_1232003_070",
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "也對……",
