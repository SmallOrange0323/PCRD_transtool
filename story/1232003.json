    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "那群傢伙會生氣",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "也是理所當然的。",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n信仰之心",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "越是純粹，",
