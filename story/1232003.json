    "name": "綾音 ",
    "words": "沒事吧……？",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「我沒事……",
    "voice": "vo_adv_1232003_069",
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "唉，",
