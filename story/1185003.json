    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "我要直接和在外面待命的人員一起衝進現場了。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n照原本預定，懇請花凜小姐",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "和我們一起行動。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "知道了。",
    "voice": "vo_adv_1185003_035",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "不好意思{0}，",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我就先告辭嘍。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我畢竟只是去見證而已",
    "voice": "vo_adv_1185003_036",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "倒也沒什麼事要做……",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我會努力的。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "background",
    "bg_id": "500891"
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "……呃，",
    "voice": "vo_adv_1185003_037",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "為什麼你也跟著來了呢？",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "目的地恰巧相同",
    "voice": "vo_adv_1185003_038",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "這樣是嗎。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "只要不會妨礙到我們就沒問題。",
    "voice": "vo_adv_1185003_039",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n那麼就，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "出動逮捕人犯了。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "快出來！",
    "voice": "vo_adv_1185003_040",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n我們已經知道你們躲在這裡了！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "把門踹開也無所謂是吧！！",
    "voice": "vo_adv_1185003_041",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "等、等一下！",
    "voice": "vo_adv_1185003_042",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n這裡危險請你退開！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "……咦？",
    "voice": "vo_adv_1185003_043",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "這裡的居民早就搬家了……？",
    "voice": "vo_adv_1185003_044",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n那、",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "那怎麼可能！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "在我們的調查中……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "實際上看起來的確沒人，",
    "voice": "vo_adv_1185003_045",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "似乎也只能從頭再來了。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "這部分是機密事項……",
    "voice": "vo_adv_1185003_046",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "沒錯。",
    "voice": "vo_adv_1185003_047",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "這裡的居民",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "原以營運住宅清潔公會為生，",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "卻從富裕家庭的豪宅",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "竊取了財物。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "花凜小姐！？",
    "voice": "vo_adv_1185003_048",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "沒問題的。",
    "voice": "vo_adv_1185003_049",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n{0}是",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "非常值得信賴的人物。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "可、",
    "voice": "vo_adv_1185003_050",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "可是……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "你知道些什麼對吧？",
    "voice": "vo_adv_1185003_051",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n{0}。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "什麼！",
    "voice": "vo_adv_1185003_052",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "既然如此怎麼不早說……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "一定是有什麼隱情吧。",
    "voice": "vo_adv_1185003_053",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n能請你將搬家地址和原因",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "一起告訴我們嗎？",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "background",
    "bg_id": "500021"
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "對方真的住在這裡？",
    "voice": "vo_adv_1185003_054",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "這位先生沒理由說謊不是嗎。",
    "voice": "vo_adv_1185003_055",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "更何況",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "您也接受了他敘述的隱情對吧？",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "這家有小孩子在，",
    "voice": "vo_adv_1185003_056",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "妳指的是這件事對吧。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n倘若真的是如此，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "我也認為讓小孩子目睹大人被逮捕，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n這種事還是能免就免……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "感謝你",
    "voice": "vo_adv_1185003_057",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "願意做出合乎人情的應對。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "可是",
    "voice": "vo_adv_1185003_058",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "交給花凜小姐和那位少年處理真的不要緊嗎？",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n我覺得起碼帶上一位【王宮騎士團】成員比較……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "不必擔心。",
    "voice": "vo_adv_1185003_059",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "因為這位先生非～常可靠。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "那麼{0}。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我們出發吧。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "來了～！",
    "voice": "vo_adv_1185003_060",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "啊，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "你是送東西來給大叔的嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "\\n我找找，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "印章印章……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "我幫妳拿過來了。",
    "voice": "vo_adv_1185003_061",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "\\n哦，是大哥啊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "一直以來謝謝你啦。",
