  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "組長～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "\\n好像有公會管理協會的人來了～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少年",
