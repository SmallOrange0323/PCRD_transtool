[
  {
    "type": "background",
    "bg_id": "500371"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "配送信件打工途中，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}踏入公會管理協會，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n見到了與平常感覺有些不同的花凜忙碌工作的身影。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "文件統整好了！",
    "voice": "vo_adv_1185003_000",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n負責這部分的是哪位？",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "職員1",
    "words": "啊，",
    "voice": "vo_adv_1185003_001",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "職員1",
    "words": "那是我負責的！",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "職員1",
    "words": "擺在桌上就好！",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "職員1",
    "words": "\\n我馬上就過去整理！",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "職員1",
    "words": "小花凜已經準備好了嗎？",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "再來只要等【王宮騎士團】將文件送來就行了。",
    "voice": "vo_adv_1185003_002",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "職員1",
    "words": "啊──",
    "voice": "vo_adv_1185003_003",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "職員1",
    "words": "等那個最後變成了一口氣全送過來的文件是嗎。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "職員1",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "職員1",
    "words": "那邊要是能分批送來就好了。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "職員1",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "職員1",
    "words": "那樣我們也就能幫忙了。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "畢竟【王宮騎士團】的成員們也有著種種苦衷嘛。",
    "voice": "vo_adv_1185003_004",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "而且",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "一點點整理，",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n和一口氣全都整理也沒什麼不同。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "職員1",
    "words": "只有小花凜妳才會這麼說……",
    "voice": "vo_adv_1185003_005",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "職員1",
    "words": "哎呀，",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "職員1",
    "words": "\\n不能再閒聊下去了。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "職員1",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "職員1",
    "words": "我也得快點做個整理才行。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "麻煩妳了。",
    "voice": "vo_adv_1185003_006",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n那麼我來進行最後一次確認……",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "啊，是{0}。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n你來送信是嗎？",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "一直以來真感謝你。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "因為突然得為【王宮騎士團】整理拘捕違法公會",
    "voice": "vo_adv_1185003_007",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "所需的文件。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "慌慌張張的真是不好意思。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "啊，",
    "voice": "vo_adv_1185003_008",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "呃，",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "這是因為……",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我得到逮捕現場做見證的關係，",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n所以準備了比較方便活動的衣服給我。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "雖然我說過穿平常的衣服就好……",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "職員1",
    "words": "妳這是什麼話。",
    "voice": "vo_adv_1185003_009",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "職員1",
    "words": "小花凜很常到事件現場出差不是。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "職員1",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "職員1",
    "words": "沒有一套方便活動的工作服反倒讓人覺得不可思議呢。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "怎麼又說這種話。",
    "voice": "vo_adv_1185003_010",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n其實妳只是想把我當成換裝娃娃擺弄對吧？",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "像萬聖節啦、",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "聖誕節啦、",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "就連新年也……",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "職員1",
    "words": "啊哈哈，",
    "voice": "vo_adv_1185003_011",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "職員1",
    "words": "這點小事別放在心上。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "職員1",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "職員1",
    "words": "至少現在這套",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "職員1",
    "words": "比以往實用得多。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "這麼說是沒錯……",
    "voice": "vo_adv_1185003_012",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "唔，",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n話說回來",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "文件都準備好了嗎？",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "職員1",
    "words": "非常完美，",
    "voice": "vo_adv_1185003_013",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "職員1",
    "words": "如妳所見已經完成了。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "如果是這樣就好……",
    "voice": "vo_adv_1185003_014",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "職員2",
    "words": "花凜小姐～！",
    "voice": "vo_adv_1185003_015",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "職員2",
    "words": "\\n【王宮騎士團】的人已經到了，\\n請妳馬上過來處理～！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "好～！",
    "voice": "vo_adv_1185003_016",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我這就過去～！",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "花凜小姐！",
    "voice": "vo_adv_1185003_017",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "這些是妳所委託的文件！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "職員1",
    "words": "在整理公會管理協會這邊的資料時我就這麼想了，",
    "voice": "vo_adv_1185003_018",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "職員1",
    "words": "\\n但加上你們那邊的文件",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "職員1",
    "words": "資料量真的變得很誇張耶。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "因為受害範圍廣泛而且大多是些瑣碎小事，",
    "voice": "vo_adv_1185003_019",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "怎麼樣都……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n另外不好意思，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "連難以判定的項目也原封不動加進來了……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "不要緊的。",
    "voice": "vo_adv_1185003_020",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "因為必要情報我已經記下來了。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "和本次案件無關的部分",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "會由我剔除。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "職員2",
    "words": "該不會",
    "voice": "vo_adv_1185003_021",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "職員2",
    "words": "能見識到花凜小姐的那招吧！？",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "職員1",
    "words": "靜靜看著就是。",
    "voice": "vo_adv_1185003_022",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "職員1",
    "words": "好玩的事情就要開始了。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "怎麼這樣形容啦。",
    "voice": "vo_adv_1185003_023",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "那只是普通的文書作業……",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "呃，",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "嗯。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n感覺有種期待的眼神集中在我身上呢。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n雖然你們這麼屏氣凝神，會讓我感到很難為情……",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "但工作就是工作。",
    "voice": "vo_adv_1185003_024",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我要全力以赴了！",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "這個公會的所在地是……",
    "voice": "vo_adv_1185003_025",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "然後……",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "這部分的活動內容和……",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n……這份收支報告……",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "沒有問題……",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "這裡和這裡……",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n有問題……",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "文件在空中飛舞！？",
    "voice": "vo_adv_1185003_026",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "職員1",
    "words": "哎呀，",
    "voice": "vo_adv_1185003_027",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "職員1",
    "words": "你也是第一次見到這情況嗎？",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "那樣",
    "voice": "vo_adv_1185003_028",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "真的能好好確認嗎！？",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "職員2",
    "words": "很神奇的是確實都確認完成了呢。",
    "voice": "vo_adv_1185003_029",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "職員2",
    "words": "\\n除了花凜小姐，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "職員2",
    "words": "這種事沒人辦得到就是了。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "職員1",
    "words": "我也模仿過一次，",
    "voice": "vo_adv_1185003_030",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "職員1",
    "words": "不過以文件弄得亂七八糟收場。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "這份文件有用，",
    "voice": "vo_adv_1185003_031",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
