  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "喂！",
    "voice": "vo_adv_1185003_062",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "大叔他說過要你別用這種語氣說話不是嗎。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "\\n真是的……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "唔，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "怪了？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "哥哥，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "你身邊的姐姐是誰啊？",
    "voice": null,
