    "name": "花凜",
    "words": "真是幫了我大忙。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "畢竟身邊突然只剩下陌生的大人，",
    "voice": "vo_adv_1185003_093",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n那些孩子也會感到不安吧。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "……說真的，",
    "voice": "vo_adv_1185003_094",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "如果能在事情變成那樣之前做些什麼是最好的。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n天不從人願呢。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "雖然這麼說，",
    "voice": "vo_adv_1185003_095",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "但我有空低落的話還不如努力工作對吧！",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n啊哈哈，",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "真不好意思。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "……咦？",
    "voice": "vo_adv_1185003_096",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "…………",
    "voice": "vo_adv_1185003_097",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "呵呵，",
    "voice": "vo_adv_1185003_098",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "說出這種話真的沒問題嗎？",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我啊，",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "不只會使用一切能用的手段，",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n也會拼了命拜託值得信賴的人哦？",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "回答得毫無猶豫呢。",
    "voice": "vo_adv_1185003_099",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "哎，",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我想您也是會這麼回答……",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "那麼",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我也有我的想法。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "still",
    "still_id": "118500301"
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "往後",
    "voice": "vo_adv_1185003_100",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我完全不會有所顧慮了。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n會比過去",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "拜託你更多更多事。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "為了避免像今天這種事再次發生，",
    "voice": "vo_adv_1185003_101",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我會和您一起周遊蘭德索爾，",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n幫助困擾的人們。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "呃，",
    "voice": "vo_adv_1185003_102",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "呃呃、",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "那是因為……",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n熟知蘭德索爾的法律和制度的人",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "是我嘛！",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n我不一起行動是不行的！",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "更何況，",
    "voice": "vo_adv_1185003_103",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "感覺您",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "一定能察覺到我看不到的那些方面。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n應該能找出許多",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "正在苦惱的人們吧，",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我想。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "所以要一起……",
    "voice": "vo_adv_1185003_104",
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "一起努力，",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n能就此創造出大家快樂生活的蘭德索爾那就太好了。",
    "voice": null,
    "unit_id": 118511
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "說出「一起」這個字眼的花凜，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n嘴角流露出了一縷溫柔。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "end"
  }
]
