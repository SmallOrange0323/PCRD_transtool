  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "唔……",
    "voice": "vo_adv_9006708_002",
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n那個啊……",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n不過就是敵人受了點小傷而已，",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "有什麼好擔心的。",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "嗚啾……！",
    "voice": "vo_adv_9006708_003",
    "unit_id": 136911
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n對不起……",
    "voice": null,
    "unit_id": 136911
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n",
    "voice": null,
    "unit_id": 136911
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "但、",
    "voice": null,
    "unit_id": 136911
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "但素……！",
    "voice": null,
    "unit_id": 136911
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "儂",
    "voice": "vo_adv_9006708_004",
    "unit_id": 135811
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "果然還是",
    "voice": null,
    "unit_id": 135811
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "討厭這樣做……！",
    "voice": null,
    "unit_id": 135811
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "\\n",
    "voice": null,
    "unit_id": 135811
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "回來這邊吧？",
    "voice": null,
    "unit_id": 135811
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "\\n黎薩……！",
    "voice": null,
    "unit_id": 135811
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "現在的話，",
    "voice": "vo_adv_9006708_005",
    "unit_id": 136911
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "只要接受全身搔癢之刑",
    "voice": null,
    "unit_id": 136911
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "和在久遠冰河做刨冰之刑就能解決了喔！",
    "voice": null,
    "unit_id": 136911
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "哎呀呀。",
    "voice": "vo_adv_9006708_006",
    "unit_id": 135911
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135911
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "真是一群麻煩的傢伙們。",
    "voice": null,
    "unit_id": 135911
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "不，正常來說根本不可能就這樣了事吧。",
    "voice": "vo_adv_9006708_007",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "我再額外判妳無期徒刑，去清掃殭屍出沒的廢村──",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n外加舔小格蕾這雙",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "透明的美腿之刑。",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "……光是最後那項，",
    "voice": "vo_adv_9006708_008",
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "就足以構成徹底抗戰的充分理由了。",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "……我明白了。",
    "voice": "vo_adv_9006708_009",
    "unit_id": 133114
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133114
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "既然妳打算",
    "voice": null,
    "unit_id": 133114
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "繼續抵抗的話。",
    "voice": null,
    "unit_id": 133114
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "[rub:・]展[/rub][rub:・]現[/rub][rub:・]妳[/rub][rub:・]的[/rub][rub:・]全[/rub][rub:・]力[/rub]來挑戰吧──",
    "voice": "vo_adv_9006708_010",
    "unit_id": 133114
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "叛逆之徒啊。",
    "voice": null,
    "unit_id": 133114
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n畢竟現在，",
    "voice": null,
    "unit_id": 133114
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "數量的優勢可是在我們這裡。",
    "voice": null,
    "unit_id": 133114
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "唔……",
    "voice": "vo_adv_9006708_011",
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n不用妳說，",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "我也會這麼做的……",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
