  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "……！？",
    "voice": "vo_adv_9006723_000",
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "這到底是……！？",
    "voice": "vo_adv_9006723_001",
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n──情況",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "居然回溯了……！？",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "是還原嗎？",
    "voice": "vo_adv_9006723_002",
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "還是重置？",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "……不對──",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "……「公主連結程序」。",
    "voice": "vo_adv_9006723_003",
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n和當時不同，",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "這次是完全的型態……",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "你祈願的……",
    "voice": "vo_adv_9006723_004",
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n「復活夥伴們與世界」",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "是這個願望吧。",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "……米奈娃。",
    "voice": "vo_adv_9006723_005",
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n即便捨棄自身的存在，",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "也要選擇與我為敵嗎？",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "以及──",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "「媞雅」。",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "居然將累積在「埃忒耳模組」中的",
    "voice": "vo_adv_9006723_006",
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n正面情感能量，",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "盡可能地匯集起來──",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "再交付出去。",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "……",
    "voice": "vo_adv_9006723_007",
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "呵呵。",
    "voice": "vo_adv_9006723_008",
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n呵呵呵呵呵……♪",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "好啊，",
    "voice": "vo_adv_9006723_009",
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "沒問題。",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n我接受你們的挑戰。",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "面對各位時，",
    "voice": "vo_adv_9006723_010",
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "我心中所感受到的悸動。",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "究竟是為何而生──",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n我真的很想",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "一探究竟呢！",
    "voice": null,
    "unit_id": 107413
  }
]
