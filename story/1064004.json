  },
  {
    "type": "dialogue",
    "name": "採訪員",
    "words": "阿賀斗選手，",
    "voice": "vo_adv_1064004_013",
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "採訪員",
    "words": "妳很厲害呢！",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "採訪員",
    "words": "\\n平時的練習量",
