    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "採訪員",
    "words": "肯定很大吧！",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "謝謝妳的誇獎。",
    "voice": "vo_adv_1064004_014",
    "unit_id": 106431
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106431
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "厲不厲害",
    "voice": null,
    "unit_id": 106431
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "我不清楚……",
    "voice": null,
    "unit_id": 106431
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106431
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "總之，",
    "voice": null,
    "unit_id": 106431
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "我會督促自己努力練習。",
    "voice": null,
    "unit_id": 106431
  },
  {
    "type": "dialogue",
    "name": "採訪員",
    "words": "阿賀斗選手，",
    "voice": "vo_adv_1064004_015",
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "採訪員",
    "words": "聽說妳從早到晚",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "採訪員",
    "words": "都在練習。",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "採訪員",
    "words": "\\n",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "採訪員",
    "words": "就連移動過程中",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "採訪員",
    "words": "也一直在聽表演用的曲子……",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "採訪員",
    "words": "\\n飲食也有所節制，",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "採訪員",
    "words": "很辛苦的吧？",
