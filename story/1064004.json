    "unit_id": 106431
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──訪談結束後──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "……嗯……",
    "voice": "vo_adv_1064004_018",
    "unit_id": 106431
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "得快點過去練習場才行。",
