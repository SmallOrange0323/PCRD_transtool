    "voice": "vo_adv_1064004_022",
    "unit_id": 106431
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n我剛剛",
    "voice": null,
    "unit_id": 106431
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "在想事情……",
