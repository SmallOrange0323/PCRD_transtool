    "unit_id": 106431
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "訪談這種事……",
    "voice": "vo_adv_1064004_020",
    "unit_id": 106431
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "雖然不算是",
    "voice": null,
    "unit_id": 106431
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "在浪費時間，",
