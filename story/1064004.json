  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "唔……",
    "voice": "vo_adv_1064004_016",
    "unit_id": 106431
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n不能隨心所欲地吃喜歡的食物，",
    "voice": null,
    "unit_id": 106431
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106431
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "確實有些難受。",
