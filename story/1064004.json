  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "我會小心一點的。",
    "voice": null,
    "unit_id": 106431
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "……呃，",
    "voice": "vo_adv_1064004_024",
    "unit_id": 106431
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "那個。",
    "voice": null,
    "unit_id": 106431
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "那麼，",
    "voice": "vo_adv_1064004_025",
    "unit_id": 106431
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "我還在趕時間……",
