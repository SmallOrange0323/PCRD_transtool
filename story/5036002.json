[
  {
    "type": "background",
    "bg_id": "500930"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "一行人為了拯救被囚禁的人們，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n來到了盆栽小花的附近。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "繆思小鎮……",
    "voice": "vo_adv_5036002_000",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "直到剛剛",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "明明就還那麼熱鬧呢。",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "現在卻連個人影，",
    "voice": "vo_adv_5036002_001",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "都看不到了呢。",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這也沒辦法嘛。",
    "voice": "vo_adv_5036002_002",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n畢竟「盆栽小花」\\n像那樣聳立著嘛。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不過在下等人，",
    "voice": "vo_adv_5036002_003",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n得去救出被囚禁在「盆栽小花」",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n裡頭的人們才行……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "但棘手的，",
    "voice": "vo_adv_5036002_004",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "還是那個花粉呢。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n會讓人打噴嚏這點自然不必說……",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "但似乎還有",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "某種魔法效果的樣子。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "如果只是用布蓋住口鼻的話也擋不住，",
    "voice": "vo_adv_5036002_005",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "如果吸太多了，頭還會變得昏昏沉沉的呢。",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "真的令人很困擾呢～！",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "即使從遠處射擊箭矢，",
    "voice": "vo_adv_5036002_006",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這種程度的攻擊……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "它也完全不為所動呢。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那層外皮，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "似乎比乍看之下還要堅硬的樣子。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "擅長魔法攻擊的小凱留被抓走了，",
    "voice": "vo_adv_5036002_007",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n對我們來說是個重傷呢……",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "而且如果用太強力的攻擊破壞，",
    "voice": "vo_adv_5036002_008",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n有可能導致裡頭的人們受到波及……",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "這樣很危險呢。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "唔呣……",
    "voice": "vo_adv_5036002_009",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "確實相當困擾呢。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不僅不得隨意接近，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "同時也不能草率地破壞……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n那麼究竟",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "該如何是好呢？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "皮喵太",
    "words": "皮喵……",
    "voice": "vo_adv_5036002_010",
    "unit_id": 4411
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "那樣的話，",
    "voice": "vo_adv_5036002_011",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "我們要不要對它唱歌試試看呀！？",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "啊，",
    "voice": "vo_adv_5036002_012",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "原來如此～！",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "剛才",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "「盆栽小花」也是，\\n對我們唱的歌產生反應了嘛！",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "未央和卯月，",
    "voice": "vo_adv_5036002_013",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "妳們等一下。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "如果因為這樣讓「盆栽小花」越變越大，",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n不就反而會讓事態更加惡化了嗎？",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "啊哈，",
    "voice": "vo_adv_5036002_014",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "說的也是──",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "欸嘿嘿……",
    "voice": "vo_adv_5036002_015",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不……",
    "voice": "vo_adv_5036002_016",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n那",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "說不定是好主意呢☆",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "咦？",
    "voice": "vo_adv_5036002_017",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "佩可小姐？",
    "voice": "vo_adv_5036002_018",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "如果「盆栽小花」真的\\n聽到大家的歌聲就會變大的話……",
    "voice": "vo_adv_5036002_019",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那就乾脆，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "讓它變大到極限為止吧！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "咦咦咦？",
    "voice": "vo_adv_5036002_020",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "畢竟「盆栽小花」細細長長",
    "voice": "vo_adv_5036002_021",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "而且頂端渾圓，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "如果讓它盡可能地變大……",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "……啊！",
    "voice": "vo_adv_5036002_022",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "\\n那它就會失去平衡……！",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是的！",
    "voice": "vo_adv_5036002_023",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "說不定會碰咚──☆",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n一聲",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "倒下來呢！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "咦咦……？",
    "voice": "vo_adv_5036002_024",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "真的辦得到嗎？",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "那種事……",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "凜小姐的不安，",
    "voice": "vo_adv_5036002_025",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "確實有所道理……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "可是，",
    "voice": "vo_adv_5036002_026",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "感覺好像很有趣♪",
    "voice": null,
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "嗯嗯！",
    "voice": "vo_adv_5036002_027",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n反正光想也不會有什麼改變……",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "那不如就試試看吧，",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "這個方案！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "……哎……",
    "voice": "vo_adv_5036002_028",
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "真拿妳們沒辦法。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "如果真要這麼做，",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "凜",
    "words": "那就要全力以赴喔。",
    "voice": null,
    "unit_id": 112511
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "真不愧是澀凜凜♪",
    "voice": "vo_adv_5036002_029",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "那麼就，",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "音樂，開始──",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "給我慢著喵────！！！",
    "voice": "vo_adv_5036002_030",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "咦！？",
    "voice": "vo_adv_5036002_031",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這個聲音是……！",
    "voice": "vo_adv_5036002_032",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "妳們那麼難聽的歌聲，",
    "voice": "vo_adv_5036002_033",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "哪有人聽得下去呀喵──！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "對呀對呀──！",
    "voice": "vo_adv_5036002_034",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "卯月",
    "words": "咦咦咦！？",
    "voice": "vo_adv_5036002_035",
    "unit_id": 112411
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……！",
    "voice": "vo_adv_5036002_036",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n各位，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請看那邊！",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在「盆栽小花」的嘴邊附近……！",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "still",
    "still_id": "503600201"
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "凱留凱留～♪",
    "voice": "vo_adv_5036002_037",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n偶像凱留，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "華麗地、登、場、喵～♪",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可等人",
