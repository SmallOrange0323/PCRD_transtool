[
  {
    "type": "background",
    "bg_id": "501340"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在工廠負責各種工作的美冬\\n一邊和許多帳簿大眼瞪小眼，一邊處理著文書工作。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這星期的銷售額是這樣，",
    "voice": "vo_adv_1169004_000",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "支出是這樣……",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n應付費用和應收帳款是這樣……",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "收支平衡則是……",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "嗯嗯～～！",
    "voice": "vo_adv_1169004_001",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n一直盯著小小的數字看，",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "會讓肩膀僵硬起來呢。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "終於午休了嗎……",
    "voice": "vo_adv_1169004_002",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n大家是不是都先走了呢？",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "哎呀，",
    "voice": "vo_adv_1169004_003",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "是你。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "怎麼了？",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n你正好要去吃飯嗎？",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "……你在等我？",
    "voice": "vo_adv_1169004_004",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這樣啊，",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "對不起。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n可以再給我一點時間嗎？",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我把這份文件處理掉就好。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我找找，",
    "voice": "vo_adv_1169004_005",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "印章，",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "印章……",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "咦？",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "平常明明都放在這裡的啊。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n我是收到這個抽屜了嗎……？",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "唔……",
    "voice": "vo_adv_1169004_006",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "好難拉啊。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n好像",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "有什麼東西勾住了……",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "嘿！！",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "打開了……",
    "voice": "vo_adv_1169004_007",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "呃，",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這道光是什麼！？",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n抽屜裡在發光，",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這樣就什麼都看不見了啊！",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "呀啊啊啊啊啊！",
    "voice": "vo_adv_1169004_008",
    "unit_id": 116911
  },
  {
    "type": "background",
    "bg_id": "510300"
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "突然找你出來，真是不好意思。",
    "voice": "vo_adv_1169004_009",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n今天明明是難得的假日。",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "不過，",
    "voice": "vo_adv_1169004_010",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "幸好你今天有空。",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n因為我不知道",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "該找誰商量這種事情才好……",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "關於這個……",
    "voice": "vo_adv_1169004_011",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "希望你",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "能幫我挑選要送弟弟的生日禮物。",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "最近好像有一部很流行的機器人動畫……",
    "voice": "vo_adv_1169004_012",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n我弟弟很想要那個作品的模型。",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我也試著自己查了一下，",
    "voice": "vo_adv_1169004_013",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "但那部動畫的……",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "是叫系列嗎？",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "好像有很多種類……",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我不知道",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "他想要的是哪一種。",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我覺得如果來問是男生的你，",
    "voice": "vo_adv_1169004_014",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "應該很了解這些事情吧。",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "拜",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "託你了！",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "可以幫我嗎？",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "謝謝。",
    "voice": "vo_adv_1169004_015",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "幫大忙了。",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n我下次會好好答謝你的。",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "總而言之，",
    "voice": "vo_adv_1169004_016",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "先去玩具店就可以了嗎？",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n可不可以請你為我帶路？",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "background",
    "bg_id": "510370"
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "最近這種商店",
    "voice": "vo_adv_1169004_017",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "也有在賣模型啊。",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n種類也比我想像中的還要多……",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "找你來幫忙是正確的決定啊。",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "男生就喜歡這樣的東西吧。",
    "voice": "vo_adv_1169004_018",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n像是機器人",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "或是電車，",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "還有英雄的玩具之類的。",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "呃，",
    "voice": "vo_adv_1169004_019",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "那我弟弟想要的……",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "是這個嗎？",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "但有個顏色不一樣的版本就放在旁邊……",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "戰隊英雄的主角也是紅色的，",
    "voice": "vo_adv_1169004_020",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "選紅的一定比較好吧。",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "外表看起來也刺刺的，",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "很帥氣。",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "咦？",
    "voice": "vo_adv_1169004_021",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這個紅色的",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "是主角之前搭乘的機體？",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n你說現在搭乘的……",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "是這邊的綠色？",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這、",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這樣啊。",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "謝謝你。",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "咦？",
    "voice": "vo_adv_1169004_022",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我說，",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這個展示品也是模型吧？",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n雖然放在透明的盒子裡，",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "但這也是商品嗎？",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "哦，",
    "voice": "vo_adv_1169004_023",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "是把實際做出來的模型當成範本，放在這裡啊。",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "像這樣觀察，",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "能發現其實做得很細膩呢。",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "……我問你，",
    "voice": "vo_adv_1169004_024",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n你覺得我弟弟能不能",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "順利地做出這種模型呢？",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我不知道",
    "voice": "vo_adv_1169004_025",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "原來模型是做工這麼細膩的東西。",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n有很多小裝飾品，",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "好像也很複雜……",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "你看，",
    "voice": "vo_adv_1169004_026",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這個範本也是，",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n到處都有可以開開關關的零件不是嗎？",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
