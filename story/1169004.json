    "words": "這裡也有在出借塗裝用的道具啊。",
    "voice": "vo_adv_1169004_053",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n既然如此，",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "難得有這個機會，我要不要也來挑戰一下呢？",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "你想想嘛，",
    "voice": "vo_adv_1169004_054",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "以防弟弟說自己也想塗裝，",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我想先學起來……",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n而且色彩繽紛又可愛的機器人好像很有趣，不是嗎？",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "呵呵，",
    "voice": "vo_adv_1169004_055",
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這讓人開心起來了呢。",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n該塗成什麼顏色才好呢……",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "啊，",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "對了，",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n和你選同樣的顏色",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "或許也不錯呢♪",
    "voice": null,
    "unit_id": 104831
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好了，",
    "voice": "vo_adv_1169004_056",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "辛苦你了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "就算平常的美冬像個可靠的大姐姐，",
    "voice": "vo_adv_1169004_057",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n也還是會有慌慌張張的時候啊～",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n真～可愛♪",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不過，她想為弟弟準備生日禮物，",
    "voice": "vo_adv_1169004_058",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n真是個為家人著想的乖孩子呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n在那之後，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "她好像沒有弄錯，順利地買到禮物了喔。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "只不過……",
    "voice": "vo_adv_1169004_059",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "她弟弟好像發現了和你一起做的模型，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n纏著她問了一堆問題。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這又是另一個故事了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那就這樣囉，",
    "voice": "vo_adv_1169004_060",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "掰掰～♪",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "501340"
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "嗯嗯……",
    "voice": "vo_adv_1169004_061",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "呼",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "啊……",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我做了個有點奇妙的夢啊……",
    "voice": "vo_adv_1169004_062",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n好像是在和你一起做玩具……",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "如果有那種玩具，說不定會很有趣呢。",
    "voice": "vo_adv_1169004_063",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n能夠擁有親手製作的體驗，",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "好像很開心。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "……說到這個，",
    "voice": "vo_adv_1169004_064",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "在我們的商品中，",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n好像沒有那種親手製做的玩具吧？",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "好像任何人都想得到，",
    "voice": "vo_adv_1169004_065",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "卻還不存在的商品……",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這搞不好",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "是個商機呢。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "親手製作玩具很開心，",
    "voice": "vo_adv_1169004_066",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "拿製作出來的玩具來玩",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "又有另一種樂趣！",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n我覺得這種一舉兩得的玩具",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "是有市場需求的。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "對吧……？",
    "voice": "vo_adv_1169004_067",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "既然你都這麼說了，",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "一定就是這樣吧！",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n嗯，",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我總覺得行得通。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "既然都這麼決定了，",
    "voice": "vo_adv_1169004_068",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "就趁午休結束前",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n找工廠長商量一下吧。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n雖然這可能是外行人的想法，",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "但我還是想盡量讓它化為實體。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "幾天後──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "各個生產線的",
    "voice": "vo_adv_1169004_069",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "工作進度如何？",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n請成形、",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "塗裝和",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "組裝",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "報告各自的進度。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "職員1",
    "words": "成形生產線",
    "voice": "vo_adv_1169004_070",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "職員1",
    "words": "沒有問題！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "職員2",
    "words": "塗裝生產線",
    "voice": "vo_adv_1169004_071",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "職員2",
    "words": "一樣沒問題！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "職員3",
    "words": "組裝生產線",
    "voice": "vo_adv_1169004_072",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "職員3",
    "words": "的進度慢了一點！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "職員3",
    "words": "\\n希望能增派支援的人手！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我知道了，",
    "voice": "vo_adv_1169004_073",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我來支援組裝。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "……好了，",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "要把沒跟上進度的部分追回來囉！",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "喝啊啊啊啊──────！！",
    "voice": "vo_adv_1169004_074",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "職員2",
    "words": "好厲害，",
    "voice": "vo_adv_1169004_075",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "職員2",
    "words": "居然能夠同時完成實作、指示和訂單管理……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "職員2",
    "words": "\\n這、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "職員2",
    "words": "這不是人類能辦到的事情……！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "好，",
    "voice": "vo_adv_1169004_076",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "組裝好一百個了！",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "時間呢？",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "職員1",
    "words": "九、",
    "voice": "vo_adv_1169004_077",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "職員1",
    "words": "九點七秒。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "職員2",
    "words": "居然還比之前快了兩秒以上……",
    "voice": "vo_adv_1169004_078",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "職員2",
    "words": "\\n美冬的",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "職員2",
    "words": "速度和精準度比以前更好了……！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "職員3",
    "words": "那個人就是我們的領班……！",
    "voice": "vo_adv_1169004_079",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "職員3",
    "words": "\\n可惡，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "職員3",
    "words": "我們也不能輸啊！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "職員3",
    "words": "唔喔喔喔喔喔！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "是啊是啊，",
    "voice": "vo_adv_1169004_080",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "在美冬他們來了之後，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "工廠就越來越忙了呢～！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "\\n她之前幫忙出點子的新商品也再度成了熱銷品項。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "因為人手不夠，",
    "voice": "vo_adv_1169004_081",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "我們又僱用了新的打工人員，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "\\n真的是忙到連休息的時間都沒有啊～",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "就是有這麼多的",
    "voice": "vo_adv_1169004_082",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "小孩子在等待啊，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "\\n等著我們工廠製作的玩具。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "\\n這就叫",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "工廠長",
    "words": "甜蜜的負擔吧～",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "是啊，",
    "voice": "vo_adv_1169004_083",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "所以要讓每一分每一秒，",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "還有這一瞬間",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "擁有最高效率！",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n為了小孩子們，",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "大家要一起做出更好的玩具喔！",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "background",
    "bg_id": "501340"
  },
  {
    "type": "dialogue",
    "name": "物流商",
    "words": "那麼，",
    "voice": "vo_adv_1169004_084",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "物流商",
    "words": "這些就是所有要出貨的份吧？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "物流商",
    "words": "\\n我們確實收到了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "呼……",
    "voice": "vo_adv_1169004_085",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這樣總算是完成工作了。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "今天也整天都",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "工作得很有效率啊。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "今天晚上好像能睡得很好。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "辛苦了，",
    "voice": "vo_adv_1169004_086",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "讓你也留下來加班，真是抱歉。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n因為這是難得的商機，",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我不希望延後出貨的時間。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "啊，",
    "voice": "vo_adv_1169004_087",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "那兩個留下來沒關係。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "來，",
    "voice": "vo_adv_1169004_088",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這是{0}的份。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n這是我要送你的禮物喔。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "……你也不用這麼驚訝吧？",
    "voice": "vo_adv_1169004_089",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這是我用員工價買的。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "有特別折扣。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我也做過了各式各樣的工作，",
    "voice": "vo_adv_1169004_090",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n卻不太常遇到",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "能像這樣留下某些具體事物的工作。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這是我和你",
    "voice": "vo_adv_1169004_091",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "一起讓想到的點子化為實體的玩具啊。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n想要至少留一個放在身邊，",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這種想法有那麼奇怪嗎？",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "呵呵，",
    "voice": "vo_adv_1169004_092",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "能讓你這麼高興，",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n我送這份禮物就值得了。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "對了，",
    "voice": "vo_adv_1169004_093",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "你",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "下次休假時有空嗎？",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n如果你沒有安排的話，",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "要不要一起來組裝？",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我會試著調整一下班表。",
    "voice": "vo_adv_1169004_094",
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n比起在家裡一個人做，",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "兩個人一起做一定會更開心吧。",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "那麼，",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "下次休假就──",
    "voice": null,
    "unit_id": 116911
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "於是，為了配合下次休假的日子，\\n美冬開心地討論著時程表的調整。",
    "voice": null,
    "unit_id": null
  }
]
