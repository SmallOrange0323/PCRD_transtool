    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "\\n",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "でも、",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "私は別に",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "魔物料理は……",
    "voice": null,
    "unit_id": 135111
  },
  {
    "type": "dialogue",
    "name": "エリス",
    "words": "そうなの……？",
    "voice": "vo_adv_5206411_014",
    "unit_id": 135011
  },
  {
