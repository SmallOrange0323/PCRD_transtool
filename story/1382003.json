[
  {
    "type": "background",
    "bg_id": "502114"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──遺跡騷動的隔天。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}在涅妃‧涅羅的帶領下，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n前往鬼岩城塞的廣場。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "小心搬運！",
    "voice": "vo_adv_1382003_000",
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "\\n那傢伙鱗片上的刺，",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "一旦扎進去可就很難拔出來了！",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "喂，",
    "voice": "vo_adv_1382003_001",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "別推我！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "\\n這肉在還沒烹調前就跟鋼鐵一樣硬，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "\\n要是掉下來砸到腳，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "那可不得了啊！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "搬了這麼多食材過來，",
    "voice": "vo_adv_1382003_002",
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "變得好熱鬧呢～",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n這可是在吉歐‧格黑納也見不到，",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n取自凶惡魔物的",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "食材大遊行唷～",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "汝是來遊山玩水的嗎？",
    "voice": "vo_adv_1382003_003",
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "別偷懶，",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "這不正是鍛鍊力氣之良機？",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "唔！",
    "voice": "vo_adv_1382003_004",
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n這是要我",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "去幫忙搬運",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "的意思嗎～！？",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n……不知道有沒有留下",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "比較不危險的食材……",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "騎士閣下呀，",
    "voice": "vo_adv_1382003_005",
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "請放心休息。",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n待場地準備就緒，",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "便會著手烹煮。",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "正是如此。",
    "voice": "vo_adv_1382003_006",
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n彼些魔物，",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "皆是為款待騎士閣下而備齊的珍品……",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "說是吉歐‧格黑納引以為傲的",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "至高美食，",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "亦不為過。",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家會傾全力",
    "voice": "vo_adv_1382003_007",
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "烹煮。",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "若能讓恁對奴家親手準備的誠摯款待抱有期待，",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "那",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "便是奴家的榮幸──",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "……",
    "voice": "vo_adv_1382003_008",
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n恁剛剛，",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "說了什麼？",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "騎、",
    "voice": "vo_adv_1382003_009",
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "騎士閣下先生～？",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "你是認真的嗎，",
    "voice": "vo_adv_1382003_010",
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "小兄弟！？",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "\\n你已經",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "下定決心了嗎！？",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "……騎士閣下之言，",
    "voice": "vo_adv_1382003_011",
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "乃意外之喜。",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "既如此……",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家便承蒙恁的好意。",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "不不不，",
    "voice": "vo_adv_1382003_012",
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "別這麼輕易說出口啊！",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n騎士閣下先生，",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "你有搞清楚嗎～！？",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n用這些食材和皇女大人一起烹調，就意味著……",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "唔唔！？",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "……米亞呀。",
    "voice": "vo_adv_1382003_013",
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n當然，",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "汝等也會幫忙吧？",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "唔唔",
    "voice": "vo_adv_1382003_014",
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "唔唔……",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "呼哈～！！",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n皇女大人，",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "太過分了啦～！",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n竟然突然摀住我的嘴～",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "…………",
    "voice": "vo_adv_1382003_015",
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "嗚噫……",
    "voice": "vo_adv_1382003_016",
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "知、",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "知道了啦，",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "我不多嘴就是了……",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "……看樣子，",
    "voice": "vo_adv_1382003_017",
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "我們也只能下定決心了啊。",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "那可是涅妃‧涅羅大人所認可的對象。",
    "voice": "vo_adv_1382003_018",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "\\n我沒有異議。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "但是～！",
    "voice": "vo_adv_1382003_019",
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "處理這些食材",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "既危險又困難！",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n這簡直就像是吉歐‧格黑納這嚴酷大地的象徵～！",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n至今為止",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "還沒有任何一個人敢嘗試挑戰！",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "即使如此，",
    "voice": "vo_adv_1382003_020",
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "皇女大人和騎士閣下先生打算完成挑戰的話，",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n我們也會作為吉歐‧格黑納的人民，",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "盡微薄之力協助～！",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "……沒問題吧，",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "各位！？",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "全員",
    "words": "嗚喔喔喔喔喔喔喔喔！！！！",
    "voice": "vo_adv_1382003_021",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "──呵呵。",
    "voice": "vo_adv_1382003_022",
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "諸位，",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "真是深知奴家之心。",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "甚好。",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "為不辱騎士閣下決心，",
    "voice": "vo_adv_1382003_023",
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家亦會竭盡全力，",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "還請多多指教，",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "一同",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "動手烹煮吧。",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "──此肉，",
    "voice": "vo_adv_1382003_024",
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "乃「裂岩大蛇肋肉」。",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n其質地堅如磐石，",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "唯有熟練之士方能下刀切斷。",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "若以粗劣刀技處理，",
    "voice": null,
    "unit_id": 138211
  },
  {
