    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "便趁熱享用吧。",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "騎士閣下，",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "請來此處。",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "終、",
    "voice": "vo_adv_1382003_051",
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "終於！",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n來到這個時刻了呢～！",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "是啊！",
    "voice": "vo_adv_1382003_052",
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "我們的努力也有回報了！",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "\\n往後也請多多關照啦──",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "新郎閣下！！",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "此次正式宴席，",
    "voice": "vo_adv_1382003_053",
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "乃吉歐‧格黑納的望族、",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "權貴間，",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n自古流傳",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "的特別禮法呢。",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "以無法獨自達成的烹製技法──",
    "voice": "vo_adv_1382003_054",
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "彼此互助，",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "處理棘手至極的食材，",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "一同跨越難關，",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "作為永恆盟約證明。",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "此即為……",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "「婚禮之儀」。",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "啊～",
    "voice": "vo_adv_1382003_055",
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n看你愣住的表情，",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "果然是不知道呢～",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "但是，",
    "voice": "vo_adv_1382003_056",
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "已經無法反悔了喔～！",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "這個婚禮之儀，",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "最後會透過互相餵食親手製作的料理，",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n來完成……",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "請做好心理準備吧，",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "騎士閣下先生～！",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "既如此，",
    "voice": "vo_adv_1382003_057",
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "雖然僭越……",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "便先由奴家",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "餵食",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "騎士閣下吧。",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "來吧，",
    "voice": "vo_adv_1382003_058",
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "騎士閣下呀。",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n「啊～」……♪",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "──呵呵呵。",
    "voice": "vo_adv_1382003_059",
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "這是在逗恁玩呢。",
    "voice": "vo_adv_1382003_060",
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "騎士閣下的羞澀表情──",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "實在可愛，",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "能於近處觀看，",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "乃是無上幸福呀♪",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "咦……？",
    "voice": "vo_adv_1382003_061",
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "逗我玩……？",
    "voice": "vo_adv_1382003_062",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "騎士閣下",
    "voice": "vo_adv_1382003_063",
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "是足以稱作救世英傑之人。",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "且",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "傾慕騎士閣下的女子",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "亦多如繁星，",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "此乃不爭之實。",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "更遑論，",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "事前未告知禮儀細節，",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "便締結如騙局般的婚姻。",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "若奴家於此將騎士閣下據為己有，",
    "voice": "vo_adv_1382003_064",
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n迎為夫婿，",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "必然引發諸國紛爭……",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "誰能料到，",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "恁乃是名副其實的",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "罪孽深重之人呢。",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "也、",
    "voice": "vo_adv_1382003_065",
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "也就是說～",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "這會演變成",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "國際問題對吧～？",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n光、",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "光是聽到就讓人胃痛的詞彙～",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "商人３",
    "words": "那……",
    "voice": "vo_adv_1382003_066",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "商人３",
    "words": "我們的決心呢？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "商人３",
    "words": "\\n剛才賭命支援的意義是……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "並非徒勞無功。",
    "voice": "vo_adv_1382003_067",
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "於汝等而言，",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "亦是磨練自我的良機吧？",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "全員",
