  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "「煉獄窯煮魔物鍋」，",
