    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "阿囉哈～！",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "速度還可以再更快哦！",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "雪菲！",
    "voice": "vo_adv_9004014_017",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "總之妳先放空一下！",
