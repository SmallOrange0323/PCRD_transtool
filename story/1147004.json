[
  {
    "type": "background",
    "bg_id": "500550"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "來神殿參拜的{0}，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n遇上了前來參觀的矛依未。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這裡就是神殿啊……",
    "voice": "vo_adv_1147004_000",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這裡的氛圍和繁華街廟會上的完全不同，",
    "voice": "vo_adv_1147004_001",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "但也相當熱鬧，感覺很有趣耶！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "有沒有什麼趣事可做呢～？",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "唔哇！",
    "voice": "vo_adv_1147004_002",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "什麼啊，",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "原來是你……",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "別嚇我啦！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "與其說是來參拜，",
    "voice": "vo_adv_1147004_003",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "不如說是",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "感覺新年時的神殿很有趣才來的。",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n畢竟，",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我不相信世上有神嘛！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "應該說啊，",
    "voice": "vo_adv_1147004_004",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你有聽過「言出必行」這句話嗎？",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "在我看來啊，",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "自己許的願就要由自己實現！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "啊，",
    "voice": "vo_adv_1147004_005",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "不過，",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n我倒是想去抽籤挑戰一下自己的運勢。",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我從來沒抽過「這一側」的籤呢。",
    "voice": "vo_adv_1147004_006",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你也一起來抽吧！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……嗯？",
    "voice": "vo_adv_1147004_007",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這是怎麼了？",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n太陽明明早就出來了，",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "怎麼突然這麼耀眼……",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "是你",
    "voice": "vo_adv_1147004_008",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "在發光嗎……？",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……是的話……",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "也太刺眼",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "了吧……",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "background",
    "bg_id": "510290"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "新年的某一天，矛依未藉米奈娃之力暫時避開了監視，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在大街上閒逛著。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "抽了獎、",
    "voice": "vo_adv_1147004_009",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "還吃了許多好吃的東西……",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "日本的新年真棒啊！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "那麼……",
    "voice": "vo_adv_1147004_010",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "接下來要做什麼呢～",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n難得的自由時光，",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我還沒玩夠呢！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "嗯？",
    "voice": "vo_adv_1147004_011",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "商店街前有一群人排著隊耶？",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我記得那裡……",
    "voice": "vo_adv_1147004_012",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "好像有一間小神社？",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "原來啊，",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "大家是要去參拜。",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "雖然我不信神，",
    "voice": "vo_adv_1147004_013",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "但去神社湊湊熱鬧好像也挺有趣的！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n我也混入人群裡排排看吧……",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……嗯？",
    "voice": "vo_adv_1147004_014",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "那傢伙是……！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "喂，",
    "voice": "vo_adv_1147004_015",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "{0}！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "完蛋了！",
    "voice": "vo_adv_1147004_016",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "看見認識的人下意識就上前搭話了，",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n忘了我們在「這一側」可是第一次見面啊！　",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "就、",
    "voice": "vo_adv_1147004_017",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "就是，",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "那個啊……",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我是和你同校的學生啦！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "就是啊！",
    "voice": "vo_adv_1147004_018",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "雖然我們都只是擦身而過而已！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n我有好幾次都有稍微打個招呼喔！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "稍微而已！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "呼……",
    "voice": "vo_adv_1147004_019",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "幸好這傢伙是個超級濫好人……",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你也排在這個隊伍中，",
    "voice": "vo_adv_1147004_020",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "就表示你也要去神社吧？",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "那我就跟著你吧。",
    "voice": "vo_adv_1147004_021",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n我也正好要去那裡呢。",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "不，",
    "voice": "vo_adv_1147004_022",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我沒有打算去參拜。",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n我不相信求神拜佛有什麼用啦。",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "只是感覺",
    "voice": "vo_adv_1147004_023",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "新年時去那裡會很有趣而已！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我已經決定今天要把新年會做的事通通做一遍了！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "問你喔，",
    "voice": "vo_adv_1147004_024",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "去神社除了許願之外，",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n還有什麼有趣的事可做嗎？",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "哦，",
    "voice": "vo_adv_1147004_025",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "測試運勢啊！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "那我也要抽！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……哦，",
    "voice": "vo_adv_1147004_026",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "看到神社了！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "什麼啊，",
    "voice": "vo_adv_1147004_027",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n這個隊伍裡都是排隊等待參拜的人，",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "抽籤好像不需要排隊耶。",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "那麼，我在這裡替你排隊，",
    "voice": "vo_adv_1147004_028",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n你先去抽籤吧！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "哦，歡迎回來。",
    "voice": "vo_adv_1147004_029",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n隊伍前進很多了，",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "好像馬上就能進神社囉。",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "所以呢，",
    "voice": "vo_adv_1147004_030",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "結果如何？",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "看你那表情，應該是……",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "哈哈哈，",
    "voice": "vo_adv_1147004_031",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "果然啊！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n你的表情超級陰沉的，不問也能猜到個大概呢！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n真是遺憾啊！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "籤紙上還寫了什麼？",
    "voice": "vo_adv_1147004_032",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n也讓我看看吧！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我看看……",
    "voice": "vo_adv_1147004_033",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "「旅行：",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "最好適可而止」，",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n「姻緣：",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "會碰上大麻煩」",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……啊。",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "唉唉，",
    "voice": "vo_adv_1147004_034",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "真慘啊……",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "不過，",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這只是個測試而已，",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你不必太沮喪啦！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "哦，",
    "voice": "vo_adv_1147004_035",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "好像快要能進神社了耶。",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你就繼續排隊，",
    "voice": "vo_adv_1147004_036",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "進去參拜吧！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n我要去抽籤了！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你結束後再來找我！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "好！",
    "voice": "vo_adv_1147004_037",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我要抽出比那傢伙更好的籤！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "唔喔喔喔喔！",
    "voice": "vo_adv_1147004_038",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "就是它了！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "still",
    "still_id": "114700401"
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "怎麼樣！！",
    "voice": "vo_adv_1147004_039",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你在說什麼啊！",
    "voice": "vo_adv_1147004_040",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "哪裡遺憾了！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這是最棒的結果耶！！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你剛剛也是因為沒抽到大凶",
    "voice": "vo_adv_1147004_041",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "才這麼失落的吧！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……喂，",
    "voice": "vo_adv_1147004_042",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你為什麼愣住了啊。",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n你該不會，",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "聽不懂我的意思吧？",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "「凶」",
    "voice": "vo_adv_1147004_043",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "就是指壞的意思吧？",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "那比「凶」更壞的「大凶」，",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "就是壞的最高等級。",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "所以，",
    "voice": "vo_adv_1147004_044",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我很高興能抽到最壞的籤喔！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n哈哈哈哈！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "和你一起求籤很開心喔！",
    "voice": "vo_adv_1147004_045",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n你讓我度過了快樂的新年！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "謝謝啦！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "background",
    "bg_id": "510290"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "呼……",
    "voice": "vo_adv_1147004_046",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "一不小心就和那傢伙搭話了，",
    "voice": "vo_adv_1147004_047",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "幸好沒暴露。",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "而且，",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "神社意外地有趣呢。",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "對了！",
    "voice": "vo_adv_1147004_048",
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我要拿這張大凶的籤",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "去和尾狗刀炫耀！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "他一定會嚇一大跳──！",
    "voice": null,
    "unit_id": 106131
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "哎呀……",
    "voice": "vo_adv_1147004_049",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "雖然一樣施加了能力防護，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n但那孩子的記憶好像在偶然間被播放出來了呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "或許是因為和那傢伙之間的羈絆變得更強烈了吧。",
    "voice": "vo_adv_1147004_050",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "希望記憶再現",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不會對現況造成什麼影響……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這次也沒得到什麼有益的資訊呢……",
    "voice": "vo_adv_1147004_051",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不過，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "對那孩子來說，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這應該是她在「那一側」為數不多的",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n美好回憶吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "她和那傢伙之間",
    "voice": "vo_adv_1147004_052",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "竟然有過這麼快樂的回憶。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n雖然有點驚訝，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "但也讓人放心了呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "存取結束。",
    "voice": "vo_adv_1147004_053",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "開始重新啟動。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "……妳已經與那傢伙和大家成為夥伴了，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n今後要創造更多難忘的回憶喔，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "諾維姆。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500550"
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "唔、",
    "voice": "vo_adv_1147004_054",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "唔唔……？",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……我",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "什麼時候睡著了啊。",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "而且",
    "voice": "vo_adv_1147004_055",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "竟然夢到了以前的事……",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n還在這種大白天下做了新年初夢。",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我都快忘記了，",
    "voice": "vo_adv_1147004_056",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我們以前還用抽籤決過勝負呢。",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n那時兩人互相交換看結果……",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "對了。",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……喂喂！",
    "voice": "vo_adv_1147004_057",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n和我用抽籤決勝負吧！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "規則只有一個……",
    "voice": "vo_adv_1147004_058",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "那就是抽到大凶的人勝利！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "吉利？",
    "voice": "vo_adv_1147004_059",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這種事啊，",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我只會在自己願意相信的時候相信！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "所以你也別在意這麼多了！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "來吧，",
    "voice": "vo_adv_1147004_060",
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "別廢話了，要開始囉！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n決勝負吧！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我這次也會贏你的！",
    "voice": null,
    "unit_id": 114711
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "順應一臉開心的矛依未，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}向著求籤處走去。",
    "voice": null,
    "unit_id": null
  }
]
