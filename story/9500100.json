[
  {
    "type": "background",
    "bg_id": "509040"
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "嗯♪",
    "voice": "vo_adv_9500100_000",
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n想由我來對吧。",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n知道了♪",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "不、",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "對……",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "為防萬一，我問一下，",
    "voice": "vo_adv_9500100_001",
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "您沒有搞錯人吧？",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "……我沒想到，",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "自己竟會被選中。",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n感覺非常地奇妙。",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我……",
    "voice": "vo_adv_9500100_002",
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "一直都負責支援大家和",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "整理報告，",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n不認為自己是冒險的主角。",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "但是，",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "那就是我的天職啊。",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "即便如此，",
    "voice": "vo_adv_9500100_003",
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "您還是……",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "找到了我、",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "選擇了我。",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "方便的話，",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "能讓我聽聽",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "選我的理由嗎？",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "……謝、",
    "voice": "vo_adv_9500100_004",
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "謝謝您！",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n光是聽您這麼說，",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我就感到十分光榮♪",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "不、",
    "voice": "vo_adv_9500100_005",
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "過、",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "呢！",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我覺得不要單方面支持，",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n互相支持的關係",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "才是真正的羈絆。",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我平常",
    "voice": "vo_adv_9500100_006",
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "只是暗中幫忙，",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n讓大家能夠平安歸來……",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "但在聽到",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "大家笑著說「我回來了」的瞬間，",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "還是我最開心的時刻。",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "所以，",
    "voice": "vo_adv_9500100_007",
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我希望今後也能支持您。",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我也……",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "想一直成為您的力量。",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "無論是冒險、",
    "voice": "vo_adv_9500100_008",
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "危機",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "或日常，",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "不管何時，",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我發誓",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "都會用",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n自己的一切一直",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "支持您。",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "然後，",
    "voice": "vo_adv_9500100_009",
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "不光是暗地支持，",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n我也會站在您身旁，",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "與您一同面對困難，",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "分享喜悅。",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "……全部，",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "都跟您共享……♪",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "──老實說，",
    "voice": "vo_adv_9500100_010",
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "那個……",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我不太有這種經驗。",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n肯定",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "會有很多混亂的問題，",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "但還是請您多多指教喔♪",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "呵呵呵……",
    "voice": "vo_adv_9500100_011",
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "有點害羞呢。",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "會使出全力努力的，",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "今後也請您",
    "voice": null,
    "unit_id": 118541
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "務必要依靠我喔♪",
    "voice": null,
    "unit_id": 118541
  }
]
