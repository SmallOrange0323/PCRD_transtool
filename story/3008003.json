[
  {
    "type": "background",
    "bg_id": "500070"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在公會小屋裡，秋乃和珠希兩人，\\n正跪坐在美冬面前聽訓。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "妳們兩個都太浪費了！",
    "voice": "vo_adv_3008003_000",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "秋乃本來花錢就沒有節制，",
    "voice": "vo_adv_3008003_001",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "珠希也買太多貓飼料了！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "雖然我不想說太過嚴厲的話，",
    "voice": "vo_adv_3008003_002",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "但再這樣下去，就不得不動到",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n我們運用來投資和貸款的錢了喔？",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我一直都只過著這樣的生活……",
    "voice": "vo_adv_3008003_003",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n現在才要我改變，我做不到。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我也是，一看見貓咪們那副",
    "voice": "vo_adv_3008003_004",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "「給我飼料」的表情，",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "就無法視而不見喵……",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "找藉口也沒用！",
    "voice": "vo_adv_3008003_005",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n總之，我會暫時將妳們兩個減薪！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "唉……",
    "voice": "vo_adv_3008003_006",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n這下傷腦筋了……",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "真是的喵。",
    "voice": "vo_adv_3008003_007",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n這樣下去，就沒辦法給貓咪們飼料了喵。",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "咦？ 在那裡的是？",
    "voice": "vo_adv_3008003_008",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "喂――聽我說喵！\\n美冬好過分喵！",
    "voice": "vo_adv_3008003_009",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "因為花費過度，",
    "voice": "vo_adv_3008003_010",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n竟然減薪這麼多……",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我們接下來該怎麼辦才好呢？",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "有效利用……",
    "voice": "vo_adv_3008003_011",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "啊！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n我想到了喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "賺錢……！",
    "voice": "vo_adv_3008003_012",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我有好方法喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "多虧你讓我想到好辦法喵！",
    "voice": "vo_adv_3008003_013",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "錢變少的話，我們只要自己想辦法賺就好了喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "話是這麼說沒錯……",
    "voice": "vo_adv_3008003_014",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "但該怎麼增加呢？",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我知道一個好地方喵！",
    "voice": "vo_adv_3008003_015",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "跟我來喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "background",
    "bg_id": "500050"
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "看起來只是普通的餐廳呀？",
    "voice": "vo_adv_3008003_016",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "其實這間店裡有人在玩紙牌賭博喵。",
    "voice": "vo_adv_3008003_017",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "如果我們參加的話，一定能賺錢喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "背地裡賭博……",
    "voice": "vo_adv_3008003_018",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "真的沒問題嗎？",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "只是店裡的顧客彼此在玩而已，不是犯罪喵！",
    "voice": "vo_adv_3008003_019",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我沒有擊潰這裡就是最佳證據喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "確實。若有做壞事的人，",
    "voice": "vo_adv_3008003_020",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "珠希就不可能會介紹給我吧。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "那麼，我們馬上參戰吧喵！",
    "voice": "vo_adv_3008003_021",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n這裡玩的是五張換喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "秋乃妳仔細聽好。首先將牌……",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "……葫蘆。",
    "voice": "vo_adv_3008003_022",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我贏了。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "湊熱鬧的",
    "words": "好厲害－！",
    "voice": "vo_adv_3008003_023",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "湊熱鬧的",
    "words": "\\n那位小姑娘，這麼算下來可是十連勝了！？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "有我的好運加持的話，贏紙牌遊戲再簡單不過！",
    "voice": "vo_adv_3008003_024",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我會繼續贏下去喔！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "對戰對手",
    "words": "嘿嘿嘿……是三條。",
    "voice": "vo_adv_3008003_025",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "對戰對手",
    "words": "\\n很遺憾，這次是我贏了。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "等等喵！ ",
    "voice": "vo_adv_3008003_026",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這傢伙出老千喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n他偷換牌喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n藏在袖子內的紙牌就是證據喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "對戰對手",
    "words": "可、",
    "voice": "vo_adv_3008003_027",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "對戰對手",
    "words": "可惡！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "對戰對手",
    "words": "\\n為什麼會露餡……！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "喵哈哈！",
    "voice": "vo_adv_3008003_028",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "別想逃過我的法眼喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我和珠希聯合起來就是最強的呢。",
    "voice": "vo_adv_3008003_029",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n感覺不會輸啊！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "趁著這個氣勢，大賺一筆吧──！",
    "voice": "vo_adv_3008003_030",
    "unit_id": 104611
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "數天後──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "好奇怪……",
    "voice": "vo_adv_3008003_031",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n我還以為兩個人差不多也該有所反省，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n哭著跑來央求了……",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "最近她們反倒好像很開心？",
    "voice": "vo_adv_3008003_032",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "該說是生氣勃勃……？",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "真可疑……似乎有什麼隱情呢。",
    "voice": "vo_adv_3008003_033",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "抱歉呢。讓你幫忙買東西，",
    "voice": "vo_adv_3008003_034",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n還問你這種事……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "不，你也是重要的參考人喔。",
    "voice": "vo_adv_3008003_035",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n而且你和秋乃她們感情又不錯。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我就是因為這件事，今天才找你過來的！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "你知道最近那兩個人發生什麼事了嗎？",
    "voice": "vo_adv_3008003_036",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "靠賭博來賺錢！？",
    "voice": "vo_adv_3008003_037",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "那兩個人真的是……！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "賭博可是節儉的敵人喔！",
    "voice": "vo_adv_3008003_038",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n優花梨，來幫忙！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "好是好，但我該做些什麼呢……？",
    "voice": "vo_adv_3008003_039",
    "unit_id": 103411
  },
  {
    "type": "background",
    "bg_id": "500050"
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "喔呵呵呵！ ",
    "voice": "vo_adv_3008003_040",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "又是我贏了呢！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n贏成這樣，連我都害怕自己的好運呢。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "只要有我跟著，",
    "voice": "vo_adv_3008003_041",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n就不用擔心有人出老千而輸喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "賺飽飽，狂歡了喵──！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "秋乃？ 珠希？",
    "voice": "vo_adv_3008003_042",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n妳們在做什麼？",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "美冬！？",
    "voice": "vo_adv_3008003_043",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "這、這是、那個……不是的！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "秋乃，冷靜喵！",
    "voice": "vo_adv_3008003_044",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n我們並沒有做壞事喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "要怎麼用自己的錢，是我們的自由喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "就算是這樣，賭博也太超過了。",
    "voice": "vo_adv_3008003_045",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "因為我們受妳的父親所託，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "得要教妳腳踏實地的生活方式。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "但是就結果來看，我們並沒有輸喔？",
    "voice": "vo_adv_3008003_046",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "有賺到錢這點，對美冬而言不也是件開心的事嗎？",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "妳們兩個異口同聲地說賺到錢了，",
    "voice": "vo_adv_3008003_047",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n荷包卻似乎意外地空呢？",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "那、",
    "voice": "vo_adv_3008003_048",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "那是因為……",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "賺到的錢馬上就花掉了，這也是沒辦法的事喵。",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我可是為了矯正妳們浪費的習慣才減薪喔？",
    "voice": "vo_adv_3008003_049",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這樣一來豈不是一點意義也沒有了……",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "唔……但是，這是我們自己贏來的錢喵！",
    "voice": "vo_adv_3008003_050",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "要怎麼花都隨我們高興喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這樣啊……",
    "voice": "vo_adv_3008003_051",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "看起來相當有自信呢。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "那麼，我和優花梨組成一隊，和妳們以紙牌決勝負吧。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我會賭上我所有的存款。誓約書已經寫好帶來了。",
    "voice": "vo_adv_3008003_052",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "順帶一提，如果贏了我們，妳們以後要繼續賭博也沒關係。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "這也……可以嗎？",
    "voice": "vo_adv_3008003_053",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "但是，妳們也必須賭上相同的金額喔。",
    "voice": "vo_adv_3008003_054",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "而且若是我們贏的話，妳們就不能再賭博！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n沒問題吧？",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "求之不得喵！",
    "voice": "vo_adv_3008003_055",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n我會讓妳們後悔向我們挑戰喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "兩對！",
    "voice": "vo_adv_3008003_056",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "想贏我和珠希，妳們還早一百年呢。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我們立馬就佔了優勢喵。",
    "voice": "vo_adv_3008003_057",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "順著這個氣勢贏下去吧喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "顧客１",
    "words": "讚！不愧是秋乃姑娘！",
    "voice": "vo_adv_3008003_058",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "顧客２",
    "words": "就這樣把他們手頭的錢都贏光光吧－！",
    "voice": "vo_adv_3008003_059",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "……優花梨。還能繼續下去吧？",
    "voice": "vo_adv_3008003_060",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "是的，還可以喔。",
    "voice": "vo_adv_3008003_061",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "喵呵呵……看來手上的錢相當多呢喵♪",
    "voice": "vo_adv_3008003_062",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "秋乃，既然如此，我們就從她們身上多榨點錢吧！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "了解！",
    "voice": "vo_adv_3008003_063",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "葫蘆喔。",
    "voice": "vo_adv_3008003_064",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "是一對……",
    "voice": "vo_adv_3008003_065",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "這點錢算不了什麼！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "顧客１",
    "words": "別在意！現在開始才是勝負！",
    "voice": "vo_adv_3008003_066",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "沒錯……才這點錢，",
    "voice": "vo_adv_3008003_067",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n之前我也曾經逆轉翻盤。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "這次絕對不會輸的！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "一對……",
    "voice": "vo_adv_3008003_068",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這樣就分出勝負了吧？",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "不，等一下喵！",
    "voice": "vo_adv_3008003_069",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n一口氣就被逆轉了喵！？",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "怎麼一回事喵！？",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "同花順喔。",
    "voice": "vo_adv_3008003_070",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "……是我們贏得壓倒性的勝利，沒異議吧？",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "這、這是怎麼回事……",
    "voice": "vo_adv_3008003_071",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n竟然讓我們束手無策！？",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "很簡單呀。",
    "voice": "vo_adv_3008003_072",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n我靠著紙牌上的刮痕，將所有的數字背了起來。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "紙牌不可能會有那麼明顯的刮痕才對喵！",
    "voice": "vo_adv_3008003_073",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "因為是紙做的，只要動作粗魯一點，就會刮傷了對吧？",
    "voice": "vo_adv_3008003_074",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "妳看，像是這裡。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這也太小了喵！",
    "voice": "vo_adv_3008003_075",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "妳是在比賽進行時確認刮痕的嗎喵？",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "那當然。",
    "voice": "vo_adv_3008003_076",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "而且妳們讓優花梨和我一起對戰，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n是很失策的。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "因為我很了解妳們兩個的習性，",
    "voice": "vo_adv_3008003_077",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "只靠表情和動作舉止，就能知道妳們抽到什麼牌。",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "竟然有這種方法……",
    "voice": "vo_adv_3008003_078",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "還有，周圍的觀眾全部都是幫手喔。",
    "voice": "vo_adv_3008003_079",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n在每個人進到店裡之前，我就幫他們付了酒錢。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "妳說什麼！？",
    "voice": "vo_adv_3008003_080",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "奇怪喵，妳如果出老千的話，我一定會察覺到的喵！",
    "voice": "vo_adv_3008003_081",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "為了讓妳們在一定的程度上輕鬆獲勝，",
    "voice": "vo_adv_3008003_082",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n我可是拜託大家拚命幫妳們加油喔。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n妳們兩個，比到一半就對我們放下戒心了對吧？",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "也就是說，",
    "voice": "vo_adv_3008003_083",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n周圍的人只是在免費的吃喝，幫妳們加油而已。",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "效果很棒對吧？",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "顧客２",
    "words": "優花梨！下次好好地來喝一杯吧！",
    "voice": "vo_adv_3008003_084",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "顧客２",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "顧客２",
    "words": "很少看到你這種沒喝醉的樣子，真有意思！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "啊哈哈……如果我心情好的話。",
    "voice": "vo_adv_3008003_085",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "被、",
    "voice": "vo_adv_3008003_086",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "被擺了一道喵……",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n因為跟出老千不一樣，所以我沒看穿喵……",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "那麼……我們贏了也就代表……",
    "voice": "vo_adv_3008003_087",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "還記得約定吧？",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "……我知道了。",
    "voice": "vo_adv_3008003_088",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我不會再賭博了",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "應該不是只有這樣吧？",
    "voice": "vo_adv_3008003_089",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n我們可是賭上了全部的存款喔？",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "也就是說，妳們輸的金額比手頭上的錢還要多。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "……！",
    "voice": "vo_adv_3008003_090",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "金額相當大呢……妳們兩個的薪水支付得起嗎？",
    "voice": "vo_adv_3008003_091",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "若是付不起的話，即使借錢也要還喔♪",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n說到這個，我們公會有提供借貸服務……",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "怎麼會喵啊啊啊啊！ 我討厭借錢喵啊啊啊啊啊……！",
    "voice": "vo_adv_3008003_092",
    "unit_id": 104611
  },
  {
    "type": "background",
    "bg_id": "500070"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "隔天――",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "工、工作結束了喵……",
    "voice": "vo_adv_3008003_093",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "……文件擬好了。",
    "voice": "vo_adv_3008003_094",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "那麼，接下來就麻煩妳們打掃房間，",
    "voice": "vo_adv_3008003_095",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n之後幫忙完成新事業的計劃書。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "嗚……妳也讓我們做太多事了喵！",
    "voice": "vo_adv_3008003_096",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "反對不當勞動喵！ 我們也應該擁有權利――！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "為什麼我們會被欺負到這種地步呢……！",
    "voice": "vo_adv_3008003_097",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "如果不多做些工作，不就無法償還向公會借的款項了嗎？",
    "voice": "vo_adv_3008003_098",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "而且作為賭博的懲罰，妳們的薪水又更少了。",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "因為公會日益壯大，人手真的不足。",
    "voice": "vo_adv_3008003_099",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "抱歉兩位，我今天要先走了，之後就麻煩妳們囉。",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "辛苦了，優花梨。",
    "voice": "vo_adv_3008003_100",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "……在她們把錢還清之前，就由我會代理公會長一職喔！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "喏，手腳俐落點！ 時間就是金錢喔！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我……",
    "voice": "vo_adv_3008003_101",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "我已經受夠賭博了──！！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我最討厭借錢了喵啊啊啊……！！",
    "voice": "vo_adv_3008003_102",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "秋乃和珠希在心裡深深地發誓，\\n這輩子絕對不會再賭博了。",
    "voice": null,
    "unit_id": null
  }
]
