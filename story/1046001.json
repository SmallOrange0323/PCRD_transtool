[
  {
    "type": "background",
    "bg_id": "500210"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "當{0}走在山路時，\\n傳來有人在激烈戰鬥的聲音。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "喵！ 喵，喵！",
    "voice": "vo_adv_1046001_000",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘰歐歐歐歐歐",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "太好了，",
    "voice": "vo_adv_1046001_001",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "打倒牠了喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "領教到我的實力了吧喵……",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "魔物群",
    "words": "──呱歐歐歐歐歐！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……嗯，",
    "voice": "vo_adv_1046001_002",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "哇啊啊啊啊啊！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我以為打倒的這隻魔物居然分裂了喵啊啊啊！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "嗚嗚嗚，真棘手喵……",
    "voice": "vo_adv_1046001_003",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我以為只要從反方向同時攻擊，",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n就能簡單的打倒牠們喵……至少再有一個人幫忙的話──",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "喵……？ 在那邊的是冒險者嗎喵？",
    "voice": "vo_adv_1046001_004",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "喵喵喵─！ 來得正好喵！",
    "voice": "vo_adv_1046001_005",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n你來幫我一下喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "喵喵！",
    "voice": "vo_adv_1046001_006",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n那麼，當我說「預備─起，喵」，",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n你就從另一邊攻擊喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "預備─起，喵",
    "voice": "vo_adv_1046001_007",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "background",
    "bg_id": "500210"
  },
  {
    "type": "dialogue",
    "name": "魔物１",
    "words": "──嘰歐歐歐歐歐",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物１",
    "words": "！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "很完美喵！",
    "voice": "vo_adv_1046001_008",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "另一隻也……預備─起，喵喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "background",
    "bg_id": "500210"
  },
  {
    "type": "dialogue",
    "name": "魔物２",
    "words": "──嘰歐歐歐歐歐",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "魔物２",
    "words": "！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "喵喵！ ",
    "voice": "vo_adv_1046001_009",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "大獲全勝喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "多虧有你幫忙喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "雖然想送你什麼當作謝禮，",
    "voice": "vo_adv_1046001_010",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n不巧的是，我身上沒什麼特別的東西喵。",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "但是，總有一天我一定會答謝你的喵！",
    "voice": "vo_adv_1046001_011",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "請期待吧喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "那麼，我先告辭了喵。",
    "voice": "vo_adv_1046001_012",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "非常謝謝你喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "background",
    "bg_id": "500211"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "與貓耳少女分開後，\\n{0}走在崎嶇不平的山路上。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "喵？ ",
    "voice": "vo_adv_1046001_013",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "感覺剛剛好像有人從山崖跌落了喵？",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "啊，",
    "voice": "vo_adv_1046001_014",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "在那裡的，",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n不就是剛剛幫助我的人嗎喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "不好了喵───！",
    "voice": "vo_adv_1046001_015",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n我現在馬上就來救你喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "喵咕嚕靈！",
    "voice": "vo_adv_1046001_016",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你很驚訝嗎喵？",
    "voice": "vo_adv_1046001_017",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "因為我是貓獸，動作輕盈，",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n所以很擅長跳躍、潛入之類的喵。",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "嗯，這些話等等再說喵！",
    "voice": "vo_adv_1046001_018",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你身上都是傷喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "喵─……",
    "voice": "vo_adv_1046001_019",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你的傷不要緊吧喵？",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n你不介意的話……",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "作為剛才你幫我的謝禮，",
    "voice": "vo_adv_1046001_020",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我以390盧幣的優惠價格賣你療傷藥喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "什麼啊，你一臉被貓抓傷的樣子喵。",
    "voice": "vo_adv_1046001_021",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我可是將原價一倍以上的藥，",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n特別優惠給你的喵。",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "不要說這麼失禮的話喵。",
    "voice": "vo_adv_1046001_022",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我可是將原價一倍以上的藥，",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n特別優惠給你的喵。",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "嗯─，真沒辦法喵……",
    "voice": "vo_adv_1046001_023",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n就算這麼說，但剛剛受到你的幫助喵……",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "嗯，",
    "voice": "vo_adv_1046001_024",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我決定了喵。",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "今天就讓你試用吧喵。",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你說謝謝我……",
    "voice": "vo_adv_1046001_025",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "這是我給你的謝禮，",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n所以你沒有必要向我道謝喵。",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……啊，對了，",
    "voice": "vo_adv_1046001_026",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n雖說要向你道謝，",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "剛剛忘了問你的名字喵。",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "嗯……你叫這個名字啊喵。",
    "voice": "vo_adv_1046001_027",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我是珠希喵！",
    "voice": "vo_adv_1046001_028",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "因為我在鯛魚燒店打工，常常會到處奔走，",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n所以我想我們一定會再見面的喵。",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "之後也請多關照喵！",
    "voice": "vo_adv_1046001_029",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "那麼我就先告辭了……",
    "voice": "vo_adv_1046001_030",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "咦，喵喵？",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "你臉頰上還有傷口喵。",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "但是我已經沒有療傷藥了喵……",
    "voice": "vo_adv_1046001_031",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這樣的話――",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "still",
    "still_id": "104600101"
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "――舔。",
    "voice": "vo_adv_1046001_032",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "你問我做什麼，",
    "voice": "vo_adv_1046001_033",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "因為你還有傷口，",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n我就是舔一下幫你消毒喵。",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "喵哈哈，你好像相當驚訝喵。",
    "voice": "vo_adv_1046001_034",
    "unit_id": 104611
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "算了，這是給你的優惠！",
    "voice": "vo_adv_1046001_035",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "再見喵―♪",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "珠希留下不知所措的{0}，\\n如風般離開了……",
    "voice": null,
    "unit_id": null
  }
]
