[
  {
    "type": "background",
    "bg_id": "501193"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "遭到自海底出現的巨魚攻擊，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n【美食殿堂】的成員們落入海中──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……嗚",
    "voice": "vo_adv_5056001_000",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……這裡是？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "看起來……",
    "voice": "vo_adv_5056001_001",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不像是海裡呢。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我們",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "應該是所有人都掉入海中了啊──",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是的。",
    "voice": "vo_adv_5056001_002",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n會不會是這艘船的船員",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "救了我們……？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "總覺得這艘船的外形很奇特……",
    "voice": "vo_adv_5056001_003",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……啊，",
    "voice": "vo_adv_5056001_004",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小凱留還在昏迷！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n小凱留，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "快醒來──！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "唔唔……",
    "voice": "vo_adv_5056001_005",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "會被吃掉……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n本來是要釣魚，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "卻要被魚吃掉了了了了……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "──啊！？",
    "voice": "vo_adv_5056001_006",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n這裡是哪？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我們到底怎麼了！？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n剛剛那隻像是怪物的魚呢！？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "妳、",
    "voice": "vo_adv_5056001_007",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "妳冷靜一點呀，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小凱留。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n剛剛的大魚已經不見了，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n應該很安全──",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "──呀啊！？",
    "voice": "vo_adv_5056001_008",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗚啊啊啊啊啊啊！？",
    "voice": "vo_adv_5056001_009",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n船在晃！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "晃超大的！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這整艘船似乎晃得很嚴重……！",
    "voice": "vo_adv_5056001_010",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "各位，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請小心別被甩下去了！",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "──哦哦哦哦哦哦哦哦哦哦喝啊！！！",
    "voice": "vo_adv_5056001_011",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "噫噫！？",
    "voice": "vo_adv_5056001_012",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n這、",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這次又是什麼啦！？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那是──？",
    "voice": "vo_adv_5056001_013",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕哦哦哦哦哦！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "──唔哦哦……！！",
    "voice": "vo_adv_5056001_014",
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那、",
    "voice": "vo_adv_5056001_015",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那個魚型魔物是",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "剛剛的……！？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不，",
    "voice": "vo_adv_5056001_016",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "外觀的確是很像沒錯……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n體型卻好像比剛剛看到的",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "那隻小很多。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那個人似乎正在用釣線把魚拉上來──",
    "voice": "vo_adv_5056001_017",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……唔……？",
    "voice": "vo_adv_5056001_018",
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……小姑娘們，",
    "voice": "vo_adv_5056001_019",
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你們醒啦。",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "不好意思，",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "就如你們所見，我正在忙。",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n在我跟那傢伙分出勝負前，",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "麻煩你們稍等一下囉……！",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕哦哦哦哦哦！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "──呀啊！？",
    "voice": "vo_adv_5056001_020",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n這、",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這是什麼狀況？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……「金槍鮪」，",
    "voice": "vo_adv_5056001_021",
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n牠們是只棲息於這片大間海域中的魔物。",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n而我現在就是要釣起牠……！",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "喔喔喔喔！！！！",
    "voice": "vo_adv_5056001_022",
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕哦哦哦哦哦！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "竟、",
    "voice": "vo_adv_5056001_023",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "竟然只憑臂力，就把魚給扯過來了……！",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "騙、",
    "voice": "vo_adv_5056001_024",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "騙人的吧……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n他真的釣得起那麼大的魚嗎！？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "嗚喔喔喔喔喔喔喔喔──！！！",
    "voice": "vo_adv_5056001_025",
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "──呀嗯！？",
    "voice": "vo_adv_5056001_026",
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……",
    "voice": "vo_adv_5056001_027",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……",
    "voice": "vo_adv_5056001_028",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……",
    "voice": "vo_adv_5056001_029",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……咦？",
    "voice": "vo_adv_5056001_030",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "他剛剛、",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "跌倒了？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n他腳滑跌倒了吧？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "等、",
    "voice": "vo_adv_5056001_031",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "等等！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那或許是某種戰術。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "況且你們看，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "他似乎是個很厲害的漁夫！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不對吧，",
    "voice": "vo_adv_5056001_032",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "他剛剛不是叫了聲「啊嗯！？」嗎？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n都一把年紀了，還不由自主地叫出充滿少女心的悲鳴耶。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……",
    "voice": "vo_adv_5056001_033",
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……故意裝成腳滑，",
    "voice": "vo_adv_5056001_034",
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n再發出特殊吆喝聲釣起獵物的「呀嗯漁法」……",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n真正執行起來，才發現還挺困難的啊。",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "才怪，",
    "voice": "vo_adv_5056001_035",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那是什麼樣的漁法啊！？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n雖然你煞有其事地含混過去，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "但其實就只是跌倒吧！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n魚也被逃掉了的說！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "「呀嗯漁法」……！？",
    "voice": "vo_adv_5056001_036",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "有這樣的技術啊……！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n捕魚還真是深奧呢☆",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "妳也別一副理所當然的樣子相信啊！",
    "voice": "vo_adv_5056001_037",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……捕魚就是會伴隨著意外。",
    "voice": "vo_adv_5056001_038",
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "不、不不不",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "不要著急，",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "獵物會從著急的傢伙手中逃走。",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "冷冷冷冷冷",
    "voice": null,
    "unit_id": 6411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "冷靜下來展開下一步行動──",
    "voice": null,
    "unit_id": 6411
  },
