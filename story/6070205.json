  {
    "type": "dialogue",
    "name": "サレン",
    "words": "あんた、",
    "voice": "vo_adv_6054205_000",
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "ダンスを踊ったことはあるの？",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "\\n",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "あたしはよく",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "お父様に連れられて行ってたから",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "\\n少しは教えてあげられると思うわ。",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "えっ！？　",
    "voice": "vo_adv_6054205_001",
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "アキノさんと踊ったことがあるの！？",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "\\n",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "そっか、",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "ほんとアキノさんに気に入られてるのね。",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "\\n",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "……すごいじゃない！",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "素直でよろしい！",
    "voice": "vo_adv_6054205_002",
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "\\n",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "でも",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "あまり固くやるつもりはないわ。",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "\\n",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "昔遊んだ時みたいに、",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "楽しく踊りましょ！",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "もう！　",
    "voice": "vo_adv_6054205_003",
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "ほんとにあんたは素直っていうか……",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "\\n",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "でも、",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "あたしもよ。",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "一緒に踊る相手があんたで、",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "\\nあたしもうれしい……",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "なんてね！",
    "voice": null,
    "unit_id": 114511
  }
]
