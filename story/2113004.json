    "voice": "vo_adv_2113004_029",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n不過我不太希望",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "他湊齊索爾魔珠──",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "反正肯定不會用在什麼好事上面。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "哈！",
    "voice": "vo_adv_2113004_030",
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我不知道你們到底怎麼了，",
    "voice": null,
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不過看來是鬧內訌啦！？",
    "voice": null,
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小凱留！？",
    "voice": "vo_adv_2113004_031",
    "unit_id": 180411
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "哎呀～",
    "voice": "vo_adv_2113004_032",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "準備了那麼多魔物，全都被你們解決掉了啊。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "你們真是厲害。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n看來真的有變強了呢──",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不需要誇獎我們！",
    "voice": "vo_adv_2113004_033",
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n快點老實投降吧，",
    "voice": null,
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不然我就宰了你！！",
    "voice": null,
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "對了……！",
    "voice": "vo_adv_2113004_034",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "如果他就是操縱魔物的人，",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n肯定",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "還留有一手……",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "…………",
    "voice": "vo_adv_2113004_035",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "呃……",
    "voice": "vo_adv_2113004_036",
    "unit_id": 180411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n尾狗刀先生！",
    "voice": null,
    "unit_id": 180411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我們要不要先一起吃個飯，",
    "voice": null,
    "unit_id": 180411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好好溝通一下呢！？",
    "voice": null,
    "unit_id": 180411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "話說回來！",
    "voice": "vo_adv_2113004_037",
    "unit_id": 180411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n你為什麼要",
    "voice": null,
    "unit_id": 180411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "幫助厄莉絲小姐呢！？",
    "voice": null,
    "unit_id": 180411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n請你告訴我！",
    "voice": null,
    "unit_id": 180411
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "嗯～",
    "voice": "vo_adv_2113004_038",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "對我來說，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n這個世界會變得怎樣，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n我其實不怎麼在乎──",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "什麼「重蹈覆轍」之類的事情，",
    "voice": "vo_adv_2113004_039",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n老實說我一點都不想管──",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "而且",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "我還有契約在身嘛？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "重蹈覆轍……",
    "voice": "vo_adv_2113004_040",
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "呃，",
    "voice": null,
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "指的是",
    "voice": null,
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "世界會輪迴嗎……！？美空也說過。",
    "voice": null,
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "嗯，",
    "voice": "vo_adv_2113004_041",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "你們要怎麼想都無所謂啦。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n不過不管用什麼方法，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "既然我是站在「厄莉絲大人」這邊的──",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "很可惜，",
    "voice": "vo_adv_2113004_042",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n我就不可能",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "和你們聯手──",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "黑色風之精靈？",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 14411
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "嗚",
    "voice": "vo_adv_2113004_043",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "嗚！？",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n好好好、",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "好像有很不得了的東西出現了……！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "這叫聲是……？",
    "voice": "vo_adv_2113004_044",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "和我們剛剛",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "聽到的一樣……！",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小凱留！",
    "voice": "vo_adv_2113004_045",
    "unit_id": 180411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 180411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那隻精靈是──！",
    "voice": null,
    "unit_id": 180411
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那不是黑色風之精靈嗎！",
    "voice": "vo_adv_2113004_046",
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n明明已經在可蘿仔的",
    "voice": null,
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "儀式上淨化他了！？",
    "voice": null,
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "我是不太清楚",
    "voice": "vo_adv_2113004_047",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "這傢伙的事情──",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "不過你們打倒的",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "「黑色風之精靈」",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "是別的個體。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "別的個體……？",
    "voice": "vo_adv_2113004_048",
    "unit_id": 180411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n可、",
    "voice": null,
    "unit_id": 180411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "可是，",
    "voice": null,
    "unit_id": 180411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "長得幾乎一樣啊……！",
    "voice": null,
    "unit_id": 180411
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "我有個同僚的興趣，",
    "voice": "vo_adv_2113004_049",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n是破解、",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "和重現資料喔──",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "能操縱那個叫贊恩的龍人族屍體，",
    "voice": "vo_adv_2113004_050",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "似乎也是那個研究的一環。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "真是個品味低級的傢伙，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "你們說是吧──？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "贊恩……",
    "voice": "vo_adv_2113004_051",
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "重現……",
    "voice": null,
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "所以這也是彌勒",
    "voice": null,
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "搞的鬼喔……！",
    "voice": null,
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "一開始拿到這玩意時我也不知道有什麼用，",
    "voice": "vo_adv_2113004_052",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "不過只要好好利用",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "這種精靈能強制讓魔物失控的特性，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n我做起事來也就事半功倍了喔？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "而且也能用來阻撓",
    "voice": "vo_adv_2113004_053",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "你們這些礙事的人──",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "黑色風之精靈‧複製",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 14411
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "那",
    "voice": "vo_adv_2113004_054",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "我先去和長老打聲招呼，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "把該辦的事情辦一辦。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "你們就和這傢伙玩玩吧──",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "可惡……！",
    "voice": "vo_adv_2113004_055",
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "給我",
    "voice": null,
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "等一下！",
    "voice": null,
    "unit_id": 180611
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小凱留，",
    "voice": "vo_adv_2113004_056",
    "unit_id": 180411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小心一點！",
    "voice": null,
    "unit_id": 180411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n這隻精靈，",
    "voice": null,
    "unit_id": 180411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "力量比以前更強了！",
    "voice": null,
    "unit_id": 180411
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "啊哇哇哇哇哇！！",
    "voice": "vo_adv_2113004_057",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我──",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "說──",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "初──",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "音──啊──！！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "……嗯呃！",
    "voice": "vo_adv_2113004_058",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n呼嚕～",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "再給我睡500年……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那時候我們都變成骨灰啦──！！",
    "voice": "vo_adv_2113004_059",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "啊！",
    "voice": "vo_adv_2113004_060",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "對了。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n這個",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "也順便留下來好了──",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "still",
    "still_id": "211300401"
  },
  {
    "type": "dialogue",
    "name": "厄莉絲的使者",
    "words": "…………！",
    "voice": null,
    "unit_id": 191313
  },
  {
