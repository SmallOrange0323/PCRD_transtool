  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "恢復魔法好了──",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "尾狗刀先生！？",
