    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "不要再抵抗囉。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n其實做這種事",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "我也挺心痛的～",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "啊哇哇哇哇！",
    "voice": "vo_adv_2113004_020",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "初音初音，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "快點起來！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n疑似敵方老大的人物出現了！！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "初音",
