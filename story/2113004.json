    "name": "碧",
    "words": "\\n已經",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "快撐不下去啦。",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "不過……",
