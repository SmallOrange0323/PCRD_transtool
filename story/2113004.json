    "name": "碧",
    "words": "嗚！",
    "voice": "vo_adv_2113004_014",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n不不不不認識的人突然冒出來……！？",
