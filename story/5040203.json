[
  {
    "type": "dialogue",
    "name": "栞",
    "words": "總算打倒他們了。",
    "voice": "vo_adv_5040203_000",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "真是些不能掉以輕心的傢伙呢。",
    "voice": "vo_adv_5040203_001",
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "雖然不知道在他身後的監察官",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "到底想做什麼。",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "從頭到尾都在後面偷偷摸摸的，",
    "voice": "vo_adv_5040203_002",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n以一個上位者來說",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "這樣做對嗎……",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "既然沒有膽量挺身站在前面，",
    "voice": "vo_adv_5040203_003",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n那一開始就不該做壞事啦。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "嗯？　",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "他好像又想做些什麼了。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "唉……",
    "voice": "vo_adv_5040203_004",
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "真不肯死心。",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "在事情變得更棘手之前，",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "早點收拾掉他們吧。",
    "voice": null,
    "unit_id": 112711
  }
]
