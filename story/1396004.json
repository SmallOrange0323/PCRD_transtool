    "name": "媞雅",
    "words": "不要突然跑進",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n柔弱女子的家裡啊，笨蛋。",
