  {
    "type": "dialogue",
    "name": "旁白",
    "words": "啟程前往背面世界之前，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}他們順道去了厄莉絲的城堡，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n然後……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500510"
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……「那兩個人」，",
    "voice": "vo_adv_5137068_000",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n回到原本的世界了，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "騎士先生。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "那個嚮導小妖精",
    "voice": "vo_adv_5137068_001",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "沒有跟你說這件事嗎……？",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "但是？",
    "voice": "vo_adv_5137068_002",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "道謝……",
    "voice": "vo_adv_5137068_003",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n難道說，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "是跟我道謝？",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……不客氣。",
    "voice": "vo_adv_5137068_004",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "那、",
    "voice": "vo_adv_5137068_005",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "那個，",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我也要跟妳道謝……！",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n非常謝謝妳！",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "…………",
    "voice": "vo_adv_5137068_006",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "草野優衣……",
    "voice": "vo_adv_5137068_007",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n為什麼，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "連妳都進來了……",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "因、",
    "voice": "vo_adv_5137068_008",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "因為我想謝謝妳",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "幫了我們……",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "而且……",
    "voice": "vo_adv_5137068_009",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n說不定暫時",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "沒辦法回來這邊了，",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n所以想在那之前道謝……",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "不好意思。",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "這樣啊……",
    "voice": "vo_adv_5137068_010",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "那個。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "路上小心喔，",
    "voice": "vo_adv_5137068_011",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "騎士先生。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n如果有什麼事……",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "就跟我說一聲。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "一路順風。",
    "voice": "vo_adv_5137068_012",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "那、",
    "voice": "vo_adv_5137068_013",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "那我們就告辭了……",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……草野優衣。",
    "voice": "vo_adv_5137068_014",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "是！",
    "voice": "vo_adv_5137068_015",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "妳過來這邊。",
    "voice": "vo_adv_5137068_016",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n耳朵湊過來。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "騎士先生，",
    "voice": "vo_adv_5137068_017",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "抱歉。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "你可以稍微",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "離遠一點嗎？",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "湊、",
    "voice": "vo_adv_5137068_018",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "湊過來了……",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……騎士先生他，",
    "voice": "vo_adv_5137068_019",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n給妳「那時候」的答覆了嗎？",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "「那時候」的……？",
    "voice": "vo_adv_5137068_020",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "妳在前往【憤怒‧軍團】據點的船上，",
    "voice": "vo_adv_5137068_021",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n向騎士先生",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "傳達了某件事吧。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "咦？",
    "voice": "vo_adv_5137068_022",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n難道，",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "妳是指──",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "still",
    "still_id": "513706801"
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "告……",
    "voice": "vo_adv_5137068_023",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n告告告",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "告白的……！？",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "background",
    "bg_id": "500510"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "為什麼厄莉絲",
    "voice": "vo_adv_5137068_024",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "會知道這件事？",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n當時明明沒有任何人在旁邊才對……！",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "這種事情怎樣都好吧。",
    "voice": "vo_adv_5137068_025",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "快回答我。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "才、",
    "voice": "vo_adv_5137068_026",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "才不是怎樣都好……",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "那件事……",
    "voice": "vo_adv_5137068_027",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "現在",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "不重要。",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n因為狀況，",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "和那時候已經完全不同了……",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "現在重要的是，",
    "voice": "vo_adv_5137068_028",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "去尋找雪菲",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n還有",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "消失的人們。",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……而且……",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我覺得自己沒有資格因為得不到答覆而著急。",
    "voice": "vo_adv_5137068_029",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "所以……",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我會等他。",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……這樣啊。",
    "voice": "vo_adv_5137068_030",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "草野優衣。",
    "voice": "vo_adv_5137068_031",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n妳接下來要跟騎士先生去冒險，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n跟他之間的回憶一定又會增加吧。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "然後……",
    "voice": "vo_adv_5137068_032",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "一定會更加被他吸引。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "…………！",
    "voice": "vo_adv_5137068_033",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……不過，",
    "voice": "vo_adv_5137068_034",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "那只是妳的自滿。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n就算回憶增加了，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "對我來說也微不足道。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我比妳更了解騎士先生，",
    "voice": "vo_adv_5137068_035",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n是妳完全比不上的程度。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "比方說──",
    "voice": "vo_adv_5137068_036",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "啊嗚！？",
    "voice": "vo_adv_5137068_037",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……剛、",
    "voice": "vo_adv_5137068_038",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "剛才的是……？",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "是餞別禮。",
    "voice": "vo_adv_5137068_039",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "雖然微不足道，",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n不過妳就拿去吧。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "不。",
    "voice": "vo_adv_5137068_040",
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "什麼事都沒有。",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……嗯、",
    "voice": "vo_adv_5137068_041",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "嗯。",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n我只是有點站不穩而已。",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "啊哈哈……",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "只有一瞬間……",
    "voice": "vo_adv_5137068_042",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n雖然只有一瞬間，",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "但剛剛……",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
