[
  {
    "type": "background",
    "bg_id": "500170"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在城鎮的近郊，有一位抱頭苦惱的小孩。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "啊──真是的！",
    "voice": "vo_adv_1050001_000",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n接下來",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "這樣要我該怎麼辦才好！？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "這樣的話，",
    "voice": "vo_adv_1050001_001",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "不就變成是我在逞強了嗎……",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "不對。",
    "voice": "vo_adv_1050001_002",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n可是，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "被當作小孩果然還是令人很生氣！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "但是……",
    "voice": "vo_adv_1050001_003",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "要我和魔物戰鬥什麼的，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n萬一出了什麼狀況的話……",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "嗚……",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我該怎麼辦。",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "呀！？",
    "voice": "vo_adv_1050001_004",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "幹、",
    "voice": "vo_adv_1050001_005",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "幹嘛啦。",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你不要突然向我搭話啦！！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "話說回來，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你是誰啊！？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "不過你無法對正在苦惱的淑女置之不理，",
    "voice": "vo_adv_1050001_006",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n也算是蠻有紳士風度的……",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "呀！？",
    "voice": "vo_adv_1050001_007",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n你、",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你這個人搞什麼！？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "話說，",
    "voice": "vo_adv_1050001_008",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你不要把我當成小孩子！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n突然跟我搭話還這麼說，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你真是個失禮的傢伙！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……說真的，",
    "voice": "vo_adv_1050001_009",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你到底是什麼人？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "難道你是來",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "向我搭訕的嗎？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "呵呵，",
    "voice": "vo_adv_1050001_010",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "果然有我這種水準之後，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n身上的那個就藏不住了呢。",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "……咦？",
    "voice": "vo_adv_1050001_011",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你問我",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "是哪個？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我是指費洛蒙啦，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "費洛蒙。",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "從成熟淑女身上散發出來的",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "魅",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "・",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "力♪",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "等等！",
    "voice": "vo_adv_1050001_012",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n什麼嘛！你一副冷淡的眼神是怎樣！！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "什、",
    "voice": "vo_adv_1050001_013",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "什麼！？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n你說差不多要五點了，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "叫我最好快點回家！？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "所‧",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "以‧",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "說！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你別把我當小孩子──！！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我把話說在前頭了，",
    "voice": "vo_adv_1050001_014",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我可是不會回家的！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "因為我等一下",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "還得去打倒魔物不可！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "咦？",
    "voice": "vo_adv_1050001_015",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n你、",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你問為什麼，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "那是因為……",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "哼！",
    "voice": "vo_adv_1050001_016",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n都是那些臭男生不好！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "因為他們不肯認同我已經是一位成熟的淑女了！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "他們故意說些",
    "voice": "vo_adv_1050001_017",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n「既然妳是大人的話，應該能打倒魔物吧」",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "之類的話……",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "男生真的是",
    "voice": "vo_adv_1050001_018",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "又蠢又幼稚！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "不過，",
    "voice": "vo_adv_1050001_019",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "像魔物這種東西，\\n我可是一點也不害怕！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我要輕鬆地打倒魔物給他們瞧瞧！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "什、",
    "voice": "vo_adv_1050001_020",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "什麼！？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你說我、",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "的腳、",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "在發抖？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "怎麼",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "可能！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你的眼睛",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "是不是有問題呀！？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "算了。",
    "voice": "vo_adv_1050001_021",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n既然連你都把我當小孩看的話，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我就做給你們看！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我會華麗",
    "voice": "vo_adv_1050001_022",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "又快速地，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "在一瞬間將魔物打倒――",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "呱歐歐歐歐歐！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "呀――！？",
    "voice": "vo_adv_1050001_023",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n出現了――――――！！？？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "怎怎怎、",
    "voice": "vo_adv_1050001_024",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "怎麼辦……",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n魔物比我想像的還要大太多了……",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "可是，",
    "voice": "vo_adv_1050001_025",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "如果不設法解決牠的話，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "男生會看不起我的――",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "呱歐歐歐歐歐！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "呀――！？",
    "voice": "vo_adv_1050001_026",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "啊，",
    "voice": "vo_adv_1050001_027",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "真是糟透了！！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "為什麼我要因為臭男生的關係，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "而落入這種窘境……！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "等、等一下！？",
    "voice": "vo_adv_1050001_028",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n你想做什麼啦！？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "竟然突然抓住我的手……",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "什麼！？",
    "voice": "vo_adv_1050001_029",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你說要逃走！？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "別開玩笑了！！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n我身為一位成熟的淑女，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "怎麼可以做這種事――",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "呱歐歐歐歐歐！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "呀――――！！",
    "voice": "vo_adv_1050001_030",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我、",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我們要逃跑了呦！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你快點在前面幫我帶路！！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "background",
    "bg_id": "500011"
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "幹、",
    "voice": "vo_adv_1050001_031",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "幹嘛啦。",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你不要一直盯著我看！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "受傷？",
    "voice": "vo_adv_1050001_032",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我沒有受傷啦！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n硬要說的話",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "，倒是你那麼大力地握住我的手，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "所以覺得手有點痛而已！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "真是的……",
    "voice": "vo_adv_1050001_033",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你為什麼",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "要做這種多餘的事？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n像那種程度的魔物，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "只要交給我這個成熟的淑女，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "就能在一瞬間優雅地――",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "什、",
    "voice": "vo_adv_1050001_034",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "什麼！？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n我什麼時候",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "說過魔物很可怕了！？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "啊，",
    "voice": "vo_adv_1050001_035",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "等一下！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我想還是算了！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你可以不用告訴我詳細情況！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "啊，",
    "voice": "vo_adv_1050001_036",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "真的是笨蛋笨蛋、",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "笨蛋！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "都是因為遇到你的關係，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我今天一整天都糟透了！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "不過，",
    "voice": "vo_adv_1050001_037",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "那個……",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "算了……",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "哼！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "那個，",
    "voice": "vo_adv_1050001_038",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你叫什麼名字？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你、",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你問我為什麼要問這種事……",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "別管那麼多，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "給我回答就對了！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "嗯……叫做{0}啊。",
    "voice": "vo_adv_1050001_039",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我知道了。",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我就姑且告訴你一下，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我的名字",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "叫美咲。",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "那個、",
    "voice": "vo_adv_1050001_040",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "呃……",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "謝、",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "謝謝你",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "救了我。",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "這、",
    "voice": "vo_adv_1050001_041",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "這種時候，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我要是不自我介紹，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "還有跟你道謝的話，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n之後我會被媽媽罵的！",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "所以……",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "多、",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "多謝你了。",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "可是、可是！",
    "voice": "vo_adv_1050001_042",
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我身為一位成熟的淑女，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n其實真的不需要什麼幫忙喔！？",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "唯獨這一點，",
    "voice": null,
    "unit_id": 105011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你絕對不要搞錯了！",
    "voice": null,
    "unit_id": 105011
  }
]
