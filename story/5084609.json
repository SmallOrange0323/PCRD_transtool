[
  {
    "type": "background",
    "bg_id": "500140"
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "明明可愛的我都露臉給你看了，",
    "voice": "vo_adv_5084609_000",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n你竟然沒有醒來……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n這可能是",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "比我想的還要嚴重的狀況呢。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "真是的……",
    "voice": "vo_adv_5084609_001",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n怎麼反倒是我盯著你的臉看啊。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "氣色看起來很健康，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "但總覺得露出了很痛苦似的表情……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "唉……",
    "voice": "vo_adv_5084609_002",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n無論我怎麼盯著自己美麗的臉，心情也還是不愉快。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不如說因為想太多，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我甚至都覺得肌膚變糟了啊。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "{0}。\\n希望你能快點醒來啊。",
    "voice": "vo_adv_5084609_003",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n這也是為了",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我還有你自己",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "喔。",
    "voice": null,
    "unit_id": 100811
  }
]
