  },
  {
    "type": "dialogue",
    "name": "參加者3",
    "words": "我才不想",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "參加者3",
    "words": "參加咧～～～！！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "喂！？",
    "voice": "vo_adv_1053010_055",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "你要去哪！？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "戰士2",
    "words": "敗者瀟灑離場才符合騎士道。",
    "voice": "vo_adv_1053010_056",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "大賽可還沒有開始喔！",
    "voice": "vo_adv_1053010_057",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n在非正式的場合決鬥，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "只是普通的幹架！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n絕不是騎士道！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "戰士2",
    "words": "這顆饅頭還真是說得振振有詞。",
    "voice": "vo_adv_1053010_058",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這次是饅頭！？",
    "voice": "vo_adv_1053010_059",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "你說了饅頭對吧！？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n你們兩兄弟，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "從剛才起就沒禮貌到家耶！？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "可惡，",
    "voice": "vo_adv_1053010_060",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "就算他們很沒禮貌……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "但毫無破綻。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n那道牆也是",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "僅憑一劍就打破的吧。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n他們是極為少見的高手。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "戰士1",
    "words": "……原來如此，",
    "voice": "vo_adv_1053010_061",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "戰士1",
    "words": "看來妳有點底子啊。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "戰士1",
    "words": "\\n皮球小朋友，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "戰士1",
    "words": "把手從劍上拿開，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "戰士1",
    "words": "妳要是拔劍可不只是受傷能解決的啊。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……我才不會在這裡拔劍。",
    "voice": "vo_adv_1053010_062",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n我們要",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "在這場大賽裡做了斷！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "戰士2",
    "words": "就我看來，",
    "voice": "vo_adv_1053010_063",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "戰士2",
    "words": "妳連搭檔都沒有的樣子？",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "戰士2",
    "words": "\\n說到底，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "戰士2",
    "words": "憑妳一個人是要怎麼出席大賽？",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "閣、",
    "voice": "vo_adv_1053010_064",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "閣下……！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "你不用出面……！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n這是我自己的問題……！！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "戰士1",
    "words": "什麼啊？",
    "voice": "vo_adv_1053010_065",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "戰士1",
    "words": "這次是根瘦竹竿跑出來了。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "戰士1",
    "words": "\\n我今天早上吃的帶骨肉，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "戰士1",
    "words": "反而還有更多肌肉……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "戰士1",
    "words": "\\n他似乎比剛才的男人還弱呢。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "喂！你！",
    "voice": "vo_adv_1053010_066",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "別用外表來評判別人！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n你要是敢羞辱這個人，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我可不會善罷甘休！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "你們，",
    "voice": "vo_adv_1053010_067",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "給我聽仔細了！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n我們會奪得冠軍！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "把你們通通打倒！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "戰士2",
    "words": "那麼，",
    "voice": "vo_adv_1053010_068",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "戰士2",
    "words": "我就不抱期待地等你們來吧。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……我說了……！！",
    "voice": "vo_adv_1053010_069",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n結果，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "竟然把{0}給捲了進來……！！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……嗯？",
    "voice": "vo_adv_1053010_070",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "怎、",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "怎麼了？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "笑得那麼開心……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n你說能成為莫妮卡的搭檔",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "很高興……？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "咦！？",
    "voice": "vo_adv_1053010_071",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "不，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "其實我也……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n…………",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "老、",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "老實說其實我也",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "很高興喔！？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我從一開始就一直",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "想著如果和閣下搭檔就好了！！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……可是",
    "voice": "vo_adv_1053010_072",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "閣下人很善良，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "如果我開口邀請，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "你就不會拒絕我對吧？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "因此",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我就不由得……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "對邀約一事猶豫不決了……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "但是",
    "voice": "vo_adv_1053010_073",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "{0}，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n對我說了「能成為莫妮卡的搭檔很高興」。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……對這個沒被任何人選擇的我，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "說了這句話。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "託你的福，我下定了決心！",
    "voice": "vo_adv_1053010_074",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n就如同你為了我參與作戰一樣，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n我發誓直到最後我也不會放棄，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "會全力以赴去戰鬥！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "好！",
    "voice": "vo_adv_1053010_075",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這份信賴，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我確確實實地收到了！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "首先去報名大賽吧，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n然後……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "直到正式比賽前的幾天，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "都要猛烈特訓。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "最應該要戒備的對手",
    "voice": "vo_adv_1053010_076",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "是那對兄弟，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n對方",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "能夠輕而易舉使出一擊",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "破壞掉牆壁，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "不曉得他們動真格攻擊過來時，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我們能否防禦得了……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "所以，",
    "voice": "vo_adv_1053010_077",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我打算學習新的招數。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n那是祖國流傳至今的奧義。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "很抱歉，",
    "voice": "vo_adv_1053010_078",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我還想聽聽閣下給予的意見，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "你願意",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "陪我練習嗎？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}欣然答應莫妮卡的請求。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n他們以冠軍為目標，展開新的特訓。",
    "voice": null,
    "unit_id": null
  }
]
