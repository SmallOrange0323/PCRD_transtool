[
  {
    "type": "background",
    "bg_id": "500170"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "自長高特訓以來數個月後──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n終於來到大賽受理報名當日……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}幫莫妮卡量了最後一次的身高。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "閣下，",
    "voice": "vo_adv_1053010_000",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "怎麼樣……？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "唔嗚嗚……！",
    "voice": "vo_adv_1053010_001",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "如果量100次都一樣，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "就不是一場夢也不是自己多心了！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我這次終於能參加大賽了……！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "一路走到這裡",
    "voice": "vo_adv_1053010_002",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "真是崎嶇坎坷啊。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n不過",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "多虧有閣下的支持",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "不，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "抱歉，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我真是急性子！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我實在太高興了，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "一不小心就……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我真正的目的，",
    "voice": "vo_adv_1053010_003",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "是在決鬥大賽中奪得冠軍。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "既然知道可以參賽，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "就得馬上前往賽場才行……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……嗯？",
    "voice": "vo_adv_1053010_004",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我是不介意啦……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "今天只是申請參賽，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "還沒有要進行比賽喔？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……你想看我",
    "voice": "vo_adv_1053010_005",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "報名成功的那個瞬間？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "閣下人真的很善良呢。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "那麼",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "你就盡情地看到最後吧。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "要參加大賽的人",
    "voice": "vo_adv_1053010_006",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "請到這邊排隊！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "\\n我們將依照順序受理報名！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "啊啊，",
    "voice": "vo_adv_1053010_007",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "怎麼不快點輪到我呢。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n期待測量身高到這種程度，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "是我有生以來第一次啊♪",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "不過話說回來，",
    "voice": "vo_adv_1053010_008",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "參賽者人數真多啊……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "更確切來說，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "好像都和我一樣",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "身邊帶著同伴……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "那麼，",
    "voice": "vo_adv_1053010_009",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "麻煩下一位！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "哎呀，",
    "voice": "vo_adv_1053010_010",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "輪到我出場了。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "給我盡量測量吧！！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "……雖然差距僅小，",
    "voice": "vo_adv_1053010_011",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "但確實",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "滿足了參賽條件。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "\\n我們受理妳的報名。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "閣下，",
    "voice": "vo_adv_1053010_012",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "你聽見了嗎！？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "好……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "剩下的目標只要取勝就──",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "那麼接下來……",
    "voice": "vo_adv_1053010_013",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "莫妮卡小姐的組隊搭檔，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "\\n是要登記旁邊這位先生嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我有同樣疑問，",
    "voice": "vo_adv_1053010_014",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "到底是什麼意思啊！？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這是決鬥大賽對吧！？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n不是一對一",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "的正式對決嗎！？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "其實參賽規則有重新修正，",
    "voice": "vo_adv_1053010_015",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "\\n今年起更改為兩人一組共鬥",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "的「武鬥大賽」了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "規則修訂的公告，",
    "voice": "vo_adv_1053010_016",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "\\n有透過公佈欄、傳單發送，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "以及通訊魔法來傳達給大眾……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "本大賽畢竟是例行賽事，",
    "voice": "vo_adv_1053010_017",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "\\n新規則也才剛發表不久……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "\\n所以也有很多人",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "是在這裡才聽到說明，初次知道詳情的。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "是、",
    "voice": "vo_adv_1053010_018",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "是這樣子啊……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "因為我們有段時間每天都在森林裡特訓……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這是我的失誤。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n不過，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "為什麼要改規則……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "本大賽過去",
    "voice": "vo_adv_1053010_019",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "是一直交由貴族議會在營運的，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "\\n但現在決定要全權委託給公會管理協會負責。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "營運權轉交時，",
    "voice": "vo_adv_1053010_020",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "規則也一同更改了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "\\n獨自一人勝出的力量雖然也很重要，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "\\n但是現在",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "普遍需要的，是與他人相互配合的能力……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "事情就是這樣。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "是、",
    "voice": "vo_adv_1053010_021",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "是嗎……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "既然規則是如此，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "那我也會遵守。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "可是……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "搭檔啊……",
    "voice": "vo_adv_1053010_022",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "如果是{0}，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我是能夠把背後託付給他。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "但就算如此，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "也不能夠讓他再繼續遷就我的任性了……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "若沒有決定好的對象，",
    "voice": "vo_adv_1053010_023",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "請到裡面的空地處去看一看吧。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "\\n我想會有許多在找組隊搭檔的人。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我知道了！",
