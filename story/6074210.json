[
  {
    "type": "background",
    "bg_id": "500036"
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "アキノさんがあたしのことを",
    "voice": "vo_adv_6054210_000",
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "\\n『ライバルで大親友』",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "って言ってくれるの、",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "すごくうれしいわ。",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "\\n……だから",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "もっと努力して、",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "追いつきたいの。",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "ありがとう。",
    "voice": "vo_adv_6054210_001",
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "でもね、",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "最初",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "『ライバル』って言われた時、",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "\\n『アキノさんはあたしを過大評価している』って",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "慌てちゃったのよ。",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "\\n",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "でも今は",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "実力とか関係なく、",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "ただ『そうなりたい』って思ってるわ。",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "うん。",
    "voice": "vo_adv_6054210_002",
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "でも、",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "まだまだ足りないかな。",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "\\nアキノさんに勝負を挑まれたら、",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "『負けたくない』って思うから、",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "\\nあたしはもっと上を目指すわ。",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "アキノさんを追い越すぐらいにね！",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "あたしもそう思うわ。",
    "voice": "vo_adv_6054210_003",
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "それで、",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "感謝もしてる。",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "\\n",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "でもそれを伝えるのは、",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "あたしが実業家として成功した時よ。",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "\\n",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "……この話は、",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "内緒にしててね。",
    "voice": null,
    "unit_id": 114511
  }
]
