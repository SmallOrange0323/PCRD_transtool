[
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "えへへ、",
    "voice": "vo_adv_5048601_000",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "ラフィちゃん私たちのこと、",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "ちゃんと覚えててくれたんだね！",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "\\nうれしいなぁ♪",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "それに",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "平均点超えだって！　",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "ラフィちゃんすごいね！",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "そうね、",
    "voice": "vo_adv_5048601_001",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "ちゃんと頑張ってるみたいで",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "安心したわ。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "私とお姉ちゃんが入れ替わってたんだもんね。",
    "voice": "vo_adv_5048601_002",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "今思うと",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "すごく不思議な感じだよ。",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "しかも",
    "voice": "vo_adv_5048601_003",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "私たちだけじゃなくて",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "街中の人たちまで巻き込んで……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "ホント、",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "よく解決できたわよね。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "でも、",
    "voice": "vo_adv_5048601_004",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "そんなラフィちゃんのおかげで、",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "\\n私たちはハッピーになれたんだよ。",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "ええ、",
    "voice": "vo_adv_5048601_005",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "間違いなく",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "ラフィはハッピーエンジェルだったわね。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "それにしてもあの子、",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "『エンジェルがんばってるですか？』って……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "もう、",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "ちゃんと約束したわけでもないのに。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "ラフィちゃんには分かってたんだよ。",
    "voice": "vo_adv_5048601_006",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "お姉ちゃんなら絶対にエンジェルをやってくれるって。",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "それに",
    "voice": "vo_adv_5048601_007",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "私も結構エンジェルの活動気に入ってるんだ。",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "ラフィちゃんみたいな力はなくても、",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "心はちゃんとエンジェルだよ！",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "……そうね。",
    "voice": "vo_adv_5048601_008",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "あの子と再会したときに",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "\\n恥ずかしいところを見せないように、",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "私も頑張らないとね。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "うんうん！　",
    "voice": "vo_adv_5048601_009",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "それじゃあ",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "ラフィちゃんが送ってくれたキャンディ、",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "\\n一緒に食べようよ？",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "……待ってアカリ！",
    "voice": "vo_adv_5048601_010",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "\\n思い出した、",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "これって『大天使の泪』だわ！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "『大天使の泪』……？",
    "voice": "vo_adv_5048601_011",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "前に",
    "voice": "vo_adv_5048601_012",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "イリヤさんの魔力を取り戻すアイテムを探してたときに、",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "\\n本で見たことがあるの。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "ものすごい高額で取引されてる",
    "voice": "vo_adv_5048601_013",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "幻のアイテム……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "こんな貴重なものをあっさり送ってきちゃうなんて……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "\\nやっぱりあの子、",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "本当のエンジェルだったのね。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "うーん、",
    "voice": "vo_adv_5048601_014",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "そんな貴重なものだと",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "さすがに食べづらいよね。",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "どうしようお姉ちゃん、",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "売れば私たちお金持ちになれるよ？",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "……ううん、",
    "voice": "vo_adv_5048601_015",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "これはとっておきましょ。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "\\nラフィの成長の証みたいなものだもん、",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "大事にしたいじゃない。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "お姉ちゃんならそう言うと思ったよ。",
    "voice": "vo_adv_5048601_016",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "それじゃあ",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "キャンディの代わりに、",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "何か甘いもの食べに行こう♪",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "\\n私たちから",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "ラフィちゃんへのお祝いだよ。",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "全く、",
    "voice": "vo_adv_5048601_017",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "アカリってば調子がいいんだから。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "でも、",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "今日くらいはいいわよね。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "私たちのハッピー、",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "ラフィに届くといいわね。",
    "voice": null,
    "unit_id": 102211
  }
]
