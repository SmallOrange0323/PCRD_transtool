    "voice": "vo_adv_1213004_017",
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我雖然有上過舞台，",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n但還是第一次",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "坐上觀眾席。",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "舞台上",
    "voice": "vo_adv_1213004_018",
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "看起來原來是這樣子的……",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "比從舞台上往下看",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "還高了不少。",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "而且",
    "voice": "vo_adv_1213004_019",
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "有點刺眼……",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "咦……！？　",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "background",
    "bg_id": "510300"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "胡桃參加了市區的市民中心",
