    "type": "dialogue",
    "name": "胡桃",
    "words": "我們也",
    "voice": "vo_adv_1213004_014",
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "稍微休息一下好了。",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "呃，",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n哥哥？",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "妳在看哪……",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "background",
    "bg_id": "501510"
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "啊！",
    "voice": "vo_adv_1213004_015",
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
