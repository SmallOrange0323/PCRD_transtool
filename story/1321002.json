    "name": "漁夫2",
    "words": "妳想釣起死神嗎！？",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "雷姆學了船釣的基礎了。",
    "voice": "vo_adv_1321002_066",
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "而且……",
    "voice": null,
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "要是能在這裡學會釣大魚的訣竅的話，",
    "voice": null,
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n就能親自教昂了。",
    "voice": null,
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "還能防止船被襲擊，",
    "voice": "vo_adv_1321002_067",
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "是一石二鳥呢！",
    "voice": null,
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "昂是誰啦！",
    "voice": "vo_adv_1321002_068",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "那不是能當獵物的對象啊！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "\\n那樣只會被拖下去而已！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "別那麼做啊！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "來吧，",
    "voice": "vo_adv_1321002_069",
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "這裡有很好吃的魚餌喔。",
    "voice": null,
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "過來吧──！",
    "voice": null,
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "不要引誘牠過來啊啊啊啊！！！！",
    "voice": "vo_adv_1321002_070",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "上鉤了！",
    "voice": "vo_adv_1321002_071",
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "漁夫１、漁夫２",
    "words": "什麼啊啊啊！？",
    "voice": "vo_adv_1321002_072",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "忠於基礎，",
    "voice": "vo_adv_1321002_073",
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "配合釣竿……",
    "voice": null,
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "捲起線！",
    "voice": null,
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "喝啊啊啊啊啊啊！",
    "voice": "vo_adv_1321002_074",
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "漁夫１、漁夫２",
    "words": "怎麼可能────！！",
    "voice": "vo_adv_1321002_075",
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500160"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "哎呀，沒想到",
    "voice": "vo_adv_1321002_076",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "妳真的",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "能釣起「藍色的死神」啊……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "託小姑娘的福，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "所有漁夫都撿回了一條命了啊！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "小姑娘妳技術很厲害啊……",
    "voice": "vo_adv_1321002_077",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "不，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "已經不是小姑娘了，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "是傳奇漁夫啊！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "我說傳奇漁夫，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "妳要不要來我船上工作！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "能被這樣稱讚，",
    "voice": "vo_adv_1321002_078",
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "雷姆感到很光榮。",
    "voice": null,
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "但是，",
    "voice": null,
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "雷姆有女僕這個工作要做。",
    "voice": null,
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "女僕！？",
    "voice": "vo_adv_1321002_079",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "\\n妳",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "那樣的身手，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "在女僕工作上有辦法充分發揮嗎！？",
