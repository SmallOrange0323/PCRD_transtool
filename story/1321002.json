    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "當然可以，",
    "voice": "vo_adv_1321002_080",
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "跟船釣一樣，",
    "voice": null,
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "女僕是很深奧的。",
    "voice": null,
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "而且",
    "voice": null,
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "雷姆還不夠成熟。",
    "voice": null,
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "作為範本，雷姆每天都在追逐著姊姊的背影。",
    "voice": null,
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "原來女僕是個",
    "voice": "vo_adv_1321002_081",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "很辛苦的工作啊……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "那不然下次，",
    "voice": "vo_adv_1321002_082",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "\\n妳一定要跟那個「昂」",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "一起來釣魚喔。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
