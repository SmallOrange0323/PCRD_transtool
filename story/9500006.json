    "words": "\\n",
    "voice": null,
    "unit_id": 100241
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……你真的",
    "voice": null,
    "unit_id": 100241
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "願意選我嗎？",
    "voice": null,
    "unit_id": 100241
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……！",
    "voice": "vo_adv_9500006_001",
    "unit_id": 100241
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100241
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "嗯……",
    "voice": null,
    "unit_id": 100241
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我也是",
    "voice": null,
    "unit_id": 100241
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "同樣的心情……！",
    "voice": null,
    "unit_id": 100241
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "無論是拯救世界，",
    "voice": "vo_adv_9500006_002",
    "unit_id": 100241
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "還是今後一起度過──",
    "voice": null,
    "unit_id": 100241
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100241
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我都希望",
    "voice": null,
    "unit_id": 100241
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "那個人是你……！",
    "voice": null,
    "unit_id": 100241
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我",
    "voice": "vo_adv_9500006_003",
    "unit_id": 100241
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "真的可以這麼幸福嗎？",
    "voice": null,
    "unit_id": 100241
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100241
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "太過幸福，",
    "voice": null,
    "unit_id": 100241
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "反而感到不安了……",
    "voice": null,
    "unit_id": 100241
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "………",
    "voice": "vo_adv_9500006_004",
    "unit_id": 100241
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100241
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "欸嘿嘿，",
    "voice": null,
    "unit_id": 100241
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "謝謝你，騎士先生。",
    "voice": null,
    "unit_id": 100241
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我果然還是──",
    "voice": "vo_adv_9500006_005",
    "unit_id": 100241
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "喜歡騎士先生。",
    "voice": null,
    "unit_id": 100241
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "雖然發生了很多事，",
    "voice": "vo_adv_9500006_006",
    "unit_id": 100241
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "沒有放棄真是太好了。",
    "voice": null,
    "unit_id": 100241
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100241
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "不管發生什麼，",
    "voice": null,
    "unit_id": 100241
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我都喜歡你。",
    "voice": null,
    "unit_id": 100241
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "所以我不再迷惘了。",
    "voice": "vo_adv_9500006_007",
    "unit_id": 100241
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n也不會再逃避自己的心情……！",
    "voice": null,
    "unit_id": 100241
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "嗯！",
    "voice": "vo_adv_9500006_008",
    "unit_id": 100241
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100241
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "那個，騎士先生。",
    "voice": null,
    "unit_id": 100241
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "至今為止，從今以後──",
    "voice": "vo_adv_9500006_009",
    "unit_id": 100241
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100241
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我都一直",
    "voice": null,
    "unit_id": 100241
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "最喜歡你了！",
    "voice": null,
    "unit_id": 100241
  }
]
