    "words": "喂",
    "voice": null,
    "unit_id": 130041
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "喂。",
    "voice": null,
    "unit_id": 130041
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n你是喝醉了嗎？小子。",
    "voice": null,
    "unit_id": 130041
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n不是若菜或布武機，",
    "voice": null,
    "unit_id": 130041
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "而是我？",
    "voice": null,
    "unit_id": 130041
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "我已經告訴過你我沒那個意思了，",
    "voice": "vo_adv_9500071_002",
    "unit_id": 130041
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n也應該和你結為姐弟了才對。",
    "voice": null,
    "unit_id": 130041
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n就算是那樣，你",
    "voice": null,
    "unit_id": 130041
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "還是說要選擇我嗎？",
    "voice": null,
    "unit_id": 130041
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "……",
    "voice": "vo_adv_9500071_003",
    "unit_id": 130041
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "那個眼神……",
    "voice": null,
    "unit_id": 130041
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "是認真的呢。",
    "voice": null,
    "unit_id": 130041
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130041
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "……唉。",
    "voice": null,
    "unit_id": 130041
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "我可壓根沒想過，",
    "voice": null,
    "unit_id": 130041
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n一個我打算當成義弟的男人，",
    "voice": null,
    "unit_id": 130041
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "竟然會想要我。",
    "voice": null,
    "unit_id": 130041
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "不過，",
    "voice": "vo_adv_9500071_004",
    "unit_id": 130041
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "既然你都渴求到這種地步了，",
    "voice": null,
    "unit_id": 130041
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n若不回應你，豈不就太枉為女人了嗎。",
    "voice": null,
    "unit_id": 130041
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130041
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "……雖然對若菜和布武機很抱歉就是了。",
    "voice": null,
    "unit_id": 130041
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "──",
    "voice": "vo_adv_9500071_005",
    "unit_id": 130041
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "好，",
    "voice": null,
    "unit_id": 130041
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "我下定決心了喔！",
    "voice": null,
    "unit_id": 130041
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n你和我，",
    "voice": null,
    "unit_id": 130041
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "就把彼此的人生全都押上去吧。",
    "voice": null,
    "unit_id": 130041
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130041
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "都說要賭上人生了，",
    "voice": null,
    "unit_id": 130041
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "想必會是相當有趣的賭局吧。",
    "voice": null,
    "unit_id": 130041
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "就算你中途嚷嚷著要退出，我也不會容許喔。",
    "voice": "vo_adv_9500071_006",
    "unit_id": 130041
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130041
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "做好覺悟了吧，",
    "voice": null,
    "unit_id": 130041
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "小子？",
    "voice": null,
    "unit_id": 130041
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "回答得好♪",
    "voice": "vo_adv_9500071_007",
    "unit_id": 130041
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130041
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "啊啊，還有──",
    "voice": null,
    "unit_id": 130041
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "其他女人姑且不論，",
    "voice": null,
    "unit_id": 130041
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n你可得好好照顧",
    "voice": null,
    "unit_id": 130041
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "若菜和布武機喔。",
    "voice": null,
    "unit_id": 130041
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "好，",
    "voice": "vo_adv_9500071_008",
    "unit_id": 130041
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "這下你從現在起就是我們家的一員了。",
    "voice": null,
    "unit_id": 130041
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n那麼，就先從──",
    "voice": null,
    "unit_id": 130041
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "把整個LoA",
    "voice": null,
    "unit_id": 130041
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n都給我們搶過來開始吧！",
    "voice": null,
    "unit_id": 130041
  }
]
