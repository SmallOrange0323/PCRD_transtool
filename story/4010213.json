[
  {
    "type": "background",
    "bg_id": "509015"
  },
  {
    "type": "background",
    "bg_id": "510320"
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "辛苦了，",
    "voice": "vo_adv_4010213_000",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "少年。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n今天真不好意思，讓你臨時扮演怪人角色。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "先不提台詞，",
    "voice": "vo_adv_4010213_001",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n你飾演被擊敗的角色時的反應真的非常好。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n讓我也能爽快的扮演英雄。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "作為接受我任性請求的回禮。",
    "voice": "vo_adv_4010213_002",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n如何，",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這之後要不要辦個慶功宴？",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n當然由我來請客。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯？",
    "voice": "vo_adv_4010213_003",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "啊啊，",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "難道說你記得嗎。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n沒錯，",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "今天是我的生日。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n……不過，",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "辦生日派對也不太像我的風格。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "唔……",
    "voice": "vo_adv_4010213_004",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這樣啊？",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n你說想辦的話，",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我也沒有理由拒絕。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n派對啊……",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "聽起來很令人期待呢。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……咦？",
    "voice": "vo_adv_4010213_005",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你要去買蛋糕跟禮物？",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n等一下少年，",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你不用做到那種程度──",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "啊啊，",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "走掉了。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "哎呀，",
    "voice": "vo_adv_4010213_006",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "真是個有趣的孩子呢。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "background",
    "bg_id": "510124"
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "啊啊，",
    "voice": "vo_adv_4010213_007",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "謝謝你。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n這蛋糕……",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "連蠟燭都有準備嗎。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n呵呵。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "好久沒有吹熄蛋糕的蠟燭了……",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "啊。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……嗯，",
    "voice": "vo_adv_4010213_008",
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "好吧。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n反正派對的參加者",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "只有我和少年而已。",
    "voice": null,
    "unit_id": 104732
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "──呼。",
    "voice": "vo_adv_4010213_009",
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯……",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "少年，",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不要盯著我的臉看。",
    "voice": null,
    "unit_id": 104733
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n……我會害羞的。",
    "voice": null,
    "unit_id": 104733
  }
]
