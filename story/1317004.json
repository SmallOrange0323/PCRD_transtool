[
  {
    "type": "background",
    "bg_id": "501030"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "愛梅斯和{0}在夢中被賦予了各式各樣的任務。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n但兩人無視了那些，在海邊悠閒地度過。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "呼～",
    "voice": "vo_adv_1317004_000",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "……差不多是她進行下一個行動的時候了吧。",
    "voice": "vo_adv_1317004_001",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "涅比亞最討厭被無視了，",
    "voice": "vo_adv_1317004_002",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "像這樣對她置之不理，她會受不了",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "的吧。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "看吧，",
    "voice": "vo_adv_1317004_003",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "果然。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "background",
    "bg_id": "510300"
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "這次是什麼啦？",
    "voice": "vo_adv_1317004_004",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n……啊？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "咖啡廳和",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "高樓大廈……？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "這裡",
    "voice": "vo_adv_1317004_005",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "不就是「那邊的世界」嗎！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "涅比亞那傢伙，",
    "voice": "vo_adv_1317004_006",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "是出於什麼打算才做這種……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "怎樣啦？",
    "voice": "vo_adv_1317004_007",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "一直盯著這邊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n我有點難為情耶。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "我有什麼──",
    "voice": "vo_adv_1317004_008",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "──咦？",
    "voice": "vo_adv_1317004_009",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "這是怎樣！",
    "voice": "vo_adv_1317004_010",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n誒，",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "原本的",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "我……！？",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "涅比亞",
    "voice": "vo_adv_1317004_011",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "那傢伙～～～～～！",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "給我擅自亂用我的模型資料，",
    "voice": "vo_adv_1317004_012",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n就算是在假想空間裡也惡作劇過頭了啦，",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "真是的……！",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "……對，",
    "voice": "vo_adv_1317004_013",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "沒錯喔，",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n這就是原本的我。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "「你終於醒來了！",
    "voice": "vo_adv_1317004_014",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "我是妖精菲歐。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "我會告訴你阿斯特朗的各種事的，",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "要仔細聽喔！」",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "……開玩笑的",
    "voice": "vo_adv_1317004_015",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "啦。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "不過話說回來……",
    "voice": "vo_adv_1317004_016",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "好強烈的違和感啊，",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n我竟然會在這個世界裡。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "這是絕對……",
    "voice": "vo_adv_1317004_017",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "不可能的光景呢。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "那是當然啊，",
    "voice": "vo_adv_1317004_018",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "因為",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "「那邊的世界」裡並沒有我的存在。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n我",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "只能存在於資料中。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "啊啊，",
    "voice": "vo_adv_1317004_019",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "如果像晶和小可可蘿所做的，",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n進到義體之中的話，",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "好像就有可能呢？",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "不過，",
    "voice": "vo_adv_1317004_020",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "做那種事是沒有意義的。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n因為我是嚮導小妖精，",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n是為了介紹阿斯特朗而存在的。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "……不過，",
    "voice": "vo_adv_1317004_021",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "機會難得，稍微走一下吧。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n因為我在飛，",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "所以會動到腳的只有你就是了♪",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "嗯～",
    "voice": "vo_adv_1317004_022",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n就我稍微四處看一下的感覺，",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "沒有半個人在。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "而且，",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "似乎有很多限制呢。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "你看，",
    "voice": "vo_adv_1317004_023",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "有像是看不見的牆壁一樣的東西吧？",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n是沒辦法隨意繞路的",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "刻意設計。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "總之，",
    "voice": "vo_adv_1317004_024",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "只朝著可以前進的方向前進吧。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "要緊跟著我喔♪",
    "voice": "vo_adv_1317004_025",
    "unit_id": 134011
  },
  {
    "type": "background",
    "bg_id": "510350"
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "好了……",
    "voice": "vo_adv_1317004_026",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "可以正常地來到車站呢。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "也就是說，大概……",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "啊啊，果然。",
    "voice": "vo_adv_1317004_027",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n正好有電車停靠。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "是要我們搭這個吧。",
    "voice": "vo_adv_1317004_028",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "電車啊……",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "其實我有點想搭搭看呢。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "啊！",
    "voice": "vo_adv_1317004_029",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "有在賣車站便當嗎？",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n搭電車的時候果然要買車站便當吧？",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "啊啊，",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "沒人的話就沒辦法買啊，",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "真可惜。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "那麼，",
    "voice": "vo_adv_1317004_030",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "重振精神，出發前進♪",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "background",
    "bg_id": "510250"
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "──來到海邊了呢。",
    "voice": "vo_adv_1317004_031",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "是要我們在這邊做什麼嗎？",
    "voice": "vo_adv_1317004_032",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "……嗯？",
    "voice": "vo_adv_1317004_033",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n那邊，",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "沙灘裡埋著什麼？",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "這是……",
    "voice": "vo_adv_1317004_034",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "寶箱？",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n這裡是終點",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "的意思嗎？",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "都耍我們到這種地步了，",
    "voice": "vo_adv_1317004_035",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n要是裡面沒有裝相應的東西，我可不會原諒她喔。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "{0}，打開吧。",
    "voice": "vo_adv_1317004_036",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "妖精的……",
    "voice": "vo_adv_1317004_037",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "泳裝？",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "該不會",
    "voice": "vo_adv_1317004_038",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "是要我穿這個吧！？",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
