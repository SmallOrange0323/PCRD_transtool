    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "那傢伙！",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n真是的！",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "別開玩笑了～～～！",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "好的，",
    "voice": "vo_adv_1317004_071",
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "辛苦了～♪",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "你剛才看到的是像夢境般的東西喔，",
    "voice": "vo_adv_1317004_072",
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "啊，",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "這句話最近好像不太說了？",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "比起那個，如何？",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "我的夏日計畫",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "很有趣吧？",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n我涅比亞大人",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "作為嚮導小妖精，演出令人愉快的海邊約會──",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "──喝！",
    "voice": "vo_adv_1317004_073",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "好痛！？",
    "voice": "vo_adv_1317004_074",
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "妳突然幹嘛啦，菲歐！？",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "妳可真是幹得好呢，",
    "voice": "vo_adv_1317004_075",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n擅自用系統做出品質很差的假想空間！",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "妳是出於什麼理由做這種事，我已經無所謂了。",
    "voice": "vo_adv_1317004_076",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n我就讓妳見識一下",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "靜流親自傳授的姐姐手刀……！",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "妳已經讓我見識完了吧！",
    "voice": "vo_adv_1317004_077",
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n至少聽一下理由也好吧！？",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "……說說看吧。",
    "voice": "vo_adv_1317004_078",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "老實說，",
    "voice": "vo_adv_1317004_079",
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "因為感覺很有趣♪",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "姐姐手刀！",
    "voice": "vo_adv_1317004_080",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "呀啊！",
    "voice": "vo_adv_1317004_081",
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "痛痛痛～",
    "voice": "vo_adv_1317004_082",
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "呵、",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "呵呵……！",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "什、",
    "voice": "vo_adv_1317004_083",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "什麼啦……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "突然笑出來。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n我打得太大力了嗎……？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "不……",
    "voice": "vo_adv_1317004_084",
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "我是在想，妳變得像菲歐了",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "呢～",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "！",
    "voice": "vo_adv_1317004_085",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "妳有做一個好夢嗎？",
    "voice": "vo_adv_1317004_086",
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "姐姐。",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "算是……",
    "voice": "vo_adv_1317004_087",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "還不錯。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "呵呵♪",
    "voice": "vo_adv_1317004_088",
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n可要好好感謝我喔？",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n能受到我的引導♪",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "雖然如此，我還是不原諒妳。",
    "voice": "vo_adv_1317004_089",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "咦。",
    "voice": "vo_adv_1317004_090",
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n為、",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "為什麼？",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "我感覺到很強烈的怒氣耶……",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "\\n擅自操作系統",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "有那麼糟嗎？",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那部分就算了，",
    "voice": "vo_adv_1317004_091",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我不能原諒的是，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "妳作為嚮導小妖精不會看時機到失職的程度！",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "那是怎樣！？",
    "voice": "vo_adv_1317004_092",
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "目送完這傢伙，我再繼續說。",
    "voice": "vo_adv_1317004_093",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "涅比亞，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "妳明白吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "嗚嗚，",
    "voice": "vo_adv_1317004_094",
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "涅比亞",
    "words": "我知道了啦～",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "嚮導小妖精們",
    "words": "那麼，",
    "voice": "vo_adv_1317004_095",
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "嚮導小妖精們",
    "words": "掰掰♪",
    "voice": null,
    "unit_id": 190911
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "被兩名嚮導小妖精目送後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}轉而甦醒。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n他不忘與妖精們共度夏天的回憶，將其深藏於心──",
    "voice": null,
    "unit_id": null
  }
]
