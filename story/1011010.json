    "name": "璃乃",
    "words": "哥哥，",
    "voice": "vo_adv_1011010_016",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "請你先忍耐。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n現在要是亂動就會被發現的……",
    "voice": null,
    "unit_id": 101112
  },
  {
