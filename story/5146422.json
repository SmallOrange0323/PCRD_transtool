[
  {
    "type": "background",
    "bg_id": "502283"
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "呼……",
    "voice": "vo_adv_5146422_000",
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "總算是打贏了呢。",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n這樣遊行應該就能繼續下去了……",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "……員工先生。",
    "voice": "vo_adv_5146422_001",
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "\\n沒想到事情會變成這樣，",
    "voice": null,
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "我真的真的感到很遺憾……",
    "voice": null,
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "\\n",
    "voice": null,
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "但是和你一起工作的那些時光，",
    "voice": null,
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "我覺得非常開心。",
    "voice": null,
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "如果你有一天洗心革面，",
    "voice": "vo_adv_5146422_002",
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "想要露出笑容的話。",
    "voice": null,
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "\\n",
    "voice": null,
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "到時還請你務必務必",
    "voice": null,
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "以客人的身分來玩喔……！",
    "voice": null,
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "到時候我們會以笑容來迎接你的！",
    "voice": "vo_adv_5146422_003",
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "\\n由我和真步小小姐兩個人一起！",
    "voice": null,
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "嗯。",
    "voice": "vo_adv_5146422_004",
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n到時候，",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "咱們會一起在門口",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "出聲迎接你。",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "庫露露、真步",
    "words": "歡迎你，",
    "voice": "vo_adv_5146422_005",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "庫露露、真步",
    "words": "\\n來到「大夢想樂園」……",
    "voice": null,
    "unit_id": null
  }
]
