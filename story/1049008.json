  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "咦？",
    "voice": "vo_adv_1049008_031",
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "沒這回事？",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n你需要",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我？",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "說的也是。",
    "voice": "vo_adv_1049008_032",
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n{0}真坦率！",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我們要",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "永遠在一起喔。",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "嘿嘿♪",
