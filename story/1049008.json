    "voice": "vo_adv_1049008_027",
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "姐姐本來\\n想叫醒你的呢～？",
