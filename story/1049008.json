    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "但也有些寂寞。",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n就算姐姐不在身邊，",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n{0}還是活得很獨立自主……",
    "voice": null,
    "unit_id": 104932
  },
  {
    "type": "dialogue",
