[
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "等等……",
    "voice": "vo_adv_5038321_000",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "那是怎麼回事啊！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n好像墨丘利的極限角色扮演的謎之團體",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n墨丘地登場了耶！？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "那個叫做……",
    "voice": "vo_adv_5038321_001",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "「好朋友全像投影」！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這功能可以用外觀、性格、行為模式……等",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "事先儲存的資訊為參考，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n製作出和目標幾乎一模一樣的影子！！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "看來這並不是鏡像立體投影",
    "voice": "vo_adv_5038321_002",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這麼簡單的東西。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "喔～竟然",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "連質量都能複製，真有意思。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n簡直就像是複製人啊。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "喔～真的，",
    "voice": "vo_adv_5038321_003",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "連細節都好像。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n喝著麥酒，吃著鯛魚燒，數著錢，高聲地笑著。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "全體的獨特風格都完全模仿了。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "等一下？",
    "voice": "vo_adv_5038321_004",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我喝酒的方式可沒那麼誇張喔！？",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "魔法的酒杯裡像間歇泉一樣不斷湧出金黃色的液體。",
    "voice": "vo_adv_5038321_005",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n大口大口地把那奔騰的酒水",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "一滴也不漏地喝光，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這已經可以說是街頭藝人等級了呢。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "講白一點，真的很誇張。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "那個連琪愛兒都無法接受。",
    "voice": "vo_adv_5038321_006",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "不～是～的～！",
    "voice": "vo_adv_5038321_007",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "美冬！　",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "那種滿是虛假的影子，",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "趕快把它打倒吧！",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "嗯，是啊。",
    "voice": "vo_adv_5038321_008",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "本人比這個更誇張說……！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "美冬！？",
    "voice": "vo_adv_5038321_009",
    "unit_id": 103411
  }
]
