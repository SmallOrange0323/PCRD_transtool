  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}等人成功奪回亞瑟。\\n並為了奪回其他玩偶們，開始展開了行動。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "從現在起",
    "voice": "vo_adv_5021004_000",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "兵分兩路行動，",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "大家準備好了嗎？",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "當然",
    "voice": "vo_adv_5021004_001",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "沒問題～！",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "是啊。",
    "voice": "vo_adv_5021004_002",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "既然知道解決方法了，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n要應付那麼多對手，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "分頭行動是最有效率的。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生。",
    "voice": "vo_adv_5021004_003",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "真琴就",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "拜託您照顧囉？",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "嗯，",
    "voice": "vo_adv_5021004_004",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生真是可靠呢。",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "不不不，",
    "voice": "vo_adv_5021004_005",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "怎麼想都是我保護他吧？",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "雖然",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我知道這傢伙",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "有時候真的很可靠啦……",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "你、",
    "voice": "vo_adv_5021004_006",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "你說什麼啊！？",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "那種話說給優衣聽啦！？",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "真琴，",
    "voice": "vo_adv_5021004_007",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "妳的臉好紅呀～♪",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "那麼，",
    "voice": "vo_adv_5021004_008",
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "我們等等見。",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "太陽下山前，",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "我們約在海灘那裡集合吧？",
    "voice": null,
    "unit_id": 110611
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "你們兩個，",
    "voice": "vo_adv_5021004_009",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "記得不要到處閒晃呀～♪",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "妳們才要令人擔心呢！",
    "voice": "vo_adv_5021004_010",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "真是的。",
    "voice": "vo_adv_5021004_011",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "好了，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我們走吧。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n我們負責找漁村裡面，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "還有停泊漁船的碼頭。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "嗯～",
    "voice": "vo_adv_5021004_012",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "看起來",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "一切正常呢。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "你那邊怎麼樣？",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "看樣子",
    "voice": "vo_adv_5021004_013",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "你那邊也是一樣啊。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "沒辦法。",
    "voice": "vo_adv_5021004_014",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "沒頭沒腦找下去只是浪費體力，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n稍微等等看吧。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "嗯？　",
    "voice": "vo_adv_5021004_015",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "怎麼了，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "坐下來啊。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "幹嘛那麼緊張啊？",
    "voice": "vo_adv_5021004_016",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "沒事的。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "不管什麼東西出現，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我都會保護你啦♪",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "哎呀哎呀，",
    "voice": "vo_adv_5021004_017",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "居然有情侶來這種地方呀？",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "情…！？",
    "voice": "vo_adv_5021004_018",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "才、才不是那樣，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "突然間是誰冒出來啊！？",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "沒事兒。",
    "voice": "vo_adv_5021004_019",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "咱剛才看到你們倆生面孔年輕伙子。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n還以為你們要對漁船做啥壞事才來瞧瞧呀。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "啊，",
    "voice": "vo_adv_5021004_020",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "原來是這樣。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "抱歉讓妳會錯意啦，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "老婆婆。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "那的確是很可疑。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "不過這是誤會。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我們是【哞哞自衛隊】……",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "咱知咱知。",
    "voice": "vo_adv_5021004_021",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "咱就不打擾你們年輕小倆口親熱啦。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "就―說―了，這一切都是誤會啊！？",
    "voice": "vo_adv_5021004_022",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "{0}，你也幫忙說幾句話澄清啊！",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "哦、",
    "voice": "vo_adv_5021004_023",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "哦……",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "也不需要裝作不認識我啦。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "幹嘛把誤會加深啦！？",
    "voice": "vo_adv_5021004_024",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "那種事……",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "哎，算了！",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "呵呵呵。",
    "voice": "vo_adv_5021004_025",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "咱說笑的呀。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "不過，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "你們可得小心呀。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "這附近有奄美魔物出沒呀。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "喔，",
    "voice": "vo_adv_5021004_026",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "老婆婆也知道。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "用不著擔心，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我們就是為了尋找那個奄美魔物才到這裡來的。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "喔。",
    "voice": "vo_adv_5021004_027",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n試膽嗎，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "但看上去也不像是呀。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "吶老婆婆，",
    "voice": "vo_adv_5021004_028",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "妳知道就告訴我們吧，",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "奄美魔物究竟是什麼東西？",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "咱也沒親眼見過，",
    "voice": "vo_adv_5021004_029",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n只能說村里相傳的事呀……",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "那也行。",
    "voice": "vo_adv_5021004_030",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我們得多收集點情報。",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "奄美魔物是",
    "voice": "vo_adv_5021004_031",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "形容那些惡靈、",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "駭人生物、",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "可怕生物的詞彙。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n傳聞它們有著千奇百怪的模樣。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "跟香織說的一樣。",
    "voice": "vo_adv_5021004_032",
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "那",
    "voice": null,
    "unit_id": 110411
  },
  {
    "type": "dialogue",
    "name": "真琴",
