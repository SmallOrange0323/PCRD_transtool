  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}在大江戶町內散步，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n看見雪正被人群團團圍住。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "等一下啦～",
    "voice": "vo_adv_1176001_000",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這樣我很困擾耶～",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "啊！{0}！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你來得正好！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "發生大事了啦～",
    "voice": "vo_adv_1176001_001",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "就算我再怎麼美，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "也受不了大家這樣蜂擁而上～",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "喂，",
    "voice": "vo_adv_1176001_002",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "為什麼說得好像我做了什麼壞事一樣，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這太奇怪了吧？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "喔喔，",
    "voice": "vo_adv_1176001_003",
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "將軍！",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n你來得正好！",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "可以請你一起幫忙拜託她嗎？",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "其實，",
    "voice": "vo_adv_1176001_004",
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "因為發生了上次那件事，",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n大江戶町",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "也開始提倡",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "平時就要注意健康。",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "因為某位大人費盡心思提案張羅，",
    "voice": "vo_adv_1176001_005",
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我們現在要舉行健康檢查。",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "所以",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我才拜託在深月醫生那邊當過護理師的雪，",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n也務必來幫忙……",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "就算",
    "voice": "vo_adv_1176001_006",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你這麼說……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我就只有",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "可愛美麗的外貌，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "沒有任何醫療知識耶。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我已經從蘭德索爾找了醫生來，",
    "voice": "vo_adv_1176001_007",
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "這點還請放心。",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "妳在那間醫院的表現，",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n在大江戶町的居民之間大受好評。",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我的表現？",
    "voice": "vo_adv_1176001_008",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n我不是只有跟大家聊天而已嗎？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我們從妳身上學到了，",
    "voice": "vo_adv_1176001_009",
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "那是一件非常重要的事情。",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "經常聽到鎮上有人說，",
    "voice": "vo_adv_1176001_010",
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "雖然醫院感覺很可怕，\\n但跟雪聊天很開心，",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "所以比較願意去醫院了。",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "就算你這麼說，",
    "voice": "vo_adv_1176001_011",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "巧婦難為無米之炊。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "別寄望我了，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你們還是去找別人吧。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "她從剛剛就一直不為所動……",
    "voice": "vo_adv_1176001_012",
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "能幫忙想想辦法嗎？",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "說起來，",
    "voice": "vo_adv_1176001_013",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這種事打從一開始",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "就沒有找我去的必要……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "……你再說一次。",
    "voice": "vo_adv_1176001_014",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "好吧，",
    "voice": "vo_adv_1176001_015",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "既然你呢？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "都這麼說了嘛？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "那我去幫忙一下也不是不行啦？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "唉～真是的，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "既然需要我的美貌，那就沒辦法了。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "相對的，",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你也要一起來幫忙喔！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "所以",
    "voice": "vo_adv_1176001_016",
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "妳是答應了？",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "真不愧是將軍，",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "非常謝謝你們！",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n事不宜遲，請跟我來……！",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "background",
    "bg_id": "501380"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "雪跟{0}開始幫忙健康檢查後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n過了幾天。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "哼哼哼～♪",
    "voice": "vo_adv_1176001_017",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n好～",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "今天也要加油！",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "是說，",
    "voice": "vo_adv_1176001_018",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "如何？",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n果然",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "在這裡工作",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "還是該打扮成這樣才對，",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n很適合我吧？",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "嗯嗯，",
    "voice": "vo_adv_1176001_019",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "很好，非常誠實！",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n真不愧是",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我美貌的信徒，",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "盡情欣賞",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我的美吧。",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "對吧～？",
    "voice": "vo_adv_1176001_020",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "真不愧是我～",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "{0}，",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你該不會是想再看一次我的這副模樣，",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n才希望我來工作的吧？",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "呵呵……",
    "voice": "vo_adv_1176001_021",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "咦，",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "怎麼了？",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "一直目不轉睛地看著我，",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n雖然我能理解你看到入迷的心情……",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "難不成，",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我的美貌",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "有哪裡不一樣……？",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "咦？",
    "voice": "vo_adv_1176001_022",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n你說",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "看我這麼樂在工作之中，",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "感覺很不可思議？",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "真失禮，",
    "voice": "vo_adv_1176001_023",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "只要有獎賞……",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n不對，",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "只要有意義，我也是會努力工作的。",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "比起這個，",
    "voice": "vo_adv_1176001_024",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n看到我的美貌，",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你沒有什麼話要說嗎？",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "真是的～",
    "voice": "vo_adv_1176001_025",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
