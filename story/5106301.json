  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "這跟我知道的聖誕樹",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "完全不一樣……",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "嗯……",
    "voice": "vo_adv_5106301_001",
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "平常明明是那麼可愛的東西，",
    "voice": null,
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n竟然會突然狂暴化……",
    "voice": null,
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "反差太大了吧……",
    "voice": null,
    "unit_id": 124011
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "別被迷惑了，",
    "voice": "vo_adv_5106301_002",
    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "那是它暫時的化身，",
    "voice": null,
    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n只要能解開魔法，",
    "voice": null,
    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "一定就會變回原來的模樣。",
    "voice": null,
    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "用我們的力量",
    "voice": null,
    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "拯救那傢伙吧……！",
    "voice": null,
    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "依里、茜里",
    "words": "──好！",
    "voice": "vo_adv_5106301_003",
    "unit_id": null
  }
