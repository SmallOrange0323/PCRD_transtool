  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "不過大家都很積極參加，",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n就算輸了也很開心，好像也沒關係？",
