  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "怎麼這樣……",
    "voice": null,
    "unit_id": 130112
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n雖然這的確是倭姊姊很喜歡的發展……！",
