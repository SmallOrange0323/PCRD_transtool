    "unit_id": 127813
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "傷到別人也沒關係。",
    "voice": null,
    "unit_id": 127813
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127813
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "只要能從這個充滿矛盾的世界，",
    "voice": null,
    "unit_id": 127813
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
