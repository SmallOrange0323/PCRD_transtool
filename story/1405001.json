    "type": "dialogue",
    "name": "烏爾姆",
    "words": "就得離開了。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n我不能一直待在這裡。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我不能繼續依賴大家。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "這是理所當然的吧。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "畢竟，",
    "voice": "vo_adv_1405001_032",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我可是個叛徒啊……",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "background",
    "bg_id": "502960"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "從琳德那裡得知烏爾姆狀況的{0}，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n為了探望她，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "拜訪了烏爾姆的住處。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……早安。",
    "voice": "vo_adv_1405001_033",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "說是這麼說，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "但應該已經中午了吧。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……你是受我老姊所託才來的吧，",
    "voice": "vo_adv_1405001_034",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "不過睡眠不足是我自作自受，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "不用在意。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……啊啊。",
    "voice": "vo_adv_1405001_035",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "難怪老姊現在",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "還住在這裡啊。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "嘛，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我就是做了點惡夢而已。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我有在吃啦──",
    "voice": "vo_adv_1405001_036",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "萊拉耶爾殿下每天都有送布丁給我，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "最近",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "還升級成了水桶布丁。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "不過我實在吃不完，",
    "voice": "vo_adv_1405001_037",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "只好一點一點慢慢吃。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "而且我又沒怎麼運動，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "該說是根本不太會餓吧。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "喜歡的料理？",
    "voice": "vo_adv_1405001_038",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "…………",
    "voice": "vo_adv_1405001_039",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "所有人，",
    "voice": "vo_adv_1405001_040",
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "\\n每一個人，",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "\\n都是沒有靈魂的",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "dialogue",
    "name": "阿爾莎特",
    "words": "人偶……♡",
    "voice": null,
    "unit_id": 195611
  },
  {
    "type": "background",
    "bg_id": "502960"
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "該怎麼說呢？",
    "voice": "vo_adv_1405001_041",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……「喜歡蜂蜜」，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "「不喜歡苦澀的紅茶」。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "好像沒有",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "除此之外的「設定」了呢。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……………………",
    "voice": "vo_adv_1405001_042",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "等等。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我跟騎士先生",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "說這些幹嘛啊。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "可能因為每天總是做著奇怪的夢，",
    "voice": "vo_adv_1405001_043",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "才會比自己想像中還要煩躁……",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "睡眠不足真可怕……",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "看吧，",
    "voice": "vo_adv_1405001_044",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "騎士先生都沉默不語了。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……唉。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "雖然很麻煩，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "但還是隨便找個話題岔開一下吧──",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……啊。",
    "voice": "vo_adv_1405001_045",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "要來這招？",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……真的帶了各式各樣的東西過來啊。",
    "voice": "vo_adv_1405001_046",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "那麼，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "機會難得，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n我就心懷感激地享用",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "「主人」親手做的料理吧。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "那個，",
    "voice": "vo_adv_1405001_047",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "這第一道菜是……",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……",
    "voice": "vo_adv_1405001_048",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "原來如此？",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n也就是說，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "是將蘭德索爾與吉歐‧提格尼亞的食材",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "結合在一起了啊。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "啊呣……",
    "voice": "vo_adv_1405001_049",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……原來是這樣啊。",
    "voice": "vo_adv_1405001_050",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n將不甜和甜的食材",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "組合在一起，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n原本還在想會是什麼味道，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "意外地還不錯呢？",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "哦～",
    "voice": "vo_adv_1405001_051",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "下一道是「蜜橙醬烤雞」嗎？",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "這也是創意料理吧。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n我要開動了。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "唔──！",
    "voice": "vo_adv_1405001_052",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n肉質好軟嫩，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "醬汁的甜味也令人上癮。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n真虧你找得到",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "這種組合呢。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "「鳳梨糖漿炒飯」",
    "voice": "vo_adv_1405001_053",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……沒想到到最後都還是創意料理。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "話說回來，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "這個組合實在是……",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "…………！！",
    "voice": "vo_adv_1405001_054",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n雖然很看人，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "但我還蠻喜歡這種口味呢。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "呼……",
    "voice": "vo_adv_1405001_055",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "多謝款待。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "同時兼顧甜與不甜的組合。",
    "voice": "vo_adv_1405001_056",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n這種搭配說不定",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "會在吉歐‧提格尼亞受到歡迎喔。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n畢竟有很多充滿好奇心的居民。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "啊……",
    "voice": "vo_adv_1405001_057",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n這麼說來，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "之前是在聊這個呢。",
