    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……唉，",
    "voice": "vo_adv_1405001_060",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n都是[rub:那傢伙]阿爾莎特[/rub]害的，",
