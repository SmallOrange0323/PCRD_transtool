    "unit_id": 127812
  },
  {
    "type": "background",
    "bg_id": "502960"
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "明明想離開，",
    "voice": "vo_adv_1405001_069",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "卻又想留在對方身邊。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "明明想留在對方身邊，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "卻又想離開。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n我已經搞不清楚",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "自己到底是怎麼想的了……",
