  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "はは……",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "やった、",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "やってやりましたわー！",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nバジリスク、",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "討伐完りょ、",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "う……",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "あ、",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ららら……",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "クレジッタさん！？　",
    "voice": "vo_adv_5132402_001",
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "どこか",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "ケガでもされたんですか！",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "ご安心を。",
    "voice": "vo_adv_5132402_002",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "体力が尽きかけたところに大声で勝ち名乗りを上げたせいで",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\nいよいよ限界がきただけですから。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n特製の栄養剤で",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "体力を前借りすれば、",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "すぐ復活します。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "そう、",
    "voice": "vo_adv_5132402_003",
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "ですか……",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "よかった……",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "クレジッタさんには",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "だいぶ無理をさせてしまいました。",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "わたしのために、",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "ありがとうございます……",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ふっ、",
    "voice": "vo_adv_5132402_004",
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "陛下の頼みとあらば、",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "化け物の一匹や二匹くらい",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n倒してみせるのが真の忠臣、",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ですわ！",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "まあ、",
    "voice": "vo_adv_5132402_005",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "実際倒したのは",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "陛下なのですが。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "こ、",
    "voice": "vo_adv_5132402_006",
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "細かいことはいいんですわよ！",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "とにかくわたくしは",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "陛下のためなら何でもする、",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nそのことは示せたし、",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "これからも努めてまいりますわ！",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "クレジッタさん……",
    "voice": "vo_adv_5132402_007",
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "それでは",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "お疲れのところ申し訳ないのですが、",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "このバジリスクの下処理を手伝ってください！",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "え……？　",
    "voice": "vo_adv_5132402_008",
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "こ、",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "このデカすぎバジリスクを、",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ここで……？",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "はい！　",
    "voice": "vo_adv_5132402_009",
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "すぐにやらないとどんどん味が落ちてしまうので、",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "最高のごちそうにするためにも",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "ぜひ、",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "お願いします。",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "頑張ってくださいね、",
    "voice": "vo_adv_5132402_010",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "真の忠臣。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ちょっと！？",
    "voice": "vo_adv_5132402_011",
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n貴女も手伝うんですからね秘書１号！？",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "あ。",
    "voice": "vo_adv_5132402_012",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "もう定時を過ぎていますので。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "きいいいーーーーっ！！",
    "voice": "vo_adv_5132402_013",
    "unit_id": 128011
  }
]
