  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "沒想到我也能參與製作年菜呢。",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "決定了就馬上開始料理吧。",
    "voice": "vo_adv_1118001_060",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "食材的新鮮度可是美味的關鍵喔。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好的！！",
    "voice": "vo_adv_1118001_061",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "特製豪華魔物年菜，",
    "voice": "vo_adv_1118001_062",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "完成啦☆",
