[
  {
    "type": "background",
    "bg_id": "500651"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "新年將至，貪吃佩可和{0}",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n為了買備受好評的豪華年菜，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n大老遠地來到了大江戶町。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那間店",
    "voice": "vo_adv_1118001_000",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "應該在這附近才對……",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n聽說會大排長龍，",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但都還沒看到來排隊的人呢。",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……啊！！",
    "voice": "vo_adv_1118001_001",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n該不會已經全部賣完了吧！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "說的也是，",
    "voice": "vo_adv_1118001_002",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不確認",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "就放棄也太性急了。",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "而且，",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "俗話說好酒沉甕底嘛，",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我們就期待還買得到吧！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "background",
    "bg_id": "500670"
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "唔，",
    "voice": "vo_adv_1118001_003",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "明明應該就是這間店……",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "卻沒有任何客人呢。",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "小姑娘，",
    "voice": "vo_adv_1118001_004",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "莫非妳是來買年菜的？",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "沒錯！",
    "voice": "vo_adv_1118001_005",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我們是從蘭德索爾來的，",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "果然已經賣光了嗎？",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "蘭德索爾！",
    "voice": "vo_adv_1118001_006",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "那還真是千里迢迢呢……",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n實在抱歉讓妳白跑一趟，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n我們今年做不成年菜了。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "老婆婆妳是這裡的店員嗎？",
    "voice": "vo_adv_1118001_007",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "做不成年菜",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是什麼意思？",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "我們的供貨商",
    "voice": "vo_adv_1118001_008",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "今年受到魔物襲擊，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n特選的食材都送不過來了。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這樣啊……",
    "voice": "vo_adv_1118001_009",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "我姑且",
    "voice": "vo_adv_1118001_010",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "有將停賣消息公佈到大江戶町內，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "但由於事出突然，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "還來不及通知到",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n蘭德索爾那裡，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "不好意思啊。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不不、請妳別這麼說！",
    "voice": "vo_adv_1118001_011",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "沒關係的！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這種事稍微查一下就能知道了，",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n不是老婆婆的錯啦！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "妳能這麼說真是太感謝了。",
    "voice": "vo_adv_1118001_012",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "對了，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "讓妳空手而歸我會很過意不去的，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n帶幾道料理回去吧。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "雖然不是那種拿出來賣，",
    "voice": "vo_adv_1118001_013",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n只是我做來",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "自己吃的簡單料理，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n但也很好吃喔。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "能得到美味料理",
    "voice": "vo_adv_1118001_014",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n是很讓人感激啦，",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但真的可以嗎？",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "難得的新年卻見不到客人的笑容，",
    "voice": "vo_adv_1118001_015",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n讓我很空虛呢，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "妳就帶回去吧。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "而且，",
    "voice": "vo_adv_1118001_016",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "這或許是我最後一次",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n為客人做料理了。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "咦？",
    "voice": "vo_adv_1118001_017",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "為什麼……",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "根據業者的說法，",
    "voice": "vo_adv_1118001_018",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "採集年菜所需食材的地點，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n最近開始有很多魔物出沒。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "還說別太指望今後的貨源。",
    "voice": "vo_adv_1118001_019",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n再加上，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "我也上年紀了。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n雖然對客人們很抱歉，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "但我差不多是時候退休了。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "怎麼這樣……",
    "voice": "vo_adv_1118001_020",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "輪到我們出場？",
    "voice": "vo_adv_1118001_021",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……啊！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "說得沒錯呢！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "讓我們把擾人的魔物吃光光吧！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "好像能為小可蘿和小凱留",
    "voice": "vo_adv_1118001_022",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "帶很棒的伴手禮了！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "魔物的話，",
    "voice": "vo_adv_1118001_023",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我們確實有辦法解決呢。",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "而且，",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "吃著美味食材長大的魔物感覺就很好吃！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "既然決定了，",
    "voice": "vo_adv_1118001_024",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "就立刻出發吧！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "等、",
    "voice": "vo_adv_1118001_025",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "等一下！",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "我有點不太明白，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n小姑娘妳們打算做什麼？",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "老婆婆，",
    "voice": "vo_adv_1118001_026",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我們會去採集食材。",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "如果可以，",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "能麻煩妳為我們做年菜嗎？",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "以這種方式結束營業，也太寂寞了。",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "不、",
    "voice": "vo_adv_1118001_027",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "不過，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "但是……",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "光靠小姑娘你們兩人，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n能完成這麼危險的事嗎？",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "沒問題！",
    "voice": "vo_adv_1118001_028",
    "unit_id": 111811
  },
