    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "哎呀──",
    "voice": "vo_adv_1118001_063",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "沒想到魔物還有這種用途。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n看來我還",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "有得學呀。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "現在就退休似乎還太早了點呢。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……！！",
    "voice": "vo_adv_1118001_064",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n那麼……！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "是啊，",
    "voice": "vo_adv_1118001_065",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "我明年還會繼續做年菜。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n做出那種會讓所有人大吃一驚的料理。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "太好了！",
    "voice": "vo_adv_1118001_066",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "不過，",
    "voice": "vo_adv_1118001_067",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "再怎麼說還是得",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "先看這次的年菜料理成不成功啊。",
