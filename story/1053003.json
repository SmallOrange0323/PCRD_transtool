  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "時間來到莫妮卡打算參加的決鬥大賽當天。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……好、",
    "voice": "vo_adv_1053003_000",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "好，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "終於到這一天了！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "因為有閣下陪我一起特訓，",
    "voice": "vo_adv_1053003_001",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n我也變強許多了。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "在這個大賽裡，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "一定可以大顯身手的！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "明明應該是這樣的……",
    "voice": "vo_adv_1053003_002",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "啊，不，沒什麼！",
    "voice": "vo_adv_1053003_003",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n我、我還得去確認報到，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我走了。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "下次見面",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "應該是我獲勝之後啦！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "再見！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "唔……",
    "voice": "vo_adv_1053003_004",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "糟糕……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "結果，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "還是沒能說出實話……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "沒想到，",
    "voice": "vo_adv_1053003_005",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "大賽居然有身高限制……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "可我的身高……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "但、",
    "voice": "vo_adv_1053003_006",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "但是讓人幫忙進行特訓，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n結果卻不能參賽，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這實在難以啟齒……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "該怎麼辦呢……",
    "voice": "vo_adv_1053003_007",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "雖然在報名表上，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n我虛報了一點身高……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "不，",
    "voice": "vo_adv_1053003_008",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "不可以放棄！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "說不定",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我昨天一夜之間突然長高了也不一定！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "而且，",
    "voice": "vo_adv_1053003_009",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "大賽也不一定會仔細檢查身高。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "總之就去報到看看吧！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "好的，現在開始按照順序量身高喔──！",
    "voice": "vo_adv_1053003_010",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "完了……",
    "voice": "vo_adv_1053003_011",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n果然還是要現場量身高啊……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "下一位──！",
    "voice": "vo_adv_1053003_012",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "\\n就是小姐妳啦。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "\\n請站到這裡來。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "等、等等、",
    "voice": "vo_adv_1053003_013",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我……去上一下洗手間。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "很快就好了。",
    "voice": "vo_adv_1053003_014",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "好啦，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "請站上來吧。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "唔、",
    "voice": "vo_adv_1053003_015",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "唔嗯……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "看來是逃不過了。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "我看看……？",
    "voice": "vo_adv_1053003_016",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "\\n呃，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "138公分呢。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "非常抱歉。",
    "voice": "vo_adv_1053003_017",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "\\n為了安全起見140公分以下的人不能參加喔。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "果然是這樣……",
    "voice": "vo_adv_1053003_018",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "但、",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "但是，我有足夠的實力！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "而且，",
    "voice": "vo_adv_1053003_019",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "為了今天的比賽，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n還有夥伴特地陪我進行了特訓，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "為了夥伴，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我絕對要參賽！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "拜託你了！",
    "voice": "vo_adv_1053003_020",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n請讓我參加吧！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "就算妳這麼說，",
    "voice": "vo_adv_1053003_021",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "但規矩就是規矩……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "你就行行好吧！",
    "voice": "vo_adv_1053003_022",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "參加者１",
    "words": "怎麼了，怎麼了？",
    "voice": "vo_adv_1053003_023",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "參加者１",
    "words": "\\n發生什麼事了啊？",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "參加者２",
    "words": "身高不夠？",
    "voice": "vo_adv_1053003_024",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "參加者２",
    "words": "\\n有什麼關係嘛。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "參加者２",
    "words": "\\n她都已經這麼誠懇地拜託了，就讓她參加嘛。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "幾位閣下……！",
    "voice": "vo_adv_1053003_025",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "但是，",
    "voice": "vo_adv_1053003_026",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "這是規則……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "不行就是不行。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "參加者１",
    "words": "對小孩說這種話，太殘忍了。",
    "voice": "vo_adv_1053003_027",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "參加者１",
    "words": "\\n",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "參加者１",
    "words": "要不然，大賽也辦一個小孩部門呀！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "參加者２",
    "words": "是啊是啊！",
    "voice": "vo_adv_1053003_028",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "參加者２",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "參加者２",
    "words": "為什麼沒有小孩部門呢？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "參加者２",
    "words": "\\n如果有的話，事情可以解決啦！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "啊……不、",
    "voice": "vo_adv_1053003_029",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "不是……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我並不是小孩……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "參加者們",
    "words": "小孩部門！",
    "voice": "vo_adv_1053003_030",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "參加者們",
    "words": "小孩部門！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "都說了，我不是──",
    "voice": "vo_adv_1053003_031",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "參加者們",
    "words": "小孩部門！！",
    "voice": "vo_adv_1053003_032",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "參加者們",
    "words": "小孩部門！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "我、我瞭解了！",
    "voice": "vo_adv_1053003_033",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "\\n是我錯了！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "所以，請大家安靜！！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "喔喔！？",
    "voice": "vo_adv_1053003_034",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "難道，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我也可以參加了嗎！？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "下次我們會設一個小孩部門的。",
    "voice": "vo_adv_1053003_035",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "接待員",
    "words": "所以小妹妹妳就當個好孩子，等到下次再參加吧？",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "唔……",
    "voice": "vo_adv_1053003_036",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "唔、",
    "voice": null,
