[
  {
    "type": "background",
    "bg_id": "502400"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "當各地正上演著一場場反抗消滅的戰鬥時，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n霸瞳皇帝造訪了某個人物。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……哎呀。",
    "voice": "vo_adv_5220003_000",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n看你這落魄的樣子，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "真是悽慘呢。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "──「術士」的局長。",
    "voice": "vo_adv_5220003_001",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "不對，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "該說是「前任」局長才對吧？",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "……這問候還真沒禮貌，",
    "voice": "vo_adv_5220003_002",
    "unit_id": 193611
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "霸瞳皇帝。",
    "voice": null,
    "unit_id": 193611
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "但是，",
    "voice": "vo_adv_5220003_003",
    "unit_id": 193611
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "你目前的狀況並非萬全吧？",
    "voice": null,
    "unit_id": 193611
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "\\n看來是在那場戰鬥中，",
    "voice": null,
    "unit_id": 193611
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "被尤絲蒂亞娜公主等人",
    "voice": null,
    "unit_id": 193611
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "\\n修理得很慘。",
    "voice": null,
    "unit_id": 193611
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "還有，",
    "voice": "vo_adv_5220003_004",
    "unit_id": 193611
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "還不需要加上「前任」這兩個字。",
    "voice": null,
    "unit_id": 193611
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "\\n……",
    "voice": null,
    "unit_id": 193611
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "只是不曉得３天後會怎麼樣。",
    "voice": null,
    "unit_id": 193611
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "嗯，",
    "voice": "vo_adv_5220003_005",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我想也是。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n畢竟對目前的聯合國來說，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "你的立場",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n太過危險。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "儘管",
    "voice": "vo_adv_5220003_006",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "成功顛覆現實的阿斯特賴亞王國，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n卻被兩位部下背叛，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "奪取埃忒耳模組的行動失敗。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "不光沒能",
    "voice": "vo_adv_5220003_007",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "得到目標的「認知修正程式」，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n連表面任務",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "「拯救消失靈魂」的功勞",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n都被小姑娘們奪走，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "也沒能打倒幻境龍后。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "即使想要解釋，",
    "voice": "vo_adv_5220003_008",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "也遭到上層阻撓，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n連登出都做不到……",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "不過你似乎是至少勉強",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "保住了身邊的部下。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "這不叫悲慘，什麼才叫悲慘呢。",
    "voice": "vo_adv_5220003_009",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n看了真是爽快。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "隨妳怎麼說。",
    "voice": "vo_adv_5220003_010",
    "unit_id": 193611
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "\\n",
    "voice": null,
    "unit_id": 193611
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "我總有一天會回到",
    "voice": null,
    "unit_id": 193611
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "「[rub:那邊]現實[/rub]」，",
    "voice": null,
    "unit_id": 193611
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "再次貫徹自己的正義。",
    "voice": null,
    "unit_id": 193611
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "──",
    "voice": "vo_adv_5220003_011",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "正義？",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我是完全不認為",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "現在的你能夠達成",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "這種冠冕堂皇的口號啦。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "畢竟我倖存下來了。",
    "voice": "vo_adv_5220003_012",
    "unit_id": 193611
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "\\n",
    "voice": null,
    "unit_id": 193611
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "既然沒死，",
    "voice": null,
    "unit_id": 193611
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "那唯一能做的就是貫徹這個「口號」到死。",
    "voice": null,
    "unit_id": 193611
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "……差不多該進入正題了。",
    "voice": "vo_adv_5220003_013",
    "unit_id": 193611
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "\\n妳應該",
    "voice": null,
    "unit_id": 193611
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "對我的信條毫無興趣吧？",
    "voice": null,
    "unit_id": 193611
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "嗯，",
    "voice": "vo_adv_5220003_014",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "沒錯。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n我的興趣只是",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "「你要如何存在」，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "而不在於",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n你今後",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "「要貫徹什麼」。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "好了……",
    "voice": "vo_adv_5220003_015",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "那就讓我們開始「談判」吧？",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "──事情的始末我已經清楚了。",
    "voice": "vo_adv_5220003_016",
    "unit_id": 193611
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "\\n",
    "voice": null,
    "unit_id": 193611
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "在這個前提上……",
    "voice": null,
    "unit_id": 193611
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "妳這是想讓我「協助」妳的意思吧？",
    "voice": null,
    "unit_id": 193611
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "這對你應該不是件壞事。",
    "voice": "vo_adv_5220003_017",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "只要以後你協助我，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "作為報酬，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "可以帶回有關這個世界核心",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n的資料，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "像是只有七冠才可能知道的那種…………",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "啊。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "只要把那份情報獻給聯合國，",
    "voice": "vo_adv_5220003_018",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n你在「現實」的立場",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "也能稍微得到一點保障了吧？",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "誰知道呢。",
    "voice": "vo_adv_5220003_019",
    "unit_id": 193611
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "\\n",
    "voice": null,
    "unit_id": 193611
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "表面上看似是妳讓步，",
    "voice": null,
    "unit_id": 193611
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "但其實",
    "voice": null,
    "unit_id": 193611
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "要流出什麼情報，",
    "voice": null,
    "unit_id": 193611
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "\\n以及情報本身的真偽，",
    "voice": null,
    "unit_id": 193611
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "還是掌握在妳手上吧？",
    "voice": null,
    "unit_id": 193611
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "也就是說，",
    "voice": "vo_adv_5220003_020",
    "unit_id": 193611
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "妳在情報戰中",
    "voice": null,
    "unit_id": 193611
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "可以一直處於有利的位置。",
    "voice": null,
    "unit_id": 193611
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "\\n",
    "voice": null,
    "unit_id": 193611
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "我反而會被妳當作傀儡，",
    "voice": null,
    "unit_id": 193611
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "甚至表面世界都有可能受到妳的掌控。",
    "voice": null,
    "unit_id": 193611
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "哎呀，",
    "voice": "vo_adv_5220003_021",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "你很清楚嘛。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n但你無法拒絕，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "對吧？",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "畢竟",
    "voice": "vo_adv_5220003_022",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "想要持續你的「正義」遊戲，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "沒有其他辦法了。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "更何況，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "現在你自己也性命攸關了。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "……咕。",
    "voice": "vo_adv_5220003_023",
    "unit_id": 193611
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "\\n",
    "voice": null,
    "unit_id": 193611
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "霸瞳皇帝──",
    "voice": null,
    "unit_id": 193611
  },
  {
    "type": "dialogue",
    "name": "八斗神",
    "words": "妳果然可怕。",
    "voice": null,
    "unit_id": 193611
  },
