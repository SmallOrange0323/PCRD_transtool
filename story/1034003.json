[
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "當{0}走在城鎮內時――",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "唔唔唔唔唔……果然很可愛呢……",
    "voice": "vo_adv_1034003_000",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n如果再便宜一點的話，我就買得起了……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "欸？ 啊……是你！",
    "voice": "vo_adv_1034003_001",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "你、你好！",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "那、那個，前陣子……",
    "voice": "vo_adv_1034003_002",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n欸嘿嘿，因為喝太多而讓你看見我丟臉的樣子……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "雖然你那麼對我說……",
    "voice": "vo_adv_1034003_003",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n如果我真的沒被討厭就好了……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "啊、啊哈哈……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "這、這樣啊……",
    "voice": "vo_adv_1034003_004",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "唔呵呵。謝謝！",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "真開心呢。",
    "voice": "vo_adv_1034003_005",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "你、你還把我帶……回家。",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "怎、怎麼會……！ ",
    "voice": "vo_adv_1034003_006",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "完、完了……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "你說是開玩笑……？ 完全不討厭我？ ",
    "voice": "vo_adv_1034003_007",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "真、真是的――！",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n怎麼能這樣戲弄姐姐呢！",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "咦，你問我在做什麼？",
    "voice": "vo_adv_1034003_008",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n我在購物……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "喏，你看這間護具店的飾品！",
    "voice": "vo_adv_1034003_009",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n不覺得它很可愛嗎？",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "但是……\\n重要的是它下面標示的價錢啊……",
    "voice": "vo_adv_1034003_010",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "這似乎只有一個，而且真的很貴……",
    "voice": "vo_adv_1034003_011",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n但考慮到公會的經營，我不能亂花錢……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n沒有辦法，我只能羨慕地望著它。",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "唉……真想要啊……",
    "voice": "vo_adv_1034003_012",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "隔天。\\n當{0}恰巧路過護具店前時――",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "防具屋店長",
    "words": "有小偷――！！",
    "voice": "vo_adv_1034003_013",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "小偷",
    "words": "咕嘿嘿！ 這間店的營業額，",
    "voice": "vo_adv_1034003_014",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "小偷",
    "words": "\\n我全收下囉――――！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "小偷",
    "words": "啊？ 你這傢伙要做什麼，想討皮痛嗎――",
    "voice": "vo_adv_1034003_015",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "小偷",
    "words": "呃！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "防具屋店長",
    "words": "謝謝你！ 謝謝你！",
    "voice": "vo_adv_1034003_016",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "防具屋店長",
    "words": "\\n如果這個月的營業額全部被搶的話……",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "防具屋店長",
    "words": "\\n我們就要面臨破產了！ 多虧你的幫忙！",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "防具屋店長",
    "words": "我送你一件本店的商品作為謝禮！",
    "voice": "vo_adv_1034003_017",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "防具屋店長",
    "words": "\\n請隨意挑一件！",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "隔天，當{0}正在尋找優花梨時――",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "阿，",
    "voice": "vo_adv_1034003_018",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "{0}……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "咦……你說我看起來很沮喪的樣子？",
    "voice": "vo_adv_1034003_019",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "呵呵，讓你擔心了，對不起。",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "其實今天……我原本想買下那個飾品。",
    "voice": "vo_adv_1034003_020",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n帶著",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "積蓄，興高采烈地去了那間店……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "但飾品已經被買走了。\\n雖然那是我很喜歡的飾品……卻沒有順利買到呢。",
    "voice": "vo_adv_1034003_021",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "但這也是沒辦法的事呢。這應該就是命運的機緣吧。",
    "voice": "vo_adv_1034003_022",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "那個飾品一定是有男朋友的人，",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n吵著要男朋友買來送給她的吧――。",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我沒有命中注定的人啊……",
    "voice": "vo_adv_1034003_023",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "必須接受這個事實呢。",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "咦……禮物？ 你要送我？",
    "voice": "vo_adv_1034003_024",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "……咦、咦？",
    "voice": "vo_adv_1034003_025",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n這是……我想要的飾品……！",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "你、你問我『打起精神了嗎』，但問題不在這裡……",
    "voice": "vo_adv_1034003_026",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n怎麼",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "辦……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n我第一次收到男性送的禮物……！",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "優、優花梨，冷靜一點。",
    "voice": "vo_adv_1034003_027",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "呼――哈――，呼――哈――……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n好、好好想想發生了什麼事啊。",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "因為我沒有命中注定的人，所以才沒辦法得到想要的東西……\\n但、",
    "voice": "vo_adv_1034003_028",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "但是他，",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n卻送了我禮物……！",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "咦，也就是說，他是我命中注定的王子……咦？",
    "voice": "vo_adv_1034003_029",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "咦咦咦！？ 怎、怎麼辦……要和未成年的人",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n去哪裡約會才好……！？",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "咦……？ 啊……也、也是呢……",
    "voice": "vo_adv_1034003_030",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "你沒有特別的意思……對吧……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "……但是，這無疑是份禮物。",
    "voice": "vo_adv_1034003_031",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "真的、真的很謝謝你！ 我會好好珍惜的！",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "總之，我今晚似乎能懷著最棒的心情睡個好覺！",
    "voice": "vo_adv_1034003_032",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n我有了非常好的回憶呢！ 謝謝喔！",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "非常開心的優花梨緊抱著飾品如此說著。",
    "voice": null,
    "unit_id": null
  }
]
