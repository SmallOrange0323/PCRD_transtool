  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "但你沒忘記",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n我們現在賭上哥哥，正在激烈競爭吧？",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "難道說，",
