[
  {
    "type": "background",
    "bg_id": "501030"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在慈樂之音巡演中的某個夏日，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n紡希利用下次公演前的休息日，來到了某處海邊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "嗯～～～！",
    "voice": "vo_adv_1174002_000",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "天氣真好！",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n今天是個適合衝浪的好日子呢！！　",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "要是小望和千歌她們也能一起來就好了。",
    "voice": "vo_adv_1174002_001",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "但她們有其他行程，這也沒辦法……",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "話說回來，騎士先生也是，",
    "voice": "vo_adv_1174002_002",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n特別幹勁十足地出門去了……",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我才不在意那個人的行程呢！",
    "voice": "vo_adv_1174002_003",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n沒錯，",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "一點也不在意！！　",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我今天要盡情地享受休假！",
    "voice": "vo_adv_1174002_004",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "向著大海！",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "出發！　",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "……騎士先生！？",
    "voice": "vo_adv_1174002_005",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n你怎麼會在這裡！？",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "咦？",
    "voice": "vo_adv_1174002_006",
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "是大哥哥認識的人嗎？",
    "voice": null,
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "大姐姐",
    "voice": "vo_adv_1174002_007",
    "unit_id": 213
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "長得好眼熟呀……",
    "voice": null,
    "unit_id": 213
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "\\n",
    "voice": null,
    "unit_id": 213
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "對了！",
    "voice": null,
    "unit_id": 213
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "是慈樂之音的──",
    "voice": null,
    "unit_id": 213
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "啊～～～！",
    "voice": "vo_adv_1174002_008",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我常常被人這麼說呢！",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "嗚嗚……",
    "voice": "vo_adv_1174002_009",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "對不起喔。",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我被經紀人再三叮囑",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n出去玩時不能暴露身分……",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "說得也是……",
    "voice": "vo_adv_1174002_010",
    "unit_id": 213
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "\\n",
    "voice": null,
    "unit_id": 213
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "偶像怎麼可能出現在這裡嘛。",
    "voice": null,
    "unit_id": 213
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "就是啊就是啊！",
    "voice": "vo_adv_1174002_011",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "所、",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "所以，你們三個人在這裡做什麼？",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "我們呀，",
    "voice": "vo_adv_1174002_012",
    "unit_id": 213
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "\\n在和大哥哥",
    "voice": null,
    "unit_id": 213
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "一起練習游泳唷！",
    "voice": null,
    "unit_id": 213
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "大哥哥一大早就自己一個人跑來練習，",
    "voice": "vo_adv_1174002_013",
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "\\n",
    "voice": null,
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "我們實在看不下去才來當他的教練！",
    "voice": null,
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "一大早！？",
    "voice": "vo_adv_1174002_014",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n話說騎士先生，",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "原來你不會游泳啊！？",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "嘿嘿！",
    "voice": "vo_adv_1174002_015",
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "這是特訓的成果呢！",
    "voice": null,
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "\\n可是，",
    "voice": null,
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "我們也差不多該回去了。",
    "voice": null,
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "不過，",
    "voice": "vo_adv_1174002_016",
    "unit_id": 213
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "既然朋友來了，就沒問題了吧！",
    "voice": null,
    "unit_id": 213
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "咦？",
    "voice": "vo_adv_1174002_017",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "是說我嗎！？",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我是能夠教他啦……",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "……",
    "voice": "vo_adv_1174002_018",
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "哦",
    "voice": null,
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "，",
    "voice": null,
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "看來有戲喔。",
    "voice": null,
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "\\n這不正是大哥哥的好機會嗎……",
    "voice": null,
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "大哥哥他",
    "voice": "vo_adv_1174002_019",
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "超級溫柔的喔！",
    "voice": null,
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "\\n如果選他當男朋友，",
    "voice": null,
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "他一定會非常珍惜妳的！",
    "voice": null,
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "男男男、",
    "voice": "vo_adv_1174002_020",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "男朋友！？",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n不不不！",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我這輩子都沒有那種打算啦！！",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "大哥哥，",
    "voice": "vo_adv_1174002_021",
    "unit_id": 213
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "我們會為你加油的！",
    "voice": null,
    "unit_id": 213
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "\\n",
    "voice": null,
    "unit_id": 213
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "掰掰──！！",
    "voice": null,
    "unit_id": 213
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "走掉了……",
    "voice": "vo_adv_1174002_022",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "話說回來，",
    "voice": "vo_adv_1174002_023",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "說完那種話之後留下我們兩人獨處……",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n氣氛超級尷尬啊……！　",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我、",
    "voice": "vo_adv_1174002_024",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我覺得你還是自己練習比較好！",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我要去衝浪了，",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "請你好好加油吧！",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "唉～",
    "voice": "vo_adv_1174002_025",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "只是像這樣躺在衝浪板上……",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "感覺和待在宿舍裡無所事事沒什麼兩樣嘛。",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "……騎士先生",
    "voice": "vo_adv_1174002_026",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "不擅長游泳對吧。",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n今天的浪有點高，",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "他沒問題吧？　",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "啊，",
    "voice": "vo_adv_1174002_027",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "看到人了。",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "他自己一個人在練習呢……",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "……正、",
    "voice": "vo_adv_1174002_028",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "正好有點口渴了，",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n去海之家的路上順便和他打聲招呼──",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "呀──！",
    "voice": "vo_adv_1174002_029",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "海裡有個巨大的魔物──！！",
    "voice": "vo_adv_1174002_030",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "\\n大家",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性１",
    "words": "快上岸避難！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "這裡怎麼會出現魔物！",
    "voice": "vo_adv_1174002_031",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n留在海裡的人呢！？　",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "……還有很多！",
    "voice": "vo_adv_1174002_032",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我得引開那傢伙的注意，",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "為大家爭取時間……！　",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "喂喂！",
    "voice": "vo_adv_1174002_033",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我在這裡唷──！！",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "來比比看",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "誰的速度更快吧！！",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "嗚哇哇哇……！",
    "voice": "vo_adv_1174002_034",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "明明體型龐大移動速度卻非常快！",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "這下遲早會被他追上吧！？　",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "騎士先生！？",
    "voice": "vo_adv_1174002_035",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "你怎麼站在崖上！？",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "這道光……",
    "voice": "vo_adv_1174002_036",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "力量湧出來了……",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "有了這股力量，",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我一個人也能把它打飛……！　",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "騎士先生真是的，",
    "voice": "vo_adv_1174002_037",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "總在最關鍵的時刻出現。",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n……害我不由得",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "萌生了一股安心感。",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "騎士先生，",
    "voice": "vo_adv_1174002_038",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "你要在那裡仔細看著",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我的活躍表現唷！　",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "喝呀呀呀！！",
    "voice": "vo_adv_1174002_039",
    "unit_id": 117411
  },
  {
    "type": "background",
    "bg_id": "501030"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "咦？",
    "voice": "vo_adv_1174002_040",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "它朝這裡倒下來了！？　",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "呀啊啊啊啊！？",
    "voice": "vo_adv_1174002_041",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "什麼都看不到……",
    "voice": "vo_adv_1174002_042",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n我……",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "現在怎麼樣了……？　",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "聽見了騎士先生的聲音……",
    "voice": "vo_adv_1174002_043",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "不用叫那麼大聲",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我也能聽見啦……",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "就說了──",
    "voice": "vo_adv_1174002_044",
    "unit_id": 117411
  },
  {
    "type": "background",
    "bg_id": "501030"
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我聽得見……",
    "voice": "vo_adv_1174002_045",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "騎士先生……",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "咦？",
    "voice": "vo_adv_1174002_046",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "怎麼在岸邊……？",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n而且，",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "騎士先生……？",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "那個……",
    "voice": "vo_adv_1174002_047",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n我有點搞不清楚現在的狀況……",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "那位少年跳下海",
    "voice": "vo_adv_1174002_048",
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "把妳救起來了喔。",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "咦……",
    "voice": "vo_adv_1174002_049",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "你明明不太會游泳，是怎麼辦到的……？",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "看起來確實不太會呢。",
    "voice": "vo_adv_1174002_050",
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "\\n然而，他卻把繩子捆在自己身上，",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "\\n又將繩子的一端交給我們，",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "拜託我們「收到信號後就拉他上來」……",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "他勉強靠著自己游了過去，",
    "voice": "vo_adv_1174002_051",
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "\\n",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "再由",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "這裡的所有人一起把你們拉回來。",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "\\n……真是",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "太亂來了。",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "不過，",
    "voice": "vo_adv_1174002_052",
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "幸好大家都沒事。",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "\\n",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "那麼，",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "我去找人過來，",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男性２",
    "words": "你們在這裡等一下！",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "騎士先生……",
    "voice": "vo_adv_1174002_053",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "所以你的臉色才這麼蒼白啊。",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "而且眼睛也有點紅……",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "都是因為我……",
    "voice": "vo_adv_1174002_054",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "騎士先生，",
    "voice": "vo_adv_1174002_055",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "對不起……",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "咦？",
    "voice": "vo_adv_1174002_056",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "因為……",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "……對喔。",
    "voice": "vo_adv_1174002_057",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "這種時候",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "不應該道歉。",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "應該要說「謝謝你救了我」，",
    "voice": "vo_adv_1174002_058",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "對吧！",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "紡希傳達了發自內心的感謝，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n看著這樣的她，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}也露出了笑容。",
    "voice": null,
    "unit_id": null
  }
]
