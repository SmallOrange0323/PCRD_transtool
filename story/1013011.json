[
  {
    "type": "background",
    "bg_id": "500050"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在那之後，七七香針對「黑暗魔導書」與「黑暗收藏家」，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n蒐集了許多情報。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "大概就像這樣吧～",
    "voice": "vo_adv_1013011_000",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "所以才想問妳是不是知道些什麼。",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "女魔法使",
    "words": "「黑暗收藏家」嗎。",
    "voice": "vo_adv_1013011_001",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女魔法使",
    "words": "那人最近好像是有些什麼動作。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "最近指的是，",
    "voice": "vo_adv_1013011_002",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "之前這幾天嗎？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "女魔法使",
    "words": "是啊。",
    "voice": "vo_adv_1013011_003",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女魔法使",
    "words": "聽說發掘出罕見魔導書的那間店裡，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女魔法使",
    "words": "\\n有幾個人跑去施展了前所未見的魔法鬧得天翻地覆。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "前所未見的魔法，",
    "voice": "vo_adv_1013011_004",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "嗎。",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "那應該是",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "「黑暗魔導書」賦予他們的魔法吧。",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "哼嗯……",
    "voice": "vo_adv_1013011_005",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "明明「黑暗魔導書」在我這裡，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "也一樣嗎。",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "看來那魔法一旦賦予，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "即使手頭沒有「黑暗魔導書」",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n還是能夠照常施展吧。",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "女魔法使",
    "words": "倒是原來有「黑暗魔導書」這種東西。",
    "voice": "vo_adv_1013011_006",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女魔法使",
    "words": "雖然聽起來有點難以置信，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女魔法使",
    "words": "\\n但這下事情就說得通了。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女魔法使",
    "words": "欸，",
    "voice": "vo_adv_1013011_007",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女魔法使",
    "words": "那東西能借我一下下嗎？",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "這可不～行。",
    "voice": "vo_adv_1013011_008",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "應該說，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我現在也還是脫不了手的狀態啦～",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n不管把它藏到哪兒去，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "都會不知不覺間回到我手裡。",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "何況",
    "voice": "vo_adv_1013011_009",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "根據對方的反應，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n這東西應該是真的每人限用一次。",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n那麼妳不如等到等級提升後再嘗試比較好。",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "女魔法使",
    "words": "……",
    "voice": "vo_adv_1013011_010",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女魔法使",
    "words": "也對。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女魔法使",
    "words": "那我就",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女魔法使",
    "words": "等魔法的實力更進一步後再跟妳借吧。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "好好好～",
    "voice": "vo_adv_1013011_011",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "隨時等妳來～",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "女魔法使",
    "words": "唉～",
    "voice": "vo_adv_1013011_012",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女魔法使",
    "words": "妳今天還真是從容大方喔。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女魔法使",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女魔法使",
    "words": "受不了妳們這種帶著男朋友的現充。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "什麼？",
    "voice": "vo_adv_1013011_013",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n妳哪壺不開提哪壺，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n竟然跟七七香我這種魔法宅中之宅說這種話！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "女魔法使",
    "words": "因為，",
    "voice": "vo_adv_1013011_014",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女魔法使",
    "words": "不就在妳後面嗎。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女魔法使",
    "words": "男朋友。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "男朋友？",
    "voice": "vo_adv_1013011_015",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "啥？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "唔哇啊啊啊！",
    "voice": "vo_adv_1013011_016",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n你你你、",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "你是哪時在的！？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "嚇得我心臟差點從嘴裡跳出來了！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "女魔法使",
    "words": "意思是他還不只是男朋友嗎？",
    "voice": "vo_adv_1013011_017",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女魔法使",
    "words": "\\n真有妳的。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "哇啊",
    "voice": "vo_adv_1013011_018",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "啊啊啊！？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n你、",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "你你你、",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "在胡說些什……",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "咦咦咦咦咦！？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "女魔法使",
    "words": "是是是，",
    "voice": "vo_adv_1013011_019",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女魔法使",
    "words": "多謝放閃。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女魔法使",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女魔法使",
    "words": "好吧，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女魔法使",
    "words": "反正帶著男朋友的女生總是這麼說嘛～",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女魔法使",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女魔法使",
    "words": "現在幸福就夠了，",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女魔法使",
    "words": "其他我別無所求！",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女魔法使",
    "words": "類似這種話。",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "啥？沒啦，",
    "voice": "vo_adv_1013011_020",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "不是的……！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "女魔法使",
    "words": "繼續打擾妳們也不好，",
    "voice": "vo_adv_1013011_021",
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女魔法使",
    "words": "我看我就先走一步吧～",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女魔法使",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女魔法使",
    "words": "唉～",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女魔法使",
    "words": "我看我也別找魔法改找男朋友好了～",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "呃，",
    "voice": "vo_adv_1013011_022",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "那個……",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "啊哈哈……",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "剛剛她",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "還真是誤會大了……",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n這樣子……",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "對、",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "對你應該很困擾吧？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "為為為為為、",
    "voice": "vo_adv_1013011_023",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "為什麼？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "等等，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "不對啦，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "現在不是開玩笑的……",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "咦？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "咦咦咦？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "咦？",
    "voice": "vo_adv_1013011_024",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "有、",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "有嗎？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "這這、",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "這、",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "這並不是",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "詛咒帶來的影響，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "呃嗯……",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "唔喔，",
    "voice": "vo_adv_1013011_025",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "好刺眼！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "你",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "怎麼像是在發光……",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
