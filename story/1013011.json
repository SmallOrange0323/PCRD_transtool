  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "認為跟世界觀格格不入，",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n但那與平常不一樣的角色間交流，",
    "voice": null,
    "unit_id": 101332
  },
