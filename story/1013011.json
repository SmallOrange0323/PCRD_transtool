  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "那個……",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我會好好珍惜的！",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "……不對啦，",
    "voice": "vo_adv_1013011_050",
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "這樣豈不是好像是什麼約會紀念一樣嗎！",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n還好周遭有許多其他情侶，才沒那麼醒目……",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "既然會舉辦情侶限定活動，",
    "voice": "vo_adv_1013011_051",
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n看來世上的御宅情侶檔",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "比我所想的還要多啊。",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "情侶……",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "情侶嗎……",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我、",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "跟他……",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "對了！",
    "voice": "vo_adv_1013011_052",
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我們開動吧！",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "既然聖代都送上來了！",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "一個人也吃不完，我們倆一起……",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "喂～",
    "voice": "vo_adv_1013011_053",
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我怎麼又得寸進尺地說這種活像是情侶檔會講的話啦！",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n可是……",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "看他好像也是一副樂在其中的樣子……",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "那麼，",
    "voice": "vo_adv_1013011_054",
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "啊～",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "請餵我吃一口吧～",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n開個玩笑而已……",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "呼喔喔喔！",
    "voice": "vo_adv_1013011_055",
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n等等等等等！",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "玩笑！",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我是玩笑的！",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我們趕緊開動吧！！",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "好嗎！？",
    "voice": null,
    "unit_id": 101332
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好的，",
    "voice": "vo_adv_1013011_056",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "辛苦囉。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "七七香的男朋友，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "當的還挺稱職的嘛。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n這次就稱讚你吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "倒是",
    "voice": "vo_adv_1013011_057",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "七七香她也真是的～",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "都察覺到自己的真心了卻還要裝傻下去。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這下真不曉得到底誰才是遲鈍男主角了呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好了，",
    "voice": "vo_adv_1013011_058",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "玩笑就開到這裡。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n不管動畫還是電玩，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "總是能全心全意地投入所好。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n她真是個認真的女生呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不過",
    "voice": "vo_adv_1013011_059",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "經歷了這件事，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n也許她接下來",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "就能夠面對自己的真心了吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那麼到時候，",
    "voice": "vo_adv_1013011_060",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你也要誠懇地面對七七香喔？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這次就到此結束。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "下次見囉～",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500050"
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "眼睛～",
    "voice": "vo_adv_1013011_061",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我的眼睛────！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "呃",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "咦，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "這裡是……",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "哎呀～",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "原來我不知不覺間睡著了嗎……",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "{0}……咦，",
    "voice": "vo_adv_1013011_062",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "原來這頭也睡著了呢。",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "啊～",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "還睡得一臉幸福的樣子。",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "嘻嘻……",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "倒是話說回來，",
    "voice": "vo_adv_1013011_063",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "剛剛的夢境真奇怪啊～",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "竟然說我們是有默契的情侶……",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "但是要御宅和戀愛……",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "要兩者兼融，",
    "voice": "vo_adv_1013011_064",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "說不定、",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "也可以……",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "嗎？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "而如此嘀咕的七七香並未察覺，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n自己懷裡的「黑暗魔導書」正發出淡淡的光輝。",
    "voice": null,
    "unit_id": null
  }
]
