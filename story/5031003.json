[
  {
    "type": "background",
    "bg_id": "500170"
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "沒想到",
    "voice": "vo_adv_5031003_000",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "2區竟然在如此膠著的狀態結束了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "\\n所有選手並列",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "進入了3區！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "\\n森林裡的視野很差，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "這段賽程絕對會讓大家陷入苦戰！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "雖然主人",
    "voice": "vo_adv_5031003_001",
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "和一群女性",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "一起來到中繼站的這種情況實在讓人無法接受，",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但是大家並列進入3區的狀況，",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "還真是激烈呢。",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "話說回來，",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "純小姐穿著這身鎧甲，",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "看起來會比在下",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "還難跑呢。",
    "voice": null,
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我平時生活、",
    "voice": "vo_adv_5031003_002",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "訓練時都是穿成這樣子。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n所以沒問題的。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "現在勉強搶先可沒什麼效率呢。",
    "voice": "vo_adv_5031003_003",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "還是先保存體力比較好……",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "先走一步囉～",
    "voice": "vo_adv_5031003_004",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "什麼！？",
    "voice": "vo_adv_5031003_005",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "沒想到！　",
    "voice": "vo_adv_5031003_006",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "突然取得領先的是鈴選手！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "小鈴好～～～～厲害！　",
    "voice": "vo_adv_5031003_007",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "老實說我還以為妳會是最後一名呢！",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "她很靈活地在樹與樹之間穿梭呢。",
    "voice": "vo_adv_5031003_008",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n是因為鈴的個子很嬌小……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "的關係嗎？",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "不過",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "她的動作對森林很熟悉呢。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我知道了！　",
    "voice": "vo_adv_5031003_009",
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "一定是她為了彌補平時偷懶的份，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n一個人練習過了吧！　",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "哎呀，",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "小鈴真是見外～",
    "voice": null,
    "unit_id": 105211
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "因為自己常常偷懶跑來撿橡實",
    "voice": "vo_adv_5031003_010",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n所以對森林很熟，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "這種話實在說不出口呢……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊也在唷～！",
    "voice": "vo_adv_5031003_011",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "哎――――呀！　",
    "voice": "vo_adv_5031003_012",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "追趕在鈴選手身後的",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "是禊選手！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "欸嘿嘿。",
    "voice": "vo_adv_5031003_013",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊常常和【小小甜心】的大家來森林玩呢！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n要在這跑步太簡單了，簡～單！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "啊！　",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "從那邊的樹木之間穿過去的話就可以抄近路唷！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "抄近路！？　",
    "voice": "vo_adv_5031003_014",
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這可不能當作沒聽到呢！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "唔，",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "呀啊啊啊！",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "　",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這、",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這個又白又黏的是什麼……",
    "voice": null,
    "unit_id": 104811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "嘿嘿，",
    "voice": "vo_adv_5031003_015",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "那是蜘蛛魔物的巢穴唷～",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n惡作劇大成功～！　",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "接下來是～！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "啊！　",
    "voice": "vo_adv_5031003_016",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "鎧甲姐姐，",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "妳如果這樣繼續跑的話會撞到樹枝唷！？",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "呵呵。",
    "voice": "vo_adv_5031003_017",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "真是可愛的搗蛋鬼。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我才不會上妳的當，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗚啊！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哇！",
    "voice": "vo_adv_5031003_018",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "就說了嘛……",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "妳撞得好大力，沒事吧？",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "啊，",
    "voice": "vo_adv_5031003_019",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "妳在擔心我嗎？　",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "妳真溫柔呢。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊幫妳看看有沒有腫起來！　",
    "voice": "vo_adv_5031003_020",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "看――招！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "哇！　",
    "voice": "vo_adv_5031003_021",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "小、",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "小姐！　",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "把那個還給我！",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "沒有那個我就沒辦法跑步了啊！",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "咦？　",
    "voice": "vo_adv_5031003_022",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "……",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "咦～",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "這樣子啊～！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n好像也沒有腫起來，",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "那禊就走囉！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "等、慢著！　",
    "voice": "vo_adv_5031003_023",
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "頭盔！　",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不要把頭盔拿走啊──！",
    "voice": null,
    "unit_id": 104712
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "美冬選手和純選手，",
    "voice": "vo_adv_5031003_024",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "\\n似乎都因為禊選手的妨礙",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "而動彈不得的樣子～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "\\n可可蘿選手",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "跑向她們兩位，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "伸出援手了！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "目前第一名是",
    "voice": "vo_adv_5031003_025",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "鈴選手，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "第二名是",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "禊選手……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "奇怪？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "\\n沒看到鈴選手的身影呢。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "該不會是",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "掉進禊選手的洞穴陷阱裡了吧？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊什麼都沒做唷～？",
    "voice": "vo_adv_5031003_026",
    "unit_id": 100411
  },
  {
    "type": "still",
    "still_id": "503100301"
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "呼～",
    "voice": "vo_adv_5031003_027",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "睡得真舒爽。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "鈴選手她竟然！　",
    "voice": "vo_adv_5031003_028",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "在大樹的空隙間",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "擺出午睡的姿勢！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "\\n她的動作就像在某本繪本裡",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "實況",
    "words": "出現的兔子一樣！",
    "voice": null,
    "unit_id": null
  },
