  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}與班比得到了伊莉亞的協助，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n再度開始尋找貝斯。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "很Q彈？",
    "voice": "vo_adv_1223003_000",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "胖胖的？",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "粉紅色的龍？",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n……那就是妳在找的貝斯？",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "沒錯唷！",
    "voice": "vo_adv_1223003_001",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n既Q彈又胖胖的！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "粉紅色的龍，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "那就是貝斯唷！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "牠雖然有尖牙和利爪，",
    "voice": "vo_adv_1223003_002",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "但卻一下子",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "就能和蝴蝶",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "或是小動物玩在一塊呢──！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "以前小小的，班比還背得動牠，",
    "voice": "vo_adv_1223003_003",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n但不知道是不是因為給牠吃了很多水果……",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "牠現在",
    "voice": "vo_adv_1223003_004",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "已經長大到能背起班比",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "的程度了唷！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "然後",
    "voice": "vo_adv_1223003_005",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "那個啊──",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "牠和僕從一模一樣呢！！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "和這傢伙一模一樣……？",
    "voice": "vo_adv_1223003_006",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n這世上有這麼弱小的龍存在嗎？",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "有唷有唷！",
    "voice": "vo_adv_1223003_007",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "貝斯和僕從",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "都很容易被欺負，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n班比很擔心呢──",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "原來如此……",
    "voice": "vo_adv_1223003_008",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "如果是這麼奇特的龍，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n應該至少會聽到一兩件傳聞才對，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "但卻從沒聽過呢。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妳雖然說是偷偷溜出來的……",
    "voice": "vo_adv_1223003_009",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "但綁架妳的那群傢伙，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "可能已經發現你們逃走了。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "先不說班比，",
    "voice": "vo_adv_1223003_010",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "那麼懦弱的貝斯要是被發現就糟了。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……倒不如說，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "牠也有可能已經被抓住了。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這附近",
    "voice": "vo_adv_1223003_011",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "有許多適合藏身的洞窟。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "雖然不知道牠是迷路還是被綁架了……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "但似乎值得去找找看。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "貝斯要是被那些叔叔發現的話……",
    "voice": "vo_adv_1223003_012",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "得快點找到牠才行！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "可是……",
    "voice": "vo_adv_1223003_013",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "洞窟有很多個對吧？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n要從哪裡開始找才好呢──？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妳",
    "voice": "vo_adv_1223003_014",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "沒有蝙蝠眷屬嗎？",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "沒有唷。",
    "voice": "vo_adv_1223003_015",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比的僕從就只有{0}呀！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……妳",
    "voice": "vo_adv_1223003_016",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "還真奇怪呢。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "沒辦法了，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這裡就交給妾身吧。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n現身吧，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "吾之眷屬們！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "壞巴特",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 2011
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "哇──！",
    "voice": "vo_adv_1223003_017",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "伊莉亞好厲害──！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "哈、哈、哈！",
    "voice": "vo_adv_1223003_018",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n率直的稱讚真令人心情舒暢！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "來吧，",
    "voice": "vo_adv_1223003_019",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "眷屬們！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身下令！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n去找出貝斯的所在……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "啊好痛！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "壞巴特",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 2011
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "啊，好痛────！？",
    "voice": "vo_adv_1223003_020",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n唔……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你們今天的心情怎麼特別差啊……！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "若你們不願聽話，",
    "voice": "vo_adv_1223003_021",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身就恢復真正的模樣──",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "喂！",
    "voice": "vo_adv_1223003_022",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "不可以欺負伊莉亞唷！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "壞孩子們，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "來這裡排排站好！！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "壞巴特",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 2011
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "很好很好！",
    "voice": "vo_adv_1223003_023",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "做得很棒，真乖──！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "聽好囉？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "是要去找貝斯唷？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n牠是一隻",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "粉紅色的龍！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "那麼大家，",
    "voice": "vo_adv_1223003_024",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "去吧──！！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妳……",
    "voice": "vo_adv_1223003_025",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n該不會是使用了吸血鬼的力量……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妳用了「魅惑」嗎？",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "魅惑？",
    "voice": "vo_adv_1223003_026",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n班比",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "只是拜託牠們而已唷？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "竟然是下意識使出來的嗎！？",
    "voice": "vo_adv_1223003_027",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這小姑娘真是驚人……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不過，",
    "voice": "vo_adv_1223003_028",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "真可惜。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n班比若能加入我軍，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身離征服世界的夢想就更近了……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "征服世界？",
    "voice": "vo_adv_1223003_029",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n嗯……",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "對那種事情沒興趣──",
    "voice": null,
    "unit_id": 122311
  },
  {
