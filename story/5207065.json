    "unit_id": 137111
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "步未可是",
    "voice": "vo_adv_5207065_002",
    "unit_id": 137111
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我們公會",
    "voice": null,
    "unit_id": 137111
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "數一數二的忍者！",
    "voice": null,
    "unit_id": 137111
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 137111
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "在消除氣息這方面",
    "voice": null,
    "unit_id": 137111
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "無人能出其右！",
    "voice": null,
    "unit_id": 137111
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 137111
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "而且……",
    "voice": null,
    "unit_id": 137111
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我知道喔……",
    "voice": null,
    "unit_id": 137111
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "步未",
    "voice": "vo_adv_5207065_003",
    "unit_id": 137111
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "總是",
    "voice": null,
    "unit_id": 137111
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "在調查將軍的事，",
    "voice": null,
    "unit_id": 137111
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n她就是個純粹的",
    "voice": null,
    "unit_id": 137111
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "將軍狂熱者！",
    "voice": null,
    "unit_id": 137111
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "所以！",
    "voice": "vo_adv_5207065_004",
    "unit_id": 137111
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "不只是明裡暗裡……",
    "voice": null,
    "unit_id": 137111
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 137111
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "她應該會願意",
    "voice": null,
    "unit_id": 137111
  },
