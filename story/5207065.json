    "type": "dialogue",
    "name": "妮諾",
    "words": "按字面意思成為",
    "voice": null,
    "unit_id": 137111
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "將軍的影子，",
    "voice": null,
    "unit_id": 137111
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "保護將軍！",
    "voice": null,
    "unit_id": 137111
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "要是",
    "voice": "vo_adv_5207065_005",
    "unit_id": 137111
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "步未願意加入大奧……",
    "voice": null,
    "unit_id": 137111
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "登登登登登！",
    "voice": "vo_adv_5207065_006",
    "unit_id": 137111
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n將軍",
    "voice": null,
    "unit_id": 137111
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "駕到──！",
    "voice": null,
    "unit_id": 137111
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n大奧的各位！",
    "voice": null,
    "unit_id": 137111
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "請集合！",
    "voice": null,
    "unit_id": 137111
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "……咦？",
    "voice": "vo_adv_5207065_007",
    "unit_id": 137111
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n沒看到步未呢……？",
    "voice": null,
    "unit_id": 137111
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 137111
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "怎麼回事……？",
