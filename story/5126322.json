[
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "哎呀呀！？",
    "voice": "vo_adv_5126322_000",
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n惠理子寶她們",
    "voice": null,
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "加入了阿爾杰什寶那邊！？",
    "voice": null,
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n話說，",
    "voice": null,
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家也在裡面耶！？",
    "voice": null,
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "為什麼～～！？？",
    "voice": null,
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "冷靜點！",
    "voice": "vo_adv_5126322_001",
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n那是妳們的闇影……",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不對，",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是那傢伙的魔法呢……！",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "真假！？",
    "voice": "vo_adv_5126322_002",
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "……話說阿爾杰什寶",
    "voice": null,
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "居然想讓我們跟朋友互相戰鬥，",
    "voice": null,
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n真是超級討厭的欸……！",
    "voice": null,
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不過阿爾杰什，",
    "voice": "vo_adv_5126322_003",
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你那樣做",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "可是反效果。",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我完全被惹毛了……！！",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "竟敢利用我的朋友……",
    "voice": "vo_adv_5126322_004",
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我絕對",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不會原諒你！！",
    "voice": null,
    "unit_id": 127211
  }
]
