[
  {
    "type": "background",
    "bg_id": "500160"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "當{0}為了比賽正在自主練習時，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n初音來到了他的身旁。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "{0}！\\n難不成",
    "voice": "vo_adv_1134002_000",
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "你在自主練習嗎？",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n美里老師明明說今天社團活動休息一天，",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "你還真勤奮呢～！",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "那麼那麼，",
    "voice": "vo_adv_1134002_001",
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n我可以待在這裡",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "看你練習嗎？",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "謝謝你！",
    "voice": "vo_adv_1134002_002",
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "對了，",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "要是你想要喝水之類的，",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "都可以跟我說喔！",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "{0}真的好厲害……！",
    "voice": "vo_adv_1134002_003",
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n天氣這麼熱，",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "還能夠一直認真地練習……！　",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "那認真的表情，",
    "voice": "vo_adv_1134002_004",
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "讓汗水顯得更耀眼了，",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "感覺很帥呢……！　",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我也不能輸！",
    "voice": "vo_adv_1134002_005",
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n為了在比賽時助大家一臂之力，",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n我也得做",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "加油的練習才行！　",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嗯！",
    "voice": "vo_adv_1134002_006",
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "既然如此，",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "就事不宜遲！",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n{0}！",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n我還有事，",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "就先走一趟了！",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我要去做",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "加油的練習～☆",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "這樣好嗎？",
    "voice": "vo_adv_1134002_007",
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "你不是還在練習……",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嗯嗯……",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "你說正好想去跑步，時機剛剛好……？",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "這樣啊！",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "那我們就一起走吧！",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "不過，",
    "voice": "vo_adv_1134002_008",
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "加油的練習要做些什麼好呢？",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "咦？",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "你說加油就是在鼓勵各式各樣的人，",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n所以可以試著去幫助有困難的人……？",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "真不愧是{0}！",
    "voice": "vo_adv_1134002_009",
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "這真是個好主意～！",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "那麼我就在這裡，",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "幫助附近的大家試試吧！",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "初音跟{0}兩個人，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n就這樣在海岸邊來回奔波，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "幫助遇到困難的人們──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500160"
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "欸嘿嘿～",
    "voice": "vo_adv_1134002_010",
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "不管是在海之家遇到麻煩的叔叔、",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n努力在打沙灘排球的大姐姐們，",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n以及在練習游泳的孩子們",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "都變得充滿活力呢！",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "或許是因為我有盡全力地幫大家加油！",
    "voice": "vo_adv_1134002_011",
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "只要努力地加油，",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "就一定能讓對方感受到我的心意～",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "像這樣替各種人加油，",
    "voice": "vo_adv_1134002_012",
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "真的讓我收穫良多！",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "就照這個氣勢繼續幫大家加油吧～！",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "嗚嗚……",
    "voice": "vo_adv_1134002_013",
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "\\n我果然……",
    "voice": null,
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "不行嗎……",
    "voice": null,
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "咦？",
    "voice": "vo_adv_1134002_014",
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "那位小朋友怎麼了嗎？",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "感覺他很失落呢……",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "讓人有點擔心呢……",
    "voice": "vo_adv_1134002_015",
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我去搭話看看！",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "像我這種人打從一開始就沒有機會了……",
    "voice": "vo_adv_1134002_016",
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "\\n",
    "voice": null,
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "我看……",
    "voice": null,
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "還是放棄吧……",
    "voice": null,
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "小朋友～！",
    "voice": "vo_adv_1134002_017",
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "你在這裡做什麼呢～？",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "走開啦……",
    "voice": "vo_adv_1134002_018",
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "\\n不要管我這種人……",
    "voice": null,
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "不要這麼說嘛！",
    "voice": "vo_adv_1134002_019",
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "你看起來很難過呢！",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我可以聽聽你的煩惱，",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "說出來或許會輕鬆一點！",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "原來是這樣啊～",
    "voice": "vo_adv_1134002_020",
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "你想要向喜歡的女生告白，",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n所以用貝殼做成一條項鍊，對吧？",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "嗯。",
    "voice": "vo_adv_1134002_021",
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "\\n然後，",
    "voice": null,
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "我想要找一顆漂亮的貝殼作為項鍊的墬飾。",
    "voice": null,
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "我聽說這附近的大海",
    "voice": "vo_adv_1134002_022",
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "有著像寶石一樣閃閃發亮的貝殼。",
    "voice": null,
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "\\n",
    "voice": null,
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "於是我就不斷地",
    "voice": null,
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "潛到海裡去找……",
    "voice": null,
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "結果還是沒找到嗎～",
    "voice": "vo_adv_1134002_023",
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "所以你才會那麼沮喪～",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "……嗯。",
    "voice": "vo_adv_1134002_024",
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "\\n",
    "voice": null,
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "這一定是上天在告訴我，",
    "voice": null,
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "你要告白還早得很呢。",
    "voice": null,
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "\\n因為這樣，",
    "voice": null,
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "我正打算放棄了……",
    "voice": null,
    "unit_id": 113
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "原來如此～",
    "voice": "vo_adv_1134002_025",
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "這樣的確會很沮喪呢～",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "……好，",
    "voice": "vo_adv_1134002_026",
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我決定了！",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我們就一起來",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
