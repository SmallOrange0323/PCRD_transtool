    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "其實我以為，",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n可能沒辦法再見到你了……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "（所、所以趁你睡著時，",
    "voice": "vo_adv_1012007_054",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n　忍不住對你說了那些話……）",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "（趁、趁你睡著時……）",
    "voice": "vo_adv_1012007_055",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "…………欸、",
    "voice": "vo_adv_1012007_056",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "欸，{0}。",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "你剛剛睡著了……對吧？",
    "voice": "vo_adv_1012007_057",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我說的話……你沒聽到……對吧？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "你問我什麼事，",
    "voice": "vo_adv_1012007_058",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "就是、那個……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "最、",
    "voice": "vo_adv_1012007_059",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "呼啊啊啊～～～",
