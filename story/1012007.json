[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "初音臉色大變地來到\\n一如往常過著平靜日子的{0}面前。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "終於找到你了――！",
    "voice": "vo_adv_1012007_000",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "不好了啊，不好了！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我做了預知夢！",
    "voice": "vo_adv_1012007_001",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "你知道預知夢嗎？",
    "voice": "vo_adv_1012007_002",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n是夢見未來之事的超能力……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "真的嗎！？",
    "voice": "vo_adv_1012007_003",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n你也是超能力者！？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "……因為夢到咖哩，所以中午就吃咖哩？",
    "voice": "vo_adv_1012007_004",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "那、那才不是預知夢呢！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "沒錯沒錯！",
    "voice": "vo_adv_1012007_005",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "預知夢使用了超能力，",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n所以我剛醒來又覺得睏，睡了回籠覺呢～",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "呃！",
    "voice": "vo_adv_1012007_006",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "不是說這些話的時候了！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "聽我說！ 蘭德索爾要不見了喔！",
    "voice": "vo_adv_1012007_007",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我在預知夢裡看見了！",
    "voice": "vo_adv_1012007_008",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "今晚會有隕石掉落在蘭德索爾喔！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n是非常非常大的隕石！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "雖是這麼說，你也不會相信吧？",
    "voice": "vo_adv_1012007_009",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n這麼離奇的事情……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "真的嗎！ ",
    "voice": "vo_adv_1012007_010",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "謝謝――！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n你果然是最棒的朋友呢！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "你有一半是相信的？",
    "voice": "vo_adv_1012007_011",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "欸嘿嘿，即使只有這樣我也很開心喔。",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "但、但是，該怎麼辦？",
    "voice": "vo_adv_1012007_012",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n變成那樣的話，大家會很困擾吧……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n最喜愛的城鎮沒了，很令人傷心呢……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "也對呢。",
    "voice": "vo_adv_1012007_013",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n至少要讓城鎮裡的人們去避難――",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "……但是，他們不會相信這種事吧？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "也不能到處去說我的能力……",
    "voice": "vo_adv_1012007_014",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n就算說了超能力的事，也不知道有沒有人會相信……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "咦咦！？ 怎麼做？",
    "voice": "vo_adv_1012007_015",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我覺得那是不可能的……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "……什麼什麼？ ",
    "voice": "vo_adv_1012007_016",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "你忽然想到什麼了！？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "咦？ 之前我睡很飽的時候？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "啊，原來如此！",
    "voice": "vo_adv_1012007_017",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "如果我像前陣子一樣睡很飽的話，",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n也許就能使用非常厲害的超能力！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "這樣一來，也許連隕石都能破壞！？",
    "voice": "vo_adv_1012007_018",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "即使破壞不了，",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n如果能改變它的路線，也許就不會掉在城鎮裡！？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嗯，好主意！ 不愧是你！",
    "voice": "vo_adv_1012007_019",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "好――！ 我們馬上去準備吧！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "這裡是我喜歡的地方喔。",
    "voice": "vo_adv_1012007_020",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n因為很舒服，可以讓我熟睡！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "喂，你也一起午睡嘛。",
    "voice": "vo_adv_1012007_021",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "如果你在身邊的話，我就能睡得很好……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n喂，可以吧？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "……可以嗎？ ",
    "voice": "vo_adv_1012007_022",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "謝謝你！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n好啦好啦，躺下來吧！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n休息吧～♪",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "background",
    "bg_id": "500142"
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嗯～，睡得好飽……",
    "voice": "vo_adv_1012007_023",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嗯！ 精神百分之兩百喔！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "啊，",
    "voice": "vo_adv_1012007_024",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n你還在睡呀……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "……你就在這裡睡吧。",
    "voice": "vo_adv_1012007_025",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n就算我失敗，這裡的話應該很安全的。",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "但是，我絕對會成功給你看的。",
    "voice": "vo_adv_1012007_026",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我必須守護大家的城鎮！以我全部的超能力……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "即使用我的生命交換，也要守護蘭德索爾。",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "………………",
    "voice": "vo_adv_1012007_027",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "……謝謝你總是幫我喔。",
    "voice": "vo_adv_1012007_028",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "在我睡著的時候守護我，",
    "voice": "vo_adv_1012007_029",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n也替我隱瞞超能力的事情……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "自從和你在一起之後，",
    "voice": "vo_adv_1012007_030",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n我每天都非常開心喔。",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "啊！ 還有，以防萬一！",
    "voice": "vo_adv_1012007_031",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "若是我不幸失敗，被隕石壓扁的話～",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "小栞……就麻煩你了。",
    "voice": "vo_adv_1012007_032",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "若是你的話，我就可以將",
    "voice": "vo_adv_1012007_033",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我最最、最～重要的小栞放心交給你……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "如果有你在小栞身邊的話，",
    "voice": "vo_adv_1012007_034",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n我想她一定也會很開心的喔。",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "那樣的話，我也會很高興的。",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "但是……",
    "voice": "vo_adv_1012007_035",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n我有點……羨慕呢……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "有點……不甘心呢……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "不只是……有點……呢……",
    "voice": "vo_adv_1012007_036",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "……說不定這是最後了，所以我就說囉。",
    "voice": "vo_adv_1012007_037",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我……最喜歡你了喔。",
    "voice": "vo_adv_1012007_038",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "……欸嘿嘿。",
    "voice": "vo_adv_1012007_039",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "趁你睡著的時候說有點狡猾呢。",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "但這是最後一次了，原諒我吧。",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "那麼，我去去就回♪",
    "voice": "vo_adv_1012007_040",
    "unit_id": 101211
  },
  {
    "type": "background",
    "bg_id": "500012"
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "真的掉下來了……！",
    "voice": "vo_adv_1012007_041",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "真是的！ 什麼預知夢嘛，失準的話該有多好！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "但是，我睡得很飽，所以沒問題的！",
    "voice": "vo_adv_1012007_042",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "那種隕石我兩三下就能破壞了喔！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嘿――――噫！！！",
    "voice": "vo_adv_1012007_043",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嗚……嗚！",
    "voice": "vo_adv_1012007_044",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": " 好、好重……！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n我明明充飽了電，使出超過全力的力量……！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n卻無法破壞隕石！？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "這、這樣下去的話……！",
    "voice": "vo_adv_1012007_045",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "咦！？",
    "voice": "vo_adv_1012007_046",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n奇、奇怪……突然變輕了？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "超能力突然增強了……？",
    "voice": "vo_adv_1012007_047",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "這難道是……！？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "這果然是你的力量……！",
    "voice": "vo_adv_1012007_048",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "真、真是的……",
    "voice": "vo_adv_1012007_049",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n我明明打算一個人努力的！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我明明不希望你來的！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "……但是，既然這樣，就絕對要成功喔！",
    "voice": "vo_adv_1012007_050",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "一起努力吧！",
    "voice": "vo_adv_1012007_051",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "要上囉，嘿――噫！！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "……成、成功了……成功了啊！",
    "voice": "vo_adv_1012007_052",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "隕石被破壞了～！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n多虧了你喔☆",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "太好了～，成功保護了大家的城鎮呢♪",
