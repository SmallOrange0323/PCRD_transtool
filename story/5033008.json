[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "接受街上人們的聲援，從絕望的險境中復活的",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n魔法偵探Misty★霞、魔法獵人Purely★栞。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n因為兩位魔法少女的力量，蘭德索爾再次恢復了和平。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在那之後，又過了一段時間——",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "嗯。",
    "voice": "vo_adv_5033008_000",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "今天街上也沒有異常呢。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n從那之後已經過了好幾天，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "看起來危機真的解除了呢。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "之前幾乎每天都會出現的反逆獸，",
    "voice": "vo_adv_5033008_001",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n沒想到會這樣突然就消失不見呢。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "嗯，",
    "voice": "vo_adv_5033008_002",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "畢竟源頭已經被切斷了呢。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "如果還繼續出現的話會很困擾呢。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "……靜流小姐",
    "voice": "vo_adv_5033008_003",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "她已經沒有那時候的",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n記憶了吧？",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "嗯。",
    "voice": "vo_adv_5033008_004",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "原本想問她",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n和反逆獸相遇時的事情之類的呢……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n助手先生，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "她的狀況怎麼樣了呢？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "會想起她衝向{0}",
    "voice": "vo_adv_5033008_005",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "的樣子呢……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "唉呀唉呀。",
    "voice": "vo_adv_5033008_006",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n也已經觀察好幾天了，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這樣可以算是正式——",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "解除職務了呢。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "……摩拉",
    "voice": "vo_adv_5033008_007",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "到底跑去哪裡了呢。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "……",
    "voice": "vo_adv_5033008_008",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "牠跑到哪裡去都不重要了。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n打倒了反逆獸，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "代表摩拉的使命也已經完成了吧。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "就算是這樣……",
    "voice": "vo_adv_5033008_009",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "也不用這樣默默走掉吧。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "明明都還沒有好好道別……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我不覺得有什麼問題喔。",
    "voice": "vo_adv_5033008_010",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "不如說因為可以不用再打扮成那樣了，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "讓我鬆一口氣了呢。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "助、",
    "voice": "vo_adv_5033008_011",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "助手先生！？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n我才沒有",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "說過那種話喔！？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "呵呵。",
    "voice": "vo_adv_5033008_012",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "霞明明是名偵探，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n卻很不擅長撒謊呢。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "真是的，",
    "voice": "vo_adv_5033008_013",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "你們兩個！",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n不要再捉弄我了！",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "可是，",
    "voice": "vo_adv_5033008_014",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我覺得……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "很落寞呢。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n不管是摩拉走掉的事情……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n還是我們",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "已經沒辦法變身成魔法少女的事情。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "……我、",
    "voice": "vo_adv_5033008_015",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我也很難過，",
    "voice": "vo_adv_5033008_016",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這種話",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我說不出口啊……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "啊。",
    "voice": "vo_adv_5033008_017",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "是這附近對吧。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n第一次跟摩拉見面的地方……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "嗯，",
    "voice": "vo_adv_5033008_018",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "沒錯呢。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n我記得是在這附近",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "聽到了聲音……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "喂～",
    "voice": "vo_adv_5033008_019",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "有誰在嗎～",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "沒錯沒錯，",
    "voice": "vo_adv_5033008_020",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "就像這樣。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "然後我就這麼說了：",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "「嗯？　",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "妳有沒有聽到什麼聲音？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "栞」",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "誰來～",
    "voice": "vo_adv_5033008_021",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "救救我啊～",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "對，",
    "voice": "vo_adv_5033008_022",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "就像這樣呢。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "然後我好像是回妳",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "「是的。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "好像有人在叫我們的樣子……」",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "這樣",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "吧……？",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "喂～",
    "voice": "vo_adv_5033008_023",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "小霞、",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "小栞、",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "騎士大人！",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n不要在那邊聊天，快點來救救我啦！",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "摩拉！？",
    "voice": "vo_adv_5033008_024",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "摩拉！？",
    "voice": "vo_adv_5033008_025",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "嗨大家，",
    "voice": "vo_adv_5033008_026",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "好久不見啊！",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "最近還好嗎？",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "最近還好嗎，",
    "voice": "vo_adv_5033008_027",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "才——",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "才不是問什麼「最近還好嗎？」",
    "voice": "vo_adv_5033008_028",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "的時候吧！",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n讓人留下那麼難為情的回憶，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n卻突然消失不見，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "你到底是什麼意思啊！　",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我才不聽你解釋！",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "哇哇哇！？　",
    "voice": "vo_adv_5033008_029",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "小霞",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "超級生氣的！？",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "對、",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "對不起！　",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "可是，",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "我有必須要趕時間的原因！",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "……有原因",
