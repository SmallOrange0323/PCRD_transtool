  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就知道妳會這麼說……",
    "voice": "vo_adv_9067156_002",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我才不要！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n至少讓我吃正常的飯啦！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "真是的，",
