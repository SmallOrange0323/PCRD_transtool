[
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "得手了！",
    "voice": "vo_adv_5111203_000",
    "unit_id": 125011
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "打倒他了吧！",
    "voice": null,
    "unit_id": 125011
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不對，",
    "voice": "vo_adv_5111203_001",
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "他的氣息還沒消失……",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "那傢伙，",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "還想繼續打。",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那邊",
    "voice": "vo_adv_5111203_002",
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "的確傳來了很強大的氣息。",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……只能",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "去看看了。",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "嗚哇～",
    "voice": "vo_adv_5111203_003",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "真不想過去，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "接下來可以交給你們就好嗎？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "喂，",
    "voice": "vo_adv_5111203_004",
    "unit_id": 125011
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "尾狗刀！",
    "voice": null,
    "unit_id": 125011
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "別這麼客氣！",
    "voice": null,
    "unit_id": 125011
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 125011
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這可是久違地搭檔作戰，",
    "voice": null,
    "unit_id": 125011
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "讓我們盡情大鬧吧！",
    "voice": null,
    "unit_id": 125011
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "唉，",
    "voice": "vo_adv_5111203_005",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "真會使喚人，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "不過我已經司空見慣了。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "好吧，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "我奉陪，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "我奉陪到底就是了。",
    "voice": null,
    "unit_id": 106211
  }
]
