[
  {
    "type": "background",
    "bg_id": "500020"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}遇見心情很好的初音。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "啦啦啦～♪",
    "voice": "vo_adv_1012003_000",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n小～栞，我馬上就過去，等我一下喔～☆",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "哎呀呀？ ",
    "voice": "vo_adv_1012003_001",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "還以為是誰，原來是你！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "真是巧遇！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "咦？ 我看起來心情很好？",
    "voice": "vo_adv_1012003_002",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "欸嘿嘿～果然看得出來呀～",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "其實，我接下來要去牧場找我妹妹！",
    "voice": "vo_adv_1012003_003",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "因為很久沒見了，我現在很興奮呢～！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "她叫小栞，是非常可愛的妹妹♪",
    "voice": "vo_adv_1012003_004",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n真想快點見到她呢～！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "咦？",
    "voice": "vo_adv_1012003_005",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n你也有事要去牧場？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "那麼，一起去吧――",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "啊，你腳邊很危險喔！",
    "voice": "vo_adv_1012003_006",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n有水坑……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "啊，跌倒了……",
    "voice": "vo_adv_1012003_007",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n因為有泥濘，變得容易滑倒呢。",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n你沒事吧？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "若在平時我也許能用超能力幫你……",
    "voice": "vo_adv_1012003_008",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "但是，今天不行不行！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "若使用超能力後睡著的話，",
    "voice": "vo_adv_1012003_009",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n就沒辦法和小栞見面了！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "今天就算你陷入危險，我也做不了什麼，所以要小心喔～",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "那麼，出發前往牧～場！",
    "voice": "vo_adv_1012003_010",
    "unit_id": 101211
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "嗚哇啊啊啊啊！",
    "voice": "vo_adv_1012003_011",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "\\n好可怕啊！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "孩子被狗嚇壞了！？ 我必須救他！",
    "voice": "vo_adv_1012003_012",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "啊……但是不能使用超能力……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "你被狗咬了！",
    "voice": "vo_adv_1012003_013",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "沒、沒事吧！？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n快點治療……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "嗚哇啊啊！ 救救我！",
    "voice": "vo_adv_1012003_014",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "這次是被貓追的人……",
    "voice": "vo_adv_1012003_015",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "呃，貓！？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n他怕貓啊？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "貓",
    "words": "呼咻―――！",
    "voice": null,
    "unit_id": 1711
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "這次是被貓抓傷了！",
    "voice": "vo_adv_1012003_016",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n不、不要緊吧！？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "無賴（小）",
    "words": "嗚喔喔喔喔！ ",
    "voice": "vo_adv_1012003_017",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴（小）",
    "words": "誰、誰來救我―――！！！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "鸚鵡",
    "words": "啾啾啾～♪",
    "voice": null,
    "unit_id": 1911
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "這、這次是被鸚鵡追的人……呃，",
    "voice": "vo_adv_1012003_018",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "咦咦！？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "鸚鵡",
    "words": "啾――――！",
    "voice": null,
    "unit_id": 1911
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "你、你被鸚鵡啄了！",
    "voice": "vo_adv_1012003_019",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "無賴（大）",
    "words": "喂，搞啥啊！ 想打架嗎！？",
    "voice": "vo_adv_1012003_020",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "哇哇！ 這次又是什麼！？",
    "voice": "vo_adv_1012003_021",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "藉口就留到監獄再聽吧！",
    "voice": "vo_adv_1012003_022",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n跟我走吧！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "無賴（大）",
    "words": "有本事的話，就來硬的試試啊！",
    "voice": "vo_adv_1012003_023",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無賴（大）",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無賴（大）",
    "words": "放馬過來！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "可、可怕的人和騎士團的人正在爭執……？",
    "voice": "vo_adv_1012003_024",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "雖然想幫忙……可是不能使用超能力……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "無賴（大）",
    "words": "嗚哇！",
    "voice": "vo_adv_1012003_025",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無賴（大）",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無賴（大）",
    "words": "你這傢伙在做什麼！ 放開我！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "喔，",
    "voice": "vo_adv_1012003_026",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "感謝你的幫忙！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n再幫我壓制這傢伙一下！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n我馬上綁住他的手腳！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "無賴（大）",
    "words": "可惡！",
    "voice": "vo_adv_1012003_027",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無賴（大）",
    "words": "\\n不要妨礙我！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嗚哇～",
    "voice": "vo_adv_1012003_028",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "你好嚴重呢……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "background",
    "bg_id": "500130"
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "你受了不少傷呢……",
    "voice": "vo_adv_1012003_029",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n還會痛嗎？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我其實也很想幫忙，",
    "voice": "vo_adv_1012003_030",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n但是若使用超能力，就會變得想睡……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "但是，你好厲害呢。",
    "voice": "vo_adv_1012003_031",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "明明沒有超能力，卻馬上去幫忙……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我太感動了啊～！",
    "voice": "vo_adv_1012003_032",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "該怎麼說呢，非常――",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "噫欸欸欸！",
    "voice": "vo_adv_1012003_033",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "\\n來人啊――！",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──呱歐歐歐歐歐",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "啊啊！ 魔物正在襲擊老爺爺！？",
    "voice": "vo_adv_1012003_034",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "喂――！ 住手！！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "壞魔物就用超能力來打跑！",
    "voice": "vo_adv_1012003_035",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n嘿──噫！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "好了！ 這樣就解決了喔！",
    "voice": "vo_adv_1012003_036",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "……啊！",
    "voice": "vo_adv_1012003_037",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "果然還是無法置之不理，而使用了……超能力……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n怎麼辦……變得好想睡……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "呼嚕！",
    "voice": "vo_adv_1012003_038",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "呼嚕呼嚕……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "呼嚕呼嚕……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "background",
    "bg_id": "500151"
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嗯～！",
    "voice": "vo_adv_1012003_039",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": " 睡得好飽～！！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "呃，不行不行！ 不能睡著啊！",
    "voice": "vo_adv_1012003_040",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "怎怎怎、怎麼辦！？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n天色已經暗了，見不到小栞了！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "……咦？ 這裡是牧場？",
    "voice": "vo_adv_1012003_041",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嗚哇！ ",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n為什麼你會揹著我！？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "咦……因為我睡著了，所以你揹著我來這裡嗎？",
    "voice": "vo_adv_1012003_042",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "這、這樣啊……",
    "voice": "vo_adv_1012003_043",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "欸嘿嘿～，謝謝！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "那麼，到小栞那裡還有一小段路，",
    "voice": "vo_adv_1012003_044",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n所以就麻煩你揹我到那裡吧♪",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "欸～！ 小氣──！",
    "voice": "vo_adv_1012003_045",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n再揹一下就好了嘛──！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "好了好了，出──發！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "哇～，謝謝♪",
    "voice": "vo_adv_1012003_046",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "欸嘿嘿，你的背好溫暖呢。",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "still",
    "still_id": "101200301"
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "小――栞！",
    "voice": "vo_adv_1012003_047",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n我來找妳了喔！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "姊姊……妳來了啊？",
    "voice": "vo_adv_1012003_048",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n謝謝！",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "好久不見了呢！",
    "voice": "vo_adv_1012003_049",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n我好開心～☆",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嗯！ 姐姐也很開心喔！",
    "voice": "vo_adv_1012003_050",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "但是，我原本也不曉得今天能不能來呢……",
    "voice": "vo_adv_1012003_051",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n因為途中我使用了超能力而睡著了。",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n多虧了他帶我來喔！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "小栞，小栞！",
    "voice": "vo_adv_1012003_052",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n他很厲害喔！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n他總是不斷幫助我♪",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "這樣啊……",
    "voice": "vo_adv_1012003_053",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n謝謝你。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n連姊姊也給你添麻煩了呢……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "…………嗯嗯嗯？",
    "voice": "vo_adv_1012003_054",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "咦？ 什麼什麼！？",
    "voice": "vo_adv_1012003_055",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n你們兩人認識嗎！？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "嗯。",
    "voice": "vo_adv_1012003_056",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n我也總是受到",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n這個人的許多幫忙。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "…………呣～！",
    "voice": "vo_adv_1012003_057",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": " 總覺得無法接受！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "接受……？",
    "voice": "vo_adv_1012003_058",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "姊姊，妳怎麼了？",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我、我不知道！",
    "voice": "vo_adv_1012003_059",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "總之我覺得心情鬱悶！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n你這個笨蛋～！",
    "voice": null,
    "unit_id": 101211
  }
]
