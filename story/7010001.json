[
  {
    "type": "background",
    "bg_id": "500430"
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀，",
    "voice": "vo_adv_7010001_000",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "原來裡面是長這樣呢～",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "慢慢來沒關係，",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "注意腳邊小心前進吧～",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "{0}，四周有點黑，不要緊吧？　",
    "voice": "vo_adv_7010001_001",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "沒事吧？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "為了讓你不要害怕，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我會待在你身邊的。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "呵呵，",
    "voice": "vo_adv_7010001_002",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "你和伊緒老師的感情還真好呢。",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "{0}",
    "voice": "vo_adv_7010001_003",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "竟然會直接叫伊緒，",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n比起老師和學生，",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "更像是朋友的關係呢～",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我啊，",
    "voice": "vo_adv_7010001_004",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "作為師長還有很多要學習的地方，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "希望能和學生們一起成長，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n在像朋友一樣",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "良好的關係下學習各式各樣的事物。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "正因為這樣",
    "voice": "vo_adv_7010001_005",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "才會讓學生們",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n直接叫我伊緒的。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "當然，",
    "voice": "vo_adv_7010001_006",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "在該認真的時候，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n作為大人",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "還是得做好模範才行。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀，",
    "voice": "vo_adv_7010001_007",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "真是了不起的想法呢～！",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我也是，",
    "voice": "vo_adv_7010001_008",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "為了成為對孩子們而言的好老師，",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n首先",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "得作為一名優秀的大人，",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "總是這樣提醒自己呢。",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "美里老師也這麼想，真令人開心。",
    "voice": "vo_adv_7010001_009",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "那麼，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "今天請多多指教了。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "還不知道會遇上什麼狀況，",
    "voice": "vo_adv_7010001_010",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "小心一點",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "千萬不要受傷了唷～！",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "――咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀，",
    "voice": "vo_adv_7010001_011",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "魔物呢～",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "不用擔心呦～",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "呀，",
    "voice": "vo_adv_7010001_012",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "魔物？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "真有精神呢～",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "被我們嚇到才跑出來的嗎？",
    "voice": "vo_adv_7010001_013",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "嚇到你真的很抱歉。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "——咕嗚嗚嗚……♪",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "好乖好乖，",
    "voice": "vo_adv_7010001_014",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "乖孩子",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "乖孩子……",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n放心吧，",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "已經沒事了。",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "——咕嗚♪",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "要保重喔～！",
    "voice": "vo_adv_7010001_015",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "呵呵，",
    "voice": "vo_adv_7010001_016",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "本來因為太黑有點害怕的，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n跟可愛的魔物玩了一下心情舒服多了！",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀哎呀～",
    "voice": "vo_adv_7010001_017",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n看來今天這趟會是愉快的散步呢～",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "當然",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "不要把最重要的目的",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "也給忘記了喔？",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "還在說那種話嗎？　",
    "voice": "vo_adv_7010001_018",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "好了快點開始走吧？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n不要脫隊，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "好好跟緊喔。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "但是，",
    "voice": "vo_adv_7010001_019",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "累了的話一定要跟老師說喔？",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n千萬不能逞強喔。",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀～",
    "voice": "vo_adv_7010001_020",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "有氣無力的呢～",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "已經累了嗎？",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "這可不行呢。",
    "voice": "vo_adv_7010001_021",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "才剛開始走呢。",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "{0}應該能做得更好才對吧？",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "很棒的答覆呢～！　",
    "voice": "vo_adv_7010001_022",
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "好棒好棒♪",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "嗯！　",
    "voice": "vo_adv_7010001_023",
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "照這股氣勢加油吧～！",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "走吧，",
    "voice": null,
    "unit_id": 101811
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "好好跟著老師們～！",
    "voice": null,
    "unit_id": 101811
  }
]
