  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "哎呀……",
    "voice": "vo_adv_9500078_000",
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "你的意思",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "是要選我嗎？",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "騎士。",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "並非玩笑話，",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "也不是「扮家家酒」，",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n而是要",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "對我",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "立下真愛的誓言、",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "嗎……？",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "──怎麼會這樣呢？",
    "voice": "vo_adv_9500078_001",
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n身為非人之物",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "的我？",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "竟然能與",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "人類之子一同作戰，",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "建立起羈絆……",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "嗯，",
    "voice": "vo_adv_9500078_002",
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "有一點……",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "本來應該很開心……",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我現在",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "卻覺得恐懼。",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "好像快要沉溺在",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "你的心意、",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "自己的心情中。",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……我過去對",
    "voice": "vo_adv_9500078_003",
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "人的醜陋、",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "殘酷感到絕望……",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "才離開地面。",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n我堅定地",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "想著……",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "自己不會",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "再相信任何人了。",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "即使過了段時間，",
    "voice": "vo_adv_9500078_004",
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "那份絕望如今也沒有消失。",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n只要想到，",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "萬一你的心意只是假象……",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我就怕得",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "不得了。",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "可是……",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "可是……",
    "voice": "vo_adv_9500078_005",
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "那份歡喜",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "卻壓過了恐懼，",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "貫穿了我的全身。",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "這幾乎令人喜極而泣的喜悅",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "──如同花朵綻放般的心意，",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "正滿溢而出、無法遏止。",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "這就是",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "真正的「愛」嗎……？",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……當然願意，",
    "voice": "vo_adv_9500078_006",
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "騎士。",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我也來",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "回應你這份心意吧。",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "請讓我發誓",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "──我會永遠，",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "與你同在。",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……",
    "voice": "vo_adv_9500078_007",
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "然後、",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "就是……",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "說到誓言、",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "這部分。",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我想用這具身軀，",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "體會所謂人類的愛……",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "是、",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "是不是很不知羞恥？",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "…………",
    "voice": "vo_adv_9500078_008",
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "只有這一瞬間，",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "將夜幕……",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……哎……♪",
    "voice": "vo_adv_9500078_009",
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……已經",
    "voice": "vo_adv_9500078_010",
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "沒有何事可以令我恐懼。",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n騎士",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……不，",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "「親愛的」。",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n讓我們贏得勝利，",
    "voice": null,
    "unit_id": 126541
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "成為真正的夫妻吧──",
    "voice": null,
    "unit_id": 126541
  },
