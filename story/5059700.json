[
  {
    "type": "background",
    "bg_id": "500850"
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "【ドラゴンズネスト】の3人はふたたびエルピス島の密林にある、\\nドラゴンもどきの住む遺跡を訪れていた。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "お～い、",
    "voice": "vo_adv_5027700_000",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "いるですか～？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "出てくるですよ～！　",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "お土産もあるですから～！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "土産って",
    "voice": "vo_adv_5027700_001",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "なに持って来たんだ？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "お菓子ですよ！",
    "voice": "vo_adv_5027700_002",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\nきっと気に入るです！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "そういえば",
    "voice": "vo_adv_5027700_003",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "アイツが最初に襲撃してきた時、",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "\\nキャンプからチョコがごそっとなくなってたな……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "イノリちゃん。",
    "voice": "vo_adv_5027700_004",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "\\nあそこでこっちの様子見てるよ？",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "じゃあ",
    "voice": "vo_adv_5027700_005",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "さっさと引っ張り出そうぜ。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "待つですよカヤぴぃ！",
    "voice": "vo_adv_5027700_006",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\nカヤぴぃにボコボコにされてビビってやがるです。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "大丈夫ですよ～、",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "こわくないですよ～……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "ドラゴンもどき",
    "words": "ぐもも……",
    "voice": "vo_adv_5027700_007",
    "unit_id": 12311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "こっちくるです！",
    "voice": "vo_adv_5027700_008",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\nおいしいチョコもあるですよ～！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "お、",
    "voice": "vo_adv_5027700_009",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "来た来た。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "\\n見た目通り食い意地はってるな……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "さっそく話聞いてみようぜ。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "ふむふむ……",
    "voice": "vo_adv_5027700_010",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\n……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "ドラゴンが、",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "うらやましかったんですね。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "コイツ……",
    "voice": "vo_adv_5027700_011",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "ドラゴンになりたくてこういう格好してたですよ。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "やっぱり言ってることが分かるみたいだな。",
    "voice": "vo_adv_5027700_012",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "なんとなくですけど……",
    "voice": "vo_adv_5027700_013",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "あたしたちのキャンプに来たのも、",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "ドラゴンの気配を感じたから",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\nみたいなこと言ってるですよ。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "確かに話は通じてるみたいだね。",
    "voice": "vo_adv_5027700_014",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "それで、",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "遺跡のことは何て？",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "……むむぅ、",
    "voice": "vo_adv_5027700_015",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "なんか言いたいことは分かるですけど",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\n細かいところがはっきりしないというか……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "うう～！　",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "分からないですよ！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "なんだそりゃ？",
    "voice": "vo_adv_5027700_016",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "感情は伝わっても",
    "voice": "vo_adv_5027700_017",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "具体的なことは言語化できない、",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "ってことかな。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "細かい聞き取りは無理そうだね～",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "ボスにも何言ってる分かんないんだよな？",
    "voice": "vo_adv_5027700_018",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "なんでイノリにだけ分かるんだ？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "そもそもの相性",
    "voice": "vo_adv_5027700_019",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "ってのもあると思うけど～",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "やっぱり",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "知能の程度が近い",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "ってことなんだと思うな〜☆",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "そっか……",
    "voice": "vo_adv_5027700_020",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "こいつもかなりのマヌケってことか。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "かわいそうに……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "カヤぴぃ！？　",
    "voice": "vo_adv_5027700_021",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "今とっても失礼なこと言ったです！？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "だってさあ、",
    "voice": "vo_adv_5027700_022",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "結局何の役にも立たないってことだろ？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "わざわざ二回来てダメだったとか……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "はぁ……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "あううぅ！　",
    "voice": "vo_adv_5027700_023",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "ま、",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "待つですよ！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\nこいつは役立たずなんかじゃないです！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "そうだ、",
    "voice": "vo_adv_5027700_024",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "教えるですよ！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "言葉を教えればきっと聞き出せるです！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "できるのかぁ？",
    "voice": "vo_adv_5027700_025",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "\\nこいつ見た目からして相当バカそうだぞ？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "ちょうどいいし、",
    "voice": "vo_adv_5027700_026",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "この石板を使ったらどうかな〜？",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "\\n物の名前や概念を",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "ゆっくり教えていけば、",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "\\nもしかしたら",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "私たちとも会話できるかも〜",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "それです！",
    "voice": "vo_adv_5027700_027",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\nこれでカヤぴぃより頭がいいことを",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "見せつけてやるですよ！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "いやいやいや、",
    "voice": "vo_adv_5027700_028",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "さすがにそれはないって。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "そうと決まればまずは名前です。",
    "voice": "vo_adv_5027700_029",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\nあたしがゴッドマザーになってやるですよ。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "ドラゴンもどき……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "ドラモ！　",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "おまえの名前はドラモです！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "ドラモ",
    "words": "ぐももも！",
    "voice": "vo_adv_5027700_030",
    "unit_id": 12311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "ふふふ、",
    "voice": "vo_adv_5027700_031",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "そうですか、",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "気に入ったですか……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "カヤぴぃ！　",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "首を洗って待ってるですよ！！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "へいへい、",
    "voice": "vo_adv_5027700_032",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "分かったよ。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "せいぜいがんばんな。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "background",
    "bg_id": "500520"
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "そして、イノリによるドラゴンもどきの教育が始まった。\\n時に厳しく、時に熱く……\\n主にチョコで釣るイノリの教育は続き……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500850"
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "ふふ、",
