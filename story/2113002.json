        "words": "確實，",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "「無名士兵」和",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "「天使」們……",
        "voice": null
    },
    {
        "name": "彌勒",
