    },
    {
        "name": "彌勒",
        "words": "意思？",
        "voice": null
    },
    {
        "name": "尾狗刀",
        "words": "咦？",
        "voice": "vo_adv_2113002_005"
    },
    {
        "name": "尾狗刀",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "尾狗刀",
        "words": "你想想嘛，",
        "voice": null
    },
    {
        "name": "尾狗刀",
        "words": "變貌大妃和誓約女君",
        "voice": null
    },
    {
        "name": "尾狗刀",
        "words": "被搶回去了──",
        "voice": null
    },
    {
        "name": "尾狗刀",
        "words": "\\n美空也意志消沉幹勁全無不是嗎──？",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "變貌大妃和誓約女君",
        "voice": "vo_adv_2113002_006"
    },
    {
        "name": "彌勒",
        "words": "本來就只是不可靠的工具。",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "如果她們跟迷宮女王兩敗俱傷，",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "\\n那也是個毫無損失的交易吧。",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "至於美空小姐，",
        "voice": "vo_adv_2113002_007"
    },
