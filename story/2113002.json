        "words": "我之前也說過了吧？",
        "voice": "vo_adv_2113002_010"
    },
    {
        "name": "彌勒",
        "words": "\\n我們本來就不是",
        "voice": null
    },
    {
        "name": "彌勒",
        "words": "什麼感情深厚的集團。",
        "voice": null
    },
    {
        "name": "彌勒",
