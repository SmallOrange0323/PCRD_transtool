        "words": "可能是",
        "voice": "vo_adv_2113002_002"
    },
    {
        "name": "尾狗刀",
        "words": "太急於立功了吧──",
        "voice": null
    },
    {
        "name": "尾狗刀",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "尾狗刀",
        "words": "「使徒」也連帶被幹掉了，",
        "voice": null
    },
    {
        "name": "尾狗刀",
        "words": "唉～我認輸了認輸了──",
        "voice": null
    },
    {
        "name": "尾狗刀",
        "words": "……不過啊──？",
        "voice": "vo_adv_2113002_003"
    },
    {
        "name": "尾狗刀",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "尾狗刀",
        "words": "才幾天不見的工夫，",
        "voice": null
    },
    {
        "name": "尾狗刀",
        "words": "\\n除了我之外，其他人也都慘兮兮的不是嗎──？",
