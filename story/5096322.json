[
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這是",
    "voice": "vo_adv_5096322_000",
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我們嗎……！？",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n以水棲魔物而言，",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "出的招式還真奇怪呢。",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "怜，可是妳看！",
    "voice": "vo_adv_5096322_001",
    "unit_id": 122411
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n對面穿的是平常的衣服，",
    "voice": null,
    "unit_id": 122411
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "不過我們現在穿的可是泳衣耶！",
    "voice": null,
    "unit_id": 122411
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是啊……",
    "voice": "vo_adv_5096322_002",
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "但那個情報",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "和現在有關係嗎？",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "有呀──！",
    "voice": "vo_adv_5096322_003",
    "unit_id": 122411
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "肯定是我們比較強！",
    "voice": null,
    "unit_id": 122411
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n因為這裡是海邊，",
    "voice": null,
    "unit_id": 122411
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "就是要穿泳衣嘛！",
    "voice": null,
    "unit_id": 122411
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……為什麼呢……",
    "voice": "vo_adv_5096322_004",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n居然感覺很有說服力……！",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那是因為妳被氣勢給蒙混過去了喔，",
    "voice": "vo_adv_5096322_005",
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "優衣。",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……不過呢，",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "妳說我們比較強這件事，",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我當然是同意的。",
    "voice": null,
    "unit_id": 122511
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "來來來，優衣、",
    "voice": "vo_adv_5096322_006",
    "unit_id": 122411
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "怜！",
    "voice": null,
    "unit_id": 122411
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n讓牠徹底見識一下",
    "voice": null,
    "unit_id": 122411
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我們真正的力量吧──！",
    "voice": null,
    "unit_id": 122411
  }
]
