  {
    "type": "dialogue",
    "name": "旁白",
    "words": "美里跟{0}繼續在沙灘上散步。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "啊，",
    "voice": "vo_adv_1135002_000",
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "那裡",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "聚集了很多人呢。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n看起來好熱鬧。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "現在正在舉辦沙灘棒球活動！",
    "voice": "vo_adv_1135002_001",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "\\n請大家踴躍參加！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哇，",
    "voice": "vo_adv_1135002_002",
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "居然還有這樣的活動。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "其他還有全壘打大賽、",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "沙灘搶旗，",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "跟擲遠比賽呢。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "……他們看起來好開心。",
    "voice": "vo_adv_1135002_003",
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我、",
    "voice": "vo_adv_1135002_004",
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我有露出想參加的表情嗎？",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "……",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "其實我平常看大家練習的時候，",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n就有點想嘗試看看。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "可是，",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "當大家都在認真練習時，",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我也不好說出那種話呢。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "所以，",
    "voice": "vo_adv_1135002_005",
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "難得有這個機會，",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我想試試看。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "而且，",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "要是身為顧問",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "卻沒揮過棒的話，",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n會有點不好意思。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "達令～！",
    "voice": "vo_adv_1135002_006",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "你要展現帥氣的一面喔～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "好，",
    "voice": "vo_adv_1135002_007",
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "交給我吧，甜心！",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "咦？",
    "voice": "vo_adv_1135002_008",
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n我居然揮空了！？",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "討厭，",
    "voice": "vo_adv_1135002_009",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "達令你振作一點啦～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "好，",
    "voice": "vo_adv_1135002_010",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "接下來換我了。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "看好了，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "別看爸爸這樣，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "爸爸可是曾經參加過全國大賽的。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "好厲害～！",
    "voice": "vo_adv_1135002_011",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "爸爸加油！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "哼！",
    "voice": "vo_adv_1135002_012",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "喔喔，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "這棒打得不錯……！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀呀，",
    "voice": "vo_adv_1135002_013",
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "男性參加者果然很多呢。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我參加的話",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "沒問題嗎？",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "呵呵呵，",
    "voice": "vo_adv_1135002_014",
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "說得也是。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "畢竟是我自己說想試的。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n要是現在退縮的話，",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "就沒資格當老師了。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "那麼，",
    "voice": "vo_adv_1135002_015",
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "你要看好囉。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "老師我",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "要上場加油了！",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "大家好！",
    "voice": "vo_adv_1135002_016",
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n我叫美里。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "請多多指教！",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "投手",
    "words": "咦，",
    "voice": "vo_adv_1135002_017",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "投手",
    "words": "那麼可愛的女性要參加？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "投手",
    "words": "\\n動作一看就知道是外行人，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "投手",
    "words": "就投個好打的球──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "投手",
    "words": "不，",
    "voice": "vo_adv_1135002_018",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "投手",
    "words": "她的眼神非常認真。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "投手",
    "words": "\\n她是帶著決心站上打擊區的。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "投手",
    "words": "\\n要是放水就太失禮了……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "投手",
    "words": "我會認真投！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "嘿！",
    "voice": "vo_adv_1135002_019",
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "裁判",
    "words": "一好球！",
    "voice": "vo_adv_1135002_020",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "呵呵呵，",
    "voice": "vo_adv_1135002_021",
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "完全沒打到球呢。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "希望這次能勉強打中。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "嘿！",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "裁判",
    "words": "兩好球！",
    "voice": "vo_adv_1135002_022",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "唉呀呀，",
    "voice": "vo_adv_1135002_023",
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "又揮空了。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "大家平時",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "都是打那麼快的球呢……",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "真是太厲害了。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "喂，",
    "voice": "vo_adv_1135002_024",
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "那位大姐……",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n雖然不曉得她有什麼理由，",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "但她是認真的吧？",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "是啊，",
    "voice": "vo_adv_1135002_025",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "投手也是知道那點，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "父親",
    "words": "\\n才會盡全力在投。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "嘿！",
    "voice": "vo_adv_1135002_026",
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "裁判",
    "words": "三好球！",
    "voice": "vo_adv_1135002_027",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "裁判",
    "words": "打者出局！",
