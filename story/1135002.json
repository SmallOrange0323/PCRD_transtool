    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "唉呀呀，",
    "voice": "vo_adv_1135002_028",
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我居然連一次都沒打中。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "三球就出局了。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "擊球真的很難呢……",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我站上打擊區",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "才知道。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "呵呵，",
    "voice": "vo_adv_1135002_029",
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "不過",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "實際試一次後，",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "真的非常有趣。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "大姐，",
    "voice": "vo_adv_1135002_030",
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "妳對沙灘棒球有興趣嗎？",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "不嫌棄的話，由我來",
