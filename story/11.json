[
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "可惡……！",
    "voice": "vo_adv_0000011_000",
    "unit_id": 100012
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n竟然還殘留著這樣的力量嗎……！",
    "voice": null,
    "unit_id": 100012
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "公主騎士……",
    "voice": "vo_adv_0000011_001",
    "unit_id": 106913
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n沒想到你們竟然能撐到這裡……",
    "voice": null,
    "unit_id": 106913
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n但也到此為止了。",
    "voice": null,
    "unit_id": 106913
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "這一切……",
    "voice": null,
    "unit_id": 106913
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "就讓我將它畫下句點",
    "voice": null,
    "unit_id": 106913
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "別再打了好嗎……？",
    "voice": "vo_adv_0000011_002",
    "unit_id": 100112
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n即使繼續打下去，",
    "voice": null,
    "unit_id": 100112
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "也不會有什麼好結果呀！",
    "voice": null,
    "unit_id": 100112
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "要實現我的願望……",
    "voice": "vo_adv_0000011_003",
    "unit_id": 106913
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n為此不管要打多少次都行！",
    "voice": null,
    "unit_id": 106913
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "多少次我都不在乎！",
    "voice": null,
    "unit_id": 106913
  }
]
