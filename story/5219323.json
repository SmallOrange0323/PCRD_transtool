[
  {
    "type": "dialogue",
    "name": "班比",
    "words": "雖然完全不聽人家說，",
    "voice": "vo_adv_5219323_000",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n但這應該會是我最後一次",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "說",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "「不行」了♪",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "沒錯沒錯ｗ",
    "voice": "vo_adv_5219323_001",
    "unit_id": 140111
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n精彩畫面已經夠了，",
    "voice": null,
    "unit_id": 140111
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n所以趕快被打倒吧──♡",
    "voice": null,
    "unit_id": 140111
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "真是的，",
    "voice": "vo_adv_5219323_002",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "布武機就是",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "嘴巴很壞～",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n那孩子也是",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "拼命戰鬥到現在喔？",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "不，",
    "voice": "vo_adv_5219323_003",
    "unit_id": 140111
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "妳那種說法也很過分吧？",
    "voice": null,
    "unit_id": 140111
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n像是在說雜碎努力也沒用一樣？",
    "voice": null,
    "unit_id": 140111
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "是嗎？",
    "voice": "vo_adv_5219323_004",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "只是",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n好──好在稱讚努力的孩子喔♪",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "嗯～？",
    "voice": "vo_adv_5219323_005",
    "unit_id": 140111
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "班比，",
    "voice": null,
    "unit_id": 140111
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "妳是被誰影響了嗎？",
    "voice": null,
    "unit_id": 140111
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n算了，",
    "voice": null,
    "unit_id": 140111
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "無所謂♪",
    "voice": null,
    "unit_id": 140111
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 140111
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "那就",
    "voice": null,
    "unit_id": 140111
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "迅速解決掉吧，",
    "voice": null,
    "unit_id": 140111
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "超雜碎的海鮮♡",
    "voice": null,
    "unit_id": 140111
  }
]
