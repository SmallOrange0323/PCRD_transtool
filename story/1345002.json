    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "餐廳的女店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "餐廳的女店長",
    "words": "那麼，",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "餐廳的女店長",
    "words": "克蘿茜小姐的挑戰，",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "餐廳的女店長",
    "words": "請讓我一起幫忙吧。",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "好的，",
    "voice": "vo_adv_1345002_048",
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "那就麻煩妳了！",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n不知道會是什麼樣的飯菜，",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "吃了又會有什麼樣的感覺，",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n我現在就開始興奮起來了呢♪",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "餐廳的女店長",
    "words": "來，",
    "voice": "vo_adv_1345002_049",
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "餐廳的女店長",
    "words": "讓你們久等了。",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "餐廳的女店長",
    "words": "\\n這是今天的每日定食喔。",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "感應器啟動♪",
    "voice": "vo_adv_1345002_050",
    "unit_id": 134514
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "我看看，",
    "voice": null,
    "unit_id": 134514
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "是肉和白飯對吧！",
    "voice": null,
    "unit_id": 134514
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n表面溫度和內部溫度都很高，",
    "voice": null,
    "unit_id": 134514
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "好像熱騰騰的。",
    "voice": null,
    "unit_id": 134514
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n白飯看起來也充滿光澤，",
    "voice": null,
    "unit_id": 134514
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "而且還冒著熱氣呢。",
    "voice": null,
    "unit_id": 134514
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "騎士先生，",
    "voice": "vo_adv_1345002_051",
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "「看起來很好吃」",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "就是這種感覺啊！",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "我也要開動了！",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "啊呣……",
    "voice": "vo_adv_1345002_052",
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "餐廳的女店長",
    "words": "啊，",
    "voice": "vo_adv_1345002_053",
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "餐廳的女店長",
    "words": "那樣一口吞進去的話……",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "嗯嗯嗯……",
    "voice": "vo_adv_1345002_054",
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "內部感應器出現了強烈的反應！",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n我第一次感受到這種刺激！",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n……這就是「好吃」的感覺嗎？",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "奇怪……？",
    "voice": "vo_adv_1345002_055",
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n總覺得",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "肚子附近好像有個功能第一次啟動了。",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n食物裝進了袋子裡，",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "體內氣壓好像減少了一部分……",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "騎士先生，",
    "voice": "vo_adv_1345002_056",
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "「好吃」就是這種感覺嗎？",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n在騎士先生的體內，",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "也會有袋子打開、",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "壓力下降的現象嗎？",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "奇、",
    "voice": "vo_adv_1345002_057",
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "奇怪？",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "好像又有其他功能啟動了！",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n軀體的正中央部分打開了……！？",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "哇，",
    "voice": "vo_adv_1345002_058",
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "肚子上的門掉出了真空包裝！",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "剛才吃下的食物被完整地包裝起來了！",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "餐廳的女店長",
    "words": "好厲害！",
    "voice": "vo_adv_1345002_059",
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "餐廳的女店長",
    "words": "簡直就像在做便當一樣。",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "餐廳的女店長",
    "words": "\\n機械人族",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "餐廳的女店長",
    "words": "真的很不可思議呢……",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "原來有這種新功能呀～！",
    "voice": "vo_adv_1345002_060",
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "看來似乎還有很多我不知道的事！",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "……啊。",
    "voice": "vo_adv_1345002_061",
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "不過，",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "這樣",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "我有享受到餐點嗎？",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n雖然真空包裝帶來的刺激，",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "確實是全新的體驗……",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "但好像跟我看著【美食殿堂】的各位，",
    "voice": "vo_adv_1345002_062",
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n一直很嚮往，",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "覺得",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "「真好～」的感覺",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "不太一樣……",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "……嗯～",
    "voice": "vo_adv_1345002_063",
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "心裡",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "有一種堆積了重物的感覺。",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n不是食物，",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "而是另一種沉甸甸的壓迫感。",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n這到底是什麼呢……？",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "悲傷？",
    "voice": "vo_adv_1345002_064",
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n這就是",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "悲傷的感覺嗎？",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "我不具備流眼淚的機能，",
    "voice": "vo_adv_1345002_065",
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n所以不了解悲傷的感覺……",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n該不會，",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "這也算是一種成長吧？",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "真是這樣的話，",
    "voice": "vo_adv_1345002_066",
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "成長明明應該是很開心的事，",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n但胸口內側卻感覺沉甸甸的。",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n沒想到不只有開心，",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "還真是難懂呢……",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "騎士先生",
    "voice": "vo_adv_1345002_067",
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "也有體會過",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n像這樣",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "沉重的心情嗎？",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n那一定",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "很難受吧？",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "悲傷的感覺",
    "voice": "vo_adv_1345002_068",
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "就像一個大蛋糕一樣呢。",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n既然可以和騎士先生一起分享，",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n那我",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "就算感到悲傷也沒關係！",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "嘿嘿♪",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "因為是【美食殿堂】，",
    "voice": "vo_adv_1345002_069",
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "所以我本來想和大家一起吃飯，",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n但是不要緊♪",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "餐廳的女店長",
    "words": "就算沒辦法像大家一樣吃飯，",
    "voice": "vo_adv_1345002_070",
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "餐廳的女店長",
    "words": "\\n克蘿茜小姐和{0}",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "餐廳的女店長",
    "words": "\\n今天也還是一起用餐了喔。",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "是這樣嗎？",
    "voice": "vo_adv_1345002_071",
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "這麼說來，",
    "voice": "vo_adv_1345002_072",
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "我聽說【美食殿堂】是大家圍著餐桌吃飯，",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n一起品嚐美食的公會！",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "這樣的話，",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "我也達成了一半呢♪",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "雖然和大家有不一樣的地方……",
    "voice": "vo_adv_1345002_073",
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n但",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "我會和騎士先生一起吃飯，",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "所以也是",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "【美食殿堂】的一員吧！",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "……嘿嘿，",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "謝謝你們！",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "我打起精神了♪",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "感謝招待！",
    "voice": "vo_adv_1345002_074",
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n謝謝妳幫忙我",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "一起挑戰！",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "餐廳的女店長",
    "words": "只是粗茶淡飯而已。",
    "voice": "vo_adv_1345002_075",
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "餐廳的女店長",
    "words": "\\n看來我的料理",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "餐廳的女店長",
    "words": "似乎有好好變成「養分」呢。",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "餐廳的女店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "餐廳的女店長",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "餐廳的女店長",
    "words": "真是太好了……",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "原來如此♪",
    "voice": "vo_adv_1345002_076",
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "就算是長途冒險，只要有乾糧，",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n就不用太擔心能量耗盡吧！",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "那麼，",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "我要來做很多的包裝囉～♪",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "哇♪",
    "voice": "vo_adv_1345002_077",
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n我第一次吃的飯菜",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "可以讓騎士先生吃到呢！",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "你願意品嘗的話我會很開心的♪",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "透過在蘭德索爾的活動，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n克蘿茜又進一步確認了自身的成長。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n作為【美食殿堂】的臨時成員，",
    "voice": null,
