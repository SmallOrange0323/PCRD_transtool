    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "漫長的蘑菇狩獵也終於要進入尾聲了！",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "就讓我們痛扁牠一頓吧！",
    "voice": null,
    "unit_id": 122211
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "嗯，",
    "voice": "vo_adv_5094308_002",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "就在此分出勝負吧！",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n這也是為了奪回我們的團體露營時光！",
    "voice": null,
