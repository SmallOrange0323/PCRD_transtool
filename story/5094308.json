  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "和之前相較起來，魄力截然不同……！",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n看來對方也打算毫不保留地使出全力了。",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "各位，",
    "voice": null,
    "unit_id": 104715
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "千萬別大意。",
