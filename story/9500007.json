  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……！",
    "voice": "vo_adv_9500007_000",
    "unit_id": 100341
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100341
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "選我……",
    "voice": null,
    "unit_id": 100341
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "沒關係嗎？",
    "voice": null,
    "unit_id": 100341
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n真的嗎……？",
    "voice": null,
    "unit_id": 100341
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "但是，",
    "voice": "vo_adv_9500007_001",
    "unit_id": 100341
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這樣對優衣和日和……",
    "voice": null,
    "unit_id": 100341
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100341
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不，",
    "voice": null,
    "unit_id": 100341
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我們約定過了。",
    "voice": null,
    "unit_id": 100341
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n今後要平等地面對彼此，",
    "voice": null,
    "unit_id": 100341
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "無須顧慮。",
    "voice": null,
    "unit_id": 100341
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我一直祈禱著，",
    "voice": "vo_adv_9500007_002",
    "unit_id": 100341
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "希望能被你選擇。",
    "voice": null,
    "unit_id": 100341
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100341
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "沒想到竟然成真了……",
    "voice": null,
    "unit_id": 100341
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "啊啊真是的，",
    "voice": null,
    "unit_id": 100341
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n願望真的實現了，",
    "voice": null,
    "unit_id": 100341
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "反而會什麼話都說不出來呢……",
    "voice": null,
    "unit_id": 100341
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "老實說，",
    "voice": "vo_adv_9500007_003",
    "unit_id": 100341
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "要說沒有迷惘是騙人的。",
    "voice": null,
    "unit_id": 100341
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100341
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不只在這邊，",
    "voice": null,
    "unit_id": 100341
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n在那邊的世界，",
    "voice": null,
    "unit_id": 100341
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我也還是不自由的人。",
    "voice": null,
    "unit_id": 100341
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "即使如此……",
    "voice": "vo_adv_9500007_004",
    "unit_id": 100341
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "無論遇到什麼障礙，",
    "voice": null,
    "unit_id": 100341
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我都不會放棄。",
    "voice": null,
    "unit_id": 100341
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100341
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "希望能和你一起跨越難關。",
    "voice": null,
    "unit_id": 100341
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我現在可以挺起胸膛說，",
    "voice": "vo_adv_9500007_005",
    "unit_id": 100341
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n未來是能夠一點點被改變的。",
    "voice": null,
    "unit_id": 100341
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100341
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "但是──",
    "voice": null,
    "unit_id": 100341
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "但是，",
    "voice": "vo_adv_9500007_006",
    "unit_id": 100341
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "要是我承受不了不自由的生活，",
    "voice": null,
    "unit_id": 100341
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "到時候──",
    "voice": null,
    "unit_id": 100341
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100341
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你會和我一起逃跑吧？",
    "voice": null,
    "unit_id": 100341
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n就像那時我們一起跑過大江戶的街道一樣……♪",
    "voice": null,
    "unit_id": 100341
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "呵呵，",
    "voice": "vo_adv_9500007_007",
    "unit_id": 100341
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "謝謝。",
    "voice": null,
    "unit_id": 100341
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100341
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "能聽到你這麼說，",
    "voice": null,
    "unit_id": 100341
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我真的很幸福。",
    "voice": null,
    "unit_id": 100341
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "一起",
    "voice": "vo_adv_9500007_008",
    "unit_id": 100341
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "創造這個世界的……",
    "voice": null,
    "unit_id": 100341
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "創造我們兩人的未來吧。",
    "voice": null,
    "unit_id": 100341
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100341
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我",
    "voice": null,
    "unit_id": 100341
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "喜歡你，",
    "voice": null,
    "unit_id": 100341
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "{0}。",
    "voice": null,
    "unit_id": 100341
  }
]
