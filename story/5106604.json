[
  {
    "type": "background",
    "bg_id": "500580"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}和純在拉菲的帶領下，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n前往即將舉辦演唱會的廣場。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "哦，",
    "voice": "vo_adv_5106604_000",
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "那是小克莉絲擔任製作人的……",
    "voice": null,
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "是慈樂之音的各位吧。",
    "voice": null,
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "看來正在傷腦筋的人就是她們幾個呢。",
    "voice": "vo_adv_5106604_001",
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "如果是認識的人正好！",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n妳們好～！",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "那個，",
    "voice": "vo_adv_5106604_002",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "這個地方目前禁止相關人員以外的人出入……",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "咦，",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "騎士先生？",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "哇，",
    "voice": "vo_adv_5106604_003",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你來啦♪",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我好開心。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "咦？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這位是？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "啊，",
    "voice": "vo_adv_5106604_004",
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "失禮了。",
    "voice": null,
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我是【王宮騎士團】團長純。",
    "voice": null,
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n克莉絲平時承蒙幾位的關照了……",
    "voice": null,
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "咦！？",
    "voice": "vo_adv_5106604_005",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "妳是純小姐",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "嗎！？",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "不好意思，",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "因為妳穿得和平時不一樣，",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "所以沒認出來……",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我們才是受到了製作人的諸多關照。",
    "voice": "vo_adv_5106604_006",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "還有，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "【王宮騎士團】的各位也經常協助",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "會場警備……\\n真的",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "非常感謝你們。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "寒暄",
    "voice": "vo_adv_5106604_007",
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "差不多就夠了啦！",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "比起這個，妳們有什麼願望嗎？",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "啊，",
    "voice": "vo_adv_5106604_008",
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "抱歉抱歉。",
    "voice": null,
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這個女孩是天使拉菲。",
    "voice": null,
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n事情是這樣子的……",
    "voice": null,
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "然後",
    "voice": "vo_adv_5106604_009",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "大家就一起幫天使的忙呀。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我覺得很了不起哦。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "所以才來問我們有沒有願望……",
    "voice": "vo_adv_5106604_010",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "有是有啦。",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n我們有點煩惱",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "演唱會的演出效果……",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯……",
    "voice": "vo_adv_5106604_011",
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "小克莉絲怎麼說呢？",
    "voice": null,
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "製作人她",
    "voice": "vo_adv_5106604_012",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "正在處理別的事情……",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n她",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "去幫聖誕老人的忙了。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "照理來說，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我也應該去的……",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "但她說什麼",
    "voice": "vo_adv_5106604_013",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "「聖誕老人三人份的工作量我輕輕鬆鬆就能搞定！」",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n然後就自己去了。",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n的確很像她的作風啦……",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "那麼，",
    "voice": "vo_adv_5106604_014",
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "妳們是想幫",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "那位製作人的忙，",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n再把她帶回來嗎？",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "不，",
    "voice": "vo_adv_5106604_015",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我們完全不擔心她。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "倒是她",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "還會罵我們不要妨礙她呢。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "是啊。",
    "voice": "vo_adv_5106604_016",
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n小克莉絲一個人也不要緊的。",
    "voice": null,
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "反而是演唱會的演出效果",
    "voice": null,
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "更令人擔心吧？",
    "voice": null,
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "是的！",
    "voice": "vo_adv_5106604_017",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "雖然製作人沒有特別說什麼，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n但我覺得",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "演出效果可以再華麗一些……",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "嗯嗯……",
    "voice": "vo_adv_5106604_018",
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "那麼，",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "演唱會當天，",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n讓100名天使",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "從天界降臨怎麼樣？",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "不，",
    "voice": "vo_adv_5106604_019",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "不用做到那種程度……",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "我覺得很華麗很好呀？",
    "voice": "vo_adv_5106604_020",
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "嗯？",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "什麼？",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "你問我有沒有什麼天界的道具",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "嗎？",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n唔～",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "我也沒帶多少過來，",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "如果是這種的話……",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "這是……",
    "voice": "vo_adv_5106604_021",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "鈴鐺？",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "哇！",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "它對聲音有反應，",
    "voice": "vo_adv_5106604_022",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "所以發亮了……？",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "好美啊……",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "這個是天界的鈴鐺……",
    "voice": "vo_adv_5106604_023",
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n它只是會隨著聲音",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "發亮而已喔？",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "這種東西能派上用場嗎？",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "唔……",
    "voice": "vo_adv_5106604_024",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯！",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這個很棒！",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "用這個的話，不必更動舞台結構",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "也能讓演出效果變得更豪華！",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "這麼一來也有足夠的時間練習舞蹈了呢。",
    "voice": "vo_adv_5106604_025",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n既然這樣……",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯！",
    "voice": "vo_adv_5106604_026",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "千歌，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "妳之前提過要在育幼院辦聖誕演唱會的事，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n是不是有機會辦得到了？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我確實",
    "voice": "vo_adv_5106604_027",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是想過總有一天",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "能辦這樣的活動，",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n來感謝他們過去的照顧……",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "不過，這畢竟是",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我個人的想法……",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "才沒那回事呢！",
    "voice": "vo_adv_5106604_028",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "千歌想做的事",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "就是慈樂之音所有人想做的事。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "對吧？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "是呀。",
    "voice": "vo_adv_5106604_029",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我也想參與。",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "當然，",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "前提是千歌不嫌棄的話……",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "望、",
    "voice": "vo_adv_5106604_030",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "紡希……",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "謝謝妳們。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "讓我們慈樂之音三人一起去問看看",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "能不能在育幼院舉辦演唱會吧。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n拉菲，純小姐，",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "還有你，",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "非常謝謝你們。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "呵呵，",
    "voice": "vo_adv_5106604_031",
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "小咲戀她們一定也會很高興的。",
    "voice": null,
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n這樣算是",
    "voice": null,
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "做好天使分內的",
    "voice": null,
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "工作了吧？",
    "voice": null,
    "unit_id": 124214
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "我覺得100名天使降臨",
    "voice": "vo_adv_5106604_032",
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "的主意還不錯呀……",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "不過只要大家開心",
    "voice": null,
    "unit_id": 5512
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "就好了！",
    "voice": null,
    "unit_id": 5512
  },
  {
