    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這對我來說是難以忍受的屈辱喔。",
