  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "克莉絲提娜和{0}在城鎮裡四處逛逛，\\n回過神來才發現夕陽開始西下。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "嗯，",
    "voice": "vo_adv_1115003_000",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "那邊的衣服也給我好了。",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "小子，",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "幫我拿。",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "順便，",
    "voice": "vo_adv_1115003_001",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "也買雙搭配衣服的新鞋好了。",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "試穿好麻煩。",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這個和這個，",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "還有……",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這個也買起來好了。",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "小子，",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "別弄掉了啊。",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "嗯？　",
    "voice": "vo_adv_1115003_002",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "什麼啊，",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "腳步很不穩哦？",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n不過就是拿個10件20件東西，",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n鍛鍊不足喔？",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "好，",
    "voice": "vo_adv_1115003_003",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "那麼就",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "讓我來幫你鍛鍊鍛鍊吧☆",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "正好，",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我記得那裡",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n有個賣全身鎧甲的地方啊。",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "啊哈哈☆",
    "voice": "vo_adv_1115003_004",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n開玩笑的啦，",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "別露出這麼緊繃的臉嘛。",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n這樣會讓我更想要捉弄你♪",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……雖說原本是想解悶才嘗試看看的，",
    "voice": "vo_adv_1115003_005",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n聖誕約會也不錯嘛。",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不過，",
    "voice": "vo_adv_1115003_006",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這個結束之後又會回到無聊的狀態了啊。",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我過去嘗試了很多事情。",
    "voice": "vo_adv_1115003_007",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "戰鬥就不用說了，",
    "voice": "vo_adv_1115003_008",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "經營生意和擔任製作人等等，",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "為了解決掉無聊",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "真的做了很多事呢。",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不過，",
    "voice": "vo_adv_1115003_009",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "那個強敵也還活得好好的，",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n無論怎麼砍都還是糾纏不清。",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "今天的聖誕約會也是一樣。",
    "voice": "vo_adv_1115003_010",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n雖然嘗試去模仿做『一般』的事，",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n但結束之後，",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "就又要開始和無聊戰鬥了。",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我這個人，",
    "voice": "vo_adv_1115003_011",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "到底要怎樣才能滿足呢。",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……唉呀，",
    "voice": "vo_adv_1115003_012",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我說了無聊的事呢。",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "忘了就好。",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "無賴１",
    "words": "克莉絲提娜！",
    "voice": "vo_adv_1115003_013",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無賴１",
    "words": "\\n妳是克莉絲提娜‧摩根吧！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "嗯？",
    "voice": "vo_adv_1115003_014",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "你說的沒錯，",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我就是天下無雙的豪傑，",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n克莉絲提娜唷☆",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "無賴２",
    "words": "好久不見了啊，",
    "voice": "vo_adv_1115003_015",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴２",
    "words": "克莉絲提娜！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴２",
    "words": "\\n我……",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴２",
    "words": "還記得我們嗎！？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "小混混 3",
    "words": "可不准妳說不記得了！",
    "voice": "vo_adv_1115003_016",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小混混 3",
    "words": "\\n之前還把我們打得落花流水啊！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "嗯，",
    "voice": "vo_adv_1115003_017",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不記得！",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "小混混們",
    "words": "妳這傢伙！",
    "voice": "vo_adv_1115003_018",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "希望別人記住你的話，",
    "voice": "vo_adv_1115003_019",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "就改改那個大眾臉和",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n老套的說話方式如何啊？",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "嗯，",
    "voice": "vo_adv_1115003_020",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "就算改變外觀和說話方式也沒差啊。",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n你們流露出一股",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "自己是小卒的氣息啊。",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "啊啊，",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "真是無可救藥☆",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "無賴１",
    "words": "這女人還是一樣愛亂講話……！",
    "voice": "vo_adv_1115003_021",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無賴１",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無賴１",
    "words": "不過妳看！　",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無賴１",
    "words": "我今天把之前被妳打敗的傢伙都召集過來了！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無賴１",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無賴１",
    "words": "快還清妳欠的債吧！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "啊哈哈哈☆",
    "voice": "vo_adv_1115003_022",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n我一直以來都是付現的啊，",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "沒積欠過什麼唷。",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "話說回來明明是聖誕節還來找碴，",
    "voice": "vo_adv_1115003_023",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n你們還真是一群孤單寂寞的男人啊？",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "無賴２",
    "words": "妳，",
    "voice": "vo_adv_1115003_024",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴２",
    "words": "妳妳妳，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴２",
    "words": "少囉嗦！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴２",
    "words": "\\n和聖誕節無關吧！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "啊啊好寂寞好寂寞。",
    "voice": "vo_adv_1115003_025",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n對這麼寂寞的一群男人，",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "多少想施捨一些憐憫呢。",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "小混混 3",
    "words": "要、",
    "voice": "vo_adv_1115003_026",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小混混 3",
    "words": "要打嗎！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "小混混 3",
    "words": "\\n我們這邊可是有10個人以上喔！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "無賴１",
    "words": "就算是妳，",
    "voice": "vo_adv_1115003_027",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無賴１",
    "words": "\\n也無法輕易逃過！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我想想。",
    "voice": "vo_adv_1115003_028",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "雖然說身體跟腦袋記憶裡都沒有印象，",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不過被指控欠債還是心情很差呢。",
    "voice": null,
    "unit_id": 111511
  },
  {
