  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "啊……？",
    "voice": "vo_adv_1115003_040",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n喂，",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
