  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "只會重複同樣的話，做得還真粗糙。",
    "voice": "vo_adv_1317003_011",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n設計得實在太隨便了。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這就只是配置了預設的模組資料而已……",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "涅比亞那傢伙～",
