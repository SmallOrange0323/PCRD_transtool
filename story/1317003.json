    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "犯人肯定是涅比亞沒錯啊。",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n她剛剛是用嚮導小妖精的專用頻道傳送聲音過來。",
