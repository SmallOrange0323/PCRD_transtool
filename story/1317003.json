  },
  {
    "type": "dialogue",
    "name": "困擾的人１",
    "words": "也能得救了。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "用100個貝殼解救故鄉是怎樣……？",
