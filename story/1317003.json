    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "要是說我很重之類的，",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我會把你打飛喔！？",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你",
    "voice": "vo_adv_1317003_073",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這傢伙真的是……！",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "still",
    "still_id": "131700302"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "──呵呵，",
    "voice": "vo_adv_1317003_074",
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "啊哈哈♪",
    "voice": null,
    "unit_id": 131711
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
