  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "蘭法小姐也加入了，",
    "voice": "vo_adv_5148070_000",
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n那真的是場很有趣的打西瓜啊……",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "對啊～對啊～",
    "voice": "vo_adv_5148070_001",
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "雖然她是負責誘導人，",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "但是她居然能發出那麼大的聲音，",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n嚇到我了啊～",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "沒辦法發出大的聲音的話，",
    "voice": "vo_adv_5148070_002",
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "就沒辦法唱好歌啊～",
    "voice": null,
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n",
    "voice": null,
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "…",
    "voice": null,
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "…而且，",
    "voice": null,
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "她其實意外的",
    "voice": null,
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n有積極的地方也說不定呢？",
    "voice": null,
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "真的嗎？",
    "voice": "vo_adv_5148070_003",
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "我很在意～",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n應該是",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "跟小騎士有關？",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "咦……",
    "voice": "vo_adv_5148070_004",
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n為、",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "為什麼會提到兄長大人……？",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n兄長大人跟蘭法小姐",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "都是很認真、",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "很冷靜的人……",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "相似的兩人產生共鳴，",
    "voice": "vo_adv_5148070_005",
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "度過一個熱情的夏天～",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "的感覺？",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "嗯呼呼，",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "燃燒到停不下來～♡",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "之類的～？",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "這個",
    "voice": "vo_adv_5148070_006",
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "我也不知道呢。",
    "voice": null,
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n",
    "voice": null,
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "但是是蘭法姐啊，",
    "voice": null,
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n她有可能用奶瓶",
    "voice": null,
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "餵騎士同學喝牛奶之類的呢★",
    "voice": null,
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "奶……",
    "voice": "vo_adv_5148070_007",
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "奶瓶……？",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "我變得",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "更無法了解他們兩個的關係了……",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "是像媽媽跟小寶寶一樣的關係喔～♪",
    "voice": "vo_adv_5148070_008",
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n不過騎士同學的周圍，",
    "voice": null,
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "似乎還有很多媽媽在就是了。",
    "voice": null,
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "…",
    "voice": "vo_adv_5148070_009",
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "…我都不知道這件事……",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "兄長大人",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "他有著非常複雜的隱情呢……",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "他一定只是沒表現出來，",
    "voice": "vo_adv_5148070_010",
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "但是其實有著很多煩惱。",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "雖然不知道能幫上他多少忙，",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n但是我也必須成為他的支柱才行……！",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "哎呀～",
    "voice": "vo_adv_5148070_011",
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n小莉莉",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "大概往嚴肅的方向誤解了？",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n要吐槽她嗎？",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "因為看起來很有趣，",
    "voice": "vo_adv_5148070_012",
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "所以沒關係吧？",
    "voice": null,
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n",
    "voice": null,
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "啊★",
    "voice": null,
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n我去準備",
    "voice": null,
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "給莉莉使用的奶瓶喔──♪",
    "voice": null,
