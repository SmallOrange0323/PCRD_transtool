    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "要是不先打倒牠們，",
    "voice": "vo_adv_5106321_002",
    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n就無法對付聖誕樹……！",
    "voice": null,
    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "原來如此～",
