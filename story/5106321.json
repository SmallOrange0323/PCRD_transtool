    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n挾著不幸氣息",
    "voice": null,
    "unit_id": 124213
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "帶來了很多髒東西呢。",
