[
  {
    "type": "background",
    "bg_id": "500242"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "伊莉亞、真步、香織、{0}等人\\n為求『魔物之角』，終於抵達洞窟。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "嗯……又硬又刺很難行走的地方啊……",
    "voice": "vo_adv_5003004_000",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "黑漆漆一片，",
    "voice": "vo_adv_5003004_001",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "要小心腳下哦─",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不過，對妾身來說，這裡和剛才的密林比起來簡直像是天堂。",
    "voice": "vo_adv_5003004_002",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "涼爽的空氣也感覺好多了。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "到底要走到多深的地方啊？",
    "voice": "vo_adv_5003004_003",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "蠻深的哦。不過妾身知道路。",
    "voice": "vo_adv_5003004_004",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n跟著妾身走就好了！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "伊莉亞真是可靠呢～。",
    "voice": "vo_adv_5003004_005",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "呵呵呵，交給妾身就對了。",
    "voice": "vo_adv_5003004_006",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "真的呢，從頭到尾都是靠妳幫忙～",
    "voice": "vo_adv_5003004_007",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n之後要好好感謝伊莉亞才行",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "～",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "是呀！要是順利達成咱們的目的，",
    "voice": "vo_adv_5003004_008",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n一定要請伊莉亞來咱們的公會玩呀！",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "咱們好好招待一番～！",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妳說……去玩？",
    "voice": "vo_adv_5003004_009",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "怎麼了～？妳的表情好像嚇到了……",
    "voice": "vo_adv_5003004_010",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "倒不是……妾身也算活了很久了……",
    "voice": "vo_adv_5003004_011",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n還是第一次有人對妾身這麼說……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n一直以來都只是被畏懼而已……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "啊哈哈，妳還是孩子呀說得這麼嚴重～",
    "voice": "vo_adv_5003004_012",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "更何況……咱們已經是朋友了吧！",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n不必這麼見外了～",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "朋友……",
    "voice": "vo_adv_5003004_013",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這樣啊……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n不是眷屬，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "也不是支配者……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n這就是，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "所謂的朋友啊……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "呵呵呵……是嗎……朋友啊……",
    "voice": "vo_adv_5003004_014",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "──咕喔喔喔喔！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "咦？",
    "voice": "vo_adv_5003004_015",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "剛才那是什麼聲音～？",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "對了伊莉亞，",
    "voice": "vo_adv_5003004_016",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n這裡是不是常會變成魔物的住處啊？",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "雖然有魔物的骨骸，但卻沒怎麼看過活的魔物呢……",
    "voice": "vo_adv_5003004_017",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "反正，就算有的話，也是等死的老怪物吧。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "──咕喔喔喔喔！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "妳聽，又聽到了呀～……這真的是等死的老怪物嗎……？",
    "voice": "vo_adv_5003004_018",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "那個，喂，真步！",
    "voice": "vo_adv_5003004_019",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n小心腳下！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "哇哇哇！",
    "voice": "vo_adv_5003004_020",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "這裡",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "有一個洞啊！？",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "呼……",
    "voice": "vo_adv_5003004_021",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王，王子先生，謝謝您出手相救。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "哇！",
    "voice": "vo_adv_5003004_022",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "可、可惡，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "怎麼突然……！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "好，抓住了！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "真步，有哪裡受傷嗎？",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "得，得救了……",
    "voice": "vo_adv_5003004_023",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "伊莉亞，謝謝妳……",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "要小心哦。",
    "voice": "vo_adv_5003004_024",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n這裡的地形崎嶇不平。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n稍微絆倒的地方可能就有大洞。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "我、",
    "voice": "vo_adv_5003004_025",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "我會銘記在心的……！",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "哦，到了寬敞的地方了。",
    "voice": "vo_adv_5003004_026",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n大概就在這附近……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "啊──！有屍骸！",
    "voice": "vo_adv_5003004_027",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n嗯嗯，有角的魔物是……",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "……嗯？屍骸的附近好像有什麼在動呢。",
    "voice": "vo_adv_5003004_028",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "那……那是活的魔物嗎……？",
    "voice": "vo_adv_5003004_029",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "什！那傢伙正在吃屍骸！",
    "voice": "vo_adv_5003004_030",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "原來如此，這裡不但是魔物的墓場，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n同時也是以魔物屍骸為食的魔物的餐廳呢！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯，這就是所謂生命的循環吧。",
    "voice": "vo_adv_5003004_031",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "自然的道理還真是殘酷呢……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "伊莉亞小姐，",
    "voice": "vo_adv_5003004_032",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "現在不是佩服的時候了！",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n那隻魔物",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "注意到我們了！",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔",
    "voice": null,
    "unit_id": 10311
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "！",
    "voice": null,
    "unit_id": 10311
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "好，好像很強耶──！",
    "voice": "vo_adv_5003004_033",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "啊啊，而且好像還有相當高的魔力呢！",
    "voice": "vo_adv_5003004_034",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "憑，憑咱們打得倒牠嗎……！",
    "voice": "vo_adv_5003004_035",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "還是別勉強比較好吧！",
    "voice": "vo_adv_5003004_036",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯，妾身有一計！",
    "voice": "vo_adv_5003004_037",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這附近不是有個很深的洞嗎，",
    "voice": "vo_adv_5003004_038",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身來當誘餌把牠誘導到那裡去吧！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "那太危險了吧！",
    "voice": "vo_adv_5003004_039",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……說得也對，有你在就沒問題了吧！",
    "voice": "vo_adv_5003004_040",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n妳們兩個，咱們這邊會巧妙閃躲。所以……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "就由妳們來攻擊把那隻魔物打下洞裡去！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "如果是妳們……",
    "voice": "vo_adv_5003004_041",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n妾身有信心絕對能漂亮地辦到！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "……嗯。",
    "voice": "vo_adv_5003004_042",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我們也……",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "相信伊莉亞～！",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n{0}，你要好好保護伊莉亞啊─！",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "伊莉亞、王子先生就拜託你們了！",
    "voice": "vo_adv_5003004_043",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……呵呵。該認真出馬了。",
    "voice": "vo_adv_5003004_044",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
