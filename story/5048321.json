[
  {
    "type": "dialogue",
    "name": "依里",
    "words": "等、",
    "voice": "vo_adv_5048321_000",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "等一下──！",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "弓箭又失控了啦！",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "還有，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "那個水晶到底是什麼……",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "拉菲，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "這是怎麼回事呀！？",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "對、",
    "voice": "vo_adv_5048321_001",
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "對不起！",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "好像是受到願望的強烈程度影響，",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n再加上它也是剛剛才獲得新的力量，",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n它沒有辦法完全抑制住～！",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "不過，",
    "voice": "vo_adv_5048321_002",
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "它好像比之前失控的時候還要強耶？",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "拉菲，",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "妳很努力呢，",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "了不起、了不起♪",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "嘿嘿，",
    "voice": "vo_adv_5048321_003",
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "也沒有妳說的那麼誇張啦……",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "現在是閒聊這個的時候嗎！",
    "voice": "vo_adv_5048321_004",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "總之，我們要阻止弓箭。",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "真是的，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我本來可沒有打算要\\n變成天使處理這麼累人的工作啊……",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "沒關係啦，",
    "voice": "vo_adv_5048321_005",
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "這也是為了讓大家變得幸福快樂嘛，",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "姊姊♪",
    "voice": null,
    "unit_id": 113711
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "……",
    "voice": "vo_adv_5048321_006",
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "說的也是。",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "那",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我們就快點解決吧。",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n拉菲，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "這裡就交給我們，",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "妳往後站。",
    "voice": null,
    "unit_id": 113811
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "這樣我心裡會過意不去的，",
    "voice": "vo_adv_5048321_007",
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "至少讓我在遠處替妳們打氣吧！",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "加油～",
    "voice": null,
    "unit_id": 5511
  },
  {
    "type": "dialogue",
    "name": "拉菲",
    "words": "加油～！",
    "voice": null,
    "unit_id": 5511
  }
