[
  {
    "type": "background",
    "bg_id": "500164"
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "最近好像，",
    "voice": "vo_adv_1080004_000",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "有很多人會在路上叫住我。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "大商會那邊的人",
    "voice": "vo_adv_1080004_001",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "會稱呼我",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "「帝王章魚獵人」，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n或默默遞給我名片……",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我好像稍微有點名氣了呢。",
    "voice": "vo_adv_1080004_002",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這下出門在外就不能太亂來了。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "咦？",
    "voice": "vo_adv_1080004_003",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "你說這算是我努力之後獲得的獎賞？",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "該說是獎賞、還是名氣稅……",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "有點微妙呢。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "而且如果要說獎賞的話，",
    "voice": "vo_adv_1080004_004",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我希望是更好一點的呢。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "比如說，{0}給的……",
    "voice": "vo_adv_1080004_005",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "啊啊啊！",
    "voice": "vo_adv_1080004_006",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "沒有，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "沒有啦！",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "哎呀？",
    "voice": "vo_adv_1080004_007",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "吶，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "是不是有亮光從海那邊靠過來了？",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "嗯……",
    "voice": "vo_adv_1080004_008",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這是什麼，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "好亮……！",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "background",
    "bg_id": "510250"
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "呼，",
    "voice": "vo_adv_1080004_009",
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "總算是可以休息了！",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "因為是包含住宿的度假村打工，",
    "voice": "vo_adv_1080004_010",
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n雖然工作時間很長，",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "錢也算是很好賺。",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "不過呢，",
    "voice": "vo_adv_1080004_011",
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "像這樣子悠閒的休息還真是久違了……",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "對了。",
    "voice": "vo_adv_1080004_012",
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "也該找找給家人的伴手禮才行。",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "你能幫忙我嗎？",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這一帶的話，有許多大自然的伴手禮呢。",
    "voice": "vo_adv_1080004_013",
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "看啊，",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這個貝殼，不是很美嗎？",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "已經長大的兄妹不會想要，",
    "voice": "vo_adv_1080004_014",
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n但對小孩子們來說",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "可是珍寶啊。",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "唔～嗯，",
    "voice": "vo_adv_1080004_015",
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這一帶沒有什麼適合的貝殼呢。",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "到岩岸那邊去看看吧。",
    "voice": "vo_adv_1080004_016",
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n也許能夠找到很珍稀的貝殼也說不定。",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "嘿……",
    "voice": "vo_adv_1080004_017",
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這樣的路面，不太好走呢，",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這個地方。",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "啊，",
    "voice": "vo_adv_1080004_018",
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "螃蟹啊……",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "呀！？",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "痛痛痛痛。",
    "voice": "vo_adv_1080004_019",
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "為了不踩到螃蟹結果腳好像扭到了……",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n要繼續在這岩岸走下去可能有困難……",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "吶，",
    "voice": "vo_adv_1080004_020",
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "不好意思啊……",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "能不能請你幫我去找貝殼來呢？",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "意、",
    "voice": "vo_adv_1080004_021",
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "意志這麼堅定我很高興，",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n但是不用那麼多啦！？",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "只要裝到有點重量就夠囉？",
    "voice": "vo_adv_1080004_022",
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "加油？",
    "voice": "vo_adv_1080004_023",
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "知、",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "知道了。",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這樣的話……",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "加油～！",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "加油～！",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "{0}加加油～！！",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "那個，",
    "voice": "vo_adv_1080004_024",
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這樣子可以嗎？",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "謝謝，",
    "voice": "vo_adv_1080004_025",
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "那就拜託你囉！",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "…………",
    "voice": "vo_adv_1080004_026",
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "他沿著岩岸走了相當遠呢，",
    "voice": "vo_adv_1080004_027",
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "不要緊吧？",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "啊，",
    "voice": "vo_adv_1080004_028",
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "回來了！",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "吶，你沒事吧！？",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "咦？",
    "voice": "vo_adv_1080004_029",
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "在海浪洶湧的地方",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "有美麗的貝殼？",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "原來是這樣呀。",
    "voice": "vo_adv_1080004_030",
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "{0}都這麼說了，",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n應該是非常美麗的吧……",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "咦！？",
    "voice": "vo_adv_1080004_031",
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "你說要去撿來……",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "啊，{0}！？",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "走、",
    "voice": "vo_adv_1080004_032",
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "走掉了。",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "真、",
    "voice": "vo_adv_1080004_033",
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "真的沒問題嗎？",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "應該不會被海浪捲走吧……？",
    "voice": "vo_adv_1080004_034",
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "唔，",
    "voice": "vo_adv_1080004_035",
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "真是讓人心急啊，",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "快點回來吧……！",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "啊！？",
    "voice": "vo_adv_1080004_036",
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "真是的，",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "怎麼這麼久！",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "你沒事吧？",
    "voice": "vo_adv_1080004_037",
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "身上沒有受傷吧？",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這，",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "等等，",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "你腳在流血──",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "still",
    "still_id": "108000401"
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "呀啊！",
    "voice": "vo_adv_1080004_038",
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "對、",
    "voice": "vo_adv_1080004_039",
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "對不起，",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "扭到的腳絆了一下――",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "啊……",
    "voice": "vo_adv_1080004_040",
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "呃、呃。",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "那個……",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我很抱歉。",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n但是，",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "等{0}很久都不回來，",
    "voice": null,
    "unit_id": 108031
  },
  {
    "type": "dialogue",
