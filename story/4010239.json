    "unit_id": 126531
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "感謝你今天",
    "voice": null,
    "unit_id": 126531
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 126531
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "陪我一起過生日。",
    "voice": null,
    "unit_id": 126531
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "嗯。",
    "voice": "vo_adv_4010239_001",
    "unit_id": 126531
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "我早就想跟你一起來逛逛了。",
    "voice": null,
    "unit_id": 126531
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 126531
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "聽說這裡有許多饒富趣味的點心，",
    "voice": null,
    "unit_id": 126531
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "跟綿滑的生奶油",
    "voice": null,
    "unit_id": 126531
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n還有香濃的奶油都大不相同……",
    "voice": null,
    "unit_id": 126531
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "哎呀……",
    "voice": "vo_adv_4010239_002",
    "unit_id": 126531
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "真的有好多不同種類的點心呢。",
    "voice": null,
    "unit_id": 126531
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 126531
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "這個是……",
    "voice": null,
    "unit_id": 126531
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "什麼東西啊？",
    "voice": null,
    "unit_id": 126531
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n紅通通的",
    "voice": null,
    "unit_id": 126531
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "乾貨，",
    "voice": null,
    "unit_id": 126531
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "好幾個串成一串……",
    "voice": null,
    "unit_id": 126531
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "烏賊……？",
    "voice": "vo_adv_4010239_003",
    "unit_id": 126531
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "跟我所知道的烏賊",
    "voice": null,
    "unit_id": 126531
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "很不一樣呢。",
    "voice": null,
    "unit_id": 126531
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n……咦，",
    "voice": null,
    "unit_id": 126531
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "那這個呢？",
    "voice": null,
    "unit_id": 126531
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "黃色",
    "voice": null,
    "unit_id": 126531
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "圓圓的三顆……",
    "voice": null,
    "unit_id": 126531
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "口香糖嗎？",
    "voice": null,
    "unit_id": 126531
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n其中摻雜了一顆超級酸的？",
    "voice": null,
    "unit_id": 126531
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "竟、",
    "voice": null,
    "unit_id": 126531
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "竟然還有那樣的考驗……",
    "voice": null,
    "unit_id": 126531
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "……騎士。",
    "voice": "vo_adv_4010239_004",
    "unit_id": 126531
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n請你來選擇",
    "voice": null,
    "unit_id": 126531
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "我的命運吧。",
    "voice": null,
    "unit_id": 126531
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 126531
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "無論結果如何，",
    "voice": null,
    "unit_id": 126531
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "我都會欣然接受。",
    "voice": null,
    "unit_id": 126531
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "那麼──",
    "voice": "vo_adv_4010239_005",
    "unit_id": 126531
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "我要吃囉。",
    "voice": null,
    "unit_id": 126531
  },
  {
    "type": "dialogue",
    "name": "耶兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 126531
  },
  {
