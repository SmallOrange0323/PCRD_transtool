[
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "嘻嘻……",
    "voice": "vo_adv_5012321_000",
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "打倒那些傢伙不是很厲害嘛。",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "接下來要給你的絕望是――",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "……",
    "voice": "vo_adv_5012321_001",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "停下來吧。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "……妳說什麼？",
    "voice": "vo_adv_5012321_002",
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "妳說看得到我的懦弱……",
    "voice": "vo_adv_5012321_003",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "和心裡的黑暗對吧。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我也",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "看得到妳的心……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n因為，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我和你很像……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "……閉嘴。",
    "voice": "vo_adv_5012321_004",
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "妳一定",
    "voice": "vo_adv_5012321_005",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "不希望發生這些事……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "其實妳渴望的不是絕望，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "而是希望――",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "……閉嘴！！！！",
    "voice": "vo_adv_5012321_006",
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "妳說妳看的到我心中的黑暗對吧！？",
    "voice": "vo_adv_5012321_007",
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "\\n那就盡量看吧！！",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "這、",
    "voice": "vo_adv_5012321_008",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "這股力量……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "這是用",
    "voice": "vo_adv_5012321_009",
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "我所有渴望的絕望，帶來的永恆暗黑之力量！",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "\\n如果你能承受這股黑暗的話，",
    "voice": null,
    "unit_id": 11111
  },
  {
    "type": "dialogue",
    "name": "哀嘆之女神",
    "words": "就承受吧！！",
    "voice": null,
    "unit_id": 11111
  }
]
