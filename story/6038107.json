[
  {
    "type": "background",
    "bg_id": "500750"
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "小墨丘利那邊的優花梨姊姊，",
    "voice": "vo_adv_6038107_000",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "是一個怎麼樣的人呢？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "嗯～",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "因為，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "她長得美腦筋聰明個性冷靜工作能力又強，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "卻也同時有著輕微的麥酒愛好者這可愛的一面，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "感覺很棒呢。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "嗯嗯，",
    "voice": "vo_adv_6038107_001",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "真的讓人好嚮往喔，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "工作能力強又很獨立的女性。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "而且她明明那麼漂亮，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "卻完～～～全沒有男人這點也是！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n我想她可能對談戀愛或結婚一點興趣也沒有吧，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "好帥！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "聖騎士？　",
    "voice": "vo_adv_6038107_002",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "嗯，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "我不是很清楚……",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "啊，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "這麼說起來。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n好像也有人叫學長你騎士對不對？　",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "那是",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "怎麼一回事啊？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "是騎白馬的那種嗎？　",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "咦，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "就憑你那張臉……",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "哪可能，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "越想越好笑。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "這說法。",
    "voice": "vo_adv_6038107_003",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "你這樣不是會讓人以為她一年到頭",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "都在喝酒嗎。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n優花梨應該是那個吧，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "為了犒賞自己平日工作的辛勞，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "所以周末會到時髦的酒吧喝到有點微醺……",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "咦，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "你為什麼要歪頭？",
    "voice": null,
    "unit_id": 110911
  }
]
