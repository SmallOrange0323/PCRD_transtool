    "words": "\\n",
    "voice": null,
    "unit_id": 133811
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……感覺，",
    "voice": null,
    "unit_id": 133811
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "有點難為情呢。",
    "voice": null,
    "unit_id": 133811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "會嗎？",
    "voice": "vo_adv_5201301_001",
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我倒是雀躍不已……♪",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "畢竟這可是",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "當時千里真那斥責說",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n「別做這種破壞戰鬥平衡的事」，就沒實裝的模型啊。",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我也是，",
    "voice": "vo_adv_5201301_002",
    "unit_id": 133711
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "被拉基拉基教訓說",
    "voice": null,
    "unit_id": 133711
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "不要破壞世界觀。",
    "voice": null,
    "unit_id": 133711
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133711
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "唉，我承認這模型是參入太多個人喜好了啦。",
    "voice": null,
    "unit_id": 133711
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 133711
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "……都是因為年輕犯下的錯誤呢。",
    "voice": null,
    "unit_id": 133711
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "不過到了現在，",
    "voice": "vo_adv_5201301_003",
    "unit_id": 133711
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "那些力量成了可靠的一線希望。",
    "voice": null,
    "unit_id": 133711
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n我要感謝以前的我。",
    "voice": null,
    "unit_id": 133711
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "呵，",
    "voice": "vo_adv_5201301_004",
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這是規格之外的東西，",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "妳們要是被捲進去，",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "可別抱怨喔！",
    "voice": null,
    "unit_id": 133911
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "來展現一下",
    "voice": "vo_adv_5201301_005",
    "unit_id": 133811
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "夢幻職業的力量吧。",
    "voice": null,
    "unit_id": 133811
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 133811
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "格列戈爾──",
    "voice": null,
    "unit_id": 133811
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "命令你殲滅我的敵人。",
    "voice": null,
    "unit_id": 133811
  },
  {
