[
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "沒想到得用未正式實裝的模型參與戰鬥。",
    "voice": "vo_adv_5201301_000",
    "unit_id": 133811
  },
  {
    "type": "dialogue",
