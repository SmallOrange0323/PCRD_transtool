[
  {
    "type": "background",
    "bg_id": "500540"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "怜為了前往祖父的技法書中記載的",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "古老流派修練場，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n與{0}一同向著與王都相隔遙遠的雪山而去。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "根據技法書的記載，",
    "voice": "vo_adv_1803003_000",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n這座山上應該有個修練場……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "但如此險要之地，",
    "voice": "vo_adv_1803003_001",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我實在不認為古今以來",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "曾有人居住在這裡。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你還好吧？",
    "voice": "vo_adv_1803003_002",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "會不會覺得冷？",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "姑且是有",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "施了點聊以慰藉的防寒魔法。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "嗯，",
    "voice": "vo_adv_1803003_003",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我也沒事。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n山間的天氣變化莫測，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我們邊留意彼此的情況邊上山吧。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "嗯？",
    "voice": "vo_adv_1803003_004",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那是……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n人嗎……？",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "你好。",
    "voice": "vo_adv_1803003_005",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "請問你們今天",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "是打算登山嗎？",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是的，",
    "voice": "vo_adv_1803003_006",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我們想去位於山頂的修練場。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "修練場……",
    "voice": "vo_adv_1803003_007",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "是嗎？",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我記得曾有傳說提到過那樣的場所。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "但是，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "現在山頂上沒有任何人居住喔。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "怎麼會……",
    "voice": "vo_adv_1803003_008",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這是準確的情報嗎？",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "是的。",
    "voice": "vo_adv_1803003_009",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我就住在山腳下的村莊，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n以管理這座山為生，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n我已經確認過山頂確實沒人居住了。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "那裡不是人人都能輕易往來的地方。",
    "voice": "vo_adv_1803003_010",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "雖然的確",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "留有建築物的痕跡，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "但如果你們是來尋找什麼人的話，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n前往山頂恐怕也是白費工夫。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這樣",
    "voice": "vo_adv_1803003_011",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "啊……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就算你說的是事實，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我也想親眼確認看看。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我們還是要登頂看看。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我知道了。",
    "voice": "vo_adv_1803003_012",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "那我就先下山了，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n請你們多加小心。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "謝謝你。",
    "voice": "vo_adv_1803003_013",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……我們繼續前進吧。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……呼、",
    "voice": "vo_adv_1803003_014",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "呼。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "空氣",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "越來越稀薄了……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "能在這種地方",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "修練的劍士，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n絕對",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是位",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "身手不凡之輩……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這裡",
    "voice": "vo_adv_1803003_015",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就是山頂啊……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n連座建築物",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "都沒有呢。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這是……",
    "voice": "vo_adv_1803003_016",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "柱子的殘骸。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "原來",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "真的曾經有人居住啊……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "哈哈，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這可真是大老遠的",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "白跑了一趟呢……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "下起暴風雪就不妙了。",
    "voice": "vo_adv_1803003_017",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我們快下山吧。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "光是確認了事實，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就不算",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "毫無所獲──",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "background",
    "bg_id": "500543"
  },
  {
    "type": "dialogue",
    "name": "騎士1",
    "words": "──汝",
    "voice": "vo_adv_1803003_018",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士1",
    "words": "是渴望探求劍術巔峰之輩嗎？",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "！？",
    "voice": "vo_adv_1803003_019",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是誰！",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "騎士1",
    "words": "──汝是",
    "voice": "vo_adv_1803003_020",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士1",
    "words": "渴望探求劍術巔峰之輩嗎？",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這個騎士",
    "voice": "vo_adv_1803003_021",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是從哪冒出來的！？",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n而且，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "天氣突然惡化了！",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我們是見到幻覺了嗎……！？　",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "騎士2",
    "words": "回答吾等的問題。",
    "voice": "vo_adv_1803003_022",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "還有一個人！？",
    "voice": "vo_adv_1803003_023",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不只一個人！",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我們已經被包圍了嗎──！　",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……我",
    "voice": "vo_adv_1803003_024",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "想探求劍術的巔峰。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我正是",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "為此而來。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "騎士3",
    "words": "是嗎……",
    "voice": "vo_adv_1803003_025",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "騎士3",
    "words": "很遺憾，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "騎士3",
    "words": "此地興旺的流派早已沒落。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "騎士3",
    "words": "\\n汝所追求的強大",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "騎士3",
    "words": "已經不復存在了。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "騎士2",
    "words": "修練場腐朽不堪，",
    "voice": "vo_adv_1803003_026",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "騎士2",
    "words": "登峰造極的劍技",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "騎士2",
    "words": "也已消逝雪中。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "騎士2",
    "words": "\\n老老實實地下山去吧。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "騎士1",
    "words": "此等建言也是為了汝，",
    "voice": "vo_adv_1803003_027",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士1",
    "words": "若汝等還想保住一命……",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "苟且保住的命我才不稀罕！",
    "voice": "vo_adv_1803003_028",
    "unit_id": 100312
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我從",
    "voice": null,
    "unit_id": 100312
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "踏入這座山的那一刻起，",
    "voice": null,
    "unit_id": 100312
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就已經下定決心了！",
    "voice": null,
    "unit_id": 100312
  },
  {
    "type": "dialogue",
    "name": "騎士1",
    "words": "……那麼，與吾等一戰吧。",
    "voice": "vo_adv_1803003_029",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士1",
    "words": "\\n就讓吾等",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士1",
