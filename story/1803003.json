    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n就像「致親愛的你」那種開頭詞。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是那種愛啦，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "親愛的愛！",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n明白了嗎！？",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……謝謝了，",
    "voice": "vo_adv_1803003_103",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "沉睡在雪山的騎士們。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我一定會用與你們戰鬥後得到的力量，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "將所愛之人",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "守護到底。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "無論何時，",
    "voice": "vo_adv_1803003_104",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "無論何地……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "怜學會了把比以往更強大的心念之力",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "化作力量，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n為了和{0}繼續並肩作戰，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n她立下決心，今後也將繼續揮舞手中之劍。",
    "voice": null,
