  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "哦哦──！",
    "voice": "vo_adv_5136061_000",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n這就是這個世界的蘭德索爾啊～！",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "如何如何？",
    "voice": "vo_adv_5136061_001",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n和埃拉的世界裡的蘭德索爾不一樣嗎？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "嗯～～～～～",
    "voice": "vo_adv_5136061_002",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "在誤差範圍內！！",
    "voice": "vo_adv_5136061_003",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n大概吧♪",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "日和、埃拉",
    "words": "啊哈哈哈哈！",
    "voice": "vo_adv_5136061_004",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "志那都妳覺得呢？",
    "voice": "vo_adv_5136061_005",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n也是在誤差範圍內嗎？",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "…………",
    "voice": "vo_adv_5136061_006",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……這個嘛。",
    "voice": "vo_adv_5136061_007",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "看起來是滿像的。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n但是不仔細端詳看看的話無法斷言。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這樣的話我們可以帶兩位去參觀哦！",
    "voice": "vo_adv_5136061_008",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "反正感覺暫時也不能做什麼呢。",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "就是啊──",
    "voice": "vo_adv_5136061_009",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "……畢竟剛剛才去確認過，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "我和志那都",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "似乎也進不了索爾之塔。",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "調查索爾之塔的事",
    "voice": "vo_adv_5136061_010",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就交給菲歐和涅比亞吧。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "還有……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "厄莉絲的行蹤",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "就由優衣和{0}負責。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……好。",
    "voice": "vo_adv_5136061_011",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n那麼我們要做什麼。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "啊！",
    "voice": "vo_adv_5136061_012",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n說到這個啊？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "要不要分成兩隊行動呢？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "…………",
    "voice": "vo_adv_5136061_013",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n是打算把我排除在外嗎……",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "為什麼會是分成三個人和一個人！？",
    "voice": "vo_adv_5136061_014",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "啊哈哈哈，",
    "voice": "vo_adv_5136061_015",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "當然是兩兩一組啦♪",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "分成怜與志那都隊～～～",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n以及日和與我這一隊♪",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "妳想嘛，",
    "voice": "vo_adv_5136061_016",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "人數太多的話",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "在團體行動中還得顧慮其他人，",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n而且也有很多想說的話吧？",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "妳我都是呢♪",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "…………妳我，",
    "voice": "vo_adv_5136061_017",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "是嗎。",
    "voice": null,
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……感覺話中有話呢。",
    "voice": "vo_adv_5136061_018",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "呃……",
    "voice": "vo_adv_5136061_019",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "那麼，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這樣的安排可以嗎？",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "如果沒有問題，",
    "voice": "vo_adv_5136061_020",
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "就原地解散吧！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "有什麼狀況的話，",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "要馬上會合喔！",
    "voice": null,
    "unit_id": 100111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "知道了。",
    "voice": "vo_adv_5136061_021",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……我也沒有異議。",
    "voice": "vo_adv_5136061_022",
    "unit_id": 135614
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "那就這麼決定囉！",
    "voice": "vo_adv_5136061_023",
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "祝怜與志那都",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "埃拉",
    "words": "蘭德索爾觀光愉快～♪",
    "voice": null,
    "unit_id": 135512
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "蘭德索爾觀光愉快～♪",
    "voice": "vo_adv_5136061_024",
