    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "那很厲害耶！",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "好！",
