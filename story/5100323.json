[
  {
    "type": "dialogue",
    "name": "植物羊",
    "words": "嗚、",
    "voice": "vo_adv_5100323_000",
    "unit_id": 16613
  },
  {
    "type": "dialogue",
    "name": "植物羊",
    "words": "嗚嗚～～～！",
    "voice": null,
    "unit_id": 16613
  },
  {
    "type": "dialogue",
    "name": "植物羊",
    "words": "\\n我真的，",
    "voice": null,
    "unit_id": 16613
  },
  {
    "type": "dialogue",
    "name": "植物羊",
    "words": "可以相信你們嗎……？",
    "voice": null,
    "unit_id": 16613
  },
  {
    "type": "dialogue",
    "name": "植物羊",
    "words": "不，",
    "voice": "vo_adv_5100323_001",
    "unit_id": 16613
  },
  {
    "type": "dialogue",
    "name": "植物羊",
    "words": "這是騙人的……！",
    "voice": null,
    "unit_id": 16613
  },
  {
    "type": "dialogue",
    "name": "植物羊",
    "words": "\\n我相信的",
    "voice": null,
    "unit_id": 16613
  },
  {
    "type": "dialogue",
    "name": "植物羊",
    "words": "只有一件事……",
    "voice": null,
    "unit_id": 16613
  },
  {
    "type": "dialogue",
    "name": "植物羊",
    "words": "\\n與老爺爺的約定是",
    "voice": null,
    "unit_id": 16613
  },
  {
    "type": "dialogue",
    "name": "植物羊",
    "words": "絕對的……！",
    "voice": null,
    "unit_id": 16613
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "你也是",
    "voice": "vo_adv_5100323_002",
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "相當頑固呢。",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "不過，",
    "voice": "vo_adv_5100323_003",
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "說到決心的堅定程度",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "人家也不會輸！",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n咱們",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "就是來幫助你的！",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "真步小姐，",
    "voice": "vo_adv_5100323_004",
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我們也……",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "使出全力上吧！",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n為了讓",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "羊先生了解我們的想法！",
    "voice": null,
    "unit_id": 123211
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "是啊，",
    "voice": "vo_adv_5100323_005",
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "綾音小姐。",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n都千里迢迢",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "跑來這裡了，",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "必須把咱們的心意──",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "好好傳達給羊先生！",
    "voice": null,
    "unit_id": 123111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「一定要把我們的心意",
    "voice": "vo_adv_5100323_006",
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "傳達過去！」",
    "voice": null,
    "unit_id": 2113
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "嗯！",
    "voice": "vo_adv_5100323_007",
    "unit_id": 123211
  }
]
