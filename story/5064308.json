[
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "找到了～！",
    "voice": "vo_adv_5064308_000",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "是神祕暗黑組織憂妮們！",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "這可是大發現！",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "話說也太好笑。",
    "voice": "vo_adv_5064308_001",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n憂妮們",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "完全復活了嘛。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "魔力的流動",
    "voice": "vo_adv_5064308_002",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "甚至比剛才都還要流暢。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "講白一點就是很強──",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "那個，等一下。\\n暫停暫停，攝影機也停一下。",
    "voice": "vo_adv_5064308_003",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "那個，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不覺得這段台詞",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "剛才已經說過了嗎？",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "是啊，",
    "voice": "vo_adv_5064308_004",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "已經說過了。",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n順帶一提，感覺應該還會再說個兩三次。",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "真的假的。",
    "voice": "vo_adv_5064308_005",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n那傢伙到底會復活多少次啊。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n這是憂妮們復活慶典IN德蕾女嗎。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "話雖如此，",
    "voice": "vo_adv_5064308_006",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "那傢伙被灌入的魔力也不是無限。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "好了，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "要不放棄地戰鬥啊克蘿依。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n既然如此反覆修復與強化，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "那盡頭肯定不會太遠。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "呃～",
    "voice": "vo_adv_5064308_007",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "真的嗎？",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我這充滿榮耀的文科人所推敲出的理論",
    "voice": "vo_adv_5064308_008",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "不可能會錯。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "如果想反駁就說來聽聽。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "「那就自己去打倒她」。",
    "voice": "vo_adv_5064308_009",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "反駁完畢。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "嗚……",
    "voice": "vo_adv_5064308_010",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "那種辯論太狡猾了……",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "唔、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "唔唔……",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "啊～真是的～好了啦～",
    "voice": "vo_adv_5064308_011",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n優妮學姐都要哭出來了啦。",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "嗚嗚，",
    "voice": "vo_adv_5064308_012",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "所以我才說運動會系的……",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "嗚、",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "嗚……",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊……",
    "voice": "vo_adv_5064308_013",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我很",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "抱歉……",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "好了，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "打起精神來吧。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "來，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "阿姨給你糖果。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我才不要，",
    "voice": "vo_adv_5064308_014",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "吃那個下巴超累的！",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "優妮學姐討厭吃東西，",
    "voice": "vo_adv_5064308_015",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "怎麼可能被食物安撫嘛。",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊──那好，",
    "voice": "vo_adv_5064308_016",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "這個給妳。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "這瓶",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我之前在魔導具店打工時拿到的",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "可疑藥水。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "哇～",
    "voice": "vo_adv_5064308_017",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "是可疑藥水～！",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "克蘿依學姐，",
    "voice": "vo_adv_5064308_018",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "我們學校禁止打工喔。",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "要是被瑪麗會長聽到的話可不得了喔。",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊，",
    "voice": "vo_adv_5064308_019",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "呃，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不是啦，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "是志工啦。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "是去當志工。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 14511
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊，糟糕，",
    "voice": "vo_adv_5064308_020",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "普通地忘了那傢伙。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "總覺得超吵的，",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "就先讓她安靜下來吧。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "說得也是。",
    "voice": "vo_adv_5064308_021",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "就切嚕地讓她安靜下來吧！",
    "voice": null,
    "unit_id": 116311
  }
]
