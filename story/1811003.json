[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "圍繞在璃乃心中的情感爆發了出來。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n姐妹之間也因此產生了誤解，然後──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "…………",
    "voice": "vo_adv_1811003_000",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我說了",
    "voice": "vo_adv_1811003_001",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "很過分的話呢。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "background",
    "bg_id": "500140"
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "「羈絆」什麼的──",
    "voice": "vo_adv_1811003_002",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "根本打從一開始就不曾有過嘛！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "……我明明",
    "voice": "vo_adv_1811003_003",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "沒有打算說出那種話的。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "但是，",
    "voice": "vo_adv_1811003_004",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "沒辦法提升力量……",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "就表示是",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "那麼回事對吧。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "自從第一天失敗的那時起，",
    "voice": "vo_adv_1811003_005",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我就一直感到很不安。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "如果",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "這個實驗沒成功的話，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "那意味著什麼，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n這個不安一直盤踞在我心中。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我和姐姐之間……",
    "voice": "vo_adv_1811003_006",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "根本沒有所謂的",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "羈絆存在。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我們既不像親生姊妹般有血緣關係，",
    "voice": "vo_adv_1811003_007",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "即使作為祕密結社的夥伴，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "姐姐一個人也什麼事都辦得到。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我",
    "voice": "vo_adv_1811003_008",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "到底……",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "算什麼呢……",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "察覺到這點的我……",
    "voice": "vo_adv_1811003_009",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "下意識就",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "對姐姐……",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "…………",
    "voice": "vo_adv_1811003_010",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "……我必須",
    "voice": "vo_adv_1811003_011",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "變得更強才行。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "就算沒辦法透過羈絆提升力量。",
    "voice": "vo_adv_1811003_012",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n我至少",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "也要努力變強，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "變得能和姐姐並肩作戰。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "……",
    "voice": "vo_adv_1811003_013",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "好～！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n現在不是垂頭喪氣的時候了！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n既然決定了，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "就要金星姐力地努力囉～！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "金星姐力？",
    "voice": "vo_adv_1811003_014",
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "金星……",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "難不成是",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "盡心竭力",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "嗎……",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n真佩服靜流",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "可以每次都馬上知道妳要說什麼……",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "公會長？",
    "voice": "vo_adv_1811003_015",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n怎麼了嗎……？",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "嗨，",
    "voice": "vo_adv_1811003_016",
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "璃乃。",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "很抱歉，我知道妳有事在身，",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n但我還是想請妳",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "幫忙處理一下",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "祕密結社的工作。",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "啊……",
    "voice": "vo_adv_1811003_017",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "好！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "就只有……",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我一個人嗎？",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "對，",
    "voice": "vo_adv_1811003_018",
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "只有璃乃一人。",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n別擔心，只是想請妳幫忙討伐一點魔物而已。",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "……能拜託妳嗎？",
    "voice": "vo_adv_1811003_019",
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "好的，",
    "voice": "vo_adv_1811003_020",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "當然沒問題！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我好歹也是",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "【拉比林斯】的一分子！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n舉頭過勞！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "妳是想說「舉手之勞」",
    "voice": "vo_adv_1811003_021",
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "對吧？",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "那麼，璃乃。",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n雖然地點距離蘭德索爾有些遙遠──",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "──我都記住了！",
    "voice": "vo_adv_1811003_022",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "正好。",
    "voice": "vo_adv_1811003_023",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n一個人完成任務，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "拿出自信",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "去向姐姐報告吧。",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "那就",
    "voice": "vo_adv_1811003_024",
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "麻煩了。",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n交給妳囉。",
    "voice": null,
    "unit_id": 106815
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "好的！",
    "voice": "vo_adv_1811003_025",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n包在我身上──",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "background",
    "bg_id": "500250"
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "──雖然我保證的那麼有自信～",
    "voice": "vo_adv_1811003_026",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "可是不管那邊……",
    "voice": "vo_adv_1811003_027",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "…………",
    "voice": null,
    "unit_id": 10111
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "還是這邊……",
    "voice": "vo_adv_1811003_028",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "…………",
    "voice": null,
    "unit_id": 10211
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "怎麼都有",
    "voice": "vo_adv_1811003_029",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "超大隻的怪物駐守啦～！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "這個地方",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "是怎麼回事啊……！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n很明顯的不太尋常吧……！？",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "這哪叫一點魔物啊，",
    "voice": "vo_adv_1811003_030",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "公會長！？",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n這要我一個人解決",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "絕對沒辦法啦……！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "要是有姐姐在……",
    "voice": "vo_adv_1811003_031",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "……不。",
    "voice": "vo_adv_1811003_032",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我不是才下定決心",
    "voice": "vo_adv_1811003_033",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "要努力變強嗎！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n倒不如說，任務越難越好！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "順利完成任務，",
    "voice": "vo_adv_1811003_034",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "得到姐姐的認可，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
