[
  {
    "type": "background",
    "bg_id": "500550"
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "呵呵呵，",
    "voice": "vo_adv_0000440_000",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "總算過完年了，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這是屬於我的一年啊！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "聽好了，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我祈梨大人",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "就是今年的老大啦！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n來吧，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "壓歲錢拿來喔。",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "好了好了！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "快一點！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "新年快樂。",
    "voice": "vo_adv_0000440_001",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n希望今年也會是很棒的一年。",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "……好了，",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "烏爾姆也好好問候。",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "新年快樂。",
    "voice": "vo_adv_0000440_002",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "今年也請多指教──",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……唉。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "令人難過的是，從元旦開始就有工作……",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "真是的，",
    "voice": "vo_adv_0000440_003",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "我說烏爾姆！",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "身為萊拉耶爾殿下的隨從，",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n這種時候就必須好好問候──",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "喂，",
    "voice": "vo_adv_0000440_004",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那邊的兩位！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n不要乾脆忽視別人，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n悠哉地進行什麼新年問候啦。",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "啊，",
    "voice": "vo_adv_0000440_005",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "對不起。",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "但一年之計在於元旦，",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "所以，",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n為了成就美好的一年，",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "也必須好好進行才行。",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "又",
    "voice": "vo_adv_0000440_006",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "要打掃了喔？",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……穿著女僕裝。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "咿！",
    "voice": "vo_adv_0000440_007",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那我絕對不要！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我拒絕！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "…",
    "voice": "vo_adv_0000440_008",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "…咳咳，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "新年快樂！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "小哥。",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n今年絕對也會是很棒的一年！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "儘管放心",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "一起冒險吧！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "請多指教喔，",
    "voice": "vo_adv_0000440_009",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "騎士先生。",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "請多指教。",
    "voice": "vo_adv_0000440_010",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……我主要是對老姊說的。",
    "voice": null,
    "unit_id": 127812
  }
]
