[
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "正在散步的{0}，碰巧遇到鈴奈時……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "咦，這不是秀才嗎！",
    "voice": "vo_adv_1016008_000",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "哈嚕！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "喂喂喂，待會有空嗎？",
    "voice": "vo_adv_1016008_001",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n你知道接下來那邊要舉行時裝秀嗎？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "真的嗎？秀才也知道啊！",
    "voice": "vo_adv_1016008_002",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "真高興～",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "咦？ 你問為什麼人家會很高興？",
    "voice": "vo_adv_1016008_003",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "因為人家也會出席那場時裝秀呀。",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "所以希望秀才能夠來喔～",
    "voice": "vo_adv_1016008_004",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "想讓你看看人家模特兒的樣子。",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "為了秀才，人家已經事先拿到入場券了――",
    "voice": "vo_adv_1016008_005",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "這張給你，絕對要來看――",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "哇，好刺眼……",
    "voice": "vo_adv_1016008_006",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "這個是之前的？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "發生什麼事了？到底怎麼回事！？",
    "voice": "vo_adv_1016008_007",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "呀～！！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "background",
    "bg_id": "510300"
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "啊，秀才你終於來了～",
    "voice": "vo_adv_1016008_008",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "吶吶，可以幫人家補習嗎？",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "拜託～！",
    "voice": "vo_adv_1016008_009",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n考試快要到了～",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "如果很多科不及格，",
    "voice": "vo_adv_1016008_010",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n人家說不定會被迫辭去模特兒的工作？",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "有趣的活動也差不多要開始了，",
    "voice": "vo_adv_1016008_011",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n現在辭職不就損失很大嗎？",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "你問是什麼事情？",
    "voice": "vo_adv_1016008_012",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "這個嘛……",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "啊！有了，有了！",
    "voice": "vo_adv_1016008_013",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "你看看那邊的海報？",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "椿丘時裝發表會！",
    "voice": "vo_adv_1016008_014",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n就像是時裝秀之類的活動。",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家下次會出席這場活動喔～",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "好像是相當盛大的活動……",
    "voice": "vo_adv_1016008_015",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "因為被拜託出席，",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "就一口答應了。",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "咦？太草率了嗎？",
    "voice": "vo_adv_1016008_016",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家身邊的人都是這樣喔？",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "啊，對了～",
    "voice": "vo_adv_1016008_017",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n秀才也來嘛～",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "拿去，票給你！",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "是相關人員專用的票，所以是特等席喔！",
    "voice": "vo_adv_1016008_018",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n可以清楚地看到人家模特兒的樣子！",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "絕對要來喔～",
    "voice": "vo_adv_1016008_019",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n沒來的話，",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家會超級生氣喔！",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "background",
    "bg_id": "510300"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "幾天後。活動當天――",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "101600801"
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "哇～好厲害！",
    "voice": "vo_adv_1016008_020",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n到處都是人！",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "女顧客１",
    "words": "呀！",
    "voice": "vo_adv_1016008_021",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女顧客１",
    "words": "\\n鈴奈～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女顧客２",
    "words": "真的讚到爆！",
    "voice": "vo_adv_1016008_022",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女顧客２",
    "words": "\\n超可愛的～",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女顧客２",
    "words": "\\n呀！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "大家好～人家是鈴奈喔～！",
    "voice": "vo_adv_1016008_023",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n謝謝大家～",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "時裝秀果然很好玩～！",
    "voice": "vo_adv_1016008_024",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "不知道秀才有沒有來看？",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才在哪裡呢？",
    "voice": "vo_adv_1016008_025",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家看看……？",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "在這麼多的人群當中，",
    "voice": "vo_adv_1016008_026",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n果然還是找不到吧？",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "……啊！發現秀才～！",
    "voice": "vo_adv_1016008_027",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "在那麼遠的地方還能找到，",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n人家該不會是天才？",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "雖然之前沒能在人群中找到朋友……",
    "voice": "vo_adv_1016008_028",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "難道因為是秀才，人家才能找到？",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "喂～秀才～！",
    "voice": "vo_adv_1016008_029",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n……從這裡叫的話，好像聽不到。",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "那麼對他眨個眼好了！",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "background",
    "bg_id": "510300"
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "結束了～！",
    "voice": "vo_adv_1016008_030",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "喂喂喂，秀才！",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n你覺得人家模特兒的樣子如何？",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "很厲害對吧？",
    "voice": "vo_adv_1016008_031",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "就算讀書不行，但人家很努力在當模特兒喔！",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "啊～對了！",
    "voice": "vo_adv_1016008_032",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家剛從伸展台對你眨眼，有注意到嗎？",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "啊哈哈～說什麼呢～",
    "voice": "vo_adv_1016008_033",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "眨眼而已就臉紅，",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n秀才太可愛了～",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "真的假的？",
    "voice": "vo_adv_1016008_034",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "太好了～！",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才也對人家模特兒的樣子",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n神魂顛倒嗎～",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "嗯～？你說真虧人家能找到你？",
    "voice": "vo_adv_1016008_035",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "對呀，人家也很驚訝。",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n畢竟人很多。",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "可是無論有多少人，",
    "voice": "vo_adv_1016008_036",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n人家都覺得能找到秀才喔～",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "因為啊，秀才是人家重要的――",
    "voice": "vo_adv_1016008_037",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "女顧客們",
    "words": "啊！",
    "voice": "vo_adv_1016008_038",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女顧客們",
    "words": "\\n是鈴奈！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女顧客們",
    "words": "\\n幫我們簽名～～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "哇、",
    "voice": "vo_adv_1016008_039",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "哇哇！？",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "被粉絲們包圍了……",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才！ 待會見喔～！",
    "voice": "vo_adv_1016008_040",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n等這邊告一段落我們再聊～！",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "如何呢？這是我給你的禮物！你做了個好「夢」嗎？",
    "voice": "vo_adv_1016008_041",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這是我依照以前你和鈴奈的記憶創造出來的「夢」，",
    "voice": "vo_adv_1016008_042",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n原來現在的你會採取這樣的行動啊。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我看了也很開心呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "當模特兒的鈴奈很漂亮呢～！",
    "voice": "vo_adv_1016008_043",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n好憧憬啊～",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "怎麼樣……",
    "voice": "vo_adv_1016008_044",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我不能對漂亮的衣服感興趣嗎？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n畢竟我也是女孩子呀！",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那麼，下次見囉～ ♪",
    "voice": "vo_adv_1016008_045",
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "啊，秀才醒了嗎～？",
    "voice": "vo_adv_1016008_046",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我們好像睡著了。",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "嗯～什麼？",
    "voice": "vo_adv_1016008_047",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n人家出席時裝秀的夢？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "那不就跟人家做的夢一樣嗎！？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "這種事情，之前是不是也發生過？",
    "voice": "vo_adv_1016008_048",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "不覺得有點好玩嗎？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我們還能再做同樣的夢就好了～",
    "voice": "vo_adv_1016008_049",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "喂，秀才也這麼想吧？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "……糟糕！",
    "voice": "vo_adv_1016008_050",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n人家有場時裝秀要出席！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我得快點！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才也會來看吧？",
    "voice": "vo_adv_1016008_051",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "不來的話，人家會很生氣喔！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "就算到處都是人，",
    "voice": "vo_adv_1016008_052",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n但如果是秀才的話，人家就有信心能立刻找到。",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "作為證據，人家會跟在夢中一樣對你眨眼喔。",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "所以，絕對要來喔～！",
    "voice": "vo_adv_1016008_053",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}跟著鈴奈，\\n朝向時裝秀會場前進。",
    "voice": null,
    "unit_id": null
  }
]
