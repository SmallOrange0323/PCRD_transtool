[
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}在蘭德索爾散步時，\\n遇到了忍。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "啊，{0}，你好。正在散步嗎？",
    "voice": "vo_adv_1031003_000",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n這麼好的天氣，真是很適合散步呢。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "……你問我在做什麼嗎？",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我在這裡幫人占卜。",
    "voice": "vo_adv_1031003_001",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n我是個占卜師，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n常常在這條路上",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "幫別人看運勢。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "咦，",
    "voice": "vo_adv_1031003_002",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "你不知道什麼是占卜？",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "真是奇特的人呢。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "所謂的占卜……",
    "voice": "vo_adv_1031003_003",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "應該可以說是，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n用各種方法查看運勢或未來，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n然後提供建議給有煩惱的人……",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "實在有點難以說明。俗話說百聞不如一見，",
    "voice": "vo_adv_1031003_004",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "{0}願意的話，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n讓我實際為你占卜看看吧？",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "好的。那",
    "voice": "vo_adv_1031003_005",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "請你坐在這裡。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n我主要使用自己的第六感，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n和這個水晶骷髏頭來占卜。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那麼我要開始占卜了…………",
    "voice": "vo_adv_1031003_006",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "你的運氣非常差。未來只有痛苦等著你。",
    "voice": "vo_adv_1031003_007",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n你會被火燒、被水淋、財產燒毀、和親近的人分離，",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n孤獨一人悲慘地死去吧。",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "如果不想變成那樣，",
    "voice": "vo_adv_1031003_008",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n就現在立刻從我眼前消失。",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n趕快滾吧，這臭小子！！",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "爸爸，你適可而止。",
    "voice": "vo_adv_1031003_009",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "咿！忍好恐怖！！",
    "voice": "vo_adv_1031003_010",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "真抱歉。剛剛那是我父親胡說八道，",
    "voice": "vo_adv_1031003_011",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n不是占卜。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n希望你不要在意。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我父親以前是傑出的靈媒，也擅長占卜。",
    "voice": "vo_adv_1031003_012",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n原本占卜的準確率非常地高……",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "但不論占卜結果如何，",
    "voice": "vo_adv_1031003_013",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n他對男性只說不好的內容，對女性只說好的內容，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "所以他並不適合當占卜師。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那麼請讓我重新為你占卜一次。",
    "voice": "vo_adv_1031003_014",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "…………",
    "voice": "vo_adv_1031003_015",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "你真是個……不可思議的人呢。",
    "voice": "vo_adv_1031003_016",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n我看到了以往從未看過的運氣。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "你的過去被深厚的黑闇給籠罩，",
    "voice": "vo_adv_1031003_017",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n無法窺見你是在何種星辰下",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "一路走來……",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "而你的未來似乎還有許多苦難阻擋在眼前。",
    "voice": "vo_adv_1031003_018",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n可能會有很多煩惱和痛苦。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n或許你會為了無可避免的災禍",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "而日日悲嘆不已。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "……啊，真抱歉。",
    "voice": "vo_adv_1031003_019",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n我擅自為你占卜，",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n卻說了這樣的結果……",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "今後如果你遇到了煩惱的事，",
    "voice": "vo_adv_1031003_020",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n歡迎來找我商量。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "有時候占卜或許也能幫上一些忙。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "另外……{0}，",
    "voice": "vo_adv_1031003_021",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n我也看到了你在過去和未來共通的運勢。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那就是桃花劫之相。而且是超乎尋常的程度。",
    "voice": "vo_adv_1031003_022",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "你和眾多女性之間有深厚的緣分，",
    "voice": "vo_adv_1031003_023",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n並且似乎強烈地影響你的根源世界。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "…………",
    "voice": "vo_adv_1031003_024",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "……那個，我想這不太好呢。",
    "voice": "vo_adv_1031003_025",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n和女性的往來應該保持適度的分寸就好。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "{0}你呀，那個……",
    "voice": "vo_adv_1031003_026",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n我想你很容易被誤會。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "該怎麼說呢……個性溫柔過頭是不好的。",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "太過於溫柔的話，",
    "voice": "vo_adv_1031003_027",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n或許會有人因此而誤解……",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "也就是說……這個占卜的結果……這個……那個……",
    "voice": "vo_adv_1031003_028",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "嗯？忍，妳怎麼了？",
    "voice": "vo_adv_1031003_029",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n妳的臉紅通通的，發燒了嗎？",
    "voice": null,
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "沒、",
    "voice": "vo_adv_1031003_030",
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "沒事！",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "{0}，那個，我先走了。再見！",
    "voice": null,
    "unit_id": 103111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "忍、忍～？",
    "voice": "vo_adv_1031003_031",
    "unit_id": 2411
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "比起{0}本人，\\n反倒是忍因占卜結果而有了心情的起伏。",
    "voice": null,
    "unit_id": null
  }
]
