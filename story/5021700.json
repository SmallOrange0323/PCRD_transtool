  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "你說這個嗎～？",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "　這是假想訓練―！",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "因為對手是奄美魔物啊―",
    "voice": "vo_adv_5021700_002",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "故鄉的血在沸騰呢～！",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "{0}也要試試看嗎―？",
    "voice": "vo_adv_5021700_003",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "沒問題的，",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "只要模仿我的動作就好了―！",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "首先是集中精神想像呀―……",
    "voice": "vo_adv_5021700_004",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "你看，",
    "voice": "vo_adv_5021700_005",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "眼前出現了很多奄美魔物對吧―？",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n然後把牠打倒―！",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "咦，",
    "voice": "vo_adv_5021700_006",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "沒有出現～？",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "集中力不夠呀～",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "要更努力的想像呀～！",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "很難嗎？　",
    "voice": "vo_adv_5021700_007",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "嗯～",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "真沒辦法呢～！",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "那可以請你在旁邊幫我加油嗎～！",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "只有{0}的聲援，",
    "voice": "vo_adv_5021700_008",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n是光靠想像沒有辦法讓人滿意的呢～♪",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "那麼",
    "voice": "vo_adv_5021700_009",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
