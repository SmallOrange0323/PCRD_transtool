[
  {
    "type": "background",
    "bg_id": "501000"
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "總覺得龍人族的那兩位",
    "voice": "vo_adv_6042105_000",
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "都很有魄力耶。",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "雖然祈梨感覺是個有趣的女孩子，",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "而帆稀小姐……",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "有點捉摸不透呢。",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "可是",
    "voice": "vo_adv_6042105_001",
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "可是，",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "她們有個幫派吧？ ",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "太可疑了啦～！",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "……啊！",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "這麼說來我們【拉比林斯】也是祕密結社呢！",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "要說可疑程度的話我們更勝……",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "嗯～",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "就當作是平手好了！",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "她能從嘴裡噴出火嗎！？",
    "voice": "vo_adv_6042105_002",
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "太厲害了，",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "真不愧是龍人族……！",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "咦？",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "就連打噴嚏時也會噴出火？",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "……這能算是很厲害嗎？",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "說的也是，",
    "voice": "vo_adv_6042105_003",
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "帆稀小姐總是面帶微笑……",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "只是，",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "那個……",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "一看到她的微笑，",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "總會讓我想起身邊的某個人呢～",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "她是真的很溫柔吧？",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "不會笑著對人發動頭槌攻擊吧？",
    "voice": null,
    "unit_id": 112912
  }
]
