    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子今天也想吃好吃的布丁～",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "好吃的布丁，",
    "voice": "vo_adv_5080101_001",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "只要去找應該到處都有來的……",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "就算再也吃不到婆婆的布丁也……",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "妳好像非常沮喪耶，",
    "voice": "vo_adv_5080101_002",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "發生什麼事了？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "如果可以，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "就說給我們聽吧。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子，",
    "voice": "vo_adv_5080101_003",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "再也吃不到婆婆做的布丁了……",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "呃……",
    "voice": "vo_adv_5080101_004",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "那是婆婆已經過世了的意思嗎？",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "才不是！",
    "voice": "vo_adv_5080101_005",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "婆婆還活著喲！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "可是之後會離開，再也不能做布丁給宮子了！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "原來如此。",
    "voice": "vo_adv_5080101_006",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "非常抱歉，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我完全沒聽懂妳在說什麼啦。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "別說了，快讓宮子吃婆婆做的布丁～！！",
    "voice": "vo_adv_5080101_007",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子一行人",
    "words": "下一回，",
    "voice": "vo_adv_5080101_008",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "宮子一行人",
    "words": "「聖誕布丁快樂！　",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "宮子一行人",
    "words": "飛舞的少女與飽含真心的點心」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500036"
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "雖然不知道是怎麼回事……",
    "voice": "vo_adv_5080101_009",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "總之",
    "voice": "vo_adv_5080101_010",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我們去找婆婆吧。",
    "voice": null,
    "unit_id": 103311
  }
]
