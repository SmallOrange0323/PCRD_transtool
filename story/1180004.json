  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "某一天。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n當{0}一個人獨自走在街上……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "給我等一下！",
    "voice": "vo_adv_1180004_000",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n小心一點哪，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "撞到人是不會──",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……噢。",
    "voice": "vo_adv_1180004_001",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n原來是你啊。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "嗯，",
    "voice": "vo_adv_1180004_002",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "你好啊。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "好的，",
    "voice": "vo_adv_1180004_003",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "再見。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……給我等一下！",
    "voice": "vo_adv_1180004_004",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n你給我稍等一下！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "這正巧是個好機會。",
    "voice": "vo_adv_1180004_005",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n你稍微",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "陪我一會兒吧。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n反正你",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "應該很閒吧？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "你那是怎樣啦，露出一臉厭惡的神色。",
    "voice": "vo_adv_1180004_006",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我也不會要你",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "做免錢白工。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n我會確實給付工資，就當作買你的時間。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "更何況……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我從以前開始，",
    "voice": "vo_adv_1180004_007",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "就對你挺有興趣的喔？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "就說你別擺出那種厭惡的表情啦！",
    "voice": "vo_adv_1180004_008",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n真是的，有夠失禮耶！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "你聽好了。",
    "voice": "vo_adv_1180004_009",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "為了避免誤會，我就先說明清楚，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我剛才說的興趣，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "可不是那種",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "男女間的在意介意會錯意，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n我對你完～～全",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "沒那個意思唷？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……我只是……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "雖然你有點，",
    "voice": "vo_adv_1180004_010",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "不，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "應該說是",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "非常地超級不可靠……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "但你畢竟是",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "守護陛下的騎士。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "因此對於你是怎麼受到陛下青睞的，",
    "voice": "vo_adv_1180004_011",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "非常有興趣……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "不是！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我是說，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "弄清楚你的人品，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n對我而言",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "是件非常重要的……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "咦？",
    "voice": "vo_adv_1180004_012",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "這、",
    "voice": "vo_adv_1180004_013",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "這道光是什麼呀！？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "咿咿咿咿～！？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "background",
    "bg_id": "510100"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "某一天。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n當{0}一個人獨自走在街上……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "…………",
    "voice": "vo_adv_1180004_014",
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "「給我等一下！",
    "voice": "vo_adv_1180004_015",
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n是你先撞到人的耶，",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "那什麼態度──！」",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "「雖然多虧有mimi，所以似乎能順利溝通……",
    "voice": "vo_adv_1180004_016",
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我說你們日本少年，",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n撞到人也不會說聲對不起嗎？」",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "「哼。",
    "voice": "vo_adv_1180004_017",
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n算了，",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "有乖乖道歉就好了。」",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "「這正巧是個好機會。",
    "voice": "vo_adv_1180004_018",
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n你稍微",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "陪我一會兒吧。",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n反正你應該很閒吧？」",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "「你那是怎樣啦，露出一臉厭惡的神色。",
    "voice": "vo_adv_1180004_019",
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我也不會要你",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "做免錢白工。",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n我會確實給付工資，就當作買你的時間。",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "更何況……」",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "「我現在",
    "voice": "vo_adv_1180004_020",
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "碰上了一點小困難。",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我手上裝置的導航系統似乎有點怪怪的……",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n害我迷路到這種住宅區裡。」",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "「呵呵。",
    "voice": "vo_adv_1180004_021",
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n反應很快嘛，可幫了大忙。」",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "「這麼說來，",
    "voice": "vo_adv_1180004_022",
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我還沒做自我介紹呢。",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n我是──」",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "「我是",
    "voice": "vo_adv_1180004_023",
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "克蕾雅‧波洋希亞。",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n是名投資客。",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "還請多指教了，",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "異國的少年。」",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "background",
    "bg_id": "510120"
  },
  {
    "type": "background",
    "bg_id": "510290"
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "「給我等一下！",
    "voice": "vo_adv_1180004_024",
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n我說怎麼這麼久都還沒到",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n目的地的椿丘大飯店哪！？」",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "「既然你不曉得在哪，",
    "voice": "vo_adv_1180004_025",
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n一開始就別說要帶路啊！！」",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "「唔……",
    "voice": "vo_adv_1180004_026",
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "沒想到我竟會犯這種失誤。",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n拜託路過的學生幫忙是否就是個錯誤決定了呢……」",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "「……唉。",
    "voice": "vo_adv_1180004_027",
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n都已經像這樣",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "特地從雪梨遠道而來了，",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "卻還比約定時間晚到，",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "不曉得會被怎樣取笑哪……」",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "「這是因為……」",
    "voice": "vo_adv_1180004_028",
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "「……我要洗刷自己的汙名。",
    "voice": "vo_adv_1180004_029",
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n要報仇雪恥。」",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "…………",
    "voice": "vo_adv_1180004_030",
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "「剛才也提到過，",
    "voice": "vo_adv_1180004_031",
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n我是",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "靠投資討生活的。」",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "「現在這時代可便利了。",
    "voice": "vo_adv_1180004_032",
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "只要有預測世事變化的能力，",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "再加上一點點運氣，",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n即使足不出戶，",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "也能累積莫大的財富。」",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "「沒錯，",
    "voice": "vo_adv_1180004_033",
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "就是你想的那樣。",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n我便是",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "經由投資，",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "從幾乎身無分文，",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n爬上億萬富翁地位的。",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "……然而……」",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "「大概是我太得意忘形了吧。",
    "voice": "vo_adv_1180004_034",
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "竟然不小心……",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "相信了從未見過面、",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n只有透過網路聯繫的對象。",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "我賺到的資產，",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "有一大半都被搶走了。」",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "「而多虧如此，",
    "voice": "vo_adv_1180004_035",
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "我那之後就變得徹底不相信他人。",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n才會像這樣，不僱用當地導遊，",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "選擇用自己的眼睛判斷，",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n親自找一個看起來人還不錯的少年",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "來幫我帶路。」",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "「而最後，",
    "voice": "vo_adv_1180004_036",
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "騙走我錢的那個詐欺師也銷聲匿跡了。",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "今天約好要見面的又是另外一位……",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "透過網路斥責、",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n取笑",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "可憐的我，",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "一個不可饒恕的傢伙。」",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "background",
    "bg_id": "510350"
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "「好啦！",
    "voice": "vo_adv_1180004_037",
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n總算是抵達椿丘大飯店了！」",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "「有勞你帶路了，",
    "voice": "vo_adv_1180004_038",
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "少年。",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n然後……」",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "「來，",
    "voice": "vo_adv_1180004_039",
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "我們上吧！」",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "「你怎麼一臉呆樣？",
    "voice": "vo_adv_1180004_040",
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "都到這地步，我們算是患難與共了。",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n你也和我一起",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "殺進去吧！」",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好，",
    "voice": "vo_adv_1180004_041",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "辛苦了～",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "克蕾琪塔",
    "voice": "vo_adv_1180004_042",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "嗎……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n雖然在蘭德索爾的時候也是，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n但在那世界，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "她也是個怪傢伙啊～",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不過，",
    "voice": "vo_adv_1180004_043",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這種記憶……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n到底是從哪冒出來的？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "或許是因為對你來說，",
    "voice": "vo_adv_1180004_044",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n這段記憶一點也不重要，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "又或者是……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "……哎呀。",
    "voice": "vo_adv_1180004_045",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n看來今天就到此為止了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n雖然有點在意，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "但算啦。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那麼，下次再見囉。",
    "voice": "vo_adv_1180004_046",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "雖然她是個怪傢伙，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "但也別對其太嚴苛哪～",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n否則很可憐耶。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……唔、",
    "voice": "vo_adv_1180004_047",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "唔～嗯……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……啊！？",
    "voice": "vo_adv_1180004_048",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "剛、",
    "voice": "vo_adv_1180004_049",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "剛才的究竟是……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "失去意識了嗎……？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "雖然完全搞不清楚",
    "voice": "vo_adv_1180004_050",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "到底發生了什麼事……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……但比起這個！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "來吧，",
    "voice": "vo_adv_1180004_051",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "你快說！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n快點仔細告訴我！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n能夠討公主殿下歡心的方法～！！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "那之後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}被克蕾琪塔糾纏了好一段時間不放……",
    "voice": null,
    "unit_id": null
  }
]
