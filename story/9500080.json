[
  {
    "type": "background",
    "bg_id": "509040"
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……咦？",
    "voice": "vo_adv_9500080_000",
    "unit_id": 127841
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127841
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "呃……",
    "voice": null,
    "unit_id": 127841
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127841
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "你是認真的嗎，",
    "voice": null,
    "unit_id": 127841
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "騎士先生……？",
    "voice": null,
    "unit_id": 127841
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "你還真是個怪人……",
    "voice": "vo_adv_9500080_001",
    "unit_id": 127841
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "竟特意選擇我這種偷懶狂。",
    "voice": null,
    "unit_id": 127841
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127841
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我還以為騎士先生喜歡的，",
    "voice": null,
    "unit_id": 127841
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "應該是各方面",
    "voice": null,
    "unit_id": 127841
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n都更成熟的大姐姐類型，",
    "voice": null,
    "unit_id": 127841
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "就像我的公主殿下那樣。",
    "voice": null,
    "unit_id": 127841
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……嘿嘿。",
    "voice": "vo_adv_9500080_002",
    "unit_id": 127841
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127841
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "老實說，我有點驚訝。",
    "voice": null,
    "unit_id": 127841
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n我有那麼",
    "voice": null,
    "unit_id": 127841
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "符合騎士先生的喜好嗎？",
    "voice": null,
    "unit_id": 127841
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "不過……",
    "voice": "vo_adv_9500080_003",
    "unit_id": 127841
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n雖然你願意選我，",
    "voice": null,
    "unit_id": 127841
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我非常開心，",
    "voice": null,
    "unit_id": 127841
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127841
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "但你是不是忘了",
    "voice": null,
    "unit_id": 127841
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "重要的事情……？",
    "voice": null,
    "unit_id": 127841
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我……",
    "voice": "vo_adv_9500080_004",
    "unit_id": 127841
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "不是人類喔。",
    "voice": null,
    "unit_id": 127841
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127841
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我就只是「人造物」，",
    "voice": null,
    "unit_id": 127841
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n只是為這個世界所準備的",
    "voice": null,
    "unit_id": 127841
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "人偶。",
    "voice": null,
    "unit_id": 127841
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……即便如此，",
    "voice": "vo_adv_9500080_005",
    "unit_id": 127841
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "你也沒關係嗎……？",
    "voice": null,
    "unit_id": 127841
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……！",
    "voice": "vo_adv_9500080_006",
    "unit_id": 127841
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "這樣啊……",
    "voice": "vo_adv_9500080_007",
    "unit_id": 127841
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "也有這種",
    "voice": null,
    "unit_id": 127841
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "思考方式呢。",
    "voice": null,
    "unit_id": 127841
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127841
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "那麼，",
    "voice": null,
    "unit_id": 127841
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我相信那句話。",
    "voice": null,
    "unit_id": 127841
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n不管怎麼說，",
    "voice": null,
    "unit_id": 127841
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我現在就在這裡。",
    "voice": null,
    "unit_id": 127841
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "不過，騎士先生。",
    "voice": "vo_adv_9500080_008",
    "unit_id": 127841
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n既然你選了我，那就要好好照顧我喔。",
    "voice": null,
    "unit_id": 127841
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n因為我可不準備輕易",
    "voice": null,
    "unit_id": 127841
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "退出這個[rub:位置]位置[/rub]。",
    "voice": null,
    "unit_id": 127841
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "相對地，",
    "voice": "vo_adv_9500080_009",
    "unit_id": 127841
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我也會",
    "voice": null,
    "unit_id": 127841
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "照顧你。",
    "voice": null,
    "unit_id": 127841
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n我會一輩子照顧",
    "voice": null,
    "unit_id": 127841
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……騎士先生的。",
    "voice": null,
    "unit_id": 127841
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "今後無論是麻煩事、棘手狀況、世界的危機、",
    "voice": "vo_adv_9500080_010",
    "unit_id": 127841
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n偷懶時或是被萊拉耶爾殿下跟老姊責罵時，",
    "voice": null,
    "unit_id": 127841
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n都是一人承擔一半喔。",
    "voice": null,
    "unit_id": 127841
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "請你做好覺悟吧。",
    "voice": null,
    "unit_id": 127841
  }
]
