    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "正確的公會名稱是",
    "voice": "vo_adv_5023001_047",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "【聖德蕾莎女學院（好朋友社）】",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "才對。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "真是的，優妮學姐",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "不可以這樣喔？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "那裡的名字已經",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "在地獄裡被焚化囉～",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我可還沒有放棄喔。",
    "voice": "vo_adv_5023001_048",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我會讓它不斷復活，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n讓眾人知道",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這個世界上有個優妮們……！",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "妳這是哪來的執迷不悟的遊魂啊？",
    "voice": "vo_adv_5023001_049",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那個也就是說",
    "voice": "vo_adv_5023001_050",
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這是個為了促進大家感情的公會囉……！",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "真不愧是BB團的團長……",
    "voice": "vo_adv_5023001_051",
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "不論身在何處，",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n都致力於達成BB團的目標……！",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "不過，",
    "voice": "vo_adv_5023001_052",
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "好朋友社的各位",
