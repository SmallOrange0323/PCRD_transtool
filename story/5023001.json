    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我不管到哪裡",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "依然都是一個人……",
