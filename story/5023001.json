    "words": "日安。",
    "voice": null,
    "unit_id": 3011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "打招呼的尖峰時段，",
    "voice": "vo_adv_5023001_002",
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n四處傳來日安的聲音……",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "唔，",
    "voice": "vo_adv_5023001_003",
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那氣場太過耀眼，眼睛都快瞎了……！",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "看來這裡",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "真的不是我該來的地方……！？",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "怎麼辦，",
    "voice": "vo_adv_5023001_004",
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "怎麼辦……",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "『有我在喔好朋友號V3』也忘了帶出來……",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "啊……",
    "voice": "vo_adv_5023001_005",
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "對了，",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我手上有那個……！",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "本來打算在特別講座時拿來用的",
    "voice": "vo_adv_5023001_006",
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n曼德拉草……！",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "曼德拉草",
