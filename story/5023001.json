    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "為什麼～？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "琪愛兒的特技",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "就是無論跟誰都能馬上變成好朋友啊！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n這點程度根本不要緊～",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "對吧，小碧……",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "……縮。",
    "voice": "vo_adv_5023001_069",
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "太遲了……",
    "voice": "vo_adv_5023001_070",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊～啊。",
    "voice": "vo_adv_5023001_071",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不過，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "突然讓她這樣的學生插班過來的人",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n是美里老師吧？　",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "真是相當斯巴達教育呢。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊？",
    "voice": "vo_adv_5023001_072",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "優妮",
