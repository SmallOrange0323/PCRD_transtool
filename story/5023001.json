    "voice": "vo_adv_5023001_010",
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "對了。",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n曼德拉草先生，",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "你能不能陪我練習呢？",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "至少，",
    "voice": "vo_adv_5023001_011",
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "得、",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "得要能夠打招呼才行……！",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "日、",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "日日、",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "日日日日……！",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "呀啊！？",
    "voice": "vo_adv_5023001_012",
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "啊，",
    "voice": "vo_adv_5023001_013",
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "曼德拉草先生！？",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n請、",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "請你不要丟下我！？",
