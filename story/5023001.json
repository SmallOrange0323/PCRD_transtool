    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "剛剛的聲音！？",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n原來這不是幻聽。",
    "voice": null,
    "unit_id": 110711
