  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "可愛度一百分滿分的一年級",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "琪愛兒～！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "切嚕～♪　",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "這種打招呼的方式",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "有一天一定會成為蘭德索爾全國的常識，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n所以從現在起就要盡量用喔～♪",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "好、",
    "voice": "vo_adv_5023001_032",
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "好刺眼……！",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "那個，",
    "voice": "vo_adv_5023001_033",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "為什麼妳都不看向琪愛兒這邊呢……？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "雖然琪愛兒的臉真的長得太正太耀眼了，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n不過遇到這種反應還是史上第一次，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "有點受到打擊。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "嗯……",
    "voice": "vo_adv_5023001_034",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "原來如此，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這就是那個吧？",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n碧，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我從剛剛觀察到現在的結果可以判斷出――",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "妳就是所謂的……",
    "voice": "vo_adv_5023001_035",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "邊緣人！",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "妳、",
    "voice": "vo_adv_5023001_036",
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "妳怎麼會知道……！？",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這沒有什麼好訝異的。",
    "voice": "vo_adv_5023001_037",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n我只是感覺到和我自己一樣的氣息罷了。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "優妮學姐，妳好厲害！　",
    "voice": "vo_adv_5023001_038",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "竟然毫不掩飾的大聲說自己是邊緣人！",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "啊～真的，",
    "voice": "vo_adv_5023001_039",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "她那驚慌的樣子，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n和優妮學姐如出一轍。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "真不愧是",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "邊緣人前輩。",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "呵呵。",
    "voice": "vo_adv_5023001_040",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "別說了。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "學妹們妳們太誇獎我了。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "啊，",
    "voice": "vo_adv_5023001_041",
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那個，",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這幾個人是……？",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "好朋友社……！？",
    "voice": "vo_adv_5023001_042",
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "真是個既閃亮",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "又美麗的名字啊……！",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "太刺眼了，",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "眼淚都……！",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "有這麼誇張嗎？　",
    "voice": "vo_adv_5023001_043",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "這真的是個好到讓人想哭的名字？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n琪愛兒，我完全沒想到會被誇成這樣？",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "這不過是超隨便地順勢決定的公會名稱而已",
