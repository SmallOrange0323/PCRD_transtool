    "type": "dialogue",
    "name": "碧",
    "words": "嗎……？",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這麼說起來，{0}你好像說過",
    "voice": "vo_adv_5023001_018",
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n自己正在聖德蕾莎女學院",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "就讀……",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "太好了……",
    "voice": "vo_adv_5023001_019",
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "真的是太好了……",
    "voice": null,
    "unit_id": 110711
  },
