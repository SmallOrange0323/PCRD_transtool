    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "你們為什麼會在這裡……？",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "是{0}拜託我們來的。",
    "voice": "vo_adv_5023001_053",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "對啊對啊",
    "voice": "vo_adv_5023001_054",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n說什麼他要去接插班生",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "怕她來的第一天會很不安，",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n所以拜託我們幾個",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "也一起來。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "就是俗稱的炒熱氣氛成員。",
    "voice": null,
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "他現在在協助我寫論文。",
    "voice": "vo_adv_5023001_055",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "既然是同志的要求",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我就無法拒絕。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "{0}，你竟然為了我……！",
    "voice": "vo_adv_5023001_056",
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "原來如此，",
    "voice": "vo_adv_5023001_057",
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "BB團和好朋友社，",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n目的都是要加深和某人的感情……！",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "那個什麼BB團？　",
    "voice": "vo_adv_5023001_058",
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我是不太清楚，",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "不過……",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "我有空的時候",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "也是可以帶妳認識校園喔？",
    "voice": null,
    "unit_id": 110811
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "當然我也是",
    "voice": "vo_adv_5023001_059",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "盡全力協助妳喔。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n異文化交流",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "在學術上的角度來看也是非常重要的。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n講白一點，",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "就是培養友情。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "我們同是邊緣人，",
    "voice": "vo_adv_5023001_060",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "不就應該要互相幫助嗎？",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "琪愛兒只要能和大家一起",
    "voice": "vo_adv_5023001_061",
    "unit_id": 110911
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "開開心心的做甚麼都行～！",
    "voice": null,
    "unit_id": 110911
  },
  {
