  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "很顯然是個現充……！　",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "琪愛兒……",
    "voice": "vo_adv_5023001_066",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "不可以這樣隨便肢體接觸啦。",
