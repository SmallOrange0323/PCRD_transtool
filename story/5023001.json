    "voice": "vo_adv_5023001_007",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "呵呵……",
    "voice": "vo_adv_5023001_008",
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "你好像很有精神真是太好了……",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我就如你所見……",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "說到頭來",
    "voice": "vo_adv_5023001_009",
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這對於邊緣人的我來說",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "根本就太勉強了。",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 110711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這種充滿青春氣息",
