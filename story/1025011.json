  {
    "type": "dialogue",
    "name": "旁白",
    "words": "即將日落的黃昏時分，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n有個人從遠方眺望著咲戀育幼院。",
