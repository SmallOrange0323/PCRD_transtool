    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n我怎麼",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "睡著了……？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "這裡是……",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "【美食殿堂】的公會小屋？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "我該不會",
    "voice": "vo_adv_1025011_088",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "又絆到什麼東西摔跤，",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n昏了過去吧！？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "是{0}把我送回來的嗎……？",
    "voice": "vo_adv_1025011_089",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不好意思──！\\n{0}──？",
    "voice": "vo_adv_1025011_090",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "……他不在？",
    "voice": "vo_adv_1025011_091",
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "會不會是去了",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "什麼地方呢……？",
    "voice": null,
    "unit_id": 102511
  },
  {
    "type": "background",
    "bg_id": "500113"
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "這樣啊，",
    "voice": "vo_adv_1025011_092",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n鈴莓她過得很好。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "……太好了。",
    "voice": "vo_adv_1025011_093",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "不過，",
    "voice": "vo_adv_1025011_094",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "想不到鈴莓她會那麼說。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "「笨蛋，",
    "voice": "vo_adv_1025011_095",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "才沒有那回事！」",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我真想",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "立刻衝去這麼對她大喊……",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "但是，",
    "voice": "vo_adv_1025011_096",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "這樣一定無法讓她",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "內心感到釋懷的。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "受不了，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "真叫人傷腦筋……",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "其他孩子們也都很想念她啊。",
    "voice": "vo_adv_1025011_097",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "拿她沒轍呢，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "真是的。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "……就是",
    "voice": "vo_adv_1025011_098",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "說啊。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我是有在準備製造機會了……",
    "voice": "vo_adv_1025011_099",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n畢竟要是說什麼交給時間解決，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n感覺就像是在為我們自己毫無作為",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "找藉口而已嘛。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "好吧，",
    "voice": "vo_adv_1025011_100",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "你可以稍等一下嗎？",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "不好意思，拜託你做了好多事，",
    "voice": "vo_adv_1025011_101",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n最後可以再聽我",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "一個請求嗎？",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "……只是這次會是有點粗暴的方法。",
    "voice": "vo_adv_1025011_102",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "咲戀說完後露出微笑，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n回到桌前開始寫起了些什麼。",
    "voice": null,
    "unit_id": null
  }
