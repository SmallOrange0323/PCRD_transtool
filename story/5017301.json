[
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "受了那麼多傷，",
    "voice": "vo_adv_5017301_000",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n居然還能以那樣的氣勢襲來……",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "……對於魔女教徒而言，",
    "voice": "vo_adv_5017301_001",
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "疼痛",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "以及死亡",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "都不具任何意義。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "他們擁有的",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "就只有瘋狂而已。",
    "voice": null,
    "unit_id": 109811
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "愛蜜莉雅大人，",
    "voice": "vo_adv_5017301_002",
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "這裡太危險了，請您退到後面。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n這裡就交給雷姆吧。",
    "voice": null,
    "unit_id": 109711
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "沒事的！",
    "voice": "vo_adv_5017301_003",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n我也是",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "很～強的！",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "不論對手是誰，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "我都會擊潰他的！",
    "voice": null,
    "unit_id": 109911
  }
]
