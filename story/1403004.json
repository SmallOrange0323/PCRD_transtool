    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "吉歐‧提格尼亞",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "沒有魔物。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "因為幻境龍后引起的騷動，",
    "voice": "vo_adv_1403004_005",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n讓背面世界也受到損害了。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "雖然也",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "不至於馬上就崩潰。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "「表面」世界這邊，",
    "voice": "vo_adv_1403004_006",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "有管理者米奈娃",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "挺身修復，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n接下來似乎也會進行維護。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\n但",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "「背面」世界",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "可沒有這種機制。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "不，",
    "voice": "vo_adv_1403004_007",
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "不要強人所難了。",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "\\nAI也有很多要考量的，",
    "voice": null,
    "unit_id": 193211
  },
  {
    "type": "dialogue",
    "name": "媞雅",
    "words": "像是規格效能、",
