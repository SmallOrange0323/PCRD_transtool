  },
  {
    "type": "dialogue",
    "name": "妖刀",
    "words": "漂亮。",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "妖刀",
    "words": "沒想到你只斬除了我的妖氣……",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "妖刀",
    "words": "\\n很好很好……",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "妖刀",
    "words": "如果是你這樣的使刀之人……",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小哥，",
    "voice": "vo_adv_1056006_077",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "有受傷嗎？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "沒有事吧？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "太好了……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我很久沒使過這招式，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "順利成功真是太好了。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "其實剛剛那招，",
    "voice": "vo_adv_1056006_078",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "本來打算在擊退幽靈時拿出來用。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "好了，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "現在這傢伙的力量已經被削弱了，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就算拿著它也沒問題。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "妖刀",
    "words": "呵、",
    "voice": "vo_adv_1056006_079",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "妖刀",
    "words": "呵呵……",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "妖刀",
    "words": "快消失了。",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "妖刀",
    "words": "我的意志逐漸在消失……",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "妖刀",
    "words": "\\n女人啊，妳的名字是？",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "啊？",
    "voice": "vo_adv_1056006_080",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我叫流夏。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "突然問這個做什麼",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "想當成帶去冥界的土產嗎？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "妖刀",
    "words": "我名為",
    "voice": "vo_adv_1056006_081",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "妖刀",
    "words": "「波浪丸」",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "妖刀",
    "words": "……妳正是",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "妖刀",
    "words": "配得上我的使刀之人……",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "妖刀",
    "words": "\\n啊啊，",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "妖刀",
    "words": "這麼一來，",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "妖刀",
    "words": "我終於能夠恢復成一把普通的刀了……",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "真是的。",
    "voice": "vo_adv_1056006_082",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就為了這件事搞那麼多名堂嗎？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n魯莽耿直也要有個限度啊……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不過，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "真是沒辦法。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "畢竟只是一把刀嘛。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……",
    "voice": "vo_adv_1056006_083",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小哥。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你知道，我現在最想跟你說的話是什麼嗎？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你這個笨蛋！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "為什麼要那麼做！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不要亂來啦，",
    "voice": "vo_adv_1056006_084",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "真是的……！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "跟你廝殺這種事，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我可不想碰上啊……！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就是啊！",
    "voice": "vo_adv_1056006_085",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "嚇得我以為心臟都停下來了！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那就好……",
    "voice": "vo_adv_1056006_086",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "以後不准再做那種事囉？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "好奇怪……",
    "voice": "vo_adv_1056006_087",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "現在放心的感覺，連自己都嚇了一跳。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小哥以前陪著我的時候，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "都是這種心情嗎？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "看到你出事",
    "voice": "vo_adv_1056006_088",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我已經很～清楚地了解那種擔心的感受了……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "以後我也盡量不要太胡來。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這樣就扯平了吧，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小哥。",
    "voice": null,
    "unit_id": 105611
  },
