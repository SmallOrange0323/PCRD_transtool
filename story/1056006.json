[
  {
    "type": "background",
    "bg_id": "500032"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "這一天，外出打工到了深夜才回家的{0}，\\n在回家路上遇見流夏──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "咦？小哥。",
    "voice": "vo_adv_1056006_000",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這麼晚要去哪裡啊？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "喔，你正要回家啊。",
    "voice": "vo_adv_1056006_001",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那就快點回去吧。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n最近蘭德索爾出現了隨機殺人的殺人魔，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你應該也聽說了吧？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "大家都很怕那傢伙。",
    "voice": "vo_adv_1056006_002",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我這幾天夜裡在路上看到的，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n只剩下對實力有自信的人，或是騎士團的騎士。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "雖然這附近有些店面還開著，",
    "voice": "vo_adv_1056006_003",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "但是裡面根本沒有客人。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "喔",
    "voice": "vo_adv_1056006_004",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你問我為何在這裡？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你應該已經猜到了吧。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我是被大家委託來擊退殺人魔的。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我很高興你有這個心，",
    "voice": "vo_adv_1056006_005",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "但這次真的很危險。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n如果你有個安全的地方可以待，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就趕快回去吧。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小哥……",
    "voice": "vo_adv_1056006_006",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "哈哈！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "確實如此！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你贏了。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我知道了。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不過，你絕對不可以離開我的身邊喔──",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "──哇啊啊啊啊啊啊！",
    "voice": "vo_adv_1056006_007",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "馬上就出現了嗎！",
    "voice": "vo_adv_1056006_008",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "走囉，小哥！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "background",
    "bg_id": "500012"
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "……",
    "voice": "vo_adv_1056006_009",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "喂你，",
    "voice": "vo_adv_1056006_010",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "還好嗎！？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "唔、",
    "voice": "vo_adv_1056006_011",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "嗯……",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "太好了。",
    "voice": "vo_adv_1056006_012",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "還有呼吸。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "你、你是……",
    "voice": "vo_adv_1056006_013",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "發生了什麼事？　",
    "voice": "vo_adv_1056006_014",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我們，",
    "voice": "vo_adv_1056006_015",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "本來想要打倒殺人魔……",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n可是，",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我們完全不是它的對手……",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "他的臉呢？",
    "voice": "vo_adv_1056006_016",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你沒有看到他的臉嗎？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "臉……",
    "voice": "vo_adv_1056006_017",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "那、",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "那東西，",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "根本不是人類……！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "要追過去的話，",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "你們也要小心……！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你也是。",
    "voice": "vo_adv_1056006_018",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "如果能動的話就趁早逃走吧。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "還是說需要叫人來幫忙？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "不，",
    "voice": "vo_adv_1056006_019",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我還能動，沒關係……",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "等等。",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我的搭檔不見了……！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n我的夥伴本來也在這裡啊。",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "你們沒有看見他嗎！？",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "沒有耶？",
    "voice": "vo_adv_1056006_020",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "他會不會是跑去叫人來幫忙了。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "如果看見他的話，會幫忙轉達你的狀況。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "再會！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "background",
    "bg_id": "500022"
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不是人類？",
    "voice": "vo_adv_1056006_021",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "難不成有魔物潛入城鎮來了嗎……？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "總之，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我們得在下一個被害者出現之前，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "找到殺人魔才行！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "騎士1",
    "words": "喝！",
    "voice": "vo_adv_1056006_022",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "青年",
    "words": "──唔哇！",
    "voice": "vo_adv_1056006_023",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那是……？",
    "voice": "vo_adv_1056006_024",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "騎士2",
    "words": "……",
    "voice": "vo_adv_1056006_025",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士2",
    "words": "呼。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士2",
    "words": "終於肯老實聽話了嗎。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士3",
    "words": "剛剛真的讓我捏了一把冷汗呢。",
    "voice": "vo_adv_1056006_026",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "騎士3",
    "words": "突然間就暴動起來……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "看來是不需要我們的幫忙了。",
    "voice": "vo_adv_1056006_027",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "騎士大人啊，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那傢伙是什麼人？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "傳聞中的殺人魔嗎？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "騎士1",
    "words": "我不知道。",
    "voice": "vo_adv_1056006_028",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "騎士1",
    "words": "他突然攻擊我們。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "騎士1",
    "words": "\\n不管怎麼樣，先把他抓起來帶走。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "騎士1",
    "words": "武器也得回收……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "是刀啊。",
    "voice": "vo_adv_1056006_029",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "在這一帶很少見的說……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "哎呀呀，事情解決了呢。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小哥，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "後面交給騎士團，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我們就先回去吧。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "騎士1",
    "words": "嗚啊啊啊啊啊！",
    "voice": "vo_adv_1056006_030",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "怎麼了！？",
    "voice": "vo_adv_1056006_031",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "騎士1（妖刀）",
    "words": "唔嗚嗚嗚嗚嗚嗚嗚……！",
    "voice": "vo_adv_1056006_032",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "騎士1（妖刀）",
    "words": "還不夠，",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "騎士1（妖刀）",
    "words": "還不夠……！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "騎士1（妖刀）",
    "words": "\\n不過這個身體，",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "騎士1（妖刀）",
    "words": "似乎比剛剛的還要堪用一些……！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "騎士2",
    "words": "怎、",
    "voice": "vo_adv_1056006_033",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士2",
    "words": "怎麼回事……！？",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士2",
    "words": "這、到底……！！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "魔物！？",
    "voice": "vo_adv_1056006_034",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不，不對……！？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "騎士1（妖刀）",
    "words": "嘎嘎嘎嘎……！",
    "voice": "vo_adv_1056006_035",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "騎士1（妖刀）",
    "words": "我的模樣終於也能顯現出來了……！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "騎士1（妖刀）",
    "words": "\\n那邊那個女人。",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "騎士1（妖刀）",
    "words": "看來是個相當不錯的使刀之人……！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "騎士3",
    "words": "怎麼了！",
    "voice": "vo_adv_1056006_036",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "騎士3",
    "words": "振作一點！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "原來如此，",
    "voice": "vo_adv_1056006_037",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那把刀……！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我還小的時候，曾在故鄉聽過一個故事……",
    "voice": "vo_adv_1056006_038",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "雖是物品，卻擁有自我意識的妖刀……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那把刀，一定也是同一種刀！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "騎士2",
    "words": "喂，",
    "voice": "vo_adv_1056006_039",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士2",
    "words": "發生什麼事了！？",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你聽好！",
    "voice": "vo_adv_1056006_040",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你們的夥伴，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "被那把刀給附身了！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n若不把刀從手上打落，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你的夥伴就會繼續被刀操縱！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "騎士1（妖刀）",
    "words": "嘎哈哈！",
    "voice": "vo_adv_1056006_041",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "騎士1（妖刀）",
    "words": "高興吧……",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "騎士1（妖刀）",
    "words": "你們所有人，",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "騎士1（妖刀）",
    "words": "都會在這裡被我斬殺！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "background",
    "bg_id": "500022"
  },
  {
    "type": "dialogue",
    "name": "騎士2",
    "words": "哇啊啊！",
    "voice": "vo_adv_1056006_042",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那傢伙，好強……！",
    "voice": "vo_adv_1056006_043",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小哥，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我們來幫忙吧！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "騎士3",
    "words": "不，你們幾個快逃！",
    "voice": "vo_adv_1056006_044",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "騎士3",
    "words": "\\n不能讓應該保護的平民遭遇危險！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "別說傻話了！",
    "voice": "vo_adv_1056006_045",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "光靠你們幾個是贏不了的！！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "騎士2",
    "words": "可是……我們是騎士！",
    "voice": "vo_adv_1056006_046",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士2",
    "words": "不可以逃走！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不要在這裡堅持這種無聊的原則！",
    "voice": "vo_adv_1056006_047",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你們打算為了面子犧牲性命嗎！？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "騎士1（妖刀）",
    "words": "這女的說得對……！",
    "voice": "vo_adv_1056006_048",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "騎士1（妖刀）",
    "words": "連自己有多少斤兩都搞不清楚的蠢貨……！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "騎士1（妖刀）",
    "words": "\\n現在就讓你們死在這裡……！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "騎士3",
    "words": "哇、哇啊啊啊啊！",
    "voice": "vo_adv_1056006_049",
    "unit_id": 711
  },
  {
    "type": "background",
    "bg_id": "500022"
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小哥！",
    "voice": "vo_adv_1056006_050",
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "助我一臂之力！",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n我不會讓任何人，",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "在我的面前死掉──！",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "騎士1（妖刀）",
    "words": "唔！",
    "voice": "vo_adv_1056006_051",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "騎士1（妖刀）",
    "words": "嘎哈哈哈哈！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "騎士1（妖刀）",
    "words": "女人！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "騎士1（妖刀）",
    "words": "妳果然很強啊！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "多謝誇獎！",
    "voice": "vo_adv_1056006_052",
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "喝！！",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "background",
    "bg_id": "500022"
  },
  {
    "type": "dialogue",
    "name": "騎士1（妖刀）",
    "words": "唔喔！",
    "voice": "vo_adv_1056006_053",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "騎士1（妖刀）",
    "words": "哈哈哈！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "騎士1（妖刀）",
    "words": "好危險！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "騎士2",
    "words": "好強……！",
    "voice": "vo_adv_1056006_054",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "騎士2",
    "words": "竟然能打成平手……！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你們在幹什麼！",
    "voice": "vo_adv_1056006_055",
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "別在那裡發呆，快去找人來幫忙！",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "騎士3",
    "words": "好、好的！",
    "voice": "vo_adv_1056006_056",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "哪是平手。",
    "voice": "vo_adv_1056006_057",
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這傢伙，",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "居然用他附身的肉體當作盾牌……",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n我想把刀從他手中打飛，或是把刀打斷，",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n但再這樣下去根本沒完沒了！",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不過是個妖怪，",
    "voice": "vo_adv_1056006_058",
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "竟然搞這種小手段！",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這樣一來也能分散那傢伙的注意力吧。",
    "voice": "vo_adv_1056006_059",
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "好主意，小哥！",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "採取夾擊嗎？",
    "voice": "vo_adv_1056006_060",
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "收到！",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "騎士1（妖刀）",
    "words": "夾擊嗎，",
    "voice": "vo_adv_1056006_061",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "騎士1（妖刀）",
    "words": "真是無聊的招數！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小哥，",
    "voice": "vo_adv_1056006_062",
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就是現在！",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "background",
    "bg_id": "500022"
  },
  {
    "type": "dialogue",
    "name": "騎士1（妖刀）",
    "words": "哼！",
    "voice": "vo_adv_1056006_063",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "騎士1（妖刀）",
    "words": "光憑這點力量",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "騎士1（妖刀）",
    "words": "就想挑戰我，太愚蠢了！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "有破綻！",
    "voice": "vo_adv_1056006_064",
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "得手了！",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "background",
    "bg_id": "500022"
  },
  {
    "type": "dialogue",
    "name": "騎士1（妖刀）",
    "words": "什麼！",
    "voice": "vo_adv_1056006_065",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "騎士1（妖刀）",
    "words": "唔唔……！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "好，",
    "voice": "vo_adv_1056006_066",
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "把刀彈出去了！",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "妖刀",
    "words": "妳這傢伙……！",
    "voice": "vo_adv_1056006_067",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "妖刀",
    "words": "我得趕快找一個新的宿主……",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "刀竟然會自己移動！？",
    "voice": "vo_adv_1056006_068",
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不妙，會被它逃走！",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小哥，",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我們不能讓它逃走！",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "妖刀",
    "words": "唔？",
    "voice": "vo_adv_1056006_069",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "妖刀",
    "words": "你這傢伙",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "妖刀",
    "words": "把我拿在手上了？",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "妖刀",
    "words": "\\n好吧，",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "妖刀",
    "words": "既然這樣我就成全你！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你在幹什麼！",
    "voice": "vo_adv_1056006_070",
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "快把它放下！快點！",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "妖刀",
    "words": "嗯，",
    "voice": "vo_adv_1056006_071",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "妖刀",
    "words": "雖然比剛剛那個瘦弱，不過沒關係！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "妖刀",
    "words": "\\n逃離這裡比較重要……！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "妖刀",
    "words": "……",
    "voice": "vo_adv_1056006_072",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "妖刀",
    "words": "怎麼回事，",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "妖刀",
    "words": "為何身體不能動！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "妖刀",
    "words": "這傢伙，你以為能反抗我嗎！？",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "妖刀",
    "words": "\\n怎麼可能！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "妖刀",
    "words": "這麼瘦弱的身體，",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "妖刀",
    "words": "竟藏有如此強大的意志……！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "難不成，",
    "voice": "vo_adv_1056006_073",
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你封住了它的行動！？",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "難道你……",
    "voice": "vo_adv_1056006_074",
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "一開始就打算這麼做嗎……！",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……交給我吧。",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我會砍得乾淨俐落的！",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "讓你品嘗一下吧，",
    "voice": "vo_adv_1056006_075",
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我的絕妙刀法！妖刀混帳！",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n秘劍，",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "零之太刀！",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "水月鏡花！",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "background",
