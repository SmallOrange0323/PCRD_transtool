[
  {
    "type": "background",
    "bg_id": "509040"
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "哦～",
    "voice": "vo_adv_9500053_000",
    "unit_id": 100841
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "既然你選擇了我，",
    "voice": null,
    "unit_id": 100841
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "就代表你已經得出答案了呢。",
    "voice": null,
    "unit_id": 100841
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n對於「這世上最美麗的人是誰」",
    "voice": null,
    "unit_id": 100841
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這個問題。",
    "voice": null,
    "unit_id": 100841
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100841
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "嗯，",
    "voice": null,
    "unit_id": 100841
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我可是等不及了。",
    "voice": null,
    "unit_id": 100841
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不過，",
    "voice": "vo_adv_9500053_001",
    "unit_id": 100841
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你大可以對自己有信心。",
    "voice": null,
    "unit_id": 100841
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你的審美眼光毫無疑問地，",
    "voice": null,
    "unit_id": 100841
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n擁有看見美麗事物的能力。",
    "voice": null,
    "unit_id": 100841
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你可以為此感到自豪喔。",
    "voice": "vo_adv_9500053_002",
    "unit_id": 100841
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n為自己選擇了我這件事。",
    "voice": null,
    "unit_id": 100841
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "而且，",
    "voice": "vo_adv_9500053_003",
    "unit_id": 100841
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我也希望你放心。",
    "voice": null,
    "unit_id": 100841
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100841
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "因為我會和你約好，",
    "voice": null,
    "unit_id": 100841
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "絕對不會讓你後悔選擇了我。",
    "voice": null,
    "unit_id": 100841
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "無論男女，",
    "voice": "vo_adv_9500053_004",
    "unit_id": 100841
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "無論老少，",
    "voice": null,
    "unit_id": 100841
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "都會被美麗的事物所吸引，",
    "voice": null,
    "unit_id": 100841
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n這就是這個世界的真理呢。",
    "voice": null,
    "unit_id": 100841
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100841
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "如你所知，",
    "voice": null,
    "unit_id": 100841
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我也對美麗的事物毫無抵抗力，",
    "voice": null,
    "unit_id": 100841
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "所以我能理解喔。",
    "voice": null,
    "unit_id": 100841
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我是美麗的。",
    "voice": "vo_adv_9500053_005",
    "unit_id": 100841
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100841
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "而且，",
    "voice": null,
    "unit_id": 100841
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "只要待在你身邊，",
    "voice": null,
    "unit_id": 100841
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我就能成為更加美麗的自己。",
    "voice": null,
    "unit_id": 100841
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "擁有相同審美意識的人待在一起，",
    "voice": "vo_adv_9500053_006",
    "unit_id": 100841
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "本來就是很自然的事，",
    "voice": null,
    "unit_id": 100841
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n而我們的關係本身，",
    "voice": null,
    "unit_id": 100841
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "也應當作為極其美麗的事物，",
    "voice": null,
    "unit_id": 100841
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n映入許多人的眼簾。",
    "voice": null,
    "unit_id": 100841
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我相信那些仰慕著你的女孩們",
    "voice": "vo_adv_9500053_007",
    "unit_id": 100841
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "也會理解的喔。",
    "voice": null,
    "unit_id": 100841
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100841
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "因為究極之美這種東西，",
    "voice": null,
    "unit_id": 100841
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "有時是會超越常理的。",
    "voice": null,
    "unit_id": 100841
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "還有……",
    "voice": "vo_adv_9500053_008",
    "unit_id": 100841
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "也讓我對你說幾句話吧。",
    "voice": null,
    "unit_id": 100841
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100841
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "因為明明是你先向我展現誠意的，",
    "voice": null,
    "unit_id": 100841
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n我卻只是單方面接受，",
    "voice": null,
    "unit_id": 100841
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "那可一點也不美呢。",
    "voice": null,
    "unit_id": 100841
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "謝謝你",
    "voice": "vo_adv_9500053_009",
    "unit_id": 100841
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "選擇了我。",
    "voice": null,
    "unit_id": 100841
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "就讓美麗的我，",
    "voice": "vo_adv_9500053_010",
    "unit_id": 100841
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "與認為我很美麗的你，",
    "voice": null,
    "unit_id": 100841
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n一起成為人人稱羨、美麗的我們吧。",
    "voice": null,
    "unit_id": 100841
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100841
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "永生永世，",
    "voice": null,
    "unit_id": 100841
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "永永遠遠。",
    "voice": null,
    "unit_id": 100841
  }
]
