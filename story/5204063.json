    "name": "流夏",
    "words": "\\n喂，",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "等一下。",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……咦？",
    "voice": "vo_adv_5204063_026",
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你們",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "是彩羽的朋友嗎？",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n但……",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "妳",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不是說妳沒朋友……",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "啊哈哈！",
    "voice": "vo_adv_5204063_027",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "彩羽沒朋友什麼的，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "那種事是不可能的啦！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "\\n不如說是最多的！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "\\n因為她跟我們學校的",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "所有小孩都是朋友！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "……跟從１年級到６年級的所有男女都是，",
    "voice": "vo_adv_5204063_028",
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n而且",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "連飼養的兔子、烏龜、雞也是朋友？",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "……這是怎麼回事？",
    "voice": null,
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "嗯？",
    "voice": "vo_adv_5204063_029",
    "unit_id": 132431
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "彩羽有確實說了喔？",
    "voice": null,
    "unit_id": 132431
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n說沒有朋友",
    "voice": null,
    "unit_id": 132431
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "「跟彩羽玩躲避球」。",
    "voice": null,
    "unit_id": 132431
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "啊哈哈，",
    "voice": "vo_adv_5204063_030",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "\\n因為彩羽躲避球太強了，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "連國中生都能贏。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "\\n沒有任何人想跟彩羽玩躲避球。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……那，",
    "voice": "vo_adv_5204063_031",
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那個眼淚是？",
    "voice": null,
    "unit_id": 105631
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "嘻嘻，",
    "voice": "vo_adv_5204063_032",
    "unit_id": 132431
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "彩羽是演技派吧♪",
    "voice": null,
    "unit_id": 132431
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "……啊啊？",
    "voice": "vo_adv_5204063_033",
    "unit_id": 102731
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "雖然流夏和惠理子被彩羽的演技給騙到了，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n但不知為何卻也有種被那演技幫助的感覺。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "……前世說不定也曾發生過這種事。",
    "voice": null,
    "unit_id": null
  }
]
