[
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "除了咲戀小姐和可可蘿以外，",
    "voice": "vo_adv_6017108_000",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n蘭德索爾還有很多妖精呢。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "在露格尼卡，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "妖精是不會走在街上的……",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "……嗯。",
    "voice": "vo_adv_6017108_001",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n真的，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "蘭德索爾",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "對我而言",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "是一個奇蹟般的國家――",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "在這裡，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "能認識你們幾位",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "真的是太好了。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "的確",
    "voice": "vo_adv_6017108_002",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "和其他種族比起來並不多，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "不過還蠻常在路上看到喔？",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n當然，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "也有可能是因為我特別在意才這麼覺得。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "原來是這樣呀。",
    "voice": "vo_adv_6017108_003",
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "有機會的話",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "真想去瞧瞧。",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "當然，",
    "voice": null,
    "unit_id": 109911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "也要找咲戀小姐和可可蘿一起去。",
    "voice": null,
    "unit_id": 109911
  }
]
