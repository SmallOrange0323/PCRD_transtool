  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110031
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "你怎麼在這裡呢～！？",
    "voice": null,
    "unit_id": 110031
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110031
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "你說現在是你打工的休息時間？　",
    "voice": null,
    "unit_id": 110031
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "原來如此～！",
    "voice": null,
    "unit_id": 110031
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家",
    "voice": "vo_adv_1100004_009",
    "unit_id": 110031
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "是來拍攝泳衣的撮影唷～",
