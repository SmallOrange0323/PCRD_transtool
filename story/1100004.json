    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "哎呀！　",
    "voice": "vo_adv_1100004_007",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "好耀眼！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "這個光是……！？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "background",
    "bg_id": "510250"
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "咦？　",
    "voice": "vo_adv_1100004_008",
    "unit_id": 110031
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才？",
