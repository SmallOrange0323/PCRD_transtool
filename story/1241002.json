[
  {
    "type": "background",
    "bg_id": "500036"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "為了讓人們獲得幸福，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n依里和{0}今天也來到了街上。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "好，",
    "voice": "vo_adv_1241002_000",
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "今天也換上了這套衣服，",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n來努力蒐集點數吧。",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "咦？",
    "voice": "vo_adv_1241002_001",
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n我、",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我知道你是想要稱讚我！",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "但禁止你突然說這種話！",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "被稱讚太多次的話，",
    "voice": "vo_adv_1241002_002",
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我的心臟會受不了的！",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "真是少根筋！",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "又遲鈍！",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "而且還超級天然呆！　",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "咦？",
    "voice": "vo_adv_1241002_003",
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "聽你這麼一說，",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我今天好像很自然地",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "就穿上了這套衣服……",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "似乎",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "都沒有什麼特別的感覺了……！？",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "難道說，",
    "voice": "vo_adv_1241002_004",
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "你也看膩我這身裝扮了嗎？",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "……啊，",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我沒有什麼特別的涵義。",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n你說沒這回事？",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "……哦～",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "是這樣啊～？",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "啊，",
    "voice": "vo_adv_1241002_005",
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "真是的，",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "這下話題不都扯遠了嗎……！",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n現在得優先處理天使的工作，",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "別管我穿的衣服了！",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "要開始尋找感到困擾的人囉！",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "啊啊～",
    "voice": "vo_adv_1241002_006",
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "這下真是麻煩了……",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "\\n",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "我到底該怎麼辦才好！",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "\\n再這樣下去，",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "我準備的活動就要泡湯了！",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "那、",
    "voice": "vo_adv_1241002_007",
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "那個……",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "嗯？",
    "voice": "vo_adv_1241002_008",
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "\\n你們……",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "該不會是天使吧！？",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "\\n",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "啊啊～",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "能見到你們真是太湊巧了！",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "我果然很好運！",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "這、",
    "voice": "vo_adv_1241002_009",
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "這樣啊……",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "哎呀，",
    "voice": "vo_adv_1241002_010",
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "我還沒有自我介紹呢。",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "\\n",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "我是專門舉辦各種活動的表演家……",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "\\n也就是活動主辦人。",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "活動……",
    "voice": "vo_adv_1241002_011",
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "啊，",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "畢竟是聖誕節嘛。",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "那麼，",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "你是為了什麼事情感到困擾呢……？",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "沒錯，",
    "voice": "vo_adv_1241002_012",
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "我現在真的傷透腦筋。",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "其實……",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "\\n",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "本次由我主辦的活動，",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "\\n其中最大的賣點正面臨停辦的危機！",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "你說要停辦？",
    "voice": "vo_adv_1241002_013",
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "怎麼會這麼嚴重……",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "在我說明理由之前，",
    "voice": "vo_adv_1241002_014",
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "\\n必須先讓你們了解本次活動的內容才行。",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "\\n我就來大致介紹一下吧。",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "本次的活動……！",
    "voice": "vo_adv_1241002_015",
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "\\n簡單來說，",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "就是──",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "冰上滑行！",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "冰上……？",
    "voice": "vo_adv_1241002_016",
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "在蘭德索爾的一處，準備一座結冰的巨大池塘，",
    "voice": "vo_adv_1241002_017",
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "\\n讓大家能夠快樂地在上面滑冰！",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "幸虧在蘭德索爾，",
    "voice": "vo_adv_1241002_018",
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "也有人會在結凍的地面滑冰，",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "\\n要湊齊道具其實並不困難。",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "\\n",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "事前準備可說是非常順利。",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "……就在這個時候，",
    "voice": "vo_adv_1241002_019",
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "\\n",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "發生了大問題！",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "\\n在準備最重要的冰塊時碰到了困難……",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "在預計前往的冰山附近，",
    "voice": "vo_adv_1241002_020",
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "\\n似乎出現了魔物。",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "\\n",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "而且據說非常兇暴，一般的冒險者根本無法對抗……",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "兇暴的魔物……",
    "voice": "vo_adv_1241002_021",
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "的確是不太想靠近呢。",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n搬運物品時就更不用說了。",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "沒錯……",
    "voice": "vo_adv_1241002_022",
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "這樣下去聖誕季就要結束了。",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "\\n",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "我不僅已經做了宣傳，",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "更重要的是活動有時效性！",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "\\n要是錯過這個時機，",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "虧損可是無法估計！",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "也就是說，",
    "voice": "vo_adv_1241002_023",
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "只要設法解決那隻魔物就好了吧。",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "這樣我們應該可以幫上忙。",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "只是……",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "那個，",
    "voice": "vo_adv_1241002_024",
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我想請問一下……",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n為什麼要舉辦在冰上滑的活動呢？",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "感覺有點危險……",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "對，",
    "voice": "vo_adv_1241002_025",
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "妳說得沒錯！",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "\\n答案就是那股",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "「有點危險」的感覺！",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "咦？",
    "voice": "vo_adv_1241002_026",
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "在冰上的確有可能會不小心滑倒。",
    "voice": "vo_adv_1241002_027",
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "\\n光看這點的話，",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "冰上滑行就只是個危險行為。",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "不過……",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "\\n",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "要是身旁有親密的人，",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "妳不覺得狀況就不一樣了嗎？",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "親密的人……？",
    "voice": "vo_adv_1241002_028",
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "人在快要滑倒的時候，",
    "voice": "vo_adv_1241002_029",
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "會下意識地伸出手。",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "\\n而身旁的人",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "也會想要出手幫助。",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "\\n",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "如此一來，",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "就不難想像兩人會握住對方的手。",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "…………原來如此。",
    "voice": "vo_adv_1241002_030",
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "因為差點滑倒，",
    "voice": "vo_adv_1241002_031",
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "妳一定會感到心跳加速。",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "\\n加上手被親密的人握住，",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "肯定會更加臉紅心跳。",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "\\n而對方因為擔心妳，",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "想必也不會鬆手。",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "……原來如此？",
    "voice": "vo_adv_1241002_032",
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "由於兩人都還站在冰上，",
    "voice": "vo_adv_1241002_033",
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "事情當然不會",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "就這樣結束。",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "\\n雙方都還有可能會滑倒。",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "\\n",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "這麼一來……",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "下次或許就不是只有握手那麼簡單了。",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "可能會抱住手臂、",
    "voice": "vo_adv_1241002_034",
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "摟住對方肩膀，",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "甚至有時還會緊緊相擁……！",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "\\n隨時都可能發生",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "這種不可抗力的身體接觸！",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "\\n",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "怎麼樣？",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "充滿了娛樂效果對吧？",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "原來如此……！",
    "voice": "vo_adv_1241002_035",
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "這個想法",
    "voice": "vo_adv_1241002_036",
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "很不錯呢！",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n尤其是不可抗力的部分真是太棒了！",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "對吧對吧！",
    "voice": "vo_adv_1241002_037",
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "\\n這種並非刻意營造的感覺很棒吧！",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "我是",
    "voice": "vo_adv_1241002_038",
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "這麼想的。",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "\\n",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "只要這個活動能夠成功，",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "冰上滑行就會成為冬天約會的經典行程！",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "\\n",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "因此，",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "主辦人",
    "words": "我無論如何都需要準備冰塊！",
    "voice": null,
    "unit_id": 2512
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "……我很清楚",
    "voice": "vo_adv_1241002_039",
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "活動主辦人的想法了。",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n請務必讓我們幫忙！",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n就由我這位天使來守護",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "嶄新的冬天文化！",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我說，",
    "voice": "vo_adv_1241002_040",
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "{0}也是這麼想的對吧？",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n一定是吧？",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n好，",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "就這麼決定了！",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "background",
    "bg_id": "500540"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就這樣──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n依里和{0}為了護衛搬運冰塊的人，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n動身前往雪山的深處。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "哈、",
    "voice": "vo_adv_1241002_041",
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "哈……",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "哈啾！",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "活動工作人員1",
    "words": "哎呀。",
    "voice": "vo_adv_1241002_042",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "活動工作人員1",
    "words": "\\n你們兩位",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "活動工作人員1",
    "words": "都還好吧？",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "啊，",
    "voice": "vo_adv_1241002_043",
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "是、",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "是的，",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我沒問題。",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n不過……",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n雪山",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "還真的是很冷呢……",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "活動工作人員2",
    "words": "沒錯，",
    "voice": "vo_adv_1241002_044",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "活動工作人員2",
    "words": "完全無法跟城鎮內的氣溫相比對吧？",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "活動工作人員2",
    "words": "\\n但也因為這樣，",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "活動工作人員2",
    "words": "才能形成高品質的冰塊。",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "活動工作人員1",
    "words": "再走一段路，",
    "voice": "vo_adv_1241002_045",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "活動工作人員1",
    "words": "就能看到結冰的泉水了。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "活動工作人員1",
    "words": "\\n",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "活動工作人員1",
    "words": "……另外，據說魔物的出沒地點，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "活動工作人員1",
    "words": "主要就是在那附近。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "活動工作人員2",
    "words": "不要碰到魔物",
    "voice": "vo_adv_1241002_046",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "活動工作人員2",
    "words": "當然是最好的……",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "活動工作人員2",
    "words": "\\n",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "活動工作人員2",
    "words": "但萬一真的出現，",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "活動工作人員2",
    "words": "就得拜託天使你們了。",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "活動工作人員1",
    "words": "我們對戰鬥",
    "voice": "vo_adv_1241002_047",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "活動工作人員1",
    "words": "真的是一竅不通。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "活動工作人員1",
    "words": "\\n雖然有配戴護身用的裝備，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "活動工作人員1",
    "words": "但本業還是活動的後勤人員。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "魔物",
    "voice": "vo_adv_1241002_048",
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "就交給我們對付吧。",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n我們絕對會",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "保護各位工作人員──",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "呀啊",
    "voice": "vo_adv_1241002_049",
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "！？",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "嗚嗚，",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "風也變得越來越強了……！",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "咦……？",
    "voice": "vo_adv_1241002_050",
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "你、",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "你不用這樣做啦。",
    "voice": null,
    "unit_id": 124111
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124111
  },
  {
