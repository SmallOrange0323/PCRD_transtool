    "voice": "vo_adv_1241002_075",
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "呀！",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n呵呵，",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "這還蠻有趣的嘛♪",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n我",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "說不定很有天分呢。",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "咦，",
    "voice": "vo_adv_1241002_076",
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "奇怪？",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n……那傢伙",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "怎麼離得那麼遠？",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "而且還一副快跌倒的樣子。",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "啊……",
    "voice": "vo_adv_1241002_077",
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "這麼說來，自從掌握到訣竅後，",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n我好像就把他丟著不管了。",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "啊哈哈……",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "太沉迷也不是好事呢。",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "…………",
    "voice": "vo_adv_1241002_078",
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "真是拿他沒辦法。",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "still",
    "still_id": "124100201"
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "──來吧。",
    "voice": "vo_adv_1241002_079",
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "你在發什麼呆啊？",
    "voice": "vo_adv_1241002_080",
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "好了……",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n快點",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "握住我的手。",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我可沒有特別的意思！",
    "voice": "vo_adv_1241002_081",
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n只是你雙腿抖得像剛出生的小鹿，",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n讓人不忍心看下去罷了。",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "就只是這樣而已！",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "所以說……",
    "voice": "vo_adv_1241002_082",
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n你不用",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "顧慮些什麼。",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "兩個人牽著手應該比較不容易滑倒，",
    "voice": "vo_adv_1241002_083",
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "而且我或許也能教你訣竅。",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "另外就是……",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "嗚～～～",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "still",
    "still_id": "124100202"
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "啊……",
    "voice": "vo_adv_1241002_084",
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "沒、",
    "voice": "vo_adv_1241002_085",
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "沒錯。",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n這樣就好……",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "嗯。",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "那麼……",
    "voice": "vo_adv_1241002_086",
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n我們就",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "一起滑吧。",
    "voice": null,
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "……小心不要放開我的手喔。",
    "voice": "vo_adv_1241002_087",
    "unit_id": 124112
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}溫柔地握緊依里的手，",
    "voice": null,
    "unit_id": null
  },
  {
