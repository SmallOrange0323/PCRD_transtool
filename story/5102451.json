  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "\\nわたあめちゃんを",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "元のいい子に戻して、",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "霊界に帰してあげて……",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "ハロウィンセイバーズ、",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "大勝利さ～♪",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "でも正直……",
    "voice": "vo_adv_5076451_001",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "\\nわたあめちゃんとお別れしちゃうのは、",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "ちょっぴり寂しいさ～……",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "スズナ",
    "words": "だよねー……",
    "voice": "vo_adv_5076451_002",
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "スズナ",
    "words": "けど、",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "スズナ",
    "words": "ま、",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "スズナ",
    "words": "いつかまた会えるんじゃん？",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "スズナ",
    "words": "\\n",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "スズナ",
    "words": "なんなら、",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "スズナ",
    "words": "うちらが霊界に",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "スズナ",
    "words": "遊びに行ってもいいし！",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "スズナ",
    "words": "\\n",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "スズナ",
    "words": "行き方はわかんないけど、",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "スズナ",
    "words": "ヒデサイがいれば",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "スズナ",
    "words": "なんとかなるっしょ！",
    "voice": null,
    "unit_id": 117911
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "ハイ！　",
    "voice": "vo_adv_5076451_003",
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "わたあめちゃんに会いに行くのは",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "大賛成デス！",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "\\n",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "それに、",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "霊界も",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "ショーグンが治めるべき土地かもしれまセン。",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "\\n",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "ショーグンの家来として、",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "機会があれば",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "一度",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "行ってみたいデス！",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "二人とも、",
    "voice": "vo_adv_5076451_004",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "ずいぶん大胆だね～！　",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "けど、",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "いい考えかもしれないさ～♪",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "もし遊びに行く時は、",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "わたあめちゃんや霊界の王様のために、",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "\\nたくさんサーターアンダギーを持ってってあげるさ～♪",
    "voice": null,
