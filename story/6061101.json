  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "啊啊，",
    "voice": "vo_adv_6061101_000",
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "真教人難以置信！",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我竟然可以出席憧憬的舞會！",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不過，",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "這未免進行得太順利了，",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "該、",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "該不會",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "是在做夢吧？",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "既然你這麼說了，",
    "voice": "vo_adv_6061101_001",
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "那這肯定不是夢。",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "但是，",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "發生了比夢還要更不可思議的事……",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "人生實在是令人難以捉摸啊。",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "呀啊！",
    "voice": "vo_adv_6061101_002",
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "你這是在做什麼啊……",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "咦？",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "為了確認這是不是夢？",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我的確已經知道這不是在做夢了，不過，",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n除了我之外，",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "你可別對其他女孩子也這麼做喔。",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "咦？",
    "voice": "vo_adv_6061101_003",
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "這個嘛……",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "如果是做夢那也無所謂。",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n就算是做夢，",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我所憧憬的舞台還是沒有改變。",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 105214
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不好好享受就太可惜了♪",
    "voice": null,
    "unit_id": 105214
  }
]
