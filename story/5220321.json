[
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "呀啊！？",
    "voice": "vo_adv_5220321_000",
    "unit_id": 140611
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n出現了好多魔物喔？",
    "voice": null,
    "unit_id": 140611
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "又接二連三湧出來了……",
    "voice": "vo_adv_5220321_001",
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "別來礙事啊……！",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "魔物會採取數量優勢，",
    "voice": "vo_adv_5220321_002",
    "unit_id": 140411
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n這或許印證了對方已經被逼入了絕境。",
    "voice": null,
    "unit_id": 140411
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n雖然不是什麼難纏的對手，",
    "voice": null,
    "unit_id": 140411
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "但還是要小心別被偷襲了。",
    "voice": null,
    "unit_id": 140411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "了解！",
    "voice": "vo_adv_5220321_003",
    "unit_id": 140611
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n要把這些傢伙全部一網打盡，",
    "voice": null,
    "unit_id": 140611
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "一口氣解決掉！",
    "voice": null,
    "unit_id": 140611
  }
]
