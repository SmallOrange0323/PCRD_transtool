[
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "犯人到處逃跑，",
    "voice": "vo_adv_5104204_000",
    "unit_id": 123911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n一直沒辦法把他抓住……",
    "voice": null,
    "unit_id": 123911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "不過，",
    "voice": "vo_adv_5104204_001",
    "unit_id": 123911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "這點程度的困難可打不倒我！",
    "voice": null,
    "unit_id": 123911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n逮捕犯人所需要的，",
    "voice": null,
    "unit_id": 123911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "第一是毅力，",
    "voice": null,
    "unit_id": 123911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "第二也是毅力！",
    "voice": null,
    "unit_id": 123911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "是啊，",
    "voice": "vo_adv_5104204_002",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "況且我們也不是完全白跑一趟。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "就讓他趁現在儘管逃竄吧。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "敵人越是死纏爛打，",
    "voice": "vo_adv_5104204_003",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我就能享受得越久……",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這場你追我跑的代價，",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我可要他一分不少地付出來♪",
    "voice": null,
    "unit_id": 123811
  }
]
