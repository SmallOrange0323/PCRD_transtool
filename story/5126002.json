  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在凱留一行人插班進來後過了幾天，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n有新的插班生來到了廢柴班。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "班導",
    "words": "好，",
    "voice": "vo_adv_5126002_000",
    "unit_id": 915
  },
  {
    "type": "dialogue",
    "name": "班導",
    "words": "那麼大家就按照順序",
    "voice": null,
    "unit_id": 915
  },
  {
    "type": "dialogue",
    "name": "班導",
    "words": "來打招呼吧──",
    "voice": null,
    "unit_id": 915
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "各位初次見面。",
    "voice": "vo_adv_5126002_001",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我的名字",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "叫做惠理子。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "但是不必記住我的名字沒關係。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "因為除了這邊這位以外的人，我都沒有興趣。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "嘻嘻……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "大家早安！",
    "voice": "vo_adv_5126002_002",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我是璃乃！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n雖然我不擅長魔法，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "但我會接近星力好好努力的！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "……什麼？",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "應該是竭盡心力？",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "也是有那種說法呢！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "魔法學園的",
    "voice": "vo_adv_5126002_003",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "各位，",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "注意聽來！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我是",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "自異國之地前來此處的",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "妮諾是也──！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n今後還請銘記於心──！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "咻啪啪！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "又有一群看起來不得了的傢伙插班進來了呢……",
    "voice": "vo_adv_5126002_004",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "雖然感覺確實是會引起話題啦。",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "呀哈哈～♪",
    "voice": "vo_adv_5126002_005",
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "大家多指教囉～♪",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "感覺之後會變更開心呢，",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才！",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "奇怪？",
    "voice": "vo_adv_5126002_006",
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才？",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "班導",
    "words": "好，",
    "voice": "vo_adv_5126002_007",
    "unit_id": 915
  },
  {
    "type": "dialogue",
    "name": "班導",
    "words": "那麼妳們三人的座位是……",
    "voice": null,
    "unit_id": 915
  },
  {
    "type": "dialogue",
    "name": "班導",
    "words": "喂，",
    "voice": null,
    "unit_id": 915
  },
  {
    "type": "dialogue",
    "name": "班導",
    "words": "\\n我說妳們，",
    "voice": null,
    "unit_id": 915
  },
  {
    "type": "dialogue",
    "name": "班導",
    "words": "不要擅自……！",
    "voice": null,
    "unit_id": 915
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "那邊的人，",
    "voice": "vo_adv_5126002_008",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "請讓出你的座位。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n讓出{0}大人隔壁的座位。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "男學生１",
    "words": "咦……？",
    "voice": "vo_adv_5126002_009",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男學生１",
    "words": "\\n可是其他還有很多空的座位啊……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我話說在前頭，這並非請求，而是強制的。",
    "voice": "vo_adv_5126002_010",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "趕快把東西收好離開。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "男學生１",
    "words": "噫！",
    "voice": "vo_adv_5126002_011",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "啊～惠理子，",
    "voice": "vo_adv_5126002_012",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "要坐哥哥旁邊的人是我啦～！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "哥哥也覺得",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我在旁邊比較好吧？",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "畢竟有句名言也說「要親近可愛的妹妹」嘛♪",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "才沒聽過那種名言呢──！",
    "voice": "vo_adv_5126002_013",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "隔壁",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "是我的座位──！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "將軍的左右手之位",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我是不會讓出去的！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "哇──不行啦～！？",
    "voice": "vo_adv_5126002_014",
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才旁邊的座位",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "是人家的～！",
    "voice": null,
    "unit_id": 127312
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這後宮學園劇情是怎麼回事啊！！",
    "voice": "vo_adv_5126002_015",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "毫無進展呢，",
    "voice": "vo_adv_5126002_016",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "既然如此……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "就互相破壞來決定吧，",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "嘻嘻。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "要開始大逃殺了！？",
    "voice": "vo_adv_5126002_017",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "欸，",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "{0}你不要保持沉默，說點什麼吧！？",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗯……",
    "voice": "vo_adv_5126002_018",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "怎麼啦，為什麼從剛才就一直低著頭？",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n咦，",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那封信是什麼？",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……咦？",
    "voice": "vo_adv_5126002_019",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "在櫃子裡放信，",
    "voice": "vo_adv_5126002_020",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "該不會是……",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "咦，",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我可以看嗎？",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那、",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那我就不客氣了……",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "「敬啟者：",
    "voice": "vo_adv_5126002_021",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "給插班生的你」",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "「自從第一眼看見你之後，",
    "voice": "vo_adv_5126002_022",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "每晚你都會出現在我的夢裡。",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n方便的話，",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "今天放學後",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你可以來頂樓嗎？",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "在你到來為止，",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我都會一直等著」……",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "說什麼",
    "voice": "vo_adv_5126002_023",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "會是什麼事！！",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n這完全就是情書吧！！！",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "…………什麼？",
    "voice": "vo_adv_5126002_024",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "膽敢未經許可寫情書給您，真是罪該萬死……",
    "voice": "vo_adv_5126002_025",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我去把那個人找出來再把她給五馬分屍吧。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "唔唔唔，",
    "voice": "vo_adv_5126002_026",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "居然沒經過妹妹的許可就告白，",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "無禮之極刑！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "惠理子，",
    "voice": "vo_adv_5126002_027",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "璃乃，",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我也跟妳們一起去……！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n吹響法螺貝，",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "即刻",
    "voice": null,
    "unit_id": 103011
  },
