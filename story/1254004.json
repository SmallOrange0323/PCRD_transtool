[
  {
    "type": "background",
    "bg_id": "501690"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "栞與喵特結束任務，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n並在獵人公會的場地內進行了訓練後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n正在樹陰下享受短暫的休息時光。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "有沒有哪裡會癢癢的呀～？",
    "voice": "vo_adv_1254004_000",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "喵特",
    "words": "咕嚕嚕♪",
    "voice": null,
    "unit_id": 2312
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "啊……",
    "voice": "vo_adv_1254004_001",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "你聽到了剛才的……",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n呃，",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我在替喵特",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "梳理毛髮……",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "喵特的毛很長，",
    "voice": "vo_adv_1254004_002",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n我會每天替牠梳理，",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "以免毛髮打結。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "你看。",
    "voice": "vo_adv_1254004_003",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n多虧如此，牠的毛髮才會這麼滑順。",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "像這樣把臉埋進毛髮裡，",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "還能聞到太陽的香氣……",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "呵呵♪",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "今天",
    "voice": "vo_adv_1254004_004",
    "unit_id": 125414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "真是個好天氣呢──",
    "voice": null,
    "unit_id": 125414
  },
  {
    "type": "background",
    "bg_id": "510100"
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "…………",
    "voice": "vo_adv_1254004_005",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "如果數值下降，",
    "voice": "vo_adv_1254004_006",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我就又要住院了……",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "明明",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "前陣子才剛出院的……",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我能夠",
    "voice": "vo_adv_1254004_007",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "順利從學校畢業嗎？",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "說到底，",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我的病真的",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "能治好嗎……",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "在這樣的狀態下，",
    "voice": "vo_adv_1254004_008",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我究竟該怎麼去想像……",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "自己未來的志願還有夢想呢？",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "光是為了撐過今天就竭盡全力了，",
    "voice": "vo_adv_1254004_009",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "根本沒辦法去想像",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "「明天的自己」",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "還有「未來的自己」呀。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "……不對，",
    "voice": "vo_adv_1254004_010",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "不是的。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "這或許只是我刻意不去想而已。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "因為",
    "voice": "vo_adv_1254004_011",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我很害怕……",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "明天",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "還有未來……",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "……唉。",
    "voice": "vo_adv_1254004_012",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "喵～",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "咦？",
    "voice": "vo_adv_1254004_013",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "貓叫聲……？",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n到底是從哪裡傳來的──",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "……啊！",
    "voice": "vo_adv_1254004_014",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n該不會是",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "從這個排水溝傳來的？",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "貓",
    "words": "喵～",
    "voice": null,
    "unit_id": 1711
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "果然沒錯，",
    "voice": "vo_adv_1254004_015",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n牠究竟是怎麼跑進去的呢？",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "只要搬開這個水溝蓋，",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "應該就能救牠了……",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "嗯",
    "voice": "vo_adv_1254004_016",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "……",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "……呼、",
    "voice": "vo_adv_1254004_017",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "呼。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "水溝蓋太重了，",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "喘不過氣了……",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "心臟也跳得好快，",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我應該沒辦法",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "再繼續搬了……",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "得找人來幫忙才行……",
    "voice": "vo_adv_1254004_018",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "路人１",
    "words": "…………",
    "voice": "vo_adv_1254004_019",
    "unit_id": 1031
  },
  {
    "type": "dialogue",
    "name": "路人２",
    "words": "…………",
    "voice": "vo_adv_1254004_020",
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "……",
    "voice": "vo_adv_1254004_021",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我不敢",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "跟其他人搭話。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "該怎麼辦？",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "貓",
    "words": "喵～",
    "voice": null,
    "unit_id": 1711
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "果然",
    "voice": "vo_adv_1254004_022",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "只能靠自己努力了。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n再試一次──",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "！",
    "voice": "vo_adv_1254004_023",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "是的，",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "那個……！",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "拜託你了！",
    "voice": "vo_adv_1254004_024",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "貓",
    "words": "喵～",
    "voice": null,
    "unit_id": 1711
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "那個，",
    "voice": "vo_adv_1254004_025",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "謝謝你",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "救了這隻貓。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "哇哇，",
    "voice": "vo_adv_1254004_026",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "牠在",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "磨蹭我的腳……！",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "如果摸牠，",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "應該會被牠咬吧……",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n還是",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "牠會用爪子抓我呢……",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "…………",
    "voice": "vo_adv_1254004_027",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "好、",
    "voice": "vo_adv_1254004_028",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "好柔軟……！",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "而且",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "好溫暖……！",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "好乖好乖♪",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "這隻貓",
    "voice": "vo_adv_1254004_029",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "沒有戴項圈呢。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "而且渾身髒兮兮",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "又很瘦弱……",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "應該不是被人飼養的貓。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "耳朵上沒有記號，",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "應該也不是這個地區的貓。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "這樣的話，",
    "voice": "vo_adv_1254004_030",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "牠應該是隻野貓吧。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "是被人給棄養的嗎……？",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "牠在打噴嚏，",
    "voice": "vo_adv_1254004_031",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n有可能生病了。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "……雖然還不清楚",
    "voice": "vo_adv_1254004_032",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "接下來應該怎麼辦，",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n不過我打算",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "先帶牠去一趟動物醫院。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "然後，",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "那個……",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "不好意思，",
    "voice": "vo_adv_1254004_033",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "把你給捲進來。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "可是",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "如果有你一起的話……",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我就放心了。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "幸好",
    "voice": "vo_adv_1254004_034",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "小貓咪只是輕微的感冒呢。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "只要提供牠充足的飲水、",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "餵牠吃飯，",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "再給牠吃藥，",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n馬上就會恢復健康了……",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "問題是……",
    "voice": "vo_adv_1254004_035",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "這之後的事情呢。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "……",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "就算沒辦法養牠，",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我也能照顧牠到找到領養人為止。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n我",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "打算去拜託媽媽，",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "讓牠先由我們家照顧。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "當然，",
    "voice": "vo_adv_1254004_036",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我覺得會被反對。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "可是",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我會請姊姊幫我，",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n試著說服媽媽",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "到她願意接受為止。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "之後",
    "voice": "vo_adv_1254004_037",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "再利用公佈欄",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "和社群網站，",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n找找看有沒有人",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "願意當牠的家人。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n……",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我現在能做到的",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "也只有這些事情。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "那真是",
    "voice": "vo_adv_1254004_038",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "太好了。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n這樣的話，",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我就老實地",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "接受你的好意了♪",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在那之後過了一個月的某一天──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "啊！",
    "voice": "vo_adv_1254004_039",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n你來了呀！",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "關於喵特的事，",
    "voice": "vo_adv_1254004_040",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我有點話想跟你說。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n牠在那之後變得相當有活力喔。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "是的。",
    "voice": "vo_adv_1254004_041",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我原本沒打算替牠取名的，",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "可是姊姊",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "幫牠取了這個名字……",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "現在我的家人",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "都是這樣叫牠的。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "因為這個關係，",
    "voice": "vo_adv_1254004_042",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "對牠放了不少感情……",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "不管是照片還是影片，",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "拍攝的對象都變成是喵特了。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "你看，",
    "voice": "vo_adv_1254004_043",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "這個影片。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n這是我抱著喵特的時候……",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n原來貓的身體可以伸得這麼長呢。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "而且",
    "voice": "vo_adv_1254004_044",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "牠的身體軟趴趴的，",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "甚至讓人懷疑",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n「牠真的有骨頭嗎？」……",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "人家說「貓咪是液體」，還真的是呢。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "這部影片也很可愛喔。",
    "voice": "vo_adv_1254004_045",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n是喵特在睡午覺的樣子，",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "牠露出肚子睡覺……",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "讓人忍不住",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "就把臉埋進牠的肚子裡了。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "牠只有在餵飯時，",
    "voice": "vo_adv_1254004_046",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "叫聲會變得很撒嬌，",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "摸牠時會發出",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "呼嚕呼嚕的叫聲……",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我們全家人都被牠",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "迷得神魂顛倒了。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "但這",
    "voice": "vo_adv_1254004_047",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "並非只有我們家的人而已，",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n其實……",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "其實",
    "voice": "vo_adv_1254004_048",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我們幫牠找到領養的人了。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "已經決定",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "一週後在公園見面。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我會在那裡",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "與喵特道別。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "到時候",
    "voice": "vo_adv_1254004_049",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "會由我負責去見對方。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n然後",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "就是……",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "……太好了。",
    "voice": "vo_adv_1254004_050",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n你",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "果然能懂",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我的想法呢♪",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "background",
    "bg_id": "510124"
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "妳就是栞小姐吧。",
    "voice": "vo_adv_1254004_051",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n然後",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "這隻貓是……！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "我家以前",
    "voice": "vo_adv_1254004_052",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "也有養過貓……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "花色和這隻貓是一樣的。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n我一定",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "會很細心養育牠的。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "好的，",
    "voice": "vo_adv_1254004_053",
    "unit_id": 103831
  },
