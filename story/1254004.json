  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "可以讓我再抱抱牠嗎？",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "當然可以。",
    "voice": "vo_adv_1254004_054",
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "125400401"
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "好溫暖……",
    "voice": "vo_adv_1254004_055",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "明明才短短一個月……",
    "voice": "vo_adv_1254004_056",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n就長大了",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "相當多呢。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "替你擦眼眶、",
    "voice": "vo_adv_1254004_057",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "餵你吃飯、",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "給你抱抱……",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "這些都是我第一次經歷的事情，",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "所以很拚命去做……",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n每天",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "都咻地一下就過去了呢。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "你身體突然狀況變差的時候，",
    "voice": "vo_adv_1254004_058",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我雖然做好了心理準備，",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "但你憑著自己小小的身體",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "熬過了難關呢。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "原本是我救你的，",
    "voice": "vo_adv_1254004_059",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "但卻感覺被拯救的人",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "是我自己。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "所以",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我也不會認輸，",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "會努力下去的。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "喵特……",
    "voice": "vo_adv_1254004_060",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "雖然沒有機會",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "再用這個名字叫你了，",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n但是我",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "永遠不會忘記你的。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "在這段短暫的時間裡……",
    "voice": "vo_adv_1254004_061",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n很謝謝你",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "來到我身邊。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "background",
    "bg_id": "510124"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "那個，",
    "voice": "vo_adv_1254004_062",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "謝謝妳。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n已經",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "可以了。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "……這樣啊。",
    "voice": "vo_adv_1254004_063",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "我把牠帶回我們家了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n還有──",
    "voice": null,
    "unit_id": null
  },
