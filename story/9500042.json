  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "咦，",
    "voice": "vo_adv_9500042_000",
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n要選我嗎……？",
    "voice": null,
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "怎、",
    "voice": "vo_adv_9500042_001",
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "怎麼辦，",
    "voice": null,
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "好開心……",
    "voice": null,
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "不過……",
    "voice": null,
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "那個。",
    "voice": "vo_adv_9500042_002",
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n我……",
    "voice": null,
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "就像你很清楚的那樣，",
    "voice": null,
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "是個很沒用的姐姐喔？",
    "voice": null,
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "喝了麥酒很快就醉到傻笑，",
    "voice": "vo_adv_9500042_003",
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "變得醉醺醺又軟趴趴的……",
    "voice": null,
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "能聽到你說我這樣很可愛，",
    "voice": "vo_adv_9500042_004",
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "真的很開心呢。",
    "voice": null,
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n坦白說，",
    "voice": null,
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "每次你這麼說，我都會高興到要飛起來……",
    "voice": null,
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "能對這樣的我",
    "voice": "vo_adv_9500042_005",
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "說出喜歡，",
    "voice": null,
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我想，或許你就是我的命中注定之人",
    "voice": null,
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "呢。",
    "voice": null,
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "不過啊，",
    "voice": "vo_adv_9500042_006",
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "不對，",
    "voice": null,
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "所以呢……",
    "voice": null,
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "就讓我作為一個成熟的姐姐",
    "voice": null,
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "耍帥一下吧。",
    "voice": null,
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n這是我給即將離開我身邊、踏上征程的你，",
    "voice": null,
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "最後的忠告喔♪",
    "voice": null,
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "如果你現在",
    "voice": null,
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "要選擇一個真正重要的人，",
    "voice": null,
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "那麼……",
    "voice": null,
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "……奇怪……",
    "voice": "vo_adv_9500042_007",
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "說不出口……",
    "voice": null,
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "明明必須說出來的……",
    "voice": null,
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n要告訴你不要選擇我，",
    "voice": null,
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "而是選擇其他人。",
    "voice": null,
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "要你選擇真正成熟的人",
    "voice": null,
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "才對……",
    "voice": null,
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "……",
    "voice": "vo_adv_9500042_008",
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n……{0}……",
    "voice": null,
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "……！",
    "voice": "vo_adv_9500042_009",
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n……謝謝你。",
    "voice": null,
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "……呵呵，",
    "voice": null,
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我果然",
    "voice": null,
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "很沒用呢。",
    "voice": null,
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "明明應該要笑的，",
    "voice": null,
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "卻還是哭了出來。",
    "voice": null,
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "呵呵♪",
    "voice": null,
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我們走吧！",
    "voice": "vo_adv_9500042_010",
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "在你長大成人之前，",
    "voice": null,
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "必須守護這個世界才行呢。",
    "voice": null,
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n好了，",
    "voice": null,
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "接下來……",
    "voice": null,
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n愉快的",
    "voice": null,
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "盛大宴會要開始了喔！",
    "voice": null,
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "……命運還真是不可思議呢。",
    "voice": "vo_adv_9500042_011",
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n我一直都沒能遇見任何人，",
    "voice": null,
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "這一定……",
    "voice": null,
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "……是因為一直在等你",
    "voice": "vo_adv_9500042_012",
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "來接我吧。",
    "voice": null,
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "溫柔",
    "voice": null,
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "又可愛的，",
    "voice": null,
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我的王子。",
    "voice": null,
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n呵呵，",
    "voice": null,
    "unit_id": 103441
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "不小心說出來了♪",
    "voice": null,
    "unit_id": 103441
  }
]
