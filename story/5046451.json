  {
    "type": "dialogue",
    "name": "美里",
    "words": "終於到了",
    "voice": "vo_adv_5046451_000",
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "大賽的最後一天呢。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "至今為止",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "大家都辛苦了。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "這一路上積累的所有努力是不會背叛你們的。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "要相信",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "自己的力量唷。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "沒錯沒錯！",
    "voice": "vo_adv_5046451_001",
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n大家連教練們的魔鬼特訓",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "都熬過了嘛！",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "不會這麼輕易就輸掉的！",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "接下來",
    "voice": "vo_adv_5046451_002",
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "只需要發揮出實力就行了哦。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "昂首挺胸，",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "盡全力",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "在球場上奮鬥吧～！",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "為了讓你們有200％的活力奮鬥，",
    "voice": "vo_adv_5046451_003",
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n我會在觀眾席上大聲加油的～！",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "聲援交給我，",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "大家就盡情享受比賽吧！",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "來，",
    "voice": "vo_adv_5046451_004",
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我們去實現夢想吧！",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n如果是你們，",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "一定能拿到",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "全國大賽的入場券哦～！",
    "voice": null,
    "unit_id": 113511
  }
]
