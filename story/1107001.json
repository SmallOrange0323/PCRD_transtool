  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}為了BB團的活動，\\n來到精靈之森。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "各、",
    "voice": "vo_adv_1107001_000",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "各位，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "初次見面……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我的名字叫",
    "voice": "vo_adv_1107001_001",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "碧、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "碧……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "碧……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "碧色水黽毛蟲次郎―――――！",
    "voice": "vo_adv_1107001_002",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "啊啊……",
    "voice": "vo_adv_1107001_003",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我又失敗了……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這已經是第18次了……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "只是說個名字，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n怎麼這麼困難呢……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "就連為了練習製作出來的",
    "voice": "vo_adv_1107001_004",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "『有我在喔好朋友號V3』，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "感覺都好像在嘲笑我……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這樣下去，",
    "voice": "vo_adv_1107001_005",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "就連自我介紹……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "對了！　",
    "voice": "vo_adv_1107001_006",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這樣的話，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "如果把自己的名字改名，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "說不定就能順利說完吧！？",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "哎呀！？",
    "voice": "vo_adv_1107001_007",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n誰誰誰誰呀突然出聲！？",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "啊……",
    "voice": "vo_adv_1107001_008",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "原來是你。",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "是啊。",
    "voice": "vo_adv_1107001_009",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n仔細想想，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "會跟我這個邊緣人講話的，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n就只有你呢……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "跟我一樣都是BB團的團員，",
    "voice": "vo_adv_1107001_010",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n也是我唯一的",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "同、",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "同同、",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "同伴的……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "就只有",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "你了……！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那個……",
    "voice": "vo_adv_1107001_011",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "在做自我介紹",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "的",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "練習。",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那個、",
    "voice": "vo_adv_1107001_012",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我、這次……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "要到聖德蕾莎女學院那裡，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n暫時",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "插班就讀一陣子……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "啊，",
    "voice": "vo_adv_1107001_013",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "你不知道嗎？",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n咦？　",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "在那裡就讀？　",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那是女子學院耶！？",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "真不愧是BB團團長……",
    "voice": "vo_adv_1107001_014",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "為了結交朋友必須要有",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "就算身為男孩子也要到女子學院就讀的決心",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "原來是這麼一回事呢……！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "但是這也算是",
    "voice": "vo_adv_1107001_015",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "順水推舟呢！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n或是可以說是",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "從天而降的餡餅呢！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "請一定要！　",
    "voice": "vo_adv_1107001_016",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "將聖德蕾莎女學院的事",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n全都告訴我！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "太感謝你了……！",
    "voice": "vo_adv_1107001_017",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我果然還是需要",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "同……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "同伴……！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那麼，",
    "voice": "vo_adv_1107001_018",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我要發問了！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "學校是什麼樣的地方呢！？",
    "voice": "vo_adv_1107001_019",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "在學校就讀的通常是怎樣類型的人呢！？",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "有看起來願意跟我當朋友的人嗎！？",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "如果成為朋友的話，",
    "voice": "vo_adv_1107001_020",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我該做什麼才好呢！？",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n果然還是應該",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "一起玩翻花繩之類來增進感情吧！？",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "啊啊但是，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "如果太多朋友繩子會不夠用呢！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "既然如此，",
    "voice": "vo_adv_1107001_021",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "首先要先準備很多繩子備用……？",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "咦？　",
    "voice": "vo_adv_1107001_022",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "叫我冷靜？",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "也、",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "也是啦。",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n再說，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "像我這樣的人怎麼可能交到朋友……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "咦？　",
    "voice": "vo_adv_1107001_023",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "不是這樣的？",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n在女子學院中，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "有很多不平凡的同學？",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這樣的話……",
    "voice": "vo_adv_1107001_024",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "說不定。",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n就算是像我這樣的人，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "說不定也會有人願意跟我當朋友……！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "太謝謝你了！",
    "voice": "vo_adv_1107001_025",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n托你的福我看見了希望！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "對了！　{0}，",
    "voice": "vo_adv_1107001_026",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "如果可以的話，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "能幫我個忙嗎！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "為了迎接即將到來的學院生活，",
    "voice": "vo_adv_1107001_027",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我想練習自我介紹！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "想必你剛剛看了也知道，",
    "voice": "vo_adv_1107001_028",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我就算跟",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "『有我在喔好朋友號V3』練習對話，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "還是連名字都沒辦法好好說完……",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這樣只能",
    "voice": "vo_adv_1107001_029",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "把{0}你當成學生練習，",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n運用實戰的",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "強制療法才行了！",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "咦！？　",
    "voice": "vo_adv_1107001_030",
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "再多一點、",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "正式場合的東西吧！？",
    "voice": null,
    "unit_id": 104011
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
