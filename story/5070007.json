    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "是啊。",
    "voice": "vo_adv_5070007_047",
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n但他身邊的位置，我可不會讓給妳……",
    "voice": null,
    "unit_id": 117011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
