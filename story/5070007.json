  },
  {
    "type": "dialogue",
    "name": "靜流、惠理子",
    "words": "…………啊！？",
    "voice": "vo_adv_5070007_045",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "既然他在叫我們，",
    "voice": "vo_adv_5070007_046",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
