  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "動作卻遲鈍，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n憑{0}加上我的力量",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "也不算什麼啦。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "佩服啊……",
    "voice": "vo_adv_1080001_058",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
