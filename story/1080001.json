    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "試過很多方法都是無功而返。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "\\n為了這次特地買武器來用，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "結果還這麼狼狽。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "難道說，",
    "voice": "vo_adv_1080001_061",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "對這一帶的人們要求的高額規費，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n就是為了打倒牠而買武器所需要的費用嗎？",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "算是吧。",
    "voice": "vo_adv_1080001_062",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "\\n海這麼寬闊。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "沒有人來管理",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "就會變成無法地帶。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "但是",
    "voice": "vo_adv_1080001_063",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "這次真是受夠啦。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "就算再怎麼夢幻的食材，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "\\n我也不想再奉陪一次啦。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "夢幻的食材？",
    "voice": "vo_adv_1080001_064",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "妳不知道嗎？",
    "voice": "vo_adv_1080001_065",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "我說的就是牠呀。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "我年輕時也只吃過一次，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "但是那美味可真是……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "竟然是美食家指定的珍品啊。",
    "voice": "vo_adv_1080001_066",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n能得到使度假村重建的主打食材，這個兆頭還真好呢，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "對我們而言。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "那、",
    "voice": "vo_adv_1080001_067",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "那個……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "拜託一下，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "這頭章魚，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "能不能讓給我們？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "\\n剛才的衝突真是抱歉！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "之後",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "打漁就隨你們自由進行，我們不干涉！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "……唔～嗯，",
    "voice": "vo_adv_1080001_068",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "怎麼說好呢～？",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "呵呵。",
    "voice": "vo_adv_1080001_069",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "會長，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這頭章魚，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "就照您期望的送給您吧。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n要是能聽聽我的要求，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "就更好了。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "真、",
    "voice": "vo_adv_1080001_070",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "真的嗎！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "感謝啦！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "　那，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "要求是要什麼呢？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "請您來當我們的商業夥伴。",
    "voice": "vo_adv_1080001_071",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n首先，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我們需要進些優質的漁獲。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "而且，",
    "voice": "vo_adv_1080001_072",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "也請您別再要求高額的規費了。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n帝王章魚已經被討伐，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "應該沒有問題了吧？",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "這種要求算是小事一樁啦！",
    "voice": "vo_adv_1080001_073",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "受妳關照啦小姐！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "就這樣，",
    "voice": "vo_adv_1080001_074",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "跟大商會的交涉成功。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n而這家旅館，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "也能夠提供美味的魚料理了。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "原來發生了這樣的事……",
    "voice": "vo_adv_1080001_075",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "可是",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "如果能以帝王章魚當作主打商品，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "\\n吸引饕客來店的話，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "這裡立刻就會成為熱門的旅館吧……",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "是這樣嗎？",
    "voice": "vo_adv_1080001_076",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "照那種作法，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "帝王章魚一旦被吃完，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n又會落回原本得尋找食材的狀況了啊。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "啊……",
    "voice": "vo_adv_1080001_077",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "原來如此。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "與其用一時的好評爭取提升營業額，",
    "voice": "vo_adv_1080001_078",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n還不如細水長流，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "建立良好的交易關係不是更好嗎？",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "你也這麼想嗎？",
    "voice": "vo_adv_1080001_079",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我就是這麼想的！",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n呵呵，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "都被{0}猜透了呢。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n好像有點害羞啊。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "咦？",
    "voice": "vo_adv_1080001_080",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "那頭章魚，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "你想試吃看看嗎？",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n也是，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "畢竟是人稱作夢幻的食材。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "呵呵。",
    "voice": "vo_adv_1080001_081",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我就知道你會這麼說……",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "鏘～",
    "voice": "vo_adv_1080001_082",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "其實我也有點興趣，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "就帶過來了。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n就一條章魚腳而已。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "來來，",
    "voice": "vo_adv_1080001_083",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "請把這個拿去烤──！",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "大家也一起來吃吧！",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "美冬與旅館員工簇擁著，\\n開了一場小宴會。",
    "voice": null,
    "unit_id": null
  }
]
