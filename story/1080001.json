[
  {
    "type": "background",
    "bg_id": "500160"
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "【墨丘利財團】的新生意呢，",
    "voice": "vo_adv_1080001_000",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n是以令度假村再生為目的，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "低價收購營運狀況衰頹的度假村，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n進行改善業務。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我就是這個計畫的負責人喔。",
    "voice": "vo_adv_1080001_001",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "雖然很辛苦，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "但不努力不行呢。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "那麼，",
    "voice": "vo_adv_1080001_002",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我們立刻前往已經簽約的度假村去看看吧。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "background",
    "bg_id": "500164"
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "很高興認識您，",
    "voice": "vo_adv_1080001_003",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我是【墨丘利財團】的美冬。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "啊！",
    "voice": "vo_adv_1080001_004",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "我們正在等您。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "\\n",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "這次",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "對【墨丘利財團】該怎麼致謝才好呢……",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "\\n",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "請、",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "請務必多多關照！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我們才是，",
    "voice": "vo_adv_1080001_005",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "今天起這段時間，請您多多指教囉。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n雖然有點早，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "請先開始介紹旅館內部好嗎？",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "好，",
    "voice": "vo_adv_1080001_006",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "當然可以。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "請往這邊走！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "嗯。",
    "voice": "vo_adv_1080001_007",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "很乾淨美麗的地方不是嗎？",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "員工們也笑容可掬。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這種服務品質卻會經營衰頹，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "是什麼緣故呢？",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "只能猜想是有其他特殊理由……",
    "voice": "vo_adv_1080001_008",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "對了。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "麻煩一下。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我們能試吃給住客的餐點料理嗎？",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "明白了，",
    "voice": "vo_adv_1080001_009",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "請稍等一會。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "會端出些什麼樣的料理呢。",
    "voice": "vo_adv_1080001_010",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "令人期待。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "讓您久等了，",
    "voice": "vo_adv_1080001_011",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "在這邊。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "感謝您。",
    "voice": "vo_adv_1080001_012",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "那就立刻，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "來享用吧。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "啊嗯，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "嚼……",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "嚼。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "嗯？",
    "voice": "vo_adv_1080001_013",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "唔……",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "也不是味道不好，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n就是感覺少了什麼……",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "既然是度假村的餐點，",
    "voice": "vo_adv_1080001_014",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n希望能提供更高級的餐點呢。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "不好意思。",
    "voice": "vo_adv_1080001_015",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "我們也是想過應該要這麼做……",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "\\n但是優質的食材都被大商會給壟斷了，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "真的沒辦法……",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "大商會？",
    "voice": "vo_adv_1080001_016",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "是的。",
    "voice": "vo_adv_1080001_017",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "有一間商會支配了這附近一帶。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "\\n那會長在食材領域方面算是有名，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "\\n",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "如果不繳出高額的規費，",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "就訂不到優質的食材……",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "原來如此呢。",
    "voice": "vo_adv_1080001_018",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "那麼，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我們自己去捕撈食材好嗎？",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "不、",
    "voice": "vo_adv_1080001_019",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "不行的！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "員工",
    "words": "被人看見了不知道會被說些什麼。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "就算對方有意見，",
    "voice": "vo_adv_1080001_020",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "擅自掌控漁獲，這點我們不能忽視，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n也不打算屈服啊。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "好，",
    "voice": "vo_adv_1080001_021",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "事不宜遲。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "{0}也一起來吧？",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "好，",
    "voice": "vo_adv_1080001_022",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "首先到岩岸去撈貝類吧！",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "目標是高級貝！",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "挑些應該會很美味吧。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "哎呀？",
    "voice": "vo_adv_1080001_023",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "真美麗的貝殼……",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "啊，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "難道說這是，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "珍珠貝？",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "真不得了。",
    "voice": "vo_adv_1080001_024",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這麼美麗的東西，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我可能也是第一次看到。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "當紀念品是不錯，",
    "voice": "vo_adv_1080001_025",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "但畢竟不能吃，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n要找這種東西的話",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "還是改天再說吧。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "嗯？",
    "voice": "vo_adv_1080001_026",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "海灘那邊有漁船過來了……",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "喂！",
    "voice": "vo_adv_1080001_027",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "敢在這片海擅自打漁，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "膽子還不小嘛！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "原來如此……",
    "voice": "vo_adv_1080001_028",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這就是大商會的人員啊。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "相當橫蠻的態度呢。",
    "voice": "vo_adv_1080001_029",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n這片海，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "以及海裡撈到的食材，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n應該不特別屬於任何人才對吧？",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "妳說什麼～？",
    "voice": "vo_adv_1080001_030",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "妳這傢伙不是本地人吧。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "\\n看來有必要教妳這地方的規矩啊。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "哼。",
    "voice": "vo_adv_1080001_031",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "你要是這種態度的話，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我們也是――",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "大商會團員",
    "words": "出、",
    "voice": "vo_adv_1080001_032",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "大商會團員",
    "words": "出現啦！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "大商會團員",
    "words": "那是……",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "大商會團員",
    "words": "「帝王章魚」出現囉──！！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "真的嗎！？",
    "voice": "vo_adv_1080001_033",
    "unit_id": 911
  },
