    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "只靠兩個人是打不倒牠的吧！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "可以的。",
    "voice": "vo_adv_1080001_046",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "如果是我跟他的話！",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "拜託。",
    "voice": "vo_adv_1080001_047",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "{0}身上不可思議的力量，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n請你把它借給我！",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "謝謝，",
    "voice": "vo_adv_1080001_048",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "麻煩你，要特別增量喔！",
