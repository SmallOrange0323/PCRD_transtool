    "name": "美冬",
    "words": "來，上囉！",
    "voice": "vo_adv_1080001_052",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "帝王章魚！",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──吼喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "background",
    "bg_id": "500164"
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "啊！？",
    "voice": "vo_adv_1080001_053",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n不只體型龐大，連力道也是怪獸級呢！",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "但是，",
    "voice": "vo_adv_1080001_054",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "打不中就什麼都不算啦！",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──吼喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "太慢了！",
    "voice": "vo_adv_1080001_055",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這樣也算是攻擊嗎！？",
