    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "謝謝啊。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "以前帝王章魚讓我們吃了很多苦頭。",
    "voice": "vo_adv_1080001_059",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "\\n養殖的魚也被牠吃，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "漁船也被牠突襲打壞。",
