    "unit_id": 108011
  },
  {
    "type": "background",
    "bg_id": "510270"
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "用手頭的所有裝備跟魔法去攻擊吧！",
    "voice": "vo_adv_1080001_038",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "\\n一口氣抓住牠！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "background",
    "bg_id": "500164"
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "雖然帶了那麼多份量的武裝……",
    "voice": "vo_adv_1080001_039",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "但看來還是贏不了呢。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "什麼……！",
    "voice": "vo_adv_1080001_040",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "會長",
    "words": "竟然全都被彈開了！？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "大商會團員",
    "words": "嗚哇啊啊啊！",
    "voice": "vo_adv_1080001_041",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "大商會團員",
    "words": "牠的攻擊打過來了！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "大商會團員",
    "words": "快逃啊──！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──吼喔喔喔喔喔！",
