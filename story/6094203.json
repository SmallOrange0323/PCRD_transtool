[
  {
    "type": "background",
    "bg_id": "501590"
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "對大家來說，",
    "voice": "vo_adv_6094203_000",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "隱居山林居然是一種休閒，",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n真是出乎我的意料……",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "而且",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "還有多數人同歡的形式……！",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "如果團長也在的話，",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這種時候會給我什麼意見呢……？",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "沒、",
    "voice": "vo_adv_6094203_001",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "沒錯……",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "團長一定",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "會那麼對我說的……！",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n只要活用隱居山林的知識，",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "就能幫助到大家……",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "順利的話，",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "還能從邊緣人畢業……！？",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我、",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我盡力試試看！",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "團、",
    "voice": "vo_adv_6094203_002",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "團長也不在我身邊，",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "著急只會欲速則不達吧……！",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "總之，我要先冷靜。",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "邊緣人慌慌張張的都不會有好結果。",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "這種時候",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "就要凝視著篝火……",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "盯……………………",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "冷靜多了……",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "在大自然裡維持自然，",
    "voice": "vo_adv_6094203_003",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "開玩笑的……",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我想像出來的團長也很風趣呢。",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "不過多虧如此，",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我覺得肩膀的緊張放鬆了不少。",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "很、",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "很好！",
    "voice": null,
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我要努力保持自然的自己！",
    "voice": null,
    "unit_id": 122111
  }
]
