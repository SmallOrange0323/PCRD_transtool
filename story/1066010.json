    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "可是這麼一來，",
    "voice": "vo_adv_1066010_033",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我不就沒有能做的事了嗎……",
