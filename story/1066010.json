    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n好像",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "有所謂的",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "覺醒條件之類的東西？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "似乎是",
    "voice": "vo_adv_1066010_061",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "夥伴，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "或家人",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那些……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "說起來，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "老大她的覺醒條件是什麼呢？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "錢？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "嗯～",
    "voice": "vo_adv_1066010_062",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "因為老大她唯利是圖，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n我還想說這個方向是對的呢……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "對吧對吧！",
    "voice": "vo_adv_1066010_063",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n畢竟是那個老大啊，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這點小事也不值得驚訝嘛。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "算啦，",
    "voice": "vo_adv_1066010_064",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這時候就交給天才祈梨大人我吧！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n總之，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "因為親近的人遇到危機",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "而瞬間覺醒！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這可是最典型的呢。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "然後，",
    "voice": "vo_adv_1066010_065",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我要把這個榮譽的職責交給小哥你。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "所以說，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "你要不要稍微瀕死看看？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "什麼啊，",
    "voice": "vo_adv_1066010_066",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "真是小氣耶。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這時候就要充滿氣勢地",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "勇往直前啊！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這種發展之前也有過",
    "voice": "vo_adv_1066010_067",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "是嗎？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "你這麼一說，我好像有一點印象呢。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "如果我的條件是小哥遇到危機的話，",
    "voice": "vo_adv_1066010_068",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n那麼到現在為止覺醒個十次左右都不奇怪呢……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "話說回來，",
    "voice": "vo_adv_1066010_069",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "小哥你會不會瀕死太多次了？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n再稍微小心一點生活啊……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "算啦，",
    "voice": "vo_adv_1066010_070",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "如果是像我這樣的天才，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n怎麼可能會是那種老套的條件嘛。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我從很久以前就這麼認為了，",
    "voice": "vo_adv_1066010_071",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我應該是那種被誇獎、疼愛，\\n就會成長的類型啊。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "也就是說……",
    "voice": "vo_adv_1066010_072",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "只要能再見慈樂之音一面，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "應該就會覺醒了！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n不，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "一定會覺醒的！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "啊？",
    "voice": "vo_adv_1066010_073",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我可不是在開玩笑喔！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "應該說，見到慈樂之音、",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "見到望望卻沒有覺醒，\\n反而才奇怪也很失禮不是嗎？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "之前嘉夜夜",
    "voice": "vo_adv_1066010_074",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "和望望待在一起時，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n不也是一下子就變得全身白了嗎？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那就是慈樂之音的力量啊。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "就是這樣，所以……",
    "voice": "vo_adv_1066010_075",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n來吧！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "讓我見慈樂之音！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n又或是",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "買些什麼好吃的點心過來！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "看著逐漸脫離認真方向的祈梨，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}鬆了一口氣。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "501330"
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "雖然我想有你在的話應該沒問題，",
    "voice": "vo_adv_1066010_076",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "但還是以防萬一……",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "對吧。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "嗯？",
    "voice": "vo_adv_1066010_077",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "小哥你說了什麼嗎？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不提這個了，",
    "voice": "vo_adv_1066010_078",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我想起了很好的特訓方法，你聽我說！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n小哥成為我的手下也很長一段時間了，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "也差不多可以解除限制了……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "就來進行那個吧！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "沒錯，",
    "voice": "vo_adv_1066010_079",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "說到幫派就是那個！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n兩個人在草原上全力奔跑！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n接下來就進行這項特訓吧！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}追著跑出去的祈梨。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n蘭德索爾今天也很和平。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500890"
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "唔嗯……",
    "voice": "vo_adv_1066010_080",
    "unit_id": 8111
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "原來如此。",
    "voice": null,
    "unit_id": 8111
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n總之勘查就到這邊吧。",
    "voice": null,
    "unit_id": 8111
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n在小蟲子們開始大鬧前就先撤退。",
    "voice": null,
    "unit_id": 8111
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "可惡！",
    "voice": "vo_adv_1066010_081",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "追丟了！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "喂，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "跑去哪裡了？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流氓2",
    "words": "別讓他逃了！",
    "voice": "vo_adv_1066010_082",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流氓2",
    "words": "\\n剛剛那傢伙……",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流氓2",
    "words": "絕對不是一般老百姓。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流氓2",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流氓2",
    "words": "他到底在策劃什麼……",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "……然而卻是表面上的和平。",
    "voice": null,
    "unit_id": null
  }
]
