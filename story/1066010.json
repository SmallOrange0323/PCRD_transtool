[
  {
    "type": "background",
    "bg_id": "501320"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}一大早就被祈梨叫出來，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n前來造訪了公會小屋。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "所以說，",
    "voice": "vo_adv_1066010_000",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這是讓家族壯大的活動！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n鼓足幹勁上吧！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "廢話不多說，",
    "voice": "vo_adv_1066010_001",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我就去看看手下們的情況，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n以大幹部的身分為大家打氣！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n你要好好跟上喔！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "background",
    "bg_id": "500890"
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "哎唷，",
    "voice": "vo_adv_1066010_002",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "所以就說有好好在工作了。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "說是這麼說，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "但我們就跟之前說的一樣，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "\\n只是照著老大留下的指示去做而已。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流氓2",
    "words": "就是這個，",
    "voice": "vo_adv_1066010_003",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流氓2",
    "words": "\\n重點復興地區，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流氓2",
    "words": "還有給他們的貸款利息的指示資料。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "唔……",
    "voice": "vo_adv_1066010_004",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不過，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這樣的指示",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不是大多很籠統嗎？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "只要稍微在這裡",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "提高一點我們的利潤就好啦！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "話雖如此，但復興地區到處都很辛苦……",
    "voice": "vo_adv_1066010_005",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "\\n沒辦法做這種斂財的事啊。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "啊，",
    "voice": "vo_adv_1066010_006",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "龍骨家族的成員們，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n這是這個月的還款。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "流氓2",
    "words": "喔，",
    "voice": "vo_adv_1066010_007",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流氓2",
    "words": "我確實收到了。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流氓2",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流氓2",
    "words": "怎麼樣了啊，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流氓2",
    "words": "家裡那邊？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "託你們的福，",
    "voice": "vo_adv_1066010_008",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "總算不用讓孩子們露宿野外了。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "這份恩情",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我一定會報答的！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "大嬸，",
    "voice": "vo_adv_1066010_009",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "妳那邊怎麼樣？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "啊，",
    "voice": "vo_adv_1066010_010",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "對不起啊……",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n這個月的還款有點……",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "流氓2",
    "words": "啊，",
    "voice": "vo_adv_1066010_011",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流氓2",
    "words": "沒關係沒關係。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流氓2",
    "words": "\\n畢竟老大也指示說，等生意重新開始後再還錢嘛。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "真抱歉啊……",
    "voice": "vo_adv_1066010_012",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "相對地，",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "等店面重新開張後，請讓我好好地招待你們一頓啊。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "哈哈，",
    "voice": "vo_adv_1066010_013",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "真令人期待啊。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "啊，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "總之，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "到處都是這種感覺吧。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "唔，",
    "voice": "vo_adv_1066010_014",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "在這種時候搾取錢財",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "的確不是我們的作風呢……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "流氓2",
    "words": "而且不知道老大是怎麼做到的，連損害金額都正確記錄下來……",
    "voice": "vo_adv_1066010_015",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流氓2",
    "words": "\\n每一家都有個別指示啊。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流氓2",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流氓2",
    "words": "多虧如此，我們也有不錯的獲利。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "啊？",
    "voice": "vo_adv_1066010_016",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那是怎麼回事？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "簡直就像是預先知道事情會變成這樣啊，",
    "voice": "vo_adv_1066010_017",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "真不愧是老大呢。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流氓2",
    "words": "甚至還附上了還款計畫的範本，",
    "voice": "vo_adv_1066010_018",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流氓2",
    "words": "\\n那個人",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流氓2",
    "words": "真是恐怖啊……",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "她該不會",
    "voice": "vo_adv_1066010_019",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "事先用時間儀調查過了吧？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "如果是老大，確實有可能這麼做呢……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "唉……",
    "voice": "vo_adv_1066010_020",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我知道這邊的工作情況了。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "然後呢，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "其他的生意怎麼樣了？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "雖然妳這麼問，",
    "voice": "vo_adv_1066010_021",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "但敵對組織已經潰敗解散了，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "而且可以索取場地費的那些店，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "也像這樣正在復興中啊。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流氓2",
    "words": "目前真的就只有這些事了啊。",
    "voice": "vo_adv_1066010_022",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流氓2",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流氓2",
    "words": "所以",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流氓2",
    "words": "祈梨妳也放輕鬆一點嘛。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "唔……",
    "voice": "vo_adv_1066010_023",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "真是太丟臉了。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我知道了啦！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n家族的事情就交給你們了！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "總之，",
    "voice": "vo_adv_1066010_024",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "和平是再好不過了。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流氓2",
    "words": "來，",
    "voice": "vo_adv_1066010_025",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流氓2",
    "words": "給妳零用錢，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流氓2",
    "words": "妳就用這些去鎮上晃晃吧。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "什麼～？",
    "voice": "vo_adv_1066010_026",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不要把我當成小孩子啦！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不過，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "錢我就收下了。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "那麼小哥，",
    "voice": "vo_adv_1066010_027",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "祈梨就拜託你了。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流氓2",
    "words": "可不要讓她亂花錢喔～",
    "voice": "vo_adv_1066010_028",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "吵死了！",
    "voice": "vo_adv_1066010_029",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n你們不要偷懶，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "趕快去工作啦！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "真是的……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}和祈梨",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n望著在鬧區來來去去的人們。",
    "voice": null,
    "unit_id": null
  },
