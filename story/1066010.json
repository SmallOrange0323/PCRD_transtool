    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "但畢竟龍人族不會那麼容易就出現嘛。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "雖然在「吉歐‧提格尼亞」找到了雙胞胎，",
    "voice": "vo_adv_1066010_031",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n但她們似乎沒有想加入【龍族巢穴】的意思……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不過說到底，",
