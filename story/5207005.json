    "voice": "vo_adv_5207005_008",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我想盡可能地",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "避免使用恢復魔法。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "雖然我很清楚",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "做這種事",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "其實不太好……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "……",
    "voice": "vo_adv_5207005_009",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "來到村子前──",
    "voice": "vo_adv_5207005_010",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "妳問我「為什麼要搭理我」。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n我沒能好好答覆妳……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "對不起。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "……",
    "voice": "vo_adv_5207005_011",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "那是……",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "那個時候……",
    "voice": "vo_adv_5207005_012",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n坦白說，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "連我自己也不是很清楚。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n為什麼我會",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "想和安涅默涅小姐",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "成為朋友……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "still",
    "still_id": "520700501"
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "一、",
    "voice": "vo_adv_5207005_013",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "一開始……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "在吉歐‧格黑納剛認識不久的時候……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n要是能和守護騎士做朋友，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "可能會有助於我們",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "在未知的世界冒險，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n我當時……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "可能產生了",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "這樣的想法。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "但是……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "background",
    "bg_id": "501050"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "……即使不耍這種小聰明，",
    "voice": "vo_adv_5207005_014",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n涅妃‧涅羅小姐",
    "voice": null,
    "unit_id": 126012
  },
