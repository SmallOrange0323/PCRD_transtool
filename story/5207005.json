    "name": "可璃亞",
    "words": "要讓妳看喔。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "──恢復魔法。",
    "voice": "vo_adv_5207005_003",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n技術非常",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "高超──",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "……？",
    "voice": "vo_adv_5207005_004",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n可是──",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "到目前為止，",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
