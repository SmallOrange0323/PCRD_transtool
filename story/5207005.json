  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "不小心被可璃亞看到用眼淚治癒幼貓的身影，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n安涅默涅立刻從後面反剪她的雙臂。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n可是──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "妳說",
    "voice": "vo_adv_5207005_000",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "一樣──",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n那是什麼意思？",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "…………",
    "voice": "vo_adv_5207005_001",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "安涅默涅小姐，",
    "voice": "vo_adv_5207005_002",
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "妳的手又受傷了吧。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n所以……",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我現在",
    "voice": null,
    "unit_id": 126012
  },
