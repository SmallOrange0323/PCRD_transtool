    "type": "dialogue",
    "name": "可璃亞",
    "words": "也是一位非常溫柔的人。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "對我們非常地友善。",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "可是，",
    "voice": null,
    "unit_id": 126012
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "即使是知道了這件事之後……",
