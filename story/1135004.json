[
  {
    "type": "background",
    "bg_id": "500160"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在工作告了一段落後，美里和{0}\\n帶著充實的疲倦感在沙灘上散步著。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "來海邊後，",
    "voice": "vo_adv_1135004_000",
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我體驗到了很多事情。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "跟{0}在一起",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "總是很快樂呢。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "下次會發生什麼樣的事情呢。",
    "voice": "vo_adv_1135004_001",
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我開始有些期待了。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "不過，",
    "voice": "vo_adv_1135004_002",
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我也很喜歡像這樣",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "兩人一起在沙灘上",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "悠悠哉哉地散步喔？",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "那……",
    "voice": "vo_adv_1135004_003",
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "你呢？",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀？",
    "voice": "vo_adv_1135004_004",
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n總覺得陽光",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "突然變強了呢。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n哎呀哎呀？",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "眼前變得",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "一片空白……？",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "background",
    "bg_id": "510250"
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "終於到了。",
    "voice": "vo_adv_1135004_005",
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "……",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "海浪的聲音真是悅耳。",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "謝謝你今天陪我來。",
    "voice": "vo_adv_1135004_006",
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n很快就要到",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "托兒所的遠足日了，",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n但我想做好",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "事前勘查。",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "找你來的話，",
    "voice": "vo_adv_1135004_007",
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "你應該會注意到",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我沒察覺到的地方，",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "今天",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "就請你多多幫忙囉？",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "好了，",
    "voice": "vo_adv_1135004_008",
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我們馬上去沙灘那邊繞繞吧。",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n要是沙灘上有掉什麼危險物品就不好了，",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我們得仔細",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "確認才行。",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "咦？",
    "voice": "vo_adv_1135004_009",
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "啊……",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "難不成",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "你是在問我為什麼不換上泳裝嗎？",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "今天",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "只是來做事前勘查，",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "不需要特地換上泳裝的。",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀，",
    "voice": "vo_adv_1135004_010",
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "你看起來像是",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "有些惋惜耶？",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n……沒有嗎？",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "是真的嗎。",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "海浪很平緩，",
    "voice": "vo_adv_1135004_011",
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "沙灘很柔軟，",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "感覺就算跌倒也不會受傷。",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "在這裡玩的話，",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "孩子們肯定也會很高興。",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "但是……",
    "voice": "vo_adv_1135004_012",
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "真的不會有問題嗎。",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我",
    "voice": "vo_adv_1135004_013",
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "沒有在海邊玩過。",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n我有辦法讓孩子們",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "玩得盡興嗎。",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "而且，",
    "voice": "vo_adv_1135004_014",
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "如果孩子們",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "在海裡溺水，",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n我有辦法救他們上岸嗎。",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "對不起。",
    "voice": "vo_adv_1135004_015",
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n我明明是老師，",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "卻老想著這種事情……",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我很怕",
    "voice": "vo_adv_1135004_016",
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "真的發生什麼狀況時，",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "自己卻什麼都辦不到──",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "──哎呀？",
    "voice": "vo_adv_1135004_017",
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n那個浮在海面上的東西……",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "是人？",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "大、",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "大事不好了！",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "他是溺水了嗎！？",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "得快點去救他才行！",
    "voice": "vo_adv_1135004_018",
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n要是我有什麼意外，",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "你就負責去",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "找人來幫忙！",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "你等著，",
    "voice": "vo_adv_1135004_019",
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我這就過去救你……！",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "呀！",
    "voice": "vo_adv_1135004_020",
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "沒想到穿著衣服下海",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n會這麼難活動……！",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "不過，",
    "voice": "vo_adv_1135004_021",
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "幸好他沒被沖到海上……",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "咦，",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀？",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀哎呀？",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n這個",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "不是人……",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "……是海藻？",
    "voice": "vo_adv_1135004_022",
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我、",
    "voice": "vo_adv_1135004_023",
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我也真是的，",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "真是太貿然行事了……！",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "唉……",
    "voice": "vo_adv_1135004_024",
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "好丟臉哦。",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n回岸上吧……",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "咦？",
    "voice": "vo_adv_1135004_025",
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n哎呀，",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "{0}你也跑來了？",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "為我感到擔心？",
    "voice": "vo_adv_1135004_026",
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n……",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "謝謝你。",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "老師我",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "很開心。",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "不過，",
    "voice": "vo_adv_1135004_027",
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "對不起，",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n原本還以為有人溺水，",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "是老師誤會了，",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "結果只是海藻在水上飄。",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101532
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "呵呵，",
