[
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在因明天就要迎來７周年而喧鬧的蘭德索爾的街角，再稍微離遠一點的地方。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n有兩名客人來訪拉比林斯達的可麗餅店。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "歡迎光臨～！",
    "voice": "vo_adv_9010007_000",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n要不要來點好吃的可麗餅～",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "咦，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "啊哈哈，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "真是稀奇的二人組呢。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "經營得真是勤快啊，",
    "voice": "vo_adv_9010007_001",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "可麗餅店。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "妳居然在店裡招待客人，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "世上真是無奇不有。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "那當然，",
    "voice": "vo_adv_9010007_002",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我偶爾也是會認真工作的。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "畢竟明天是值得紀念的７周年啊～",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n妳們就來見識一下可麗餅店長的本領吧！",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "雖然這麼說，",
    "voice": "vo_adv_9010007_003",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "但來客看起來很少呢。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "真不留情～！",
    "voice": "vo_adv_9010007_004",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "也",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "沒辦法啊，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "妳看那邊的攤販！",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n大夢想樂園的經理在開外賣吉拿棒店！",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n另一邊",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "是銀章魚商會拿出真本事在賣章魚燒耶？",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "哈哈哈！",
    "voice": "vo_adv_9010007_005",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n普通口味的可麗餅根本不是對手☆",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "徹底輸了呢，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "迷宮女王。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "要說這種話不如來幫幫我！",
    "voice": "vo_adv_9010007_006",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "七冠同心協力的話，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n銷量",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "也許能夠",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "稍微提升吧？",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "完全無法理解。",
    "voice": "vo_adv_9010007_007",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "要說的話",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "設攤位置這些問題",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "都是因為妳計算失誤吧。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "自作自受。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "跟妳說，",
    "voice": "vo_adv_9010007_008",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "想說這樣下去事態不妙，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我事到如今",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n才在構思周年慶限定的特別可麗餅。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "但是想不出一個滿意的點子～",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "那麼",
    "voice": "vo_adv_9010007_009",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "就讓天才製作人的克莉絲提娜姐姐我",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "來出一個方案吧☆",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "跟我決鬥，",
    "voice": "vo_adv_9010007_010",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "贏了的話就可以獲得免費可麗餅……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n相對地，輸了的話",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "要用７萬盧幣來購買可麗餅的新優惠。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "名字就叫",
    "voice": "vo_adv_9010007_011",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "「決鬥可麗餅」",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "吧☆",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這可是會大賣喔？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "駁回。",
    "voice": "vo_adv_9010007_012",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "那麼不怕死的人，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "一定比我的客人還要少好不好。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我說啊，",
    "voice": "vo_adv_9010007_013",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "似似花有想法嗎？",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "…………",
    "voice": "vo_adv_9010007_014",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "「無限可麗餅」。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "由我生成出無限的仿製可麗餅，",
    "voice": "vo_adv_9010007_015",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n隨著「繼續繼續」",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "「再來再來」的口號端上。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n能夠吃100個就免費，",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "不行的話",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "每個都用７萬盧幣來買。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "駁回。",
    "voice": "vo_adv_9010007_016",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "除了這個國家的公主殿下，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "還有誰能夠完成這個挑戰啊。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "唉……",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "果然只能用這個方案了嗎。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "在半年前店裡的職員們做出最棒的傑作的續作！",
    "voice": "vo_adv_9010007_017",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n是「等比例",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "弟弟可麗餅」",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "ver.1.7.1",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "喔！",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n很厲害吧～！？",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "……咦，妳們兩個要去哪裡啊！",
    "voice": "vo_adv_9010007_018",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "喂～～～！",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "……哎呀，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "走掉了。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "不過，",
    "voice": "vo_adv_9010007_019",
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "稍微想起了那時候呢。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "真令人懷念。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "好了，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "沒時間陷入感傷了，",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n得趕快做慶祝的可麗餅才行。",
    "voice": null,
    "unit_id": 106812
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "為了迎接明天的紀念日，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n拉比林斯達勤奮地做著可麗餅。",
    "voice": null,
    "unit_id": null
  }
]
