    "words": "只有我們知道的祕密地點！",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "不過，",
    "voice": "vo_adv_1004011_060",
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "至今為止我們去過的地方，",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n全都是別人知道的場所……",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "真的有",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "只有我們知道的地方嗎……？",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "原來如此！",
    "voice": "vo_adv_1004011_061",
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "說得沒錯！",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n要是沒有的話，只要去找就行了！",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "still",
    "still_id": "100401101"
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "快點快點，",
    "voice": "vo_adv_1004011_062",
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哥哥！",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n可沒時間磨蹭了！",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊探險隊出發～！",
    "voice": "vo_adv_1004011_063",
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n目的地是",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "沒人知道的地方！",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "我們要去找只有禊和哥哥知道的地方！",
    "voice": "vo_adv_1004011_064",
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n一定要找到一個非常非常特別的地方哦！",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "欸嘿嘿，",
    "voice": "vo_adv_1004011_065",
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "果然跟哥哥一起的探險最開心了～",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n從今以後也要一直跟禊一起探險哦，",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哥哥！",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好的，",
    "voice": "vo_adv_1004011_066",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "辛苦了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "竟然說要尋找只有兩人知道的地方，",
    "voice": "vo_adv_1004011_067",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n還真是浪漫呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不過，",
    "voice": "vo_adv_1004011_068",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我想禊她應該完全沒有那個意思就是了，",
