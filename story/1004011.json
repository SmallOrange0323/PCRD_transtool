[
  {
    "type": "background",
    "bg_id": "500131"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "順利抓住了地痞們以後，\\n禊與{0}正走在返回蘭德索爾的路上。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "今天雖然遇上了很多麻煩事，",
    "voice": "vo_adv_1004011_000",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n不過能夠拿回哥哥被偷走的東西真是太好了！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "而且也讓很多人掉進了陷阱地洞，",
    "voice": "vo_adv_1004011_001",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n果然跟哥哥在一起就會很開心呢～",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "唉～",
    "voice": "vo_adv_1004011_002",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "真不想現在就回家呢。",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n可惜太陽已經要下山了。",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "要是一直都是大白天的話，",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n就能夠跟哥哥再玩久一點……",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "咦？",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "是不是",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "有什麼在發光？",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "這是什麼！？",
    "voice": "vo_adv_1004011_003",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n這是可以繼續玩的意思嗎～～！？",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "background",
    "bg_id": "510100"
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "發現哥哥了～！",
    "voice": "vo_adv_1004011_004",
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊就知道在這附近閒逛，一定能夠遇見你！",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "看得出來嗎？",
    "voice": "vo_adv_1004011_005",
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "欸嘿嘿嘿～",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "你看這個！",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n在國外的爸爸寄信給禊了～！",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "上面寫了許許多多的事情，",
    "voice": "vo_adv_1004011_006",
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n像是關於爸爸探險的地方，",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "還有探險時遇見的人等等，",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n非常有趣哦～",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "然後呢，",
    "voice": "vo_adv_1004011_007",
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊也想要回信給爸爸，",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n不過單純寫信回覆他太無聊了，",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n所以禊打算要放藏寶圖進去！",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "嗯！",
    "voice": "vo_adv_1004011_008",
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊想要讓爸爸知道，",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n禊平常探險的地方是怎樣的地方！",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "所以",
    "voice": "vo_adv_1004011_009",
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊希望哥哥也能夠幫禊這個忙！",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "你願意幫禊嗎……？",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "太棒了！",
    "voice": "vo_adv_1004011_010",
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "那麼必須先決定好起點！",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n果然尋寶的旅程，",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "就是要從會令人興奮的地方開始才行呢。",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊",
    "voice": "vo_adv_1004011_011",
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "已經決定好要當作起點的地方了！",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "來吧，",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哥哥！",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "要開始快樂的畫藏寶圖時間了！",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "background",
    "bg_id": "510120"
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "起點就是",
    "voice": "vo_adv_1004011_012",
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "有許多好玩東西的公園哦！",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n嗯～",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "不過只有公園有些太單調了，",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n其他有沒有什麼可以畫上去的呢？",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "啊，",
    "voice": "vo_adv_1004011_013",
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "那個可麗餅店或許不錯！",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n它常常都在那裡，",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "而且非常顯眼！",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "不過",
    "voice": "vo_adv_1004011_014",
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "好像沒有藏寶圖",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "會把可麗餅店畫上去呢。",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n嗯──",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "對了！",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "就把它當作是酒館吧！",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "像是遊戲裡",
    "voice": "vo_adv_1004011_015",
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "也會在酒館中召集夥伴嘛。",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "召集完夥伴後出發去尋寶！",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "嗯嗯，",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "真是個不錯的起點呢！",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "可是這間可麗餅店，",
    "voice": "vo_adv_1004011_016",
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "總是沒什麼客人對吧？",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n真的能夠順利召集到夥伴嗎……",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "嗯，",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "算了！",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "好，",
    "voice": "vo_adv_1004011_017",
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "那麼終於要輪到",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "通往寶藏的路途了！",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "一定要準備一條超棒的路徑，讓爸爸能夠好好享受！",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "background",
    "bg_id": "510100"
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "……吞口水。",
    "voice": "vo_adv_1004011_018",
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哥哥你小心點，",
    "voice": "vo_adv_1004011_019",
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "這條路可是非常危險的。",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "如果",
    "voice": "vo_adv_1004011_020",
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "不是為了爸爸的話，",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n禊也不想來這種危險的地方……",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "太天真了，",
    "voice": "vo_adv_1004011_021",
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哥哥！",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n比如說那邊那戶人家，",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "看起來雖然很普通，但實際上……",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "裡面有一隻很大，",
    "voice": "vo_adv_1004011_022",
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "而且非常會叫的狗哦！",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "不過，",
    "voice": "vo_adv_1004011_023",
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "牠現在已經跟禊變得很要好，",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n所以看到禊會搖著尾巴湊過來就是了～",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "初次見到的人會覺得牠非常可怕，",
    "voice": "vo_adv_1004011_024",
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哥哥你可要小心囉！",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "啊，",
    "voice": "vo_adv_1004011_025",
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "還有還有！",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "你看那邊那戶人家！",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n感覺起來就有很恐怖的人住在那裡對吧……！",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n而且圍籬也尖尖的！",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "唉～",
    "voice": "vo_adv_1004011_026",
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哥哥，",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "你已經忘記禊跟你說過，",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n叫你要小心了嗎？",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "聽好囉？",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "那戶人家裡……",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "住著會大聲罵人的大叔哦！！",
    "voice": "vo_adv_1004011_027",
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "之前禊打算摘那戶人家裡結的柿子時，被他給發現了，",
    "voice": "vo_adv_1004011_028",
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n那時候真的超恐怖的。",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "啊，",
    "voice": "vo_adv_1004011_029",
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "這裡也要好好畫在地圖上才行。",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "可不能讓爸爸遇上可怕的事呢。",
