  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "もうすぐハロウィン本番だし、",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "そろそろ幽霊が出ても",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "おかしくないさ～",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "もし悪い幽霊と出会ったら、",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "どうするのが一番だと思うね～？",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "そうだね～、",
    "voice": "vo_adv_6076105_001",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "悪い幽霊なら",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "戦ってでも",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "なんとかしないと！",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "……けど、",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "多分こっちの攻撃は当たらないよね～？",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "なら",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "話し合いで解決するさ～！　",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "話せば分かってくれるはずだよ〜！",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "私たちじゃ、",
    "voice": "vo_adv_6076105_002",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "幽霊相手だと",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "手も足も出ないもんね～……",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "いったん逃げて、",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "幽霊と戦える人を呼ぶとするさ～！",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "誰かに頼るのは、",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "全然悪いことじゃないからね～♪",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "あは～、",
    "voice": "vo_adv_6076105_003",
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "友達になれるんなら",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "それが一番だよね～♪",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "悪いことなんかするより、",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "友達と一緒におしゃべりしたり、",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "\\n踊ったりする方が",
    "voice": null,
    "unit_id": 117711
  },
  {
    "type": "dialogue",
    "name": "カオリ",
    "words": "ずーっと楽しいってことを",
