    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "果然還是，呵呵，",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n你可以「啊～」餵我吃嗎？",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "still",
    "still_id": "103800801"
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "啊、啊～嗯……♪",
    "voice": "vo_adv_1038008_052",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "嚼嚼、真好粗……♪",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "……嗯、",
    "voice": "vo_adv_1038008_053",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "嗯咕！？",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "啊，我沒事。",
    "voice": "vo_adv_1038008_054",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我不是被燙到，",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n也不是噎到了……",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "這裡面也放了切塊的章魚吧，",
    "voice": "vo_adv_1038008_055",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n我第一次吃到，覺得很驚訝。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "呵呵。",
    "voice": "vo_adv_1038008_056",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n只要和你在一起，",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我就能有許許多多的初體驗，真開心……♪",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "still",
