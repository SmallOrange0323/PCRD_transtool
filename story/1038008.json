[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "你好。",
    "voice": "vo_adv_1038008_000",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n{0}。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "是的。",
    "voice": "vo_adv_1038008_001",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n你知道嗎。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "今天我的身體狀況特別好喔。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "因為今天有一場",
    "voice": "vo_adv_1038008_002",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n我一直很期待的作家的簽書會。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我不想搞垮身體，",
    "voice": "vo_adv_1038008_003",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n所以最近在生活上比以往還要小心注意。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "萬一我的病情惡化不能下床走動……",
    "voice": "vo_adv_1038008_004",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "雖然我也說過，\\n這樣就要請你去幫我代簽。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "不過，",
    "voice": "vo_adv_1038008_005",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n我果然還是想親自去和作家見面。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "啊，",
    "voice": "vo_adv_1038008_006",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "怎麼辦……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我好興奮。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我的情緒如果太亢奮，",
    "voice": "vo_adv_1038008_007",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "又會……頭暈了♪",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "呵呵。",
    "voice": "vo_adv_1038008_008",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n我們還有時間，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n要不要去哪裡喝杯茶呢。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "畢竟",
    "voice": "vo_adv_1038008_009",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n你也難得來陪我。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "如果{0}也能",
    "voice": "vo_adv_1038008_010",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n快樂度過今天的話，我會很開心的。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "嗯，怎麼辦呢。",
    "voice": "vo_adv_1038008_011",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我很少到城鎮來，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n所以對這裡不熟悉。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "如果{0}有",
    "voice": "vo_adv_1038008_012",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n推薦的咖啡廳的話……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "嗚呀！？",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我、",
    "voice": "vo_adv_1038008_013",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我發出了奇怪的聲音。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "{0}，你怎麼了？",
    "voice": "vo_adv_1038008_014",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n總覺得你又全身閃～閃發光喔……？",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "background",
    "bg_id": "510300"
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "呵呵。",
    "voice": "vo_adv_1038008_015",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n我好久沒在城鎮裡走動了，",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n好開心。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "謝謝你。\\n陪我出來逛街……♪",
    "voice": "vo_adv_1038008_016",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "是的。",
    "voice": "vo_adv_1038008_017",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n也對呢，",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我走了很多路，想稍微休息一下。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "因為我前陣子才出院而已。",
    "voice": "vo_adv_1038008_018",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "醫生和姊姊都",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "嚴格禁止我勉強自己。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "對不起，",
    "voice": "vo_adv_1038008_019",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n我一直在休息。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我覺得頭昏昏沉沉的，",
    "voice": "vo_adv_1038008_020",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n膝蓋也很痠……",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "好像已經有點走不動了。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "哇，你不用那麼擔心也沒關係的。",
    "voice": "vo_adv_1038008_021",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "這種程度的身體不適，",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n對我來說是常有的事。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "或者應該說今天，",
    "voice": "vo_adv_1038008_022",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n我的身體狀況比往常還要好喔。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "很抱歉讓你擔心了。",
    "voice": "vo_adv_1038008_023",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n我這樣不行吧……",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "難得我",
    "voice": "vo_adv_1038008_024",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n能和你約會。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "咦，咦？",
    "voice": "vo_adv_1038008_025",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我以為你是為了慶祝我出院，",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n來和我約會作為獎勵。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "啊哈哈。",
    "voice": "vo_adv_1038008_026",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n總覺得好像只有我自己一個人很興奮，",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "對不起。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "嗯？",
    "voice": "vo_adv_1038008_027",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n你說當成約會也可以嗎？",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我好高興……",
    "voice": "vo_adv_1038008_028",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "嘻嘻，這是我有生以來的第一次約會。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "{0}，\\n我們進去那家店吧。",
    "voice": "vo_adv_1038008_029",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我想稍微休息一下，",
    "voice": "vo_adv_1038008_030",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n在那邊吃點甜點後就會恢復精神了。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "不行嗎……？",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "好的。",
    "voice": "vo_adv_1038008_031",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n你是說可以吧。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n那麼我們進去吧。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "啊哈哈。",
    "voice": "vo_adv_1038008_032",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n只要在你面前，",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n我就會變得很愛撒嬌呢……♪",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "background",
    "bg_id": "510150"
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我開動了。",
    "voice": "vo_adv_1038008_033",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "嚼、",
    "voice": "vo_adv_1038008_034",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "嚼……",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n這個可麗餅",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "真好吃。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "只是，",
    "voice": "vo_adv_1038008_035",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n它份量有點多，我可能會吃不完……",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "如果你願意的話，要不要和我分一半呢？",
    "voice": "vo_adv_1038008_036",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "雖然這樣會變成",
    "voice": "vo_adv_1038008_037",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n間接接吻。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "好的。",
    "voice": "vo_adv_1038008_038",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n因為你是男生嘛，",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n食量比較大呢。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "呵呵。",
    "voice": "vo_adv_1038008_039",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n只有我一個人心跳加速，",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "好像笨蛋一樣……♪",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "啊，你不知道嗎？",
    "voice": "vo_adv_1038008_040",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "男生真的是",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n不太在意這種事呢。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "那麼，應該沒問題吧。",
    "voice": "vo_adv_1038008_041",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "因為對你來說，",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n並不覺得這樣很害羞呢。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "來，",
    "voice": "vo_adv_1038008_042",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "啊～♪",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "哇，你沒事吧？",
    "voice": "vo_adv_1038008_043",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n很燙吧？",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "你有沒有燙到舌頭？",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "呵呵。",
    "voice": "vo_adv_1038008_044",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "因為你吃得太急了喔，",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n……",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "好吃嗎？",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "好的。",
    "voice": "vo_adv_1038008_045",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n這樣的話就太好了。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "你的章魚燒，",
    "voice": "vo_adv_1038008_046",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n好像也很好吃呢。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "盯……♪",
    "voice": "vo_adv_1038008_047",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "咦？",
    "voice": "vo_adv_1038008_048",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n啊沒什麼，",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我不是想要你也說「啊～♪」餵我吃……",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我看你吃得津津有味，",
    "voice": "vo_adv_1038008_049",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n所以很好奇那是什麼味道。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "哇，",
    "voice": "vo_adv_1038008_050",
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我可以嚐嚐味道嗎？",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "你真貼心。",
    "voice": null,
    "unit_id": 103831
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "啊，但是我兩手都有東西了……",
