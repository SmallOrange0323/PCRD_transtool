  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "你說今天有話想對老師說，",
    "voice": null,
    "unit_id": 101511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "是發生什麼事了嗎？",
