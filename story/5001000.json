[
  {
    "type": "background",
    "bg_id": "500130"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "初音為了進行森林守衛與動物苑交易品相關的工作，\\n而來到蘭德索爾……原本應該是這樣的。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "不行啦～！已經不可能趕上了～！",
    "voice": "vo_adv_5001000_000",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "這樣的話……！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "……這裡一個人也沒有……對吧？",
    "voice": "vo_adv_5001000_001",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "閃亮亮☆奇蹟躍傳！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "background",
    "bg_id": "500020"
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "到達蘭德索爾啦！再來就是衝刺了！",
    "voice": "vo_adv_5001000_002",
    "unit_id": 101211
  },
  {
    "type": "background",
    "bg_id": "500370"
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "你好～！我來送貨了！",
    "voice": "vo_adv_5001000_003",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "呼……呼……應該是……趕上了吧？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "動物苑員工",
    "words": "嗯嗯，是在約定時間內喔。",
    "voice": "vo_adv_5001000_004",
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "動物苑員工",
    "words": "\\n",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "動物苑員工",
    "words": "那麼就趕快來進行點檢吧。",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "好……不好意思，稍微先讓我……",
    "voice": "vo_adv_5001000_005",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "……呼嚕呼嚕……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "動物苑員工",
    "words": "……還真是到哪裡都能睡的孩子。喂。初音。",
    "voice": "vo_adv_5001000_006",
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "動物苑員工",
    "words": "\\n該起來啦。交易品數量和清單確實吻合。",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "交……易……啊！",
    "voice": "vo_adv_5001000_007",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n真的嗎？沒弄錯真是太好了！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "動物苑員工",
    "words": "森林守衛的草藥在治療上真是幫了大忙。",
    "voice": "vo_adv_5001000_008",
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "動物苑員工",
    "words": "\\n因為我家的孩子經常受傷。",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "欸嘿嘿，能這麼說真是太好了！",
    "voice": "vo_adv_5001000_009",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我才應該說謝謝，非常感謝你們總是給我們豐盛又美味的食物♪",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "動物苑員工",
    "words": "【伊麗莎白牧場】的乳製品賣到哪裡都是好評如潮呢。",
    "voice": "vo_adv_5001000_010",
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "動物苑員工",
    "words": "\\n",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "動物苑員工",
    "words": "話說回來，聽說小栞在各種工作上都非常努力喔？",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "小栞嗎？",
    "voice": "vo_adv_5001000_011",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "動物苑員工",
    "words": "她說受到了大家的照顧，想好好報答大家。",
    "voice": "vo_adv_5001000_012",
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "動物苑員工",
    "words": "\\n",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "動物苑員工",
    "words": "真陽也有稱讚道『那孩子很能幹』喔。",
    "voice": null,
    "unit_id": 413
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "是嗎……小栞嗎……欸嘿嘿。",
    "voice": "vo_adv_5001000_013",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "對了！我想到一個好主意了♪",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "呵呵呵！好，來開始尋找送給小栞的禮物囉！",
    "voice": "vo_adv_5001000_014",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "（作為姐姐，要為自己努力又可愛的妹妹",
    "voice": "vo_adv_5001000_015",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n挑一個超棒的禮物哦～♪）",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "（該挑什麼好呢～♪",
    "voice": "vo_adv_5001000_016",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "說到小栞喜歡的東西，果然還是書吧～？）",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "（不過，小栞已經有那麼多書了，",
    "voice": "vo_adv_5001000_017",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "而且要是小栞不中意就糟了……）",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嗯～……要是能有個驚喜一點的禮物就好了……",
    "voice": "vo_adv_5001000_018",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "姊姊。妳在做什麼？",
    "voice": "vo_adv_5001000_019",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嗚哇啊啊啊！小、小栞！？",
    "voice": "vo_adv_5001000_020",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "你怎麼會在這裡！？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "和牧場的大家一起買完東西回來了……",
    "voice": "vo_adv_5001000_021",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n然後聽到了姊姊的聲音……不、不可以和妳打聲招呼嗎？",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "怎麼會不可以呢！最近還好嗎？",
    "voice": "vo_adv_5001000_022",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "嗯。牧場空氣不錯的緣故吧？身體狀況越來越好了，",
    "voice": "vo_adv_5001000_023",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n最近也不會搖搖晃晃的了。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "啊……又開始暈起來了……",
    "voice": "vo_adv_5001000_024",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "小栞！",
    "voice": "vo_adv_5001000_025",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "啊嗚……是因為太久沒出遠門的關係嗎？",
    "voice": "vo_adv_5001000_026",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n又開始搖搖晃晃的了……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "妳、妳沒事吧！？呃呃～附近的醫院是在哪裡～！",
    "voice": "vo_adv_5001000_027",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我沒事的。我已經恢復過來了。",
    "voice": "vo_adv_5001000_028",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "唔，那、那就好……妳可不要太勉強自己啊！",
    "voice": "vo_adv_5001000_029",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "嗯……謝謝。姊姊在做什麼啊？",
    "voice": "vo_adv_5001000_030",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我嗎？我啊，我來和動物苑做商品的交易啊☆",
    "voice": "vo_adv_5001000_031",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "然後呢，我也聽說了小栞的事喔～！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我的事？",
    "voice": "vo_adv_5001000_032",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嗯！聽說小栞在牧場的工作上非常勤勞喔！",
    "voice": "vo_adv_5001000_033",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我聽了之後，感到非常高興啊～♪",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "所以呢！想給努力的小栞……",
    "voice": "vo_adv_5001000_034",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "（……雖然想問問看小栞想要的東西……",
    "voice": "vo_adv_5001000_035",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "但是想想還是來點驚喜比較好呢！）",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "想好好稱讚努力的小栞一下啊！好棒好棒！",
    "voice": "vo_adv_5001000_036",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "唔……",
    "voice": "vo_adv_5001000_037",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "那我也差不多該回去了！",
    "voice": "vo_adv_5001000_038",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "　小栞也是路上小心喔！？",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "幫我向伊麗莎白牧場的人們打聲招呼！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "那就先這樣囉！",
    "voice": "vo_adv_5001000_039",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "啊……走掉了……",
    "voice": "vo_adv_5001000_040",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "姊姊，似乎有什麼事想跟我說……",
    "voice": "vo_adv_5001000_041",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "……啊、風開始……啊嗚……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "background",
    "bg_id": "500190"
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "沒想太多就先跑了～！",
    "voice": "vo_adv_5001000_042",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n會不會很奇怪啊，這樣很奇怪吧～！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "小栞腦袋那麼聰明或許已經注意到了！",
    "voice": "vo_adv_5001000_043",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "沒、沒事的！不過就那樣聊下去肯定會更危險吧！",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "好！一定要給小栞一個超驚喜的禮物！",
    "voice": "vo_adv_5001000_044",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "初音的禮物大作戰！",
    "voice": "vo_adv_5001000_045",
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n開始啦♪閃亮亮☆……咕……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n……",
    "voice": null,
    "unit_id": 101211
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "呼嚕……呼嚕……",
    "voice": null,
    "unit_id": 101211
  }
]
