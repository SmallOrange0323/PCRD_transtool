[
  {
    "type": "background",
    "bg_id": "500090"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "茉莉等人決定開始為異文化交流做準備，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n當作與獸人族邁向和平的第一步。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "嗯～",
    "voice": "vo_adv_5104002_000",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "所謂的異文化交流，",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "要做什麼才好呢？",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "雖然阿姨說她已經有想法了……",
    "voice": "vo_adv_5104002_001",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "帶大家逛逛蘭德索爾的知名景點就夠了嗎？",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "那樣的話，",
    "voice": "vo_adv_5104002_002",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n我想跟他們介紹",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "虎虎的超級英雄秀！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "喂喂喂，",
    "voice": "vo_adv_5104002_003",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "誰准你們自顧自地討論的。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我不是說過，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "克莉絲提娜姐姐我已經有個完美計畫了嗎？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "啊，",
    "voice": "vo_adv_5104002_004",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "妳到底跑去哪了啊？",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "為了準備異文化交流，",
    "voice": "vo_adv_5104002_005",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n我可是四處奔走，忙得不可開交呢。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我趁著去和「公主殿下」報告的同時，",
    "voice": "vo_adv_5104002_006",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n順便取得了特別授權的權限和敕書。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "拜此所賜，",
    "voice": "vo_adv_5104002_007",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我差點沒被那個四眼田雞的隨從瞪出一個大洞，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n不過，既然是貪吃佩可直接提出的要求，她也無話可說。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "啊哈哈哈，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "看她一副咬牙切齒，滿臉不甘心的模樣♪",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "喔喔，",
    "voice": "vo_adv_5104002_008",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "妳在說克蕾琪塔小姐吧……",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "那個模樣",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "簡直浮現在我的腦海裡了。",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "總之，她之後八成會以報復的心態",
    "voice": "vo_adv_5104002_009",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "來對我們展開各種監察，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n所以保持報告確實，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "以及帳目上的公開透明，得花不少功夫……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "喂，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "妳那呆滯的表情是怎麼回事？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "沒什麼……",
    "voice": "vo_adv_5104002_010",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我只是覺得，原來克莉絲提娜阿姨",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "妳是個很能幹的人嘛。",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n我之前",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "有點誤會妳了。",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "因為我從其他團員那邊聽到的，",
    "voice": "vo_adv_5104002_011",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "是妳會強逼部下做行政工作，",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n做事情任性妄為",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "又不收拾爛攤子。",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這點小事如果不能隨手完成，那我還當什麼副團長啊。",
    "voice": "vo_adv_5104002_012",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "看妳因為我的能幹而目瞪口呆，真是令人心情愉快♪",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "還有，",
    "voice": "vo_adv_5104002_013",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "晚點妳可以把那些",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "對我有意見的團員名字，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n整理出來給我參考參考。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "畢竟聽起來他們很需要一些教育指導☆",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "那麼，",
    "voice": "vo_adv_5104002_014",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我們要從哪裡開始著手才好呢？",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n應該有很多事情",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "需要準備吧？",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "準備？",
    "voice": "vo_adv_5104002_015",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "哼，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "早就已經準備好了。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n這就是克莉絲提娜姐姐我",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "所規劃而成的異文化交流方案！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我們要進行的就是……",
    "voice": "vo_adv_5104002_016",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "寄宿體驗！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "寄宿體驗……",
    "voice": "vo_adv_5104002_017",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "妳是說，",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n到他人家裡借住",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "的那個寄宿體驗嗎？",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "是啊，",
    "voice": "vo_adv_5104002_018",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我們會到",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "兔子族的聚落打擾幾天，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "主要是為了了解他們的日常生活、",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "工作、",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "飲食文化，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "以及價值觀等等。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "既然宣稱要互相了解，",
    "voice": "vo_adv_5104002_019",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n如果我們對對方一無所知，那還談什麼了解呢。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "喔……",
    "voice": "vo_adv_5104002_020",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "那麼，",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我明白為什麼要進行寄宿體驗了，",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n不過，什麼時候要去呢？",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "當然是現在去啊？",
    "voice": "vo_adv_5104002_021",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "原來如此，",
    "voice": "vo_adv_5104002_022",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "現在去啊。",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "……咦咦咦咦咦！？",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "現在就去嗎！？",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "所謂作戰行動",
    "voice": "vo_adv_5104002_023",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "就貴在迅速果決。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "妳看看這小子，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n我一聲下令，就立刻整頓完畢準備出發囉。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "{0}已經這麼習慣了……",
    "voice": "vo_adv_5104002_024",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "完全可以想像你平日有多麼辛苦。",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "喂，",
    "voice": "vo_adv_5104002_025",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "妳那是什麼意思？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不過話說回來，",
    "voice": "vo_adv_5104002_026",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "如果妳也是【王宮騎士團】的一員，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n就請妳要隨時做好回應緊急動員的準備。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "好了，",
    "voice": "vo_adv_5104002_027",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "事情都明白了吧？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n明白的話，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "就快點做好準備出發吧！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "請、",
    "voice": "vo_adv_5104002_028",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "請等我一下！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n我可是",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "什麼都還沒準備啊～！？",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "──那個，",
    "voice": "vo_adv_5104002_029",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "你們兩個為什麼要跟過來啊？",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我不是說我回家一趟準備遠行，馬上回來，",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "要你們等我嗎？",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "{0}也就算了，",
    "voice": "vo_adv_5104002_030",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "為什麼連克莉絲提娜阿姨都……",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "小子可以跟來，",
    "voice": "vo_adv_5104002_031",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我就不行，妳說說這是什麼道理？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我既然要帶人家的寶貝孩子出遊，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n當然要好好打聲招呼不是嗎？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不過嘛，",
    "voice": "vo_adv_5104002_032",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "那只占了一成原因而已，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "剩下的九成，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "單純只是我好奇而已☆",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我就知道反正一定就是這麼回事！",
    "voice": "vo_adv_5104002_033",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "……",
    "voice": "vo_adv_5104002_034",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "唉唉，",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "怎麼辦？",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "再這樣下去，",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我獸人族的身分就會暴露了……",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "妳在碎碎念什麼？",
    "voice": "vo_adv_5104002_035",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "有話想說的話，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "就當面大聲說出來啊。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我要是說得出口，還糾結什麼啊！",
    "voice": "vo_adv_5104002_036",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "……啊，",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我家到了。",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "好了，",
    "voice": "vo_adv_5104002_037",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我準備好了就回來，",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "你們絕對！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "不管發生什麼事！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "都要在這裡等我喔！？",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這是叫我們要去偷看的暗示嗎？",
    "voice": "vo_adv_5104002_038",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "才不是！",
    "voice": "vo_adv_5104002_039",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我是認真的，",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我說真的，",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我不是在開玩笑喔！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "{0}你也是，",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "要是這位阿姨",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "打算胡來，請你阻止她。",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "拜託你了喔！？",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "哼。",
    "voice": "vo_adv_5104002_040",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "看來她對我是一點信任",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "也沒有。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "無妨，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "每個人都會有不想讓人觸及的一面。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "對茉莉來說，",
    "voice": "vo_adv_5104002_041",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "就是家人了吧。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不對，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "應該說是她自己的……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "出身，才對吧？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "要不然你以為我的眼睛是",
    "voice": "vo_adv_5104002_042",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "裝飾用的嗎？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "那種事根本一看就知道了。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "雖然她本人應該覺得自己隱藏得很好，不過……",
    "voice": "vo_adv_5104002_043",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "智和團長，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "還有其他團員，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "大家都只是假裝沒看出來而已。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "嗯，",
    "voice": "vo_adv_5104002_044",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "其實我也不打算讓她在這裡破功啦。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n畢竟出身和種族之類的，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "對我而言根本不值得一提。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "哎呀……",
    "voice": "vo_adv_5104002_045",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "你一副有話想說的模樣，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "小子。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n覺得很意外嗎？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不過，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我真的是這麼想的喔。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "對我來說，",
    "voice": "vo_adv_5104002_046",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "只要能消磨這股來自體內深處，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n甜膩腐臭又令人厭倦無比的百無聊賴，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n是什麼人我都無所謂。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我可是以不挑對手而聞名的克莉絲提娜姐姐。",
    "voice": "vo_adv_5104002_047",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "無論對方是獸人族、",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "魔族、",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "還是精靈族……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n當然，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "就算是人族也一樣。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "只要站在我面前，一律揮劍斬之，",
    "voice": "vo_adv_5104002_048",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "只要擋住我的去路，一律舉劍殺之。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我所看重的，",
    "voice": "vo_adv_5104002_049",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "就只有是否能與我好好起舞。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n如此而已。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我不是說我是平等主義者，",
    "voice": "vo_adv_5104002_050",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不過單就這方面，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "你大可相信我沒有半點虛言。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "……真是的，",
    "voice": "vo_adv_5104002_051",
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "茉莉妳平時那麼受人照顧，",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "\\n媽媽當然要去打聲招呼才行啊。",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "……不、",
    "voice": "vo_adv_5104002_052",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "不用了，",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "真的不用啦！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n我已經是可以獨當一面的【王宮騎士團】團員！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "不需要媽媽出來打招呼",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "也沒關係的啦！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "……那怎麼行呢！",
    "voice": "vo_adv_5104002_053",
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "\\n禮貌這方面一定要好好做到位才行，媽媽不是常常這樣教妳嗎？",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "啊，",
    "voice": "vo_adv_5104002_054",
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "不好意思。",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "\\n小女一直以來承蒙關照了──",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "啊，",
    "voice": "vo_adv_5104002_055",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "初次見面，妳好。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n我是克莉絲提娜，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "請多指教。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "此次我奉【王宮騎士團】之命，",
    "voice": "vo_adv_5104002_056",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n擔任和平大使一職。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "……原來如此，",
    "voice": "vo_adv_5104002_057",
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "辛苦您了。",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "\\n",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "那麼，",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "克莉絲提娜小姐",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "您來到寒舍是為了什麼呢？",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "作為和平活動的一環，",
    "voice": "vo_adv_5104002_058",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我接下來預定與茉莉團員，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n一同前往獸人族的聚落進行寄宿體驗。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我正是為此前來迎接",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "正躲在妳身後的千金。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "當然，",
    "voice": "vo_adv_5104002_059",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我會保證她的安全。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這可是讓心愛的孩子外出去磨練，妳說是吧？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "沒錯！",
    "voice": "vo_adv_5104002_060",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "而且",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我已經是個有能力的團員了！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "純她……",
    "voice": "vo_adv_5104002_061",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "團長這次也",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "指名由我，",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n擔任和平大使",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "這個重要的任務了！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "再說，",
    "voice": "vo_adv_5104002_062",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我還必須好好盯著",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "克莉絲提娜阿姨才行！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "畢竟要是一個不留神，",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "她不知道會做出什麼事。",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "哈哈哈☆",
    "voice": "vo_adv_5104002_063",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "叫我姐姐、",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "要叫我姐姐。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n再讓我重申一次，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我就讓妳從新兵的斯巴達訓練重新來過。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "要讓茉莉擔任",
    "voice": "vo_adv_5104002_064",
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "與獸人族的和平大使……？",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "\\n",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "可是",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "茉莉，",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "妳……",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "討厭，",
    "voice": "vo_adv_5104002_065",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "媽媽妳就是太愛操心了啦。",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我一定會好好完成使命，",
    "voice": "vo_adv_5104002_066",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "妳就放心在家等我回來吧！！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "……那好吧。",
    "voice": "vo_adv_5104002_067",
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "不過，",
    "voice": "vo_adv_5104002_068",
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "茉莉妳聽好了，",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "\\n獸人族有很多不同的習俗，",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "\\n妳千萬不能",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "做出有失禮數的行為喔。",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "放心吧！",
    "voice": "vo_adv_5104002_069",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n那麼",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "媽媽，",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我出發囉～～！！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "那麼，",
    "voice": "vo_adv_5104002_070",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "貴千金我就帶走了。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n我們會離開蘭德索爾好一陣子──",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "請問……",
    "voice": "vo_adv_5104002_071",
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "克莉絲提娜小姐。",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "\\n妳為什麼",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "什麼話都不說呢？",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "妳指的是什麼呢？",
    "voice": "vo_adv_5104002_072",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "雖然那孩子覺得自己隱藏得很好，不過……",
    "voice": "vo_adv_5104002_073",
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "\\n",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "就是，",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "我們其實是……",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "很抱歉，",
    "voice": "vo_adv_5104002_074",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我不可能記得住所有團員的事情。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "而且我身為【王宮騎士團】，也已經是過去式了。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "要我背下特定部下個人檔案中的枝微末節，",
    "voice": "vo_adv_5104002_075",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n太浪費我的大腦記憶容量了。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "更何況，",
    "voice": "vo_adv_5104002_076",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "以我的立場來說，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n多得是其他地方可以讓我的腦細胞使用得更有意義。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "這樣",
    "voice": "vo_adv_5104002_077",
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "啊……",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不過，",
    "voice": "vo_adv_5104002_078",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我向妳保證，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我們一定會平安回來。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "別看我這樣，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我可是個一諾千金的女人。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "即使是像我這樣不隨俗靡、",
    "voice": "vo_adv_5104002_079",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "特異獨行的人，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n至少也擁有一項能稱之為信念或美學的東西。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "那信念堅不可摧，",
    "voice": "vo_adv_5104002_080",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "也無法破壞。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "既不會丟失，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "也不會迷失……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "就是如此地絕對。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "雖然稱不上誓約那般慎重……",
    "voice": "vo_adv_5104002_081",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不過，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "無論要用什麼方法，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我都會遵守承諾到底♪",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "但是，",
    "voice": "vo_adv_5104002_082",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "若對方發生陣前逃亡、背叛，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "或者其他諸多……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "影響遵守承諾的行為，那我就無法保證了。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "看來您是個",
    "voice": "vo_adv_5104002_083",
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "極為坦率真誠的人啊。",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "我還以為【王宮騎士團】的人會是更……",
    "voice": "vo_adv_5104002_084",
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "\\n善於隱藏掩飾事情的人。",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "那方面我其實也很擅長，但……",
    "voice": "vo_adv_5104002_085",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "承諾這種事，就是要在雙方公平坦承的情況下才能成立不是嗎？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "尤其是現在這樣，",
    "voice": "vo_adv_5104002_086",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n有人用懷疑的目光看著自己時，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "更是如此。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "………………",
    "voice": "vo_adv_5104002_087",
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "站在我的立場，",
    "voice": "vo_adv_5104002_088",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我自認為我這段話",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "正直誠實而毫無虛假。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "至於妳要如何看待，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "那就交給妳自己判斷了。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "……我知道了。",
    "voice": "vo_adv_5104002_089",
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "克莉絲提娜小姐。",
    "voice": "vo_adv_5104002_090",
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "\\n",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "小女她就",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "麻煩妳多照顧了。",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "嗯，",
    "voice": "vo_adv_5104002_091",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "知道了。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "感謝妳",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "對這項任務的理解。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "喂喂喂，",
    "voice": "vo_adv_5104002_092",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "克莉絲提娜阿姨。",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n妳再不過來就不等妳了喔～！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "知道了，",
    "voice": "vo_adv_5104002_093",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "妳當個好孩子再等一下。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我們大人之間",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "還有一些麻煩的流程要走。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "茉莉……",
    "voice": "vo_adv_5104002_094",
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就這樣，克莉絲提娜一行人踏上旅途，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n邁向前途多舛的獸人族和平活動。",
