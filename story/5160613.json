[
  {
    "type": "background",
    "bg_id": "502170"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "那一天，梅杜莎、莫妮卡、咲戀被涅妃‧涅羅傳喚，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n她們前往了鬼岩城塞。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "莫妮卡閣下。",
    "voice": "vo_adv_5160613_000",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "咲戀閣下。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n有勞各位來這裡了。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "對了，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "順帶一提，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "梅杜莎，汝也是啊。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "不要把人叫過來，",
    "voice": "vo_adv_5160613_001",
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "卻當成順便的對待啦。",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "我",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "並不是那麼閒的啊。",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "要是是無聊的原因的話，我不會放過妳喔！",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "請別在意，",
    "voice": "vo_adv_5160613_002",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "涅妃‧涅羅閣下。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n因為我們只是閒過頭了，",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "而在隨意逛著祭典而已。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "對吧，",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "梅杜莎？",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "那、",
    "voice": "vo_adv_5160613_003",
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "那種事情不用說出來也沒關係吧！",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "因為涅妃‧涅羅的錯，",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "讓我變得要暫時住在蘭德索爾了，",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "我才沒有想著",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "要在那之前，",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "把「這邊」刻劃進腦子裡之類的事情喔！",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "──呵呵呵。",
    "voice": "vo_adv_5160613_004",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "明明是蜿蜒之蛇的化身，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "真是個耿直的女孩。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家要做的事情非常簡單明瞭。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家想依照蘭德索爾歡慶新年的慣例，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n賞賜被稱「壓歲錢」的寶物",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "給恁們。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "咦，",
    "voice": "vo_adv_5160613_005",
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "壓、",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "壓歲錢！？",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "那個，",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "雖然妳的心意讓我很高興，",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n但是我們已經",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "不是能拿壓歲錢的年齡……",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "是、",
    "voice": "vo_adv_5160613_006",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "是啊。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "雖然我看起來是這樣，",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "但是我姑且",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "是大人了……",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "咦──",
    "voice": "vo_adv_5160613_007",
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "那不是很好嗎，",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "妳們就收下吧。",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "正如蛇之么女所言。",
    "voice": "vo_adv_5160613_008",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家很清楚恁們",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "是有身分的人。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "但是此次，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "是兼具了替華音她闖的禍的賠禮。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "如果能趁此機會報恩的話，",
    "voice": "vo_adv_5160613_009",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家也能保住面子。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n而且自古以來，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "就有著客氣過頭反而失禮，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "謙讓也要看情況的這種金句良言。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n莫妮卡閣下、",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "咲戀閣下。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "誠摯地希望",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "恁們能笑納。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "但、",
    "voice": "vo_adv_5160613_010",
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "但是……",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "就是說啊……",
    "voice": "vo_adv_5160613_011",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "雖然我很感謝妳的好意……",
    "voice": "vo_adv_5160613_012",
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "但是從他國的重要人士那裡收壓歲錢，",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "這樣好嗎。",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我這次",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "姑且是作為純的代理來的。",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "收賄",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "不會發展成外交問題嗎？　",
    "voice": null,
    "unit_id": 133512
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "直接從一國的公主",
    "voice": "vo_adv_5160613_013",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "那邊收下獎勵……",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "根據情況",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "或許能換新武器，",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "也可能可以替咖啡廳進新商品啊……！？　",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……不對不對不對。",
    "voice": "vo_adv_5160613_014",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "不可以期待過頭。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n就算涅妃‧涅羅閣下",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "再怎麼慷慨，",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "那也只是壓歲錢。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "光是接下來一段時間內的",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "點心能變豪華，",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "就已經很充分了吧。",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "妳們在煩惱什麼啊？",
    "voice": "vo_adv_5160613_015",
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "妳們不要的話我就全部收下了喔。",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "停手，梅杜莎啊。",
    "voice": "vo_adv_5160613_016",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "不要貪心。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "汝的那一份在這裡。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n可千萬別浪費了。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "哼～",
    "voice": "vo_adv_5160613_017",
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "還挺漂亮的呢。",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "好吧，",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "我就忍耐只拿一個吧。",
    "voice": null,
    "unit_id": 133612
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "那、",
    "voice": "vo_adv_5160613_018",
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "那個、",
    "voice": null,
    "unit_id": 133212
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "那個啊……",
