    "name": "鏡華",
    "words": "但沒辦法和你說話……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "果然很寂寞。",
    "voice": null,
    "unit_id": 103611
  },
