[
  {
    "type": "background",
    "bg_id": "500890"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "早市的人潮散去，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "往來的腳步聲也變少的時候。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在小巷內的阿爾克絲鍊金堂店門口，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "有個嬌小的身影站著。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "嘿咻……",
    "voice": "vo_adv_1325001_000",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "好。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "呼。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "好",
    "voice": "vo_adv_1325001_001",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "了。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n就快到開店時間了……",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "哦，",
    "voice": "vo_adv_1325001_002",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "來了來了。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n時間剛剛好呢。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n真準時啊～",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "那麼……",
    "voice": "vo_adv_1325001_003",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "阿爾克絲鍊金堂，",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "開店～",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "background",
    "bg_id": "502370"
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "呼，",
    "voice": "vo_adv_1325001_004",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "有你在真是幫了大忙呢。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "露易去遠方出差了，",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "彩羽也跟著當保鑣，",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n今天就只有我一個人～",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "所以說，",
    "voice": "vo_adv_1325001_005",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "今天一天",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "就麻煩你幫忙了。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "啊，",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "絕對會準時下班，",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "不讓你加班的，",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "放心吧。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n……",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "哦，",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "有客人來了。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "雖然你應該也習慣接待客人了，",
    "voice": "vo_adv_1325001_006",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "總之",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "我來示範一次吧。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "要上囉，",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "大人的待客術……",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "來了～",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "歡迎光臨。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "哎呀哎呀，",
    "voice": "vo_adv_1325001_007",
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "小妹妹",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "是來幫忙的嗎？",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "\\n真了不起呢。",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "那個……",
    "voice": "vo_adv_1325001_008",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "嗯",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "，",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "對呀～",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n哥哥，",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "你去問問客人",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "要什麼東西吧。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "對了對了。",
    "voice": "vo_adv_1325001_009",
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "我的老伴",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "傷到腰了。",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "\\n",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "有沒有什麼適合的藥呢？",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "啊啊，",
    "voice": "vo_adv_1325001_010",
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "太好了。",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "最近，",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "有魔物",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "棲息在村子附近呢。",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "\\n",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "所以",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "老伴",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "才會不顧年紀地說要去驅逐，",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "\\n",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "結果才扛起以前用的槍，",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "就變成那樣了……",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "咦……",
    "voice": "vo_adv_1325001_011",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "魔物嗎。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "那真的很可怕呢。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "那麼",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "這邊有個驅除魔物的護身符，",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "要不要也一起購買呢？",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n對吧，",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "哥哥。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "哦～",
    "voice": "vo_adv_1325001_012",
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "聽起來很棒嘛。",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "那就一起買好了。",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "\\n",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "呼～",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "話說回來，",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "還真是乖巧的孩子呢。",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "\\n多謝妳讓我買到好東西。",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "來，",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "這糖果給妳。",
    "voice": null,
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "耶～",
    "voice": "vo_adv_1325001_013",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "謝謝～！",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "我還會再來的。",
    "voice": "vo_adv_1325001_014",
    "unit_id": 7911
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "好的～",
    "voice": "vo_adv_1325001_015",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "期待再次光臨～",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n……",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "嗯，",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "大概",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "就是這種感覺。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "不是，",
    "voice": "vo_adv_1325001_016",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "我可不是小孩子啊。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n剛才那種大人銷售術，",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "你也看到了吧。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "來買鑽頭的人",
    "voice": "vo_adv_1325001_017",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "想要的不是鑽頭，",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "而是「洞」。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "也就是說，",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "提供解決問題的方法，",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "才是能幹的店員。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n如何？",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "學到了嗎？",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "啊～",
    "voice": "vo_adv_1325001_018",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "你想嘛，",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "要全部說明",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "不是很麻煩嗎？",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "這是所謂的",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "臨機應變。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "不過，",
    "voice": "vo_adv_1325001_019",
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "算了。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "總之在下一位客人上門之前，",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "先把這裡的庫存……",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "怪了。",
    "voice": null,
    "unit_id": 132512
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n啊啊，",
