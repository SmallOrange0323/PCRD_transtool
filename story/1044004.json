[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在街上散步的伊莉亞與{0}，突然被不可思議的光芒所包覆。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這道光是怎麼回事？",
    "voice": "vo_adv_1044004_000",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n該不會，是對妾身發動的攻擊嗎？",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "哼！",
    "voice": "vo_adv_1044004_001",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n竟然敢攻擊妾身，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n膽子還不小呢。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "但是，你用不著慌張。",
    "voice": "vo_adv_1044004_002",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身會保護你的，放心吧。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "background",
    "bg_id": "510290"
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "恭喜！",
    "voice": "vo_adv_1044004_003",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n這是二獎的福袋！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯……？",
    "voice": "vo_adv_1044004_004",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "喔，是你啊。",
    "voice": "vo_adv_1044004_005",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n居然在這種地方遇到你，真巧呢。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……嗯，你說這袋子嗎？",
    "voice": "vo_adv_1044004_006",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "是妾身買番茄汁拿到的。",
    "voice": "vo_adv_1044004_007",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n看起來，似乎是獻給妾身的貢品呢。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯嗯，真是用心。",
    "voice": "vo_adv_1044004_008",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "讓妾身馬上來鑑定一下內容吧。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "機會難得。",
    "voice": "vo_adv_1044004_009",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n也准你一起看看。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯，這是什麼？",
    "voice": "vo_adv_1044004_010",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……美顏器？可以讓人變美？",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "哦……拿這玩意兒送給世界上最美的妾身……",
    "voice": "vo_adv_1044004_011",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n是刻意想惹妾身生氣的嗎？",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯嗯……原來如此。",
    "voice": "vo_adv_1044004_012",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "原來是這樣，",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n人民總是會對支配者強加過高的理想呢。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "但是，能順應這種想法才稱得上是支配者。",
    "voice": "vo_adv_1044004_013",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n人民的心意，妾身確實地收到了。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……你、你說可愛、嗎……？",
    "voice": "vo_adv_1044004_014",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……哼！",
    "voice": "vo_adv_1044004_015",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n很不適合用來形容妾身的詞彙呢……",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不、不過，既然是從你口中說出來的，",
    "voice": "vo_adv_1044004_016",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n這次就原諒你吧。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "好了，還放了什麼其他的東西呢……？",
    "voice": "vo_adv_1044004_017",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……這是？",
    "voice": "vo_adv_1044004_018",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n手持式按摩器？",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n另外這是……攜帶用迷你加濕器……？",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "原來如此，",
    "voice": "vo_adv_1044004_019",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n盡是些妾身沒看過的玩意。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "在妾身長眠的這段期間，",
    "voice": "vo_adv_1044004_020",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n世界變得很方便呢。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "那麼……這些就是那個叫福袋還是什麼的裡頭全部的東西了吧。",
    "voice": "vo_adv_1044004_021",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n算是挺有趣的――",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "咦？",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "看來裡面似乎還有一樣東西呢。",
    "voice": "vo_adv_1044004_022",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n讓妾身看看……？",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這是……手鐲嗎？",
    "voice": "vo_adv_1044004_023",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "哼，就這設計看來是給男人用的吧。",
    "voice": "vo_adv_1044004_024",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "一點都不適合妾身……",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "――好！",
    "voice": "vo_adv_1044004_025",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n這個手鐲就給你吧。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "別、",
    "voice": "vo_adv_1044004_026",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "別會錯意了！",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n妾身可沒有特別的意思！",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "那個……對、對了，是這樣的！",
    "voice": "vo_adv_1044004_027",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這只是妾身看在你平時的努力上，",
    "voice": "vo_adv_1044004_028",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n賞賜給你的獎勵而己！",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你、",
    "voice": "vo_adv_1044004_029",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你儘管感謝妾身吧！",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "接下來，今後你也要繼續為了妾身犧牲奉獻！",
    "voice": "vo_adv_1044004_030",
    "unit_id": 104431
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "伊莉亞，即使在那邊仍然還是個孩子呢。",
    "voice": "vo_adv_1044004_031",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n真是可憐……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不過要是伊莉亞在那邊以吸血鬼之姿復活的話，",
    "voice": "vo_adv_1044004_032",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n那麼，事情也會變得很嚴重了呢～",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "我在這邊的世界，",
    "voice": "vo_adv_1044004_033",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "雖然可以算是神明之類的角色，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "但即便是我，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "也無法干涉伊莉亞",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這個很特別的存在呢……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "但我也只記得，",
    "voice": "vo_adv_1044004_034",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n伊莉亞是位很漂亮的大姐姐就是了……？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "啊，剛才那個是我根據你與伊莉亞的「記憶碎片」所製造出的「夢」。",
    "voice": "vo_adv_1044004_035",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n很懷念嗎？嗯，你還不太明白吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "如果你收集到更多「記憶碎片」，",
    "voice": "vo_adv_1044004_036",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n就可以再讓你看到其他的「夢」了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "看過自己與許多女孩子的「夢」之後……",
    "voice": "vo_adv_1044004_037",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n你就能找出這世界的真相了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n加油喔♪",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那麼，下次再見囉～♪",
    "voice": "vo_adv_1044004_038",
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯……？",
    "voice": "vo_adv_1044004_039",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……看起來妾身好像是睡著了呢。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這裡是……蘭德索爾啊。",
    "voice": "vo_adv_1044004_040",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "居然在路上睡著了，這也是妾身力量低落的證據嗎……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "而且妾身好像做了一個奇怪的夢……？",
    "voice": "vo_adv_1044004_041",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……什麼？",
    "voice": "vo_adv_1044004_042",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n你也做了一個跟妾身在商店街相遇的夢？",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "…………嗯。",
    "voice": "vo_adv_1044004_043",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n這還真是奇妙。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "算了。",
    "voice": "vo_adv_1044004_044",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n別管那個，咱們繼續散步吧！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "與夢中一樣，在這個城鎮裡，",
    "voice": "vo_adv_1044004_045",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n也充斥著妾身從沒見過的東西。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "若是發現有能夠幫助妾身征服世界的東西，全都要告訴妾身喔。",
    "voice": "vo_adv_1044004_046",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
