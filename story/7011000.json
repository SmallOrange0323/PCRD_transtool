[
  {
    "type": "background",
    "bg_id": "500420"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "高聳入雲的絕海巨塔——露娜之塔。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n為了尋找失去記憶的線索，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}和流夏來到露娜之塔。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "哦，",
    "voice": "vo_adv_7011000_000",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這裡看起來也十分驚人呢。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "看來是無法輕易解決了。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "嗯？　",
    "voice": "vo_adv_7011000_001",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不要露出那麼擔心的表情嘛。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "別忘了你是為了什麼才把我叫來的？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "打鬥是我的專長，",
    "voice": "vo_adv_7011000_002",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "更何況是為了你，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這把劍，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我會盡情地揮舞的，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你就放一百二十個心吧。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那麼，",
    "voice": "vo_adv_7011000_003",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "姑且不談這件事……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你也注意到了吧？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "盯―――……",
    "voice": "vo_adv_7011000_004",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那個孩子，",
    "voice": "vo_adv_7011000_005",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "從城鎮開始就一直跟在我們後面。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那是你的熟人嗎？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "是嗎，",
    "voice": "vo_adv_7011000_006",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你的人脈真廣呢，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小哥。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "喂～",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那邊的姑娘，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "趕緊現身吧。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "什麼！　",
    "voice": "vo_adv_7011000_007",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我辛苦躲藏，",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "從城鎮沿途隱身尾隨，",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "居然輕而易舉地被識破了是也！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "明明打扮得像是要去參加祭典一樣，",
    "voice": "vo_adv_7011000_008",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "妳到底在說什麼啊？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "所以，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "妳是何許人也？　",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "從各種層面來看，妳似乎也並非等閒之輩。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "啊！　",
    "voice": "vo_adv_7011000_009",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我是",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "那位將軍的侍從，\\n",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "名為妮諾是也！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "嘿，",
    "voice": "vo_adv_7011000_010",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小哥，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "原來你還是",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "將軍啊？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "今天",
    "voice": "vo_adv_7011000_011",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我聽聞將軍",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "和武士大師",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n要一起去攀登不可思議的高塔，",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "迫不",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "急待，",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "於是前來探訪是也！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "拜託你們，",
    "voice": "vo_adv_7011000_012",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "請讓我",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "與兩位同行吧！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n我想親眼見識",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "武士大師的劍術是也！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不是，",
    "voice": "vo_adv_7011000_013",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那武士大師是怎麼回事啊。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我只是一介流浪者，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "沒有妳說得那麼偉大。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "妳太謙虛了！　",
    "voice": "vo_adv_7011000_014",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "懲治於海上作亂的魔物、",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "毀滅犯罪組織，",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "還有",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "解決了讓整個蘭德索爾",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "陷入恐懼之中的",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "妖刀事件。",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "妳的事蹟",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "可是多到數不完呢！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "唉……",
    "voice": "vo_adv_7011000_015",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我過去的所作所為，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "似乎有點太引人矚目了呢。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n麻煩反而自己找上門了。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那麼，",
    "voice": "vo_adv_7011000_016",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小哥，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你打算怎麼做？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n我是你的劍，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "所以我會遵從你的決定唷。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "將軍～！",
    "voice": "vo_adv_7011000_017",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n多謝憐憫，",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "感謝",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "感激",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "感動不已是也！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你是認真的？",
    "voice": "vo_adv_7011000_018",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……算了，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就算拒絕，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "應該也不會乖乖聽話吧。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "將軍，",
    "voice": "vo_adv_7011000_019",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "既然你同意讓我隨行，",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n那麼我也將抱持著和武士大師",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "一同粉身碎骨的覺悟，",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n盡心盡力地侍奉你！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "總而言之，",
    "voice": "vo_adv_7011000_020",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那個",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "武士大師的叫法",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就免了。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "聽得我渾身不自在。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "呣呣呣，",
    "voice": "vo_adv_7011000_021",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "那麼，",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我該怎麼稱呼妳呢？",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "喂，",
    "voice": "vo_adv_7011000_022",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你在胡說什麼啊！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "喔～！　",
    "voice": "vo_adv_7011000_023",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "大姐頭！　",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "聽起來真不錯！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你看看，",
    "voice": "vo_adv_7011000_024",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "都是你亂說話！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
