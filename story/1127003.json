[
  {
    "type": "background",
    "bg_id": "500040"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "盜賊團被摧毀之後，鈴的名聲也開始在一般市民之間廣為流傳，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n被稱作「橡子遊俠‧鈴」的她，非常受人歡迎。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "嚼嚼，",
    "voice": "vo_adv_1127003_000",
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "呼，",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "工作前的紅豆麵包真是太美味了。",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "再來一份，",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "經紀人。",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "什麼～",
    "voice": "vo_adv_1127003_001",
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "已經到了？",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "真是沒辦法，",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我就去稍微露個臉吧。",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "background",
    "bg_id": "500580"
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "那麼就有請她上台吧。",
    "voice": "vo_adv_1127003_002",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "遊戲新作發表會的\\n特別來賓，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "橡子遊俠‧鈴小姐～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "來了來了，",
    "voice": "vo_adv_1127003_003",
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "大家好～",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "雖然我才剛來，",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "但我可以回去了嗎？",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "觀眾們",
    "words": "啊哈哈哈哈！",
    "voice": "vo_adv_1127003_004",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "鈴小姐妳太突然了！",
    "voice": "vo_adv_1127003_005",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "\\n大家～",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "為了讓鈴小姐有精神努力，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "\\n請把橡子丟向舞台～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "觀眾１",
    "words": "小鈴～！",
    "voice": "vo_adv_1127003_006",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "觀眾１",
    "words": "加油～！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "有好多點心喔，",
    "voice": "vo_adv_1127003_007",
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "真是太感謝了。",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "那麼，",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我就再努力一下下吧～",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "啊，",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "活動結束後我可以收下這款遊戲嗎？",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "觀眾們",
    "words": "啊哈哈哈哈！",
    "voice": "vo_adv_1127003_008",
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500580"
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "橡子遊俠‧鈴小姐的握手會會場在這邊～！",
    "voice": "vo_adv_1127003_009",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "司儀",
    "words": "\\n請按照整理券上的號碼順序排隊！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "觀眾１",
    "words": "小鈴，",
    "voice": "vo_adv_1127003_010",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "觀眾１",
    "words": "我會一直為妳加油打氣的！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "觀眾１",
    "words": "\\n",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "觀眾１",
    "words": "要加油喔！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "嗯，",
    "voice": "vo_adv_1127003_011",
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "謝謝妳。",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "但我不太想加油呢。",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "觀眾２",
    "words": "我、",
    "voice": "vo_adv_1127003_012",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "觀眾２",
    "words": "我是",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "觀眾２",
    "words": "小鈴妳的",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "觀眾２",
    "words": "大粉絲……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "觀眾２",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "觀眾２",
    "words": "啊，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "觀眾２",
    "words": "那個可以的話，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "觀眾２",
    "words": "請妳叫一下我的名字！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "咦～",
    "voice": "vo_adv_1127003_013",
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "好麻煩，不要。",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "觀眾２",
    "words": "唔喔～！",
    "voice": "vo_adv_1127003_014",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "觀眾２",
    "words": "這冷淡的態度，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "觀眾２",
    "words": "真讓人受不了！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "觀眾２",
    "words": "謝謝妳！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "呼，",
    "voice": "vo_adv_1127003_015",
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "累了累了。",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "{0}，之後的預定行程是什麼？",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "呃，",
    "voice": "vo_adv_1127003_016",
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "好麻煩喔～",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "算了，",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "畢竟我很強，這也是沒辦法的事嘛。",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "嗯～",
    "voice": "vo_adv_1127003_017",
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "不過真沒想到我",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "居然會這麼努力地工作呢。",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n還被大家叫作什麼橡子遊俠，",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "被捧得高高在上的。",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n人生真是難以預料啊。",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "完全不會唷？",
    "voice": "vo_adv_1127003_018",
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "可是啊，",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我只要稍微努力一下，",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n就可以大把大把地賺到錢喔。",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "就算隨便應對，",
    "voice": "vo_adv_1127003_019",
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "周遭的人也會自己炒熱氣氛、感到高興，",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "即使是困難的工作，",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "也只要讓你來幫忙就能解決。",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "哎呀～",
    "voice": "vo_adv_1127003_020",
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "勞動還真是簡單啊！",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "不過",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "這也是多虧了我這麼強啦。",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "真希望能就這樣",
    "voice": "vo_adv_1127003_021",
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "繼續度過簡單模式的人生啊。",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我也會",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "分一些好處給你的，",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "就拜託你囉～",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "background",
    "bg_id": "500156"
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "哼哼～",
    "voice": "vo_adv_1127003_022",
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "順利順利超順利～",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "今天也來悠哉地",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "大賺一筆吧～",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我看看，",
    "voice": "vo_adv_1127003_023",
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "是怎麼樣的委託──",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "喔～",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "擊退魔物是吧。",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n如果是平常的話我只會覺得麻煩，",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "但今天我的心情莫名地好。",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "這點程度的魔物沒問題的，",
    "voice": "vo_adv_1127003_024",
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n我也得好好展現一下我強大的一面嘛。",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "{0}，那我要出發囉～",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "明明平常我說不要你也會叫我去的說，",
    "voice": "vo_adv_1127003_025",
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "這次是怎樣啊。",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "你說危險？",
    "voice": "vo_adv_1127003_026",
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "這個討伐對象也沒什麼大不了的吧？",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "振作一點啦經紀人。",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我是不知道你為什麼不想讓我去啦，",
    "voice": "vo_adv_1127003_027",
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n如果是現在的我明明沒問題的說。",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "算了沒關係，",
    "voice": "vo_adv_1127003_028",
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "反正我也沒有一定要去。",
    "voice": null,
    "unit_id": 112711
