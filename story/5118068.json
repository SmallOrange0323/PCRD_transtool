[
  {
    "type": "background",
    "bg_id": "500020"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "[FFFFFFFF]某一天，正當{0}帶著碧卡拉",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "[FFFFFFFF]\\n在蘭德索爾的大街上逛時──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]哈哈！",
    "voice": "vo_adv_5118068_000",
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]\\n這裡望過去的景色很不錯呢！",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]可以將蘭德索爾的城鎮一覽無遺！",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]原來{0}知道這麼棒的地點呀。",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]而且……",
    "voice": "vo_adv_5118068_001",
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]嗯，",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]這裡和鎮上比起來，清靜多了。",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]\\n很適合想要靜下來思考的時候呢♪",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]那當然囉！",
    "voice": "vo_adv_5118068_002",
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]就讓我把這地點追加進",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]我腦內的蘭德索爾觀光地圖中吧！",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]哪天真的出版來販售好了？",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]哈哈！",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]………………",
    "voice": "vo_adv_5118068_003",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]哈哇！？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]嗯？",
    "voice": "vo_adv_5118068_004",
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]\\n……",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]那個，我問你喔？",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]\\n對面有個人一直緊盯著這邊看……",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]是你認識的人嗎？",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]…………",
    "voice": "vo_adv_5118068_005",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]不不不不……",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]咦？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]不不不不，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]不可能不可能……",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]對、",
    "voice": "vo_adv_5118068_006",
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]對方一邊唸唸有詞一邊快步逼近了喔！？",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]\\n而且身體幾乎沒有因此產生起伏啊！",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]她是你認識的人吧？",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]拜託快說你認識呀！",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]當真嗎、",
    "voice": "vo_adv_5118068_007",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]這真的是現實嗎……？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]也就是說，真的真的…………",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]如果是那樣，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]糟糕不行了，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]要去了要去了……！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]呃、",
    "voice": "vo_adv_5118068_008",
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]那個……",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]嗨～♪",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]──",
    "voice": "vo_adv_5118068_009",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]──！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]是真正的鼠耳巫女啊──────！！",
    "voice": "vo_adv_5118068_010",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]咦？",
    "voice": "vo_adv_5118068_011",
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]沒想到竟能在蘭德索爾路邊這種地方",
    "voice": "vo_adv_5118068_012",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]遭遇到東國的巫女，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]噢呵，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]就算跟今天早上的七七香說這件事，她肯定也不會相信吧……！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]吞口水……",
    "voice": "vo_adv_5118068_013",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]這、",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]這就是傳聞中的巫女裝嗎……",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]啊啊，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]果然不是角色扮演啊……",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]是真正巫女的真貨服裝啊。",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]這個神聖感，和以前我曾經",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]弄到手過的劣質品根本不能比……！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]雖、",
    "voice": "vo_adv_5118068_014",
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]雖然妳好像自己講得很開心，但可以打擾一下嗎？",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]\\n妳的名字……",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]是七七香沒錯吧？",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]嗚吱！",
    "voice": "vo_adv_5118068_015",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]不對，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]沒錯！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]我太過興奮，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n[FFFFFFFF]差點變成最可愛大猩猩啦，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]啊哈哈！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]果然是這樣嗎。",
    "voice": "vo_adv_5118068_016",
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]\\n……",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]嗯，我稍微放心一點了。",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]讓我做個自我介紹吧！",
    "voice": "vo_adv_5118068_017",
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]我是碧卡拉！",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]妳的推理沒錯，",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]我是東國的巫女喔！",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]妳有聽說過鼠神宮嗎？",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]嗚喔──",
    "voice": "vo_adv_5118068_018",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]鼠神宮！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]來啦！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]我知道，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]當然知道！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]\\n是守護著東國北方的",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]超靈驗又能帶來好運的神社對吧！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]哈哈！",
    "voice": "vo_adv_5118068_019",
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]\\n原來妳知道的還不少嘛！",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]\\n謝謝妳，",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "[FFFFFFFF]我很開心唷！",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]噢",
    "voice": "vo_adv_5118068_020",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]呼！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]\\n這、",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]這衝擊力真是不得了……！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]這種撼動宅宅內心的",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]心跳加速感受……",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]沒錯！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "[FFFFFFFF]那就是，",
    "voice": "vo_adv_5118068_021",
    "unit_id": 101311
  },
  {
