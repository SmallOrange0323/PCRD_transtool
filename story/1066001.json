  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "迷失於蘭德索爾巷弄中的{0}，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在聽見背後傳來的叫喊聲後回過了頭。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "別跑──！",
    "voice": "vo_adv_1066001_000",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "哼～！",
    "voice": "vo_adv_1066001_001",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "哪有那種被說了別跑就真的不跑的笨蛋啊！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "嗚哇！？",
    "voice": "vo_adv_1066001_002",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "喂！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n幹嘛呆站在路中央啦！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "話說，不妙了！",
    "voice": "vo_adv_1066001_003",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n要被追上了啦！！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "這種事情一看就知道了吧！",
    "voice": "vo_adv_1066001_004",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "啊～真是的！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "要是我被抓到那就是你害的！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "是又怎樣？",
    "voice": "vo_adv_1066001_005",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n反正也與你無關……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "啊啊真是的！",
    "voice": "vo_adv_1066001_006",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我現在可沒時間在這裡耗啊！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n該該該、",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "該怎麼辦……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "呀啊！",
    "voice": "vo_adv_1066001_007",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你、",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你要做什……！？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在{0}將少女藏進披風的同時，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n出現了兩個明顯衣著怪異的男人。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "奇、",
    "voice": "vo_adv_1066001_008",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "奇怪？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "沒人啊？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "\\n她剛剛是轉進了這條巷子裡沒錯吧？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "我們該不會跟丟了吧？",
    "voice": "vo_adv_1066001_009",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "\\n喂喂喂，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "這下該怎麼辦啊……",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "唔──！？",
    "voice": "vo_adv_1066001_010",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "唔──！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "唔──！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "唔！？",
    "voice": "vo_adv_1066001_011",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "唔唔唔唔唔啊嗚！\\n（啥！？這哪裡沒事了啊！）",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "唔唔唔──！",
    "voice": "vo_adv_1066001_012",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "唔唔唔嗚嗚！\\n（我說你──！快點放開我！）",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "總之現在也只能先走了！",
    "voice": "vo_adv_1066001_013",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "那孩子一個人的話總會有辦法的吧！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "就是因為她一個人沒辦法，才會派我們來啊……",
    "voice": "vo_adv_1066001_014",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "喂不妙，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "他們已經追過來了！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "快開溜吧！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "在這裡！",
    "voice": "vo_adv_1066001_015",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "那些傢伙逃得還真快……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n到底往哪裡跑了？",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "噗哈──！",
    "voice": "vo_adv_1066001_016",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你、",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你做什麼啦……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "咦，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "王、",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "【王宮騎士團】！？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "唔，",
    "voice": "vo_adv_1066001_017",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "那邊那位！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "你剛剛是不是抓著那名少女不放？",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "所以才打算把我藏起來嗎？",
    "voice": "vo_adv_1066001_018",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "唉……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "這傢伙到底是怎麼回事啊……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "啥？",
    "voice": "vo_adv_1066001_019",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "保護？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n你在胡說什麼啊？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "原來如此……",
    "voice": "vo_adv_1066001_020",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "是因為剛才那夥人……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n你做的很好。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "這位少女就交由我們來保護吧。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "什、",
    "voice": "vo_adv_1066001_021",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "什麼！？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "給我等等！！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n我我我、",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "我",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "才沒有迷路什麼的！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n我可不需要【王宮騎士團】的幫助！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "唔嗯，",
    "voice": "vo_adv_1066001_022",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "這樣可不行啊。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n不過",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "這位少女好像有點眼熟……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "噫！？",
    "voice": "vo_adv_1066001_023",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n你、",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你在說什麼呀──？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n我聽不太懂耶──？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "哎呀，",
    "voice": "vo_adv_1066001_024",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "現在可不是說這個的時候！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n我得去追剛才那夥人才行。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n妳",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "知道他們往哪裡跑了嗎？",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "應該是那邊吧──",
    "voice": "vo_adv_1066001_025",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n大概就是那邊沒錯──",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "好了！",
    "voice": "vo_adv_1066001_026",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你給我閉上嘴！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "這樣啊！",
    "voice": "vo_adv_1066001_027",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "謝謝你們的情報！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n等等記得把那位少女帶到我們騎士團的據點！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "那麼我就先告辭了！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "我們走！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "就說了我不會去啦！！",
    "voice": "vo_adv_1066001_028",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "唉，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "真是的……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "哎呀──",
    "voice": "vo_adv_1066001_029",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "剛剛還真是驚險啊。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "就是啊就是啊，",
    "voice": "vo_adv_1066001_030",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "真是千鈞一髮呢。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "哎呀──能蒙混過去真是太好了，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "祈梨。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "說什麼「真是太好了祈梨」",
    "voice": "vo_adv_1066001_031",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "啊！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n你們兩個！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "竟然丟下幹部自己逃之夭夭！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "不是，",
    "voice": "vo_adv_1066001_032",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "妳突然消失不見了我們也沒辦法啊。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "這位小哥也不需要擺出備戰架勢啦。",
    "voice": "vo_adv_1066001_033",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "\\n我們可是祈梨的同伴喔。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "啥？",
    "voice": "vo_adv_1066001_034",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "在這一帶竟然有人不認識我……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "看來你",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不是做這行的人吧？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "真沒辦法，就讓我告訴你吧。",
    "voice": "vo_adv_1066001_035",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我是祈梨。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "是在暗中操控蘭德索爾的最強幫派，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n【龍族巢穴】的高級幹部。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "還不快向我表示敬意！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "不不，",
    "voice": "vo_adv_1066001_036",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "幹部什麼的，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "只是祈梨妳自封的吧……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "再說，我們家族",
    "voice": "vo_adv_1066001_037",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "也不是最強的啊……",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "呀──！",
    "voice": "vo_adv_1066001_038",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "你們都安靜啦！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n既然老大和嘉夜夜都是幹部，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那我當然也是幹部啊！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "反正，總之發生了很多事，",
    "voice": "vo_adv_1066001_039",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "所以我們\\n都在被【王宮騎士團】追著呢。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "話說回來，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "小哥你真是幫了大忙啊。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "你在胡說什麼啦～！",
    "voice": "vo_adv_1066001_040",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n我可是差點",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "就要被這傢伙\\n推給【王宮騎士團】了耶！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "不過要是沒有他插手，",
    "voice": "vo_adv_1066001_041",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "我們三個就都要被抓了喔？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "沒錯沒錯。",
    "voice": "vo_adv_1066001_042",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "祈梨也向他道個謝吧？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "才不需要向這種傢伙道謝呢！",
    "voice": "vo_adv_1066001_043",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "再說了，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "明明是因為我靈機一動，巧妙地告訴了他們錯誤的方向才……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "可惡，",
    "voice": "vo_adv_1066001_044",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "都走到死路了還是不見他們的蹤影！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n折回去再找一遍！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "呃，",
    "voice": "vo_adv_1066001_045",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "那群人折回來了！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "祈梨啊……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "\\n妳為什麼偏偏要指給他們一條死路？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "什麼？",
    "voice": "vo_adv_1066001_046",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "死路……？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "咦？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "奇怪？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "為什麼好像變成全部都是我的錯了？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "唉……",
    "voice": "vo_adv_1066001_047",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "對祈梨抱有那種期待才是錯的。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "開溜啦！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "快點，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "祈梨也跟上。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "給、",
    "voice": "vo_adv_1066001_048",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "給我等一下啦！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這是因為那個，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這傢伙披風角度的關係",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "之類的？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "害我當時只能指向那裡，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n所以就這樣那樣的……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "嗚唔唔唔……",
    "voice": "vo_adv_1066001_049",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "什、",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "什麼嘛。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n幹嘛一直盯著我看！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "有什麼好看的！？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n我可是記住",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "你這張臉了喔！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "再會啦，",
    "voice": "vo_adv_1066001_050",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞1",
    "words": "小哥。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "地痞2",
    "words": "掰啦！",
    "voice": "vo_adv_1066001_051",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我將來一定會回敬你的～！",
    "voice": "vo_adv_1066001_052",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "找到了！",
    "voice": "vo_adv_1066001_053",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "給我追──！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}就這樣看著祈梨被幫派成員一手抱起，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n目送倉皇逃跑的背影漸漸遠去……",
    "voice": null,
    "unit_id": null
  }
]
