[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "某一天，靜流增加了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n一場渴求著深愛的弟弟{0}、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n空前絕後的姐姐大亂鬥即將揭開序幕。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "靜流等人",
    "words": "弟～～～～～～弟♪",
    "voice": "vo_adv_1200002_000",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "討厭，",
    "voice": "vo_adv_1200002_001",
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "真是纏人～！",
    "voice": null,
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "話說回來，",
    "voice": "vo_adv_1200002_002",
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我們四處逃竄了那麼久，卻完全甩不掉她們……！",
    "voice": null,
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我的行動模式",
    "voice": null,
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "果然全被看穿了……！",
    "voice": null,
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "就算躲起來，也會馬上被找到……",
    "voice": "vo_adv_1200002_003",
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "真是棘手哪。",
    "voice": null,
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "咦，",
    "voice": "vo_adv_1200002_004",
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "什麼什麼？",
    "voice": null,
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n弟弟，",
    "voice": null,
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "你想要知道姐姐的弱點嗎？",
    "voice": null,
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "嘿嘿嘿，",
    "voice": null,
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "你知道姐姐的弱點是想幹嘛呀？",
    "voice": null,
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "……",
    "voice": "vo_adv_1200002_005",
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "或許對「眾多的我」也有效？",
    "voice": null,
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "這樣啊，",
    "voice": null,
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "原來不是想對姐姐惡作劇啊……",
    "voice": null,
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "真是遺憾。",
    "voice": null,
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "弱點",
    "voice": "vo_adv_1200002_006",
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "嗎……",
    "voice": null,
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "嗯～",
    "voice": null,
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n我想不太到啊……",
    "voice": null,
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "畢竟姐姐",
    "voice": null,
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "大部分的事都能克服。",
    "voice": null,
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "先",
    "voice": "vo_adv_1200002_007",
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "不說這個了。",
    "voice": null,
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n假如那群「眾多的我」",
    "voice": null,
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "和魔法少女的力量有關連……",
    "voice": null,
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n那針對這點去思考解決方法說不定比較好呢。",
    "voice": null,
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "這種時候，",
    "voice": "vo_adv_1200002_008",
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "要是有魔法少女專家在的話……",
    "voice": null,
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "呵呵呵～呵♪",
    "voice": "vo_adv_1200002_009",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n蘭德索爾今天也很和平呢♪",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "這也是",
    "voice": "vo_adv_1200002_010",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "多虧有魔法少女她們在。",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "選擇她們的我，",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "眼光果然沒錯！",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n身為魔法生物，",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "沒有比這更讓人高興的事情了。",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "希望和平的日子",
    "voice": "vo_adv_1200002_011",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "能就這樣永遠持續下去。",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n說～笑的啦，",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "嘿嘿嘿嘿──",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "──有了～！",
    "voice": "vo_adv_1200002_012",
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "咦！？",
    "voice": "vo_adv_1200002_013",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "那邊的毛茸茸魔法生物",
    "voice": "vo_adv_1200002_014",
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "──摩拉！",
    "voice": null,
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "剛才，",
    "voice": "vo_adv_1200002_015",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "有人叫了我的名字吧……？",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "但是，為什麼呢，",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "我完全不想回頭……！",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "感覺我一回頭，",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "剛才說的台詞就會全部毀於一旦……！　",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "……我瞄一眼看看吧。",
    "voice": "vo_adv_1200002_016",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "靜流等人",
    "words": "弟～～～弟！",
    "voice": "vo_adv_1200002_017",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "……",
    "voice": "vo_adv_1200002_018",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "………",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "有好多靜流！？",
    "voice": "vo_adv_1200002_019",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "我看了就知道！？",
    "voice": "vo_adv_1200002_020",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n到底是發生了什麼事，才會變成這樣啊，騎士大人！？",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "姐姐我",
    "voice": "vo_adv_1200002_021",
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "增加了！",
    "voice": null,
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "妳增加了嗎……",
    "voice": "vo_adv_1200002_022",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "總之你先跟我一起來！",
    "voice": "vo_adv_1200002_023",
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "……咦？",
    "voice": "vo_adv_1200002_024",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "守護世界和平是你的職責吧？",
    "voice": "vo_adv_1200002_025",
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n姐姐和弟弟陷入危機了。",
    "voice": null,
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n你願意幫忙吧？",
    "voice": null,
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "嗯，",
    "voice": "vo_adv_1200002_026",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "我當然願意！",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n我可是守護全世界人類笑容的",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "魔法生物呢！！",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "但是，",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "我可以說句實話嗎！！！",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "我、",
    "voice": "vo_adv_1200002_027",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "我不想扯上關係……！",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "好，",
    "voice": "vo_adv_1200002_028",
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我們走吧～♪",
    "voice": null,
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "後頸！",
    "voice": "vo_adv_1200002_029",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "別抓著我的後頸啊～～～～～！",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "background",
    "bg_id": "500890"
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "……原來如此。",
    "voice": "vo_adv_1200002_030",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "老實說，我不知道自己到底理解了什麼，",
    "voice": "vo_adv_1200002_031",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n不過我知道變成這樣的原因了。",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "果然",
    "voice": "vo_adv_1200002_032",
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "還是跟魔法少女的力量脫不了關係吧。",
    "voice": null,
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "嗯，",
    "voice": "vo_adv_1200002_033",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "不會錯的。",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n我認為那些分身們",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "是因為靜流的能力而誕生的。",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "因為能力而誕生……",
    "voice": "vo_adv_1200002_034",
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "不是指迷你弟弟嗎？",
    "voice": null,
    "unit_id": 120011
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "創造迷你騎士的能力。",
    "voice": "vo_adv_1200002_035",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n要追根究柢的話，",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "那也是",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "「將愛具現化的力量」。",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "靜流",
    "voice": "vo_adv_1200002_036",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "對騎士大人的愛",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "無比巨大。",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "我想正因為如此……",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "她們才會誕生出來。",
    "voice": null,
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
    "words": "魔法少女的力量想要替妳實現",
    "voice": "vo_adv_1200002_037",
    "unit_id": 4211
  },
  {
    "type": "dialogue",
    "name": "摩拉",
