    "name": "愛梅斯",
    "words": "碧卡拉吧？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "她那種性格接下來也會吃很多苦吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "因為她應該沒辦法輕易交到朋友，",
    "voice": "vo_adv_1256004_063",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n所以既然認識了，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你就要好好幫助她喔。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那今天就先這樣。",
    "voice": "vo_adv_1256004_064",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "再見囉～",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500390"
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "……",
    "voice": "vo_adv_1256004_065",
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "……哈！",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "剛、",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "剛剛、",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "那個夢是……？",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n出、",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "出現了長得跟人家一模一樣的人……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "人家，",
    "voice": "vo_adv_1256004_066",
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "在別人眼裡看起來是那種感覺嗎……？",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "好、",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "好害羞啊……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "這就是所謂的共感性羞恥嗎……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "真鬱卒……",
    "voice": "vo_adv_1256004_067",
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "就算是在夢裡，露出那種醜態實在太鬱卒了……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "但是，",
    "voice": "vo_adv_1256004_068",
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "那孩子也有著跟自己不相稱的夢想呢……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "讓人家有點感同身受呢……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "不、",
    "voice": "vo_adv_1256004_069",
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "不過，",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "姑且",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "在當巫女的人家，",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "領先她",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "一步了吧……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "不知道為什麼，",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "人家不想輸給那孩子……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "那麼，",
    "voice": "vo_adv_1256004_070",
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "現在就不是跟這個人客氣的時候了呢。",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n要開始新的工作，",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "穩固生活基礎才行……！　",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "那、",
    "voice": "vo_adv_1256004_071",
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "那個……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "關於你剛剛說的打工的事情……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n如果可以的話……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "果然還是可以",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "請你再介紹給人家嗎……？",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "啊，",
    "voice": "vo_adv_1256004_072",
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "但是……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n如果可以的話，那個……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "最好是在生魚片上放花的工作，",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n或是不用跟任何人講話，盡可能簡單的工作就好了～",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "人家",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "是這麼想的……",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "雖然戰戰兢兢的，但碧卡拉準備踏出下一步。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n不過，那一步是接近陽托邦的一大步。",
    "voice": null,
    "unit_id": null
  }
]
