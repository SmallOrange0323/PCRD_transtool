  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "要不要跟我們一起流汗啊？」。",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125614
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "人、",
