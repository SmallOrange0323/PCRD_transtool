    "words": "\\n",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "陰沉的少女",
    "words": "一邊勉強",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "陰沉的少女",
    "words": "辦完了要上的學校的手續……",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "陰沉的少女",
    "words": "但是，",
    "voice": "vo_adv_1256004_023",
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "陰沉的少女",
    "words": "辦完手續後人家已經身心俱疲了……",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "陰沉的少女",
    "words": "\\n",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "陰沉的少女",
    "words": "在、",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "陰沉的少女",
    "words": "在人家想要早點回公寓休息而拿出地圖來看的時候……",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "陰沉的少女",
    "words": "\\n",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "陰沉的少女",
    "words": "那個，",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "陰沉的少女",
    "words": "地圖被風吹走了……",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "陰沉的少女",
    "words": "在人家追著地圖一段時間之後，",
    "voice": "vo_adv_1256004_024",
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "陰沉的少女",
    "words": "就回到車站這裡了……",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "陰沉的少女",
    "words": "\\n",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "陰沉的少女",
    "words": "結果，",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "陰沉的少女",
    "words": "人家不但沒追到地圖，",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "陰沉的少女",
    "words": "還一步都走不動了……",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "陰沉的少女",
    "words": "人、",
    "voice": "vo_adv_1256004_025",
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "陰沉的少女",
    "words": "人家已經做好覺悟會就這樣像隻老鼠，",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "陰沉的少女",
    "words": "\\n在車站的角落不為人知的生活，然後靜靜地死去了……",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "陰沉的少女",
    "words": "噫噫噫──！",
    "voice": "vo_adv_1256004_026",
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "陰沉的少女",
    "words": "請、",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "陰沉的少女",
    "words": "請不要說那麼殘酷的話……",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "陰沉的少女",
    "words": "像、",
    "voice": "vo_adv_1256004_027",
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "陰沉的少女",
    "words": "像人家這種陰沉角色要跟都會的人講話，",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "陰沉的少女",
    "words": "\\n",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "陰沉的少女",
    "words": "光是想像那個畫面……",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "陰沉的少女",
    "words": "人、",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "陰沉的少女",
    "words": "人家就……",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "陰沉的少女",
    "words": "啊哇哇哇哇哇哇……",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "陰沉的少女",
    "words": "所、",
    "voice": "vo_adv_1256004_028",
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "陰沉的少女",
    "words": "所以說……",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "陰沉的少女",
    "words": "\\n如果可以的話，",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "陰沉的少女",
    "words": "希望你能帶人家到",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "陰沉的少女",
    "words": "這張紙上寫的住址那邊……",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "陰沉的少女",
    "words": "你、",
    "voice": "vo_adv_1256004_029",
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "陰沉的少女",
    "words": "你知道",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "陰沉的少女",
    "words": "那在哪裡嗎？",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "陰沉的少女",
    "words": "\\n那、",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "陰沉的少女",
    "words": "那麼就",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "陰沉的少女",
    "words": "拜託你了……",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "陰沉的少女",
    "words": "名、",
    "voice": "vo_adv_1256004_030",
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "陰沉的少女",
    "words": "名字……！",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "陰沉的少女",
    "words": "那、",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "陰沉的少女",
    "words": "那個……",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "陰沉的少女",
    "words": "怎、",
    "voice": "vo_adv_1256004_031",
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "陰沉的少女",
    "words": "怎麼辦啊……",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "陰沉的少女",
    "words": "雖然人家",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "陰沉的少女",
    "words": "覺得他不是壞人，",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "陰沉的少女",
    "words": "\\n",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "陰沉的少女",
    "words": "但是告訴他人家的本名",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "陰沉的少女",
    "words": "有點恐怖呢……",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "陰沉的少女",
    "words": "\\n",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "陰沉的少女",
    "words": "但是，",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "陰沉的少女",
    "words": "不回答感覺也很過意不去……",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "陰沉的少女",
    "words": "那個、",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "陰沉的少女",
    "words": "那個……",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "人、",
    "voice": "vo_adv_1256004_032",
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "人家……",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "叫做",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "碧卡拉。",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "……那、",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "那不是本名，",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "是人家網路上用的名字。",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n是用在一個叫阿斯特朗傳奇的遊戲的……",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "請不要問人家，",
    "voice": "vo_adv_1256004_033",
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "名、",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "名字的由來……",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "對、",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "對不起，",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "人家現在只能說這些……",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "background",
    "bg_id": "510290"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "帶著碧卡拉的{0}，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n經過了商店街。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "啊，",
    "voice": "vo_adv_1256004_034",
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "這裡是……",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "商店街嗎。",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "要經過",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "這裡嗎……？",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "嗚嗚，",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "這",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "裡",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "挺熱鬧呢……",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n如果是更蕭條的地方人家還有辦法通過……",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "除了時髦的店之外，",
    "voice": "vo_adv_1256004_035",
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "店員很有精神的店人家也不太行……",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "就算有善意，",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "巨大的聲音跟強烈的笑容之類的，",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n那種充滿陽光般的壓力會讓人家喘不過氣來……",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "雖、",
    "voice": "vo_adv_1256004_036",
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "雖然你可能覺得人家在意過頭了……",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "但、",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "但是這世界對陰沉角色來說，",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "很難生活啊……",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "好、",
    "voice": "vo_adv_1256004_037",
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "好啦，",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "我們快點離開這個陽光角色的巢穴──",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "咦？",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "這個音樂是……",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "從那間電器行傳來的……？",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "still",
    "still_id": "125600401"
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "那台電視難道……",
    "voice": "vo_adv_1256004_038",
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "果然沒錯！",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "是命運樂園的特輯！",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "哇……",
    "voice": "vo_adv_1256004_039",
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "幸運鼠",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "好可愛喔……！",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n人家也喜歡怪怪鼠",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "跟多貝爾鳥～",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "人家好想去看看",
    "voice": "vo_adv_1256004_040",
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "命運樂園喔。",
    "voice": null,
    "unit_id": 125631
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n人家想跟幸運鼠們",
    "voice": null,
    "unit_id": 125631
  },
  {
