[
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "面對{0}毫不留情的連續打工，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n縱然疲憊不堪，艾姬多娜還是努力完成了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n於是她暫時回到了反映自身記憶的空間。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "502340"
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "真受不了，",
    "voice": "vo_adv_1320003_000",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "有夠辛苦的。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "想不到會要連續工作到那地步……",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "但是，",
    "voice": "vo_adv_1320003_001",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "也因此才能夠瞭解他。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n總之，",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "算是達成我最初的目的了。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我看看喔，",
    "voice": "vo_adv_1320003_002",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "愛梅斯……",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "不在嗎？",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "可能去找失蹤的我了呢。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "機會難得，",
    "voice": "vo_adv_1320003_003",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我就到處調查看看吧。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "愛梅斯似乎總藉由某種能力",
    "voice": "vo_adv_1320003_004",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "觀察著這個世界。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n想必不是任誰都能輕易操控的力量。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "至少平時是如此。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "但是在被我的空間覆蓋著的情況之下，",
    "voice": "vo_adv_1320003_005",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "就有辦法了。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "…………",
    "voice": "vo_adv_1320003_006",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "哦～",
    "voice": "vo_adv_1320003_007",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n原來這裡充滿著記憶呀。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "這是……",
    "voice": "vo_adv_1320003_008",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "他的記憶碎片嗎？",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我來瞧瞧──",
    "voice": "vo_adv_1320003_009",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "──！",
    "voice": "vo_adv_1320003_010",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "有設安全裝置。",
    "voice": "vo_adv_1320003_011",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "看來沒辦法用單純的方法解決呢。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "但是，",
    "voice": "vo_adv_1320003_012",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "這東西如此激發我的興趣，",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n卻要我碰都碰不得，",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "未免也太殘忍了點吧。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "嗯……",
    "voice": "vo_adv_1320003_013",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "既然如此，",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "試試看另一個方法好了──",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "background",
    "bg_id": "500366"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "夜晚的公會小屋。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n入睡前的{0}，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "感到一股奇妙的感覺。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "502340"
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "哎呀，",
    "voice": "vo_adv_1320003_014",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "嚇到你了嗎？",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "你這反應，",
    "voice": "vo_adv_1320003_015",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "不是感到困惑的樣子。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n……看起來比較像是",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "感覺和平時不太一樣而已吧。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "這裡是我的夢之城，",
    "voice": "vo_adv_1320003_016",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "也是舉辦魔女茶會的地方。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我也只是擅自使用愛梅斯的塔，",
    "voice": "vo_adv_1320003_017",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n所以很多地方都有所限制。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "因此",
    "voice": "vo_adv_1320003_018",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "也沒辦法好好泡杯茶請你。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "也就是沒有茶的茶會囉。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "還是一樣沒什麼欲望呢，",
    "voice": "vo_adv_1320003_019",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "你這個人。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "啊，",
    "voice": "vo_adv_1320003_020",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我們可沒有悠哉聊天的餘裕。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "得在愛梅斯回來前解決才行。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "之所以會邀請你來這裡，",
    "voice": "vo_adv_1320003_021",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "是因為我厚臉皮地",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "想再次拜託你。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "你願意聽聽看嗎？",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "……這次也毫不猶豫啊。",
    "voice": "vo_adv_1320003_022",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "這種濫好人的態度，",
    "voice": "vo_adv_1320003_023",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "是相當受環境眷顧所致嗎？",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "還是……",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "也罷，",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "現在先別多想了。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "沒什麼，",
    "voice": "vo_adv_1320003_024",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "這次要拜託你的不是什麼難事。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我想",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "請你當這次茶會的見證人。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我接下來要邀請",
    "voice": "vo_adv_1320003_025",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "「某人」參加的茶會的",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "見證人──",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "──歡迎來到",
    "voice": "vo_adv_1320003_026",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "魔女的茶會。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "…………",
    "voice": "vo_adv_1320003_027",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "謝謝接受我的邀請。",
    "voice": "vo_adv_1320003_028",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n歡迎你──",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "霸瞳皇帝。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "別客氣，請坐。",
    "voice": "vo_adv_1320003_029",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n我叫艾姬多娜，",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "是「強欲的──",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "──閉上妳的嘴，回到原本的世界去，",
    "voice": "vo_adv_1320003_030",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "異端分子。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "好冷淡喔。",
    "voice": "vo_adv_1320003_031",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n至少聽我自我介紹一下嘛。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "原本不該存在於此的東西，",
    "voice": "vo_adv_1320003_032",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n又何須知道名字？",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "──尤其是魔女",
    "voice": "vo_adv_1320003_033",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "這種東西。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "……原來如此。",
    "voice": "vo_adv_1320003_034",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n和在他記憶碎片看到的一樣嚴苛。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "但是，",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "同時又能感受到見聞廣博的一面。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "看來會是場有趣的茶會。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……妳說",
    "voice": "vo_adv_1320003_035",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "記憶碎片？",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "唉……",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "那邊一臉呆樣的你，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n看來被這魔女耍得很徹底啊。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我早就知道你思慮欠周，",
    "voice": "vo_adv_1320003_036",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "判斷總是過於天真，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "唯獨對誰都敞開心胸的那股傻勁",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "實在是令人難以忍受。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "說我耍弄他就太讓人遺憾了。",
    "voice": "vo_adv_1320003_037",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我只是",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "請他來當這茶會的見證人而已。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "而且，",
    "voice": "vo_adv_1320003_038",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "要交談應該是跟我才對吧？",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n邀請你來的人是我喔？",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我可不記得自己成為了妳的客人呢。",
    "voice": "vo_adv_1320003_039",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "但是你人在這裡，",
    "voice": "vo_adv_1320003_040",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "對吧？",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n只要你想，",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "其實也能選擇",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "不赴約的選項，不是嗎？",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "…………",
    "voice": "vo_adv_1320003_041",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "好。",
    "voice": "vo_adv_1320003_042",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n我就允許妳的「謁見」。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "這樣呀，",
    "voice": "vo_adv_1320003_043",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "說是謁見。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n意思是在這世界，",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我才是「訪客」。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "你想當成這麼一回事，我也無妨。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "還真是傲慢無禮呢。",
    "voice": "vo_adv_1320003_044",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n強欲的魔女，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "妳又了解這世界的什麼了？",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我希望自己能夠了解所有的一切啊。",
    "voice": "vo_adv_1320003_045",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "因為我是──",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "強欲嘛。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "可是眼前這個當下，我想了解的是你。",
    "voice": "vo_adv_1320003_046",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "尤其是──",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "關於你的權能。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……",
    "voice": "vo_adv_1320003_047",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "「霸瞳天星」。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "啊～原來是這樣。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "妳的目的是──",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "──認識這個世界。",
    "voice": "vo_adv_1320003_048",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "你這麼快就進入狀況，這樣事情就好辦了。",
    "voice": "vo_adv_1320003_049",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "你的權能，",
    "voice": "vo_adv_1320003_050",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "也就是透視這世界的力量。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n以及運用了這個能力，被稱為預知未來的奇蹟。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "要我對那股力量置之不理，",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我實在做不到。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "所以，",
    "voice": "vo_adv_1320003_051",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "霸瞳皇帝。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "──要不要和我聯手？",
    "voice": "vo_adv_1320003_052",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "妳說",
    "voice": "vo_adv_1320003_053",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "聯手？",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "縱然擁有預測未來的力量，你還是輸了。",
    "voice": "vo_adv_1320003_054",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n這全都要歸咎於",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n你準備好的可能性數量不足。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "也就是你要預測的未來參數還有所不足。",
    "voice": "vo_adv_1320003_055",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "就由我",
    "voice": "vo_adv_1320003_056",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "來為你準備嶄新的未來吧。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "異端分子的我",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "將成為你計算之外的存在。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "為你預測的未來帶來無限分歧，",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "並化為無數的可能性吧。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "哼。",
    "voice": "vo_adv_1320003_057",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n還真是充滿吸引力的邀約。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "對吧？",
    "voice": "vo_adv_1320003_058",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n只要我們聯手，",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "你就能再次──",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我拒絕。",
    "voice": "vo_adv_1320003_059",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "……我可以問是什麼理由嗎？",
    "voice": "vo_adv_1320003_060",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "可惜啊，",
    "voice": "vo_adv_1320003_061",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "強欲的魔女。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "神是獨一無二的存在。",
    "voice": "vo_adv_1320003_062",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n孤高又絕對，",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "因此",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "沒有任何人可以和祂",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "並肩而立。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "為了保持絕對性而自己限縮了可能性。",
    "voice": "vo_adv_1320003_063",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "嗯……",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "這樣的選擇也很有意思。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "機會難得，",
    "voice": "vo_adv_1320003_064",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "趁現在把妳這可能性",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n剔除……",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "或許也很有趣？",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "你是說要把我當異端分子排除掉的意思嗎？",
    "voice": "vo_adv_1320003_065",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "這下可傷腦筋了。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "力量受限的我",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "根本無力招架呀。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "…………",
    "voice": "vo_adv_1320003_066",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "…………",
    "voice": "vo_adv_1320003_067",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "…………",
    "voice": "vo_adv_1320003_068",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "…………",
    "voice": "vo_adv_1320003_069",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "吵架……",
    "voice": "vo_adv_1320003_070",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "的確是。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "可是這下氣氛都沒了呢。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "你不也這樣覺得嗎？",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……唉。",
    "voice": "vo_adv_1320003_071",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "實在是",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "令人惱火。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "既然阻止了我，",
    "voice": "vo_adv_1320003_072",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n你就得為這個魔女的行為負起責任。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……知道了嗎？",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……愚蠢的孩子。",
    "voice": "vo_adv_1320003_073",
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "你就盡量",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "被魔女耍著玩吧。",
    "voice": null,
    "unit_id": 106911
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "又被你救了呢。",
    "voice": "vo_adv_1320003_074",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "說不想知道對戰結果",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "是騙人的，",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "但要是失手戰敗，",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "就本利全無了。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "比起這個，",
    "voice": "vo_adv_1320003_075",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "為什麼你要幫我？",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "如果照霸瞳皇帝說的，",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我可是",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "耍著你玩的魔女耶。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "原來如此。",
    "voice": "vo_adv_1320003_076",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "也就是說，",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "這是付給我的報酬嗎？",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "看來不習慣的勞動還是得做一下呢。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "而且……？",
    "voice": "vo_adv_1320003_077",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n還有什麼理由嗎？",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "……這個",
    "voice": "vo_adv_1320003_078",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "可是連我",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n都沒預期到可能性的答案。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n我，",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "和你──",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "你真的很有意思。",
    "voice": "vo_adv_1320003_079",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "或許是這世界裡",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "最未知的存在。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "你的存在",
    "voice": "vo_adv_1320003_080",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "引起了魔女相當大的興趣。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n我接下來還要",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "再觀察你一段時間哦。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "──因為感覺你可以",
    "voice": "vo_adv_1320003_081",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "充分滿足我的好奇心。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "隨心所欲地觀察異世界的艾姬多娜。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n她的視線盯著{0}，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n愉悅的光彩流轉其間。",
    "voice": null,
    "unit_id": null
  }
]
