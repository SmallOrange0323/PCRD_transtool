  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "鈴奈回到村莊後，一口氣衝進了公會小屋。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "美咲！！！",
    "voice": "vo_adv_5019005_000",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "鈴、",
    "voice": "vo_adv_5019005_001",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "鈴奈！？",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "嗚唔！？",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "呵呵，",
    "voice": "vo_adv_5019005_002",
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "歡迎回來，",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "鈴奈。",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "剛才對不起！",
    "voice": "vo_adv_5019005_003",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "好了啦！　　",
    "voice": "vo_adv_5019005_004",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "不要抱得那麼緊！",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "要更溫柔的對待淑女才行喔！？",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "好嘛，",
    "voice": "vo_adv_5019005_005",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "好嘛！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "那個啊，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我剛才有點說得太過分了！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "對不起！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "要是",
    "voice": "vo_adv_5019005_006",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "今年學校就廢校了該怎麼辦？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n從暑假之前我就一直在想這件事～",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n實在很讓人在意嘛？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "雖然是這樣說……",
    "voice": "vo_adv_5019005_007",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "對吧？",
    "voice": "vo_adv_5019005_008",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "是啊，",
    "voice": "vo_adv_5019005_009",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "說的也是。",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "太好了～！",
    "voice": "vo_adv_5019005_010",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "美咲懂我～！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "咦……",
    "voice": "vo_adv_5019005_011",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "就那樣？",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "咦？　",
    "voice": "vo_adv_5019005_012",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "什麼就那樣？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "妳想嘛，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "說不定我們明年就不能在一起玩了耶？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n那樣子不是超寂寞的嗎？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "說不定會和秀才還有小伊緒",
    "voice": "vo_adv_5019005_013",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "各自分飛耶～？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "既然如此就一定要趁今年",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "一起創造回憶才行呀。",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "鈴奈……",
    "voice": "vo_adv_5019005_014",
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "所以，",
    "voice": "vo_adv_5019005_015",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家才自己一個人那麼慌張。",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n然後也沒注意到美咲妳其實是在鼓勵我……",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "美咲！　",
    "voice": "vo_adv_5019005_016",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "所以說，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "真的很抱歉！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "唔！",
    "voice": "vo_adv_5019005_017",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我、",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我才沒有",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "想要鼓勵妳……！",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "你不要多嘴啦！",
    "voice": "vo_adv_5019005_018",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "再說了！　",
    "voice": "vo_adv_5019005_019",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "就算讀不同學校，",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n我們也不會因此就不在是朋友啊？",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "……因為，",
    "voice": "vo_adv_5019005_020",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n不管分隔多遠，",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "不論經過多長時間，",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我們都是朋友喔。",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "美咲～～！",
    "voice": "vo_adv_5019005_021",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "而且，",
    "voice": "vo_adv_5019005_022",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我隨著時間經過，",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "一定會變成更棒的成熟淑女的。",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "妳就好好期待魅力四射的我吧～！",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "不過，",
    "voice": "vo_adv_5019005_023",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n鈴奈妳對這次的工作和渡假",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "竟然如此的用心，",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我卻沒注意到這件事，",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "真是抱歉。",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "看來我身為一名淑女",
    "voice": "vo_adv_5019005_024",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "還有很長的路要走呢。",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "這樣一來我又會進步成",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "一名體貼的優秀淑女。",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "鈴奈，",
    "voice": "vo_adv_5019005_025",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "那是我要說的，",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "今天對不起了。",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "所以，",
    "voice": "vo_adv_5019005_026",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "妳不介意的話……",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "願意",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "吃這個嗎？",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "still",
    "still_id": "501900501"
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "這個聖代怎麼這麼豐富？",
    "voice": "vo_adv_5019005_027",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "上面有滿滿的水果耶！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "這是我們給妳的禮物。",
    "voice": "vo_adv_5019005_028",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n因為妳幫我們準備了這麼棒的渡假之旅。",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我們請剛才在海邊見到的鈴奈粉絲幫忙製作的。",
    "voice": "vo_adv_5019005_029",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n希望妳吃了這個能夠",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "打起精神。",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "美咲，",
    "voice": "vo_adv_5019005_030",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "謝謝妳～～",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n我好喜歡～～～～！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "我知道了，",
    "voice": "vo_adv_5019005_031",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "妳快點吃啦！",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "哈哈哈，",
    "voice": "vo_adv_5019005_032",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "抱歉抱歉。",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "能夠",
    "voice": "vo_adv_5019005_033",
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "當鈴奈和美咲的班導真是太好了～",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "竟然有如此棒的學生，",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我還真是個幸福的老師呢。",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "當然，",
    "voice": "vo_adv_5019005_034",
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我也很重視\\n{0}還有",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "其他所有學生喔。",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "那麼，",
    "voice": "vo_adv_5019005_035",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我要開動了！",
    "voice": null,
    "unit_id": 110011
  },
