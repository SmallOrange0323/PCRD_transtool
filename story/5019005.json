    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "嗯嗯！　",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "這個超讚，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "神好吃耶！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "那當然！　",
    "voice": "vo_adv_5019005_037",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "因為是我做的嘛！",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "實在超級好吃，",
    "voice": "vo_adv_5019005_038",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "讓我現在興奮起來了！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "要是雨吉也能吃這個，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "他一定能打起精神的。",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "雨吉？",
    "voice": "vo_adv_5019005_039",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "嗯，",
    "voice": "vo_adv_5019005_040",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "就是雨神大人。",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "那是人家幫他取的暱稱～",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "鈴奈，",
    "voice": "vo_adv_5019005_041",
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "妳見到雨神大人了？",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "對啊，",
    "voice": "vo_adv_5019005_042",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "剛才見到的，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "他好像沒什麼活力。",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "咦！？　",
    "voice": "vo_adv_5019005_043",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "那麼重要的事情妳要先說啊！",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "哈哈哈，",
    "voice": "vo_adv_5019005_044",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "抱歉抱歉。",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "美咲做的甜點太好吃了，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n我整個忘得一乾二淨！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "那樣的話，",
    "voice": "vo_adv_5019005_045",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "也沒辦法嘛……！",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "然後啊，",
    "voice": "vo_adv_5019005_046",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我聽說好像還有",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "另一個精靈。",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "可是，",
    "voice": "vo_adv_5019005_047",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "島上的人",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "好像沒說耶？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家也記不清楚了～",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "小伊緒妳記得嗎～？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "是啊，",
    "voice": "vo_adv_5019005_048",
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "那時候",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我只聽到雨神大人的名字。",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "可是，",
    "voice": "vo_adv_5019005_049",
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "妳的確聽到他說",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "還有另一個精靈吧？",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我們請村長先生過來，",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "詳細的詢問一下吧。",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "鈴奈，",
    "voice": "vo_adv_5019005_050",
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "在等村長先生過來時，",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n能不能告訴我，",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "你們聊了什麼？",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "好！",
    "voice": "vo_adv_5019005_051",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "請問",
    "voice": "vo_adv_5019005_052",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "有什麼不便之處嗎？",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "村長先生，",
    "voice": "vo_adv_5019005_053",
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "抱歉勞煩您過來。",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n話不多說，",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我們不是要問雨神大人，",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "而是想問關於晴神大人的事情？",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "你、",
    "voice": "vo_adv_5019005_054",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "你們從哪裡知道那名字的！？",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "看你的反應，",
    "voice": "vo_adv_5019005_055",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "似乎蠻可疑的呢。",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "不、",
    "voice": "vo_adv_5019005_056",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "不是……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "鈴奈說她和雨吉見面，",
    "voice": "vo_adv_5019005_057",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "直接聽他說的喔。",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "啊，",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "雨吉是",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "鈴奈幫雨神大人取的暱稱。",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n順帶一提，",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "那個晴神大人的",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "暱稱好像是晴吉喔。",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "好了，",
    "voice": "vo_adv_5019005_058",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "要坦白就趁現在！",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n快點說你到底隱瞞了什麼！",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "怎麼會……",
    "voice": "vo_adv_5019005_059",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n沒想到……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "妳會直接見到雨神大人，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "還聽說了晴神大人的事情……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "祕密瞞不下去了呢。",
    "voice": "vo_adv_5019005_060",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "看來",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "拜託鈴奈小姐",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "或許是正確的選擇。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "這話什麼意思？",
    "voice": "vo_adv_5019005_061",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "關於那件事，",
    "voice": "vo_adv_5019005_062",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "我現在告訴你們吧。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n首先，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "請問各位目前聽說多少事情了？",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "說到每年都會舉辦儀式，",
    "voice": "vo_adv_5019005_063",
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n但今年只有雨吉甦醒過來？",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家也是！",
    "voice": "vo_adv_5019005_064",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "原來如此。",
    "voice": "vo_adv_5019005_065",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n我想原因大概是",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "祈禱的力量不足以讓",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n兩隻精靈都甦醒。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "我也不清楚為什麼會聚集不到足夠的力量。",
    "voice": "vo_adv_5019005_066",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n我們",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "跟平常一樣，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n祈禱今年也能",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "在夏天時賜與這座島嶼恩惠……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "後來雨吉就一直是一個人生活呢。",
    "voice": "vo_adv_5019005_067",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "他看起來好難過，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "連人家看了都覺得不忍～",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "雨吉和晴吉，",
    "voice": "vo_adv_5019005_068",
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n是非常要好的朋友呢。",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "讓他一個人太可憐了……",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "是啊。",
    "voice": "vo_adv_5019005_069",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n而且，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "現在島上下雨的原因，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n就是因為只有雨神大人甦醒了。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "只有雨吉甦醒有什麼問題嘛～？",
    "voice": "vo_adv_5019005_070",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "雨神大人和晴神大人",
    "voice": "vo_adv_5019005_071",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "掌管著天氣。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "可是，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "那僅限於他們二位都在的時候。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "若是只有他們任一位，",
    "voice": "vo_adv_5019005_072",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "力量將會失衡，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n島上的天氣就會逐漸惡化。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "不過，",
    "voice": "vo_adv_5019005_073",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "雖然會下一陣子的雨，",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "等夏天結束後，",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "雨吉又會沉眠了吧？",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "不是那樣的。",
    "voice": "vo_adv_5019005_074",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "咦咦，",
    "voice": "vo_adv_5019005_075",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "還有後續嗎？",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "傳說是他會就這樣被那股力量給吞噬，",
    "voice": "vo_adv_5019005_076",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n然後失控、失去自我。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "現在",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "雨神大人何時會變成那樣也不奇怪吧。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "要是他變成那樣，",
    "voice": "vo_adv_5019005_077",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "這座島上的天氣就會變得狂暴，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "據說會變得無法住人。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "咦！　",
    "voice": "vo_adv_5019005_078",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "不會吧吧吧吧！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "因為，",
    "voice": "vo_adv_5019005_079",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "為了島上的未來，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n才企劃了明天的活動，並賭上了一切。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "每年，",
    "voice": "vo_adv_5019005_080",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "在這座島的海水浴場開幕日，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "都會聚集很多的觀光客。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "我想那樣應該很足夠了，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "但還是小心為上……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "為了聚集更多的祈禱之力，",
    "voice": "vo_adv_5019005_081",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n我才想說找蘭德索爾的知名藝人過來。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "所以，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "跟島上的年輕人徵求意見之後――",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "就決定找鈴奈了吧！",
    "voice": "vo_adv_5019005_082",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "是啊，",
    "voice": "vo_adv_5019005_083",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "就是如此。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n大家異口同聲的",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "推薦了鈴奈小姐。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "沒想到",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "那樣的名人會願意來我們這樣的小島……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "嗯？",
    "voice": "vo_adv_5019005_084",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n可是啊，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "既然這樣為什麼你不一開始",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "就跟我們說雨吉的事情？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "你早點說就好了啊～",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "那是……",
    "voice": "vo_adv_5019005_085",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "我認為不能",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "因為島上的情況",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n給鈴奈小姐造成",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "額外的壓力。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "所以",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "才閉口不提……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "但是，",
    "voice": "vo_adv_5019005_086",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "我利用了你們是事實……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n欺騙了你們，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "實在",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "非常抱歉……",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "不要緊不要緊！",
    "voice": "vo_adv_5019005_087",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "只要有人家的粉絲，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n不管是哪裡我都去！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "的確，",
    "voice": "vo_adv_5019005_088",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "喚醒沉眠的精靈，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n還是解決島上的天氣什麼的，",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "並不是模特兒的工作……",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "可是如果那樣能讓大家露出笑容，",
    "voice": "vo_adv_5019005_089",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "那就算是模特兒的工作！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "鈴奈小姐……",
    "voice": "vo_adv_5019005_090",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "……那麼，",
    "voice": "vo_adv_5019005_091",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "請讓我再拜託妳一次。",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n請妳在明天的活動上，號召聚集的觀光客，",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n務必要",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "喚醒晴神大人！",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "雨神大人已經到極限了……",
    "voice": "vo_adv_5019005_092",
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "\\n再這樣下去，這座島上",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "村長",
    "words": "將不在有夏天……！",
    "voice": null,
    "unit_id": 511
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "好！　　",
    "voice": "vo_adv_5019005_093",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "交給我吧！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n我會讓哭泣的雨吉",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "露出笑容的！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "而且，",
    "voice": "vo_adv_5019005_094",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "來這座島上的",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "不是只有人家！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "對吧？",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "當然囉！",
    "voice": "vo_adv_5019005_095",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "受到我的美貌吸引，",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n再怎麼不情願也一定會甦醒的！",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "交給我吧！",
    "voice": "vo_adv_5019005_096",
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "\\n",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "身為老師，",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "伊緒",
    "words": "我會保護大家的。",
    "voice": null,
    "unit_id": 110111
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才也拜託了！",
    "voice": "vo_adv_5019005_097",
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我很期待喔！",
    "voice": null,
    "unit_id": 110011
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}一行人在弄清楚島上的天氣與工作邀請的真相後，\\n重新打起了精神，準備起明天的活動。",
    "voice": null,
    "unit_id": null
  }
]
