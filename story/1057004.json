    "name": "愛梅斯",
    "words": "大概是你的個性吧，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n吉塔似乎也有類似的特點，",
