    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我呢，",
    "voice": "vo_adv_1057004_050",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "原本是住在離這座城鎮很遠的地方，",
