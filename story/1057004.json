[
  {
    "type": "background",
    "bg_id": "500020"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "結束了騎空團承接的工作，\\n吉塔與{0}在郊外稍作休息。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "來，給你。",
    "voice": "vo_adv_1057004_000",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "鯛魚燒和茶。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "聽說累的時候很推薦吃個鯛魚燒喔。",
    "voice": "vo_adv_1057004_001",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "「不只是又甜又好吃而已喵」，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n店員是這樣告訴我的。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "啊姆……",
    "voice": "vo_adv_1057004_002",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "嗯！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "果然這種食物，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "就是剛出爐的最好吃呢！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "怎麼樣？",
    "voice": "vo_adv_1057004_003",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "好吃嗎？",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n……",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "對吧？",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "你能吃得開心，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "真是太好了。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "嗯……？",
    "voice": "vo_adv_1057004_004",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "怎麼回事，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "鯛魚燒看起來有點刺眼，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n是不是錯覺……",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "不對，",
    "voice": "vo_adv_1057004_005",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "鯛魚燒才不會發光！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "這道光怎麼回事！？",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "太刺眼了，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "什麼都看不見……！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "background",
    "bg_id": "510100"
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "……咦？",
    "voice": "vo_adv_1057004_006",
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "好奇怪……",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "應該是在這裡轉彎沒錯，",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "為什麼……？",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "完全沒有想到會迷路成這樣……",
    "voice": "vo_adv_1057004_007",
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n怎麼辦……",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "再這樣下去就要在留學第一天遲到了……",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "明明應該是上學路線，",
    "voice": "vo_adv_1057004_008",
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "卻完全沒有穿相同制服的人經過……",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "是不是只能連絡學校，",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "請老師來接我了……",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "啊！",
    "voice": "vo_adv_1057004_009",
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "那個人，",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "穿的是椿丘的制服！",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "那個──！",
    "voice": "vo_adv_1057004_010",
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "不好意思──！",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n吶，",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "等等……！",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "……走掉了。",
    "voice": "vo_adv_1057004_011",
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "唔哇！",
    "voice": "vo_adv_1057004_012",
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "太好了……",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "你注意到我了。\\n",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "那個，",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "其實我想要去椿丘高中，",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n但是卻迷路了……",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "你也是椿丘的學生對吧？",
    "voice": "vo_adv_1057004_013",
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "拜託你！",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "請帶我去學校！",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "謝謝！",
    "voice": "vo_adv_1057004_014",
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我是吉塔。",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "是２年級哦。",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "你是幾年級的？",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "還有，",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "名字是──",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "要是不快一點……？",
    "voice": "vo_adv_1057004_015",
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "對了！",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "會遲到的！",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "跑一下沒問題的，",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "快點吧！",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "background",
    "bg_id": "510240"
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "呼……呼……",
    "voice": "vo_adv_1057004_016",
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "太好了……",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "趕上了……",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "謝謝……",
    "voice": "vo_adv_1057004_017",
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "你幫了我大忙哦。",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "學校裡面有地圖所以沒問題，",
    "voice": "vo_adv_1057004_018",
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我能找到教職員室。",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n你也得去教室了對吧。",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n畢竟在同一所學校裡，",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "一定馬上就能再見面的。",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "那就再見了！",
    "voice": "vo_adv_1057004_019",
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "真的謝謝你！",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "background",
    "bg_id": "510210"
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "是個溫柔的人呢……",
    "voice": "vo_adv_1057004_020",
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n要是班上",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "也有像他一樣的人就好了……",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "話說回來，",
    "voice": "vo_adv_1057004_021",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "妳能趕上實在太好了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "\\n我會拜託班上的同學，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "\\n明天開始盡量和妳一起上學的。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "非常抱歉，",
    "voice": "vo_adv_1057004_022",
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "讓您擔心了……",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我會自己拜託班上的同學看看的。",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n我也想快點和大家成為朋友。",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "真積極呢。",
    "voice": "vo_adv_1057004_023",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "很好很好。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "\\n好了，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "到教室了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "自我介紹準備好了嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "……是的。",
    "voice": "vo_adv_1057004_024",
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "沒有問題。",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "麻煩您了。",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "我先進去和大家說明，",
    "voice": "vo_adv_1057004_025",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "妳先在這裡等一下。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老師",
    "words": "\\n我叫妳之後再進來。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我知道了。",
    "voice": "vo_adv_1057004_026",
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "班長",
    "words": "起立！",
    "voice": "vo_adv_1057004_027",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "班長",
    "words": "敬禮！……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "班長",
    "words": "坐下！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "……",
    "voice": "vo_adv_1057004_028",
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "嗚，",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "好緊張啊……",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105731
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "能不能成功",
    "voice": null,
    "unit_id": 105731
  },
  {
