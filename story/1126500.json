    "name": "未央",
    "words": "今天看起來也很有精神嘛！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "開玩笑的啦♪",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "所以，",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "今天會把未央找來這裡……",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "代表你也知道那件事吧～？",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "哇～",
    "voice": "vo_adv_1126500_001",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "謝謝你♪",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "我的生日",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "原來你都記得啊！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "欸嘿嘿，",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "想想還真是有點難為情耶～☆",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "不過",
    "voice": "vo_adv_1126500_002",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "這真的很不容易喔！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n也許就是這種體貼",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "為你帶來你這麼好的人緣吧！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n連我這個一路看著你成長的人",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "都與有榮焉呢！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "開玩笑的啦～☆",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "你該不會",
    "voice": "vo_adv_1126500_003",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "真的不知道吧？",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "那麼我就告訴你吧！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n今天其實是！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "那個人氣超級巨星，",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n未央的生日啦！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "來～",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "掌聲鼓勵～☆",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "……不對啦，",
    "voice": "vo_adv_1126500_004",
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "你根本連禮物都準備好了！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "明明就清楚得很嘛！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "真是的，",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "知道的話就早講一聲吧！",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "\\n",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "這樣我才能",
    "voice": null,
    "unit_id": 112611
  },
  {
    "type": "dialogue",
    "name": "未央",
    "words": "早一點聽你祝福我呀♪",
