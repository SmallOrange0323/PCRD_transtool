    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這群傢伙原本",
    "voice": "vo_adv_2203005_048",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "大概是魔像之類的東西！",
