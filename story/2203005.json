    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "對、",
    "voice": "vo_adv_2203005_045",
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "對的！",
    "voice": null,
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "\\n我說過！",
