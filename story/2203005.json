  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "這個嘛……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我去去就回。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "祝您一路順風。",
    "voice": "vo_adv_2203005_069",
    "unit_id": 127812
  },
  {
    "type": "background",
    "bg_id": "501780"
  },
  {
    "type": "dialogue",
    "name": "蜘蛛型魔物",
    "words": "──嘎吱嘎吱嘎吱！！",
    "voice": null,
    "unit_id": 50011
  },
  {
    "type": "background",
    "bg_id": "501780"
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "唔……！",
    "voice": "vo_adv_2203005_070",
    "unit_id": 105911
  },
  {
    "type": "background",
    "bg_id": "501780"
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好痛！！",
    "voice": "vo_adv_2203005_071",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小凱留！",
    "voice": "vo_adv_2203005_072",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n小可蘿！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "……",
    "voice": "vo_adv_2203005_073",
    "unit_id": 126111
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 126111
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "有東西，",
    "voice": null,
    "unit_id": 126111
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "要來了。",
    "voice": null,
    "unit_id": 126111
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "該不會……",
    "voice": "vo_adv_2203005_074",
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "是新的敵人吧？",
    "voice": null,
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……不對！",
    "voice": "vo_adv_2203005_075",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n感覺好像不是魔物──",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這是什麼！？",
    "voice": "vo_adv_2203005_076",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n魔力的等級完全不同……！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "──咦！？",
    "voice": "vo_adv_2203005_077",
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "\\n這股氣息，",
    "voice": null,
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "難道是……！",
    "voice": null,
    "unit_id": 130911
  },
  {
    "type": "movie",
    "movie_id": "220300501"
  },
  {
    "type": "background",
    "bg_id": "501780"
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "萊拉耶爾殿下！",
    "voice": "vo_adv_2203005_078",
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "\\n您您您",
    "voice": null,
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "您還好嗎……！？",
    "voice": null,
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……",
    "voice": "vo_adv_2203005_079",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "沒事。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n只不過……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我已經很久沒有像這樣，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n拿出真本事來使用「皇家裝備」了……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "剛才的，",
    "voice": "vo_adv_2203005_080",
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "就是萊拉耶爾小姐的",
    "voice": null,
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "「皇家裝備」之力……",
    "voice": null,
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "對吧？。",
    "voice": null,
    "unit_id": 126011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不僅一口氣，",
    "voice": "vo_adv_2203005_081",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "讓那些蜘蛛全部蒸發，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我們幾個甚至還",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "毫髮無傷……",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "真是不得了呢。",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但相對地，",
    "voice": "vo_adv_2203005_082",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "看起來也筋疲力竭了……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……",
    "voice": "vo_adv_2203005_083",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "只是小事罷了，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "各位，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "請你們別擔心……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我透過庫露露",
    "voice": "vo_adv_2203005_084",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "利用魔法，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n掌握了你們的狀況。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "多虧如此，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我才能把握這個",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "將魔物一網打盡的好機會。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "咦咦咦！？",
    "voice": "vo_adv_2203005_085",
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "\\n是、",
    "voice": null,
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "庫露露",
    "words": "是這樣嗎～！？",
    "voice": null,
    "unit_id": 130911
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……然後，",
    "voice": "vo_adv_2203005_086",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n騎士、",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "貪吃佩可公主……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我想要向你們，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "好好地謝罪。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "謝罪？",
    "voice": "vo_adv_2203005_087",
    "unit_id": 126111
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "該道歉的人",
    "voice": "vo_adv_2203005_088",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是我才對喔？",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "雖說我本來不曉得，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但還是啃掉了城堡裡重要的柱子！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "嗯。",
    "voice": "vo_adv_2203005_089",
    "unit_id": 126111
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "關於那件事，",
    "voice": "vo_adv_2203005_090",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "就請妳別在意了。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n多虧有克蘿茜她們，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "才沒有造成嚴重的損傷，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "還在可以修復的範圍內。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我想謝罪的，",
    "voice": "vo_adv_2203005_091",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "是比那更早的事。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n我們……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……",
    "voice": "vo_adv_2203005_092",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "不。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "是因為我，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "太理所當然地接受各位的好意了。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "那是指……",
    "voice": "vo_adv_2203005_093",
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n哥哥他們",
    "voice": null,
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "被委託去驅除魔物的事，",
    "voice": null,
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "是嗎？",
    "voice": null,
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "沒錯。",
    "voice": "vo_adv_2203005_094",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "就算過去我們多麼歌頌著和平，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "多麼不習慣戰鬥……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "但想保護自己的國家，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "還是應該要靠自己的雙手才對。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "相反的，",
    "voice": "vo_adv_2203005_095",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "你們總是不顧自身的危險，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n不僅肯定庫露露的想法，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "也就是",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "「想奪回大家的笑容」，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n甚至還",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "挺身而出",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "拯救了她。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我不可能",
    "voice": "vo_adv_2203005_096",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "不相信你們各位。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "萊拉耶爾小姐……！",
    "voice": "vo_adv_2203005_097",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "…………",
    "voice": "vo_adv_2203005_098",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "但是，",
    "voice": "vo_adv_2203005_099",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這果然代表……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n有人陷害貪吃佩可小姐和普蕾西亞小姐，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n運氣好的話甚至想試圖毀掉王城……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……沒錯。",
    "voice": "vo_adv_2203005_100",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
