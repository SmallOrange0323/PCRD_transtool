  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "牠是不是又跑去追蝴蝶了呢──？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "對了！",
    "voice": "vo_adv_1223001_029",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "有水果的地方！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n因為貝斯是貪吃鬼，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "說不定會在那裡！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "來！{0}！",
    "voice": "vo_adv_1223001_030",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n跟班比一起去找貝斯吧！",
