  {
    "type": "dialogue",
    "name": "旁白",
    "words": "某天，蘭德索爾──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}在巷子裡被可疑男子們包圍。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "無賴１",
    "words": "哈！",
    "voice": "vo_adv_1223001_000",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴１",
    "words": "只不過是稍微推一下，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴１",
    "words": "就跌了一大跤！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴１",
    "words": "\\n你的劍只是裝飾品嗎！？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴２",
    "words": "喔唷，",
    "voice": "vo_adv_1223001_001",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無賴２",
    "words": "可別輕舉妄動喔。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無賴２",
    "words": "\\n想通過這裡，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無賴２",
    "words": "就乖乖把身上財物交出來。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "慢著！",
    "voice": "vo_adv_1223001_002",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "叔叔們！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "兩人",
    "words": "啊啊？",
    "voice": "vo_adv_1223001_003",
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "122300101"
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "怎麼可以欺負弱者呢！？",
    "voice": "vo_adv_1223001_004",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n班比，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "是不會允許這種事發生的！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "無賴１",
    "words": "是、",
    "voice": "vo_adv_1223001_005",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴１",
    "words": "是怎樣啊，這個小鬼……",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "啊──！",
    "voice": "vo_adv_1223001_006",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n你為什麼拿著小刀呢！？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "無賴２",
    "words": "安、",
    "voice": "vo_adv_1223001_007",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無賴２",
    "words": "安靜一點！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "「不能把刀子對著人」這件事",
    "voice": "vo_adv_1223001_008",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "沒人教過你嗎！？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n不趕快收起來的話──",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "still",
    "still_id": "122300102"
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比，",
    "voice": "vo_adv_1223001_009",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "要懲罰你哦！！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "無賴２",
    "words": "這傢伙……！！",
    "voice": "vo_adv_1223001_010",
    "unit_id": 911
  },
  {
    "type": "background",
    "bg_id": "500890"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "大家",
    "words": "！？",
    "voice": "vo_adv_1223001_011",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "路過的男性",
    "words": "剛才的喊叫聲……",
    "voice": "vo_adv_1223001_012",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "路過的男性",
    "words": "是從巷子裡傳來的？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "路過的女性",
    "words": "有人在叫救命對吧？",
    "voice": "vo_adv_1223001_013",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "路過的女性",
    "words": "\\n誰快點",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "路過的女性",
    "words": "去叫衛兵過來！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "無賴１",
    "words": "呃呃，",
    "voice": "vo_adv_1223001_014",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴１",
    "words": "不妙……！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴１",
    "words": "\\n快逃吧！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴２",
    "words": "給我記住──！",
    "voice": "vo_adv_1223001_015",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "啊，",
    "voice": "vo_adv_1223001_016",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "等一下！",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n要好好道歉後再走──",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "……唔，",
    "voice": "vo_adv_1223001_017",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "跑掉了。",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "真是的，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "怎麼回事呀──？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "……受傷？",
    "voice": "vo_adv_1223001_018",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比嗎？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n班比不會受傷唷──",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "不說這個，",
    "voice": "vo_adv_1223001_019",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "你怎麼能突然大叫呢？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n雖然那些叔叔們逃走了，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "但也有可能會讓他們生氣動粗啊。",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n你為什麼要做這種事啊──？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "…………",
    "voice": "vo_adv_1223001_020",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "你該不會，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n是想幫班比吧？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "……哼──♪",
    "voice": "vo_adv_1223001_021",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "吶，",
    "voice": "vo_adv_1223001_022",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比問你，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n叫什麼名字？",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比，",
    "voice": "vo_adv_1223001_023",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "叫做班比唷♪",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "請多指教囉！{0}♪",
    "voice": "vo_adv_1223001_024",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "聽好囉？",
    "voice": "vo_adv_1223001_025",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n如果你又被欺負了，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "要跟班比說唷？",
