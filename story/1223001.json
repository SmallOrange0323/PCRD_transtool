  {
    "type": "dialogue",
    "name": "班比",
    "words": "你",
    "voice": "vo_adv_1223001_026",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "看起來好像不怎麼強。",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n跟貝斯一模一樣，",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "感覺不能放著你不管……",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "貝斯是班比重要的朋友！",
    "voice": "vo_adv_1223001_027",
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122311
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "是隻粉紅色的龍唷！",
