  {
    "type": "background",
    "bg_id": "501652"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}他們\\n遵照志那都的指示，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "經由索爾之塔，\\n來到了",
