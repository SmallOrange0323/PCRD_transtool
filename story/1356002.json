    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "也就是說。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n妳的困擾是指那個……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "要建造自己的巨大雕像，感到很難為情，",
