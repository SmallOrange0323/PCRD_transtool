    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "徒弟２",
    "words": "是因為那件事，才將他們兩位找來嗎？",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "徒弟２",
    "words": "\\n雖然離正式揭幕還有段時間……",
