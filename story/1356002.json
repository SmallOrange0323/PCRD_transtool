    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "502630"
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "好久沒來了──",
    "voice": "vo_adv_1356002_009",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "雖然不久前才來過，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n但已經讓人十分懷念了。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n看來大家還是一樣很有活力呢。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "…………",
    "voice": "vo_adv_1356002_010",
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "志那都的表情很嚴肅……",
    "voice": "vo_adv_1356002_011",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n問題肯定相當嚴重……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……志那都。",
    "voice": "vo_adv_1356002_012",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n差不多該告訴我們了吧。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n到底發生了什麼事……？",
    "voice": null,
    "unit_id": 100311
  },
