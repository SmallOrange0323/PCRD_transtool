  },
  {
    "type": "dialogue",
    "name": "徒弟１",
    "words": "真難得呢。",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "徒弟１",
    "words": "大家齊聚一堂是怎麼了嗎？",
