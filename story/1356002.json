    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "徒弟２",
    "words": "\\n",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "徒弟２",
    "words": "但我現在也能馬上帶你們參觀！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "啊，",
    "voice": "vo_adv_1356002_016",
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
