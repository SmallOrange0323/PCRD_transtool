  },
  {
    "type": "dialogue",
    "name": "徒弟２",
    "words": "\\n",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "徒弟２",
    "words": "其實呢，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "徒弟２",
    "words": "我們要在這座城鎮建造志那都大人的巨大雕像！",
