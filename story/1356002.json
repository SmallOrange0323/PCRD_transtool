    "type": "dialogue",
    "name": "志那都",
    "words": "\\n嚴苛的訓練也認真地全力以赴，",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "從不說喪氣話，拼命努力。",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "但是……",
    "voice": "vo_adv_1356002_053",
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "即使如此，過去仍然無法抵抗重置。",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "他們的努力化為烏有，",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "連這件事",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "都無法察覺，",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n不斷反覆經歷同樣的時光……",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "我已經見過無數次",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "這樣的光景。",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "這樣的他們現在……",
    "voice": "vo_adv_1356002_054",
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "正在靠自己的力量",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "朝未來前進。",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "願意跟我一起",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "建立更美好的世界……",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "正因為我想珍惜他們的心意……",
    "voice": "vo_adv_1356002_055",
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n我才無法否定他們的意志。",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "因為",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "這正是",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "我最想肯定──",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "最想珍惜的事物。",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "志那都……",
    "voice": "vo_adv_1356002_056",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……沒錯。",
    "voice": "vo_adv_1356002_057",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "如果是為他們著想，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "妳更要說出自己的想法。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "他們不單只是想要建造雕像。",
    "voice": "vo_adv_1356002_058",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我認為大家最希望的，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "是能讓志那都高興。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "他們的心意",
    "voice": "vo_adv_1356002_059",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "反而會使志那都感到痛苦……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n要是事後才知道這一點，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "他們應該會感到更難受吧。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "接受大家仰慕志那都的心意，",
    "voice": "vo_adv_1356002_060",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n然後，志那都也要告訴大家妳的想法。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這樣肯定才是最好的。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……",
    "voice": "vo_adv_1356002_061",
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "我明白了。",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "我這次一定要下定決心。",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n我必須要──",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "坦誠說出來。",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "所以……",
    "voice": "vo_adv_1356002_062",
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "你們兩位",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "願意跟我一起去嗎？",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "只是在一旁看著",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "也無妨……",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……",
    "voice": "vo_adv_1356002_063",
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "謝謝你們……",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "即使我失敗了，",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "請你們也要幫我收屍……",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這是一場那麼嚴峻的戰鬥嗎……？",
    "voice": "vo_adv_1356002_064",
    "unit_id": 100311
  },
  {
    "type": "background",
    "bg_id": "501370"
  },
  {
    "type": "dialogue",
    "name": "徒弟２",
    "words": "志那都大人？",
    "voice": "vo_adv_1356002_065",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "徒弟２",
    "words": "\\n您說要重新談談，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "徒弟２",
    "words": "是什麼事呢？",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "建造我的雕像，",
    "voice": "vo_adv_1356002_066",
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "這件事……",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "你們願意重新考慮嗎？",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "我，",
    "voice": "vo_adv_1356002_067",
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "那個……",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "雖然現在是",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "站在引導大家的立場……",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "但是，",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "其實我的個性不喜歡在公開場合拋頭露面……",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "可以的話，",
    "voice": "vo_adv_1356002_068",
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "我想避免受到關注。",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "何況是，",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "巨大雕像之類的……",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "徒弟２",
    "words": "志那都大人……",
    "voice": "vo_adv_1356002_069",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "徒弟２",
    "words": "對、",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "徒弟２",
    "words": "對不起！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "徒弟２",
    "words": "\\n我完全沒察覺到",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "徒弟２",
    "words": "您有這層考量……！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "徒弟１",
    "words": "想讓更多人知道",
    "voice": "vo_adv_1356002_070",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "徒弟１",
    "words": "志那都大人的偉業。",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "徒弟１",
    "words": "\\n雖然我們是這麼想的……",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "徒弟１",
    "words": "但這也沒辦法。",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "徒弟１",
    "words": "我們會中止計畫……！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "謝謝你們，",
    "voice": "vo_adv_1356002_071",
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "感謝你們",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "願意理解，",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "……但是，",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "這並非我的偉業。",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "這是大家同心協力所獲得的未來。",
    "voice": "vo_adv_1356002_072",
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "功臣並非只有一人，",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "每一個人",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "都是英雄。",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n大家應該獲得同等的讚揚──",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "希望你們不要忘記",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "這件事。",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "嗯，",
    "voice": "vo_adv_1356002_073",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "沒錯。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "因為這是大家一起獲得的未來。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……那麼，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "要對志那都表達感謝之意，",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n是不是最好用其他方式傳達呢？",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "如果是能傾訴彼此想法的現在，",
    "voice": "vo_adv_1356002_074",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n你們應該也能找到",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "應當為她做的事情。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "徒弟１",
    "words": "我明白了！",
    "voice": "vo_adv_1356002_075",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "徒弟１",
    "words": "\\n我們會思考看看",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "徒弟１",
    "words": "自己所能做的事情！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "background",
    "bg_id": "502630"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "之後……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在東國的大街上，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n響徹了志那都徒弟們的響亮聲音。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "徒弟２",
    "words": "志那都道場，",
    "voice": "vo_adv_1356002_076",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "徒弟２",
    "words": "招募門生中！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "徒弟２",
    "words": "\\n能受到名震天下的高強劍士──",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "徒弟２",
    "words": "志那都大人的指導喔～！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "早安，志那都。",
    "voice": "vo_adv_1356002_077",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "他們",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "正在招募門生？",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "嗯……",
    "voice": "vo_adv_1356002_078",
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "他們似乎想要增加道場的門生，",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n讓更多人知道",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "我的劍技。",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n他們非常熱情地致力於招募。",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "雖然名字廣為人知，",
    "voice": "vo_adv_1356002_079",
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "可能會有點不便……",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "即使如此，",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "我也想要好好接受",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "他們仰慕我的這份敬意。",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "\\n這是我",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "真正的想法。",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "嗯，",
    "voice": "vo_adv_1356002_080",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我認為這樣是最好的。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "因為大家都是心地善良的人……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "志那都以充滿慈愛的眼神，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n看著致力於招募活動的徒弟們……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "徒弟１",
    "words": "現在的話，竟然！",
    "voice": "vo_adv_1356002_081",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "徒弟１",
    "words": "能得到師傅志那都大人的木芥子娃娃！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "徒弟１",
    "words": "\\n有著闔家平安、",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "徒弟１",
    "words": "生意興隆及",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "徒弟１",
    "words": "祈求良緣等等保佑，",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "徒弟１",
    "words": "\\n能帶來滿滿的吉利喔！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……木芥子娃娃就可以嗎？",
    "voice": "vo_adv_1356002_082",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "唉……",
    "voice": "vo_adv_1356002_083",
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "跟巨大雕像",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "相比，",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "志那都",
    "words": "勉強能接受……",
    "voice": null,
    "unit_id": 135612
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "一臉開心的徒弟們，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "以及感到有點困擾的志那都。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n但是她的表情柔和，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n傳達出她正在歌頌自己所獲得的未來。",
    "voice": null,
    "unit_id": null
  }
]
