    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "徒弟１",
    "words": "目前進行得非常順利！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "徒弟１",
    "words": "\\n我們找到技藝高超的工匠，",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "徒弟１",
    "words": "現在正在敲定細部的設計！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "雕像的計畫，",
