    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "一起冒險也已經是過往的事了……",
    "voice": "vo_adv_1288003_034",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n我們的生活狀態很簡樸。",
