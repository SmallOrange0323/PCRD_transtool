  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "與獸人族的和平活動……",
    "voice": "vo_adv_6104101_000",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n這是純相信我而託付給我的任務！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我絕對會把它完成的！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "唔……",
    "voice": "vo_adv_6104101_001",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "那正是不安的來源。",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "竟然跟距離和平最遙遠的人湊到了一起……",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "老實說我非常不安，",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "但也只能好好努力了！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "沒錯！",
    "voice": "vo_adv_6104101_002",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "不只是純而已，",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n小智姐",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "還有其他團員們也都相信著我。",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n我可不能逃跑！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "一定要達成任務！",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "雖然每個種族都的確有各自的特色，",
    "voice": "vo_adv_6104101_003",
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "但大家都是好人喔。",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "像附近的餐廳還有蔬果店的人，",
    "voice": null,
    "unit_id": 100512
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "都常常會給我優惠！",
    "voice": null,
    "unit_id": 100512
  }
]
