[
  {
    "type": "dialogue",
    "name": "大家",
    "words": "「黎薩！」\\n「黎薩！」\\n「黎薩姐接！」",
    "voice": "vo_adv_9006703_000",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "哎呀呀……",
    "voice": "vo_adv_9006703_001",
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "還真是",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "大陣仗呢。",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n難道是想仗著人多勢眾，好好欺負我一番嗎？",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "沒錯。",
    "voice": "vo_adv_9006703_002",
    "unit_id": 135911
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n總該算算",
    "voice": null,
    "unit_id": 135911
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "這筆帳了吧。",
    "voice": null,
    "unit_id": 135911
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "真抱歉。",
    "voice": "vo_adv_9006703_003",
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n我可不會讓你們那樣做。",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "真是丟人啊。",
    "voice": "vo_adv_9006703_004",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "幻境龍后的腳底板，",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "對妳而言就那麼甜美誘人嗎？",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "偶的腳腳，",
    "voice": "vo_adv_9006703_005",
    "unit_id": 136911
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "肯定更好吃哦……！",
    "voice": null,
    "unit_id": 136911
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "我才不需要那種東西。",
    "voice": "vo_adv_9006703_006",
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "……雖然我不討厭章魚燒就是了。",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "那、",
    "voice": "vo_adv_9006703_007",
    "unit_id": 135811
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "那麼……",
    "voice": null,
    "unit_id": 135811
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "小庫呢？",
    "voice": null,
    "unit_id": 135811
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "\\n牠看起來很寂寞，",
    "voice": null,
    "unit_id": 135811
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "一直在等著黎薩妳喔……？",
    "voice": null,
    "unit_id": 135811
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "……",
    "voice": "vo_adv_9006703_008",
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "我並沒有",
    "voice": "vo_adv_9006703_009",
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "任何留戀。",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n畢竟那孩子，",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "說不定會成為我的弱點。",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "少在那邊廢話。",
    "voice": "vo_adv_9006703_010",
    "unit_id": 135911
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135911
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "妳那扭曲的本性，",
    "voice": null,
    "unit_id": 135911
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "我會連同妳的脖子一起折斷，通通擺平。",
    "voice": null,
    "unit_id": 135911
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "唔……",
    "voice": "vo_adv_9006703_011",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "公主？",
    "voice": "vo_adv_9006703_012",
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "剛才那番豪言壯語，",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "妳沒忘記吧。",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "……當然。",
    "voice": "vo_adv_9006703_013",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n身為公主──",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n我一定會制裁妳……！",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "皇家裝備──",
    "voice": "vo_adv_9006703_014",
    "unit_id": 133114
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "「怠惰」！",
    "voice": null,
    "unit_id": 133114
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "皇家裝備──",
    "voice": "vo_adv_9006703_015",
    "unit_id": 140413
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "「貪婪」！",
    "voice": null,
    "unit_id": 140413
  }
]
