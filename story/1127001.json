[
  {
    "type": "background",
    "bg_id": "500156"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在恢復了和平的牧場中，公會成員各自做著自己的工作，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n鈴則是滿足地享受著懶散的生活。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "呼～",
    "voice": "vo_adv_1127001_000",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "真是和平呢。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "邊享受和平邊吃著的橡子，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "特別好吃呢～",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "雖然前陣子",
    "voice": "vo_adv_1127001_001",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "多虧了媽媽給我的鎧甲，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "讓我碰巧大顯身手了一番，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "但我果然還是一點都不想戰鬥啊。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "不需要穿上鎧甲，正是和平的證明，",
    "voice": "vo_adv_1127001_002",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "今後你就成為房間裡的裝飾品",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "來渡過你的後半生吧。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "哎喲！",
    "voice": "vo_adv_1127001_003",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "嚇我一大跳……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我說你啊，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "就算對象是我，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "你也至少敲個門嘛。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我可是松鼠耶？",
    "voice": "vo_adv_1127001_004",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "是小動物耶？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我很纖細的，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "要小心謹慎地對待我啊。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "不，你聽我說話啦。",
    "voice": "vo_adv_1127001_005",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "到底是有多我行我素啊，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "你這個人。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "所以，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "那封信是從哪寄來的……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "呃，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "這不是【哞哞自衛隊】寄來的嗎。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "唔哇～",
    "voice": "vo_adv_1127001_006",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "好不想打開來看……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "信上絕對沒有寫什麼好事啦。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我看看……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "啊？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "工作委託！？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "為什麼是找我！",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "唔啊～",
    "voice": "vo_adv_1127001_007",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "別開玩笑了。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "那次只有真陽她們很努力，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n我完全沒做什麼大事啊。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "啊～",
    "voice": "vo_adv_1127001_008",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "討厭啦討厭啦。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "好不容易恢復了和平的日常生活，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "就不要再煩我了啦～",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "嗯，",
    "voice": "vo_adv_1127001_009",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "如果你真的這麼覺得，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "那你真的是有眼無珠耶。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n塞個橡子進去吧。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "這、",
    "voice": "vo_adv_1127001_010",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "這我是知道啦……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "可是可是，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "嗚嗚……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我不想工作啦～！",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "嗚嗚，",
    "voice": "vo_adv_1127001_011",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "去了也是地獄，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "不去也是地獄，根本無處可逃嘛。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "太過分了，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我是有做什麼壞事嗎！",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "……話說你",
    "voice": "vo_adv_1127001_012",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "為什麼從剛才開始就一直盯著我的鎧甲看啊？",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "不、",
    "voice": "vo_adv_1127001_013",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "不是啦，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "這個現在就只是個室內裝飾品……",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "啊～",
    "voice": "vo_adv_1127001_014",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "真是的，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "連說明都好麻煩！",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n要是偷懶的話又會被要求去訓練，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "還是趕快去把事情處理掉好了。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "對了，",
    "voice": "vo_adv_1127001_015",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "機會難得，就穿著鎧甲去吧。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n這樣就算任務失敗了，",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "也可能會被評價說我有心想要做事呢。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "希望這次",
    "voice": "vo_adv_1127001_016",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "真的是我最後一次穿這套盔甲了。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "background",
    "bg_id": "500170"
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我看看，",
    "voice": "vo_adv_1127001_017",
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "工作內容是要救出遇難者對吧。",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "幸好不是要打倒魔物之類的～",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "姑且還算是有派給我比較擅長的任務，",
    "voice": "vo_adv_1127001_018",
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "但她們搞錯貼心的方式了吧。",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "算了，",
    "voice": "vo_adv_1127001_019",
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "既然都有困擾的人在，",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "就趕快出發吧～",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "{0}，你要好好跟上喔。",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "呼，",
    "voice": "vo_adv_1127001_020",
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "又黑，路又難走，",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "真是個麻煩的森林。",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "雖然",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "對我這個松鼠獸人而言不算什麼。",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "來來，",
    "voice": "vo_adv_1127001_021",
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "小心不要走丟或跌倒了喔。",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "可別造成救難者遇難這種麻煩的情況了。",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "這點程度",
    "voice": "vo_adv_1127001_022",
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "每個獸人都辦得到啦。",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "比起稱讚，",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我更想要紅豆麵包呢。",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "……嗯？",
    "voice": "vo_adv_1127001_023",
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "有一股氣息呢。",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n不是動物也不是魔物的氣息……",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "在那邊！",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "啊，",
    "voice": "vo_adv_1127001_024",
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "找到了找到了。",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "喂～",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "沒事嗎～？",
    "voice": null,
    "unit_id": 112711
  },
