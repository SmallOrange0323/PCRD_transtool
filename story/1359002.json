[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "追循抓走幽靈並從鬼族寶物庫裡\\n偷走「返魂靈玉」的犯人足跡，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}與剎鬼來到了蘭德索爾。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "這座城市還真大。",
    "voice": "vo_adv_1359002_000",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n雖然建築結構",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "跟吉歐‧尼布爾黑爾",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "有點類似……",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "但這裡的街道看起來好耀眼。",
    "voice": "vo_adv_1359002_001",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "沒有龜裂的牆壁、",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "也沒有掉落的瓦片。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n看來房子真的要有人居住",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "才不會腐朽呢。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "……是嗎。",
    "voice": "vo_adv_1359002_002",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n貪吃公主她",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "也挺能幹的嘛。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "雖然我很想四處逛逛……",
    "voice": "vo_adv_1359002_003",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "但是追緝比觀光要緊。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n沒想到",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "小偷居然會逃到異世界來。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "要是不快點抓到人，",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "可就沒臉見我家公主跟貪吃公主了。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "如果事情",
    "voice": "vo_adv_1359002_004",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "演變成蘭德索爾與吉歐‧尼布爾黑爾間的問題，",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "就不是我一人的首級能了事的。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "是啊。",
    "voice": "vo_adv_1359002_005",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n多虧騎士公的人脈很廣，",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n行動起來方便不少，真是幫大忙了。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "問題在於",
    "voice": "vo_adv_1359002_006",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "犯人到底跑去哪了。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "雖然循著足跡追到了蘭德索爾……",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "但這裡人多成這樣，",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "要找人可不容易。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "要再來打聽看看幽靈的傳聞嗎？",
    "voice": "vo_adv_1359002_007",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n光是在路上聽到的，",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "就有關於啜泣女子還有花的事情，",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "看來被抓的幽靈也沒有乖乖束手就擒。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "……又撲空了嗎。",
    "voice": "vo_adv_1359002_008",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "白天可能不會有進展呢。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "接著要往哪──",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "……嗯，",
    "voice": "vo_adv_1359002_009",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "騎士公？",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n怎麼了嗎。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "喂喂。",
    "voice": "vo_adv_1359002_010",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n都這種時候了還要幫人啊。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "哎呀，",
    "voice": "vo_adv_1359002_011",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "謝謝你幫我撐著……",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "背著大包行李爬坡果然很吃力呢。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "人終究還是敵不過年紀啊……",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "給我吧。",
    "voice": "vo_adv_1359002_012",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n我幫妳搬。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n嘿、",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "咻……",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "……這是什麼？",
    "voice": "vo_adv_1359002_013",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n武器跟防具……",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "還有捕獸夾？",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n喂，老婆婆。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "妳是準備去火拼嗎？",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "沒錯。",
    "voice": "vo_adv_1359002_014",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "聽說最近",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "出現了盜墓者。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "可不能讓人打擾到死去的老爺子安眠。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n所以我打算親自出手教訓。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "雖然精神可敬，",
    "voice": "vo_adv_1359002_015",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "但上了年紀就要服老。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "比起死去的丈夫，",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "先擔心自己的腰吧。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "……是啊，",
    "voice": "vo_adv_1359002_016",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "騎士公。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n想使用「返魂靈玉」的話",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "會需要遺骸。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n搞不好",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "那就是犯人也說不定。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "這位老婆婆。",
    "voice": "vo_adv_1359002_017",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "擦肩而過亦是累世之緣。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n盜墓者的事情，",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "能不能交給我們來處理呢。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "說不定，",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "那個盜墓者",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "就是我們正在追緝的傢伙。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "是這樣嗎？",
    "voice": "vo_adv_1359002_018",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "既然",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "妳這麼說，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "那就拜託兩位了。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "我這身老骨頭就算去戰鬥，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "可能會徒增一座墳墓呢。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "交給我們。",
    "voice": "vo_adv_1359002_019",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n儘管放心吧，",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "老婆婆。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "background",
    "bg_id": "500532"
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "……這邊世界的墓地",
    "voice": "vo_adv_1359002_020",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "還真是和平啊。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n連半隻殭屍都沒有。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "不用在意。",
    "voice": "vo_adv_1359002_021",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n我只是有點意外而已。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "反倒是騎士公，",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "你才需要放鬆一點──",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "……不，",
    "voice": "vo_adv_1359002_022",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "等等。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "做好準備吧。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n看來那傢伙出現了。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "盜墓者",
    "words": "終於……",
    "voice": "vo_adv_1359002_023",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "盜墓者",
    "words": "終於啊……",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "盜墓者",
