  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "那就跟我面對面，",
    "voice": null,
    "unit_id": 110511
