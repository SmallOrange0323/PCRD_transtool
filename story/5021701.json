    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "讓我好好看一下呀～",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "嗯？",
    "voice": "vo_adv_5021701_007",
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "　太近了？",
