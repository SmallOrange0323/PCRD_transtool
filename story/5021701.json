    "words": "\\n",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "空手道就是以始於禮，",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "而止於禮為基本原則呢～！",
    "voice": null,
    "unit_id": 110511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "{0}也要做嗎～？",
    "voice": "vo_adv_5021701_004",
