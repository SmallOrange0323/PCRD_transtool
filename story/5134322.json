    "words": "嗯～",
    "voice": "vo_adv_5134322_000",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "唔嗯唔嗯……",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "這次",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "有沒有好好地醒過來呢……？",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我",
    "voice": "vo_adv_5134322_001",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "覺得世界真的是",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "非常地",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "閃亮呢。",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "就像現在從眼前飛過的",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "眾多隕石一樣。",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "不，",
    "voice": "vo_adv_5134322_002",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "看來似乎是沒有呢。",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "那個",
    "voice": "vo_adv_5134322_003",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "是石質隕石嗎？",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "如果是的話……",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "還真有種",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "命中注定的感覺呢。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "話說那顆隕石",
    "voice": "vo_adv_5134322_004",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "正在朝著這邊飛過來！？",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "要是不去迎擊，後果會很嚴重啊～！？",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "迎擊",
    "voice": "vo_adv_5134322_005",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "嗎……",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "為什麼，我們沒辦法停止鬥爭呢？",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "還要再迎接多少次新年，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "才能結束這重複不斷的輪迴？",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "雖然是很殘忍的抉擇，",
    "voice": "vo_adv_5134322_006",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "但必須要有人來下決定。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "而這，",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "就是所謂的跨年……",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n妳說對吧，",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "初音？",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "唔嗯唔嗯……",
    "voice": "vo_adv_5134322_007",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "總覺得好像不太對……",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "啊！？",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n這、",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "這次應該",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "有好好地醒來了吧！？",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我已經",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "不想再作惡夢了……",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "呼嚕……",
    "voice": null,
    "unit_id": 128411
  }
]
