[
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "嗯，",
    "voice": "vo_adv_5215411_000",
    "unit_id": 139011
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "這樣一來，",
    "voice": null,
    "unit_id": 139011
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "外出去幫媽媽跑腿應該也沒問題。",
    "voice": null,
    "unit_id": 139011
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n無論是誰",
    "voice": null,
    "unit_id": 139011
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "看到我們，",
    "voice": null,
    "unit_id": 139011
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "都不會在背後指指點點呢。",
    "voice": null,
    "unit_id": 139011
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n……能避開「變態可疑分子毀滅結局」真是太好了……",
    "voice": null,
    "unit_id": 139011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "鎖鏈的共同生活，",
    "voice": "vo_adv_5215411_001",
    "unit_id": 138911
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "真是辛苦呢。",
    "voice": null,
    "unit_id": 138911
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 138911
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "但是能跟鏡華大小姐組成搭檔，",
    "voice": null,
    "unit_id": 138911
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "我很高興喔。",
    "voice": null,
    "unit_id": 138911
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "畢竟兩位的",
    "voice": "vo_adv_5215411_002",
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "默契",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "非常好嘛。",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n偶能陪同兩位，",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "也覺得很高興。",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "呵呵……",
    "voice": "vo_adv_5215411_003",
    "unit_id": 139011
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "到了現在，",
    "voice": null,
    "unit_id": 139011
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "那或許確實",
    "voice": null,
    "unit_id": 139011
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "是個美好的回憶？",
    "voice": null,
    "unit_id": 139011
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n況且最後，",
    "voice": null,
    "unit_id": 139011
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "是大家合力才跨過難關的。",
    "voice": null,
    "unit_id": 139011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "剛剛那句話好令人感動，",
    "voice": "vo_adv_5215411_004",
    "unit_id": 138911
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "我已經沒有遺憾了。",
    "voice": null,
    "unit_id": 138911
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 138911
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "各位，",
    "voice": null,
    "unit_id": 138911
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "一直以來謝謝你們……",
    "voice": null,
    "unit_id": 138911
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "咦，",
    "voice": "vo_adv_5215411_005",
    "unit_id": 139011
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "格蕾斯小姐！？",
    "voice": null,
    "unit_id": 139011
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n妳為什麼",
    "voice": null,
    "unit_id": 139011
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "在漸漸消失……！？",
    "voice": null,
    "unit_id": 139011
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "原、",
    "voice": "vo_adv_5215411_006",
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "原來如此……",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "格蕾斯姐接素幽靈啊。",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n或許素因為對至今的一切感到滿足，",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "所以要升天了……",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "怎、",
    "voice": "vo_adv_5215411_007",
    "unit_id": 139011
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "怎麼會！？",
    "voice": null,
    "unit_id": 139011
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 139011
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "格蕾斯小姐，",
    "voice": null,
    "unit_id": 139011
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "不要走……！",
    "voice": null,
    "unit_id": 139011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "──其實是騙人的就是。",
    "voice": "vo_adv_5215411_008",
    "unit_id": 138911
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 138911
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "有嚇一跳嗎？",
    "voice": null,
    "unit_id": 138911
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "──我就知道是這樣。",
    "voice": "vo_adv_5215411_009",
    "unit_id": 139011
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 139011
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "畢竟我一直待在旁邊，",
    "voice": null,
    "unit_id": 139011
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "早就看穿妳的玩笑了。",
    "voice": null,
    "unit_id": 139011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "哎呀，",
    "voice": "vo_adv_5215411_010",
    "unit_id": 138911
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "我被將了一軍呢。",
    "voice": null,
    "unit_id": 138911
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 138911
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "真不愧是鏡華大小姐。",
    "voice": null,
    "unit_id": 138911
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "為什麼格蕾斯小姐一臉驕傲的樣子呀。",
    "voice": "vo_adv_5215411_011",
    "unit_id": 139011
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n受不了……",
    "voice": null,
    "unit_id": 139011
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "呵呵。",
    "voice": null,
    "unit_id": 139011
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "兩位",
    "voice": "vo_adv_5215411_012",
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "已經素對好搭檔了呢。",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "……啊，",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "今年春天",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "不只素可疑分子湧出的季節，",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n一定",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "也素相遇的季節吧。",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "璐璐伊，",
    "voice": "vo_adv_5215411_013",
    "unit_id": 138911
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "說得真好呢。",
    "voice": null,
    "unit_id": 138911
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 138911
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "鏡華大小姐，",
    "voice": null,
    "unit_id": 138911
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "拿獎賞的坐墊來。",
    "voice": null,
    "unit_id": 138911
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "才不會拿來呢。",
    "voice": "vo_adv_5215411_014",
    "unit_id": 139011
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "最後一天也是這種狀態嗎？",
    "voice": null,
    "unit_id": 139011
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n別再胡鬧了，",
    "voice": null,
    "unit_id": 139011
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "要去跑腿囉。",
    "voice": null,
    "unit_id": 139011
  }
]
