[
  {
    "type": "background",
    "bg_id": "501450"
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "虐待狂先生。",
    "voice": "vo_adv_6078204_000",
    "unit_id": 119112
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "空花覺醒了愛與希望之力，",
    "voice": null,
    "unit_id": 119112
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "當上魔法少女了。",
    "voice": null,
    "unit_id": 119112
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "\\n空花要把這股力量用在正確的方面，",
    "voice": null,
    "unit_id": 119112
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "讓街上的人們都露出笑容。",
    "voice": null,
    "unit_id": 119112
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 119112
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "沒錯──",
    "voice": null,
    "unit_id": 119112
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "要把所有人都變成被虐狂，",
    "voice": null,
    "unit_id": 119112
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "帶給全世界幸福！",
    "voice": null,
    "unit_id": 119112
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "什麼？",
    "voice": "vo_adv_6078204_001",
    "unit_id": 119112
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "空花",
    "voice": null,
    "unit_id": 119112
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "有搞錯什麼嗎……？",
    "voice": null,
    "unit_id": 119112
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "\\n魔法少女不是這樣的存在？",
    "voice": null,
    "unit_id": 119112
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "可是空花，",
    "voice": null,
    "unit_id": 119112
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "\\n基本上只擁有把人變成被虐狂的力量……",
    "voice": null,
    "unit_id": 119112
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "該怎麼做才好呢……？",
    "voice": null,
    "unit_id": 119112
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "謝謝你，",
    "voice": "vo_adv_6078204_002",
    "unit_id": 119112
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "虐待狂先生！",
    "voice": null,
    "unit_id": 119112
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "\\n一起不斷奮戰下去吧……！",
    "voice": null,
    "unit_id": 119112
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 119112
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "直到讓整個世界",
    "voice": null,
    "unit_id": 119112
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "都充滿被虐狂的那一天……！",
    "voice": null,
    "unit_id": 119112
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "咦……！",
    "voice": "vo_adv_6078204_003",
    "unit_id": 119112
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "只要有、",
    "voice": null,
    "unit_id": 119112
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "空花……？",
    "voice": null,
    "unit_id": 119112
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 119112
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "怎麼會，",
    "voice": null,
    "unit_id": 119112
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "居然說了「空花是專屬於我的被虐狂」",
    "voice": null,
    "unit_id": 119112
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "這種話……",
    "voice": null,
    "unit_id": 119112
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 119112
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "空花的",
    "voice": null,
    "unit_id": 119112
  },
  {
    "type": "dialogue",
    "name": "黑暗空花",
    "words": "愛與希望之力會太過高漲啦……",
    "voice": null,
    "unit_id": 119112
  }
]
