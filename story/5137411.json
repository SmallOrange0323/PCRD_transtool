  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "這樣就結束了呢。",
    "voice": "vo_adv_5137411_000",
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "一切都結束了……",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "志那都、埃拉……",
    "voice": "vo_adv_5137411_001",
    "unit_id": 128812
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "還有厄莉絲都平安無事。",
    "voice": null,
    "unit_id": 128812
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 128812
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "「紅霧精靈」也消失無蹤。",
    "voice": null,
    "unit_id": 128812
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 128812
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我想事情算是告一段落了。",
    "voice": null,
    "unit_id": 128812
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……嗯。",
    "voice": "vo_adv_5137411_002",
    "unit_id": 128911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n大家都平安無事，",
    "voice": null,
    "unit_id": 128911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "真是太好了。",
    "voice": null,
    "unit_id": 128911
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "發生了很多事呢。",
    "voice": "vo_adv_5137411_003",
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n不管是艱辛的事、",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "讓人驚訝的事、",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "難過的事……",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "還有，",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "也發生了很～多",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "有趣的事！",
    "voice": null,
    "unit_id": 128711
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "不管是哪件事都讓人印象深刻呢。",
    "voice": "vo_adv_5137411_004",
    "unit_id": 128812
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n每一件事，",
    "voice": null,
    "unit_id": 128812
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我都絕對無法忘記。",
    "voice": null,
    "unit_id": 128812
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "好好珍惜吧。",
    "voice": "vo_adv_5137411_005",
    "unit_id": 128911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n跟大家的回憶……",
    "voice": null,
    "unit_id": 128911
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "還有這份情誼！",
    "voice": null,
    "unit_id": 128911
  }
]
