    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "謝謝。",
    "voice": "vo_adv_1136004_043",
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n天氣很熱，要小心別中暑囉！",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯？",
    "voice": "vo_adv_1136004_044",
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "少年，",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你怎麼了嗎？",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯，",
    "voice": "vo_adv_1136004_045",
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "還好啦……",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不過，",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "就像我剛才說過的，",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不光是表演，",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我希望今天",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n能成為他",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "美好的回憶。",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "是嗎？",
    "voice": "vo_adv_1136004_046",
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n有人",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "像那樣相信自己，",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n確實是英雄最大的幸福。",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "可是，",
    "voice": "vo_adv_1136004_047",
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "為什麼會被注意到呢……",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n這面具也是一般店面有在賣的東西……",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "少年知道原因嗎？",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "那、",
    "voice": "vo_adv_1136004_048",
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "那算什麼回答嘛……",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n不過，",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "呵呵……",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "被你稱讚的感覺",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "還不差。",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n謝謝你。",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "好，",
    "voice": "vo_adv_1136004_049",
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "把剩下的垃圾撿一撿後，",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "就在海邊玩吧。",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n你當然",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "會陪我對吧？",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "background",
    "bg_id": "500890"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好，辛苦了。",
    "voice": "vo_adv_1136004_050",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "每次都會見到我，所以你應該已經知道了，",
    "voice": "vo_adv_1136004_051",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n你剛才看到的光景就像是在做夢一樣。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "話又說回來，真是叫人吃驚呢。",
    "voice": "vo_adv_1136004_052",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n純居然連換上泳裝都要戴面具。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "但比起面具，只要看到那個英姿煥發的模樣，",
    "voice": "vo_adv_1136004_053",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n熟悉的人就會馬上認出她是英雄。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "本人不是刻意做的，所以似乎沒有自覺。",
    "voice": "vo_adv_1136004_054",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "但她肯定天生就是個英雄。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不過，那部分的祕密就由你小心替她掩護了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "正因為是平時負責保護大家的英雄，",
    "voice": "vo_adv_1136004_055",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n才會需要有個人來保護她。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "而且，",
    "voice": "vo_adv_1136004_056",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "能辦到那件事的人就只有你而已哦。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500950"
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯……",
    "voice": "vo_adv_1136004_057",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "咦……？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我不小心睡著了嗎……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "少年也睡著了嗎？",
    "voice": "vo_adv_1136004_058",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n但畢竟",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "時間也還很早，這也沒辦法呢。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "然後，",
    "voice": "vo_adv_1136004_059",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我想說……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "關於昨天的泳裝跟",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我的長相……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "是啊，",
    "voice": "vo_adv_1136004_060",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "希望你能為我保密。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n只是，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "難得有這個機會……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "可以請你",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "再稍微陪著我的祕密嗎？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "background",
    "bg_id": "500164"
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯，",
    "voice": "vo_adv_1136004_061",
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "果然這個時間點幾乎沒有什麼人呢。",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "雖然對小咲戀他們不好意思，",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "就讓我們兩人獨占沙灘吧。",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "在其他人蜂擁而至之前，",
    "voice": "vo_adv_1136004_062",
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "只有段短暫的時間……",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "所以在那之前，我想做一些有假期感的事。",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "呼……",
    "voice": "vo_adv_1136004_063",
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "直接用肌膚感受海風的感覺，",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我還不習慣啊。",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……喂、",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "喂。",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "別那麼一直盯著看……",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "怎麼？",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……你是在意這套泳裝嗎？",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我原本確實是",
    "voice": "vo_adv_1136004_064",
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "打算一直穿著鎧甲……",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不過，",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "畢竟是要來海邊。",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "所以我",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "姑且是有帶泳裝來啦。",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……想像能以這種方式",
    "voice": "vo_adv_1136004_065",
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "度假的念頭，",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我倒也不是不曾有過。",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不過……",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我只想在你面前做……",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "謝、",
    "voice": "vo_adv_1136004_066",
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "謝謝你……",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我總覺得你比平時",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "更加可靠呢。",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "會對我說這種話的人，",
    "voice": "vo_adv_1136004_067",
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "就只有你而已。",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n現在就",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "讓我坦率地接受你的好意吧。",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "感覺就像是",
    "voice": "vo_adv_1136004_068",
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "自己成了公主一樣……",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "呃，",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不……",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "沒什麼。",
    "voice": null,
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你、",
    "voice": "vo_adv_1136004_069",
    "unit_id": 113611
  },
  {
    "type": "dialogue",
    "name": "純",
