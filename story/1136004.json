[
  {
    "type": "background",
    "bg_id": "500950"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "早上，在海邊旅店醒來的{0}，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n有個罕見的訪客。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗨、",
    "voice": "vo_adv_1136004_000",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗨，少年……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "身體狀況如何？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "啊，",
    "voice": "vo_adv_1136004_001",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你不用勉強自己起來。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n畢竟昨天才發生過那種意外。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你看起來很有精神，",
    "voice": "vo_adv_1136004_002",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "真是太好了。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我就像你看到的這樣，非常健康。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n畢竟我平時都有在鍛鍊。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "重要的是，",
    "voice": "vo_adv_1136004_003",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "那個……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "昨天的事……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "關、",
    "voice": "vo_adv_1136004_004",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "關於那件事……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n那個……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這、",
    "voice": "vo_adv_1136004_005",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這道光是……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗚！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "background",
    "bg_id": "510250"
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你等很久了嗎，",
    "voice": "vo_adv_1136004_006",
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "少年。",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我也剛把舞台整理乾淨。",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "話說回來，",
    "voice": "vo_adv_1136004_007",
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你可真是幫了大忙呢。",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n把舞台",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "換到與平常不同的沙灘上後，",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n超級英雄秀的人手也會不足。",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "有你加入後，",
    "voice": "vo_adv_1136004_008",
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "感覺氣氛比平時還要更加熱絡呢。",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n而且，",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你還留下來幫忙撿沙灘上的垃圾……",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n這樣真的好嗎？",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "謝謝你，",
    "voice": "vo_adv_1136004_009",
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "幫了我一個大忙呢。",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n為了特地跑來海邊欣賞虎虎英雄秀的孩子們，",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我想盡量讓他們看見美麗的景色。",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不光是舞台上的表演。",
    "voice": "vo_adv_1136004_010",
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我希望能讓",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "今天也變成他們的美好回憶。",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我是這麼想的啦……",
    "voice": "vo_adv_1136004_011",
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "好，",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "再撿一下垃圾",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "就休息吧。",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "少年？",
    "voice": "vo_adv_1136004_012",
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n嗯……",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你是對那個小孩感到在意嗎？",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n他確實是從剛才就一直看著我們……",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "喔，",
    "voice": "vo_adv_1136004_013",
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "他朝這邊走過來了呢。",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "小弟弟你是怎麼啦？",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "虎虎！",
    "voice": "vo_adv_1136004_014",
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯？",
    "voice": "vo_adv_1136004_015",
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "喔，你是說這個面具嗎？",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n對啊。",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我也是",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "虎虎的粉絲喔。",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "是虎虎沒錯，",
    "voice": "vo_adv_1136004_016",
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "但不是那樣！",
    "voice": null,
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "怎麼啦？",
    "voice": "vo_adv_1136004_017",
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你不是在說這個面具的事嗎？",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "大姐姐，",
    "voice": "vo_adv_1136004_018",
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "妳就是真正的虎虎對吧？",
    "voice": null,
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "她就是！",
    "voice": "vo_adv_1136004_019",
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "\\n我一眼就看出來了！",
    "voice": null,
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "就、",
    "voice": "vo_adv_1136004_020",
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "就算你那麼說……",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯，",
    "voice": "vo_adv_1136004_021",
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你、",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你看錯囉？",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我並不是虎虎……",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "我才沒有看錯！",
    "voice": "vo_adv_1136004_022",
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "妳就是虎虎！",
    "voice": null,
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "他應該不是隨便說說，",
    "voice": "vo_adv_1136004_023",
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n而是有他自己的根據吧……",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n只要看著他耿直的眼神就能明白。",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我或許可以編個謊話來蒙混過關。",
    "voice": "vo_adv_1136004_024",
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n但是……",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "妳是虎虎對吧？",
    "voice": "vo_adv_1136004_025",
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "看著這孩子耿直的眼神，",
    "voice": "vo_adv_1136004_026",
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "讓我很想坦然承認。",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n……我想當個能坦白的人。",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n尤其",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "是在他的面前……",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "still",
    "still_id": "113600401"
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你可以靠過來一點嗎？",
    "voice": "vo_adv_1136004_027",
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "咦？",
    "voice": "vo_adv_1136004_028",
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "事情確實",
    "voice": "vo_adv_1136004_029",
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "就是你說的那樣。",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "果然！",
    "voice": "vo_adv_1136004_030",
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "大姐姐就是虎虎！",
    "voice": null,
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不過，",
    "voice": "vo_adv_1136004_031",
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "虎虎的真面目",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "必須保密才行。",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n你能明白嗎？",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "咦～？",
    "voice": "vo_adv_1136004_032",
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "不能跟朋友講嗎？",
    "voice": null,
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "噓……！",
    "voice": "vo_adv_1136004_033",
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "小聲點。",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n搞不好有壞蛋正在偷聽我們說話。",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "對、",
    "voice": "vo_adv_1136004_034",
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "對喔！",
    "voice": null,
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "\\n要是被壞蛋知道就糟糕了！",
    "voice": null,
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "沒錯。",
    "voice": "vo_adv_1136004_035",
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "英雄必須隱藏真面目才行。",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "所以，",
    "voice": "vo_adv_1136004_036",
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "為了實現正義，",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "你可以一起保守祕密嗎？",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "我知道了！",
    "voice": "vo_adv_1136004_037",
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "虎虎！",
    "voice": null,
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "\\n這全都是",
    "voice": null,
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "為了實現正義對吧！",
    "voice": null,
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "沒錯。",
    "voice": "vo_adv_1136004_038",
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這是你跟虎虎之間的約定。",
    "voice": null,
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "嗯！",
    "voice": "vo_adv_1136004_039",
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "那好，",
    "voice": "vo_adv_1136004_040",
    "unit_id": 113631
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我們來打勾勾。",
