  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就這樣，蘭德索爾的人們一個個被",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n聖誕老人禮物袋的力量變成了馴鹿。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}他們為了阻止這件事情，到處奔波。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "馴鹿頭目",
    "words": "噗喔喔喔喔喔喔喔喔喔喔喔喔喔喔――！\\n（就由我這個新上任的聖誕老人，\\n把聖誕節全部毀掉――！）",
    "voice": "vo_adv_5029006_000",
    "unit_id": 12511
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "總算追上牠了！",
    "voice": "vo_adv_5029006_001",
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……嗯，",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身好像來過這裡呢？",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "聖誕演唱會的會場！？",
    "voice": "vo_adv_5029006_002",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "眼光真不錯，竟然挑上這裡……♪",
    "voice": "vo_adv_5029006_003",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n不管戰鬥或歌唱都是舞台上的娛樂之一。",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n盡情地炒熱氣氛吧！",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "喂！克莉絲提娜！",
    "voice": "vo_adv_5029006_004",
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n不要單槍匹馬地闖進去！",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "哈哈☆",
    "voice": "vo_adv_5029006_005",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n這個時候要敬老尊賢喔！",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身的年紀比妳大得多了！",
    "voice": "vo_adv_5029006_006",
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "嘿咻☆",
    "voice": "vo_adv_5029006_007",
    "unit_id": 111511
  },
  {
    "type": "background",
    "bg_id": "500873"
  },
  {
    "type": "dialogue",
    "name": "馴鹿頭目",
    "words": "噗喔！\\n（哼！）",
    "voice": "vo_adv_5029006_008",
    "unit_id": 12511
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "牠用鹿角擋下了！？",
    "voice": "vo_adv_5029006_009",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "馴鹿頭目",
    "words": "噗喔喔喔喔喔！\\n（這些小蟲子！）",
    "voice": "vo_adv_5029006_010",
    "unit_id": 12511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "沒什麼大不了的！",
    "voice": "vo_adv_5029006_011",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這點程度――",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "咦？",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "background",
    "bg_id": "500873"
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "被打飛了！？",
    "voice": "vo_adv_5029006_012",
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身方才就說了吧！",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……只是擦傷了而已！",
    "voice": "vo_adv_5029006_013",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "原本，",
    "voice": "vo_adv_5029006_014",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "是不可能會被擋下，也不會擦傷的……",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "亂數聖域的反應變遲鈍了？　",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "是因為下雪的緣故嗎？",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "那個發達的肌肉，",
    "voice": "vo_adv_5029006_015",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "力氣比看起來還要更強呢。",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "瞬間的遲疑被對方逮著了……♪",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "製作人，",
    "voice": "vo_adv_5029006_016",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "妳沒事吧！？",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n雖然妳在笑，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不過剛剛應該被擊中要害了吧……？",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "啊哈哈☆　",
    "voice": "vo_adv_5029006_017",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這怎麼能不笑呢！",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n這配得上聖誕夜的強敵，",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "就是送給我最好的禮物了！",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不好意思，強搶妳的禮物，",
    "voice": "vo_adv_5029006_018",
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不過下一個輪到妾身了！",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "遇到體型巨大的敵人",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "就要從遠處發動攻擊！",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "background",
    "bg_id": "500873"
  },
  {
    "type": "dialogue",
    "name": "馴鹿頭目",
    "words": "噗喔喔！\\n（沒效！）",
    "voice": "vo_adv_5029006_019",
    "unit_id": 12511
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身的魔法……",
    "voice": "vo_adv_5029006_020",
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "竟然被袋子",
    "voice": "vo_adv_5029006_021",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "吸收了……",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "再怎麼誇張也要有個限度啊～～～～～！？",
    "voice": "vo_adv_5029006_022",
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "馴鹿頭目",
    "words": "噗喔喔喔喔喔喔喔喔！\\n（給我收下這個禮物吧！）",
    "voice": "vo_adv_5029006_023",
    "unit_id": 12511
  },
  {
    "type": "background",
    "bg_id": "500873"
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "牠、",
    "voice": "vo_adv_5029006_024",
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "牠竟然把袋子甩過來了……！",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "若是被那種東西打中的話，",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身不就死定了嗎！",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "抱歉……",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "謝謝你救了妾身。",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "沒想到製作人和伊莉亞的攻擊居然無效……",
    "voice": "vo_adv_5029006_025",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "馴鹿先生竟然這麼強……",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "哼。",
    "voice": "vo_adv_5029006_026",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不過是隻馴鹿罷了。",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "沒錯沒錯。",
    "voice": "vo_adv_5029006_027",
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n牠才不是傳說的吸血鬼――妾身的對手呢。",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "大家同心協力，",
    "voice": "vo_adv_5029006_028",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "一定會有辦法的！",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "馴鹿頭目",
    "words": "――噗喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔喔！",
    "voice": "vo_adv_5029006_029",
    "unit_id": 12511
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "咦？",
    "voice": "vo_adv_5029006_030",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "什、",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "什麼！？　",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "突然間怎麼了！？",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "剛剛的咆哮……",
    "voice": "vo_adv_5029006_031",
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "總覺得",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "有種不好的預感。",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "嗯。",
    "voice": "vo_adv_5029006_032",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "牠還有什麼招數嗎？",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不管牠要使出什麼招――",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "馴鹿",
    "words": "……噗喔。",
    "voice": "vo_adv_5029006_033",
    "unit_id": 4111
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "咦？　",
    "voice": "vo_adv_5029006_034",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這是……",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "被變為馴鹿的居民們！？",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "嗯。",
    "voice": "vo_adv_5029006_035",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "聚集到這個廣場上來了。",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "變得好熱鬧啊……",
    "voice": "vo_adv_5029006_036",
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n雖然幾乎只有馴鹿就是了。",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "喂！",
    "voice": "vo_adv_5029006_037",
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "別把妾身跟馴鹿混為一談！",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妳以為妾身是誰啊！",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "哈哈，",
    "voice": "vo_adv_5029006_038",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這不是很有意思嗎！",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n傳說的吸血鬼應該會很有看頭♪",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "咦？",
    "voice": "vo_adv_5029006_039",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "難道我被期待要做些什麼嗎？",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n那個，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "各位～",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "久等了～！",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "【慈樂之音】的偶像",
    "voice": "vo_adv_5029006_040",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n不要這麼認真和馴鹿互動好嗎……",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不過，",
    "voice": "vo_adv_5029006_041",
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "剛剛的咆哮，",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "難不成是――",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "馴鹿們",
    "words": "噗喔喔喔！",
    "voice": "vo_adv_5029006_042",
    "unit_id": 4111
  },
  {
    "type": "background",
    "bg_id": "500873"
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "果然，",
    "voice": "vo_adv_5029006_043",
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "牠在操縱這些馴鹿！",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不愧是馴鹿中的菁英，",
    "voice": "vo_adv_5029006_044",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "真是了不得的領導力啊！",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "現在可不是誇牠的時候了，製作人！",
    "voice": "vo_adv_5029006_045",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "馴鹿們不斷聚集過來了……！",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n再這樣下去會被牠們包圍的！",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "馴鹿頭目",
    "words": "噗喔喔！\\n（有破綻！）",
    "voice": "vo_adv_5029006_046",
    "unit_id": 12511
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "呀！？",
    "voice": "vo_adv_5029006_047",
    "unit_id": 111611
  },
  {
    "type": "background",
    "bg_id": "500873"
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "{0}……！",
    "voice": "vo_adv_5029006_048",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n謝謝你保護我！",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "馴鹿",
    "words": "噗喔喔喔喔喔！",
    "voice": "vo_adv_5029006_049",
    "unit_id": 4111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "唔，",
    "voice": "vo_adv_5029006_050",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "周圍的馴鹿出乎意料地礙事耶。",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n不過，牠們原本都是人類，",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "也不能斬了牠們……",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不，",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "乾脆把牠們斬了好了？",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "住手！",
    "voice": "vo_adv_5029006_051",
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "牠們可是",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "未來妾身要統治的人民，",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身不允許妳傷害牠們！",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "先不管統不統治，",
    "voice": "vo_adv_5029006_052",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "總之不可以傷害牠們！",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "首先當然不能傷害居民們，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "然後，那幾隻菁英馴鹿",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n牠們應該本性也不壞……！",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "馴鹿頭目",
    "words": "噗喔、",
    "voice": "vo_adv_5029006_053",
    "unit_id": 12511
  },
  {
    "type": "dialogue",
    "name": "馴鹿頭目",
    "words": "噗喔喔喔喔喔喔！\\n（不需要這種為了使喚馴鹿而存在的聖誕節！）",
    "voice": null,
    "unit_id": 12511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "嘖……！　",
    "voice": "vo_adv_5029006_054",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "你們是要我在這種情況下，",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n還要跟所有人握手言和啊……",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "是在講這麼天～真的夢話嗎？",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……沒錯！",
    "voice": "vo_adv_5029006_055",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "因為，",
    "voice": "vo_adv_5029006_056",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "今天是……",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "啊～",
    "voice": "vo_adv_5029006_057",
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "是呢。",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不管怎麼說今天都是……",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……原來如此。",
    "voice": "vo_adv_5029006_058",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n既然妳們這麼說，那就沒辦法了。",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "那麼這些",
    "voice": "vo_adv_5029006_059",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n原本是人類的馴鹿，就由妳來想辦法。",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "那邊那個大塊頭，",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "就由我和伊莉亞‧奧恩斯坦來對付。",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "咦？　",
    "voice": "vo_adv_5029006_060",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "要我",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "想辦法處理這些馴鹿們嗎……！？",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "怎麼這樣，",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "該怎麼辦才好……",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "妳在不知所措什麼。",
    "voice": "vo_adv_5029006_061",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "――想想妳是誰？",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我……？",
    "voice": "vo_adv_5029006_062",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n我是……",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "【慈樂之音】的偶像！",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "既然如此，就像個偶像一樣，",
    "voice": "vo_adv_5029006_063",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n好好地達成製作人的要求吧！",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "管他是聖誕老人還是馴鹿，",
    "voice": "vo_adv_5029006_064",
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n用妳的歌聲迷倒他們吧――",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "望！",
    "voice": null,
    "unit_id": 111511
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……是！",
    "voice": "vo_adv_5029006_065",
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n我知道了！",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "製作人！",
    "voice": null,
    "unit_id": 111611
  },
  {
    "type": "dialogue",
    "name": "馴鹿頭目",
    "words": "噗喔喔喔喔喔喔喔喔喔喔喔！\\n（這種只會讓馴鹿感到痛苦的聖誕節，不要也罷！）",
    "voice": "vo_adv_5029006_066",
    "unit_id": 12511
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "牠們要來了！　",
    "voice": "vo_adv_5029006_067",
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "克莉絲提娜！",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "movie",
    "movie_id": "502900601"
  }
]
