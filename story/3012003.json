[
  {
    "type": "background",
    "bg_id": "500050"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "由莫妮卡率領的\\n【純白之翼 蘭德索爾分部】\\n正面對著至今不曾遇過的危機──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……有件事情我實在無法接受。",
    "voice": "vo_adv_3012003_000",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "挑食是不好的呦。",
    "voice": "vo_adv_3012003_001",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我果然還是該準備一下",
    "voice": "vo_adv_3012003_002",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n餐後的甜點嗎……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "沒錯，果然還是需要甜點……",
    "voice": "vo_adv_3012003_003",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "──",
    "voice": "vo_adv_3012003_004",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "才不是咧！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n我想講的話才不是這個。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "對於我們未來的公會活動",
    "voice": "vo_adv_3012003_005",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我想要提出些問題。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "公會活動不是進行地很順利嗎，\\n",
    "voice": "vo_adv_3012003_006",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "妳有什麼不滿呢？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "……對呀。多虧了公會活動的福，",
    "voice": "vo_adv_3012003_007",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "我們才能夠在這邊享受料理呢。",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "妳們這些人呀，",
    "voice": "vo_adv_3012003_008",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n是不是搞錯了什麼事情。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "冒險者公會本來的目標是打倒強大的魔物、",
    "voice": "vo_adv_3012003_009",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n提升等級，為求能在緊急狀況時守護百姓，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "而不斷磨練自己的功夫。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "要是像我們這樣從早到晚，",
    "voice": "vo_adv_3012003_010",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n都只埋頭在採集方面的委託裡，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n不就沒辦法達成原來的目的了！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "欸～可是呀～",
    "voice": "vo_adv_3012003_011",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n人家我，不想參加激烈的戰鬥。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "要是傷到這美麗的身體可就糟糕了。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "……如、如果是植物系魔物的話",
    "voice": "vo_adv_3012003_012",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n我還蠻想戰鬥看看的……",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "嘻、嘻嘻……",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "空花，",
    "voice": "vo_adv_3012003_013",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "注意一下自己儀態啊。",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "妳的口水流到菜裡頭了。",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "哎呀！",
    "voice": "vo_adv_3012003_014",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "對、對不起……",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "知道就好。",
    "voice": "vo_adv_3012003_015",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "啊，妮諾不可以呦。",
    "voice": "vo_adv_3012003_016",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "那是增加辣度的醬汁……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "科科科，妮諾對於這種程度的辣，",
    "voice": "vo_adv_3012003_017",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n當然是完全沒問題的……",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我吃。",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "好、",
    "voice": "vo_adv_3012003_018",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "好辣呀！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "所以我就跟妳說啦……",
    "voice": "vo_adv_3012003_019",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我、我馬上拿水過來。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……你們這些人，",
    "voice": "vo_adv_3012003_020",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n到底為什麼會想加入公會呀。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "閣下也告誡她們幾句吧。",
    "voice": "vo_adv_3012003_021",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "真是的，閣下實在太過寬容了。",
    "voice": "vo_adv_3012003_022",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "連閣下都這麼說嗎……",
    "voice": "vo_adv_3012003_023",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "咳咳……總之呢，",
    "voice": "vo_adv_3012003_024",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "明天我們要在普拉諾平原實施特別強化訓練！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "background",
    "bg_id": "500140"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "隔天──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "哈……哈……",
    "voice": "vo_adv_3012003_025",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "汗水淋漓的我……",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n怎麼會這樣性感又美麗呢。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "……嗚，發現疲累到無法動彈的空花後，",
    "voice": "vo_adv_3012003_026",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n妳打算盡情玩弄空花是吧！？",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "嘻嘻、嘻嘻……",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "在腰部綁上一條長長的布，然後快跑讓布不要碰到地面！",
    "voice": "vo_adv_3012003_027",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "咻趴趴趴！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……我們難得到這幾乎不會出現魔物",
    "voice": "vo_adv_3012003_028",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n的草原裡好好進行訓練……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……這群傢伙們有心想要認真做嗎？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "喂喂，妳們再開玩笑的話，",
    "voice": "vo_adv_3012003_029",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n我可要追加訓練菜單囉。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……",
    "voice": "vo_adv_3012003_030",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "嗯，怎麼了……？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這不可能的吧……",
    "voice": "vo_adv_3012003_031",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n這個地方可是──",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──呱歐歐歐歐歐",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "哇呀！？",
    "voice": "vo_adv_3012003_032",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "是、是魔物耶！？",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "怎麼一回事！？",
    "voice": "vo_adv_3012003_033",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這種強力的魔物，",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n應該不會出現在這邊才對呀──",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "啊！話說回來……",
    "voice": "vo_adv_3012003_034",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n由於不遠處的森林之主最近消失了，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n所以這附近好像變得會出現強力的魔物了……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "妳說什麼！？",
    "voice": "vo_adv_3012003_035",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……如果真是這樣的話，就是我的判斷錯誤了。",
    "voice": "vo_adv_3012003_036",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "我居然會犯下這種錯……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……不過，在這邊懊惱也無濟於事。",
    "voice": "vo_adv_3012003_037",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "大家注意！我們先撤退吧！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n現在的我們並沒有勝算。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "啊啊，遇到魔物也完全不緊張的我……",
    "voice": "vo_adv_3012003_038",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "怎麼會這麼帥氣又可愛呢！",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "現在不是講這種話的場合！",
    "voice": "vo_adv_3012003_039",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n不快點逃跑的話可是非常危險的。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "沒問題的。",
    "voice": "vo_adv_3012003_040",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n我呀，可以魅惑大部分的魔物。",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "是吧？你不會襲擊我吧？",
    "voice": null,
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──呱歐歐歐歐歐",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "好、好厲害！",
    "voice": "vo_adv_3012003_041",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n牠從雪身邊逃跑了！",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "不過那個方向可不妙呀！",
    "voice": "vo_adv_3012003_042",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "空花，魔物要跑到妳那邊了！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "當空",
    "voice": "vo_adv_3012003_043",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "、空花被魔物襲擊時……",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n虐待狂先生突然出現，",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "對空花說『妳知道該怎麼回禮吧？』──",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──呱歐歐歐歐歐",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "奇、奇怪了……",
    "voice": "vo_adv_3012003_044",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n魔物從空花身邊逃開了？",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……雖然不知道怎麼一回事，",
    "voice": "vo_adv_3012003_045",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n似乎牠判斷不該跟空花扯上關係……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "不過那個方向是！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "大家為什麼一直大聲叫呢？",
    "voice": "vo_adv_3012003_046",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "是在辦祭典嗎？",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "可惡，沒辦法了。",
    "voice": "vo_adv_3012003_047",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n既然這樣就只好由我來……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "閣下，拜託你掩護我了！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "妮諾，魔物出現了！",
    "voice": "vo_adv_3012003_048",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n妳快趁我擋住牠時逃走──！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "咦？魔物？",
    "voice": "vo_adv_3012003_049",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "──啊，莫妮卡小姐",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n妳別過來這邊。",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "魔、魔物消失了！？",
    "voice": "vo_adv_3012003_050",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "發生了什麼事呀！？",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這是……地洞陷阱？",
    "voice": "vo_adv_3012003_051",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……真是太危險了。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n我差點就跟魔物一起掉進去了。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "……啊啊，我本來打算用來捕獵晚餐的陷阱",
    "voice": "vo_adv_3012003_052",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n這下就派不上用場了……",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "這個魔物，可以吃嗎？",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "那、那個……",
    "voice": "vo_adv_3012003_053",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n我想牠應該不太適合食用……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "姆姆姆……",
    "voice": "vo_adv_3012003_054",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n讓妮諾晚餐泡湯的罪可是非常重的。",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "覺悟吧！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "background",
    "bg_id": "500140"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘰歐歐歐歐歐",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "……哼，",
    "voice": "vo_adv_3012003_055",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "我又砍了些",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "\\n無聊的東西呢。",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……不過呀，這到底怎麼一回事。",
    "voice": "vo_adv_3012003_056",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "雖然說是偶然，但她們居然打倒了",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n那個兇惡的魔物。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "大家，好厲害呢。",
    "voice": "vo_adv_3012003_057",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "嗯哼",
    "voice": "vo_adv_3012003_058",
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "妮諾",
    "words": "！",
    "voice": null,
    "unit_id": 103011
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "只要我出手的話\\n就是這麼簡單。",
    "voice": "vo_adv_3012003_059",
    "unit_id": 100811
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "奇、奇怪了……",
    "voice": "vo_adv_3012003_060",
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n魔物跑到哪裡去了？",
    "voice": null,
    "unit_id": 104511
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "或許，這些公會成員們，",
    "voice": "vo_adv_3012003_061",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "身上擁有非常棒的潛在能力",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n也說不定……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "……不過這麼一來，",
    "voice": "vo_adv_3012003_062",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n我終於能送個像樣的報告回本國了。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "太棒了！",
    "voice": "vo_adv_3012003_063",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "太棒太棒了！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "\\n哈哈哈哈！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "原本充滿不安的【純白之翼 蘭德索爾分部】\\n的未來\\n似乎也出現了一絲的希望──",
    "voice": null,
    "unit_id": null
  }
]
