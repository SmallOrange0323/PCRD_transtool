    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n妳在這艘船上幹什麼！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n這裡可不是妳這種小鬼該來的地方。",
