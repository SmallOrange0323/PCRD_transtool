    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我們應該要",
    "voice": "vo_adv_5027001_007",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "鎖定在公會成員的龍人族身上。",
