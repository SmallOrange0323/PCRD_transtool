  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "咦，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "奇怪？",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "咦？　",
    "voice": "vo_adv_5027001_010",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "咦咦咦咦咦？　{0}！？\\n你怎麼",
