    "name": "智",
    "words": "就是那麼回事。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "目前還沒有人發現我們就是【王宮騎士團（NIGHTMARE）】\\n的成員！　",
    "voice": "vo_adv_5027001_006",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "真不愧是純的策略！",
