  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "她頂著一張可怕的臉，在摘向日葵的花瓣耶……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "哼……",
    "voice": "vo_adv_9004005_002",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "據這雙七七香☆之眼所見，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n我已看破那是僅流傳於美好年華的少女之間",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n的古老占卜！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "花占卜說中是占卜，",
    "voice": "vo_adv_9004005_003",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "說不中也是占卜。",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "但若是動手阻撓的話，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "則有戀情受阻的定論。",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "會來，",
    "voice": "vo_adv_9004005_004",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "不來，",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
