[
  {
    "type": "background",
    "bg_id": "510370"
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "ついに我が【ヴァイスフリューゲル ランドソル支部】にも、",
    "voice": "vo_adv_6106101_000",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n新たな支所ができたぞ！　",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "ふふふ、",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "万全の準備で、",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "華々しく門出を",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n迎えなくては。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "差し当たり必要不可欠なものといえば……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "それはいいな。",
    "voice": "vo_adv_6106101_001",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "我がギルドの威光を示すには持ってこいだ。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "……いやしかし、",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "周辺住民の理解を得る上で、",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "あまり物々しい",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n店構えにするのも考えものか。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "うーん、",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "悩ましいな……",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "なるほど。",
    "voice": "vo_adv_6106101_002",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "ギルドの長たるもの、",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "礼節をおろそかにしてはいけないな。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "早速、",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "菓子折りを持参してご近所を行脚するとしよう。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "……け、",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "決して私がついでに甘味を楽しみたいからではないぞ！？",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "お菓子……？　",
    "voice": "vo_adv_6106101_003",
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "い、",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "いや、",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "確かに……！",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n兵糧は組織のまさに生命線であるし、",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "いわんやそれが甘味とあれば",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "\\n全体の士気にも大いに影響する。",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "ふふ、",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "さすがの慧眼だ、",
    "voice": null,
    "unit_id": 105311
  },
  {
    "type": "dialogue",
    "name": "モニカ",
    "words": "貴公！",
    "voice": null,
    "unit_id": 105311
  }
]
