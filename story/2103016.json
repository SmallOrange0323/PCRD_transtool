  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "同一時間，【咲戀育幼院】——",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "斬擊颶風！",
    "voice": "vo_adv_2103016_000",
    "unit_id": 180311
  },
  {
    "type": "background",
    "bg_id": "500353"
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "呵、呵、呵。",
    "voice": "vo_adv_2103016_001",
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "\\n這可真是的，",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "多麼令人畏懼呀。",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……唔！",
    "voice": "vo_adv_2103016_002",
    "unit_id": 180311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n從剛才開始，",
    "voice": null,
    "unit_id": 180311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "我明明就完全壓制住他了……",
    "voice": null,
    "unit_id": 180311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n卻遲遲無法了結他！　",
    "voice": null,
    "unit_id": 180311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "難不成……",
    "voice": "vo_adv_2103016_003",
    "unit_id": 180311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "他在拖延時間……？　",
    "voice": null,
    "unit_id": 180311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……你這傢伙。",
    "voice": "vo_adv_2103016_004",
    "unit_id": 180311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n可別跟我說",
    "voice": null,
    "unit_id": 180311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "你放水了啊。",
    "voice": null,
    "unit_id": 180311
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "我當然是盡全力應戰了唷？",
    "voice": "vo_adv_2103016_005",
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "\\n",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "畢竟我",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "可不擅長這種刀光劍影的場面呢。",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "還真敢說，",
    "voice": "vo_adv_2103016_006",
    "unit_id": 180311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n你可是只用那種短劍就將我的攻擊全都架開了呀……！",
    "voice": null,
    "unit_id": 180311
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "正是。",
    "voice": "vo_adv_2103016_007",
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "\\n畢竟我這雙手最擅長的器具……",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "\\n",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "便是右手持刀，",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "左手持叉",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "的嘛。",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "竟敢小看人……！",
    "voice": "vo_adv_2103016_008",
    "unit_id": 180311
  },
  {
    "type": "background",
    "bg_id": "500353"
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "呵、呵。",
    "voice": "vo_adv_2103016_009",
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "\\n這一下挺可惜的呢。",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "可惡……",
    "voice": "vo_adv_2103016_010",
    "unit_id": 180311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "再如此下去，",
    "voice": null,
    "unit_id": 180311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "日和她們就……！　",
    "voice": null,
    "unit_id": 180311
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "哈啊、",
    "voice": "vo_adv_2103016_011",
    "unit_id": 180111
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "哈啊……",
    "voice": null,
    "unit_id": 180111
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "喂喂喂怎麼啦？",
    "voice": "vo_adv_2103016_012",
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "上氣不接下氣了耶！？",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "\\n妳們所謂的「公主型態」就只有這點能耐而已嗎！",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "我倒是還可以再繼續強化下去的喔！？",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "background",
    "bg_id": "500353"
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "……哇哇！",
    "voice": "vo_adv_2103016_013",
    "unit_id": 180111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "……胡桃！",
    "voice": "vo_adv_2103016_014",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n我們兩個人，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "來想辦法搞定那傢伙吧！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "嗯、",
    "voice": "vo_adv_2103016_015",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "嗯……！",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "可是，",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "要怎麼做……！？",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「我說啊！",
    "voice": "vo_adv_2103016_016",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n那邊那個東西，",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "能不能派得上用場啊！？」",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "啊……！",
    "voice": "vo_adv_2103016_017",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "那個是",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "前陣子，",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n【小小甜心】她們來玩的時候的那個……！？",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "好！",
    "voice": "vo_adv_2103016_018",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "喂～！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "那邊那個矮冬瓜～！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「只會靠魔物戰鬥的",
    "voice": "vo_adv_2103016_019",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "超遜膽小鬼！」",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "壞、",
    "voice": "vo_adv_2103016_020",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "壞小孩……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n我們可是會",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "打你屁屁的唷……！？",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "啊——！？",
    "voice": "vo_adv_2103016_021",
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "\\n誰是矮冬瓜，誰是超遜膽小鬼啊，你們這群臭雜魚！",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「除了你以外還有誰啊——？」",
    "voice": "vo_adv_2103016_022",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "不甘心的話就自己過來打呀——！",
    "voice": "vo_adv_2103016_023",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "可惡！",
    "voice": "vo_adv_2103016_024",
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "竟然給我得寸進尺……",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "這麼想要吃我的鞭子，",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "我這就讓妳們嚐嚐！",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "\\n給我乖乖站在那裡別跑啊！",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "才、",
    "voice": "vo_adv_2103016_025",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "才不要……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我們就是要跑！",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "給我站住！",
    "voice": "vo_adv_2103016_026",
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "來呀來呀這邊這邊！",
    "voice": "vo_adv_2103016_027",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "大～蠢～蛋～♪",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「慢吞吞的笨鬼，",
    "voice": "vo_adv_2103016_028",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "快點來抓人呀～！」",
    "voice": null,
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "我不是說給我站住了……",
    "voice": "vo_adv_2103016_029",
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "……唔喔！？",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "still",
    "still_id": "210301601"
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "上當了！",
    "voice": "vo_adv_2103016_030",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n他掉進地洞了～♪",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「這可是禊小妹的特製陷阱呢！」",
    "voice": "vo_adv_2103016_031",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "嘖！",
    "voice": "vo_adv_2103016_032",
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "\\n就這種程度，",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "我一下就能出——",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "痛啊！？",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "看招看招！",
    "voice": "vo_adv_2103016_033",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "看招呀～！",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "噗吉打地鼠敲擊！",
    "voice": "vo_adv_2103016_034",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「喔啦喔啦喔啦喔啦～！」",
    "voice": "vo_adv_2103016_035",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "痛痛痛！？",
    "voice": "vo_adv_2103016_036",
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "這群傢伙！！",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「嘿嘿！",
    "voice": "vo_adv_2103016_037",
    "unit_id": 2111
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "這樣你就沒辦法妨礙那位貓咪小姐了吧！」",
    "voice": null,
    "unit_id": 2111
  },
