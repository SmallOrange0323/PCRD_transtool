    "name": "卡里莎",
    "words": "別在那邊擅自主張……",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "\\n我還、",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "沒有……",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "最短的捷徑，",
    "voice": "vo_adv_2103016_081",
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "可不一定會通往勝利的大門喔，",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "卡里莎。",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "\\n",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "就算看似繞遠路，",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "也應該要懂得適時地撤退。",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "……嘖……",
    "voice": "vo_adv_2103016_082",
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "騎士的少年。",
    "voice": "vo_adv_2103016_083",
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "你那被稱為「公主型態」的強化能力，",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "\\n",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "我已充分親身體驗……",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "並且把握箇中一二了。",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "若是，",
    "voice": "vo_adv_2103016_084",
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "你還有機會活下去並且與我等再次相遇的話，",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "\\n那麼到時……",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "再讓我用別種料理方式，",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "與各位好好過過招吧。",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "日和、怜",
    "words": "……",
    "voice": "vo_adv_2103016_085",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "胡桃、綾音",
    "words": "……",
    "voice": "vo_adv_2103016_086",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "……",
    "voice": "vo_adv_2103016_087",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "萬能人偶們",
    "words": "「嗡——嗡——」……",
    "voice": null,
    "unit_id": 191912
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "……大、",
    "voice": "vo_adv_2103016_088",
    "unit_id": 106414
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "大……家……！",
    "voice": null,
    "unit_id": 106414
  },
  {
    "type": "dialogue",
    "name": "萬能人偶們",
    "words": "「嗡——嗡——」……",
    "voice": null,
    "unit_id": 191912
  },
  {
    "type": "dialogue",
