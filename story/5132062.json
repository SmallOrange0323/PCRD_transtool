[
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "克蕾琪塔為了讓腦袋冷靜一下一個人在街上散步，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n就在這時候，有個壞消息傳進了她的耳裡。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "啊～真是受不了！",
    "voice": "vo_adv_5132062_000",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "怎麼會變成這樣！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n我不祥的預感果然應驗了！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "訂購的高級起司竟然出了差錯！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "早知道就不該特地去向國外的知名品牌下訂單……",
    "voice": "vo_adv_5132062_001",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "不僅運送過程出了意外，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "還搞錯數量……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我可沒聽說壞事會接踵而來啊！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "要現在過去取貨嗎……？",
    "voice": "vo_adv_5132062_002",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "還是要用高價把市場上的貨全部買下來……？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "不，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "不管哪個方法都來不及吧……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "話雖如此，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我也想不到要去哪裡才找得到那種等級的起司……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "大姐大姐，",
    "voice": "vo_adv_5132062_003",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "妳在為起司煩惱嗎？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "既然如此，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "要不要試試看我們家的起司呀？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "咦？",
    "voice": "vo_adv_5132062_004",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……抱歉，",
    "voice": "vo_adv_5132062_005",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我現在可沒時間陪小孩玩",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n店家扮家家酒。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我在趕時間，失陪了。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "等、",
    "voice": "vo_adv_5132062_006",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "等一下！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我已經是出色的大人了啦！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "而且，我還是【牧場】公會的公會長啊！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我今天是來賣我們牧場最受歡迎的起司的啦！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "這麼說的話，",
    "voice": "vo_adv_5132062_007",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "妳是想向我推銷自己家的產品是吧。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我確實也可以更改活動方向，主打自產自銷，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n如此一來，當地產的普通起司也不是不可行……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "可是，",
    "voice": "vo_adv_5132062_008",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "如果是街上店家叫貨也就算了，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n妳的商品究竟合不合乎我的聖誕節活動的標準，我對此抱持著很大的疑問。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "若不是送禮或高級料理用的那種等級就沒有意義了。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "不相信的話，就試吃看看吧。",
    "voice": "vo_adv_5132062_009",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n大姐只要吃過之後就絕對會愛上的啦！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "來吧來吧，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "請用請用！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……唉，",
    "voice": "vo_adv_5132062_010",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "反正我也是為了轉換心情才到街上來的，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n我就稍微奉陪一下吧。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "啊，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "嗯……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "咦？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n這",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "這這這這是",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "什麼……？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "她露出了好可怕的表情啦……",
    "voice": "vo_adv_5132062_011",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n難道……",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "搞砸了嗎……",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "難不成",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我的牧場又要被沒收了嗎……！　",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "唔，",
    "voice": "vo_adv_5132062_012",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "沒想到在蘭德索爾就有如此美味的起司……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "關於【牧場】的起司，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我本以為只是那些討人厭的貴族在那邊起鬨而已，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n是我太小看它了……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "調查的不夠徹底……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……妳，",
    "voice": "vo_adv_5132062_013",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "叫什麼名字？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我、",
    "voice": "vo_adv_5132062_014",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我叫真陽啦……",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "拜託，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "原諒我吧！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n唯獨放過牧場",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "還有我這條",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "小命啦……！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "什麼？",
    "voice": "vo_adv_5132062_015",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……妳在說什麼啊？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "真陽小姐，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "請妳務必要將妳們家的起司賣給我，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n讓我用在下次的聖誕節活動上。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "真、",
    "voice": "vo_adv_5132062_016",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "真的嗎！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "當然沒問題啦！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "……咦，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "賣給妳……？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n直到剛才",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "妳不是還皺著眉頭的嗎？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "那是我在對自己的無知感到羞恥。",
    "voice": "vo_adv_5132062_017",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "很抱歉，我以為妳是可疑的旅行商人，所以小看妳了。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "事不宜遲，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "可以立刻跟妳商量進貨的相關事宜嗎？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "喔？",
    "voice": "vo_adv_5132062_018",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "那個，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "平時的話……",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "大概是這個價錢啦。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "啥啊啊啊啊啊啊？",
    "voice": "vo_adv_5132062_019",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "妳是在我耍我嗎！？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "咦，",
    "voice": "vo_adv_5132062_020",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我、",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我做了什麼壞事嗎？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "對啊，",
    "voice": "vo_adv_5132062_021",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "沒錯！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "壞到不行，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "壞透了！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n竟然把如此高品質的起司，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n用那種低廉的價格賣出去，簡直是腦袋有問題！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "是、",
    "voice": "vo_adv_5132062_022",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "是這樣嗎……？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "可是，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n我想要以便宜的價格，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "讓更多人能夠",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "享用到美味的食物，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n讓大家都露出滿足的笑容啦……",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "妳說的我都理解，",
    "voice": "vo_adv_5132062_023",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我也認為那是個很了不起的志向。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n可是，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "要做出這麼棒的起司，勢必得花上不少時間和金錢才對。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "如果妳今後也想繼續提供好吃的起司給大家，",
    "voice": "vo_adv_5132062_024",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n最好趁能賺錢的時候多賺一點。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "一味的賤價售出",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "對支持妳的客人也很失禮。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "即使價格稍微貴一點也願意買。",
    "voice": "vo_adv_5132062_025",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "妳身邊",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "應該有客人抱持這種想法的吧？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "是啊。",
    "voice": "vo_adv_5132062_026",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "大姐說得很有道理啦。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "可是……",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "雖然我們才剛認識不久，",
    "voice": "vo_adv_5132062_027",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n但我從妳無欲無求的樣子來看，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "就算大賺了一筆，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n妳也肯定不會胡亂揮霍吧？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "那、",
    "voice": "vo_adv_5132062_028",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "那是當然！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我不是抱著那種心態在做起司的啦！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "既然如此，多賺的錢",
    "voice": "vo_adv_5132062_029",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "就拿去投資設備或發獎金給夥伴吧。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "如此一來，就會產生好的循環，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "到最後也一定會回饋到客人身上。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "大、",
    "voice": "vo_adv_5132062_030",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "大姐，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "好厲害的啦……",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "從來沒想到那麼遠過……",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "商人會有這樣的考量是理所當然的。",
    "voice": "vo_adv_5132062_031",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n販售方法就交給我來想吧。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "妳只要",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "專心做出美味的起司就可以了。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我知道了！",
    "voice": "vo_adv_5132062_032",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我相信大姐啦。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "麻煩妳了！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "啊，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "說起來",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我還不知道大姐叫什麼名字啦。",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "抱歉介紹晚了。",
    "voice": "vo_adv_5132062_033",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我叫克蕾琪塔。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n我是擔任蘭德索爾的行政長官的",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "克蕾琪塔‧凱許。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "好好記清楚囉，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "真陽小姐。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "克蕾琪塔……",
    "voice": "vo_adv_5132062_034",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "那就是克蕾克蕾囉！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "再次跟妳說聲請多指教了，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "克蕾克蕾！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "克、",
    "voice": "vo_adv_5132062_035",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "克蕾克蕾！？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "突然就幫人家取綽號，妳的距離感也太奇怪了吧！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n而且",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "克蕾克蕾的發音",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "聽起來好像我很可憐一樣！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "現在馬上換掉！",
    "voice": "vo_adv_5132062_036",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n否則",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我可能要重新考慮一下我們之間的合作關係了！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "請等一下起司！",
    "voice": "vo_adv_5132062_037",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "難得我們有這份起司之緣，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "因為是透過起司牽起的緣分，",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "所以今後也請",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "多多起司牽絲啦！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "咿咿咿！",
    "voice": "vo_adv_5132062_038",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "好冷、",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "實在太冷了！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "冷到冷笑話都要涼了……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "啊！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "喔，",
    "voice": "vo_adv_5132062_039",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "克蕾克蕾也很不錯嘛？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "才、",
    "voice": "vo_adv_5132062_040",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "才不是！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我只是不小心被妳影響……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "是說，",
    "voice": "vo_adv_5132062_041",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "要不要和我一起組一個搞笑團體啊？",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我們外表上看起來也很像一對互補的好搭檔！",
    "voice": null,
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我絕對拒絕！",
    "voice": "vo_adv_5132062_042",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "談判破裂、談判破裂！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n聽妳說胡話聽得談判都糊了……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "不對！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n怎麼搞得好像是相聲的結尾一樣！？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "啊哈哈！",
    "voice": "vo_adv_5132062_043",
    "unit_id": 103311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "克蕾克蕾果然很有搞笑的才華呢！",
    "voice": null,
    "unit_id": 103311
  }
]
