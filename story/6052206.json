  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "Lovely★莫妮卡",
    "voice": "vo_adv_6052206_000",
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "很棒對吧……",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "可說是魔法少女招牌的粉紅色",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "\\n為基底的服裝，",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "加上愛心造型相當的可愛。",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "因為才剛成為魔法少女，",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "\\n所以情報還不多，",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "要特別關注她才行！",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "你知道些什麼嗎？",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "Lovely★莫妮卡喜歡吃點心啊……",
    "voice": "vo_adv_6052206_001",
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "\\n",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "我身上也帶一些",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "好用來增進感情吧。",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "\\n",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "感謝你提供貴重的情報，",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "我就拿來參考了。",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "嚴禁把她當小孩子，",
    "voice": "vo_adv_6052206_002",
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "記下了。",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "不過，",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "誰叫Lovely★莫妮卡那麼可愛……",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "\\n得小心不要下意識地去捉弄她才行呢。",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "\\n",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "……",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "要捉弄的話，",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "就拿{0}將就一下好了，",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "嗯。",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "提督……",
    "voice": "vo_adv_6052206_003",
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "真是遠大的夢想呢。",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "\\n我知道Lovely★莫妮卡堅強的意志背後，",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "是什麼在支持著她了。",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "\\n",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "同為魔法少女，",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "要是能幫助她實現夢想就好了。",
    "voice": null,
    "unit_id": 114311
  }
]
