  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "哥哥──",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "background",
    "bg_id": "500950"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}安撫茜里，讓她躺在床上睡覺。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}姑且先聯絡了依里，請她把照顧病人的東西送來，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n然後回到了旅館房間。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "茜里",
