  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}受到茜里要求，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n要跟她約會當作先前演奏會努力的獎勵。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n到了當天，茜里有點晚到約好碰面的地方。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "──呼、",
    "voice": "vo_adv_1240003_000",
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "呼……",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "嗯、",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "哥哥……",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "讓、",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "讓你久等了……",
