    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里連衣服都洗得很乾淨，",
    "voice": "vo_adv_1240003_011",
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n還洗了好幾次澡，",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "做了很多準備的說……",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
