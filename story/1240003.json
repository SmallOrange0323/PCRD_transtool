    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "所、",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "所以才會",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "流滿身汗──",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "呀！？",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "……哥、",
    "voice": "vo_adv_1240003_005",
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "哥哥……",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "不可以……！",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n不、",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "不能突然摸女孩子的臉……",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "呀！",
    "voice": "vo_adv_1240003_006",
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "不可以摩擦",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "額頭啦……",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n被你這樣摸的話，",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里會──",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "嗚……",
    "voice": "vo_adv_1240003_007",
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "才、",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "才沒那回事。",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n雖然茜里今天，",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "精神可能有點不太好沒錯……",
    "voice": null,
    "unit_id": 124012
  },
  {
    "type": "dialogue",
    "name": "茜里",
