[
  {
    "type": "background",
    "bg_id": "505034"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "變裝的{0}和智走在受萬聖節影響，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n而熱絡不已的蘭德索爾街道上。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "哇──",
    "voice": "vo_adv_1236002_000",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "真壯觀，",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "街上因為變裝的人們而變得相當熱鬧呢！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n距離晚上的遊行還有一段時間，",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n但大家看起來已經迫不及待了。",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "啊，",
    "voice": "vo_adv_1236002_001",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "那個殭屍裝扮的姐姐，好逼真啊……！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "那邊那位扮成魔女的女孩子，",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "跟這邊扮成木乃伊的哥哥也都……",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "大家都好適合啊──！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "咦，",
    "voice": "vo_adv_1236002_002",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "這套衣服你已經看過很多次了吧？",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "還是說，",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "你想說不管看幾次都很可愛嗎？",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……開、",
    "voice": "vo_adv_1236002_003",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "開玩笑的啦，",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n不要用那麼直率的眼神看著我點頭啦。",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "不、",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "不過謝謝你，",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我很高興。",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……好、",
    "voice": "vo_adv_1236002_004",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "好了，先不說這個，",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "有很多攤販呢！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "那邊那攤寫著「會讓遊行有趣100倍的週邊商品熱賣中」",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "耶！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n我們去看看吧！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……那店員",
    "voice": "vo_adv_1236002_005",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "真會做生意。",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "說什麼「登對的情侶就要配這個！」",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "講得頭頭是道……",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n結果就忍不住買下同款的螢光棒了。",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "嗯，",
    "voice": "vo_adv_1236002_006",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "是啊。",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "既然買都買了，",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "就用這個來炒熱遊行的氣氛吧♪",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "粉絲",
    "words": "請、",
    "voice": "vo_adv_1236002_007",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "粉絲",
    "words": "請問～",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "粉絲",
    "words": "妳是智……",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "粉絲",
    "words": "對吧？",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "粉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "粉絲",
    "words": "我自從上次在文化祭看到妳之後，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "粉絲",
    "words": "就變成妳的粉絲了。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "粉絲",
    "words": "\\n我說，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "粉絲",
    "words": "跟我一起拍張合照吧！",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "粉絲",
    "words": "然後再跟我握手！",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……咦、",
    "voice": "vo_adv_1236002_008",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "啊、",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "不……",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "哦哦，",
    "voice": "vo_adv_1236002_009",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "芝芝，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "妳來玩了啊！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n……話說，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "我聽你剛才",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "叫她智",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n但她是我妹，芝芝喔。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "對吧，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "芝芝！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……咦？",
    "voice": "vo_adv_1236002_010",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "前輩，你怎麼了？",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n我不是芝芝，是智……",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "哦哦智，",
    "voice": "vo_adv_1236002_011",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "智……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "摯友跟妳走散了是吧？",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n是這樣吧，我的妹妹，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "芝芝！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……啊！",
    "voice": "vo_adv_1236002_012",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "對，",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "沒錯，前……",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "不對，哥哥！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我是芝芝！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "不是智！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "粉絲",
    "words": "咦……",
    "voice": "vo_adv_1236002_013",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "粉絲",
    "words": "是這樣嗎？",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "粉絲",
    "words": "不好意思我認錯人了。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "粉絲",
    "words": "\\n但妳這套衣服",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "粉絲",
    "words": "跟智一樣，很適合妳喔！",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "粉絲",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "粉絲",
    "words": "抱歉打擾了～！",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "不，怎麼連你也要走了！？",
    "voice": "vo_adv_1236002_014",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "你放心，",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我是智啦！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "啊……",
    "voice": "vo_adv_1236002_015",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "前輩，",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "謝謝你！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n你是因為看我很傷腦筋，",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "才來幫忙說謊蒙混過去的吧？",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "不過要蒙混的話可以想好一點的名字吧……",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "是嗎？",
    "voice": "vo_adv_1236002_016",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "以臨時想到的名字來說我覺得還不錯……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n但這種小事一點都不重要，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "我並不是特別為了妳。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n是為了避免人群聚集之後產生混亂。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "是、",
    "voice": "vo_adv_1236002_017",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "是這樣啊……！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……啊、",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "比起這個，",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "前輩明明在做警備工作，",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n我這個後輩怎麼能跑去玩耍……",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "妳在說什麼，",
    "voice": "vo_adv_1236002_018",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "要是一直繃緊神經，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "遇上緊急情況反而沒辦法好好做事吧。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n妳今天就別去想任何工作的事，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "盡情地過個開心的假日吧。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n那我先告辭了。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "智",
