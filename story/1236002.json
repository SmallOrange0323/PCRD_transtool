    "name": "智",
    "words": "魔物那邊已經順利討伐了嗎？",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "……不，",
    "voice": "vo_adv_1236002_072",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "說來慚愧，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "但最後被牠們逃掉了。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n我們應該是有把牠們逼到絕路，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "可是牠們卻忽然消失了蹤影……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n嗯……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "魔物的氣息姑且是消失了，",
    "voice": "vo_adv_1236002_073",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "但還是得繼續警戒才行……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "\\n那",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "我先離開了。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "嗯……",
    "voice": "vo_adv_1236002_074",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "到底是怎麼回事呢？",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我不認為魔物能從",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "優秀的前輩們手中逃走。",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "事情有點不對勁……",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "嗯……？",
    "voice": "vo_adv_1236002_075",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n怎麼了，",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "又一直盯著我看……",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "話先說好，",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我可不會借你手銬的喔。",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……哇！？",
    "voice": "vo_adv_1236002_076",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……",
    "voice": "vo_adv_1236002_077",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "你怎麼突然把自己的斗篷披到我身上……",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n你要做什……",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "！！？",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "騙、",
    "voice": "vo_adv_1236002_078",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "騙騙、",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "騙人的吧……？",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "裙、",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "裙子破了……！？",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n是、",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "是在剛才的混亂中，",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "不小心勾破的嗎……！？　",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "難……",
    "voice": "vo_adv_1236002_079",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "難道",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "你是注意到裙子破掉了，",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n才幫我披上斗篷蓋住它嗎……？　",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "太狡猾了啦……",
    "voice": "vo_adv_1236002_080",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "突然做這種帥氣的事……",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……啊！",
    "voice": "vo_adv_1236002_081",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……呵呵，",
    "voice": "vo_adv_1236002_082",
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "真是的！",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "你牽著我可以走慢一點嗎？不然我很難走路的……♪",
    "voice": null,
    "unit_id": 123611
  },
  {
    "type": "dialogue",
