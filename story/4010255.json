[
  {
    "type": "background",
    "bg_id": "509015"
  },
  {
    "type": "background",
    "bg_id": "510302"
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "喂，",
    "voice": "vo_adv_4010255_000",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我在這邊。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n很準時呢。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "呵呵。",
    "voice": "vo_adv_4010255_001",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n突然想見我，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "是因為知道今天是什麼日子嗎？",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "哎呀。",
    "voice": "vo_adv_4010255_002",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "既然你知道，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我可以把這當作",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "生日約會的邀約",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "吧？",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "你也挺會的嘛。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "長大之後，",
    "voice": "vo_adv_4010255_003",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "所謂的生日，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "往往就是買貴一點的熟食，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "無視熱量吃幾口蛋糕慶祝而已。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "等到像這樣，",
    "voice": "vo_adv_4010255_004",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "要跟某個人一起度過生日時……",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "呵呵。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n總覺得，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "體內的溫度在上升呢。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "話雖如此，",
    "voice": "vo_adv_4010255_005",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這孩子畢竟還年輕，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "與其說是生日約會，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "感覺更像是慶生會呢。　",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "咦？",
    "voice": "vo_adv_4010255_006",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這間店",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "對你來說，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "應該不便宜吧……",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n沒關係嗎？",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……呵呵，",
    "voice": "vo_adv_4010255_007",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "感覺到你的緊張了呢。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "是為了配合我，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "才勉強自己嗎？",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "是個了不起的男孩子呢。",
    "voice": "vo_adv_4010255_008",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不對，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "把他當作小孩看待",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "很失禮呢。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "謝",
    "voice": "vo_adv_4010255_009",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "謝你為我展現帥氣的一面。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n光是這份心意",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "就讓我很開心了。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不過，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "還是讓我結帳吧。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "想請我吃飯的話，",
    "voice": "vo_adv_4010255_010",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "等你",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "再長大一點吧，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "好嗎♪",
    "voice": null,
    "unit_id": 105131
  }
]
