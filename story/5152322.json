  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "不小心一點的話，",
    "voice": "vo_adv_5152322_001",
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "昴又要開始吧哺吧哺了呢。",
    "voice": null,
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "愛蜜莉雅大人，",
    "voice": "vo_adv_5152322_002",
    "unit_id": 132111
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "請注意不要直接接觸到。",
    "voice": null,
    "unit_id": 132111
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "我知道了。",
    "voice": "vo_adv_5152322_003",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "各位，",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "一邊用魔法製造障壁，",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n一邊注意不要被小型魔物攻擊到吧。",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "不過昴的那個樣子有點有趣就是了。",
    "voice": "vo_adv_5152322_004",
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "受不了，",
    "voice": "vo_adv_5152322_005",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "帕克你真是的。",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "那可是非～常困擾的事啊，",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "不可以以此為樂喔。",
    "voice": null,
    "unit_id": 131911
  }
