  {
    "type": "dialogue",
    "name": "珠希",
    "words": "喵喵。",
    "voice": "vo_adv_1046500_000",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "突然找我出來，",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n對{0}來說還真稀奇喵。",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n有什麼要緊事喵？",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "謝謝你喵！",
    "voice": "vo_adv_1046500_001",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這個是包袱巾喵？",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "剛好平常用的",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "開始破了喵。",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n好不容易偷到手的寶物，",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "要是掉了就沒轍了喵～",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "……啊！",
    "voice": "vo_adv_1046500_002",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "莫非",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "你知道才送我這個喵？",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "喵哈哈，",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "不愧是{0}，",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "觀察入微喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "了不起！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "當之無愧是幻影貓的同伴喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "鯛魚燒？",
    "voice": "vo_adv_1046500_003",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這是",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "{0}親手做的喵？",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "是為了幫我慶生做的喵？",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "謝謝你喵～",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n那就趕快來嘗嘗看喵。",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "啊呣……",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "嗯嗯～！",
    "voice": "vo_adv_1046500_004",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這烤得酥酥脆脆、",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "香甜綿密的滋味。",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "{0}的手藝越來越好了喵。",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "下次還想",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "請你來當我們店的幫手喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "難道是想幫我慶生喵？",
    "voice": "vo_adv_1046500_005",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "謝謝你喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "喵、",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這個是……",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "即將開幕的貓咖啡的入場券？",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "……你說店裡有大隻的也有小隻的，",
    "voice": "vo_adv_1046500_006",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "還有很多毛茸茸的貓咪？",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "原來如此喵。",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "{0}讚不絕口的話一定沒錯喵。",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我已經開始",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "期待不已了喵……！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "……對了喵！",
    "voice": "vo_adv_1046500_007",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "你跟我來一下喵。",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n作為禮物的回報，",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "告訴你我珍藏的貓咪聚集地喵。",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "難得的機會，",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我們就跟貓咪們一起慶祝喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "既然這樣決定了，",
    "voice": "vo_adv_1046500_008",
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "得準備很──多的點心喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "喵哈哈！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "快點快點，",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "{0}也一起來喵！",
    "voice": null,
    "unit_id": 104611
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n再不快點我就先走了喵──♪",
    "voice": null,
    "unit_id": 104611
  }
