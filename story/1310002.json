  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "有說了什麼嗎？",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n王子先生，",
