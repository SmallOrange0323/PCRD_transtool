[
  {
    "type": "background",
    "bg_id": "502280"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "作為大夢想樂園的新賣點而大力宣傳的馬戲團，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n迎來了首次公演，然而──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "最後一位觀眾",
    "voice": "vo_adv_1310002_000",
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "剛才回去了。",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "不過……",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "大家",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "都很失望呢。",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "雖然",
    "voice": "vo_adv_1310002_001",
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "最一開始的雜技表演",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n還有掌聲，",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "氣氛",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "相當地熱烈的……",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "background",
    "bg_id": "501410"
  },
  {
    "type": "dialogue",
    "name": "一行人",
    "words": "………………",
    "voice": "vo_adv_1310002_002",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "本來以為這個世界的民眾",
    "voice": "vo_adv_1310002_003",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "可能會很渴望看到",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "\\n刺激的表演……",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "但看來是預測失誤了呢。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "丟小刀的時候，",
    "voice": "vo_adv_1310002_004",
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "大家甚至不約而同地",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "把眼睛閉了起來……",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "那些表演內容",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "對這個世界的人來說，",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "太過刺激了呀。",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "……畢竟不止是國度，",
    "voice": "vo_adv_1310002_005",
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "甚至連世界都不同，",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "文化和喜好會有所差異，",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "也是理所當然的。",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "然而人家",
    "voice": "vo_adv_1310002_006",
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "卻自以為",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n已經完全了解觀眾的想法……",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "人家",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "覺得好羞愧啊。",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "真對不起，",
    "voice": "vo_adv_1310002_007",
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "團長先生。",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n難得",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "請你們來，",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n卻變得像是",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "砸了你們的招牌。",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "不會，",
    "voice": "vo_adv_1310002_008",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "我們沒能讓觀眾盡興也是事實。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "\\n應該要做更多的事前調查才對。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "不過，",
    "voice": "vo_adv_1310002_009",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "能讓觀眾樂在其中才算是專業表演者。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "我們並不打算",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "就這樣子結束收場。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "團長先生……",
    "voice": "vo_adv_1310002_010",
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "我說，",
    "voice": "vo_adv_1310002_011",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "大家也是這麼想的吧？",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "就這樣結束的話，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "蘭德索爾第一的名號可是會哭泣的啊！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "一行人",
    "words": "喔喔！！",
    "voice": "vo_adv_1310002_012",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "幸好",
    "voice": "vo_adv_1310002_013",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "表演檔期還沒有結束。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "\\n為了不讓您後悔委託，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "我們會拚盡全力的。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "……畢竟是人家說",
    "voice": "vo_adv_1310002_014",
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "要做馬戲團表演的，",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "看到你們這麼有幹勁，",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "人家也沒辦法說不做了呢。",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "團長先生。",
    "voice": "vo_adv_1310002_015",
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "咱們才是",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "要請你多多指教了。",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生……",
    "voice": "vo_adv_1310002_016",
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "呵呵……",
    "voice": "vo_adv_1310002_017",
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "要是讓王子先生來幫忙的話，",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n那可就",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "更不能失敗了呢。",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "看觀眾們的反應，",
    "voice": "vo_adv_1310002_018",
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "果然",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "比較刺激的表演，",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n會有滿多人",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "不敢看的樣子呢……",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "是呀，",
    "voice": "vo_adv_1310002_019",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "像是丟小刀和空中走鋼索……",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "那些以刺激為賣點的表演，全都不太受歡迎。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "關於這部分，",
    "voice": "vo_adv_1310002_020",
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "就是吉歐‧提格尼亞民眾",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "的喜好問題了呢。",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n畢竟這裡也很少有紛爭，",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "或許他們",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "本來就不喜歡這類的事吧。",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "像遊樂設施",
    "voice": "vo_adv_1310002_021",
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "他們就玩得很開心，",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "所以他們",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "應該不是討厭",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "刺激的感覺……",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "要怎麼樣改變表演的內容，",
    "voice": "vo_adv_1310002_022",
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "才能讓大家樂在其中，",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n而不感到害怕呢……",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "就算要改變表演內容，",
    "voice": "vo_adv_1310002_023",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "也是有極限的。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "\\n像是丟小刀",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "雖然可以改成丟圈圈……",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "但空中鞦韆和跳火圈就不太能調整……",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "要是改成低的鞦韆",
    "voice": "vo_adv_1310002_024",
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "和沒有火的圓圈",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n雖然比較安全，",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "但就無法帶來",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "驚奇和感動……",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "嗯…………",
    "voice": "vo_adv_1310002_025",
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "糟糕，",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "思考到腦袋都要發熱了……",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "轉換心情……？",
    "voice": "vo_adv_1310002_026",
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n王子先生，",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "您有什麼推薦的地點嗎？",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "於是，一行人來到了──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "501740"
  },
  {
    "type": "dialogue",
