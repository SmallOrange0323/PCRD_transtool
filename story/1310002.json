  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "真步小姐，",
    "voice": "vo_adv_1310002_076",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "我還有一項請求。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "\\n能夠請您",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "擔任動物馬戲團的助手嗎？",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "助手……",
    "voice": "vo_adv_1310002_077",
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "是要",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "做什麼呢？",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "必須流暢地誘導動物們，",
    "voice": "vo_adv_1310002_078",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "還要擅長使用鞭子……",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "而您",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "具備有這樣的資質。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "在不容失敗的下一場表演中，",
    "voice": "vo_adv_1310002_079",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "我們希望能盡全力做到最好。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "能請您",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "助我們一臂之力嗎？",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "團長先生，",
    "voice": "vo_adv_1310002_080",
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "真的很謝謝你。",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "雖然人家",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "也還有一點害怕……",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n……",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "……王子先生。",
    "voice": "vo_adv_1310002_081",
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n可以稍微",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "握一下人家的手嗎？",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "呵呵……",
    "voice": "vo_adv_1310002_082",
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "好溫暖呢。",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "嗯……",
    "voice": "vo_adv_1310002_083",
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "謝謝您，",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "王子先生。",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n人家已經不要緊了。",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "感覺到勇氣了。",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "……今天",
    "voice": "vo_adv_1310002_084",
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "在馬戲團小屋討論時，",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n人家",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "也已經做好心理準備了。",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "雖然",
    "voice": "vo_adv_1310002_085",
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "不知道人家究竟",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "能夠做到什麼程度……",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "但是人家",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "會誠心誠意地去表演。",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "非常感謝您。",
    "voice": "vo_adv_1310002_086",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "\\n就讓我們攜手",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "呈現出最棒的舞台吧。",
