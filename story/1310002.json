  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "如果是這樣，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "應該也能夠讓吉歐‧提格尼亞的各位",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "感到滿意。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "嗯……",
    "voice": "vo_adv_1310002_057",
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "嗯！",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "感覺很不錯。",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "光是聽了這些，",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "人家就已經迫不及待想看看",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n那會是什麼樣的馬戲團了♪",
    "voice": null,
    "unit_id": 131011
  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "就剛才那樣看來，",
