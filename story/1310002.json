  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "馬戲團所帶來的感動，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "並不是因為有人冒著風險，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "\\n而是挑戰困難的事，才會產生感動。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "馬戲團團長",
    "words": "讓觀眾不禁想幫忙加油打氣，",
