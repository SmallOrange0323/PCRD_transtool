  {
    "type": "dialogue",
    "name": "旁白",
    "words": "為了宣傳和服，{0}和空花\\n來到了市區。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "一、",
    "voice": "vo_adv_1095002_000",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "一來到市區，",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "果然人潮就很多呢……",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "擦身而過的人，",
    "voice": "vo_adv_1095002_001",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "已經有好幾個",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "都盯著空花看了……",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "雖說是為了宣傳，",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "還是讓人很害羞……",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "可、",
    "voice": "vo_adv_1095002_002",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "可是，",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "那些盯著空花……",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "宛如舔舐般的眼神，",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "讓我雖然穿著衣服，",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "卻有種連裡面的裡面都被看光光的感覺……！",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "啊啊，",
    "voice": "vo_adv_1095002_003",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "不要……",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "不要用那種眼神",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "盯著空花看！",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n空花的一切會失控的！",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "然、",
    "voice": "vo_adv_1095002_004",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "然後空花……",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "會在眾目睽睽之下，",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n照虐待狂先生的命令做出恬不知恥的行為……",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "（流口水）。",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "咿……",
    "voice": "vo_adv_1095002_005",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "在、",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "在這種大馬路上",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "你想讓我做什麼下流的事情啊！",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "咦？　",
    "voice": "vo_adv_1095002_006",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "你、",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "你什麼都沒說嗎？",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "哎呀呀，",
    "voice": "vo_adv_1095002_007",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "我失禮了！",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n一不小心……",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "就妄想過頭了……！",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "這樣不行呢。",
    "voice": "vo_adv_1095002_008",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n明明是要宣傳和服的，",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "說不定反而帶給別人不好的印象了……",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "既然這樣子，空花就",
    "voice": "vo_adv_1095002_009",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "在眾人的面前被剝光和服，",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n為了讓虐待狂先生把一絲不掛的空花都展示給大家看……",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "現、",
    "voice": "vo_adv_1095002_010",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "現在開始禁止妄想嗎！？",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "怎麼可以，",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "竟然不讓空花妄想……！",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "你是想要把空花的……",
    "voice": "vo_adv_1095002_011",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "身體和心靈，",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "全部都奪走嗎！？",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "虐待狂先生的攻勢",
    "voice": "vo_adv_1095002_012",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "實在是越來越厲害了……！",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "這樣下去，",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "空花的身體就會變得沒有虐待狂先生就活不下去了！",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n（流口水）……",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "嘻嘻嘻……",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "那樣也不錯！",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "什麼，",
    "voice": "vo_adv_1095002_013",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "難道說……",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "這是在命令我！？",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "要是我不服從的話，",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "就要懲罰人家了吧……！",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "竟然要在這種地方處罰空花，",
    "voice": "vo_adv_1095002_014",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "不愧是人格異常的瘋子……！",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n不可以啦，虐待狂先生，",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "有小孩子在看呢……",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "嘻嘻嘻。",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "哇，",
    "voice": "vo_adv_1095002_015",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "好漂亮～！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "咦，",
    "voice": "vo_adv_1095002_016",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "漂亮？　",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "是、",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "是說空花嗎？",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "嗯，",
    "voice": "vo_adv_1095002_017",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "非常漂亮！",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "姐姐，",
    "voice": "vo_adv_1095002_018",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "那是什麼衣服？",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "啊，",
    "voice": "vo_adv_1095002_019",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "是的！　",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "這、",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "這個叫作和服，",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "這是為了讓",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "那邊的虐待狂先生",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "從空花身上脫下來，",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n這樣那樣實現各式各樣欲望的……",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "（流口水）。",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "啊！　",
    "voice": "vo_adv_1095002_020",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "我、",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "我不小心又妄想了……",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "虐、",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "虐待狂先生……",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "用好冷淡的眼神看著空花……！",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "空、",
    "voice": "vo_adv_1095002_021",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "空花都知道的。",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "乍看之下，",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "虐待狂先生的眼神和平常一樣，",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n可是你的眼神裡散發出了野獸的光芒！",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "被你用那樣的眼神看著的話，",
    "voice": "vo_adv_1095002_022",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n空花會……",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "空花會",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "動彈不得的……！",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "你光是用看的，",
    "voice": "vo_adv_1095002_023",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "竟然就能束縛空花的身體……",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "真不愧是虐待狂、",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "人格異常的瘋子……！",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "虐待狂先生讓空花動彈不得後，",
    "voice": "vo_adv_1095002_024",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n接著會在眾人面前對空花呢喃！",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "「妳逃不掉了吧？　",
    "voice": "vo_adv_1095002_025",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "我會好好玩弄妳的」",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "咿咿咿！　",
    "voice": "vo_adv_1095002_026",
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "實在有夠虐待狂的！",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n已經毫無抵抗之力的空花，",
    "voice": null,
    "unit_id": 109511
  },
  {
    "type": "dialogue",
    "name": "空花",
