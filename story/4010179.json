  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "謝謝你～",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "居然記得我的生日，",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "太愛你了♡",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "\\n盡情享受",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "動物園約會吧～",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "嗯",
    "voice": "vo_adv_4010179_001",
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "哼哼～♡",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "喔，",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "馬上就看到猴子區了～",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "\\n先來看一下吧～",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "嗯……？",
    "voice": "vo_adv_4010179_002",
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "那隻小猴子，",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "跟某人長得很像耶～？",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "一直嘰嘰叫不覺得就像小卡里莎一樣嗎？",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "嗯",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "哼哼，",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "拍個照吧～",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "很好，",
    "voice": "vo_adv_4010179_003",
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "再來是三人合照～",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "小",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "騎士，",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "再靠過來一點～",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "你不好好貼著姐姐的話，",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "就沒辦法拍出可愛的照片囉～？",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "OK～",
    "voice": "vo_adv_4010179_004",
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "\\n嗯哼，",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "很不錯嘛♡",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "手機解鎖畫面換成這張好了～",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "嗯～",
    "voice": "vo_adv_4010179_005",
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "雖然",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "也喜歡動物，",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "但也蠻喜歡巡邏的？",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "你想想～",
    "voice": "vo_adv_4010179_006",
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "來動物園",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "是遠足的經典行程嘛。",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "\\n所以可以一邊看動物，",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "一邊幫助落單迷路的小孩～",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "這樣還能看到小孩的笑容，",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "雙重養眼呢♡",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "沒有啦～",
    "voice": "vo_adv_4010179_007",
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "話說",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "小騎士你看。",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "在那邊的",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "是小卡里莎本人吧？",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "好像是跟團體走散了～",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "沒辦法了，",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "去幫幫他吧～",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "很好。",
    "voice": "vo_adv_4010179_008",
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "那麼小騎士，",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "你也要和姐姐牽著手走過去喔～",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "為了不走散，",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "要緊緊～",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "牽著，",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "吶？",
    "voice": null,
    "unit_id": 123331
  },
  {
    "type": "dialogue",
    "name": "寢亞",
    "words": "\\n",
    "voice": null,
