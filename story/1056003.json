    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "殺氣騰騰的……！",
    "voice": "vo_adv_1056003_066",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "喂，妳這傢伙！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "\\n妳到底是什麼人！？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "是那傢伙雇來的殺手嗎！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "問我到底是什麼人，",
    "voice": "vo_adv_1056003_067",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我真的只是一個魚店的臨時工啊……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "也順便兼職",
    "voice": "vo_adv_1056003_068",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "暮光流星群的公會長就是了。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "……暮、",
    "voice": "vo_adv_1056003_069",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "暮光流星群！？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "\\n哈哈哈，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "怎麼可能……？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "對吧？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "老大的部下",
    "words": "老大，",
    "voice": "vo_adv_1056003_070",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "老大的部下",
    "words": "她剛剛講的該不會是……！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "首領",
    "words": "「獨眼惡魔」……",
    "voice": "vo_adv_1056003_071",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "首領",
    "words": "不僅如此！還有「收藏家」！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "首領",
    "words": "\\n以及「破壞者」和「移動龍卷風」幾人所屬的公會，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "首領",
    "words": "\\n",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "首領",
    "words": "這個鎮上最可怕的公會吧……！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "但是，公會會長卻完全不在黑社會露面……！",
    "voice": "vo_adv_1056003_072",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "\\n聽說她的實力強大到能讓那些傢伙乖乖聽話……！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "乖乖聽話？",
    "voice": "vo_adv_1056003_073",
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那些傢伙怎麼可能會乖乖聽話呢？",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n我只是被她們逼著接下了這個工作而已。",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我到現在……",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "依然只是個普通的賣魚人啊。",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "可惡！",
    "voice": "vo_adv_1056003_074",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "那傢伙，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "給我叫了什麼人過來啊……！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "首領",
    "words": "快，",
    "voice": "vo_adv_1056003_075",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "首領",
    "words": "快逃啊！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "首領",
    "words": "我們贏不了的！　",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "不！",
    "voice": "vo_adv_1056003_076",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "要是我們能在這裡打倒這傢伙，就能統治整個黑社會了！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "你們幾個給我上！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "動手！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "壞人們",
    "words": "喔喔喔喔喔喔喔！！！",
    "voice": "vo_adv_1056003_077",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "真是的……",
    "voice": "vo_adv_1056003_078",
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "壞人聚在一起，",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "總是會像這樣群體作惡……",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就讓我把你們的劣根性，",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "連根斬除！",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "認命吧！",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "壞人們",
    "words": "呀啊啊啊啊啊！",
    "voice": "vo_adv_1056003_079",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "壞人們",
    "words": "救、救命啊啊啊啊啊！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500050"
  },
  {
    "type": "dialogue",
    "name": "騎士",
    "words": "我們明明接到餐廳有人在鬧事的通報……",
    "voice": "vo_adv_1056003_080",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "騎士",
    "words": "\\n到底，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "騎士",
    "words": "發生了什麼事……！？",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "騎士",
    "words": "……這、這是，",
    "voice": "vo_adv_1056003_081",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "騎士",
    "words": "什麼狀況？",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "大姐頭！",
    "voice": "vo_adv_1056003_082",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "我……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "我至今為止都錯了！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就說我不是你們的大姐頭了吧！？",
    "voice": "vo_adv_1056003_083",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你們給我差不多一點！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "首領",
    "words": "不要這麼說嘛！",
    "voice": "vo_adv_1056003_084",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "首領",
    "words": "\\n",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "首領",
    "words": "我們幾個，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "首領",
    "words": "以後要一輩子追隨大姐頭！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "壞人們",
    "words": "大‧姐‧頭！",
    "voice": "vo_adv_1056003_085",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "壞人們",
    "words": "大‧姐‧頭！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "啊～真是的！",
    "voice": "vo_adv_1056003_086",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "結果變成這樣！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "騎士",
    "words": "……那個～",
    "voice": "vo_adv_1056003_087",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "騎士",
    "words": "請問發生了什麼事……？",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "啊～那邊那位騎士大人！",
    "voice": "vo_adv_1056003_088",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這些傢伙就交給你處理了！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "再見！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小哥！我們走！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "壞人們",
    "words": "請等一下～！",
    "voice": "vo_adv_1056003_089",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "壞人們",
    "words": "大姐頭～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500022"
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "呼、呼、呼……",
    "voice": "vo_adv_1056003_090",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "總算脫身了……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小哥，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你還好嗎？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "像那樣嘴裡說著我清醒了的傢伙啊，",
    "voice": "vo_adv_1056003_091",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n只不過是被當下情緒給迷惑而已。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那些崇拜我的笨蛋，",
    "voice": "vo_adv_1056003_092",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "總是不停地勉強自己，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n到最後每個人都把身體搞壞了……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小哥你啊，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "可不能變得和他們一樣喔。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我想也是。",
    "voice": "vo_adv_1056003_093",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "如果你想的話，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "早就加入騎士團了……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "說得也是。",
    "voice": "vo_adv_1056003_094",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小哥你",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "並不執著於強大的力量。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "既然這樣，",
    "voice": "vo_adv_1056003_095",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那你為何要跟著我呢？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……你是為了我？",
    "voice": "vo_adv_1056003_096",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "所以組織之間的對立，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n還有懲惡鋤奸這些事，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你根本就不放在眼裡囉……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "呵呵……",
    "voice": "vo_adv_1056003_097",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "呵呵呵，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "啊哈哈哈哈！！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小哥，",
    "voice": "vo_adv_1056003_098",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你真是個好男人！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n我越來越中意你了！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "以後也要靠你幫忙囉，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小哥！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──流夏輕輕拍了他的背，從她說的話以及背後傳來的觸感，\\n{0}可以感覺到流夏對自己的信賴。",
