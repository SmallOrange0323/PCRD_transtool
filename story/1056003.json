[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──這一天，當{0}\\n漫無目的地走在街上時，遇見了流夏。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你不要太過分了。",
    "voice": "vo_adv_1056003_000",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n自己捅的摟子自己收拾。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "大姐頭，請妳不要這麼說嘛！",
    "voice": "vo_adv_1056003_001",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n拜託妳了！拜託！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "別叫我大姐頭！",
    "voice": "vo_adv_1056003_002",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "真是的……什麼拜不拜託的。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "真是丟人現眼，快走……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "咦，小哥。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你最近過得好嗎？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這樣啊。",
    "voice": "vo_adv_1056003_003",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "太好了。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……喔，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你說這傢伙啊？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "喔，",
    "voice": "vo_adv_1056003_004",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你說這傢伙啊……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我之前稍微修理過這傢伙。",
    "voice": "vo_adv_1056003_005",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n他好像遇到了有點麻煩的事。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "不是有點麻煩而已！",
    "voice": "vo_adv_1056003_006",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n我剛剛也說了，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "再這樣下去，我會被宰了！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "但是去取對方頭目的性命，",
    "voice": "vo_adv_1056003_007",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n橫豎也是死路一條……",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "哈哈哈……",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "好像是",
    "voice": "vo_adv_1056003_008",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這傢伙想脫離一個幫派，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n那個幫派的老大命令他",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "去暗殺敵對犯罪組織的頭頭。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "都是我不好我欠了老大人情……",
    "voice": "vo_adv_1056003_009",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n他威脅我說，如果拒絕的話，就吃不完兜著走……",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "可是我已經想金盆洗手，",
    "voice": "vo_adv_1056003_010",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "規規矩矩地過生活！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n托大姐頭的福我已經清醒了！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n我只能靠妳了，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "大姐頭！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就說不要再叫我大姐頭了！",
    "voice": "vo_adv_1056003_011",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……真拿你沒轍。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你告訴我，那個老大人在哪裡。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "總之，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我直接去找他談。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "大姐頭！",
    "voice": "vo_adv_1056003_012",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "謝謝妳！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "妳的大恩大德我一輩子都不會忘記！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這才不是什麼大恩。",
    "voice": "vo_adv_1056003_013",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我只是不想看到你的屍體而已。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這樣好嗎？",
    "voice": "vo_adv_1056003_014",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "也好，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "總比一個人去來得放心。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "請多指教，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小哥。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "background",
    "bg_id": "500050"
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "……哼哼。",
    "voice": "vo_adv_1056003_015",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "那個傢伙。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "自己沒出面也就算了，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "竟然敢讓別人代替他過來。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你就是這裡的老大嗎？",
    "voice": "vo_adv_1056003_016",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我是流夏。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我在鬧區的魚店裡工作。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "魚店……？",
    "voice": "vo_adv_1056003_017",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "哈哈哈哈哈！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "這也太可笑了！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我就直說了。",
    "voice": "vo_adv_1056003_018",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你就饒了那傢伙吧。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "他已經不是你的部下了。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "……我怎麼可能平白饒過他。",
    "voice": "vo_adv_1056003_019",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "\\n如果妳代替他把對方的首級帶來，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "我就饒了他。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "啊？",
    "voice": "vo_adv_1056003_020",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "為什麼我得做這種事……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "──那傢伙不是拜託妳幫忙了嗎！",
    "voice": "vo_adv_1056003_021",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "既然這樣，妳幫他擦屁股才是合乎道理啊！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "什麼道理啊？",
    "voice": "vo_adv_1056003_022",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "還真敢講，分明是你趁人之危……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "不過那傢伙也真是，誰不拜託，",
    "voice": "vo_adv_1056003_023",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "卻偏偏去拜託一個魚店女人……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "哼哼哼。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "我就要看！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "妳到底有什麼能耐？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "反正妳會切的也只有魚吧？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……你可不要小看魚店的女人喔。",
    "voice": "vo_adv_1056003_024",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "既然你這麼說，那我就做給你看！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "妳要是做得到務必讓我見識一下！",
    "voice": "vo_adv_1056003_025",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "\\n反正一介賣魚的不可能辦到吧！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "妳放心！",
    "voice": "vo_adv_1056003_026",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "如果搞砸我會幫妳收屍啦！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "哈哈哈哈！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……到時被首級嚇到可不關我的事。",
    "voice": "vo_adv_1056003_027",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "打擾了。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……",
    "voice": "vo_adv_1056003_028",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "唉。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我又搞砸了。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "老大的部下",
    "words": "喂，小哥！",
    "voice": "vo_adv_1056003_029",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "老大的部下",
    "words": "大姐她出來囉。太好了呢！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "老大的部下",
    "words": "\\n你可以不用再提心吊膽了！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "老大的部下",
    "words": "呀哈哈哈！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小哥。",
    "voice": "vo_adv_1056003_030",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "抱歉讓你在這裡等。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我們走吧。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "細節等一下邊走邊說。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "background",
    "bg_id": "500021"
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "──就是這麼一回事，",
    "voice": "vo_adv_1056003_031",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n最後變成我得代替他去做這件事。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "因為那傢伙瞧不起我的工作，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我吞不下這口氣就……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "雖說我天生個性如此，",
    "voice": "vo_adv_1056003_032",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不過這次我真的有好好地反省……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "希望能順利解決",
    "voice": "vo_adv_1056003_033",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n他們雙方的對立……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "說得也是。",
    "voice": "vo_adv_1056003_034",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "讓敵對的雙方自己處理是最好的。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就是說啊。",
    "voice": "vo_adv_1056003_035",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "把毫不相關的人硬捲進來實在太過分了。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "既然要做乾脆讓他們互打……",
    "voice": "vo_adv_1056003_036",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就是這個。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "根本不需要弄髒我們自己的手啊。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "只要讓雙方頭目碰面，",
    "voice": "vo_adv_1056003_037",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "接下來他們就會互相擊潰了。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這麼一來，",
    "voice": "vo_adv_1056003_038",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "要做的事就只有一樣……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n首先要先找到首領。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "background",
    "bg_id": "500022"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "接著流夏就開始去找敵對組織的首領。\\n終於，打聽到那個頭頭經常出沒的地點，\\n流夏和{0}一同前往該地點。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……看來那個傢伙就是首領吧。",
    "voice": "vo_adv_1056003_039",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你在這兒把風。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我過去囉！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "借一步說話！",
    "voice": "vo_adv_1056003_040",
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "首領",
    "words": "妳誰啊！",
    "voice": "vo_adv_1056003_041",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "喝！",
    "voice": "vo_adv_1056003_042",
    "unit_id": 105612
  },
  {
    "type": "background",
    "bg_id": "500022"
  },
  {
    "type": "dialogue",
    "name": "首領",
    "words": "唔哇！",
    "voice": "vo_adv_1056003_043",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……成功了呢。",
    "voice": "vo_adv_1056003_044",
    "unit_id": 105611
  },
  {
    "type": "background",
    "bg_id": "500050"
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "打擾了！",
    "voice": "vo_adv_1056003_045",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "原來是妳……",
    "voice": "vo_adv_1056003_046",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "一定是夾著尾巴逃回來了吧？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "我早就知道──",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我把對方的首領帶來囉！",
    "voice": "vo_adv_1056003_047",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n剩下的就讓你們自己去談吧！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "首領",
    "words": "唔……",
    "voice": "vo_adv_1056003_048",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "妳說什麼！？",
    "voice": "vo_adv_1056003_049",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "我可沒要妳把他帶來啊！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "首領",
    "words": "這裡是……",
    "voice": "vo_adv_1056003_050",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "首領",
    "words": "啊！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "首領",
    "words": "原來是你搞的鬼！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "首領",
    "words": "\\n居然搞這種手段！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "首領",
    "words": "你的組織會怎樣都無所謂了嗎！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "這，這是誤會！",
    "voice": "vo_adv_1056003_051",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "……對，對了！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "我其實是想和你結盟，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "來壯大彼此的組織！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "啊！？",
    "voice": "vo_adv_1056003_052",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "首領",
    "words": "什麼～！？",
    "voice": "vo_adv_1056003_053",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "首領",
    "words": "\\n",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "首領",
    "words": "……是，是這樣啊！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "首領",
    "words": "其實我也正在思考著同一件事！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "首領",
    "words": "\\n再這樣互相對立下去，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "首領",
    "words": "最後也只是兩敗俱傷！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "是啊是啊！",
    "voice": "vo_adv_1056003_054",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "所以說……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "今天這事都是",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "那個女人搞的鬼！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "這個女人，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "就是挑撥我們的主嫌！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "首領",
    "words": "原來如此……",
    "voice": "vo_adv_1056003_055",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "首領",
    "words": "搞出這件事的原來就是妳！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "首領",
    "words": "\\n妳想阻礙我們聯手壯大組織是吧！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "首領的部下",
    "words": "首領！",
    "voice": "vo_adv_1056003_056",
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "首領的部下",
    "words": "我們來救你了！",
    "voice": null,
    "unit_id": 1011
  },
  {
    "type": "dialogue",
    "name": "首領",
    "words": "喔！",
    "voice": "vo_adv_1056003_057",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "首領",
    "words": "他們不是敵人！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "首領",
    "words": "我們的敵人是那個女人和小鬼！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "老大的部下",
    "words": "老大，只要打倒這個女人就行了嗎！",
    "voice": "vo_adv_1056003_058",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "沒錯！",
    "voice": "vo_adv_1056003_059",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "順便連他旁邊的小鬼也一起滅了！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "組織的老大",
    "words": "記得把門鎖緊喔……？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……哎呀呀。",
    "voice": "vo_adv_1056003_060",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "原來這就是壞人的鬼點子嗎。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "真不是什麼好東西。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "笑死人了。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小哥你快逃吧。",
    "voice": "vo_adv_1056003_061",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這裡我會想辦法。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……小哥。",
    "voice": "vo_adv_1056003_062",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你這種義氣，我喜歡！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n那就讓我再借助你的力量吧！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……哎呀呀，真是的。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "看來我也得拿出真本事",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "來回禮才行呢。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……像你們這種小嘍囉，",
    "voice": "vo_adv_1056003_063",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "對我而言根本是小意思。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我本來想盡可能和平處理的……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "既然這樣，我就不管你們有什麼下場囉！",
    "voice": "vo_adv_1056003_064",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "想死的傢伙",
