    "name": "嘉夜",
    "words": "好，我知道了！　",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "聽好囉？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n你對這傢伙找的碴，",
    "voice": null,
