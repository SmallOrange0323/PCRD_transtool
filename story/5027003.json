  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "她嘴上這麼說，",
    "voice": "vo_adv_5027003_019",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "最後還是跑回去她老大那裡了……",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "感覺……",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "要待在這個公會也滿不容易的……",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "你說啥！",
    "voice": "vo_adv_5027003_020",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流氓2",
