    "name": "紡希",
    "words": "難不成你剛才，",
    "voice": "vo_adv_9003508_012",
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n不知道目的地還直接衝出去嗎……",
    "voice": null,
    "unit_id": 105412
  },
  {
    "type": "dialogue",
    "name": "大吾",
    "words": "我也沒辦法吧，",
