  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n我們還必須去",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "救援其他人，卻在這裡……！",
