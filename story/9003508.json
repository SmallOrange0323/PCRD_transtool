  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "奇怪？",
    "voice": null,
    "unit_id": 102912
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n蘭法小姐，",
    "voice": null,
    "unit_id": 102912
  },
