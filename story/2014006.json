        "voice": null
    },
    {
        "name": "克莉絲提娜",
        "words": "真是夠了……",
        "voice": null
    },
    {
        "name": "克莉絲提娜",
        "words": "這不就感覺像是當了正義的英雄一樣嗎？",
        "voice": null
    },
    {
        "name": "克莉絲提娜",
        "words": "本小姐我呢！",
        "voice": null
    },
    {
        "name": "拉基拉基",
        "words": "儘管看來是狼狽了不少的模樣，",
        "voice": "vo_adv_2014006_066"
    },
    {
        "name": "拉基拉基",
        "words": "\\n然而能安然無事就是萬幸了。",
        "voice": null
    },
    {
        "name": "拉基拉基",
        "words": "似似花。",
        "voice": null
    },
    {
        "name": "似似花",
        "words": "克莉絲……",
        "voice": "vo_adv_2014006_067"
    },
    {
        "name": "似似花",
        "words": "還有拉基拉基。",
        "voice": null
    },
    {
        "name": "似似花",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "似似花",
        "words": "若要來助人一臂之力，",
        "voice": null
    },
    {
        "name": "似似花",
        "words": "還請盡早一些。",
        "voice": null
    },
    {
        "name": "似似花",
        "words": "\\n這兒可是差一些就被人間蒸發，",
        "voice": null
    },
    {
        "name": "似似花",
        "words": "魂魄被人給闇影化去了呢。",
        "voice": null
    },
    {
        "name": "克莉絲提娜",
        "words": "啊啊，",
        "voice": "vo_adv_2014006_068"
    },
    {
        "name": "克莉絲提娜",
        "words": "抱歉抱歉。",
        "voice": null
    },
    {
        "name": "克莉絲提娜",
        "words": "\\n儘管讓拉基拉基進行了轉移，",
        "voice": null
    },
    {
        "name": "克莉絲提娜",
        "words": "然而卻始終掌握不到所在處呢。",
        "voice": null
    },
    {
        "name": "克莉絲提娜",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "克莉絲提娜",
        "words": "不過，",
        "voice": null
    },
    {
        "name": "克莉絲提娜",
        "words": "不也都沒差了嗎？　",
        "voice": null
    },
    {
        "name": "克莉絲提娜",
        "words": "畢竟趕上了嘛。",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "……",
        "voice": "vo_adv_2014006_069"
    },
    {
        "name": "霸瞳皇帝",
        "words": "妳還真有辦法鎖定我的所在處呢，",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "克莉絲提娜。",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "在如此寬廣的城中，",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "不論各處也都正在混戰當中……",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "\\n而魔力的流動，",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "明明都被攪得一團亂了。",
        "voice": null
    },
    {
        "name": "克莉絲提娜",
        "words": "啊啊，",
        "voice": "vo_adv_2014006_070"
    },
    {
        "name": "克莉絲提娜",
        "words": "講到這回事？",
        "voice": null
    },
    {
        "name": "克莉絲提娜",
        "words": "\\n我們這，",
        "voice": null
    },
    {
        "name": "克莉絲提娜",
        "words": "有能夠用通訊魔法提供消息與幫助的人唷。",
        "voice": null
    },
    {
        "name": "克莉絲提娜",
        "words": "\\n若又要說到這――",
        "voice": null
    },
    {
        "name": "克莉絲提娜",
        "words": "哈哈。",
        "voice": null
    },
    {
        "name": "克莉絲提娜",
        "words": "不是，這可真是太妙了啊。",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "……？",
        "voice": "vo_adv_2014006_071"
    },
    {
        "name": "克莉絲提娜",
        "words": "陛下現在的所在處――",
        "voice": "vo_adv_2014006_072"
    },
    {
        "name": "克莉絲提娜",
        "words": "他們把這事告訴我們時，",
        "voice": null
    },
    {
        "name": "克莉絲提娜",
        "words": "還說做為回報，",
        "voice": null
    },
    {
        "name": "克莉絲提娜",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "克莉絲提娜",
        "words": "『要我們幾個』，",
        "voice": null
    },
    {
        "name": "克莉絲提娜",
        "words": "『想辦法拖延住陛下』",
        "voice": null
    },
    {
        "name": "克莉絲提娜",
        "words": "竟然這麼講呢！",
        "voice": null
    },
    {
        "name": "克莉絲提娜",
        "words": "說要我拖延！？　",
        "voice": "vo_adv_2014006_073"
    },
    {
        "name": "克莉絲提娜",
        "words": "真是笑掉人大牙對吧！",
        "voice": null
    },
    {
        "name": "克莉絲提娜",
        "words": "\\n若當我跟你都攤了牌要打一場――",
        "voice": null
    },
    {
        "name": "克莉絲提娜",
        "words": "\\n那鐵定就是場最終決戰了，",
        "voice": null
    },
    {
        "name": "克莉絲提娜",
        "words": "豈還有其他可能！",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "……",
        "voice": "vo_adv_2014006_074"
    },
    {
        "name": "霸瞳皇帝",
        "words": "這瘋狗。",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "\\n能否請妳別把妳那口水濺到人這兒了呢？",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "\\n妳的這一點，",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "讓人非常不愉快啊。",
        "voice": null
    },
    {
        "name": "克莉絲提娜",
        "words": "這樣啊？",
        "voice": "vo_adv_2014006_075"
    },
    {
        "name": "克莉絲提娜",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "克莉絲提娜",
        "words": "我可是最喜歡你啦！",
        "voice": null
    },
    {
        "name": "克莉絲提娜",
        "words": "\\n我可是打從心底愛著你的呢！",
        "voice": null
    },
    {
        "name": "克莉絲提娜",
        "words": "那份美貌！　",
        "voice": "vo_adv_2014006_076"
    },
    {
        "name": "克莉絲提娜",
        "words": "那份天賦的異稟！",
        "voice": null
    },
    {
        "name": "克莉絲提娜",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "克莉絲提娜",
        "words": "這其中更是",
        "voice": null
    },
    {
        "name": "克莉絲提娜",
        "words": "你那扭曲到透徹乾脆至極的靈魂，令人無法自拔啊！",
        "voice": null
    },
    {
        "name": "克莉絲提娜",
        "words": "所以我才因此願意居於你的麾下啊！",
        "voice": "vo_adv_2014006_077"
    },
    {
        "name": "克莉絲提娜",
        "words": "\\n因為能滿足我那渴望的，",
        "voice": null
    },
    {
        "name": "克莉絲提娜",
        "words": "除了你以外別無他人了！",
        "voice": null
    },
    {
        "name": "克莉絲提娜",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "克莉絲提娜",
        "words": "沒錯――",
        "voice": null
    },
    {
        "name": "克莉絲提娜",
        "words": "我可是愛到想要殺死你了唷，",
        "voice": null
    },
    {
        "name": "克莉絲提娜",
        "words": "千里真那！",
        "voice": null
    },
    {
        "name": "拉基拉基",
        "words": "……似似花，",
        "voice": "vo_adv_2014006_078"
    },
    {
        "name": "拉基拉基",
        "words": "請妳退下。",
        "voice": null
    },
    {
        "name": "拉基拉基",
        "words": "\\n我來掩護克莉絲提娜。",
        "voice": null
    },
    {
        "name": "拉基拉基",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "拉基拉基",
        "words": "妳的狀態如此，",
        "voice": null
    },
    {
        "name": "拉基拉基",
        "words": "可別被捲入進來了……",
        "voice": null
    },
    {
        "name": "似似花",
        "words": "那我就心存感謝地",
        "voice": "vo_adv_2014006_079"
    },
    {
        "name": "似似花",
        "words": "接受你們的好意了。",
        "voice": null
    },
    {
        "name": "似似花",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "似似花",
        "words": "……",
        "voice": null
    },
    {
        "name": "似似花",
        "words": "拉基拉基。",
        "voice": null
    },
    {
        "name": "似似花",
        "words": "見到如此紳士的你，",
        "voice": null
    },
    {
        "name": "似似花",
        "words": "讓人有些不自在呢……",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "哼……",
        "voice": "vo_adv_2014006_080"
    },
    {
        "name": "霸瞳皇帝",
        "words": "看來是讓妳暫時撿回一條小命了呢。",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "\\n不過，",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "我馬上就會把你們全都做成闇影囉……",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "包括妳，",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "和這愚蠢的兩人一起啊！",
        "voice": null
    },
    {
        "name": "克莉絲提娜",
        "words": "啊啊，",
        "voice": "vo_adv_2014006_081"
    },
    {
        "name": "克莉絲提娜",
        "words": "太棒了！　",
        "voice": null
    },
    {
        "name": "克莉絲提娜",
        "words": "您可終於有意和我一戰了呢！",
        "voice": null
    },
    {
        "name": "克莉絲提娜",
        "words": "陛下呀！",
        "voice": null
    },
    {
        "name": "克莉絲提娜",
        "words": "\\n我的亂數聖域，",
        "voice": null
    },
    {
        "name": "克莉絲提娜",
        "words": "和你的霸瞳天星！",
        "voice": null
    },
    {
        "name": "克莉絲提娜",
        "words": "\\n究竟哪一方較為優異――",
        "voice": null
    },
    {
        "name": "克莉絲提娜",
        "words": "如今！　",
        "voice": null
    },
    {
        "name": "克莉絲提娜",
        "words": "不讓我們來好好一爭高下嗎！",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "妳說有意",
        "voice": "vo_adv_2014006_082"
    },
    {
        "name": "霸瞳皇帝",
        "words": "與妳一戰？",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "\\n還說要和我一爭高下？",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "妳那愚昧的見解最好修正一下，",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "克莉絲――",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "――那條霸王之道，",
        "voice": "vo_adv_2014006_083"
    },
    {
        "name": "霸瞳皇帝",
        "words": "總是敞開於我的面前。",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "\\n而將你們這些礙事的人從這條路上剔除……",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "根本不是什麼戰鬥，",
        "voice": null
    },
    {
        "name": "霸瞳皇帝",
        "words": "不過就是些雞毛蒜皮之事啊！",
        "voice": null
