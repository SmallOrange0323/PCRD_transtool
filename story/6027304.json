[
  {
    "type": "background",
    "bg_id": "500750"
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ど、",
    "voice": "vo_adv_6023304_000",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "どうした後輩、",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "今日はエキセントリックな御登場じゃないか。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "さてはチエル君に",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "なにか吹きこまれてきたな……",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "彼女の悪戯は",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "親愛表現だろうが、",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "君は彼女をどう思っているね？",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "同感だ。",
    "voice": "vo_adv_6023304_001",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "彼女は持って生まれた特質を",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "最大限に享受している。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n世に「女の子」などと呼称されるジェンダーを",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "全霊で満喫している。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "その自由で瑞々しい生き様を、",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ぼくらは可愛いと形容するのだろう。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "まあ、",
    "voice": "vo_adv_6023304_002",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "そう言ってやるな。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "彼女のああいう戯れ言や振る舞いは、",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n他者を楽しませたい",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "道化の精神だ。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ああ見えて芯は……",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "なに？",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ああ、",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "頭がおかしいという意味ではないのか。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "失敬、",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "早とちりだ。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "そうだな。",
    "voice": "vo_adv_6023304_003",
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "大脳皮質に情報を詰めこんだだけのぼくとは",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "本質的に違う。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n彼女の賢さは",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "もっと根源に由来する。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "ああいうのが本物なのだろう。",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "\\n",
    "voice": null,
    "unit_id": 111011
  },
  {
    "type": "dialogue",
    "name": "ユニ",
    "words": "……あまりにちぇるちぇるしていて日頃は忘れがちだがな。",
    "voice": null,
    "unit_id": 111011
  }
]
