  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "原來是這樣……",
    "voice": "vo_adv_5013003_062",
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
