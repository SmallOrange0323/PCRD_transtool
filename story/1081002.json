  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "成功擊退了魔物，開心地看著幽靈與孩子們嬉戲的景象之後――",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "咦？　",
    "voice": "vo_adv_1081002_000",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "怎麼了嗎？　",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "最後還有一個請求嗎……？",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "啊，",
    "voice": "vo_adv_1081002_001",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不好意思，{0}。\\n",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "剛才幫我們阻止魔物的那些幽靈們",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n好像想跟我們說話。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "是的。",
    "voice": "vo_adv_1081002_002",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "說是有個請求……",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "嗯嗯。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "咦咦！？　",
    "voice": "vo_adv_1081002_003",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這、",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這樣再怎麼說也……",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "嗚嗚。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那、",
    "voice": "vo_adv_1081002_004",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那個。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "他們好像是一對夫婦，\\n",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "要是能在這麼開心的節日，",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "約、",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "約會的話，\\n",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "把這當作紀念，就能毫無牽掛地順利升天了。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "然後",
    "voice": "vo_adv_1081002_005",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "他們問說能不能……",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "讓太太附身在我身上，",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n先生則是附身在{0}身上，",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "讓兩個人可以在這一天",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "做最後的約會……",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "我不允許！　",
    "voice": "vo_adv_1081002_006",
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "絕對不允許！",
    "voice": null,
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n就算神明點頭，我也不可能答應的！",
    "voice": null,
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "嗯？　",
    "voice": "vo_adv_1081002_007",
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "什麼？　",
    "voice": null,
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "下次會介紹很不錯的女幽靈給你認識，",
    "voice": null,
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n所以請不要這麼生氣？",
    "voice": null,
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "耍人……",
    "voice": "vo_adv_1081002_008",
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "不對，耍骷髏頭也要有個限度啊！",
    "voice": null,
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n本大爺怎麼可能會輸給這種誘惑……",
    "voice": null,
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "嗚，唔唔唔唔。",
    "voice": null,
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n也、",
    "voice": null,
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "也不是不能考慮一下啦……",
    "voice": null,
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "爸、",
    "voice": "vo_adv_1081002_009",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "爸爸，",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "你的意志力也太薄弱了吧……",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那個……",
    "voice": "vo_adv_1081002_010",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "其實我也很感謝他們幫忙救了那些孩子們，",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n也很想盡可能地做些什麼來答謝他們，",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "但約會就有點……",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "而且，",
    "voice": "vo_adv_1081002_011",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "還得顧慮{0}的想法。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "可、",
    "voice": "vo_adv_1081002_012",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "可以嗎！？　",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "可、",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "可是。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "可是可是……",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "嗚嗚……",
    "voice": "vo_adv_1081002_013",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我知道了。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n因為我從來都沒有約會過，",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n所以不知道能不能達成他們的願望……",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我、",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我會加油的。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "咦？　",
    "voice": "vo_adv_1081002_014",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我知道了。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "首先是在鎮上散步……",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "要、",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "要牽著手。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "小伙子！　",
    "voice": "vo_adv_1081002_015",
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "你有先消毒過嗎！？",
    "voice": null,
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n要是你敢用你骯髒的手碰忍，",
    "voice": null,
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "我就把那手指給咬斷！",
    "voice": null,
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "爸爸，",
    "voice": "vo_adv_1081002_016",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "你別說這麼可怕的事啦。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那麼，",
    "voice": "vo_adv_1081002_017",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那個……",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "麻煩你了。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "啊……",
    "voice": "vo_adv_1081002_018",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "人類的手，真的很溫暖呢。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n因為爸爸一直都冷冰冰的。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "唔。",
    "voice": "vo_adv_1081002_019",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "感覺我的臉開始發燙了……",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "咦？　",
    "voice": "vo_adv_1081002_020",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "想要聽一些男女朋友之間會說的肉麻話",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "嗎？",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "又、",
    "voice": "vo_adv_1081002_021",
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "又要做了啊！　",
    "voice": null,
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "嗚唔唔唔唔……",
    "voice": null,
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "……親～",
    "voice": "vo_adv_1081002_022",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "親愛的……",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我、",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我愛你。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "忍、",
    "voice": "vo_adv_1081002_023",
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "忍……",
    "voice": null,
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "妳也太不會演戲了吧。",
    "voice": null,
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "這樣很可愛唷！",
    "voice": null,
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不論什麼時候看到你，",
    "voice": "vo_adv_1081002_024",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "都好帥……",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "咦……",
    "voice": "vo_adv_1081002_025",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那、那個，",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這是在演戲",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "對吧……？",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那、",
    "voice": "vo_adv_1081002_026",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那個，",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "你這樣看著我，",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我不知道該做出什麼反應才好……",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "嗚嗚。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "這是怎樣……",
    "voice": "vo_adv_1081002_027",
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "這是怎樣這是怎樣這是怎樣\\n這是怎樣這是怎樣這是怎樣這是怎樣這是怎樣這是怎樣――",
    "voice": null,
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "爸爸，",
    "voice": "vo_adv_1081002_028",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "你不要抖得那麼誇張啦。",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "雖然我快被怒氣衝昏了頭，",
    "voice": "vo_adv_1081002_029",
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "\\n不過這都是為了認識可愛的女孩子。",
    "voice": null,
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "忍耐，",
    "voice": null,
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "骷髏老爸",
    "words": "我要好好忍耐……！",
    "voice": null,
    "unit_id": 2412
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那個，",
    "voice": "vo_adv_1081002_030",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那麼",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "接下來要做什麼……",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "咦？　",
    "voice": "vo_adv_1081002_031",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
