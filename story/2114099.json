    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "甚至是肉體和靈魂資訊的，",
