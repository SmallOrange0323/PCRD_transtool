  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "呵呵……",
    "voice": "vo_adv_2114099_066",
    "unit_id": 129013
  },
  {
    "type": "movie",
    "movie_id": "211409901"
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "美空……",
    "voice": "vo_adv_2114099_067",
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……為什麼……？",
    "voice": "vo_adv_2114099_068",
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n為什麼你現在，",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "會在意起她的事？",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "在這裡的，",
    "voice": "vo_adv_2114099_069",
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "可是我喔。",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n騎士先生……",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……？",
    "voice": "vo_adv_2114099_070",
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "這是……",
    "voice": "vo_adv_2114099_071",
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "有某種",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "干涉……",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "難道說……！",
    "voice": "vo_adv_2114099_072",
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "…………\\n……",
