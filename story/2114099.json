    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "…………",
    "voice": "vo_adv_2114099_030",
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……嗯。",
    "voice": "vo_adv_2114099_031",
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n這樣啊……",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "也是呢。",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "騎士先生……",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "就是這樣的人嘛……",
