    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "那怎麼可能呢♪",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "我只是順勢衝破結界，",
    "voice": "vo_adv_2114099_076",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "當下臨機使用了空間跳躍，",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n將騎士同學拐了過來。",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "在這之後的事情",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "我可是完～全沒有在考慮呢★",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "因為因為──",
    "voice": "vo_adv_2114099_077",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n這是騎士同學的錯喔？",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "我本來，",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "只是想靜靜地守望著這個世界結束……",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "結果騎士同學你，",
    "voice": "vo_adv_2114099_078",
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "卻注意到了我。",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "總覺得",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "胸口好像「揪★」了一下嘛♪",
    "voice": null,
    "unit_id": 192011
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n這是我第一次有了這種感覺♪",
