  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "和其他的人大不相同。",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n我用了比起任何人都還要長的時間，",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "一直不斷地想著你的事。",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "因為，",
    "voice": "vo_adv_2114099_055",
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我跟其他人不一樣。",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n我的思念，",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "不會被重置。",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我啊。",
    "voice": "vo_adv_2114099_056",
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "一直，",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "在看著騎士先生。",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "看到騎士先生",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "受傷、",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "倒下。",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n看到你因為建立起的羈絆被破壞……",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "而痛苦的樣子。",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我其實，",
    "voice": "vo_adv_2114099_057",
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "是很想幫你的。",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n但我能夠介入的，",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "總是只有在你已經不存在的世界。",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n……而且……",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "如果跟米奈娃同化後的我，",
    "voice": "vo_adv_2114099_058",
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "是掌管世界運作的人，",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n那麼騎士先生，",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "就是因為我的關係，",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "連受了傷害這件事，",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "都無法察覺……",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "一而再、",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "再而三地……",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "……",
    "voice": "vo_adv_2114099_059",
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "不過……",
    "voice": "vo_adv_2114099_060",
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "你放心。",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n那樣悲傷的命運，",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "已經，",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "結束了。",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "騎士先生，",
    "voice": "vo_adv_2114099_061",
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "已經不會再受傷了。",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n已經再也，",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "不會痛苦了。",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "就算你不知道我的事，",
    "voice": "vo_adv_2114099_062",
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n我也會慢慢地，",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "花時間……",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "告訴你。",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我也想要",
    "voice": "vo_adv_2114099_063",
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "知道更多更多，",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "關於騎士先生的事情。",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "因為我在此之前，",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "都只能遠遠地觀望著你。",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "今後，",
    "voice": "vo_adv_2114099_064",
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "我可以更加深入地……",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "與你接觸。",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "連同身上的每一根汗毛，",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "甚至是肉體和靈魂資訊的，",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "每一個位元組……",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "來，",
    "voice": "vo_adv_2114099_065",
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "騎士先生。",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "拜託你。",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "和我",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "一起──",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "將理想鄉給，",
    "voice": null,
    "unit_id": 129013
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "關閉起來吧？",
    "voice": null,
    "unit_id": 129013
  },
