    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我向步未請教了暗中觀察別人的訣竅，",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n但好像不管用呢～～",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "不過，",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "能被哥哥發現也有點開心……",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "欸嘿嘿。",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "沒錯！",
    "voice": "vo_adv_6042103_002",
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "要是我",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "也像步未一樣，",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "擁有能偷偷觀察別人的能力，",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "不就能知道哥哥的更多事情了嗎～！",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "雖然是這麼想，",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "但我果然還是比較適合",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "更直接地碰撞交流呢！",
    "voice": null,
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "唔唔，",
    "voice": "vo_adv_6042103_003",
    "unit_id": 112912
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "和哥哥對到眼了！？",
    "voice": null,
    "unit_id": 112912
  },
