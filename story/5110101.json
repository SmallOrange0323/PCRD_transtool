  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "一片祥和的蘭德索爾",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n國內各地正在進行建國慶典的準備。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "很棒耶──",
    "voice": "vo_adv_5110101_000",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "慶典準備得很順利。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "明明慶典還沒開始，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我的心臟已經開始砰砰跳了☆",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "更重要的是",
    "voice": "vo_adv_5110101_001",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "城鎮的大家都帶著笑容進行準備作業，真令人感到開心。",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "希望下一年，",
    "voice": "vo_adv_5110101_002",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "然後再下一年",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "都可以像這樣慶祝，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我想把這份和平與未來聯繫起來☆",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "哼哼～♪",
    "voice": "vo_adv_5110101_003",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "哼哼哼～♪",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "怎麼回事，祈梨，",
    "voice": "vo_adv_5110101_004",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "妳看起來很開心嘛。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這麼喜歡佈置工作的話，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "也把我的部分弄一弄吧。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "啊？",
    "voice": "vo_adv_5110101_005",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "別開玩笑了！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我才不是因為工作才這麼開心呢。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我是對建國慶典期待到不能自已！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "畢竟",
    "voice": "vo_adv_5110101_006",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "可以看到慈樂之音的特別演唱會喔？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "只要想到這個，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "就算是麻煩的工作都能開心面對了。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "慈樂之音……",
    "voice": "vo_adv_5110101_007",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "啊，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "偶像嗎。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "反正",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "只要祈梨肯好好工作，原因不重要。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "和平的慶典似乎無法期待有熱血沸騰架能打啊。",
    "voice": "vo_adv_5110101_008",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我就加減享受慶典吧。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "background",
    "bg_id": "500583"
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "──嗯，",
    "voice": "vo_adv_5110101_009",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "感覺很不錯。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "妳們兩個看起來都幹勁十足呢。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是的，",
    "voice": "vo_adv_5110101_010",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "因為是久違的演唱會。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "不是為了戰鬥，",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "而是為了粉絲唱歌，",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "真的很令人期待。",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我們為這次演唱會",
    "voice": "vo_adv_5110101_011",
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "好好地練習過了，",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n也會好好地讓觀眾樂在其中喔！",
    "voice": null,
    "unit_id": 105411
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "也是呢，",
    "voice": "vo_adv_5110101_012",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "為了回應大家的等待，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n我們得盡情地為大家帶來歡樂♪",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那麼，",
    "voice": "vo_adv_5110101_013",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我們就帶著這股幹勁",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "再努力一下吧。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "做好充分的準備，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "呈現最棒的演唱會囉！",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "怎麼回事？",
    "voice": "vo_adv_5110101_014",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "街道上的大家看起來都很忙碌？",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "……",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "原來是在準備慶典啊！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n能夠舉行慶典，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "意味著現在很和平呢！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "不過，",
    "voice": "vo_adv_5110101_015",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "在和平的背面，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n總會有三流壞蛋",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "企圖偷偷做卑鄙的壞事！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "作為大壞蛋",
    "voice": "vo_adv_5110101_016",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "才不會放過這種人！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "這時候就要爽快地大鬧一頓，",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "揍扁他們！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "嘉夜、矛依未、望",
    "words": "下回，",
    "voice": "vo_adv_5110101_017",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "嘉夜、矛依未、望",
    "words": "「解放自由的伊甸園　",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "嘉夜、矛依未、望",
    "words": "有朝一日",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "嘉夜、矛依未、望",
    "words": "重逢的未來」。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "妨礙慶典的三流壞蛋，",
    "voice": "vo_adv_5110101_018",
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我會讓你變成劍上的鏽斑！",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 106113
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "哈──哈哈哈哈！！",
    "voice": null,
    "unit_id": 106113
  }
]
