[
  {
    "type": "dialogue",
    "name": "華音",
    "words": "庶民雜碎成群結隊地冒出來了呢。",
    "voice": "vo_adv_5205321_000",
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "不過，",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "就這點程度難道以為能贏過本小姐嗎？",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n愚蠢過頭甚至有點可憐了──",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "不要啊啊啊啊啊！？",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "啊～",
    "voice": "vo_adv_5205321_001",
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "遭到集中攻擊了呢。",
    "voice": null,
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "不過這樣正好，",
    "voice": null,
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "前衛就交給華音負責，",
    "voice": null,
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "趁這個機會一網打盡吧！",
    "voice": null,
    "unit_id": 134811
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "先來",
    "voice": "vo_adv_5205321_002",
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "救救本小姐啊！？",
    "voice": null,
    "unit_id": 134911
