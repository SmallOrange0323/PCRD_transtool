    "type": "dialogue",
    "name": "米亞",
    "words": "「魔卡決鬥」嗎～？",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n這是在吉歐‧格黑納的小孩子們之間流行的遊戲，",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "是一種把魔物",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "抓進那張魔卡中，",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "並讓它們戰鬥的嶄新遊戲～",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "還真像庶民的小鬼們會喜歡的遊戲。",
    "voice": "vo_adv_5205000_042",
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n那種板子算什麼？",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "比起那個，",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "還不如趕快離開這裡獲得自由……",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "我可什麼都沒說哦～",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "我們改良了刻在那張魔卡上的符文魔法～",
    "voice": "vo_adv_5205000_043",
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n現在連魔物以外的東西也能收納進去了～",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "……咦？",
    "voice": "vo_adv_5205000_044",
    "unit_id": 134912
  },
  {
    "type": "background",
    "bg_id": "502170"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "──呵呵，",
    "voice": "vo_adv_5205000_045",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "對於那種蠢蛋，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "縱然騎士閣下身為英雄，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "恐怕也會傷透腦筋吧。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n因此奴家才準備了合適的項圈。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "在方才之搔癢中，",
    "voice": "vo_adv_5205000_046",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n已施加詛咒於",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "華音這傢伙身上。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n而後僅要以魔卡相對，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "如此唸誦──",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "給我等一下！？",
    "voice": "vo_adv_5205000_047",
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n我可沒聽說過那種事啊！",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n被關進那種板子什麼的我可敬謝不敏──",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "──啊啊啊啊啊啊啊啊啊啊！",
    "voice": "vo_adv_5205000_048",
    "unit_id": 134912
  },
  {
    "type": "still",
    "still_id": "520500004"
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "改良後的符文魔法",
    "voice": "vo_adv_5205000_049",
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "正常啟動了～",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "這次試著把她放出來看看～",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "still",
    "still_id": "520500003"
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "到～～～～～～～底在搞什麼啊！？",
    "voice": "vo_adv_5205000_050",
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n竟敢把本小姐像碗蕎麥麵一樣吸進──",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "still",
    "still_id": "520500004"
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "──呀啊啊啊啊啊！？",
    "voice": "vo_adv_5205000_051",
    "unit_id": 134912
  },
  {
    "type": "still",
    "still_id": "520500003"
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "把我令人感激的話語聽到最後啊你這笨貓笨馬！",
    "voice": "vo_adv_5205000_052",
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n別像個笨蛋一樣只會那一招地吸啊吐啊！",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "still",
    "still_id": "520500005"
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "你是不是有點玩得太開心了啊啊啊啊啊啊啊啊啊！？",
    "voice": "vo_adv_5205000_053",
    "unit_id": 134912
  },
  {
    "type": "background",
    "bg_id": "502170"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "甚好甚好，",
    "voice": "vo_adv_5205000_054",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "效果立竿見影。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "那麼騎士閣下，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "請盡情",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "使喚這傢伙吧。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "再這樣下去，",
    "voice": "vo_adv_5205000_055",
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "高貴的我",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "真的",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "要成為奴隸了……！",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "我絕不原諒",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "涅妃‧涅羅……",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "不過，",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "反正對象是",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "阿貓阿馬，",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n我只要",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "先把那張",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "魔卡搶過來就好！",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "沒",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "問題的！　",
    "voice": null,
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "啊，",
    "voice": "vo_adv_5205000_056",
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "騎士閣下先生～",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n保險起見，",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "我也把備用的",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "魔卡交給你哦～",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "開什麼玩笑啊！？",
    "voice": "vo_adv_5205000_057",
    "unit_id": 134912
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就這樣，{0}獲得了華音與魔卡，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n邁向了某個陰謀翻湧的吉歐‧格黑納大地。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n而對抗那企圖的",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
