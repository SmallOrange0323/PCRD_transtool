    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我一定",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "會去救妳的。",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "怜大人……！",
    "voice": "vo_adv_5205000_059",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "那我們走吧。",
    "voice": "vo_adv_5205000_060",
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n……",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "話說回來，",
    "voice": null,
    "unit_id": 134812
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我還沒有問妳的名字吧？",
    "voice": null,
    "unit_id": 134812
  },
