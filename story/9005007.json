  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "雪菲覺得在街上已經收集不到更多情報了，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n於是來到某個地方拜訪友人。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "原來如此，",
    "voice": "vo_adv_9005007_000",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "送給那傢伙的禮物啊。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n找上妾身是很正確的判斷。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "畢竟妾身乃是",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "那傢伙的主人嘛！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "哈～哈哈哈！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "除了伊莉亞小姐以外，",
    "voice": "vo_adv_9005007_001",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n我也想要聽聽【惡魔偽王國軍】",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "的大家",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "有什麼想法。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "送布丁喲。",
    "voice": "vo_adv_9005007_002",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "雖然很開心妳會來問我們……",
    "voice": "vo_adv_9005007_003",
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "但那傢伙喜歡",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "的東西……",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我才",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "更想知道呢……",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "啊，",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "對了。",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "忍可以",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "用占卜來找答案吧？",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "送布丁喲。",
    "voice": "vo_adv_9005007_004",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "當然可以……",
    "voice": "vo_adv_9005007_005",
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "換作平時",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我或許會這麼說，",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "但這個問題還是別用占卜為妙吧。",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n靠著一個憑空冒出來的答案去準備禮物，",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這麼做毫無意義。",
    "voice": null,
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "送布丁喲。",
    "voice": "vo_adv_9005007_006",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "如果是茜里的話，",
    "voice": "vo_adv_9005007_007",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "應該會送親手做的貼身衣物。",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "然後茜里自己",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "也穿同款的♪",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "在看不見的地方穿著同樣的東西，",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "真令人臉紅心跳～♪",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "送～",
    "voice": "vo_adv_9005007_008",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "布～",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "丁～",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "喲",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n為什麼要無視人家來的！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "送禮就是要送布丁！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "就決定送一個比山跟海都要大的布丁喲！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "因為宮子肯定會說布丁啊……",
    "voice": "vo_adv_9005007_009",
    "unit_id": 103113
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "問也是白問……",
    "voice": "vo_adv_9005007_010",
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "對吧？",
    "voice": null,
    "unit_id": 102212
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "嗯……",
    "voice": "vo_adv_9005007_011",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "除了布丁之外還有什麼提議嗎？",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "沒有喲。",
    "voice": "vo_adv_9005007_012",
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n只要有布丁就行了。",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "來，",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "趕緊給宮子布丁喲！",
    "voice": null,
    "unit_id": 100711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "宮子呀……",
    "voice": "vo_adv_9005007_013",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "現在是在討論要送什麼給那傢伙耶……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "呵呵。",
    "voice": "vo_adv_9005007_014",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "不過……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "要是大家都可以像宮子小姐這樣，",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n給我一個",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "簡單明瞭的答案",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "就好了。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯……",
    "voice": "vo_adv_9005007_015",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這樣啊。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "雪菲呀。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "看來妳已經問過許多人的意見了，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n但一直這麼做有用嗎？",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "咦？",
    "voice": "vo_adv_9005007_016",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "咱們每個人跟那傢伙的交情",
    "voice": "vo_adv_9005007_017",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "各有不同，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "對於他喜歡什麼、",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不喜歡什麼",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "也各有各的見解才是。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妳問到了那麼多意見，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "可有找到哪個滿意的答案嗎？",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "伊莉亞小姐……！",
    "voice": "vo_adv_9005007_018",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "謝謝妳……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "或許我",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "一直都弄錯努力的方向了。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "哈哈哈！",
    "voice": "vo_adv_9005007_019",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n儘管感謝妾身、",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "尊敬妾身吧！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妳要是願意的話，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身也可以將妳收為部下喔？",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "不，",
    "voice": "vo_adv_9005007_020",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "這就免了……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "聽了伊莉亞的建議，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n雪菲重新調整思考方向。",
    "voice": null,
    "unit_id": null
  }
]
