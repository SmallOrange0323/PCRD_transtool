  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "打開包裝",
    "voice": "vo_adv_4010214_000",
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "……",
    "voice": null,
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "啊，",
    "voice": null,
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "中獎了。",
    "voice": null,
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "\\n",
    "voice": null,
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "又拿到一個點心了。",
    "voice": null,
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "\\n太好了。",
    "voice": null,
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "{0}氏。",
    "voice": "vo_adv_4010214_001",
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "\\n我好像",
    "voice": null,
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "死過之後就覺醒了。",
    "voice": null,
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "\\n",
    "voice": null,
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "獲得了找出中獎的懷舊點心的能力──",
    "voice": null,
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "當然是開玩笑的。",
    "voice": "vo_adv_4010214_002",
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "\\n",
    "voice": null,
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "不過，",
    "voice": null,
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "應該是生日運氣比較好吧。",
    "voice": null,
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "\\n我可沒有變透明偷看喔。",
    "voice": null,
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "那太不解風情了。",
    "voice": null,
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "話說回來。",
    "voice": "vo_adv_4010214_003",
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "\\n居然帶今天的主角到懷舊點心店，",
    "voice": null,
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "\\n你的品味還真特別，",
    "voice": null,
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "{0}氏。",
    "voice": null,
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "我",
    "voice": "vo_adv_4010214_004",
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "再怎麼說都是成人女性喔。",
    "voice": null,
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "\\n",
    "voice": null,
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "不過我玩得很開心",
    "voice": null,
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "所以也沒關係就是了。",
    "voice": null,
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "\\n",
    "voice": null,
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "這個拉繩子抽糖果也很令人懷念。",
    "voice": null,
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "……原來如此。",
    "voice": "vo_adv_4010214_005",
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "\\n也就是說{0}氏",
    "voice": null,
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "是為了失去記憶的小飛白，",
    "voice": null,
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "\\n特地挑了這個地方？",
    "voice": null,
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "{0}氏。",
    "voice": "vo_adv_4010214_006",
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "\\n那真是──",
    "voice": null,
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "\\n",
    "voice": null,
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "很好的判斷。",
    "voice": null,
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "以前的事情，",
    "voice": "vo_adv_4010214_007",
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "雖然還想不起來。",
    "voice": null,
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "\\n",
    "voice": null,
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "但見到自己熟悉的東西，",
    "voice": null,
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "\\n老實說我有感到安心。",
    "voice": null,
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "沒想到會有這種出其不意的禮物，",
    "voice": "vo_adv_4010214_008",
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "\\n",
    "voice": null,
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "你果然",
    "voice": null,
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "很擅長泡妞呢。",
    "voice": null,
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "\\n",
    "voice": null,
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "啊啊，",
    "voice": null,
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "我也要被吃掉了。",
    "voice": null,
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "真有道理。",
    "voice": "vo_adv_4010214_009",
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "\\n",
    "voice": null,
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "……嗯，",
    "voice": null,
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "不開玩笑了。",
    "voice": null,
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "\\n畢竟是難得的禮物。",
    "voice": null,
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "謝謝你。",
    "voice": "vo_adv_4010214_010",
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "\\n",
    "voice": null,
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "沒想到，",
    "voice": null,
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "死掉之後還有機會被慶祝生日──",
    "voice": null,
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "剛好這裡",
    "voice": "vo_adv_4010214_011",
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "有兩個剛剛中獎的糖果。",
    "voice": null,
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "\\n我們分著吃，",
    "voice": null,
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "像小孩子一樣聊天吧。",
    "voice": null,
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "\\n",
    "voice": null,
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "給",
    "voice": null,
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "你，",
    "voice": null,
    "unit_id": 133031
  },
  {
    "type": "dialogue",
    "name": "飛白",
    "words": "啊──",
    "voice": null,
    "unit_id": 133031
  }
]
