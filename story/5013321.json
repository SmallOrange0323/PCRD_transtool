  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "……喝啊啊啊！！",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "巨靈",
    "words": "――咕喔喔喔喔！",
    "voice": null,
    "unit_id": 11211
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "唔！？",
    "voice": "vo_adv_5013321_002",
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "　什麼！",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "這隻巨靈……",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "\\n動作和之前的不一樣……！",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "真的呢……！",
    "voice": "vo_adv_5013321_003",
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n當他處於防禦狀態時，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "最好不要貿然出手攻擊……！",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "\\n",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "否則說不定會遭到反擊……！？",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "嗯，",
    "voice": "vo_adv_5013321_004",
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "我知道了！",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "\\n抓準時機，",
    "voice": null,
    "unit_id": 109411
  },
  {
    "type": "dialogue",
    "name": "古蕾婭",
    "words": "一口氣進行連環攻擊吧！",
    "voice": null,
    "unit_id": 109411
  }
