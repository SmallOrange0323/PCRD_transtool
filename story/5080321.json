[
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "怎麼回事！？",
    "voice": "vo_adv_5080321_000",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n出現了和我們長的一模一樣的人！？",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子的布丁是宮子的！",
    "voice": "vo_adv_5080321_001",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n拿走宮子布丁的傢伙才不是宮子呢！",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "雖然聽起來十分哲學，",
    "voice": "vo_adv_5080321_002",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "但其實宮子並沒有深入思考太多吧……",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子有在思考！",
    "voice": "vo_adv_5080321_003",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n只要打倒那些傢伙，",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "布丁就全都是宮子的了喲！",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "啊哈哈，",
    "voice": "vo_adv_5080321_004",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "果然沒有我們的份呢。",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我已經習慣啦。",
    "voice": "vo_adv_5080321_005",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "那麼，",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "為了宮子的布丁，",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n我們再努力一下吧！",
    "voice": null,
    "unit_id": 119211
  }
]
