[
  {
    "type": "background",
    "bg_id": "509001"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "鳳凰與{0}",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "因為某個理由，\\n而從吉歐‧格黑納來到了蘭德索爾附近的農村──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "咿～～～～～～～～～！！",
    "voice": "vo_adv_1347001_000",
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "農民1",
    "words": "受死吧啊啊啊啊啊啊！！",
    "voice": "vo_adv_1347001_001",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "為什麼～～",
    "voice": "vo_adv_1347001_002",
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "為什麼偏偏是我遇上這種事────！？",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "農民1",
    "words": "蠢貨！",
    "voice": "vo_adv_1347001_003",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "農民1",
    "words": "那個雞屁股",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "農民1",
    "words": "逃去哪啦！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "農民2",
    "words": "不對，",
    "voice": "vo_adv_1347001_004",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "農民2",
    "words": "是雞翅！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "農民３",
    "words": "雞胸軟骨！",
    "voice": "vo_adv_1347001_005",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "唔唔唔唔唔，",
    "voice": "vo_adv_1347001_006",
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "竟然用雞的",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "可食用部位名稱來稱呼作為神的我，",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n何等不敬……！",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "話說！",
    "voice": "vo_adv_1347001_007",
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n我明明是要在這個世界的農村享用好吃的米才對，",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n為什麼事情會變成這樣啊啊啊！",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "background",
    "bg_id": "501660"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "事情要回溯至",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "昨天在吉歐‧提格尼亞所發生的事件──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "唔唔唔……",
    "voice": "vo_adv_1347001_008",
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "唉，",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n果然",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "好像無法變成人類的樣子……",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n明明",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "貪吃佩可已經幫我取回一部分權能了……",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "那個超巨大的人偶……",
    "voice": "vo_adv_1347001_009",
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "巨、",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "巨型？",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "巨型的克蘿茜，我似乎把力量全都用來搬運她了。",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n雖然還能正常說話……",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "真是的！",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "不論我是個多麼莊嚴、優雅且可靠的神，",
    "voice": "vo_adv_1347001_010",
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n盡是被捲入麻煩事，我會很困擾的！",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n我可不會再上人類花言巧語的當了！",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "你又來了，",
    "voice": "vo_adv_1347001_011",
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "我才剛說完，你又講那種表面好聽的話……",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "咳咳。",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "算了，",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "要是想獻上供品，",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "那我就鄭重接受吧，",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "畢竟我肚子也餓了。",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "我想想……",
    "voice": "vo_adv_1347001_012",
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "吉歐‧提格尼亞的甜食雖然也不賴，",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n但既然要吃，",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "我想要更能填飽肚子的東西……",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "對了，",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "米！",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "我想吃米飯！",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "以前",
    "voice": "vo_adv_1347001_013",
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "真陽請我吃的米，",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n那還真是相當好吃呢。",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n……",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "雖然我不能接受她把我當成小雞就是了。",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "這就是所謂的事不宜遲吧。",
    "voice": "vo_adv_1347001_014",
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "你的心態值得嘉許♪",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n那麼騎士先生，",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "我賜予你把我放在肩上走的權利！",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n啾啾～♪",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "background",
    "bg_id": "509001"
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "真是相當恬靜的地方呢。",
    "voice": "vo_adv_1347001_015",
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n農田裡金黃色的稻穗結實纍纍……",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "呵呵呵，",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "彷彿就像在等待我一樣啊！",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "就、",
    "voice": "vo_adv_1347001_016",
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "就算是生米我也無所謂了！",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n趕快",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "請那邊的農民把米分給我們吧！",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "農民1",
    "words": "……啥？",
    "voice": "vo_adv_1347001_017",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "農民1",
    "words": "你們有什麼事？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "我是",
    "voice": "vo_adv_1347001_018",
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "鳳凰，",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "是偉大的神鳥！",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n我就賜予你們",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "向我獻上米的權利吧！",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "你們該感到榮幸……",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "農民1",
    "words": "你這",
    "voice": "vo_adv_1347001_019",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "農民1",
    "words": "害鳥！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "農民1",
    "words": "\\n是盯上咱們好不容易",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "農民1",
    "words": "才種好的稻子嗎！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "農民1",
    "words": "\\n大夥！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "農民1",
    "words": "有害鳥──！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "農民1",
    "words": "快出來快出來！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "害害害害",
    "voice": "vo_adv_1347001_020",
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "害鳥？",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "不、",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "不敬也要有個限度啊！",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n你沒看見這不染塵垢的美麗羽毛嗎？",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n這是作為神的……",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "呀──！",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "鋤頭！",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "不要用鋤頭啊──！",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "農民1",
    "words": "什麼？",
    "voice": "vo_adv_1347001_021",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "農民1",
    "words": "那不是麻雀嗎！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "農民2",
    "words": "因為牠一臉渴望地",
    "voice": "vo_adv_1347001_022",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "農民2",
    "words": "看著咱們的稻子，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "農民2",
    "words": "\\n咱還以為是哪種害鳥啊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "我、",
    "voice": "vo_adv_1347001_023",
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "我才沒有露出那種眼神啦～！",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n雖、",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "雖然",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "肚子確實有點餓了……",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "農民３",
    "words": "那你早說啦？",
    "voice": "vo_adv_1347001_024",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "農民３",
    "words": "\\n白飯的話咱們多～的是啦！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "農民３",
    "words": "給你！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "哇哇，",
    "voice": "vo_adv_1347001_025",
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "在碗裡堆得像山一樣的白飯……！",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n咳咳。",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "明白了就好！",
    "voice": null,
    "unit_id": 134713
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
