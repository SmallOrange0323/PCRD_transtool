[
  {
    "type": "background",
    "bg_id": "500361"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "自從{0}一行人開始使用公會之家後，\\n又經過了一段時間。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "果然，很令人在意呢。",
    "voice": "vo_adv_4001002_000",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "咦，什麼？",
    "voice": "vo_adv_4001002_001",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我我我、我可沒有在想什麼詭計之類的喔？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我跟你們是同一個公會的夥伴呢，對吧可蘿仔！？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "啊……",
    "voice": "vo_adv_4001002_002",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n凱留小姐不好意思，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在下已經說過很多次了，請不要稱呼在下為可蘿仔。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "最近連主人也開始仿效，",
    "voice": "vo_adv_4001002_003",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n稱呼在下為可蘿仔了呢。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請好好地用充滿感情的口吻，",
    "voice": "vo_adv_4001002_004",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "稱呼在下",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "可可蘿……♪",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我們是不是離題了呀？",
    "voice": "vo_adv_4001002_005",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "妳注意到什麼地方了嗎～",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n小可蘿？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是的。",
    "voice": "vo_adv_4001002_006",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n在下等精靈族，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n是聽力優越的種族。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下是覺得樓上，",
    "voice": "vo_adv_4001002_007",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n好像有些可疑的聲音。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "有點像是怪物的呻吟……",
    "voice": "vo_adv_4001002_008",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是不是在下的錯覺呢？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗯～……",
    "voice": "vo_adv_4001002_009",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "在意的話，要不要去看看？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "咦，小凱留不可以啦！",
    "voice": "vo_adv_4001002_010",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "樓上是禁止使用的，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n【公會管理協會】的花凜小姐不是才交代過嗎？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗯～……",
    "voice": "vo_adv_4001002_011",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n那傢伙似乎也在微妙地隱瞞些什麼事情，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "總覺得怪怪的呢。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "明明其他的事情都很親切地應對，",
    "voice": "vo_adv_4001002_012",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n不知怎的就硬是不想讓我們到樓上去。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我感覺這肯定有什麼，就在樓上。",
    "voice": "vo_adv_4001002_013",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "去調查一下吧！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "要是什麼問題都沒有的話，",
    "voice": "vo_adv_4001002_014",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n二樓也可以作為我們的聚會地點。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "一樓已經變得非常侷促，",
    "voice": "vo_adv_4001002_015",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "要是上面的樓層能用的話不是很方便嗎？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "雖然妳說的也沒錯啦～",
    "voice": "vo_adv_4001002_016",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n不過得先取得花凜小姐的許可才行啦～",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "要是我們違反規定的話，",
    "voice": "vo_adv_4001002_017",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n有可能會被趕出這個公會之家耶？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "只是稍微看一眼而已啦。",
    "voice": "vo_adv_4001002_018",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "之後只要道個歉就會原諒我們了不是嗎，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "而且花凜看起來像個大好人。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "就因為她是個好人，",
    "voice": "vo_adv_4001002_019",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n所以才不能造成人家的困擾呀～……？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "沒關係啦，",
    "voice": "vo_adv_4001002_020",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "責任就由我來承擔。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "花凜那傢伙，",
    "voice": "vo_adv_4001002_021",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n剛好出去買東西不在家呢……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "趁現在把所有疑點都追根究底弄個明白吧！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "事實上確實，",
    "voice": "vo_adv_4001002_022",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我感受到樓上傳來了不安定的魔力……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "叫人坐立難安，感到憂心呢。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "在我的地盤裡，",
    "voice": "vo_adv_4001002_023",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n有自己未能掌握的部分存在，真叫人無法忍受啊。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "唔……？",
    "voice": "vo_adv_4001002_024",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "通往二樓的樓梯，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n被相當強大的力量封鎖住了呢。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "但只要我出手的話，這種程度的封印，",
    "voice": "vo_adv_4001002_025",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n輕而易舉就可以突破了喔！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "呵呵～♪",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊～",
    "voice": "vo_adv_4001002_026",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小凱留！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我就說不行了嘛！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不要緊的吧。",
    "voice": "vo_adv_4001002_027",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "畢竟在主人周圍，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n好像也環繞著異常恐怖的陰謀呢。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "不對。",
    "voice": "vo_adv_4001002_028",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n看來這或許，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就是主人所背負的命運。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "也因此。",
    "voice": "vo_adv_4001002_029",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n不安的種子，應該要盡快去除才是。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下認為，",
    "voice": "vo_adv_4001002_030",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "因為一些理由被綁手綁腳，進而失去了重要的事物，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "之後再來後悔的話就太遲了。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "凱留小姐，在下來幫助您解除封印。",
    "voice": "vo_adv_4001002_031",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n即便是在下，也是有兩把刷子的。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "哎唷～連小可蘿都這麼說……",
    "voice": "vo_adv_4001002_032",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嗚嗚～……",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這樣如果只有我在這邊假正經、",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n不一起同流合汙的話就太沒人情味了對吧？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "大家都是同一個公會的夥伴，是牽一髮而動全身的～",
    "voice": "vo_adv_4001002_033",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "該、該怎麼辦呢……{0}？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我的確也很在意樓上有什麼東西，",
    "voice": "vo_adv_4001002_034",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我們也一起協助小凱留……",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嗚呀！？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "各位？",
    "voice": "vo_adv_4001002_035",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n是在做什麼呢？",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "咦咦，",
    "voice": "vo_adv_4001002_036",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "花凜！？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n妳回來了呀！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不不不、",
    "voice": "vo_adv_4001002_037",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不是那樣喔！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "因為上面的樓層傳來了奇怪的聲音，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "讓人在意……！？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "呵呵。",
    "voice": "vo_adv_4001002_038",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "會有疑問是理所當然的，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n不過各位擅自行動的話會讓我很困擾。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "至少請與我商量一下，",
    "voice": "vo_adv_4001002_039",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我又不會生氣………",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n因為我能理解各位的心情。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "雖然我也被上司嚴格警告，",
    "voice": "vo_adv_4001002_040",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n而不能詳細說明……",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "因為上面的樓層，有點危險。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "話說回來。",
    "voice": "vo_adv_4001002_041",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n這棟建築，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n本來就是不屬於任何人的空屋。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "所以，有幸被國家接收……",
    "voice": "vo_adv_4001002_042",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n並且賜給了我們【公會管理協會】。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "另外就是。",
    "voice": "vo_adv_4001002_043",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "前往上層階梯的封印，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n是在我們管理這棟建築物的一開始就存在了。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "是為了封印什麼，",
    "voice": "vo_adv_4001002_044",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n樓上到底藏著什麼………",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n老實說，我們也不清楚。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "但只要不觸摸到封印，",
    "voice": "vo_adv_4001002_045",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n是不會有什麼問題的。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "呵呵。",
    "voice": "vo_adv_4001002_046",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n因為是這樣有點可疑的房子，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "所以才會租給像各位這樣來歷不明的公會。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "喔～我就想說這麼豪華的建築物怎麼會借給我們……",
    "voice": "vo_adv_4001002_047",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "果然～這就是所謂的有問題的房子吧～",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "天下真的沒有白吃的午餐呢～我就知道～",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "呵呵。",
    "voice": "vo_adv_4001002_048",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "很抱歉一直瞞著各位，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n我在一開始說明清楚的話就好了。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "只是因為，",
    "voice": "vo_adv_4001002_049",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n還不知道各位是不是能信任的對象。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我是打算，",
    "voice": "vo_adv_4001002_050",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n找時機擇日再說明的。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這也沒辦法嘛～",
    "voice": "vo_adv_4001002_051",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n畢竟花凜小姐是公務員！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "妳也無法違抗上司跟國家的命令吧～",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "妳現在能夠好好地跟我們說明，",
    "voice": "vo_adv_4001002_052",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我們就感激不盡了喔～",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "很感謝各位能理解～。",
    "voice": "vo_adv_4001002_053",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "所以說呢……非常抱歉，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n請千萬別觸碰封印。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "被封印的有可能，",
    "voice": "vo_adv_4001002_054",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n是兇狠的魔物之類的。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊不好意思，已經太晚了。",
    "voice": "vo_adv_4001002_055",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n因為封印，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "早就被我輕鬆解除了。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "咦～偏偏這時候手腳那麼快……！？",
    "voice": "vo_adv_4001002_056",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小凱留妳要小心喔！",
    "voice": "vo_adv_4001002_057",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n搞不好會有危險的魔物衝出來！？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗯～？",
    "voice": "vo_adv_4001002_058",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n可是乍看之下根本沒有什麼魔物存在啊？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "話說回來，",
    "voice": "vo_adv_4001002_059",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n二樓完全沒有任何顯眼的東西耶。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n就是空無一物的感覺。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "咦，不該是這樣的……？",
    "voice": "vo_adv_4001002_060",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "很抱歉，請讓我也看一下！",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "background",
    "bg_id": "500362"
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "是真的呢……",
    "voice": "vo_adv_4001002_061",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n雖然隨著時間變的老舊又有點髒亂，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n但看起來只是個普通的房間。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "當然也沒有封印著，",
    "voice": "vo_adv_4001002_062",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n什麼凶狠魔物的樣子。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "嗯？",
    "voice": "vo_adv_4001002_063",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這樣的話～為什麼這裡會被封印住呢？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "啊……",
    "voice": "vo_adv_4001002_064",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "各位請看，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n牆壁上畫著魔法陣呢。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗯嗯。",
    "voice": "vo_adv_4001002_065",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這是空間轉移的魔法陣呢。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n它能一瞬間就把對象轉移到遠方去……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "要是被用在軍事用途上的話會十分危險，",
    "voice": "vo_adv_4001002_066",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n所以這是被國際條約列為禁止使用的魔法喔！",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "唔～……",
    "voice": "vo_adv_4001002_067",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不行呢，這好像是用過一次就會失效的魔法陣。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n發動過一次之後，魔法迴路就會溶解。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "即使注入魔力還是無法啟動呀，",
    "voice": "vo_adv_4001002_068",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n也不知道這到底是跟哪裡聯繫著……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這已經單純是一幅牆上的塗鴉了。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "嗯。",
    "voice": "vo_adv_4001002_069",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "所以可以推測，被封印在這裡的魔物還是什麼的，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n利用了空間轉移魔法之類的逃出去了……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這裡有生活過的跡象。",
    "voice": "vo_adv_4001002_070",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n確實是有「什麼」曾經在這裡生活過，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n可能在很久以前就已經離開了吧。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "呼，真讓人泄氣呢。",
    "voice": "vo_adv_4001002_071",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "【公會管理協會】也不覺得丟人現眼嗎，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n一直為了空盪盪的箱子而戰戰兢兢的過度警戒呢。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "呵呵。",
    "voice": "vo_adv_4001002_072",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "只要沒有危險的魔物的話，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n什麼都沒關係囉。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "看起來只要四處整修一下，",
    "voice": "vo_adv_4001002_073",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n似乎就可以當作普通的房間使用……",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我去請業者來施工，",
    "voice": "vo_adv_4001002_074",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n讓他們整修成像一樓般可以便利地使用。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "由於造成各位的不安，",
    "voice": "vo_adv_4001002_075",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n作為補償就由【公會管理協會】來支付工程費用。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊，真是慷慨呢。",
    "voice": "vo_adv_4001002_076",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗯嗯，憂慮也一掃而空，二樓也開放了……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n結果是皆大歡喜呢，可喜可賀～♪",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那個～我突然想到一個問題……",
    "voice": "vo_adv_4001002_077",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "既然二樓是沒有任何東西的空房間，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n那為什麼剛剛樓上會傳來奇怪的聲音呢？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……是三樓吧～",
    "voice": "vo_adv_4001002_078",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "啊……",
    "voice": "vo_adv_4001002_079",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n通往三樓的樓梯，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n也被下了封印呢。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "而且有聲響的話，",
    "voice": "vo_adv_4001002_080",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n表示三樓恐怕不是空房間吧。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "也就是說，跟被封印在二樓的一樣，",
    "voice": "vo_adv_4001002_081",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n現在三樓很有可能也有著「什麼」……是吧？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "嗯。被封印在三樓的東西，",
    "voice": "vo_adv_4001002_082",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "跟曾經被封印在二樓的「什麼」究竟是同等級的，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n還是更加高等級的存在……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這有點不妙呢。",
    "voice": "vo_adv_4001002_083",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n空間轉移是禁術，而且是高等魔法喔。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "能畫出魔法陣，",
    "voice": "vo_adv_4001002_084",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n代表可能是高等智力的強大魔物或者其他什麼的。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不小心惹牠發怒的話，",
    "voice": "vo_adv_4001002_085",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n大概會造成一個小村子被毀滅之類的吧。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "對於通往三樓樓梯的封印，",
    "voice": "vo_adv_4001002_086",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n還是別輕率出手比較好吧。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "可是又很叫人在意呢～……",
    "voice": "vo_adv_4001002_087",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n被封印在這公會之家裡的，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n到底是什麼呢？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "有些來路不明的東西潛伏在上頭，",
    "voice": "vo_adv_4001002_088",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n根本沒辦法安穩的生活呢。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……",
    "voice": "vo_adv_4001002_089",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "三樓，我想另外擇日好好調查一下。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n當然，到時候我會徵求花凜的同意的。",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這棟公會之家待起來蠻舒適的……",
    "voice": "vo_adv_4001002_090",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我也不想因為違反規定而被人趕出去。",
    "voice": null,
    "unit_id": 106012
  }
]
