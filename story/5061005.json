[
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在牧場度過了安穩的日子後，莉瑪收到了一封通知。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "太好了……",
    "voice": "vo_adv_5061005_000",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "太好了，{0}！",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n我",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "通過最終選拔了！",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n啊啊，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "簡直像在做夢一樣。",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "距離我憧憬的舞會就只差一步了。",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "咦咦，",
    "voice": "vo_adv_5061005_001",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "真了不起呢！",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不對，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "你是為了工作的緣故吧？",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "不過，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我們都在課程中一起努力過來了，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n如果能一起出席舞會就太好了呢。",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "啊，",
    "voice": "vo_adv_5061005_002",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "也就是說",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "如果順利的話，就能在憧憬的舞會中，\\n跟{0}一起……",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "討厭，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我有點心跳加速了！",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "啊，",
    "voice": "vo_adv_5061005_003",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "沒、",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "沒事啦！",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "只不過是太高興了，所以有些興奮而已。",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "好了，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我們快點前往宅邸吧！",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "background",
    "bg_id": "501240"
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "我們已經恭候多時了。",
    "voice": "vo_adv_5061005_004",
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "……",
    "voice": "vo_adv_5061005_005",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "兩位好！",
    "voice": "vo_adv_5061005_006",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "羅伊德先生、",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "瑪莎小姐。",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "……那個，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "其他人還沒到嗎？",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "很遺憾，",
    "voice": "vo_adv_5061005_007",
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "從最終選拔脫穎而出的人，",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "就只有莉瑪小姐而已。",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "咦！？",
    "voice": "vo_adv_5061005_008",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "是、",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "這樣啊……",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我原本還想跟大家一起參加舞會的……",
    "voice": "vo_adv_5061005_009",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "既然如此，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我要連大家的份一起努力，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "絕對要出席舞會！　",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "莉瑪小姐，",
    "voice": "vo_adv_5061005_010",
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "您經由許多的課程，",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "\\n獲得了足以被稱作淑女的",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "美麗與光輝。",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "接著就只剩通過最終測驗了。",
    "voice": "vo_adv_5061005_011",
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "\\n只要通過測驗，",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "您就能正式地出席舞會──",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "……已經，",
    "voice": "vo_adv_5061005_012",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "夠了……",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "咦？",
    "voice": "vo_adv_5061005_013",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "羅伊德大人，",
    "voice": "vo_adv_5061005_014",
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "您說什麼……",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "這原本就是我的問題，",
    "voice": "vo_adv_5061005_015",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "\\n我不能讓無辜的女性陪我一起承擔！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "但、",
    "voice": "vo_adv_5061005_016",
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "但是那樣的話羅伊德大人會……",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "那無所謂，",
    "voice": "vo_adv_5061005_017",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "已經夠了。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "為了得救而不惜欺騙她們，這件事本身就是錯的。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "我會親自做個了斷。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "等、",
    "voice": "vo_adv_5061005_018",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "等一下！",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "您說欺騙我們",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "是",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "什麼意思……？",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "完全搞不懂是怎麼回事！",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "莉瑪小姐說得沒錯，",
    "voice": "vo_adv_5061005_019",
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n羅伊德先生，",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "能不能",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "也跟咱們說明白呢？",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "妳、",
    "voice": "vo_adv_5061005_020",
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "妳們幾位……",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "全都聽到了嗎？",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "畢竟她們是我們的學生嘛，",
    "voice": "vo_adv_5061005_021",
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n當然會在意結果呀。",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "但是，",
    "voice": "vo_adv_5061005_022",
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "這個結果實在讓人難以接受啊。",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n莉瑪被選上自然是沒話說，",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "不過，",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "其他的小姐們竟然全部都落選，這我可無法認同。",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "……",
    "voice": "vo_adv_5061005_023",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "吶，",
    "voice": "vo_adv_5061005_024",
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "能不能把真相",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "告訴我們？",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n要我教導大小姐們戰鬥技巧，",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "還有讓這傢伙擔任護衛，",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "這些事怎麼想都很可疑呢。",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "你們真的打算舉辦舞會嗎？",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "真步、",
    "voice": "vo_adv_5061005_025",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "真琴……",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n妳們兩人也不知道詳情嗎？",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "是啊，",
    "voice": "vo_adv_5061005_026",
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我跟公主受那邊那位瑪莎小姐所託，",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n負責擔任小姐們的課程講師，",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "還有",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "貴族的護衛。",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "先不論講師，",
    "voice": "vo_adv_5061005_027",
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "護衛的話",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "是人越多越好吧？",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "所以人家也邀請了王子先生",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "一起來哦。",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "這傢伙之所以一起接受課程，",
    "voice": "vo_adv_5061005_028",
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n則是因為在附近能夠迅速應對狀況。",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "真是的，",
    "voice": "vo_adv_5061005_029",
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "竟然邊工作邊享受，",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "還真有你的風格呢。",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "只不過，",
    "voice": "vo_adv_5061005_030",
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "關於",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "到底要從",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "什麼手中保護對象，",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "咱們也沒有聽說呢。",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n差不多可以告訴咱們了吧？",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "……",
    "voice": "vo_adv_5061005_031",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "我知道了，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "我就把一切都告訴你們吧。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "\\n其實……",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "我被某個人給盯上了。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "您說的，",
    "voice": "vo_adv_5061005_032",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "該不會是殺手，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "之類的……？",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "不，",
    "voice": "vo_adv_5061005_033",
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "盯上了羅伊德大人的，",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "是住在邊境的某個強大魔物。",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "是魔物啊……",
    "voice": "vo_adv_5061005_034",
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "但是",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "為什麼魔物要取貴族的命啊？",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "不，",
    "voice": "vo_adv_5061005_035",
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "她並不是要取羅伊德大人的命。",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "\\n那個魔物──",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "自稱為公主的魔物，",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "她的目標是羅伊德大人本身，",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "她似乎……",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "傾慕著羅伊德大人。",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "所謂的傾慕，",
    "voice": "vo_adv_5061005_036",
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "就是",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "愛慕著對方的意思，",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "也就是",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "迷上了對方哦～",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "莉瑪・真琴",
    "words": "咦……",
    "voice": "vo_adv_5061005_037",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "莉瑪・真琴",
    "words": "咦咦咦咦！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "公主好幾次出現於羅伊德大人面前，",
    "voice": "vo_adv_5061005_038",
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "逼迫大人與其訂婚。",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "不管怎麼拒絕她都一而再再而三地來訪，",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "而且每次",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "都輕易地就把",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "強壯的護衛們制服。",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "原本還以為只是個魔物，",
    "voice": "vo_adv_5061005_039",
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "卻非常棘手呢，",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n從各方面來說都是。",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "然後在不知第幾次的來襲時，",
    "voice": "vo_adv_5061005_040",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "公主這麼說了。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "「去找比妾身更美麗、",
    "voice": "vo_adv_5061005_041",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "更強大的女性過來，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n如果辦得到的話，我就放棄追求你。」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "501240"
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "原來如此呀～",
    "voice": "vo_adv_5061005_042",
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "所以",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "你們才會為此",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "而招集女孩子啊。",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "是的。",
    "voice": "vo_adv_5061005_043",
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "只是要美麗的話還好說，",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "但如果要比那個魔物更強大，",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "\\n那要找到符合條件的女性，",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "可不是件簡單的事。",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "於是",
    "voice": "vo_adv_5061005_044",
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "我們以邀請參加舞會的名義，",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "招集了許多女性。",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "\\n打算佯稱是課程，",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "來培育並選出",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "能與公主一戰的人。",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "……我本來",
    "voice": "vo_adv_5061005_045",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "就不想採取這個手段。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "這相當於以甜言蜜語來引誘她們，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "讓她們背負危險的使命。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "再加上隨著課程的進行，",
    "voice": "vo_adv_5061005_046",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "\\n在目睹了以莉瑪小姐為首的參加者們純粹、專一的模樣後，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "\\n到了這最後關頭，我已經不忍心再繼續欺騙各位了。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "對於隱瞞真相，",
    "voice": "vo_adv_5061005_047",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "並欺騙了你們這件事，我真的感到非常抱歉。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "但是要恨的話，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "請你們恨我一個人就好。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "都是因為我如此無能，",
    "voice": "vo_adv_5061005_048",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "才會讓瑪莎及其他家臣們，\\n必須擔任這種惹人厭的角色。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "他們都是為了我才會這麼做的。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "莉瑪小姐，",
    "voice": "vo_adv_5061005_049",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "還有真步小姐們也是，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "希望你們能從這件事收手。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "\\n因為像我這種人，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "沒有資格接受你們的保護……",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "羅伊德先生……",
    "voice": "vo_adv_5061005_050",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "嗯，",
    "voice": "vo_adv_5061005_051",
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "事前說明的確是不夠充分呢。",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "以結果而言，也確實是欺騙了小姐們。",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "不過，",
    "voice": "vo_adv_5061005_052",
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我們從一開始就是被僱來保護你的，",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "那些瑣碎的事根本無所謂。",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "要是這時候撤退，",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "可就有辱【哞哞自衛隊】的名號了。",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "沒問題吧？",
    "voice": "vo_adv_5061005_053",
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "公主。",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "就算妳不打算幫忙，",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我也要做到底哦？",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "沒問題哦，",
    "voice": "vo_adv_5061005_054",
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "人家",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "當然也要去。",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "因為真琴一個人的話，",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "搞不好會亂來呢。",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "妳們兩位……",
    "voice": "vo_adv_5061005_055",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "謝謝妳們。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我、",
    "voice": "vo_adv_5061005_056",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我也要去！",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "莉瑪小姐！？",
    "voice": "vo_adv_5061005_057",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "為什麼……",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "我明明欺騙了妳，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "\\n妳已經沒有必要",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "再為此去冒險了啊……！",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "事情居然有內幕，",
    "voice": "vo_adv_5061005_058",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "的確讓我有些受到打擊。",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n拚了命努力過來的大家，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "要是知道了事實，我想也會很難受吧。",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "但是",
    "voice": "vo_adv_5061005_059",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我對於在這裡接受的課程，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "並沒有絲毫的後悔。",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n畢竟多虧如此，才讓我接觸到了原以為一生都無緣的夢想世界，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n即使那只是暫時的事。",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "在這裡度過的日子，",
    "voice": "vo_adv_5061005_060",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "充滿了無可取代的璀璨光輝，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "所以，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "請讓我回報你吧。",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "而且，",
    "voice": "vo_adv_5061005_061",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "羅伊德先生和瑪莎小姐正感到痛苦不是嗎？",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n真正的淑女就應該對有困擾的人伸出援手，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "對吧？",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "莉瑪小姐……",
    "voice": "vo_adv_5061005_062",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "要說是交換條件也有點奇怪，",
    "voice": "vo_adv_5061005_063",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n不過為了參加課程的那些女孩著想，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n我希望你能照常舉辦舞會。",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我不想讓大家的努力白費，",
    "voice": "vo_adv_5061005_064",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n況且",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "照理來說，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "她們比我這種人還更適合參加舞會呢。",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "那、",
    "voice": "vo_adv_5061005_065",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "那倒是完全沒問題，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "不，",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "可是如果妳有個萬一的話……",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "沒問題的啦。",
    "voice": "vo_adv_5061005_066",
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "莉瑪她很強，",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "這點我可以掛保證。",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "而且",
    "voice": "vo_adv_5061005_067",
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "還有咱們在一起呢。",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "\\n【哞哞自衛隊】",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "可不是虛有其表哦。",
    "voice": null,
    "unit_id": 116011
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "各位……",
    "voice": "vo_adv_5061005_068",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "謝謝你們！",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "羅伊德大人，",
    "voice": "vo_adv_5061005_069",
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "瑪莎",
    "words": "就相信她們吧。",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "瑪莎……",
    "voice": "vo_adv_5061005_070",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "我明白了。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "羅伊德",
    "words": "但是請務必要平安無事地回來。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "好，",
    "voice": "vo_adv_5061005_071",
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "都談妥了吧。",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "這最後的重要任務，",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "讓我們確實地把它解決掉吧！",
    "voice": null,
    "unit_id": 115911
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "唉，",
    "voice": "vo_adv_5061005_072",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "原本還以為距離舞會只差一步了，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n結果竟然變成這種情況，真是太出乎我的意料了。",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "雖然是個非常辛苦的最終測驗，",
    "voice": "vo_adv_5061005_073",
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "\\n但是感覺只要跨越了這個難關，",
    "voice": null,
    "unit_id": 115812
  },
  {
    "type": "dialogue",
    "name": "莉瑪",
    "words": "我就能變成更加出色的女孩子呢！　",
    "voice": null,
    "unit_id": 115812
  }
]
