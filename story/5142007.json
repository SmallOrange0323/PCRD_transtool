[
  {
    "type": "background",
    "bg_id": "500790"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "既漫長又短暫的訓練期間也結束了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n而今天──本期新兵訓練所的受封儀式，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n則於王宮前舉行……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "各位。",
    "voice": "vo_adv_5142007_000",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這20天的訓練，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "辛苦你們了。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n雖然期間短暫，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "但此次訓練",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "想必使各位學到許多，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n並得到了更多力量吧……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "……呼～",
    "voice": "vo_adv_5142007_001",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n這一期因為惠理子的關係而一片混亂呢。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "終於結束了啊……",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "哎呀，",
    "voice": "vo_adv_5142007_002",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "真沒禮貌。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我可沒有製造什麼騷動。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "騙誰啊！",
    "voice": "vo_adv_5142007_003",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n妳知道妳害我有多麼擔心嗎……！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……咳咳。",
    "voice": "vo_adv_5142007_004",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "呃……！",
    "voice": "vo_adv_5142007_005",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "嗚嗚……",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "本期的新兵訓練所畢業生，",
    "voice": "vo_adv_5142007_006",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "共62名。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n在此",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "表揚結束所有訓練課程的各位。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我以【王宮騎士團】騎士團長之名，",
    "voice": "vo_adv_5142007_007",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n冊封各位為「騎士」。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "成績優秀者……",
    "voice": "vo_adv_5142007_008",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "請代表上前。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "……喔。",
    "voice": "vo_adv_5142007_009",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "終於要公布成績優秀者了啊。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "哼……",
    "voice": "vo_adv_5142007_010",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我對拿不到的勳章",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "才沒有興趣。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "……哼，",
    "voice": "vo_adv_5142007_011",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "呵呵呵。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "真琴，",
    "voice": "vo_adv_5142007_012",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "妳是在笑什麼？",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "嘿嘿，",
    "voice": "vo_adv_5142007_013",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "沒什麼～",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n我只是感覺嚇人計畫進行得很順利，",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "所以很高興。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "什麼──？",
    "voice": "vo_adv_5142007_014",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "弗萊迪",
    "words": "是、",
    "voice": "vo_adv_5142007_015",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "弗萊迪",
    "words": "是的！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "弗萊迪",
    "words": "\\n我是本期首席，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "弗萊迪",
    "words": "弗萊迪！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "──！？",
    "voice": "vo_adv_5142007_016",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "是……",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "弗萊、",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "迪？",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "騎士弗萊迪。",
    "voice": "vo_adv_5142007_017",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我在此，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "授予你新兵訓練所",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "首席畢業徽章。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "恭喜你。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "弗萊迪",
    "words": "謝、",
    "voice": "vo_adv_5142007_018",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "弗萊迪",
    "words": "謝……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "弗萊迪",
    "words": "謝謝騎士團長！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "那、",
    "voice": "vo_adv_5142007_019",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "那是……",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n怎麼一回事……？",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "嘿嘿嘿……",
    "voice": "vo_adv_5142007_020",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "關於這點，",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "妳要不要直接去問問看騎士團長大人？",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "──接著，",
    "voice": "vo_adv_5142007_021",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "請這位新兵的指導教官上前。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "！",
    "voice": "vo_adv_5142007_022",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "在叫妳了！",
    "voice": "vo_adv_5142007_023",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "快去吧！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "好、",
    "voice": "vo_adv_5142007_024",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "好的……",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "騎士教官，",
    "voice": "vo_adv_5142007_025",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "惠理子。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n貴官",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "培育出了健壯且堅忍不拔的騎士，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n給予他們",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "許多的教導、傳授。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我在此……",
    "voice": "vo_adv_5142007_026",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "授予妳名譽教官勳章。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "來，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "收下吧。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "…………",
    "voice": "vo_adv_5142007_027",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……惠理子？",
    "voice": "vo_adv_5142007_028",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "妳不收下嗎？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "不、",
    "voice": "vo_adv_5142007_029",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "不……",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我要收下。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "非常感謝妳。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "不過……",
    "voice": "vo_adv_5142007_030",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "為什麼是我呢？",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "呵呵，",
    "voice": "vo_adv_5142007_031",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "那是因為……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我從真琴那裡聽說了妳的活躍表現啊。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "活躍表現，",
    "voice": "vo_adv_5142007_032",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "是嗎……？",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯。",
    "voice": "vo_adv_5142007_033",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "惠理子和新兵們早一步發現有魔物襲擊過來，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n而聯手擊退了魔物不是嗎？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "特別是那位名為弗萊迪的新兵……",
    "voice": "vo_adv_5142007_034",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "那位騎士，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我聽說多虧有他自願擔任誘餌，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "才使誘敵作戰成功的。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "其實騎士團",
    "voice": "vo_adv_5142007_035",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "也為了要怎麼處理那隻魔物而傷腦筋。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n這是多虧有妳的指揮，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "以及妳班上新兵們的強韌才能立下的功勞。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n呵呵，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "真的很謝謝妳。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "啊……",
    "voice": "vo_adv_5142007_036",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "是這樣嗎……",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "咳咳……",
    "voice": "vo_adv_5142007_037",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "那麼，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
