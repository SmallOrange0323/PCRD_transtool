    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "吾想讓你，",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "也來體驗一下吾的感覺。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "這就是，",
    "voice": "vo_adv_1328003_075",
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "由吾所贈送給你的聖誕禮物。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "看到這片夜景，",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "你有何想法？",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "still",
    "still_id": "132800302"
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "居然與神意有著相同感想，",
    "voice": "vo_adv_1328003_076",
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "還真是傲慢呢。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "真是不得了的氣量。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "呵。",
    "voice": "vo_adv_1328003_077",
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n真的是個，",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "不得了的傢伙……",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "能與你體驗同樣的感動，",
    "voice": "vo_adv_1328003_078",
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "吾很高興。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n果然，",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "兩個人比一個人好。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……跟吃飯一樣呢。",
    "voice": "vo_adv_1328003_079",
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……是嗎。",
    "voice": "vo_adv_1328003_080",
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "不過這是身為人會有的感覺。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n與天使不同。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "吾只是想與你共享這片景色，",
    "voice": "vo_adv_1328003_081",
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "很抱歉這樣勉強你。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "still",
    "still_id": "132800302"
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "呵呵……",
    "voice": "vo_adv_1328003_082",
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "別擔心，",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "你是不會掉下去的。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n有吾陪著你。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "吾跟你兩人，",
    "voice": "vo_adv_1328003_083",
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "在看著一樣的景色。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "現在，",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "這樣就夠了。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "雖然吾與你之間，",
    "voice": "vo_adv_1328003_084",
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "有著不同之處。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "但內心的距離，",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "並不遙遠。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n你說對吧？",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "吾，",
    "voice": "vo_adv_1328003_085",
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "並不打算揮開你的手。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "所以，",
    "voice": "vo_adv_1328003_086",
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "你也別放開",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "吾的手。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "平安夜的夜晚。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n萊拉耶爾與{0}一同奔馳在夜空中。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500040"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "然後，時間來到隔天──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "昨晚，",
    "voice": "vo_adv_1328003_087",
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "真的是",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "萬分抱歉。",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我會更加小心",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "葡萄酒的……",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "真的嗎……？",
    "voice": "vo_adv_1328003_088",
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "你能這樣說，",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我很高興。",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "不過，",
    "voice": "vo_adv_1328003_089",
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我昨晚的失態",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "還請別跟其他人說……！",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "那是只屬於我們",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "兩人的",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "祕密哦。",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "平安夜所發生的事變成了只屬於兩人的祕密。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n與萊拉耶爾所共度的愉快時光以及壯闊的夜景，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n全都深深地刻印在{0}的記憶裡。",
