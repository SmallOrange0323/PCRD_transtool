    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "可別放手哦？",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n會真的",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "就這樣掉下去。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "在你下面的是，",
    "voice": "vo_adv_1328003_072",
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "聖誕節的夜景。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n吾等所守護的城鎮。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "而這則是，",
    "voice": "vo_adv_1328003_073",
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "天上的景色，",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "天使的視角。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n地上與空中，",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "看到的東西很不一樣吧。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "天使與人不同，",
    "voice": "vo_adv_1328003_074",
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "不會受到重力的束縛。",
