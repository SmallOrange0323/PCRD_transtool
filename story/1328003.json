  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n不過……",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我已經，",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "到極限了。",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "呼啊……",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "background",
    "bg_id": "500042"
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "………………",
    "voice": "vo_adv_1328003_026",
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "呼……",
    "voice": "vo_adv_1328003_027",
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "呼……",
    "voice": null,
    "unit_id": 132811
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "等等。",
    "voice": "vo_adv_1328003_028",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n夜晚還沒結束哪。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "來陪陪吾吧。",
    "voice": "vo_adv_1328003_029",
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n吾特別，",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "允許你坐在吾旁邊。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "今晚可是平安夜哪。",
    "voice": "vo_adv_1328003_030",
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "難道你要放吾一人度過嗎。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "吾有諸多事想問你。",
    "voice": "vo_adv_1328003_031",
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n葡萄酒，",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "你也喝嗎？",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "什麼……？",
    "voice": "vo_adv_1328003_032",
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n你居然不喝吾的葡萄酒──",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "不過，",
    "voice": "vo_adv_1328003_033",
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "今晚就原諒你。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "因為是平安夜哪。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n聖誕節是個充滿愛的季節。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "你好好享受點心與茶吧。",
    "voice": "vo_adv_1328003_034",
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "而吾則享受點心與葡萄酒。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n今晚，",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "就由吾跟你探究解答哲學的問題。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "沒錯，",
    "voice": "vo_adv_1328003_035",
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "這可是場饗宴。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n既然有葡萄酒與茶",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "還有點心的話，",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "那就該來討論哲學哪。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "而且「吾」本身也，",
    "voice": "vo_adv_1328003_036",
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "想試著與你更進一步討論。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "這亦是為了讓吾面對自己……",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "那麼，",
    "voice": "vo_adv_1328003_037",
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "就馬上來吧……",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "愛到底為何物。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n你會怎麼去定義？",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……話題結束了哪。",
    "voice": "vo_adv_1328003_038",
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "不過別擔心，",
    "voice": "vo_adv_1328003_039",
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "吾換個問法。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "用二選一來深度挖掘你的思考。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "愛的本質，",
    "voice": "vo_adv_1328003_040",
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "是給予，",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "還是接受。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "你深思熟慮後認為是哪邊？",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "愛的本質，",
    "voice": "vo_adv_1328003_041",
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "是給予嗎……",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n也就是說，",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "即使要自我犧牲也在所不惜嘛？",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "愛的本質，",
    "voice": "vo_adv_1328003_042",
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "是接受嗎……",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n也就是說，",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "即使要全部肯定也在所不惜嘛？",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "真是不得了的器量。",
    "voice": "vo_adv_1328003_043",
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n你為了愛，",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "可以奉獻一切是嗎。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "什麼嘛，",
    "voice": "vo_adv_1328003_044",
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "這就收回前言了嗎。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "嗯？",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "你說吾把話題弄得太誇張了？",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "居然敢指使神意，",
    "voice": "vo_adv_1328003_045",
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "簡直傲慢至極──",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "不過",
    "voice": "vo_adv_1328003_046",
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "今晚就原諒你。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "因為是平安夜哪。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "倒不如說，",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "若是不能坦誠地對答就沒意義了。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "那麼，",
    "voice": "vo_adv_1328003_047",
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "下一個二選一。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n愛是，",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "情感",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "還是選擇。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "你認為愛是自然湧現的情感。",
    "voice": "vo_adv_1328003_048",
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n正因為有情感上的交流，",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "才能維持住愛是嘛。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "乍看之下，",
    "voice": "vo_adv_1328003_049",
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "是很浪漫的思考，",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "但若假設當情感交流結束時，",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "愛也會跟著結束的話，",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n這種思考方式或許需要相對的覺悟哪。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "你認為愛是根據有意識地去選擇，",
    "voice": "vo_adv_1328003_050",
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "來維持的是嗎。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n沒想到",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "你意外理性哪。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "但這得要看看你的優先順位，",
    "voice": "vo_adv_1328003_051",
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "以及選擇的基準擺放於何處。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "根據情況不同，",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "愛的結局",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "肯定也會不同哪。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "熱身該結束了。",
    "voice": "vo_adv_1328003_052",
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "就讓吾等來引導真正的解答吧。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n愛到底為何，",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "天使與人到底為何，",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "絕望到底",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "為何……",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}與萊拉耶爾反覆討論著哲學的問題。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n但是，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "不管是哪個問題都無法導出完美的答案。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "咕……",
    "voice": "vo_adv_1328003_053",
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "難道說哲學問答，",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "無法導出完美的答案嘛……",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "公主與冒險者，",
    "voice": "vo_adv_1328003_054",
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "天使與人，",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "吉歐‧提格尼亞與蘭德索爾。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "本以為有著不同觀點的吾與你",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "只要徹夜暢談，",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "就能發現些什麼……",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "沒想到即便是吾，",
    "voice": "vo_adv_1328003_055",
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "也沒這麼容易……",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "…………",
    "voice": "vo_adv_1328003_056",
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……確實，",
    "voice": "vo_adv_1328003_057",
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "如你所說。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "雖然沒能得到答案，",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "但這是一段很愉快的時光。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "嗯嗯，",
    "voice": "vo_adv_1328003_058",
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "心靈這個東西",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "還真是不可思議哪……",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n看似無益的時間也能利用得七彩繽紛……",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "最後吾再問你。",
    "voice": "vo_adv_1328003_059",
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "心靈是為何而存在的，",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "你的想法為何？",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……什麼意思？",
    "voice": "vo_adv_1328003_060",
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "……為了與夥伴一起，",
    "voice": "vo_adv_1328003_061",
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n享用美味的料理，",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "才會有心靈的存在是嗎？",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "嗯嗯……",
    "voice": "vo_adv_1328003_062",
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "這真是，",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "很符合你風格的答案呢。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n你那踏實的答案，",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "吾很中意。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "比起一個人，",
    "voice": "vo_adv_1328003_063",
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "兩人一起享用的料理會更美味，",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n確實是因為",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "吾等擁有心靈的關係哪。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "就像現在，",
    "voice": "vo_adv_1328003_064",
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "不管是點心還是葡萄酒",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "都感覺比平時還要美味。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n這是因為，",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "與你一起分享點心，",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "還有共度時光的關係。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "能將國家與種族都不同的吾等，",
    "voice": "vo_adv_1328003_065",
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "連結起來的方法。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "其中之一就是，",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "共享料理嗎……",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "這樣一想，",
    "voice": "vo_adv_1328003_066",
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "或許心靈的確是……",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n為了像這樣",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "與你一起邊吃東西邊聊天而存在的哪。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "呼……",
    "voice": "vo_adv_1328003_067",
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "雖然哲學的問答沒有得出答案來，",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n但你之所以能夠吸引他人的原因，",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "吾可以推測……",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "哈哈哈，",
    "voice": "vo_adv_1328003_068",
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "感覺情緒高昂起來了哪。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n很好，",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "來確認一下",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "現在吾與你",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "能否共享心靈。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "吾興致來了。",
    "voice": "vo_adv_1328003_069",
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n就特別",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "由吾來送給你",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "聖誕禮物吧。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n讓你窺探一下",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "天使的內心。",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "still",
    "still_id": "132800301"
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "夜風",
    "voice": "vo_adv_1328003_070",
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "將身體的熱氣給吹散了……",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "如何，",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "很舒服對吧？",
    "voice": null,
    "unit_id": 132812
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "呵呵，",
