    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "カラクリ技術にも",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "引けを取りまセンね。",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "\\n",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "ワタシの笛は、",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "音で",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "妖魔を呼び寄せることができマスが、",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "\\nショーグンの装備は、",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "どういう能力があるんデスか？",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "その装置、",
    "voice": "vo_adv_6076204_001",
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "前から",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "不思議だったデス！",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "\\nたくさん捕まえた",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "わたあめちゃんたちを、",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "なぜ",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "全部吸い込めるのか……",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "\\n",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "どういう原理なのか、",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "博士の謎は",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "深まるばかりデ〜ス……",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "フム……",
    "voice": "vo_adv_6076204_002",
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "背中の",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "捕獲機には、",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "そのような機能もあるんデスね！",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "\\n",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "だから",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "ワタシが",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "初めてわたあめちゃんと会った時、",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "\\nその反応を追って",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "ショーグンも",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "現れたというわけデスか！",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "確かに",
    "voice": "vo_adv_6076204_003",
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "妖魔は",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "霊界の住人……",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "未知の攻撃に備えている",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "というわけデスね。",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "\\n",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "ですが、",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "ワタシの制服も",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "博士が作ったので、",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "妖魔の攻撃に耐えられマス！",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "\\n",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "ショーグンに危険が迫れば、",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "ワタシが",
    "voice": null,
    "unit_id": 117811
  },
  {
    "type": "dialogue",
    "name": "ニノン",
    "words": "盾になりマスよー！",
    "voice": null,
    "unit_id": 117811
  }
