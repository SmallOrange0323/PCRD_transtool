[
  {
    "type": "background",
    "bg_id": "500012"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──某天{0}在路上看到\\n流夏被蘭德索爾的人圍住，臉上流露出很困擾的表情。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就這件事我一個人處理有困難啊……",
    "voice": "vo_adv_1056005_000",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我知道了。我去找找看有沒有人對這方面比較熟。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這樣如何？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "居民",
    "words": "可是這樣不知道要拖到什麼時候啊？",
    "voice": "vo_adv_1056005_001",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "居民",
    "words": "\\n既然騎士團不願意積極處理，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "居民",
    "words": "我們想趁早把事情解決。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "居民的女兒",
    "words": "流夏姐姐……",
    "voice": "vo_adv_1056005_002",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "居民的女兒",
    "words": "妳不願意，",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "居民的女兒",
    "words": "幫我們擊退幽靈嗎……？",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不是的……",
    "voice": "vo_adv_1056005_003",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "真傷腦筋。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "啊～小哥。",
    "voice": "vo_adv_1056005_004",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……對了，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "有你在！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "真是幫了大忙！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "居民",
    "words": "流夏妳認識他嗎？",
    "voice": "vo_adv_1056005_005",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "是啊。",
    "voice": "vo_adv_1056005_006",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你別看他那樣，他還挺可靠的。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n就算是幽靈，他也一定有辦法處理。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "居民",
    "words": "其實最近，",
    "voice": "vo_adv_1056005_007",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "居民",
    "words": "有個傳聞，說鎮上的墓地有幽靈出沒。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "居民",
    "words": "\\n鎮上的人都很不安……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "居民",
    "words": "這事情也要麻煩你了。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "居民的女兒",
    "words": "求求妳，",
    "voice": "vo_adv_1056005_008",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "居民的女兒",
    "words": "流夏姐姐。",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "居民的女兒",
    "words": "大哥哥。",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就是這麼一回事。",
    "voice": "vo_adv_1056005_009",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "拜託你了，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小哥。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n今晚難得，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就讓我們兩一起擊退幽靈吧。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "background",
    "bg_id": "500022"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "當晚，{0}和流夏在前往墓地\\n的路上會合。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小哥！",
    "voice": "vo_adv_1056005_010",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你怎麼這麼慢！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "到底去哪裡打混了。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "可別讓我等太久啊。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不是啦，",
    "voice": "vo_adv_1056005_011",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "雖然只有遲到一下下……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "但你讓我在這裡等是事實啊？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你遲到了30秒耶。",
    "voice": "vo_adv_1056005_012",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "如果是平常的話，我也不會這麼生氣。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n可是今天不提高警覺可就麻煩了。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "而且雖說在城中，但夜晚還是很危險。",
    "voice": "vo_adv_1056005_013",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n總之……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "唉，算了。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我們趕緊出發吧。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "可是你不覺得",
    "voice": "vo_adv_1056005_014",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "大家都太害怕幽靈了嗎？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就算幽靈出現，他跟魔物有什麼兩樣？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "真要說起來，",
    "voice": "vo_adv_1056005_015",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "都是因為相信這些不存在的東西才是問題。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不存在的東西就是不存在！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這不就了結了。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "說什麼聽見怪聲或看見人影之類的，",
    "voice": "vo_adv_1056005_016",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "大家都太緊張了啦。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "想必一定是，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "供品被風吹動，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "還是附近有蟲子在動吧。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這種事多半都是誤會。",
    "voice": "vo_adv_1056005_017",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你不這麼認為嗎？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小孩子就算了，",
    "voice": "vo_adv_1056005_018",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "連成年大人也嚇成那樣，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n真的是有夠沒出息的……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "沒，",
    "voice": "vo_adv_1056005_019",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "什麼也沒有啊……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你怎麼會這麼問呢？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我和平常一樣沒變啊。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就跟平常一樣。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "哈哈哈……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "哎呀，",
    "voice": "vo_adv_1056005_020",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "快到墓地了呢……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小哥，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "從這裡開始你先走在前頭。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我的話，",
    "voice": "vo_adv_1056005_021",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就你也知道的，要保護你的身後啊。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "怎麼啦？",
    "voice": "vo_adv_1056005_022",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "該不會需要我在背後推一把你才能往前走吧？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "別擔心，有我陪著你。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "好啦，快走快走！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "background",
    "bg_id": "500532"
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……到目前為止還看不出有什麼異常呢。",
    "voice": "vo_adv_1056005_023",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "太好了……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "啊！等、等一下啊！",
    "voice": "vo_adv_1056005_024",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "哪有人這樣突然加快腳步的！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "拜託你稍微再走慢一點……！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不然的話，那個……",
    "voice": "vo_adv_1056005_025",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我要怎麼在背後保護你呢？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "前進時如果沒有配合彼此的步調，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n萬一有什麼突發狀況兩人都會陷入困境喔。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那我們就",
    "voice": "vo_adv_1056005_026",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "繼續走吧……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……好，快滾出來，",
    "voice": "vo_adv_1056005_027",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "讓我把你大卸八塊……！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "在哪……？",
    "voice": "vo_adv_1056005_028",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "到底在哪裡……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "快給我滾出來……！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "呼，",
    "voice": "vo_adv_1056005_029",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "呼，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "呼……！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "沒事，",
    "voice": "vo_adv_1056005_030",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "沒事……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "一點都",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不恐怖……！",
