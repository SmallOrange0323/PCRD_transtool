  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "真是太可笑了。",
    "voice": "vo_adv_1056005_032",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就算不知道幽靈的真面目，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n也沒道理要害怕吧？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "哈哈、哈哈哈……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我輸了。",
    "voice": "vo_adv_1056005_033",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我投降。",
