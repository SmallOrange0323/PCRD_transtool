[
  {
    "type": "background",
    "bg_id": "500090"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "茉莉和克莉絲提娜兩人，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n結束了作為【王宮騎士團】和獸人族和平大使的活動。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n久違地享受了休假──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "比我預想中的",
    "voice": "vo_adv_5104007_000",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "還要更平靜呢。",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n茉莉的衝擊性告白。",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "雖然大家都裝作沒發現，",
    "voice": "vo_adv_5104007_001",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n但是幾乎所有團員都已經知道了吧。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "話雖如此，",
    "voice": "vo_adv_5104007_002",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "好像還是有少部分人，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n第一次聽說茉莉是獸人族這件事，因此受到了震撼……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n不過也沒有發生什麼問題，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "就這樣子接受真是太好了。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "那麼，",
    "voice": "vo_adv_5104007_003",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "純。",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n我接下來要去幫忙英雄秀，就先告辭了。",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "好，",
    "voice": "vo_adv_5104007_004",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "路上小心。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……真是和平呢。",
    "voice": "vo_adv_5104007_005",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "今天感覺也會是個好日子。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……啊啊，",
    "voice": "vo_adv_5104007_006",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "糟透了。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "既和平又太過乏味到令人煩躁。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這麼和平的日子，",
    "voice": "vo_adv_5104007_007",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "要是什麼都不做，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n就會有種血液像是要凝固般的倦怠感。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "啊啊，",
    "voice": "vo_adv_5104007_008",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不管是誰都好，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "來幫我排解無聊吧……♪",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "兔子族",
    "words": "啊，",
    "voice": "vo_adv_5104007_009",
    "unit_id": 8811
  },
  {
    "type": "dialogue",
    "name": "兔子族",
    "words": "克莉蹦！",
    "voice": null,
    "unit_id": 8811
  },
  {
    "type": "dialogue",
    "name": "兔子族",
    "words": "\\n好久不見蹦～♪",
    "voice": null,
    "unit_id": 8811
  },
  {
    "type": "dialogue",
    "name": "老虎族族長",
    "words": "這可真巧啊，",
    "voice": "vo_adv_5104007_010",
    "unit_id": 8611
  },
  {
    "type": "dialogue",
    "name": "老虎族族長",
    "words": "一切都好嗎？",
    "voice": null,
    "unit_id": 8611
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "嗯？",
    "voice": "vo_adv_5104007_011",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我還想說是在哪裡見過的面孔……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n你們",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "在這裡做什麼？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "兔子族",
    "words": "我們正要去看茉莉蹦的英雄秀蹦！",
    "voice": "vo_adv_5104007_012",
    "unit_id": 8811
  },
  {
    "type": "dialogue",
    "name": "兔子族",
    "words": "\\n",
    "voice": null,
    "unit_id": 8811
  },
  {
    "type": "dialogue",
    "name": "兔子族",
    "words": "我是第一次看英雄秀，所以很期待蹦！",
    "voice": null,
    "unit_id": 8811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "英雄秀……？",
    "voice": "vo_adv_5104007_013",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "啊啊，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這麼說起來，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n茉莉好像有說過呢。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "所以說，",
    "voice": "vo_adv_5104007_014",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "要去看英雄秀的人為什麼會在這裡？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "就算是開演前的觀光，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "未免有些太過乏味了吧。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "老虎族族長",
    "words": "不，",
    "voice": "vo_adv_5104007_015",
    "unit_id": 8611
  },
  {
    "type": "dialogue",
    "name": "老虎族族長",
    "words": "那是因為……",
    "voice": null,
    "unit_id": 8611
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "那是，",
    "voice": "vo_adv_5104007_016",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "因為什麼？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "別賣關子快點告訴我吧。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "兔子族",
    "words": "那是，",
    "voice": "vo_adv_5104007_017",
    "unit_id": 8811
  },
  {
    "type": "dialogue",
    "name": "兔子族",
    "words": "因為我們迷路了蹦！！",
    "voice": null,
    "unit_id": 8811
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "唔……？",
    "voice": "vo_adv_5104007_018",
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "剛剛一瞬間",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "突然有種刺骨的寒意……！",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "沒事吧，",
    "voice": "vo_adv_5104007_019",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "茉莉？",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "是因為第一次演主角所以在緊張吧？",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "是這樣子嗎……？",
    "voice": "vo_adv_5104007_020",
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "只是我的錯覺就好了。",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "但是，",
    "voice": "vo_adv_5104007_021",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n沒想到茉莉居然",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "會被推選來當超級英雄秀的主角呢。",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "看來團長也是做了個大膽的決定。",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "因為如果都是同樣的戲碼，",
    "voice": "vo_adv_5104007_022",
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "觀眾也會看膩嘛。",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "果然還是需要有新的變化！",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "雖然我自己的話，",
    "voice": "vo_adv_5104007_023",
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n光看主角演員的動作",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "和對打場面的不同就會覺得興奮。",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "不過小孩子觀眾不太在意這種地方。",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "這次的英雄秀，",
    "voice": "vo_adv_5104007_024",
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n是和各種不同種族的競爭對手",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "以及夥伴們",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "合力打倒敵人，",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "展開讓人心生雀躍的熱血故事……！",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "是是。",
    "voice": "vo_adv_5104007_025",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "熱血沸騰又有幹勁是很好，",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n但是要好好準備英雄秀才行啊。",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我把票",
    "voice": "vo_adv_5104007_026",
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "送給那些照顧過我的人了，",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "不知道大家會不會來呢……？",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "background",
    "bg_id": "500090"
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……嗯？",
    "voice": "vo_adv_5104007_027",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "有人來了。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "喂，",
    "voice": "vo_adv_5104007_028",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "妳在這裡做什麼呢？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "團長。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗨，",
    "voice": "vo_adv_5104007_029",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "小克莉絲。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n如妳所見，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我在當守衛喔。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "小克莉絲，",
    "voice": "vo_adv_5104007_030",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "妳不去看茉莉的英雄秀沒關係嗎？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n我如果有時間的話，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "也是很想去看呢……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "很不巧，",
    "voice": "vo_adv_5104007_031",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我對那種訴說乏味理想論和正義，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n騙小孩的英雄秀沒有興趣呢。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "趁機闖上台去搗亂，",
    "voice": "vo_adv_5104007_032",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這種惡作劇以前也做過了……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "再做同樣的事情也沒什麼意思吧？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "這樣啊。",
    "voice": "vo_adv_5104007_033",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "那麼，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "妳願意在這裡陪我聊聊天嗎？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n因為我現在還不能離開這裡。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "哈！",
    "voice": "vo_adv_5104007_034",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我就是來逼迫妳離開這裡的。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "拔起那把立在地上的劍吧。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n──喝！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "兔子族",
    "words": "人數相當多呢蹦。",
    "voice": "vo_adv_5104007_035",
    "unit_id": 8811
  },
  {
    "type": "dialogue",
    "name": "兔子族",
    "words": "\\n一直都是這麼多人的嗎蹦～？",
    "voice": null,
    "unit_id": 8811
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "不，",
    "voice": "vo_adv_5104007_036",
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "之前的觀眾比這少呢。",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "\\n",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "今天是因為聽說有新的英雄秀要上演，",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "\\n所以孩子們都跑來看了喔。",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "老虎族族長",
    "words": "被這麼多的人圍觀，",
    "voice": "vo_adv_5104007_037",
    "unit_id": 8611
  },
  {
    "type": "dialogue",
    "name": "老虎族族長",
    "words": "希望她不會緊張就好。",
    "voice": null,
    "unit_id": 8611
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "是呢……",
    "voice": "vo_adv_5104007_038",
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "\\n",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "而且",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "茉莉的母親",
    "words": "也沒有看到克莉絲提娜小姐的身影。",
    "voice": null,
    "unit_id": 8511
  },
  {
    "type": "dialogue",
    "name": "兔子族",
    "words": "克莉蹦的話，",
    "voice": "vo_adv_5104007_039",
    "unit_id": 8811
  },
  {
    "type": "dialogue",
    "name": "兔子族",
    "words": "她帶我們過來之後，",
    "voice": null,
    "unit_id": 8811
  },
  {
    "type": "dialogue",
    "name": "兔子族",
    "words": "\\n說她自己還有事要處理～",
    "voice": null,
    "unit_id": 8811
  },
  {
    "type": "dialogue",
    "name": "兔子族",
    "words": "就不知道去哪裡了蹦。",
    "voice": null,
    "unit_id": 8811
  },
  {
    "type": "background",
    "bg_id": "500090"
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "…………？",
    "voice": "vo_adv_5104007_040",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "小克莉絲，",
    "voice": "vo_adv_5104007_041",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "妳把劍立在地上……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n是什麼意思……？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "意思是",
    "voice": "vo_adv_5104007_042",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這裡就交給我。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "團長就去看茉莉的英雄秀吧。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "小克莉絲……",
    "voice": "vo_adv_5104007_043",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我對那些正義什麼的已經厭煩了。",
    "voice": "vo_adv_5104007_044",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "像那種天真的故事",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "最適合團長或公主殿下了。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "而且……",
    "voice": "vo_adv_5104007_045",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "應該有個小傢伙，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n為了獲得妳的認可，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這次特別卯足全力了吧。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "像這樣",
    "voice": "vo_adv_5104007_046",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "認可部下的努力，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n也是上司的重要工作之一。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我是這麼想的。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……妳還是這麼強勢啊，",
    "voice": "vo_adv_5104007_047",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "小克莉絲。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n妳這種強硬的地方都沒有改變呢。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不過，",
    "voice": "vo_adv_5104007_048",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "請不要忘了我們之間的約定喔。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "下個休息日，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "妳要和我一對一決鬥啊。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "……謝謝妳，",
    "voice": "vo_adv_5104007_049",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "小克莉絲。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "感激不盡。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "別感激了，",
    "voice": "vo_adv_5104007_050",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "快去吧。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……所以，",
    "voice": "vo_adv_5104007_051",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "小子你又是為什麼在這裡呢？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這樣啊，",
    "voice": "vo_adv_5104007_052",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "那真是多謝了。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "那麼，",
    "voice": "vo_adv_5104007_053",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我也去看看吧。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "的確，",
    "voice": "vo_adv_5104007_054",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我是說交給我，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "但我可沒有說過",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "要自己來負責看守啊。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "喂，",
    "voice": "vo_adv_5104007_055",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "出來。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "換班的時間到了。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "是！",
    "voice": "vo_adv_5104007_056",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "王宮騎士",
    "words": "克莉絲提娜副團長！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "每個人都這樣……",
    "voice": "vo_adv_5104007_057",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "是「前」",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "副團長。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "算了，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "以前的人脈關係，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "可是意外地方便呢。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這次",
    "voice": "vo_adv_5104007_058",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "為了我的任務善後也添了不少麻煩啊。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不過，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "佔點這種程度的方便，也不會造成什麼損失吧。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "連善後服務都萬無一失。",
    "voice": "vo_adv_5104007_059",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n我克莉絲提娜姐姐必定會完美達成任務，對吧？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "那麼小子，",
    "voice": "vo_adv_5104007_060",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "要走囉。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "那個小姑娘肯定緊張得手足無措吧。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "說不定正在舞台的側幕緊張發抖呢。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "嗚，",
    "voice": "vo_adv_5104007_061",
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "肚子感覺好像……",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "開始痛起來了。",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "馬上就要開場了，",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我的腳還在不停地發抖啊～！　",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "這個感覺……",
    "voice": "vo_adv_5104007_062",
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "就像",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "跟族長決鬥那時候一樣。",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "但是",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "這裡得要靠我自己",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "一個人戰鬥才行……！　",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "啊，",
    "voice": "vo_adv_5104007_063",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "純來了……？",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……她好像在和克莉絲提娜爭論。",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n太遠了所以聽不到，",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "不知道是不是她又策劃了什麼。",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "咦？",
    "voice": "vo_adv_5104007_064",
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "純來了嗎！？",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n還有克莉絲提娜阿姨？",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "哇，",
    "voice": "vo_adv_5104007_065",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "茉莉。",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "妳突然整個人都有精神了呢……",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "不過，",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "看樣子，應該不用擔心了吧。",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "不只是她們兩個，",
    "voice": "vo_adv_5104007_066",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n妳看，",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "還有一個人。",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "呵呵……",
    "voice": "vo_adv_5104007_067",
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "英雄秀都還沒開始，",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n就開始幫英雄加油可是不行的喔？",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "好，",
    "voice": "vo_adv_5104007_068",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "看來已經準備好了。",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "那麼，",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "去吧，茉莉。",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n當然，",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我也會為妳加油的♪",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "……謝謝，",
    "voice": "vo_adv_5104007_069",
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "小智姐～！",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "大家都在等我。",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我這就去！！",
    "voice": null,
    "unit_id": 123912
  },
  {
    "type": "still",
    "still_id": "510400701"
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "哼哼哼……！",
    "voice": "vo_adv_5104007_070",
    "unit_id": 123911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n各位乖孩子，",
    "voice": null,
    "unit_id": 123911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "讓你們久等了！！",
    "voice": null,
    "unit_id": 123911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "我的名字是",
    "voice": "vo_adv_5104007_071",
    "unit_id": 123911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "勇氣之虎！",
    "voice": null,
    "unit_id": 123911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n是身為獸人族，",
    "voice": null,
    "unit_id": 123911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "也是來自【王宮騎士團】的……",
    "voice": null,
    "unit_id": 123911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "守護大家的，",
    "voice": "vo_adv_5104007_072",
    "unit_id": 123911
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "正義英雄！！",
    "voice": null,
    "unit_id": 123911
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就這樣，經由茉莉等人踏出了邁向和平的一步，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n而後的【王宮騎士團】不只是人族，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n也向各個種族敞開了大門，達到更進一步的發展。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "end"
  },
