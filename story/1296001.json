    "name": "涅婭",
    "words": "誰都沒辦法靠近呢～",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "就算是這樣啊？",
    "voice": "vo_adv_1296001_065",
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "她以前還是不一樣的～",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "就像小騎士一樣超純真～",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "background",
    "bg_id": "502110"
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "現在也是，雖然外在渾身帶刺，",
    "voice": "vo_adv_1296001_066",
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n但我覺得她其實是個溫柔的孩子呢～",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "有點可惜耶？",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "這樣的感覺……",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "自那天以來的幾天，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}都在吉歐‧格黑納為旅行做準備。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n那個期間安涅默涅的態度也依舊不變……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "……就這樣到了出發的前一晚。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "502111"
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "──換我",
    "voice": "vo_adv_1296001_067",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "來值夜班。",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "夜班人員",
    "words": "安涅默涅？",
    "voice": "vo_adv_1296001_068",
    "unit_id": 50611
  },
  {
    "type": "dialogue",
    "name": "夜班人員",
    "words": "\\n",
    "voice": null,
    "unit_id": 50611
  },
  {
    "type": "dialogue",
    "name": "夜班人員",
    "words": "可是聽說",
    "voice": null,
    "unit_id": 50611
  },
  {
    "type": "dialogue",
    "name": "夜班人員",
    "words": "妳明天就要啟程前往其他世界了……",
    "voice": null,
    "unit_id": 50611
  },
  {
    "type": "dialogue",
    "name": "夜班人員",
    "words": "\\n早點休息不是比較好嗎？",
    "voice": null,
    "unit_id": 50611
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "──我沒事。",
    "voice": "vo_adv_1296001_069",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n因為並不是",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "要去戰鬥。",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "夜班人員",
    "words": "呃、",
    "voice": "vo_adv_1296001_070",
    "unit_id": 50611
  },
  {
    "type": "dialogue",
    "name": "夜班人員",
    "words": "唉……",
    "voice": null,
    "unit_id": 50611
  },
  {
    "type": "dialogue",
    "name": "夜班人員",
    "words": "\\n",
    "voice": null,
    "unit_id": 50611
  },
  {
    "type": "dialogue",
    "name": "夜班人員",
    "words": "我知道啦。",
    "voice": null,
    "unit_id": 50611
  },
  {
    "type": "dialogue",
    "name": "夜班人員",
    "words": "那就……",
    "voice": null,
    "unit_id": 50611
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "……呼。",
    "voice": "vo_adv_1296001_071",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n沒有異狀──",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "───我原本，",
    "voice": "vo_adv_1296001_072",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n是這樣想的。",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "…………",
    "voice": "vo_adv_1296001_073",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "為什麼──",
    "voice": "vo_adv_1296001_074",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "你會在這裡？",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "你只是為了講這個",
    "voice": "vo_adv_1296001_075",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "就特地跑來嗎？",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "……",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "──難不成，",
    "voice": "vo_adv_1296001_076",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n你知道我的祕密，",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "想趁我一個人的時候",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "鎖定我……？",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "那樣的話──",
    "voice": "vo_adv_1296001_077",
    "unit_id": 129613
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "──收起武器，",
    "voice": "vo_adv_1296001_078",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "默涅。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "！",
    "voice": "vo_adv_1296001_079",
    "unit_id": 129613
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "皇女──",
    "voice": null,
    "unit_id": 129613
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "為什麼在這裡？",
    "voice": null,
    "unit_id": 129613
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "不問自明。",
    "voice": "vo_adv_1296001_080",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家的目的",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "和騎士閣下是一樣的呢？",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "騎士閣下。",
    "voice": "vo_adv_1296001_081",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n奴家只是來說聲，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "「明天起請多關照默涅了」。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "皇女……",
    "voice": "vo_adv_1296001_082",
    "unit_id": 129613
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "──呵呵。",
    "voice": "vo_adv_1296001_083",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n奴家想這會讓恁很辛苦……",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n但默涅的事，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "麻煩恁多多擔待，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "騎士閣下。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "…………",
    "voice": "vo_adv_1296001_084",
    "unit_id": 129613
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "默涅呀，",
    "voice": "vo_adv_1296001_085",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n要是板著臉，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "就糟蹋汝如花似玉的容顏了吧？",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "尤其在吾等尚且所不熟悉的世界，",
    "voice": "vo_adv_1296001_086",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "這位人物",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "乃是唯一的依靠。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n不可欠缺禮數。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "好了，",
    "voice": "vo_adv_1296001_087",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "向他問候吧。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "…………",
    "voice": "vo_adv_1296001_088",
    "unit_id": 129613
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "請──",
    "voice": "vo_adv_1296001_089",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "多多指教了。",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "嗯。",
    "voice": "vo_adv_1296001_090",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n汝在蘭德索爾",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "也要好好聽從這位閣下的指示。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "默涅，明白的話……",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "就離開吧。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "──是。",
    "voice": "vo_adv_1296001_091",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "我去執行",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "夜班的巡邏了。",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "──呼。",
    "voice": "vo_adv_1296001_092",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "對於默涅的多次無禮，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "真是萬分抱歉。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家只能在此處說──",
    "voice": "vo_adv_1296001_093",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "儘管此次視察，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n僅有吾妹便可，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "但奴家仍刻意讓默涅同行。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "這也全都是",
    "voice": "vo_adv_1296001_094",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "為了向默涅展現廣闊的世界。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "為了教導那女孩不受吉歐‧格黑納的處世束縛的生活方式，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n讓她的人生綻放出華美的花。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "因此──",
    "voice": "vo_adv_1296001_095",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "再次",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "拜託恁了。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "請向",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "那女孩展示恁的世界吧。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "感謝至極。",
    "voice": "vo_adv_1296001_096",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家現在便開始",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "期待視察歸來的日子了。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "要是能稍微治好她那",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "極為嚴重的怕生就好──",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "──哈啾！",
    "voice": "vo_adv_1296001_097",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "真怪，",
    "voice": "vo_adv_1296001_098",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "這噴嚏──",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n我沒感覺有生病",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "就是了。",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "──這麼說來，",
    "voice": "vo_adv_1296001_099",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n涅婭小姐好像說，",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "要是有誰在談論你，",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n就會",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "打噴嚏。",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "不過──",
    "voice": "vo_adv_1296001_100",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "這是",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "迷信吧。",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "安涅默涅──身為吸血妖花遭人覬覦，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n因而警戒心變得很強。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n這位少女，將從這次視察中獲得的收穫是──？",
    "voice": null,
    "unit_id": null
  }
]
