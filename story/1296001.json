    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "就這樣♪",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "好～了，小卡里莎？",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n壞～壞的嘴巴是～",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "這、一、張、嗎～？",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "唔嗚！？",
    "voice": "vo_adv_1296001_017",
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "唔嗚嗚嗚嗚～～～！！",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "……那個，",
    "voice": "vo_adv_1296001_018",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "簡單",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "來說──",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "……是",
    "voice": "vo_adv_1296001_019",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "皇女的",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "詔令。",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n她說──",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "我們三人要去",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "蘭德索爾這地方",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "進行視察。",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "涅婭小姐的報告──",
    "voice": "vo_adv_1296001_020",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n都是些甜食",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "還有男孩子之類的報告。",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "皇女說",
    "voice": "vo_adv_1296001_021",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "希望有能更認真視察的人跟著她，",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "所以，",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "就連我都──",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "唉。",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "不過，",
    "voice": "vo_adv_1296001_022",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "我會做就是了──",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n因為是命令。",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "只不過，",
    "voice": "vo_adv_1296001_023",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "那個小孩一直在反抗，",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "真的──",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "很吵。",
    "voice": null,
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "說我吵～！？",
    "voice": "vo_adv_1296001_024",
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "\\n而且",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "妳剛剛還把我當成小鬼看待嗎？妳這眼珠開花！",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "\\n我們根本沒差幾歲吧！",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "你說啥！？",
    "voice": "vo_adv_1296001_025",
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "\\n",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "少講得一副你很懂一樣，",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "公主騎士！",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "真是夠了～",
    "voice": "vo_adv_1296001_026",
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n別見人就亂吠啦～",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "你是小型犬嗎～？",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "汪汪♡",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "要是你那～麼希望我陪你～",
    "voice": "vo_adv_1296001_027",
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "嗯呵呵～",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "我就這樣做吧♡",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "哼！",
    "voice": "vo_adv_1296001_028",
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "又──是史萊姆啊！",
