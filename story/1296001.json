    "words": "唉……",
    "voice": "vo_adv_1296001_005",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "啊，",
    "voice": "vo_adv_1296001_006",
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "小騎士～♪",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "你好～",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "欸～",
    "voice": "vo_adv_1296001_007",
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "聽我說聽我說～",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n小卡里莎啊，",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "好過分喔～",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "吵死了！",
    "voice": "vo_adv_1296001_008",
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "妳很煩啦！",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "\\n誰會聽妳們這種",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "\\n怪物女的命令啊！！",
    "voice": null,
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "……",
    "voice": "vo_adv_1296001_009",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "好啦好啦，",
    "voice": "vo_adv_1296001_010",
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "小默涅冷靜～",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "說是這樣說，",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "但我也差不多要發火了～",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "嗯──",
    "voice": "vo_adv_1296001_011",
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "說來話長呢～",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "小默涅，",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "交給妳了～",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "……",
    "voice": "vo_adv_1296001_012",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "──我不要。",
    "voice": "vo_adv_1296001_013",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "可是～",
    "voice": "vo_adv_1296001_014",
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n我必須要應付小卡里莎耶～？",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "小默涅",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "更討厭應付小卡里莎吧？",
    "voice": null,
    "unit_id": 123311
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "對。",
    "voice": "vo_adv_1296001_015",
    "unit_id": 129612
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "那",
