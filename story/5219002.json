    "name": "布武機",
    "words": "那個評價感覺也很好──♡",
    "voice": "vo_adv_5219002_013",
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n就讓妳聽聽吧♪",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "嘿，",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "我按♪",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機的貼文",
    "words": "「嘻嘻嘻ｗ",
    "voice": "vo_adv_5219002_014",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "布武機的貼文",
    "words": "\\n這個啊～",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "布武機的貼文",
    "words": "你們是在沒有任何人的地方",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "布武機的貼文",
    "words": "偷偷摸摸地聽著吧～？ｗ",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "布武機的貼文",
    "words": "\\n真是雜碎，好可憐～ｗ」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "布武機的貼文",
    "words": "「為了那樣的可憐雜碎，",
    "voice": "vo_adv_5219002_015",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "布武機的貼文",
    "words": "\\n我",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "布武機的貼文",
    "words": "就給你們特別服務吧ｗ",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "布武機的貼文",
    "words": "\\n來──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "布武機的貼文",
    "words": "再把耳朵靠近一點──」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "布武機的貼文",
    "words": "「雜──碎♡」",
    "voice": "vo_adv_5219002_016",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "……會有被說是「雜碎」",
    "voice": "vo_adv_5219002_017",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "而開心的人嗎？",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "班比不懂吧～ｗ",
    "voice": "vo_adv_5219002_018",
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n總覺得妳像是好人家的大小姐～",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n不諳世事一覽無遺的感覺～ｗ",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "……",
    "voice": "vo_adv_5219002_019",
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "話說，",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "只是個「乖孩子」什麼的，",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n瞬間就會被埋沒並結束吧。",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n妳看看排名吧──",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "排名",
    "voice": "vo_adv_5219002_020",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "是什～麼？",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "要怎麼看？",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "真受不了！",
