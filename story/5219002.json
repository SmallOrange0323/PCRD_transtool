    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "話說，哥哥，",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "你根本笑得一臉豬哥樣嘛～？♡",
