    "words": "\\n不要那麼認真工作啦～～～！",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "嗚哇～～！",
    "voice": null,
    "unit_id": 140112
  },
  {
