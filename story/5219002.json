    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "滑動畫面並按那個分頁！",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "對，那個。",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "……排名前幾的",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "是超級名模「鈴奈」，",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n還有頂尖偶像「慈樂之音」。",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "再來就是",
    "voice": "vo_adv_5219002_022",
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "靠著華麗大撒幣，排名不斷飆升的",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n「秋乃」。",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "懂嗎？",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n頂點都被「好女人」獨佔了。",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "跟這些怪物們正經地[rub:來]比賽[/rub]，",
    "voice": "vo_adv_5219002_023",
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "根本只是笨蛋吧。",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "正攻法這種話，",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "肯定是真正最強無敵的魅力人物，",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n或是腦子不好的傢伙才會說的。",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "畢竟我很可愛嘛，",
    "voice": "vo_adv_5219002_024",
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "光靠這份可愛也算是能[rub:行]一決勝負[/rub]啦～",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "沒必要特地從正面迎戰吧？",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "話說，",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "我就是想贏得輕輕鬆鬆啦？",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "所以，",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "就要用「有點壞壞的女生」來營銷♡",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "這就──是戰略♡",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "……布武機",
    "voice": "vo_adv_5219002_025",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "原來考量到那種程度了啊。",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "戰略",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "啊～",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "哼哼～♪",
