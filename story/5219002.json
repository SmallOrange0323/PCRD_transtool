    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "是「不行！」的呢──",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "不過？",
    "voice": "vo_adv_5219002_056",
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n就先不管那個了～",
    "voice": null,
    "unit_id": 140211
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "好冷漠！？",
    "voice": "vo_adv_5219002_057",
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n對我更溫柔一點啦～～～！",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "「戰略」……",
