    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "是怎樣？",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n明明是雜碎哥哥，是以製作人自居的意思嗎？",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n把擬定企劃講得很簡單嘛。",
