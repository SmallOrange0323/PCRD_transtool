    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "那就想想我的企劃啊！",
    "voice": "vo_adv_5219002_061",
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n讓我賺到愛心和獎金，",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "讓我贏過班比！",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 140112
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "然後把雜碎哥哥變得更雜碎啦，笨蛋～～～！！！",
