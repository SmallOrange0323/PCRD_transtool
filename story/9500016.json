[
  {
    "type": "background",
    "bg_id": "509040"
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "咦？",
    "voice": "vo_adv_9500016_000",
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "你說要選我",
    "voice": null,
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "……",
    "voice": null,
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n真的嗎……？",
    "voice": null,
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "難道是因為……",
    "voice": null,
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我是",
    "voice": null,
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "小孩子嗎？",
    "voice": null,
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "因為擔心我，",
    "voice": "vo_adv_9500016_001",
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "才想要保護我，",
    "voice": null,
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "你是這個意思，對吧？",
    "voice": null,
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "真是的，",
    "voice": null,
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我不是一直跟你說，",
    "voice": null,
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n不要把我當小孩子看待嗎……！",
    "voice": null,
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "……話雖如此，",
    "voice": "vo_adv_9500016_002",
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "其實我也明白。",
    "voice": null,
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "雖然我嘴上說著不要把我當小孩子看待，",
    "voice": null,
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n但如果你真的不把我當小孩子看待，",
    "voice": null,
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "而選擇我的話……",
    "voice": null,
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "那樣一來，",
    "voice": "vo_adv_9500016_003",
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "恐怕也會有點問題啊。",
    "voice": null,
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "你啊……",
    "voice": "vo_adv_9500016_004",
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "偶爾在奇怪的事情上倒是很有常識呢。",
    "voice": null,
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "……咳咳。",
    "voice": "vo_adv_9500016_005",
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n而且，",
    "voice": null,
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "你為了保護我而把我當小孩子看待，",
    "voice": null,
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "其實我也有點開心。",
    "voice": null,
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "不過，",
    "voice": "vo_adv_9500016_006",
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "只有現在不可以！",
    "voice": null,
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "不是把我當成小孩子，",
    "voice": null,
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "而是能把我",
    "voice": null,
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "當成我自己來看待的話……",
    "voice": null,
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我也不是不能",
    "voice": null,
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "接受你的提議喔！",
    "voice": null,
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "……嘿嘿，",
    "voice": "vo_adv_9500016_007",
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我知道了。",
    "voice": null,
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n那麼，我今天也不會",
    "voice": null,
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "把你當成變態可疑分子，",
    "voice": null,
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n而是好好相信你、",
    "voice": null,
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "依靠你。",
    "voice": null,
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "但是，相對地！",
    "voice": "vo_adv_9500016_008",
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "也請你要",
    "voice": null,
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "依靠我喔。",
    "voice": null,
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "那個……",
    "voice": null,
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n我會努力",
    "voice": null,
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "成為你的依靠……",
    "voice": null,
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "謝謝。",
    "voice": "vo_adv_9500016_009",
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n今天的{0}",
    "voice": null,
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "比平常還要可靠，",
    "voice": null,
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n有一點點帥氣喔……",
    "voice": null,
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "開玩笑的，",
    "voice": null,
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "嘿嘿……",
    "voice": null,
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "好",
    "voice": "vo_adv_9500016_010",
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "了，",
    "voice": null,
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我們走吧，{0}。",
    "voice": null,
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n我們一定要贏，",
    "voice": null,
    "unit_id": 103641
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "然後和大家一起回家。",
    "voice": null,
    "unit_id": 103641
  }
]
