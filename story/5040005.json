[
  {
    "type": "background",
    "bg_id": "500111"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "因為抓到懸賞犯",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n而得到一筆意外收入的真陽和鈴，興奮不已地",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n回到了咲戀育幼院。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真陽、鈴",
    "words": "我們回來了～",
    "voice": "vo_adv_5040005_000",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "歡迎回來。",
    "voice": "vo_adv_5040005_001",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "從妳們的表情看來，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "工作進行得似乎很順利呢。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "算是啦。",
    "voice": "vo_adv_5040005_002",
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "沒想到因為在進行第一件委託的途中",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "捉到了懸賞犯，",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n結果造成了話題，",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "之後不斷地有委託湧入呢。",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n賺了不少錢喔。",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "照這個樣子下去",
    "voice": "vo_adv_5040005_003",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "拿回牧場的那天",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "也不遠了啦。",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我回來",
    "voice": "vo_adv_5040005_004",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "了。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "歡迎回來，小栞。",
    "voice": "vo_adv_5040005_005",
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "妳怎麼悶悶不樂的，",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "發生了什麼事嗎？",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n難不成，",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "你們遇到了什麼問題？",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "啊，",
    "voice": "vo_adv_5040005_006",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "不是的。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "也不能說是",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "有問題……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n該怎麼說才好呢……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "農民1",
    "words": "嘿，",
    "voice": "vo_adv_5040005_007",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "農民1",
    "words": "打擾囉。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "農民2",
    "words": "打擾了。",
    "voice": "vo_adv_5040005_008",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "…………他們是誰？",
    "voice": "vo_adv_5040005_009",
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "這兩位的",
    "voice": "vo_adv_5040005_010",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "農場和牧場也跟【伊麗莎白牧場】一樣，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n被那個監察官沒收了。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "農民1",
    "words": "最後沒有籌到錢，",
    "voice": "vo_adv_5040005_011",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "農民1",
    "words": "牧場就被徵收了。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "農民2",
    "words": "我經營的果園",
    "voice": "vo_adv_5040005_012",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "農民2",
    "words": "被徵收之後，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "農民2",
    "words": "\\n就成了來路不明的貴族的別墅。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "這……",
    "voice": "vo_adv_5040005_013",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "這種時候該說什麼呢……",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "農民1",
    "words": "這件事已經過去了。",
    "voice": "vo_adv_5040005_014",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "農民1",
    "words": "什麼都不用說。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "農民2",
    "words": "更重要的是，",
    "voice": "vo_adv_5040005_015",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "農民2",
    "words": "我希望這些能幫上妳們的忙。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "這是……",
    "voice": "vo_adv_5040005_016",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "農民1",
    "words": "這是我們為了取回自己的公會",
    "voice": "vo_adv_5040005_017",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "農民1",
    "words": "而存下的錢。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "這、",
    "voice": "vo_adv_5040005_018",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "這怎麼可以！　",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我不能收下",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "這筆錢啦！",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "農民1",
    "words": "我可沒說要送妳。",
    "voice": "vo_adv_5040005_019",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "農民1",
    "words": "這只是借給妳而已。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "農民1",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "農民1",
    "words": "等妳們取回牧場後再還給我。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "農民2",
    "words": "我稍微打聽了一下，",
    "voice": "vo_adv_5040005_020",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "農民2",
    "words": "妳們似乎受到很多人的喜愛呢。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "農民2",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "農民2",
    "words": "所以，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "農民2",
    "words": "這筆錢就借給妳們。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "可、",
    "voice": "vo_adv_5040005_021",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "可是……",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "真陽。",
    "voice": "vo_adv_5040005_022",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n其實，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我們收到的錢不只有這些。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "什麼意思？",
    "voice": "vo_adv_5040005_023",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "這、",
    "voice": "vo_adv_5040005_024",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "這也是你們的？",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "農民2",
    "words": "這些不是我們的錢喔。",
    "voice": "vo_adv_5040005_025",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "農民2",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "農民2",
    "words": "我們是因為看到這些",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "農民2",
    "words": "才決定把錢借給妳們的。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我們在遞送郵件的途中，",
    "voice": "vo_adv_5040005_026",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "不斷地被村人們叫住，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n大家都在問牧場現在到底是什麼狀況。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "然後，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "當我解釋完之後……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "解釋完之後……？",
    "voice": "vo_adv_5040005_027",
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "大家就",
    "voice": "vo_adv_5040005_028",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "紛紛捐了錢給我們……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "咦？　",
    "voice": "vo_adv_5040005_029",
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "為、",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "為什麼事情會變成那樣啊？",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "真陽去兜售過的遠方村落裡的村民，",
    "voice": "vo_adv_5040005_030",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "還有那場戰役時",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "來牧場避難的人們，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "大家都說想要表達他們的感謝之意……",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我明明",
    "voice": "vo_adv_5040005_031",
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "就沒有做什麼值得大家這樣感謝的事……",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "這些錢",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "我不能收下……",
    "voice": null,
    "unit_id": 112811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我也有跟他們說過了。",
    "voice": "vo_adv_5040005_032",
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "要他們等我",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "問過真陽再說。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "\\n",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "可是大家說，",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "栞",
    "words": "我們每個人都只有拿出一點點而已。",
    "voice": null,
    "unit_id": 103811
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "每個人一點點",
    "voice": "vo_adv_5040005_033",
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "就累積成這麼多……？",
    "voice": null,
    "unit_id": 112711
  },
  {
    "type": "dialogue",
    "name": "農民1",
    "words": "因為有非常多人捐贈啊。",
    "voice": "vo_adv_5040005_034",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "農民2",
    "words": "那個人數真的是多得驚人呢。",
    "voice": "vo_adv_5040005_035",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "哎呀～",
    "voice": "vo_adv_5040005_036",
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "你們看，都是你們幾個",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "一直扭扭捏捏的不趕快交出去，",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "結果被人家搶先了呢。",
    "voice": null,
    "unit_id": 102811
  },
  {
    "type": "dialogue",
    "name": "真陽等人",
    "words": "……？",
    "voice": "vo_adv_5040005_037",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "那個呀，",
    "voice": "vo_adv_5040005_038",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "真陽姐姐。",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "\\n我們幾個也一樣，",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "雖然只有一點點，",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "不過……",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
