  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "……！？",
    "voice": "vo_adv_9006726_000",
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "這到底是……！？",
    "voice": "vo_adv_9006726_001",
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n──情況",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "居然回溯了……！？",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "是還原嗎？",
    "voice": "vo_adv_9006726_002",
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "還是重置？",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "……不對──",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "……！",
    "voice": "vo_adv_9006726_003",
    "unit_id": 107412
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……奇、",
    "voice": "vo_adv_9006726_004",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "奇怪……？",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我們，",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "還活著……？",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下記得用盡",
    "voice": "vo_adv_9006726_005",
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "最後的力量保護主人，",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n被光芒吞噬為止的",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "記憶……",
    "voice": null,
    "unit_id": 105911
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我明明以為自己100％死定了。",
    "voice": "vo_adv_9006726_006",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "為什麼……",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "……原來是這樣啊。",
    "voice": "vo_adv_9006726_007",
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "米奈娃小姐……",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "雖然有些驚訝，",
    "voice": "vo_adv_9006726_008",
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "但情況並沒有任何改變。",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "就算憑藉米奈娃的力量，",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "讓你們[rub:復活]回溯100次，[/rub]我也會讓你們在",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n第101次",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "迎來遊戲結束。",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "……沒錯。",
    "voice": "vo_adv_9006726_009",
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "就是這樣。",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "你們當初也是如此，",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "才打倒了那位霸瞳皇帝吧。",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "雖然你們是否有自覺又是另一回事。",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "好啊，",
    "voice": "vo_adv_9006726_010",
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "沒問題。",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n我接受你們的挑戰。",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "面對各位時，",
    "voice": "vo_adv_9006726_011",
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "我心中所感受到的悸動。",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "究竟是為何而生──",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "\\n我真的很想",
    "voice": null,
    "unit_id": 107413
  },
  {
    "type": "dialogue",
    "name": "幻境龍后",
    "words": "一探究竟呢！",
    "voice": null,
    "unit_id": 107413
  }
]
