  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "經歷現實世界的旅行後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "菲歐返回了阿斯特朗世界。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n當她的意識",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "再次甦醒時──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "……嗯……",
    "voice": "vo_adv_1340004_000",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "熟悉的風景、",
    "voice": "vo_adv_1340004_001",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "令人懷念的",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "氣氛──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "──看來我",
    "voice": "vo_adv_1340004_002",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "回來了呢。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "等等，",
    "voice": "vo_adv_1340004_003",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "為什麼啊！",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n我",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "不是原本的模樣了！",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "是晶搞的鬼？",
    "voice": "vo_adv_1340004_004",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n難道出了什麼差錯嗎？",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "真是的……",
    "voice": "vo_adv_1340004_005",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "啊……",
    "voice": "vo_adv_1340004_006",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "那是我平常在說的！",
    "voice": "vo_adv_1340004_007",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "是說，",
    "voice": "vo_adv_1340004_008",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "我費了這麼多功夫才回來，",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "你對我說的第一句話卻是這個！？",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n你只是想說一次看看而已吧！",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "一般而言，這種時候要說──",
    "voice": "vo_adv_1340004_009",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "……",
    "voice": "vo_adv_1340004_010",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "我……",
    "voice": "vo_adv_1340004_011",
    "unit_id": 134011
  },
  {
    "type": "still",
    "still_id": "134000401"
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "我回來了～～～～～！",
    "voice": "vo_adv_1340004_012",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "我好害怕～！",
    "voice": "vo_adv_1340004_013",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n真的好害怕！",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "我第一次用人類的身體，",
    "voice": "vo_adv_1340004_014",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n還被國際刑警追趕，",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n也不知道該怎麼做才好！",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "──而且你也不在！",
    "voice": "vo_adv_1340004_015",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "我真的……",
    "voice": "vo_adv_1340004_016",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "好害怕……！",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "至少有你的聲音陪在我身邊，",
    "voice": "vo_adv_1340004_017",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "真的幫了大忙……！",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "……！",
    "voice": "vo_adv_1340004_018",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "那當然。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n因為我",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "要成為",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "獨當一面的嚮導小妖精嘛。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "這點程度的事，",
    "voice": "vo_adv_1340004_019",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "完全",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "沒有問題♪",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "不過……",
    "voice": "vo_adv_1340004_020",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "再稍微",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "誇獎我一下。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "直到我",
    "voice": "vo_adv_1340004_021",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "說好為止。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "……",
    "voice": "vo_adv_1340004_022",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "呼。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "總算冷靜下來了。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "肩膀",
    "voice": "vo_adv_1340004_023",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "借我一下。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n雖然我不需要你的許可。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "嗯，",
    "voice": "vo_adv_1340004_024",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "這裡",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "果然是我的歸宿。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n畢竟我是你的",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "嚮導小妖精嘛。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "～♪",
    "voice": "vo_adv_1340004_025",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "啊啊……",
    "voice": "vo_adv_1340004_026",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "好安心。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n光是他在身邊就……",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "如果在「另一邊」時，",
    "voice": "vo_adv_1340004_027",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "也有{0}在的話，",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n一定",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "可以",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "玩得更開心吧。",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "雖然很像……",
    "voice": "vo_adv_1340004_028",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "在做白日夢……",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "是因為做了很多勉強的",
    "voice": "vo_adv_1340004_029",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "事情嗎……",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "我覺得……",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "有點睏……",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "就這樣再維持",
    "voice": "vo_adv_1340004_030",
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "一下下──",
    "voice": null,
    "unit_id": 134011
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "菲歐在{0}的肩上，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n慢慢地進入夢鄉。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──然後再次做了夢。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "510220"
  },
  {
    "type": "background",
    "bg_id": "510210"
  },
  {
    "type": "background",
    "bg_id": "510020"
  },
  {
    "type": "background",
    "bg_id": "510240"
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "──等一下啦。",
    "voice": "vo_adv_1340004_031",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "辛苦了。",
    "voice": "vo_adv_1340004_032",
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "我們一起回去吧。",
    "voice": "vo_adv_1340004_033",
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "你是怎麼了？",
    "voice": "vo_adv_1340004_034",
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n看著這裡",
    "voice": null,
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "在發呆。",
    "voice": null,
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "怎～樣～？",
    "voice": "vo_adv_1340004_035",
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n是看我看到入迷了嗎～？",
    "voice": null,
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "說笑的啦～",
    "voice": "vo_adv_1340004_036",
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "那怎麼可能呢。",
    "voice": null,
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n",
    "voice": null,
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "畢竟你都看習慣了。",
    "voice": null,
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "對了，",
    "voice": "vo_adv_1340004_037",
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "我們今天稍微繞點路再回家吧！",
    "voice": null,
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "不准有任何意見！",
    "voice": "vo_adv_1340004_038",
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n",
    "voice": null,
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "來，",
    "voice": null,
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "靜靜地跟著我來吧♪",
    "voice": null,
    "unit_id": 134031
  },
  {
    "type": "background",
    "bg_id": "510330"
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "啊，",
    "voice": "vo_adv_1340004_039",
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "這個玩偶好可愛！",
    "voice": null,
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n",
    "voice": null,
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "可以送我",
    "voice": null,
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "當禮物之類的──",
    "voice": null,
    "unit_id": 134031
  },
  {
    "type": "background",
    "bg_id": "510340"
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "放學後繞遠路",
    "voice": "vo_adv_1340004_040",
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n吃的點心",
    "voice": null,
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "是最棒的呢──",
    "voice": null,
    "unit_id": 134031
  },
  {
    "type": "background",
    "bg_id": "510030"
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "吶，",
    "voice": "vo_adv_1340004_041",
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "要不要對戰一下？",
    "voice": null,
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n",
    "voice": null,
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "也歡迎你故意輸給我喔──",
    "voice": null,
    "unit_id": 134031
  },
  {
    "type": "background",
    "bg_id": "510370"
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "亂花錢要適可而止喔。",
    "voice": "vo_adv_1340004_042",
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n",
    "voice": null,
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "我已經阻止過你了──",
    "voice": null,
    "unit_id": 134031
  },
  {
    "type": "background",
    "bg_id": "510200"
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "風吹得好舒服……♪",
    "voice": "vo_adv_1340004_043",
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n",
    "voice": null,
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "我們坐在長椅上",
    "voice": null,
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "放鬆一下吧──",
    "voice": null,
    "unit_id": 134031
  },
  {
    "type": "background",
    "bg_id": "510390"
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "真是的，",
    "voice": "vo_adv_1340004_044",
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "居然連一束花都沒有準備，",
    "voice": null,
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n",
    "voice": null,
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "你也還差得遠呢──",
    "voice": null,
    "unit_id": 134031
  },
  {
    "type": "background",
    "bg_id": "510100"
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "──呼♪",
    "voice": "vo_adv_1340004_045",
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "玩得真過癮♪",
    "voice": null,
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n你覺得我",
    "voice": null,
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "當嚮導當得怎麼樣？",
    "voice": null,
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "呵呵，",
    "voice": "vo_adv_1340004_046",
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "那當然♪",
    "voice": null,
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "\\n",
    "voice": null,
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "因為我是你的──",
    "voice": null,
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "…………",
    "voice": "vo_adv_1340004_047",
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "呵呵♪",
    "voice": "vo_adv_1340004_048",
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "那麼，",
    "voice": "vo_adv_1340004_049",
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "是時候該回去了。",
    "voice": null,
    "unit_id": 134031
  },
  {
    "type": "background",
    "bg_id": "510080"
  },
  {
    "type": "background",
    "bg_id": "510090"
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "歡迎回來～",
    "voice": "vo_adv_1340004_050",
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "你怎麼啦，",
    "voice": "vo_adv_1340004_051",
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "一臉嚇一跳的樣子。",
    "voice": null,
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "我在這裡很不可思議？",
    "voice": "vo_adv_1340004_052",
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "……你在說什麼啊。",
    "voice": "vo_adv_1340004_053",
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "我可是你的嚮導小妖精。",
    "voice": "vo_adv_1340004_054",
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "不管到哪裡，",
    "voice": "vo_adv_1340004_055",
    "unit_id": 134031
  },
  {
    "type": "dialogue",
    "name": "菲歐",
    "words": "一定都要一直在一起啊♪",
    "voice": null,
    "unit_id": 134031
  },
