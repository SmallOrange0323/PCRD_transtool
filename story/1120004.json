[
  {
    "type": "background",
    "bg_id": "500361"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "新年題字大會結束後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n回到了公會小屋的{0}和凱留，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n享受了短暫的休息時間。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "呼──",
    "voice": "vo_adv_1120004_000",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "新年才剛開始就活動過頭了。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我差不多想休息了。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不知道是不是因為太疲勞的關係，",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "總覺得異常地刺眼……",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊！",
    "voice": "vo_adv_1120004_001",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我說你，",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "似乎又在發光了！",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這道光是……！",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "background",
    "bg_id": "510350"
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "才剛過年而已你就要做配送郵件的打工？",
    "voice": "vo_adv_1120004_002",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n你真的很喜歡工作耶。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "嗯，",
    "voice": "vo_adv_1120004_003",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "新年快樂。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "不過沒什麼值得祝賀的事就是了。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "你問我在做什麼？",
    "voice": "vo_adv_1120004_004",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "沒什麼。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "只是跟家人說我要去新年參拜就出來了，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "然後就這樣到處閒晃而已。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "不管去到哪都是人，真的很煩。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "不說這個了，",
    "voice": "vo_adv_1120004_005",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "既然你都這麼賣力工作了，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n那你肯定有錢吧？　",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "請我吃東西吧。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "啊？　",
    "voice": "vo_adv_1120004_006",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "為什麼你可以毫不猶豫地把現金交出來啊？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "真是莫名其妙。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "雖然感覺你就會這麼說，",
    "voice": "vo_adv_1120004_007",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "但你現在是被逼著要請客耶，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n好歹也露出一點困擾的表情啊。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "啊～真是的！　",
    "voice": "vo_adv_1120004_008",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "算了、",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "算了！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n我說請客只是在開玩笑，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "你別當真啊！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "你問我想吃什麼？",
    "voice": "vo_adv_1120004_009",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我說你",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "到底是有多爛好人啦！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "給我適可而止一點啊！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "說是",
    "voice": "vo_adv_1120004_010",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我在向你討錢，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n感覺更像是我被你施捨一樣，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "真讓人不爽。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "什麼？　",
    "voice": "vo_adv_1120004_011",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "那要不要一起去吃",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "免費的年糕紅豆湯嗎？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "免費的話，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "是可以啦……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "中年女性",
    "words": "新年快樂。",
    "voice": "vo_adv_1120004_012",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "中年女性",
    "words": "\\n來，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "中年女性",
    "words": "這是年糕紅豆湯。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "雖然是免費的，但還滿好吃的，",
    "voice": "vo_adv_1120004_013",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "身體也暖和起來了。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "你別那麼開心地看著我啦。",
    "voice": "vo_adv_1120004_014",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n你什麼也沒做吧……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "雖然是我不讓你做的就是了。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "唉……",
    "voice": "vo_adv_1120004_015",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "這樣仔細一看，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "穿和服的人果然很多呢。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "你問我要不要也去穿和服？　",
    "voice": "vo_adv_1120004_016",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "是很想穿，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "但媽媽不會幫我出那種錢的。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "而且因為媽媽的關係，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我打工也都做不久……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "…………不了，",
    "voice": "vo_adv_1120004_017",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "你做到這種程度，真的很嚇人耶。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "怎麼？　",
    "voice": "vo_adv_1120004_018",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "你在打什麼壞主意嗎？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "如果是那樣的話，感覺反而還比較正常……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "但你不是那種人對吧。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我不會跟你拿錢的。",
    "voice": "vo_adv_1120004_019",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "如果你可以不花錢就讓我穿到和服，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "那我是可以穿啦，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n但那是不可能的吧。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "只要是真的免費就沒關係，",
    "voice": "vo_adv_1120004_020",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n但你知道哪裡有免費的嗎？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "而且，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "大家都說沒有什麼東西比免費的更可怕了……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "喂！？",
    "voice": "vo_adv_1120004_021",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n也不聽人說話就自己先走了！！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "background",
    "bg_id": "510100"
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "你把我帶到這種地方來要做什麼？",
    "voice": "vo_adv_1120004_022",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n這裡只是一般的住宅區嘛。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "幹嘛啊？　",
    "voice": "vo_adv_1120004_023",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "要我仔細看？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "什麼？　",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "就算要我仔細看……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n有個攝影工作室的看板呢。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "只是有看板而已，",
    "voice": "vo_adv_1120004_024",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "但怎麼看都像是一般的住宅啊。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "你把我帶到這種地方來，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "該不會是想做什麼奇怪的事吧！？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "啊──！　",
    "voice": "vo_adv_1120004_025",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "你還按下電鈴了！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "來了來了，",
    "voice": "vo_adv_1120004_026",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "久等了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n哎呀。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n我剛才已經收到賀年卡囉……？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "怎麼，",
    "voice": "vo_adv_1120004_027",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "是客人嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "\\n哦，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "怎麼了？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "嗯。",
    "voice": "vo_adv_1120004_028",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "\\n你希望能",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "讓那邊的小姐穿上和服嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "哎呀哎呀……！",
    "voice": "vo_adv_1120004_029",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "你、",
    "voice": "vo_adv_1120004_030",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "你看！　",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "人家這不是很困擾嗎！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "你突然在說什麼啊！？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n給我道歉！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "不是，",
    "voice": "vo_adv_1120004_031",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "不是的。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n我並沒有覺得困擾喔。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "咦……？",
    "voice": "vo_adv_1120004_032",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "我打算再過不久就要收掉工作室了。",
    "voice": "vo_adv_1120004_033",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "\\n雖然已經用非常便宜的價格來出租和服和替人拍攝，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "\\n但還是完全沒有客人來。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "那間車站前的工作室",
    "voice": "vo_adv_1120004_034",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "把客人都搶走了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n要說困擾應該是這件事比較令人困擾吧。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "雖然店都要收了，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n但不覺得會想在最後",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "再拚一下看看嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "是、",
    "voice": "vo_adv_1120004_035",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "是喔……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "但是，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "這樣的話就要用租的了，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n果然不是免費",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "的吧？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "妳什麼都沒聽說嗎？",
    "voice": "vo_adv_1120004_036",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "雖然因為新年已經開始，現在算是有點晚了，",
    "voice": "vo_adv_1120004_037",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n但我有在找",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "能夠幫忙穿和服宣傳的女孩子喔。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n當然，我也會出打工費，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "還可以免費穿喜歡的和服。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "這些話是",
    "voice": "vo_adv_1120004_038",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "我在他送信過來時，跟他聊到的，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "\\n沒想到他竟然會連我這種老人家所說的無聊話",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "都記得這麼清楚呢……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "喂，我說你！",
    "voice": "vo_adv_1120004_039",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n既然是這樣的話，就好好說明過後再帶人過來啊！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "不、",
    "voice": "vo_adv_1120004_040",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "不過，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n既然能穿和服……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "又拿得到打工錢……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n那我現在就可以幫忙去宣傳了……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "哦哦！",
    "voice": "vo_adv_1120004_041",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "\\n真的嗎！？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "那麼，",
    "voice": "vo_adv_1120004_042",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "得趕快讓妳穿上和服了！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "112000401"
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "如、",
    "voice": "vo_adv_1120004_043",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "如何？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n會、",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "會很奇怪嗎？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "可、",
    "voice": "vo_adv_1120004_044",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "可愛！？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n我只有問你有沒有哪裡很奇怪啦！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n很、",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "很可愛",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "是什麼啦！！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "呵呵呵。",
    "voice": "vo_adv_1120004_045",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n是因為真的可愛，他才說可愛的吧。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "很適合妳喔。",
    "voice": "vo_adv_1120004_046",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "是、",
    "voice": "vo_adv_1120004_047",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "是嗎……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "好。",
    "voice": "vo_adv_1120004_048",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "\\n來拍張照",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "當做紀念吧。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "咦！？",
    "voice": "vo_adv_1120004_049",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n拍、",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "拍照！？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "那、",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "那種事，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我還沒做好心理準備……！！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "你很吵耶！！",
    "voice": "vo_adv_1120004_050",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n我知道了啦！！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "是是，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我很可愛！！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "still",
    "still_id": "112000402"
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "咦！？",
    "voice": "vo_adv_1120004_051",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n剛、",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "剛才的拍下來了！？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "是啊。",
    "voice": "vo_adv_1120004_052",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "\\n因為妳剛才露出了最放鬆",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "又好看的表情了喔。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "放、",
    "voice": "vo_adv_1120004_053",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "放鬆……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我只是在生氣而已耶。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "那個，",
    "voice": "vo_adv_1120004_054",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n能夠穿上這麼漂亮的和服，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我當然也覺得很開心……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "…………",
    "voice": "vo_adv_1120004_055",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "但如果想用mimi",
    "voice": "vo_adv_1120004_056",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "來掃描這套和服的話，果然還是不會允許的吧……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "用mimi",
    "voice": "vo_adv_1120004_057",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "掃描和服？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "沒、",
    "voice": "vo_adv_1120004_058",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "沒關係。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n什麼事都",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "沒有。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "都讓妳配合我任性的要求了。",
    "voice": "vo_adv_1120004_059",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "\\n妳也別客氣儘管說吧。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "是、",
    "voice": "vo_adv_1120004_060",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "是嗎？　",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "那個……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "就是……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "只要用這台叫做mimi的裝置掃描這套和服，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n就能在遊戲中穿上同樣的服裝了喔。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我想自己應該沒有機會再穿上這樣的和服了，",
    "voice": "vo_adv_1120004_061",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "所以想說至少能在遊戲中",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "隨時穿上……",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我、",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我說說的",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "而已。",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n這再怎麼說都太厚臉皮了呢！　",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "對不起！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "哦～",
    "voice": "vo_adv_1120004_062",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "在遊戲中穿這套和服啊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老人",
    "words": "\\n很時髦，不錯啊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "也是呢。",
    "voice": "vo_adv_1120004_063",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n這樣就能讓更多的人看見了，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n我想這套和服也會覺得開心吧。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "still",
    "still_id": "112000403"
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "真、",
    "voice": "vo_adv_1120004_064",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "真的？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n可以嗎……？",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "那當然了。",
    "voice": "vo_adv_1120004_065",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "非、",
    "voice": "vo_adv_1120004_066",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "非常謝謝你！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "那、",
    "voice": "vo_adv_1120004_067",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "那個，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "既然都接受這麼多好意了，",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "\\n那我也會",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "努、",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "努力找客人來的……！",
    "voice": null,
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "我會",
    "voice": "vo_adv_1120004_068",
    "unit_id": 106031
  },
  {
    "type": "dialogue",
    "name": "希留耶",
    "words": "非常努力的！！",
    "voice": null,
    "unit_id": 106031
  },
