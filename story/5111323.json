[
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "喔、",
    "voice": "vo_adv_5111323_000",
    "unit_id": 17212
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "喔喔喔、",
    "voice": null,
    "unit_id": 17212
  },
  {
    "type": "dialogue",
    "name": "亞斯來",
    "words": "喔喔喔喔喔喔喔！",
    "voice": null,
    "unit_id": 17212
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "嘖，",
    "voice": "vo_adv_5111323_001",
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "還想說是個討人厭的瘋子，",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "沒想到還挺有毅力的嘛。",
    "voice": null,
    "unit_id": 124911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯……",
    "voice": "vo_adv_5111323_002",
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "如果只論意志的堅強程度，",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n他應該超越了我們至今遇過的強敵。",
    "voice": null,
    "unit_id": 124811
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我們和這傢伙直到最後都沒能相互理解。",
    "voice": "vo_adv_5111323_003",
    "unit_id": 125011
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 125011
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "但是，",
    "voice": null,
    "unit_id": 125011
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我承認他比誰都還要耿直！",
    "voice": null,
    "unit_id": 125011
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "呦～",
    "voice": "vo_adv_5111323_004",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "諾維姆，很帥喔。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "妳要放過他嗎？",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "怎麼可能！",
    "voice": "vo_adv_5111323_005",
    "unit_id": 125011
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "手下留情的話，",
    "voice": null,
    "unit_id": 125011
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "對亞斯來太失禮了！",
    "voice": null,
    "unit_id": 125011
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n",
    "voice": null,
    "unit_id": 125011
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "我要像個壞蛋一樣，",
    "voice": null,
    "unit_id": 125011
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "獲得壓倒性的勝利！",
    "voice": null,
    "unit_id": 125011
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "真不錯，",
    "voice": "vo_adv_5111323_006",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "這樣才是未來的大壞蛋。",
    "voice": null,
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "還用你說！",
    "voice": "vo_adv_5111323_007",
    "unit_id": 125011
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "快，",
    "voice": null,
    "unit_id": 125011
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "你也來吧！",
    "voice": null,
    "unit_id": 125011
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "\\n讓我們這組大壞蛋組合",
    "voice": null,
    "unit_id": 125011
  },
  {
    "type": "dialogue",
    "name": "矛依未",
    "words": "爽快地了結這一切！",
    "voice": null,
    "unit_id": 125011
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "收到，",
    "voice": "vo_adv_5111323_008",
    "unit_id": 106211
  },
  {
    "type": "dialogue",
    "name": "尾狗刀",
    "words": "就聽諾維姆妳的。",
    "voice": null,
    "unit_id": 106211
  }
]
