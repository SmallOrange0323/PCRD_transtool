[
  {
    "type": "background",
    "bg_id": "501472"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "初音等人在除夕夜拯救了蘭德索爾不受隕石撞擊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在那之後，【王宮騎士團】針對騷動，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n向{0}和初音進行偵訊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "禁、",
    "voice": "vo_adv_1284001_000",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "禁止通行的證明書？",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我什麼都不知道呢～",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "呼",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "、",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "咻～",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員",
    "words": "嗯……",
    "voice": "vo_adv_1284001_001",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員",
    "words": "我收到了部下的報告，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員",
    "words": "\\n說在我們不知道的地方有通行管制，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員",
    "words": "但那果然是誤會嗎？",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員",
    "words": "\\n還有什麼隕石，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員",
    "words": "和女孩子變大之類",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員",
    "words": "荒誕無稽的報告呢……",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "就、",
    "voice": "vo_adv_1284001_002",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "就是啊！",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "一定是有什麼誤會啦！",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "對吧？",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "你也是這麼想的吧！",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員",
    "words": "嗯，",
    "voice": "vo_adv_1284001_003",
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員",
    "words": "果然是誤會吧……",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員",
    "words": "\\n弄到這麼晚，真抱歉啊。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員",
    "words": "謝謝你們的協助。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "王宮騎士團員",
    "words": "祝你們新年快樂。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "新年快樂～！",
    "voice": "vo_adv_1284001_004",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "……呼，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "想辦法蒙混過關了呢！",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "……話說，",
    "voice": "vo_adv_1284001_005",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嗯？",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "新年快樂……？",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "咦？",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "難道說，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "新的一年已經到了嗎！？",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "唔哇，",
    "voice": "vo_adv_1284001_006",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "還真的……",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "老早就過了啊～",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "竟然是在偵訊中跨年，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "小初音我也嚇了一跳……",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "再幾個小時就天亮了呢～",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "其他人都早早被釋放了，",
    "voice": "vo_adv_1284001_007",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n小栞現在也正睡得香甜吧～",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我們不小心熬夜了呢……",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "啊……！",
    "voice": "vo_adv_1284001_008",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我想到了一個好主意！",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "機會難得，",
    "voice": "vo_adv_1284001_009",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我們去看元旦日出吧！",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "因為",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "再幾個小時天就要亮了嘛！",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "太棒了～！",
    "voice": "vo_adv_1284001_010",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n感覺興奮起來了～！",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "閃亮亮☆",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "咕～～～",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "一亢奮，",
    "voice": "vo_adv_1284001_011",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "肚子就叫了……",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "這麼說來，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我們什麼東西都沒有吃呢。",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "現在還有時間，",
    "voice": "vo_adv_1284001_012",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我們去吃碗跨年蕎麥麵吧。",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n雖然已經跨完年了，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "但那邊剛好有攤販呢。",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "好好吃！",
    "voice": "vo_adv_1284001_013",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "身體也溫暖起來了，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "好暖和啊～",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "跨年蕎麥麵",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "果然很棒呢～！",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "蕎麥麵店店長",
    "words": "謝謝，",
    "voice": "vo_adv_1284001_014",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "蕎麥麵店店長",
    "words": "能夠聽妳那麼說我很高興喔。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "蕎麥麵店店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "蕎麥麵店店長",
    "words": "跨年蕎麥麵",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "蕎麥麵店店長",
    "words": "有著把去年的災禍都斬斷的含意。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "蕎麥麵店店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "蕎麥麵店店長",
    "words": "如果今年是美好的一年就好了呢。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "哦～",
    "voice": "vo_adv_1284001_015",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "原來是這樣啊。",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "畢竟年底還發生了那種事，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "要是能靠這個好好斬斷就好了呢！",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "蕎麥麵店店長",
    "words": "話說回來，",
    "voice": "vo_adv_1284001_016",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "蕎麥麵店店長",
    "words": "你們在這種時間外出……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "蕎麥麵店店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "蕎麥麵店店長",
    "words": "難道",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "蕎麥麵店店長",
    "words": "小姐你們",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "蕎麥麵店店長",
    "words": "是要去看元旦日出嗎？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "蕎麥麵店店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "蕎麥麵店店長",
    "words": "我有推薦的地點，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "蕎麥麵店店長",
    "words": "要告訴你們嗎？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "真的嗎！？",
    "voice": "vo_adv_1284001_017",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "請務必告訴我們～！",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "蕎麥麵店店長",
    "words": "當然好。",
    "voice": "vo_adv_1284001_018",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "蕎麥麵店店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "蕎麥麵店店長",
    "words": "郊外有一座山丘，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "蕎麥麵店店長",
    "words": "從那裡看到的日出非常漂亮喔。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "蕎麥麵店店長",
    "words": "\\n那邊也有鋪設道路，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "蕎麥麵店店長",
    "words": "所以應該可以輕鬆爬上去。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "蕎麥麵店店長",
    "words": "雖然是手寫的，",
    "voice": "vo_adv_1284001_019",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "蕎麥麵店店長",
    "words": "不過我給你們一張簡易地圖吧。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "蕎麥麵店店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "蕎麥麵店店長",
    "words": "元旦日出",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "蕎麥麵店店長",
    "words": "有祈禱那一年",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "蕎麥麵店店長",
    "words": "能幸福與豐收的含意呢，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "蕎麥麵店店長",
    "words": "\\n你們就去好好欣賞吧。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "謝謝你，",
    "voice": "vo_adv_1284001_020",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "大叔！",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "告訴我們這麼棒的事～",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "那麼",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我們就馬上出發吧。",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n謝謝你的款待！",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "background",
    "bg_id": "500512"
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "到了呢，",
    "voice": "vo_adv_1284001_021",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "推薦的地點。",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "視野也很棒，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "從這裡感覺能看到很壯觀的日出耶～",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "……話雖如此，",
    "voice": "vo_adv_1284001_022",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "在日出之前還有時間呢。",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "機會難得，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我們來回顧去年是怎麼樣的一年吧！",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "有什麼讓你印象深刻的事嗎？",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "啊哈哈，",
    "voice": "vo_adv_1284001_023",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "就是說呢！",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我也一樣。",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n畢竟是才剛發生的事情，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "而且實在太過衝擊，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "腦裡想的都是隕石呢～",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "年底轉眼就過了啊～",
    "voice": "vo_adv_1284001_024",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "這忙碌程度也能夠理解",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "為什麼會被稱為「師走」呢。",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "去年過得這麼驚人的話，",
    "voice": "vo_adv_1284001_025",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "不知道今年會是如何呢。",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "真想一起經歷",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "比破壞隕石還要更驚人的事啊。",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "對了，",
    "voice": "vo_adv_1284001_026",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "你有想好今年希望過個怎麼樣的一年嗎？",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n新年參拜要祈求的事已經決定好了嗎？",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "你今年想努力念書啊？",
    "voice": "vo_adv_1284001_027",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "真是認真呢！",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我要不要也效仿你，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "然後一起念書呢～",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "因為你想啊，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "互相教對方就能開心地努力用功了吧？",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "看來你今年也想努力工作呢！",
    "voice": "vo_adv_1284001_028",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "畢竟你一直都很努力地在打工，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我大概可以理解。",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "人手不足的時候，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "隨時都能告訴我喔。",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我也會幫忙的！",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "咦？",
    "voice": "vo_adv_1284001_029",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "是這樣嗎！？",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n你的意思是想像我一樣，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "能飛起來或者做預知夢嗎？",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n咦～",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "但就算沒有什麼超能力，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我也覺得你已經非常厲害了喔！",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "因為，",
    "voice": "vo_adv_1284001_030",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "你想嘛。",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n我遇到麻煩的時候，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "你總是會幫助我，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "就連年底時也是……",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "啊，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "你是在開玩笑啊。",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "啊哈哈，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嚇我一跳呢。",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我",
    "voice": "vo_adv_1284001_031",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "應該想祈求身體健康",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "或疾病康復吧。",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "果然",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "大家都能健健康康的話，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n光是這樣我就覺得很開心、",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "很幸福了呢。",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我也會祈禱",
    "voice": "vo_adv_1284001_032",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "你可以健健康康的喔！",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "如果這一年彼此的願望都能夠實現就好了呢。",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嗯？",
    "voice": "vo_adv_1284001_033",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "難道你是想睡覺了嗎？",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n你剛剛",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "眼睛有點閉起來了耶？",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "啊啊，",
    "voice": "vo_adv_1284001_034",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "不用那樣揉眼睛",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "來勉強自己清醒啦！",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "畢竟年底一直很忙，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "你也很累了嘛！",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "在日出前",
    "voice": "vo_adv_1284001_035",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "還有時間，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n稍微小睡一下比較好吧？",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "對、",
    "voice": "vo_adv_1284001_036",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "對了，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "你……",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "你來躺在我的腿上吧？",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "你想，",
    "voice": "vo_adv_1284001_037",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我之前也有躺過你的腿，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "這是那個的回禮喔！",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n所以",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "你不需要客氣！",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我沒問題的，",
    "voice": "vo_adv_1284001_038",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我完全不想睡喔！",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n畢竟為了做預知夢，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "已經睡得很多了呢。",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我在日出之前會醒著的，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "你可以放心睡喔！",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "欸嘿嘿，",
    "voice": "vo_adv_1284001_039",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "不客氣。",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "那麼……",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "來吧！",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n我準備好了喔！",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嗯……………………",
