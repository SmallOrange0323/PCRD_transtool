[
  {
    "type": "background",
    "bg_id": "500250"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "為了取得藥草而踏進迷宮的三人。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哇，山裡面竟然有這種地方！",
    "voice": "vo_adv_5002004_000",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n禊想像的探險就是這種感覺！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "這裡曾被過去的人當成要塞來使用。",
    "voice": "vo_adv_5002004_001",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n歷史書裡是這麼寫的……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "咦──！那就是說，也許會藏有寶藏的意思囉？",
    "voice": "vo_adv_5002004_002",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "嗯呼呼呼，說不定會被我們發現哦？",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我覺得這種地方的寶藏，應該很久以前就被盜賊之類的人給找到了吧。",
    "voice": "vo_adv_5002004_003",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "更何況我們的目的是找藥草而不是挖寶吧？",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "我，我明白啦──，就當做個白日夢也沒關係吧！",
    "voice": "vo_adv_5002004_004",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "這地方好像很久沒有人出入了，",
    "voice": "vo_adv_5002004_005",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n就算變成魔物的居所也不奇怪。所以要小心注意──",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哇啊啊啊！鏡華！千萬別動～！",
    "voice": "vo_adv_5002004_006",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "咦？幹嘛突然叫住我！？",
    "voice": "vo_adv_5002004_007",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "鏡華剛剛踩到陷阱的開關了！",
    "voice": "vo_adv_5002004_008",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "誒誒！怎、怎麼辦！那個，那個……",
    "voice": "vo_adv_5002004_009",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "鏡華冷靜點！亂動的話會粉身碎骨哦……",
    "voice": "vo_adv_5002004_010",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "粉、粉身碎骨！？",
    "voice": "vo_adv_5002004_011",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊馬上來救妳！先別亂動……",
    "voice": "vo_adv_5002004_012",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "怎，怎麼這樣……嗚嗚……",
    "voice": "vo_adv_5002004_013",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n我會死在這裡嗎？",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "啊……謝謝你……",
    "voice": "vo_adv_5002004_014",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "禊一定會救我的，一定會沒事的對吧？",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "好，好的……不過，還是有點可怕……",
    "voice": "vo_adv_5002004_015",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "那個，請留在我身邊……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "嗯嗯，這裡要這樣，然後這樣……咦",
    "voice": "vo_adv_5002004_016",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "？",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "什，什麼！怎麼了嗎！？",
    "voice": "vo_adv_5002004_017",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "沒什麼啦！沒事沒事……應該吧。",
    "voice": "vo_adv_5002004_018",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "應該！？",
    "voice": "vo_adv_5002004_019",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "啊啊……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "{0}～……嗚嗚",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "嗚嗚……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "啊！這樣啊！嗯，這裡要這樣然後……好了！",
    "voice": "vo_adv_5002004_020",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n已經沒事了！解除完畢！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "呼……啊，真的耶……好厲害……",
    "voice": "vo_adv_5002004_021",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "嘿嘿～！這種程度，對愛設陷阱的人來說是小事一樁的啦♪",
    "voice": "vo_adv_5002004_022",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "禊……謝謝妳。",
    "voice": "vo_adv_5002004_023",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哪裡哪裡！一直都受到鏡華的幫助嘛。",
    "voice": "vo_adv_5002004_024",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "話說回來，這個迷宮好像有很多陷阱呢……",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "嗯……注意看的話說不定就能發現陷阱……",
    "voice": "vo_adv_5002004_025",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "那好，我來找出陷阱，然後讓禊來解除它們吧！",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "明白！禊拿出全力的話根本易如反掌！",
    "voice": "vo_adv_5002004_026",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "啊，禊，那塊牆壁的顏色是不是很可疑？",
    "voice": "vo_adv_5002004_027",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "嗯嗯！？的確很可疑！",
    "voice": "vo_adv_5002004_028",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n這應該是陷坑吧？大家退後一點！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "妳看，果然是陷坑！",
    "voice": "vo_adv_5002004_029",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n如果沒注意到，一邊摸著牆壁一邊前進的話，就危險了。",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "嗯？腳下似乎有什麼光……啊！",
    "voice": "vo_adv_5002004_030",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n禊，地上有一條線！",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "這種絕對是拉到線就會從兩旁射出箭的陷阱！！",
    "voice": "vo_adv_5002004_031",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n絕對不能拉到哦！要這樣跨過去前進。",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "呼，總算通過陷阱區了吧！",
    "voice": "vo_adv_5002004_032",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "多虧有禊在！還好妳很清楚對應的處置……",
    "voice": "vo_adv_5002004_033",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "是多虧了鏡華把陷阱全都找出來啦！",
    "voice": "vo_adv_5002004_034",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n禊只是幫忙處理而已！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "不對不對是禊！",
    "voice": "vo_adv_5002004_035",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "不是不是，是鏡華～！",
    "voice": "vo_adv_5002004_036",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "鏡華・禊",
    "words": "……噗！",
    "voice": "vo_adv_5002004_037",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鏡華・禊",
    "words": "啊哈哈哈哈哈哈～！",
    "voice": "vo_adv_5002004_038",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "（禊好像能和鏡華好好講話了！？",
    "voice": "vo_adv_5002004_039",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "說不定現在就是道歉的機會！）",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "（進入迷宮以後，感覺就能好好和禊對話了……",
    "voice": "vo_adv_5002004_040",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "要道歉的話，應該要趁現在吧？）",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華・禊",
    "words": "那、那個……！",
    "voice": "vo_adv_5002004_041",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "嗯？剛才的是……",
    "voice": "vo_adv_5002004_042",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "那是，陷阱的開關……哥哥，難道……",
    "voice": "vo_adv_5002004_043",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哥哥大笨蛋──！！！",
    "voice": "vo_adv_5002004_044",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n哇──！！大石頭滾過來了～！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "禊、{0}！",
    "voice": "vo_adv_5002004_045",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n得趕快逃才行！",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "之前才說過一定要注意周遭的情況啊！",
    "voice": "vo_adv_5002004_046",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "呼，呼……啊！裡面有個房間！我們往那裡逃吧！",
    "voice": "vo_adv_5002004_047",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哈、哈……總算，沒事了……",
    "voice": "vo_adv_5002004_048",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "嗯嗯，而且好像剛好到了迷宮的最深處了。",
    "voice": "vo_adv_5002004_049",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n我想從這深處應該可以回到外面……吧……",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "鏡華？怎麼了嗎？",
    "voice": "vo_adv_5002004_050",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "那個，是什麼東西呢……",
    "voice": "vo_adv_5002004_051",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "好像是巨大的油燈……啊啊～！",
    "voice": "vo_adv_5002004_052",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n難道是魔法油燈！？我們發現寶物了嗎！？",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "──咕喔喔喔喔",
    "voice": null,
    "unit_id": 10211
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "！",
    "voice": null,
    "unit_id": 10211
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "動、動了～！",
    "voice": "vo_adv_5002004_053",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "？",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "咿！禊快退後！那不是寶物哦！",
    "voice": "vo_adv_5002004_054",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n這是……魔物啦！",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "欸！這麼大的魔物，光靠我們打不贏吧！？",
    "voice": "vo_adv_5002004_055",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "可，可是，不想辦法處理這頭魔物，就沒辦法到出口啊……",
    "voice": "vo_adv_5002004_056",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n藥草已經近在眼前了說！",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "唔唔……雖然害怕……可是美美在等我們呢！",
    "voice": "vo_adv_5002004_057",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n為了治療美美的病，只好打倒你這傢伙了──！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "禊……",
    "voice": "vo_adv_5002004_058",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "嗯，",
    "voice": null,
    "unit_id": 103611
  },
