[
  {
    "type": "background",
    "bg_id": "500130"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}為了完成在蘭德索爾接下的任務，\\n往大街出發。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "哎呀，你就是接下任務的人？",
    "voice": "vo_adv_1051001_000",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我是委託人，深月。拜託你了哦。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "今天我想採集開在這附近的花朵。",
    "voice": "vo_adv_1051001_001",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n能請你幫忙做這份工作嗎？",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我這樣說你大概也分辨不了採集的目標吧，",
    "voice": "vo_adv_1051001_002",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n所以我先摘了一朵。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這就是那種花唷。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "哎呀……你不能這樣大咧咧地靠近啦。 ",
    "voice": "vo_adv_1051001_003",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n花朵中也是有危險的品種。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這種花的花粉可是有毒的唷？",
    "voice": "vo_adv_1051001_004",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "嚴格來說，是它的花粉對人類有毒……",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "而且在花的下面……仔細看它的莖，有小小的刺對吧？",
    "voice": "vo_adv_1051001_005",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n那裡也是有毒的。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "要是被刺刺到、或是吸入了花粉，",
    "voice": "vo_adv_1051001_006",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n可是會很糟糕的。你採集的時候要注意哦。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "但是呢，這種花的毒很特殊，處理得當的話還能做成藥。",
    "voice": "vo_adv_1051001_007",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "就算是毒也能視用法成為救人的藥，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "你不覺得很棒嗎？",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "說到為什麼我會知道這種事情，",
    "voice": "vo_adv_1051001_008",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n我是個科學家，平常都在研究植物。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "所謂的科學是……",
    "voice": "vo_adv_1051001_009",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "現在還是到此為止吧。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "就算是細小的花粉也會構成危險，",
    "voice": "vo_adv_1051001_010",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n所以要一朵一朵，小心地放進這個玻璃容器裡哦。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "那麼，馬上開始採集吧。",
    "voice": "vo_adv_1051001_011",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n雖然剛才也說過了，你千萬記住要小心點。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……怎麼了？難道出事了？",
    "voice": "vo_adv_1051001_012",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "沒事嗎？讓我來診斷一下。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "別擔心。這種情形我也經常幫人醫治的。",
    "voice": "vo_adv_1051001_013",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "應急處理的話我還是能應付。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……傷口還很淺。這樣的話滲入的毒也不多，",
    "voice": "vo_adv_1051001_014",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "應該馬上就能好。也不需要特別治療呢……",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……話說不只你的手，就連手臂和肩膀也……",
    "voice": "vo_adv_1051001_015",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n出乎意外地強壯呢。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這個嘛？這只是觸診唷。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "你看起來很纖細，卻鍛鍊得很壯呢。",
    "voice": "vo_adv_1051001_016",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n實在是理想的身體…",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "…",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "――你……要不要成為我的實驗品？",
    "voice": "vo_adv_1051001_017",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我想嘗試的藥物和實驗有很多呢。",
    "voice": "vo_adv_1051001_018",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n你來當實驗品的話肯定能試出很好的結果。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "怎麼樣？",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "一點都不可疑哦。",
    "voice": "vo_adv_1051001_019",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "當實驗品也算是一份好工作唷……？",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "你願意考慮嗎？",
    "voice": "vo_adv_1051001_020",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "也就是「好」的意思呢……？我真高興……",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "無賴１",
    "words": "喂庸醫！ 終於找到妳了！",
    "voice": "vo_adv_1051001_021",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "是誰……明明氣氛正好，",
    "voice": "vo_adv_1051001_022",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "竟然有礙事的傢伙來了呢。真可惜……",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我想想，你們是……誰來著？",
    "voice": "vo_adv_1051001_023",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "無賴２",
    "words": "妳可別說忘記了啊！",
    "voice": "vo_adv_1051001_024",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴２",
    "words": "\\n我們是被妳治療過的病人！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……你這麼一說，我還真有點印象呢。",
    "voice": "vo_adv_1051001_025",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "然後呢？你們這些前病人找我有什麼事？",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "無賴１",
    "words": "治療費啊！",
    "voice": "vo_adv_1051001_026",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無賴１",
    "words": "妳這開的是天價，是跟我開玩笑吧！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無賴１",
    "words": "\\n這個價錢誰付得起吧！妳這個骯髒的密醫！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我的確是密醫，但你們也只能依靠我，",
    "voice": "vo_adv_1051001_027",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "到底有什麼立場向我抱怨？",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "要是得被你們抱怨的話還不如不救你們呢。",
    "voice": "vo_adv_1051001_028",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這樣的話你們就可以不用交治療費了 吧？",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "能有命來我這裡就該慶幸了。",
    "voice": "vo_adv_1051001_029",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n只要你們好好工作的話，就應該付得起這個價格唷。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "無賴２",
    "words": "別給我開玩笑了！妳態度好的話我還打算用商量的方式解決， ",
    "voice": "vo_adv_1051001_030",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴２",
    "words": "\\n這樣就只能靠實力來讓妳改變想法！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "就連一般不該幫的我也都幫你們了……",
    "voice": "vo_adv_1051001_031",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "看來得對不知感恩的人必須好好教訓一番呢？",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "無賴１",
    "words": "唔……",
    "voice": "vo_adv_1051001_032",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無賴１",
    "words": "妳是要來開幹嗎！？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "先露出敵意的可是你們。",
    "voice": "vo_adv_1051001_033",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……給我準備好了！",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "無賴２",
    "words": "嗚哇！這風是怎麼回事！？",
    "voice": "vo_adv_1051001_034",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴２",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴２",
    "words": "站不穩腳……！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴１",
    "words": "別亂了陣腳！只不過是風而已！",
    "voice": "vo_adv_1051001_035",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無賴１",
    "words": "\\n這種程度嚇不倒我們的！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無賴２",
    "words": "的確……",
    "voice": "vo_adv_1051001_036",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴２",
    "words": "嘿嘿，竟敢威脅我們。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴２",
    "words": "\\n這次輪到我們出手了！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴１",
    "words": "喔喔！……",
    "voice": "vo_adv_1051001_037",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無賴１",
    "words": "欸，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無賴１",
    "words": "欸？怎麼回事？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無賴１",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無賴１",
    "words": "我的腳怎麼動不了……！？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "無賴２",
    "words": "我、",
    "voice": "vo_adv_1051001_038",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴２",
    "words": "我也是……！我、我的身體也……麻痺了……！？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴２",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴２",
    "words": "不能呼吸……！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "無賴２",
    "words": "咳！咳咳！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "呵呵呵……！果不其然。馬上就奏效了呢。",
    "voice": "vo_adv_1051001_039",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這種花的刺和花粉裡可是有痲痹人體的成分唷。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "然後剛才的那陣風裡呢……",
    "voice": "vo_adv_1051001_040",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n就藏了不少這種花粉哦。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "真的有很多……憑肉眼沒法看見的小花粉。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "吸了這麼多的花粉，你們呼吸困難了吧？",
    "voice": "vo_adv_1051001_041",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n不過放心吧♪ ",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……因為你們再也不用呼吸了♪",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "哎呀，你……",
    "voice": "vo_adv_1051001_042",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "為什麼要擋著我？",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n你站在那裡我可給不了最後一擊哦……",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……呵呵。的確，你說得對呢。",
    "voice": "vo_adv_1051001_043",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "在這裡幹掉他們的話，我可就收不了治療費呢。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這次就放過你們了。記得要向他道謝呢。",
    "voice": "vo_adv_1051001_044",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……還有別忘了交治療費哦？",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "反正花朵也採集好了，我們回城鎮去吧。",
    "voice": "vo_adv_1051001_045",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "用不著擔心他們。過一會毒性就會失效。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n我們走吧。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "background",
    "bg_id": "500011"
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "今天辛苦你了。能早早結束真好呢。",
    "voice": "vo_adv_1051001_046",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "好了。這是今天的報酬唷。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "哎呀，怎麼了？",
    "voice": "vo_adv_1051001_047",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……是哦。你也吸到剛才的花粉了呢。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不只是刺裡的毒，",
    "voice": "vo_adv_1051001_048",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n連花粉也進到體內的話可就相當危險唷。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "你不馬上接受治療的話，說不定會有生命危險。",
    "voice": "vo_adv_1051001_049",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n雖然我能治好你……",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這樣吧，你要是能常常來幫我做實驗的話，",
    "voice": "vo_adv_1051001_050",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n我現在就馬上治好你。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "有像你這樣年輕健康的男孩子來當實驗品的話，",
    "voice": "vo_adv_1051001_051",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n我的研究肯定能有很大的進展。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "怎麼樣？",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "呵呵……成交。",
    "voice": "vo_adv_1051001_052",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "那麼現在就給你治療。別動哦……",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……應該沒問題了。",
    "voice": "vo_adv_1051001_053",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n……嗯，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "身體也能動了呢。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "幸好及時治療了呢……別忘了我們的約定哦？",
    "voice": "vo_adv_1051001_054",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n呵呵呵……",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "接下來的實驗真讓人期待♪",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "看著深月妖豔的微笑，\\n{0}感到在廣闊的城鎮中也無路可逃。",
    "voice": null,
    "unit_id": null
  }
]
