  {
    "type": "dialogue",
    "name": "旁白",
    "words": "數日後。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n平安結束旅程的可璃亞和安涅默涅，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n還有{0}他們，再次來到了海邊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "然而──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "來，",
    "voice": "vo_adv_5207007_000",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "默涅呀？",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n讓奴家",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "看看汝可愛臉蛋。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "──我不要。",
    "voice": "vo_adv_5207007_001",
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我說，可璃亞～？",
    "voice": "vo_adv_5207007_002",
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n這裡有很漂亮的貝殼，",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "要不要一起去撿呢？",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我、",
    "voice": "vo_adv_5207007_003",
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我不要……！",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "跟哥哥一起",
    "voice": "vo_adv_5207007_004",
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "吃蘋果糖……",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "啊！",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n呃，",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "那個……",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "對不起！",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……連{0}\\n用食物吸引也行不通啊……",
    "voice": "vo_adv_5207007_005",
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "居然連兄長大人的話都不願聽……",
    "voice": "vo_adv_5207007_006",
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "璃亞",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "竟然會這麼生氣……",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "──呦呦呦。",
    "voice": "vo_adv_5207007_007",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家的默涅",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "亦進入叛逆期了。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "因為",
    "voice": "vo_adv_5207007_008",
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "她們發現我們一直跟在後面，",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "才會變成這樣嘛──",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "換作是我，我也會害羞得要死吧。",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "background",
    "bg_id": "501682"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "沒有屈服於{0}他們的誘惑，\\n可璃亞和安涅默涅很不高興（？）。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n這理由",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "要回溯到旅程的最後一天。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "保險起見，我巡視了附近一帶，",
    "voice": "vo_adv_5207007_009",
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "看來魔物們都已經不見了。",
    "voice": null,
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這下終於能好好從旁守護了。",
    "voice": "vo_adv_5207007_010",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好了，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那兩人現在怎麼樣了呢……",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "咦，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "奇怪？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "可璃亞、安涅默涅",
    "words": "…………",
    "voice": "vo_adv_5207007_011",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "等等，怎麼回事，",
    "voice": "vo_adv_5207007_012",
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "發生了什麼事嗎？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n她們好像不知不覺間重修舊好──",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不僅如此，",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n還變得比之前更親近了！？",
    "voice": null,
    "unit_id": 106012
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "──呵呵。",
    "voice": "vo_adv_5207007_013",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n在咱們沒注意的期間，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n她們抵達了應當前往的地方，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "就是這麼回事吧。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "那",
    "voice": "vo_adv_5207007_014",
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "個──",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "那麼，",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "我們回去吧。",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "說、",
    "voice": "vo_adv_5207007_015",
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "說得也是！",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n就算再三保證我們沒問題，",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "旅行了那麼長的時間，",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "大家都會擔心吧。",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "那麼，",
    "voice": "vo_adv_5207007_016",
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "安涅默涅小姐──",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "直接叫名字──",
    "voice": "vo_adv_5207007_017",
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "就好了。",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "咦？",
    "voice": "vo_adv_5207007_018",
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "名字──",
    "voice": "vo_adv_5207007_019",
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "我們，",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "是朋友吧？",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "安涅默涅小姐……！",
    "voice": "vo_adv_5207007_020",
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n……",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "不對……♪",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "那麼，",
    "voice": "vo_adv_5207007_021",
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "我可以叫妳",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "「默涅」嗎？",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "也請妳叫我",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "璃亞♪",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "……我知道了。",
    "voice": "vo_adv_5207007_022",
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "\\n",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "那個──",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "──璃亞。",
    "voice": "vo_adv_5207007_023",
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "嗯……♪",
    "voice": "vo_adv_5207007_024",
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "璃亞……！",
    "voice": "vo_adv_5207007_025",
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n……真是太好了。",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "一時之間還擔心事情會變成怎樣……",
    "voice": null,
    "unit_id": 125812
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "欲締結友誼，",
    "voice": "vo_adv_5207007_026",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "往往難免波折。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "因誤會終究在所難免。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "然而……",
    "voice": "vo_adv_5207007_027",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "哎呀？",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n──唔嗯。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家實在粗心大意……",
    "voice": "vo_adv_5207007_028",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n恁們啊。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n要鬆懈",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "恐怕為時尚早。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "──你們，",
    "voice": "vo_adv_5207007_029",
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "安涅默涅",
    "words": "在這裡做什麼。",
    "voice": null,
    "unit_id": 135411
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "「『啊……』」\\n「哎呀。」",
    "voice": "vo_adv_5207007_030",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "連哥哥都在，",
    "voice": "vo_adv_5207007_031",
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "為什麼大家會在這裡……",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n…………",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "難、",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "難道…………！",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "background",
    "bg_id": "500163"
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "簡直",
    "voice": "vo_adv_5207007_032",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "猶如怒髮衝冠。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
