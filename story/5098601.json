  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\nいいですかー？",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "なによ。",
    "voice": "vo_adv_5082601_001",
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "まさか料理が足りないとか言うんじゃないでしょうね。",
    "voice": null,
    "unit_id": 112011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "違いますよ！",
    "voice": "vo_adv_5082601_002",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\nせっかくみんな集まったんですから、",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n記念撮影をしようと思って！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "大変素敵なアイデアでございます。",
    "voice": "vo_adv_5082601_003",
    "unit_id": 111911
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "記念撮影……",
    "voice": "vo_adv_5082601_004",
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "はい！",
    "voice": "vo_adv_5082601_005",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "今日のこの思い出を、",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "バッチリ写真に残しちゃいましょう！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "ええ。",
    "voice": "vo_adv_5082601_006",
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "\\n思い出の写真、",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "シェフィ",
    "words": "とっても楽しみだわ。",
    "voice": null,
    "unit_id": 120711
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "えへへ。",
    "voice": "vo_adv_5082601_007",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "それじゃあみなさん、",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "集合してくださーい！",
    "voice": null,
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "はい、",
    "voice": "vo_adv_5082601_008",
    "unit_id": 111811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
