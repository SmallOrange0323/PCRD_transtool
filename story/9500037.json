[
  {
    "type": "background",
    "bg_id": "509040"
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "……咦？",
    "voice": "vo_adv_9500037_000",
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我？",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n你說要選我，",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "是認真的嗎！？",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "畢竟",
    "voice": "vo_adv_9500037_001",
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我是個怕麻煩的人，",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "還老是偷懶喔？",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n而且至今為止，",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我可是一直在給你添麻煩耶？",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n然而──",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "那……",
    "voice": "vo_adv_9500037_002",
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "那還用說！",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n因為你是個「好人」，",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n所以就算是麻煩事，",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我也會想努力看看──",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "……說什麼",
    "voice": "vo_adv_9500037_003",
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "「也」，",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "居然順勢把我也算進去了。",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我可能是說過",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "「要好好照顧我到最後」",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "啦──",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "不過……",
    "voice": "vo_adv_9500037_004",
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我只能看到自己變成累贅的未來。",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n我也無法一直努力下去，",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "萬一……",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "萬一被你拋棄的話──",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "哈哈，",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "這次可能真的就要",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "關在家裡不出來了。",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "……{0}。",
    "voice": "vo_adv_9500037_005",
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "對不起。",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "現在最努力的，",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "毫無疑問是你呢。",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "那麼，",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我也趁機說一下吧……",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "既然你選擇了我，",
    "voice": "vo_adv_9500037_006",
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "那我也想努力看看。",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "雖然要想",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "未來那些有的沒的很累，",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "但只有現在的話，",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我還是能努努力的。",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "不過，",
    "voice": "vo_adv_9500037_007",
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "當我累了的時候，",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "你要寵我喔。",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n這樣的話，",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我就會覺得明天又能繼續努力了。",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "還有──",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "你累了的時候，",
    "voice": "vo_adv_9500037_008",
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "也要乖乖來找我撒嬌喔？",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "不然的話，",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "感覺就不公平了。",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我，",
    "voice": "vo_adv_9500037_009",
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "總是對自己感到很失望。",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "不過，",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我覺得……",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n「能為了你努力的我」",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "其實還挺不錯呢！",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "所以，",
    "voice": "vo_adv_9500037_010",
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "我們一人一半吧！",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n不管是快樂的時候，",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "還是難受的時候，",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "當然，",
    "voice": null,
    "unit_id": 102641
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "紅豆麵包也要喔♪",
    "voice": null,
    "unit_id": 102641
  }
]
