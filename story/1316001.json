  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "兄長大人，",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "我們差不多該結束休息了。",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "可不能讓店長先生和客人們等待。",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "我們走吧。",
    "voice": "vo_adv_1316001_072",
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n為了不輸給兄長大人的努力，",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n我也會全心全意",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "精進自己的。",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "……雖然若意識到自身姿態時，",
    "voice": "vo_adv_1316001_073",
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "還是會感到害羞。",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "但那也僅是",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "很些微的感受。",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "在這夏日海灘的非日常中，",
    "voice": "vo_adv_1316001_074",
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n待於兄長大人身旁的",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "心理準備。",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "……呵呵♪",
    "voice": "vo_adv_1316001_075",
    "unit_id": 131611
  },
  {
    "type": "still",
    "still_id": "131600102"
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "歡迎光臨！",
    "voice": "vo_adv_1316001_076",
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n請問是兩位嗎？",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "請坐那邊的位子……♪",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "莉莉萌生了要面對夏日困惑的想法。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n而海邊的太陽則燦爛地照耀著這樣她。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "end"
  }
]
