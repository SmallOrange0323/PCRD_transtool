[
  {
    "type": "dialogue",
    "name": "倭",
    "words": "讓正在逃跑的小偷轉向回頭。",
    "voice": "vo_adv_5156301_000",
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n",
    "voice": null,
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "別以為能全身而退！",
    "voice": null,
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n妳們，",
    "voice": null,
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "給我上…………",
    "voice": null,
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "嗯？",
    "voice": null,
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "啊～",
    "voice": "vo_adv_5156301_001",
    "unit_id": 130211
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "踩到恐龍的便便了～ｗ",
    "voice": null,
    "unit_id": 130211
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 130211
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "笨菜姊好髒哦ｗ",
    "voice": null,
    "unit_id": 130211
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "而且好臭ｗ",
    "voice": null,
    "unit_id": 130211
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "啊～",
    "voice": "vo_adv_5156301_002",
    "unit_id": 130111
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "布武機好過分～",
    "voice": null,
    "unit_id": 130111
  },
  {
    "type": "dialogue",
    "name": "若菜",
    "words": "\\n知道那裡有大便為什麼不跟我說～！",
    "voice": null,
    "unit_id": 130111
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "我說妳們，",
    "voice": "vo_adv_5156301_003",
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "是要玩到什麼時候！",
    "voice": null,
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n沒用的妹妹就該抓來打屁股──",
    "voice": null,
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "\\n我會在小子面前，",
    "voice": null,
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "倭",
    "words": "讓妳們的屁股亮相啊！",
    "voice": null,
    "unit_id": 130011
  },
  {
    "type": "dialogue",
    "name": "布武機、若菜",
    "words": "「因為～笨菜姊她～！」\\n「因為～布武機她～！」",
    "voice": "vo_adv_5156301_004",
    "unit_id": null
  }
]
