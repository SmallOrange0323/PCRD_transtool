    "voice": "vo_adv_9013003_000",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "薇歐莉特妳看！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n這個是泳裝吧？",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "明明是冬天卻有賣泳裝，",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "真厲害！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "哎呀，",
    "voice": "vo_adv_9013003_001",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "真的耶……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "從店家的銷售文案來看，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n「說到冬天就是盛夏」",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "這句話，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "似乎是宣傳標語呢。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "這也是",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "蘭德索爾特有的文化嗎。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "一定是這樣沒錯！",
    "voice": "vo_adv_9013003_002",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "國際博覽會不只很有趣，",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "還能學到很多東西，真開心♪",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "是啊，",
    "voice": "vo_adv_9013003_003",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "而且……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "謝謝您，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "克蘿茜小姐。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n您答應陪同我，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "真是幫了大忙。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "嘿嘿，",
    "voice": "vo_adv_9013003_004",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "我也要說謝謝呢。",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "因為我想和薇歐莉特",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "增進感情♪",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "我們一起",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "盡情享受國際博覽會吧！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "background",
    "bg_id": "500033"
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "哇～",
    "voice": "vo_adv_9013003_005",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "大家都好開心地跳著舞♪",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "我也要去和大家一起跳舞！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "薇歐莉特要不要一起來？",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "不了，",
    "voice": "vo_adv_9013003_006",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "我……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "不太擅長",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "舞動身體。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "我就來欣賞大家跳舞的樣子吧……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "我知道了！",
    "voice": "vo_adv_9013003_007",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n請好好看著",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "我的舞姿喔！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "克蘿茜，",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "出發～！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "扒手",
    "words": "呵呵呵……",
    "voice": "vo_adv_9013003_008",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "扒手",
    "words": "我是專業的扒手。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "扒手",
    "words": "多虧了祭典，工作進展得很順利。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "扒手",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "扒手",
    "words": "哦唷？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "扒手",
    "words": "那位穿洋裝的小姐，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "扒手",
    "words": "毫無警戒心啊。",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "扒手",
    "words": "\\n她的錢包，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "扒手",
    "words": "我就收下了～！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "扒手",
    "words": "……嗯？",
    "voice": "vo_adv_9013003_009",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "扒手",
    "words": "錢包上掛著什麼東西……",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "扒手",
    "words": "\\n",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "扒手",
    "words": "噫噫噫！！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "扒手",
    "words": "這是什麼，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "扒手",
    "words": "手、",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "扒手",
    "words": "手！？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "啊……",
    "voice": "vo_adv_9013003_010",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "我、",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "我的手，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "還有我的錢包……！？",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "不、",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "不可以，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "請還給我……！",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "咦，",
    "voice": "vo_adv_9013003_011",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "是小偷嗎！？",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n必須趕快抓住才行……",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "火箭拳，",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "捕捉模式！！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "扒手",
    "words": "嗚呀啊啊啊啊啊！！！",
    "voice": "vo_adv_9013003_012",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "謝謝您，",
    "voice": "vo_adv_9013003_013",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "克蘿茜小姐……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n重要的東西",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "差點就要被拿走了。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "嘿嘿，",
    "voice": "vo_adv_9013003_014",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "沒事就好！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "如果弄丟就糟糕了呢。",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "我偶爾，",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "也會因為把零件弄丟而被罵唷！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "哎呀……",
    "voice": "vo_adv_9013003_015",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "說得是呢。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n我們彼此",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "都小心留意身體吧。",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "好的！",
    "voice": "vo_adv_9013003_016",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "那我們接下來要去哪──",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "嗶、",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "嗶嗶……",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "……克蘿茜小姐，",
    "voice": "vo_adv_9013003_017",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "怎麼了嗎？",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n剛剛的聲音是……",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "抱歉！",
    "voice": "vo_adv_9013003_018",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n在祭典上玩得太過頭……",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "能量好像快用完了。",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n要進入睡眠模式了。",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "怎麼會，",
    "voice": "vo_adv_9013003_019",
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "要在這種地方睡嗎……？",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "該怎麼做才能治好呢？",
    "voice": null,
    "unit_id": 133111
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "這個嘛，",
    "voice": "vo_adv_9013003_020",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "平時都是透過萊拉耶爾大人的皇家裝備，",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n來補充能量。",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n還有，",
    "voice": null,
