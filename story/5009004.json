[
  {
    "type": "background",
    "bg_id": "500120"
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "綾音～！",
    "voice": "vo_adv_5009004_000",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n沒沒沒、",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "沒事吧？",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "啊，胡桃，幫幫我！",
    "voice": "vo_adv_5009004_001",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "噗吉要被吃掉了！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "什麼……？",
    "voice": "vo_adv_5009004_002",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "嗚呀，",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "那個叫千歌的人在咬噗吉……！",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "啊呣啊呣……♪",
    "voice": "vo_adv_5009004_003",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "與其說是咬，",
    "voice": "vo_adv_5009004_004",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不如說在品嘗它？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "妳在做什麼啊千歌，是肚子餓了嗎？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n妳剛才吃了很多不是嗎，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "都把鍋子吃得精光了！",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不可以啦，",
    "voice": "vo_adv_5009004_005",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "偶像要好好注意飲食才行！",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "吃這種玩偶會弄壞肚子的，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "應該有滿滿的細菌，還會無法消化！",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "才沒有滿滿的細菌呢！",
    "voice": "vo_adv_5009004_006",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n我都有好好的清洗……",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "不對，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "是偶爾會帶牠一起洗澡！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "還有，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "噗吉不是玩偶，牠是我重要的家人～！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "噫，",
    "voice": "vo_adv_5009004_007",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "對不起喔？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "對小孩子而言，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "玩偶也算是家人呢……？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "就跟妳說它才不是玩偶！",
    "voice": "vo_adv_5009004_008",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "噗吉是我真正的爸爸和媽媽",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n為了不讓我寂寞而帶來的朋友，也是我的家人啊～！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我沮喪的時候，",
    "voice": "vo_adv_5009004_009",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n噗吉都會用可靠的聲音安慰我！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n我哭泣的時候，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "就會用毛絨絨的手手幫我擦眼淚！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "跟我說「別哭了，綾音，明天一定會是很棒的一天」……",
    "voice": "vo_adv_5009004_010",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n還有說「哭了就太浪費小美女的臉了」，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "只有噗吉每次會這樣對我說。",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "可是。",
    "voice": "vo_adv_5009004_011",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "從剛才開始，噗吉就不說話了～！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "我聽不見牠的聲音了～",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "為什麼？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "難道跟假的爸爸和媽媽，",
    "voice": "vo_adv_5009004_012",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "還有醫生說的一樣，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n這一切都是我的幻想嗎？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "難道說，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "聽不見噗吉的聲音才是正常的嗎？",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "才不是呢，",
    "voice": "vo_adv_5009004_013",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "噗吉是有生命而且會說話的！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n我聽得見！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "可是，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "可是現在，",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "噗吉都不說話了啦～！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這、",
    "voice": "vo_adv_5009004_014",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這是怎麼回事……？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "雖然不知道怎麼回事，",
    "voice": "vo_adv_5009004_015",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "但先冷靜一下，綾音……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "沒事的……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "我和{0}哥哥，",
    "voice": "vo_adv_5009004_016",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n家人會永遠和妳在一起……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n妳並不寂寞喔……",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "好乖好乖♪",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "嗚嗚嗚嗚，",
    "voice": "vo_adv_5009004_017",
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "胡桃～！",
    "voice": null,
    "unit_id": 102311
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "啊哈哈。",
    "voice": "vo_adv_5009004_018",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "抱在一起了……",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n這些孩子",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "平常都是這樣互相扶持的吧。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "真好啊，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "好羨慕。",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "可是，",
    "voice": "vo_adv_5009004_019",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我們【慈樂之音】，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n也能慢慢建立感情，變得像重要的家人一樣吧？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "成為一起哭一起笑，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "能夠共享感動、無法取代的夥伴！",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "千歌！",
    "voice": "vo_adv_5009004_020",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "　不要再調皮了，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "小噗吉……",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "噗吉君？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不要吃綾音重要的家人，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n偶像怎麼可以把小孩子弄哭呢！？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "嗚……？",
    "voice": "vo_adv_5009004_021",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "嗚、嗚嗚～？",
    "voice": "vo_adv_5009004_022",
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "嗚嗚嗚嗚……！",
    "voice": null,
    "unit_id": 104211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "咦咦？",
    "voice": "vo_adv_5009004_023",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "　等等，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "為什麼要哭啊？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "對不起，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我話說得太過分了！",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "真的對不起，",
    "voice": "vo_adv_5009004_024",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我老是那麼自以為是！　",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我會道歉的，請原諒我！",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n但是我能教妳的，只有偶像的事，",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n我會努力的教妳的……！",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "小望姐姐！",
    "voice": "vo_adv_5009004_025",
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n對在哭的孩子，就要抱緊她然後摸摸頭，",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n像這樣……♪",
    "voice": null,
    "unit_id": 102111
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯，",
    "voice": "vo_adv_5009004_026",
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "為什麼連{0}\\n都理所當然的抱住綾音了？",
    "voice": null,
    "unit_id": 102913
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我沒有別的意思，",
    "voice": "vo_adv_5009004_027",
