  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "那個……",
    "voice": null,
    "unit_id": 104541
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n難道說空花",
    "voice": null,
    "unit_id": 104541
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "正在做夢嗎……？",
    "voice": null,
    "unit_id": 104541
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "啊，",
    "voice": "vo_adv_9500055_001",
    "unit_id": 104541
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "空花",
    "voice": null,
    "unit_id": 104541
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "知道了！",
    "voice": null,
    "unit_id": 104541
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104541
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "是虐待狂先生不知何時下了安眠藥，",
    "voice": null,
    "unit_id": 104541
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n要讓空花做一個稱心如意的夢吧！？",
    "voice": null,
    "unit_id": 104541
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "就是那樣沒錯！",
    "voice": "vo_adv_9500055_002",
    "unit_id": 104541
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n因為你看，",
    "voice": null,
    "unit_id": 104541
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "就算拍打自己的大腿……",
    "voice": null,
    "unit_id": 104541
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n好痛！",
    "voice": null,
    "unit_id": 104541
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "就算是自己打的，",
    "voice": null,
    "unit_id": 104541
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "還是相當痛啊！？",
    "voice": null,
    "unit_id": 104541
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "……咦？",
    "voice": "vo_adv_9500055_003",
    "unit_id": 104541
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n意思就是，",
    "voice": null,
    "unit_id": 104541
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "虐待狂先生",
    "voice": null,
    "unit_id": 104541
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "選擇了空花的這件事……",
    "voice": null,
    "unit_id": 104541
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "雖然很開心，",
    "voice": "vo_adv_9500055_004",
    "unit_id": 104541
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "但這是真的嗎？",
    "voice": null,
    "unit_id": 104541
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "是空花沒錯吧？",
    "voice": null,
    "unit_id": 104541
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n如果是人格異常的虐待狂先生，",
    "voice": null,
    "unit_id": 104541
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n就算來個假告白整人，也沒什麼好奇怪的……",
    "voice": null,
    "unit_id": 104541
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "啊，",
    "voice": "vo_adv_9500055_005",
    "unit_id": 104541
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "這是真的吧。",
    "voice": null,
    "unit_id": 104541
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104541
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "那個……",
    "voice": null,
    "unit_id": 104541
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "空、",
    "voice": null,
    "unit_id": 104541
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "空花好",
    "voice": null,
    "unit_id": 104541
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "開心……",
    "voice": null,
    "unit_id": 104541
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "如果是虐待狂先生，",
    "voice": "vo_adv_9500055_006",
    "unit_id": 104541
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104541
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "不是會說「不一一說明妳就不懂嗎？",
    "voice": null,
    "unit_id": 104541
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n那",
    "voice": null,
    "unit_id": 104541
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "我就在妳那具身體上留下我專用的證明吧。」",
    "voice": null,
    "unit_id": 104541
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "……之類的，",
    "voice": "vo_adv_9500055_007",
    "unit_id": 104541
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "然後強行侵犯空花嗎……！？",
    "voice": null,
    "unit_id": 104541
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104541
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "空花",
    "voice": null,
    "unit_id": 104541
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "是這樣期待的，",
    "voice": null,
    "unit_id": 104541
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "所以坦白說，這個發展出乎我意料。",
    "voice": null,
    "unit_id": 104541
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n不過……",
    "voice": null,
    "unit_id": 104541
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "嗯。",
    "voice": null,
    "unit_id": 104541
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "空花",
    "voice": "vo_adv_9500055_008",
    "unit_id": 104541
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "喜歡……",
    "voice": null,
    "unit_id": 104541
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "虐待狂先生。",
    "voice": null,
    "unit_id": 104541
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n",
    "voice": null,
    "unit_id": 104541
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "虐待狂先生",
    "voice": null,
    "unit_id": 104541
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "對空花很隨便，",
    "voice": null,
    "unit_id": 104541
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "會羞辱空花，",
    "voice": null,
    "unit_id": 104541
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n也會進行放置不理的玩法……",
    "voice": null,
    "unit_id": 104541
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "而且，",
    "voice": null,
    "unit_id": 104541
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "也會對空花溫柔……",
    "voice": null,
    "unit_id": 104541
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "嘻嘻嘻……",
    "voice": null,
    "unit_id": 104541
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "所以……",
    "voice": "vo_adv_9500055_009",
    "unit_id": 104541
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "\\n空花",
    "voice": null,
    "unit_id": 104541
  },
  {
    "type": "dialogue",
    "name": "空花",
    "words": "一輩子都是虐待狂先生的",
    "voice": null,
