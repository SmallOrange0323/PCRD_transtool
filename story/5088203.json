  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "終於打倒了……",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n還真是難纏呢。",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "手下不斷從後方跑出來……",
    "voice": "vo_adv_5088203_001",
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "\\n",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "讓我很擔心不知何時才能結束呢。",
    "voice": null,
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "總之，",
    "voice": "vo_adv_5088203_002",
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "是我們贏了！",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "……話說",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "雖然很想開心慶祝一下，",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "但看來還有份工作等我們善後呢。",
    "voice": null,
    "unit_id": 121411
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "都做這麼多了，",
    "voice": "vo_adv_5088203_003",
    "unit_id": 121311
  },
  {
    "type": "dialogue",
    "name": "胡桃",
    "words": "就繼續一起加油吧！",
    "voice": null,
    "unit_id": 121311
  }
