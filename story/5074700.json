  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "【ドラゴンズネスト】の3人はドラモに会うため、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "\\nまたしてもエルピス島の密林にある遺跡を訪れていた。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "ドラちゃ～ん！",
    "voice": "vo_adv_5064700_000",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\nイノリ様が来てやったですよ～！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "出てこねえな……",
    "voice": "vo_adv_5064700_001",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "\\nなあボス、",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "見えるか？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "いるにはいるみたいなんだけど……",
    "voice": "vo_adv_5064700_002",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "\\n出てこないね～？",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "オレたちのこと忘れてるんじゃないか？",
    "voice": "vo_adv_5064700_003",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "そんなことないですよ！",
    "voice": "vo_adv_5064700_004",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\nドラちゃんはあたしに似て賢いから絶対覚えてるですよ！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "っていっても、",
    "voice": "vo_adv_5064700_005",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "出てこないじゃんか。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "これじゃ買ってきた土産も無駄に……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "ドラゴンもどき",
    "words": "ぐもあげ！　",
    "voice": "vo_adv_5064700_006",
    "unit_id": 12311
  },
  {
    "type": "dialogue",
    "name": "ドラゴンもどき",
    "words": "ぐぉも！",
    "voice": null,
    "unit_id": 12311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "出てきた！　",
    "voice": "vo_adv_5064700_007",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "ドラちゃん久しぶりですよ～！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "ホラ、",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "言った通りです！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "今、",
    "voice": "vo_adv_5064700_008",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "イノリより土産のほうに反応して出てきたよな？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "まあまあ、",
    "voice": "vo_adv_5064700_009",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "それは黙っててあげよ？",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "よーしよしよし、",
    "voice": "vo_adv_5064700_010",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "このチョコを食べるですよ！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "ドラゴンもどき",
    "words": "ぐぉも、",
    "voice": "vo_adv_5064700_011",
    "unit_id": 12311
  },
  {
    "type": "dialogue",
    "name": "ドラゴンもどき",
    "words": "ぐも！",
    "voice": null,
    "unit_id": 12311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "カヤぴぃ！　",
    "voice": "vo_adv_5064700_012",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "ボス！　",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "今の聞いたですか？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "なんか言ってたっぽいな。",
    "voice": "vo_adv_5064700_013",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "確かに、",
    "voice": "vo_adv_5064700_014",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "だいぶ言葉を覚えてきてるみたいだね～☆",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "\\n会話も出来そうかな？",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "ドラちゃん！　",
    "voice": "vo_adv_5064700_015",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "なにか言ってやるですよ！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "ドラゴンもどき",
    "words": "ぐぉも、",
    "voice": "vo_adv_5064700_016",
    "unit_id": 12311
  },
  {
    "type": "dialogue",
    "name": "ドラゴンもどき",
    "words": "もっも！",
    "voice": null,
    "unit_id": 12311
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "……チョコ、",
    "voice": "vo_adv_5064700_017",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "もっと……って言ったのか？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "おお！　",
    "voice": "vo_adv_5064700_018",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "通じた！　",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "通じたですよ！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "う～ん……",
    "voice": "vo_adv_5064700_019",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "でも、",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "遺跡に関しては\\nまだよくわかんないところが多いですね。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "結局細かいところはわからないままか。",
    "voice": "vo_adv_5064700_020",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "さっきのも単にコイツの食い意地が張ってて\\nたまたま覚えただけじゃないか？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "そんなことないですよ！",
    "voice": "vo_adv_5064700_021",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\nドラちゃんはちゃんとやればできる子です！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "じゃあ～、",
    "voice": "vo_adv_5064700_022",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "もっと単語を覚えさせてみよっか？",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "そうすればもっとわかりやすくなるかも～♪",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "いーですよ！　",
    "voice": "vo_adv_5064700_023",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "やってやろうじゃないですか！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\nこの辺探せば新しい石版も落ちてるはずですし！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "はぁ～？　",
    "voice": "vo_adv_5064700_024",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "またやんのかよ？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "ふふーん、",
    "voice": "vo_adv_5064700_025",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "カヤぴぃやっぱり恐れてるですね？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\nドラちゃんとあたしの知性を！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "ドラゴンもどき",
    "words": "ぐもーりんぐもももも！",
    "voice": "vo_adv_5064700_026",
    "unit_id": 12311
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "言ってることはわかんねえがバカにしてんのはよくわかったぜ……",
    "voice": "vo_adv_5064700_027",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "いいぜ、",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "やってやらぁ！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "\\n今度こそどっちの頭が上かわからせてやるよ！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "うんうん、",
    "voice": "vo_adv_5064700_028",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "カヤちゃんもやる気だね。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "\\nそれじゃ、",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "石版集め開始だよ～！",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "やってやるですよ！！",
    "voice": "vo_adv_5064700_029",
    "unit_id": 106611
  },
  {
    "type": "background",
    "bg_id": "500520"
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "石版を集めたイノリはドラモに言葉を教える。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "\\nそして数日後……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500850"
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "時は来たですよ！",
    "voice": "vo_adv_5064700_030",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "ドラゴンもどき",
    "words": "ぐもももも！",
    "voice": "vo_adv_5064700_031",
    "unit_id": 12311
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "ふっふっふ……",
    "voice": "vo_adv_5064700_032",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\nこれまでにない仕上がりを感じるです。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "カヤぴぃなんかいちころですよ！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "ずいぶんと自信あるみたいじゃねえか。",
    "voice": "vo_adv_5064700_033",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "まあいいぜ、",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "かかってこいよ！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "それじゃあ私は、",
    "voice": "vo_adv_5064700_034",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "\\n今回もカヤちゃんのサポートにつこっかな～♪",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "ふっふっふ、",
    "voice": "vo_adv_5064700_035",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "二人まとめてかかってくるがいいです！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "いくですよ、",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "ドラちゃん！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "\\nこの脳筋ケンカバカと腹黒糸目ババゴンにわからせてやるです！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "ドラゴンもどき",
    "words": "ぐもーりんぐもももも！",
    "voice": "vo_adv_5064700_036",
    "unit_id": 12311
  },
  {
    "type": "dialogue",
    "name": "ドラゴンもどき",
    "words": "\\nぐももぐももぐももん！",
    "voice": null,
    "unit_id": 12311
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "ふぅ～ん……？　",
    "voice": "vo_adv_5064700_037",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "……そっか。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "そんな風に思ってたんだ。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "……おい、",
    "voice": "vo_adv_5064700_038",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "イノリ……イノリ！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "なんですカヤぴぃ！　",
    "voice": "vo_adv_5064700_039",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "イノリ",
    "words": "まさか今更おじけづいたです？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "いや、",
    "voice": "vo_adv_5064700_040",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "オレはともかくボスまで挑発しちまって……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "カヤ",
    "words": "お前ら大丈夫か？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "イノリちゃ～ん？",
    "voice": "vo_adv_5064700_041",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "ホマレ",
    "words": "\\nドラちゃ～ん？",
    "voice": null,
