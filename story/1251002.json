  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "你看，這裡的甜點",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "賣相都超可愛的吧喵？",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n現在正流行拍這種讓照片顯得很好看的東西喵。",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "……然後說到拍照好看，",
    "voice": "vo_adv_1251002_002",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我們店就再適合不過了……",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "就以這樣的內容來進行宣傳喵！",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "請多支持能拍很多時髦又可愛的照片的",
    "voice": "vo_adv_1251002_003",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n咖啡廳「Naschkatze」喵～！",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "background",
    "bg_id": "501950"
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "大家，我們回來了～！",
    "voice": "vo_adv_1251002_004",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "貓咪們",
    "words": "喵～♪",
    "voice": "vo_adv_1251002_005",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "如何喵？",
    "voice": "vo_adv_1251002_006",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "能跟這些可愛的貓咪一起拍照的話，就太棒了喵！",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "但並不只有這樣喵！",
    "voice": "vo_adv_1251002_007",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n其實我還準備了",
