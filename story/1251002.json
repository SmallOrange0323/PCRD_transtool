  {
    "type": "dialogue",
    "name": "旁白",
    "words": "因準備開店而正外出購物中的珠希和{0}，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n剛好路過街上大排長龍的甜點店前。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這間店的甜點超熱門的喵～",
    "voice": "vo_adv_1251002_000",
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n因為都是女孩子跟情侶，所以超熱鬧的喵。",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "對啊喵！",
    "voice": "vo_adv_1251002_001",
    "unit_id": 125111
