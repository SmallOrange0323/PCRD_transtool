[
  {
    "type": "background",
    "bg_id": "501380"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "深月成功完成困難的手術，風評更加提升了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n然而也因此變得更為忙碌。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "真傷腦筋，",
    "voice": "vo_adv_5074003_000",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "已經這麼晚了。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "自從上次之後，變得能離開診察室走動這點是很好，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "但卻是要我接連進行手術。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "那個院長，",
    "voice": "vo_adv_5074003_001",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "完全就是打算把我給累死吧。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "完全沒問題。",
    "voice": "vo_adv_5074003_002",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "比起要和我那些公會成員相處，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n這邊的工作",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "根本是休閒活動。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "只是，",
    "voice": "vo_adv_5074003_003",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "有其他問題要擔心。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "沒錯，",
    "voice": "vo_adv_5074003_004",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這才是難關。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "雖然從來看診的患者身上問出了很多事情，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n但就是沒有牽涉到頭目的關鍵情報。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "問題出在沒有足夠的人手能進行調查，",
    "voice": "vo_adv_5074003_005",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n很遺憾的，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "要找這種時候能依靠的人才，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我實在沒有頭緒。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不能找【暮光流星群】的成員，",
    "voice": "vo_adv_5074003_006",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n她們在能力",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "以及性格上都太過極端了。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "要是真的找不到，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "可能就得請你找朋友來幫忙了。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……莫非，",
    "voice": "vo_adv_5074003_007",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "就是那位與你一樣，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "同為大江戶町英雄的忍者嗎？",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "可是，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "她看起來",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "似乎不太適合從事諜報活動……",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "等一下！",
    "voice": "vo_adv_5074003_008",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "你們是不是忘了",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "這裡就有一位",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "可靠的美麗英雄啦？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這聲音莫非是……",
    "voice": "vo_adv_5074003_009",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "對了，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "她上次說過會再來的。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我都忘光了。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "雪，",
    "voice": "vo_adv_5074003_010",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "很抱歉，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "應付妳不是我的專業，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n妳可以去找其他人嗎？",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "雪　",
    "words": "醫生，",
    "voice": "vo_adv_5074003_011",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雪　",
    "words": "妳確定要這樣冷落我嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雪　",
    "words": "先看看這個",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雪　",
    "words": "再說吧！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "movie",
    "movie_id": "507400301"
  },
  {
    "type": "background",
    "bg_id": "501380"
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "很高興妳有這份心意，",
    "voice": "vo_adv_5074003_012",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "但我們不缺人手喔。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不可以說謊喔。",
    "voice": "vo_adv_5074003_013",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "醫生，",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "妳從早上到現在",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "接連動了好幾次手術，",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n今天根本就不在診察室裡嘛。",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "害我啊，",
    "voice": "vo_adv_5074003_014",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "一直痴痴地在等妳耶。",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "所以被妳發現我其實很忙了。",
    "voice": "vo_adv_5074003_015",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "但我還是不懂，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "為什麼妳想要幫助我呢？",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我雖然跟妳不太熟，",
    "voice": "vo_adv_5074003_016",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "但妳看起來不是那種憂國憂民、",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "孜孜不倦的人吧？",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "嗯，",
    "voice": "vo_adv_5074003_017",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我只是",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "想讓妳當我的主治醫師才這麼說的，",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "而且",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "護理師的衣服很可愛不是嗎？",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我一直都很想穿一次看看呢♪",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "毫不隱瞞自己的欲望，",
    "voice": "vo_adv_5074003_018",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我不討厭妳這種直率性格。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "妳很適合加入",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "【暮光流星群】喔。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "是不是？",
    "voice": "vo_adv_5074003_019",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我就知道",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "妳是個好醫生。",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "現在我知道妳的目的了。",
    "voice": "vo_adv_5074003_020",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不過，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我們並不是來做慈善事業的。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "而是另有目的",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "才潛入這間醫院臥底的。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我們越是接近真相，",
    "voice": "vo_adv_5074003_021",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n就越有可能遭遇危險喔？",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "咦？",
    "voice": "vo_adv_5074003_022",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "醫生妳不知道嗎？",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我也和",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這個人一樣，",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n是這城鎮的英雄之一喔。",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "不過，",
    "voice": "vo_adv_5074003_023",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "像戰鬥這種暴力的事情我都交給夥伴，",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n要是遇到危險，",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我也會全都交給醫生的喔。",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……這麼誠實反而爽快。",
    "voice": "vo_adv_5074003_024",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "再問下去就真的太麻煩了。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "好吧，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "那就麻煩妳幫點忙了。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "妳總算肯答應啦？",
    "voice": "vo_adv_5074003_025",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "要我做什麼儘管說吧。",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "妳現在去每間病房逛逛，",
    "voice": "vo_adv_5074003_026",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "讓住院病患",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "欣賞欣賞妳的美貌。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n然後順便跟他們",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "閒話家常一下吧。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "原來如此，",
    "voice": "vo_adv_5074003_027",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "那些病患因為長期住院而鬱悶，",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "妳是要我用美貌為他們打氣吧？",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "美麗",
    "voice": "vo_adv_5074003_028",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "勝過任何藥劑。",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這差事",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "只有我能做到呢。",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "那麼，",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我這就出發！",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "也只能這樣了。",
    "voice": "vo_adv_5074003_029",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "畢竟她並不是真正的護理師，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n我不期待她能勝任一般護理師的職務。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不過，",
    "voice": "vo_adv_5074003_030",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "也許有些事情只有她能夠辦到。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……算了，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "還是別過度期待，看看狀況吧。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "still",
    "still_id": "507400301"
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "妳好！",
    "voice": "vo_adv_5074003_031",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "治療時間到囉！",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "住院患者1",
    "words": "哎呀呀，",
    "voice": "vo_adv_5074003_032",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者1",
    "words": "好可愛的護理師啊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者1",
    "words": "\\n但妳說治療……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者1",
    "words": "這種時間還有巡診嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "巡診？",
    "voice": "vo_adv_5074003_033",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我不知道那是什麼意思，",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我的工作是",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "散發美麗！",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "來，",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "好好欣賞我的美麗，",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "趕快恢復健康吧！",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "住院患者1",
    "words": "哎呀呀，",
    "voice": "vo_adv_5074003_034",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者1",
    "words": "真是謝謝妳。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者1",
    "words": "\\n妳有這份心意，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者1",
    "words": "我好開心呀。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者1",
    "words": "因為這間醫院，",
    "voice": "vo_adv_5074003_035",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者1",
    "words": "總有種",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者1",
    "words": "令人喘不過氣的感覺。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "是喔，",
    "voice": "vo_adv_5074003_036",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這樣啊。",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "住院患者1",
    "words": "咦？",
    "voice": "vo_adv_5074003_037",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者1",
    "words": "妳是這裡的護理師，卻沒發現嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "因為人家是",
    "voice": "vo_adv_5074003_038",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "光鮮亮麗的新人護理師嘛♪",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "住院患者1",
    "words": "原來是這樣。",
    "voice": "vo_adv_5074003_039",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者1",
    "words": "其實這間醫院",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者1",
    "words": "不久之前換了新的院長。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者1",
    "words": "\\n雖然醫院的風評變得不錯，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者1",
    "words": "\\n但醫師和護理師們卻都顯得有些陰沉。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者1",
    "words": "並不是說他們態度很差",
    "voice": "vo_adv_5074003_040",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者1",
    "words": "或是診察很隨便，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者1",
    "words": "不是這種感覺，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者1",
    "words": "\\n而是他們看起來好像很難受。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者1",
    "words": "我們原本就是",
    "voice": "vo_adv_5074003_041",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者1",
    "words": "因為不明原因住進來的，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者1",
    "words": "\\n看到他們這樣也覺得很難受呀。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "咦？",
    "voice": "vo_adv_5074003_042",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這位奶奶，",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "妳不知道自己得什麼病嗎？",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "住院患者1",
    "words": "是啊。",
    "voice": "vo_adv_5074003_043",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者1",
    "words": "住在附近的小姐",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者1",
    "words": "和我常光顧的店家老闆，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者1",
    "words": "\\n也都有了同樣症狀。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者1",
    "words": "最近",
    "voice": "vo_adv_5074003_044",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者1",
    "words": "鎮上的氣氛也不太好。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者1",
    "words": "\\n真不知道我們大江戶町發生了什麼事……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者1",
    "words": "真是的，",
    "voice": "vo_adv_5074003_045",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者1",
    "words": "瞧我一直抱怨些無趣的事……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者1",
    "words": "\\n真不好意思啊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者1",
    "words": "能和妳這麼",
    "voice": "vo_adv_5074003_046",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者1",
    "words": "開朗又漂亮的孩子聊天，我實在太開心了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者1",
    "words": "\\n可以的話，下次再來找我聊聊吧。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "當然沒問題！",
    "voice": "vo_adv_5074003_047",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "畢竟這就是",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我的工作嘛。",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "啊，",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "還有，",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "奶奶妳很快就不用再抱怨囉。",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "住院患者1",
    "words": "什麼？",
    "voice": "vo_adv_5074003_048",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "因為",
    "voice": "vo_adv_5074003_049",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這裡有鎮上的英雄",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "和名醫啊♪",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "background",
    "bg_id": "501401"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "哼哼～♪",
    "voice": "vo_adv_5074003_050",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "看著我的美貌逐漸傳播給大家，",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "感覺真棒。",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "話說回來，",
    "voice": "vo_adv_5074003_051",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "那位老奶奶的臉色也不太好呢。",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n感覺住院的人",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "比醫院外面的人還要嚴重……？",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "嗯？",
    "voice": "vo_adv_5074003_052",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "那是……",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "住院患者2",
    "words": "嗯──",
    "voice": "vo_adv_5074003_053",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者2",
    "words": "什麼都沒有耶。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者2",
    "words": "\\n應該是跑進這裡了啊……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "小弟弟，",
    "voice": "vo_adv_5074003_054",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你在這裡做什麼！？",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "住院患者2",
    "words": "哇！",
    "voice": "vo_adv_5074003_055",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者2",
    "words": "大、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者2",
    "words": "大姐姐，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者2",
    "words": "妳是誰……？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我是",
    "voice": "vo_adv_5074003_056",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這世上最美的護理師，",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "雪！",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "住院患者2",
    "words": "真的……",
    "voice": "vo_adv_5074003_057",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者2",
    "words": "嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這無情的懷疑眼神，",
    "voice": "vo_adv_5074003_058",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "有點傷感情啊。",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "算了，",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "要求小孩子瞬間理解我的美，",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n可能太難了點吧。",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "好啦，",
    "voice": "vo_adv_5074003_059",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "別待在這黑漆漆的地方，",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n到比較亮的外面去，",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "好好欣賞我的美貌吧！",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "住院患者2",
    "words": "呃──",
    "voice": "vo_adv_5074003_060",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者2",
    "words": "那不重要啦，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者2",
    "words": "我",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者2",
    "words": "得找出幽靈才行。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "幽靈？",
    "voice": "vo_adv_5074003_061",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "住院患者2",
    "words": "嗯。",
    "voice": "vo_adv_5074003_062",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者2",
    "words": "一到半夜",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者2",
    "words": "就會有人進來這個房間，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者2",
    "words": "\\n但是房裡卻都找不到。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者2",
    "words": "所以那個",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者2",
    "words": "肯定是幽靈啦！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "幽靈，",
    "voice": "vo_adv_5074003_063",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "是吧……",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "住院患者2",
    "words": "啊，",
    "voice": "vo_adv_5074003_064",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者2",
    "words": "妳一臉就是不信！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者2",
    "words": "我是說真的啦！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者2",
    "words": "\\n這裡還能聽見呻吟聲！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "你誤會了，",
    "voice": "vo_adv_5074003_065",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我的美貌優先順序",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "居然輸給了幽靈，",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n我只是不太能接受這個事實罷了……",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "住院患者2",
    "words": "呃，",
    "voice": "vo_adv_5074003_066",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者2",
    "words": "妳在計較這個？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者2",
    "words": "大姐姐妳真的好怪喔……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "院長",
    "words": "小弟弟，",
    "voice": "vo_adv_5074003_067",
    "unit_id": 512
  },
  {
    "type": "dialogue",
    "name": "院長",
    "words": "你在那裡做什麼？",
    "voice": null,
    "unit_id": 512
  },
  {
    "type": "dialogue",
    "name": "住院患者2",
    "words": "呀啊！",
    "voice": "vo_adv_5074003_068",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者2",
    "words": "院、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者2",
    "words": "院長……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "院長",
    "words": "不可以在醫院裡亂晃喔。",
    "voice": "vo_adv_5074003_069",
    "unit_id": 512
  },
  {
    "type": "dialogue",
    "name": "院長",
    "words": "\\n趕快回去你的病房。",
    "voice": null,
    "unit_id": 512
  },
  {
    "type": "dialogue",
    "name": "住院患者2",
    "words": "嗯、",
    "voice": "vo_adv_5074003_070",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者2",
    "words": "嗯……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "院長",
    "words": "那麼，",
    "voice": "vo_adv_5074003_071",
    "unit_id": 512
  },
  {
    "type": "dialogue",
    "name": "院長",
    "words": "這位小姐，",
    "voice": null,
    "unit_id": 512
  },
  {
    "type": "dialogue",
    "name": "院長",
    "words": "妳是那個女醫師派來的吧？",
    "voice": null,
    "unit_id": 512
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我不懂你在說什麼耶？",
    "voice": "vo_adv_5074003_072",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我只是來探望",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "這孩子而已啊？",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "院長",
    "words": "有人穿這樣來探病的嗎？",
    "voice": "vo_adv_5074003_073",
    "unit_id": 512
  },
  {
    "type": "dialogue",
    "name": "院長",
    "words": "\\n快帶著那孩子",
    "voice": null,
    "unit_id": 512
  },
  {
    "type": "dialogue",
    "name": "院長",
    "words": "離開這裡。",
    "voice": null,
    "unit_id": 512
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "那個醫生是怎樣？",
    "voice": "vo_adv_5074003_074",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "態度好差喔。",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n看到我",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "居然連一句可愛都不說，",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "肯定有問題！",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "住院患者2",
    "words": "我、",
    "voice": "vo_adv_5074003_075",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者2",
    "words": "我也不太清楚，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者2",
    "words": "只是那個人",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者2",
    "words": "雖然對我們很好，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者2",
    "words": "\\n卻對醫師和護理師都很嚴格。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者2",
    "words": "所以",
    "voice": "vo_adv_5074003_076",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "住院患者2",
    "words": "我也不太喜歡他。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "是喔，",
    "voice": "vo_adv_5074003_077",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "原來是這樣。",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "總之",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我先回去跟醫生報告吧。",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "background",
    "bg_id": "501382"
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "好的，",
    "voice": "vo_adv_5074003_078",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "事情就是這樣，",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我已經盡情地",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "去散播完我的美囉！",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "\\n",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "只要繼續保持下去，",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "大家一轉眼就能出院啦！",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "怎麼樣？",
    "voice": "vo_adv_5074003_079",
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "醫生？",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "我是不是",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "雪",
    "words": "還挺有用處的啊？",
    "voice": null,
    "unit_id": 117611
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "是啊，",
    "voice": "vo_adv_5074003_080",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "老實說，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我沒想到妳居然這麼能幹。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這才是最重要的。",
    "voice": "vo_adv_5074003_081",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "因為閒聊時",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "能引出他們每天察覺的小細節、",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n毫無虛偽的真心話、",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "或是令人感興趣的話題啊。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "而我們",
    "voice": "vo_adv_5074003_082",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "要找尋的真相",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "就藏在這些閒聊之中。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "雪她成功探出這些情報了。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "那麼，",
    "voice": "vo_adv_5074003_083",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我們也出發吧。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這還用問嗎？",
    "voice": "vo_adv_5074003_084",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "當然是去找幽靈囉。",
    "voice": null,
    "unit_id": 117511
  }
]
