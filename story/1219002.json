[
  {
    "type": "background",
    "bg_id": "500843"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "海盜船完成後過了幾天……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n當{0}來到船所在地點後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n修特帕魯立刻便高聲開口宣布──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "──來做一張藏寶圖吧，",
    "voice": "vo_adv_1219002_000",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "吾之盟友啊！！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "沒有錯！",
    "voice": "vo_adv_1219002_001",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "雖然海盜自己去尋找財寶這件事，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n也是別有一番風情……",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "但反過來說，將財寶藏起，",
    "voice": "vo_adv_1219002_002",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "並身懷著記載藏匿地點的地圖，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n才算是獨當一面的海盜，不是嗎！？",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "海盜船，",
    "voice": "vo_adv_1219002_003",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "也就是黑淵裂海號也已經從海底復甦，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "並成功歸還至我等熾炎戰鬼煉獄血盟暗黑團的身邊……",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "再來就只剩下準備好要保護的寶藏了。",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "因此，這次──",
    "voice": "vo_adv_1219002_004",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我想來親自動手做",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "藏匿寶藏的迷宮！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "畢竟要是寶藏太輕易就被發現，可少了點浪漫哪。",
    "voice": "vo_adv_1219002_005",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "從天而降的困難、",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "巧妙的陷阱、",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "無數待解謎題，通過這些考驗……",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "經歷如此冒險後到手的，才配稱為寶藏呀？",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "嗯，",
    "voice": "vo_adv_1219002_006",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我就知道你一定",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "會認可這個主意的！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "這一陣子以來，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我一直在尋找適合當迷宮的候補地點。",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "然後前幾天，",
    "voice": "vo_adv_1219002_007",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "終於讓我找到了最適合的地方……",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我馬上就",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "帶你過去！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "哼哼，",
    "voice": "vo_adv_1219002_008",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "你肯定",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "也會很中意那裡的。",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n快跟我來吧！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "background",
    "bg_id": "500240"
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "──到了！",
    "voice": "vo_adv_1219002_009",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "就是這個洞窟，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "吉格魯特。",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "光是外觀",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "就已經很有氣氛了對吧？",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "話雖如此，",
    "voice": "vo_adv_1219002_010",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我可並非單單只是因為很有氣氛，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n才決定選擇這個洞窟喔。",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "這其中可是",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "有著相當周密的考量……",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "其實呢，這個洞窟",
    "voice": "vo_adv_1219002_011",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "和海岸邊的淺灘",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "是相通的喔。",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "……你明白",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "這代表什麼嗎？",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "吉格魯特。",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "對對對！",
    "voice": "vo_adv_1219002_012",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "就是那樣沒錯！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n竟然可以立刻察覺到這點，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "你果然很懂呢！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "只要在淺灘上建個棧橋，",
    "voice": "vo_adv_1219002_013",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "便可以從海岸裏側進到這裡……",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "就像祕密港口一樣，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "很帥氣對吧！？",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "再加上，這個洞窟",
    "voice": "vo_adv_1219002_014",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "離蘭德索爾也很近。",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "橫渡世界追尋的寶藏，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n其實就在出發地點旁邊而已……",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "這樣也是",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "充滿浪漫！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "這裡正可謂",
    "voice": "vo_adv_1219002_015",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "最適合藏匿寶藏的地點！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "呼～",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "光是這樣談論此事，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "就令人心生雀躍啊！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "呵呵，",
    "voice": "vo_adv_1219002_016",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我也期待得不得了呢，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "吉格魯特！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "立刻就來",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "著手打造迷宮吧！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "──接下來",
    "voice": "vo_adv_1219002_017",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "將魔石配置在這裡，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n然後再做點改造，使板子被踩到後，固定用的零件就會自動鬆開……",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "很好，",
    "voice": "vo_adv_1219002_018",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "固定用的零件動了。",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "首先就從經典的機關開始吧，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n在洞窟中朝著目標滾落的",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "巨岩！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "果然得先有這個，才能算站上起點！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "再來只剩",
    "voice": "vo_adv_1219002_019",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "固定好身為主角的巨大岩石了……",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "但問題就在這裡。",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n我拿來當作參考的冒險小說中，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "是寫著「比人還要大好幾倍的巨岩",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "滾落下來」──",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "那個……",
    "voice": "vo_adv_1219002_020",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "雖然我也覺得說這種話有點不解風情……",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "但要在事後把那種大石頭",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "放回原本的位置，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "應該超級辛苦吧？",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "唔～嗯，",
    "voice": "vo_adv_1219002_021",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "實際嘗試做陷阱後，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "發現這真是比預想中困難多了。",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n而且要是讓前來尋寶的人",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "受重傷就不好了……",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "對、",
    "voice": "vo_adv_1219002_022",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "對了！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "改成把樹枝",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "組合成圓形，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n再用布料包覆住其外層，怎麼樣？",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "這樣一來，不但重量很輕，",
    "voice": "vo_adv_1219002_023",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "也可以輕易地放回原本的位置，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n就算被撞到也不會受傷！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "而且壞掉也可以立刻重新做好，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "好處多多啊！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "呵，",
    "voice": "vo_adv_1219002_024",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "了解！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我這就去",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "收集樹枝！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n吉格魯特就趁這段時間",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "將這塊布染成接近岩石的顏色吧！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "──我、",
    "voice": "vo_adv_1219002_025",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我再唸一遍喔？",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "「當惡魔之眼看透一切時，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "賢者之箱不得准許開啟。",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n當賢者揭開箱內現實時，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "箱之惡魔不得返回黑暗。」……",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "「汝",
    "voice": "vo_adv_1219002_026",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "若欲得手全知惡魔之眼，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n便與無形之獸",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "以及金屬機關之毒蛇",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "達成和解吧」──",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "怎、",
    "voice": "vo_adv_1219002_027",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "怎麼樣，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "吉格魯特，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "這道謎題應該就有辦法解開了吧？",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "……搞不懂？",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "嗚嗚，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "果然還是太難了嗎……",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "雖然打造了一個得解開謎題才有辦法出去的房間，",
    "voice": "vo_adv_1219002_028",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "但這樣子",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "題目太難了，恐怕沒人能離開房間哪。",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "而且年幼者",
    "voice": "vo_adv_1219002_029",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "可能光是讀這段文章就會覺得膩了，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "加上如果沒有讓他們在太陽下山前回家，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "會害家長們擔心的……",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "那麼，乾脆就……",
    "voice": "vo_adv_1219002_030",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "改成年幼者",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "光用眼睛看也能靠直覺解出來，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n像拼圖那樣的機關，應該會比較好。",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "還有，",
    "voice": "vo_adv_1219002_031",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "考慮到或許有人會花很多時間解謎，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n也在此備好水和糧食……",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "並且把出口設定成",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "經過一定時間後會自動開啟好了。",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "呵呵，",
    "voice": "vo_adv_1219002_032",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "如此一來家長們也可以安心了呢。",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n無論是誰來，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "都可以在萬全準備的狀態下挑戰解謎。",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "要設計什麼樣的拼圖式機關就之後再想……",
    "voice": "vo_adv_1219002_033",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我還有很多",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "想做出來的陷阱。",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "立刻來著手進行下一個吧，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "吉格魯特！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "唉……",
    "voice": "vo_adv_1219002_034",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "有、",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "有夠累人的……",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "總之",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "先把能想到的陷阱都做完了呢。",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "就算是我也不禁精疲力盡了。",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我上次把自己搞得這麼累，",
    "voice": "vo_adv_1219002_035",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "還是以前趕冥風戰記第一部的稿子時，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n很驚險地在截稿前一刻寫完那次的事了。",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "不過雖然累，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "但卻累得很舒爽呢。",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "最後只剩把寶箱安排好就完成了，",
    "voice": "vo_adv_1219002_036",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "雖然我是很想這麼說啦……",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "但還是得實際來測試一下",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "陷阱到底是不是真的安全呢。",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n要是有個萬一就不好了。",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "不過就算這麼想，",
    "voice": "vo_adv_1219002_037",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "但畢竟無所不能的我，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n已經徹底掌握所有陷阱的構造了，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n由我來測試也沒意義……",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "該怎麼辦呢……",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "什麼，",
    "voice": "vo_adv_1219002_038",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "你願意挺身涉險來幫忙測試陷阱的安全性嗎……？",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "可、",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "可是……",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "要是害你出了什麼事……",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "……",
    "voice": "vo_adv_1219002_039",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "不，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "你可是我獨一無二的盟友，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n最不應該",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "懷疑你實力的就是我啊。",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我明白了！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "你就挑戰看看吧！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "──差一點，",
    "voice": "vo_adv_1219002_040",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "只差一點了！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "吉格魯特！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "接著只要",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "成功走過這條隱形地板通道……！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "你、",
    "voice": "vo_adv_1219002_041",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "你回想一下！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "在前一個房間不是有個壁畫嗎！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n我覺得那壁畫……",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "似乎跟這機關",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "有著某種關係喔！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "唔唔，",
    "voice": "vo_adv_1219002_042",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "再說下去就跟直接把答案講出來沒兩樣了，所以不行呀……！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "可是",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "吉格魯特目前為止已經掉到下面的河裡三次了，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "要是再次掉下去，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "搞不好會感冒……！　",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "雖然以測試安全性而言已經夠了……",
    "voice": "vo_adv_1219002_043",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "但都已經來到這地步，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "希望你可以努力靠自己的力量通關啊！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n吉格魯特──！　",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "沒錯！",
    "voice": "vo_adv_1219002_044",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "就是那裡！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "你答對了，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "吉格魯特！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n就保持這樣繼續走過來！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "你一定",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "辦得到的！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "只要成功踩到下一個隱形地板上……",
    "voice": "vo_adv_1219002_045",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "寶藏就在你眼前了！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "趕快跳到",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我這邊來吧！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "太、",
    "voice": "vo_adv_1219002_046",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "太棒了……！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "你終於挑戰成功啦，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "吉格魯特！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "不愧是吾之盟友，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "也是我們海盜團引以為傲的船員……！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "這裡的財寶",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "全是你的啦！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "哎呀，",
    "voice": "vo_adv_1219002_047",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "話說回來……",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "原本的目的是要確認陷阱安不安全呢。",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "你有沒有哪裡受傷？",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "身上有會痛的地方嗎？",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "是嗎，",
    "voice": "vo_adv_1219002_048",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "那太好了！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "這樣一來",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "就能放心邀請追尋寶藏的人們",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "來這座迷宮裡了！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "只不過，",
    "voice": "vo_adv_1219002_049",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我在看你實際挑戰的時候，不禁有個想法……",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我、",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我好像還是",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "不小心製作太多陷阱了……",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "每走幾步就會碰到某個陷阱，",
    "voice": "vo_adv_1219002_050",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "搞得這地方簡直跟要塞沒兩樣了。",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "或許來尋寶的人之中",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "會有人因此被嚇得打道回府……",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "不過你都特地身體力行來證明這迷宮很安全了，",
    "voice": "vo_adv_1219002_051",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n我們還是確實地向眾人聲明這一點吧。",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "總之",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "先回到入口處吧，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "吉格魯特！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "「此洞窟內已做好最徹底之安全措施。",
    "voice": "vo_adv_1219002_052",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n追尋財寶之人啊，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "放心享受吧！」",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "──完成。",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "好了！",
    "voice": "vo_adv_1219002_053",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "只要像這樣把看板立在這邊，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n大家就會明白此洞窟很安全，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "能更輕鬆簡單地來享受正統冒險的樂趣！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "最後只要把寶箱安排好……",
    "voice": "vo_adv_1219002_054",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "守護海盜寶藏的迷宮，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "就大功告成啦──！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "……嗯？",
    "voice": "vo_adv_1219002_055",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "你在說什麼呀，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "吉格魯特。",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n寶箱裡面放的東西，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "當然就是財寶",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "──",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "啊。",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "糟……",
    "voice": "vo_adv_1219002_056",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "糟糟糟、",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "糟啦啊啊啊──！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "沒想到我竟會犯下這種錯！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我滿腦子都顧著守護海盜財寶的迷宮，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "竟、",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "竟然忘記準備",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "最重要的寶藏啦……！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "怎、",
    "voice": "vo_adv_1219002_057",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "怎麼辦，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "吉格魯特……",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n我購買了大量",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "製作迷宮用的各種材料，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "幾乎把所有錢花光了……！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "而且要說的話，能在店裡買到的東西，",
    "voice": "vo_adv_1219002_058",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "也根本稱不上是寶藏……",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "市售品什麼的一點也不浪漫！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n會讓特地前來這邊",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "尋寶的人們",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "感到失望啊！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "有沒有，",
    "voice": "vo_adv_1219002_059",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "有沒有什麼好東西……",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "相當稀有，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "又有著冒險的浪漫，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "只有我能提供的寶藏……",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "吉、",
    "voice": "vo_adv_1219002_060",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "吉格魯特！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "你說說看有沒有什麼想要的東西！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n只要是你認為可以算得上寶藏，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "而且是我有辦法準備的，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n就儘管開口提看看。",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "借助我",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "你的智慧吧！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "──就、",
    "voice": "vo_adv_1219002_061",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "就是這個──！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "吉格魯特，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "你這傢伙",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "腦袋真的超級靈光耶！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "設定資料，",
    "voice": "vo_adv_1219002_062",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "正可謂冥風戰記之外典……",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "記載著未公開秘辛的禁書！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "確實相當稀有，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n也有著冒險的浪漫。",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "而且是只有我才能提供的寶藏！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "對了，",
    "voice": "vo_adv_1219002_063",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "反正機會難得，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "當初冥風戰記首刷贈送的特典還有剩，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n就也一起當作套組放在寶箱裡吧。",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "有這麼多好東西，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "應該夠格稱為寶藏了。",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "接著就是",
    "voice": "vo_adv_1219002_064",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "把這個洞窟的地點，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "以及寫有謎題提示的地圖，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n流通到各大舊書店和骨董商……",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "肯定就會有許多人",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "為了追尋寶藏而來吧！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "是啊，",
    "voice": "vo_adv_1219002_065",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "若能有和我們一樣",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "有著成為暗黑騎士潛力的人前來，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "就更棒了。",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "吾等的靈魂將互相吸引……",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "並超越",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "萬物之理！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "搞不好在那之中，",
    "voice": "vo_adv_1219002_066",
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n還會有願意加入海盜團",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "當船員的人在呢……",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "真令人期待！",
    "voice": null,
    "unit_id": 121912
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "那之後，該迷宮成了冥風戰記這部作品的聖地，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n以該作的讀者為中心，獲得不小的人氣……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n進而帶動了一點點冥風戰記的銷量。",
    "voice": null,
    "unit_id": null
  }
]
