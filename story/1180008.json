    "bg_id": "501070"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "唔、",
    "voice": "vo_adv_1180008_046",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "唔唔……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "哦。",
    "voice": "vo_adv_1180008_047",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n您醒了呀，",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "克蕾琪塔小姐。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "唔唔唔……",
    "voice": "vo_adv_1180008_048",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "已經早上了嗎……？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "咦，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我怎麼會在王宮……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "聽說是昨晚，",
    "voice": "vo_adv_1180008_049",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n那位少年把喝得爛醉的",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "克蕾琪塔小姐帶回來的。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n晚點您去致個謝吧。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "原來是這樣……",
    "voice": "vo_adv_1180008_050",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……我知道了。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……不過……",
    "voice": "vo_adv_1180008_051",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我好像，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "做了一個奇怪的夢……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "克蕾琪塔小姐？",
    "voice": "vo_adv_1180008_052",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n工作時間差不多要開始了。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……秘書一號。",
    "voice": "vo_adv_1180008_053",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n目前最優先工作是？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "雖然有許多課題需解決，",
    "voice": "vo_adv_1180008_054",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n但要論目前最優先，",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "便是得湊國家經費的部分。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n是否要考慮去拜託【墨丘利財團】，",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "請他們幫忙買點公債呢？",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "妳說的這件事",
    "voice": "vo_adv_1180008_055",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "或許遲早都得做……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……但在那之前，",
    "voice": "vo_adv_1180008_056",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n先陪我去個地方，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "秘書一號。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "是可以。",
    "voice": "vo_adv_1180008_057",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n去哪裡呢？",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "──【里士滿工商會】。",
    "voice": "vo_adv_1180008_058",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "呵呵……",
    "voice": "vo_adv_1180008_059",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n呵呵呵……♪",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "哦──呵呵呵呵♪",
    "voice": "vo_adv_1180008_060",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n快看哪，秘書一號♪",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n好好看看我們【里士滿工商會】的寶物庫！！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "因為有一陣子沒回來，",
    "voice": "vo_adv_1180008_061",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "積了不少灰塵……",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n啊啊，",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "好想打掃……",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "亮晶晶的金銀財寶！",
    "voice": "vo_adv_1180008_062",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "眾多頂尖的高級藝術品！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n光是像這樣待在這裡，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "就感到心靈獲得滿足哪～♪",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "……幸好在豪紳議長有機會把魔爪伸到這裡前，",
    "voice": "vo_adv_1180008_063",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "反亂就宣告失敗。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n也因此，",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "這個寶物庫裡的資產維持在我們成為公務員前的狀態。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我也成功",
    "voice": "vo_adv_1180008_064",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "再次就任【里士滿工商會】的公會長。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "所以",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "順利拿回了這個寶物庫♪",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n不愧是陛下，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "真是天真……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我是說寬宏大量♪",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "只是……",
    "voice": "vo_adv_1180008_065",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "曾經興盛一時的【里士滿工商會】，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n也無法像以往那樣進行公會活動了。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n除非我可以分身成兩個人啦……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "不過，",
    "voice": "vo_adv_1180008_066",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n至今為止在克蕾琪塔小姐底下工作的人才",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "也都還留在會裡。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n現在這邊作為承接政府委外業務的組織，",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "也是大為活躍……",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "畢竟那個穢物議長不在了，",
    "voice": "vo_adv_1180008_067",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "要是我有那個意思，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n要中飽私囊或作假帳都會比以往來得容易。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n但……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "秘書一號。",
    "voice": "vo_adv_1180008_068",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n今早的工作──",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "就是要來清算",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "這個寶物庫。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n眼前所有資產",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "都拿去捐給國庫吧。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "……\\n我明白了。",
    "voice": "vo_adv_1180008_069",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "不過……",
    "voice": "vo_adv_1180008_070",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "這樣真的好嗎？",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "克蕾琪塔之塔呢？",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……當然不好。",
    "voice": "vo_adv_1180008_071",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n雖然不好，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "不過……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我已經不用將金銀財寶",
    "voice": "vo_adv_1180008_072",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "當作心靈寄託了。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n不用特地將自己成功的證明",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "化為實物了。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "現在的我，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "一定……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "有辦法走下去的。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "畢竟",
    "voice": "vo_adv_1180008_073",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我有",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "陛下和妳在呀。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n那個少年，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "也會成為我的力量。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n而且……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "……而且？",
    "voice": "vo_adv_1180008_074",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "而且，",
    "voice": "vo_adv_1180008_075",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "試想一下？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n我現在可是",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "奉陛下之命管理國庫的人唷？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "即使將這些捐獻給國庫！",
    "voice": "vo_adv_1180008_076",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n還是一樣在我的管理下呀！？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "不對！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "要說這個國家的資產，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "全歸我管也不誇張──",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "原來如此，",
    "voice": "vo_adv_1180008_077",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "是這樣啊。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "筆記筆記……",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "給我等一下！",
    "voice": "vo_adv_1180008_078",
    "unit_id": 118011
