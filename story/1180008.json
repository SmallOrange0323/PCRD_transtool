[
  {
    "type": "background",
    "bg_id": "500032"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在路邊攤被克蕾琪塔招待了一碗拉麵後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}拖著喝醉了的克蕾琪塔走在回去的路上。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "嗚、",
    "voice": "vo_adv_1180008_000",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "嗚～嗯……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "不小心喝太多了……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n明明",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "已經跟",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "那群混蛋貴族喝過一輪了……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "都是那拉麵店的大叔",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "拚命勸酒害的啦……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "嗝！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "嗚",
    "voice": "vo_adv_1180008_001",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "嗚……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "腳、",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "腳不穩……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n少年，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "你肩膀",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "借我扶一下……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "真是的……",
    "voice": "vo_adv_1180008_002",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "沒想到我",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "竟會露出如此丟人的一面。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n但是……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "別看我這樣……",
    "voice": "vo_adv_1180008_003",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我也是",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "拼了命地在努力唷？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "尤其是最近……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n為了陛下……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "也可以說是，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "為了這個國家的人民……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我可是只拿微薄薪水，",
    "voice": "vo_adv_1180008_004",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "從早到晚……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "燃燒生命在工作……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "而且還要拚命抵抗",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "想做假帳來中飽私囊的衝動……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "可是可是，",
    "voice": "vo_adv_1180008_005",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "那些文官又不太願意聽我這種",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n突然迸出來的傢伙講的話……？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "加上國庫也快見底……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "稅收也一直無法達標……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "欸欸……",
    "voice": "vo_adv_1180008_006",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "你有",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "好好在聽嗎～？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "光～？",
    "voice": "vo_adv_1180008_007",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n唔～",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "已經早上了嗎……？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "這樣的話，",
    "voice": "vo_adv_1180008_008",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "得趕快開始工作了……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n今天也要",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "賣力…………",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "唔…………",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "background",
    "bg_id": "510290"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}在路上偶然遇見一名",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n叫克蕾雅的女性，並幫她帶路，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n卻不知為何變成她述說自身遭遇的對象。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "「剛才也提到過，",
    "voice": "vo_adv_1180008_009",
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n我是",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "靠投資討生活的。」",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "「現在這時代可便利了。",
    "voice": "vo_adv_1180008_010",
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "只要有預測世事變化的能力，",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "再加上一點點運氣，",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n即使足不出戶，",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "也能累積莫大的財富。」",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "「沒錯，",
    "voice": "vo_adv_1180008_011",
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "就是你想的那樣。",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n我便是",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "經由投資，",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "從幾乎身無分文，",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n爬上億萬富翁地位的。",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "……然而……」",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "「大概是我太得意忘形了吧。",
    "voice": "vo_adv_1180008_012",
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "竟然不小心……",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "相信了從未見過面、",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n只有透過網路聯繫的對象。",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "我賺到的資產，",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "有一大半都被搶走了。」",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "「而多虧如此，",
    "voice": "vo_adv_1180008_013",
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "我那之後就變得徹底不相信他人。",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n才會像這樣，不僱用當地導遊，",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "選擇用自己的眼睛判斷，",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n親自找一個看起來人還不錯的少年",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "來幫我帶路。」",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "「而最後，",
    "voice": "vo_adv_1180008_014",
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "騙走我錢的那個詐欺師也銷聲匿跡了。",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "今天約好要見面的又是另外一位……",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "透過網路斥責、",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n取笑",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "可憐的我，",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "一個不可饒恕的傢伙。」",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "background",
    "bg_id": "510350"
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "「好啦！",
    "voice": "vo_adv_1180008_015",
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n總算是抵達椿丘大飯店了！」",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "「都到這地步，我們算是患難與共了。",
    "voice": "vo_adv_1180008_016",
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n你也和我一起",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "殺進去吧！",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "就給你機會",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "見證我打倒",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "『那個女人』的瞬間！」",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "而{0}便跟著進去",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n克蕾雅口中「敵人」正等待著的飯店內，不過……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "「唔……！",
    "voice": "vo_adv_1180008_017",
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n來偷襲這套！？",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n妳竟敢",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "這麼對我……！」",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "「啊啊！？",
    "voice": "vo_adv_1180008_018",
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "快、",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "快點放開！",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "這可是……",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "犯規吧！？」",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "「！",
    "voice": "vo_adv_1180008_019",
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "竟然也把少年捲入陷阱裡……！」",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "「不、",
    "voice": "vo_adv_1180008_020",
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "不要！",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n這樣、",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "這樣做的話！",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n不行～～～～！！！」",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "still",
    "still_id": "118000801"
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "好啦。",
    "voice": "vo_adv_1180008_021",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "\\n是我贏了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "「我氣────！！",
    "voice": "vo_adv_1180008_022",
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n為什麼！？",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n為什麼就是贏不了～～！？」",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "當然是因為，",
    "voice": "vo_adv_1180008_023",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "我的技術「比妳強」。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "\\n而且這麼一來，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "也證明了至今為止的對戰成績，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "\\n並沒有受網路速度的影響。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "要說的話，",
    "voice": "vo_adv_1180008_024",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "玩這種懷舊格鬥對戰遊戲，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "說什麼網路有延遲\\n而不肯認輸也太離譜了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "妳以為現在已經西元幾年了？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "\\n還是說妳住在什麼",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "只能夠撥接上網的地區？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "「可惡啊啊啊～！",
    "voice": "vo_adv_1180008_025",
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n妳那張愛嗆人的嘴",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "不管是語音還是面對面都沒變啊──！」",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "初次見面，你好。",
    "voice": "vo_adv_1180008_026",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "\\n不好意思自我介紹晚了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "\\n我是",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "克蕾雅小姐的……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "該說是，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "遊戲同好吧。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "「誰跟妳同好！",
    "voice": "vo_adv_1180008_027",
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n是死對頭啦，",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "死對頭！」",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "是是是。",
    "voice": "vo_adv_1180008_028",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "\\n雖然特地跑來那個死對頭在的國家，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "\\n打算來場線下聚會的，可是克蕾雅小姐妳呢。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "……雖然，",
    "voice": "vo_adv_1180008_029",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "妳硬拉一個當地的男學生來的舉動，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "\\n是超出我的預想啦。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "「哼！",
    "voice": "vo_adv_1180008_030",
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n我只是覺得",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "需要第三者來當個公正的評審！」",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "雖然妳口中的評審，",
    "voice": "vo_adv_1180008_031",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "也很自然地參加戰鬥了……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "\\n而且妳原本",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "似乎還盤算跟他一起夾擊我吧。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "「什麼嘛什麼嘛！",
    "voice": "vo_adv_1180008_032",
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n把人說得像卑鄙小人一樣！",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n這可是多人數大亂鬥類型的遊戲，",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "這種戰略可是基本！」",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "「接關！",
    "voice": "vo_adv_1180008_033",
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "我要繼續！",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n不過一兩次落敗，",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "可無法讓我收手的喔！？」",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "好吧，我奉陪。",
    "voice": "vo_adv_1180008_034",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "\\n我就在事態演變成妳擅長的體力耐久賽前，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "讓妳徹底灰心喪志吧。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "「……？",
    "voice": "vo_adv_1180008_035",
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n少年，怎麼了？",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "一直盯著這邊看。」",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "「啊啊！？",
    "voice": "vo_adv_1180008_036",
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n你的眼睛",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "是瞎了嗎！？",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n還是說",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "你大腦沒辦法正常判斷事物！？」",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "……看，",
    "voice": "vo_adv_1180008_037",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "少女",
    "words": "\\n她很有趣吧。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "「給我等一下！",
    "voice": "vo_adv_1180008_038",
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n你們在那邊說什麼悄悄話！？",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n可以請妳不要試圖拉攏評審嗎，莓小姐！」",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "莓",
    "words": "哎呀──",
    "voice": "vo_adv_1180008_039",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "莓",
    "words": "有機可趁",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "莓",
    "words": "呢。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "「",
    "voice": "vo_adv_1180008_040",
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "啊啊啊啊啊！？！？",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n連續使用道具然後把人關廁所關到死未免也太卑鄙了吧！",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n妳這個人！！？」",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "莓",
    "words": "──呵。",
    "voice": "vo_adv_1180008_041",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "「嗤之以鼻！？",
    "voice": "vo_adv_1180008_042",
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n剛才妳那完全是用一副",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "嗤之以鼻",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "的態度看我吧！？",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "我氣────！！！！」",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "「可惡～～～",
    "voice": "vo_adv_1180008_043",
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "我生氣了！！",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "忍無可忍了！！",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n你們給我打開mimi！！",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n接下來就用",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "《阿斯特朗傳奇》來一決勝負～～！！」",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──就這樣，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}被捲進兩人的遊戲對決，一直比到夜深。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "118000802"
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "「話說回來……",
    "voice": "vo_adv_1180008_044",
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "妳送我的這件衣服。",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n上面寫什麼呀？",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "\\n我",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "克蕾雅",
    "words": "比較看不懂漢字……」",
    "voice": null,
    "unit_id": 118031
  },
  {
    "type": "dialogue",
    "name": "莓",
    "words": "噢，",
    "voice": "vo_adv_1180008_045",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "莓",
    "words": "那個呀。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "莓",
    "words": "\\n上面的詞，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "莓",
    "words": "\\n很適合用來形容特地跑到赤道這一頭來的克蕾雅小姐呢。",
    "voice": null,
    "unit_id": null
  },
  {
