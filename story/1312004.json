    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "是非常罕見的超能力少女……",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "\\n在各種地方之間",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "都非常搶手呢──",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "……真的是",
    "voice": "vo_adv_1312004_021",
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "麻煩得很啊。",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "\\n",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "不過這些都是因為出身或命運那些的，",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "\\n所以也無可奈何呢──",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "不過，",
    "voice": "vo_adv_1312004_022",
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "至少現在……",
