    "name": "魅空",
    "words": "你沒事吧～？",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "被神祕組織追趕的少女流魅空，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n與被她牽連的少年{0}。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n兩人手牽著手，持續逃亡之旅。",
    "voice": null,
