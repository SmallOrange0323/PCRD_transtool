  {
    "type": "dialogue",
    "name": "黑衣男",
    "words": "可惡！",
    "voice": "vo_adv_1312004_000",
    "unit_id": 331
  },
  {
    "type": "dialogue",
    "name": "黑衣男",
    "words": "\\n那些傢伙",
    "voice": null,
    "unit_id": 331
  },
  {
    "type": "dialogue",
    "name": "黑衣男",
    "words": "跑哪去了……！",
    "voice": null,
    "unit_id": 331
  },
  {
    "type": "dialogue",
    "name": "黑衣上司",
    "words": "應該還沒走遠才對！",
    "voice": "vo_adv_1312004_001",
    "unit_id": 8031
  },
  {
    "type": "dialogue",
    "name": "黑衣上司",
    "words": "\\n快搜！",
    "voice": null,
    "unit_id": 8031
  },
  {
    "type": "dialogue",
    "name": "黑衣男",
    "words": "……呼、",
    "voice": "vo_adv_1312004_002",
    "unit_id": 331
  },
  {
    "type": "dialogue",
    "name": "黑衣男",
    "words": "呼……",
    "voice": null,
    "unit_id": 331
  },
  {
    "type": "dialogue",
    "name": "黑衣男",
    "words": "\\n",
    "voice": null,
    "unit_id": 331
  },
  {
    "type": "dialogue",
    "name": "黑衣男",
    "words": "跟丟了呢，",
    "voice": null,
    "unit_id": 331
  },
  {
    "type": "dialogue",
    "name": "黑衣男",
    "words": "班長……",
    "voice": null,
    "unit_id": 331
  },
  {
    "type": "dialogue",
    "name": "黑衣上司",
    "words": "…………",
    "voice": "vo_adv_1312004_003",
    "unit_id": 8031
  },
  {
    "type": "dialogue",
    "name": "黑衣男",
    "words": "沒有來自其他班的發現報告，",
    "voice": "vo_adv_1312004_004",
    "unit_id": 331
  },
  {
    "type": "dialogue",
    "name": "黑衣男",
    "words": "機器也沒有反應……",
    "voice": null,
    "unit_id": 331
  },
  {
    "type": "dialogue",
    "name": "黑衣男",
    "words": "\\n",
    "voice": null,
    "unit_id": 331
  },
  {
    "type": "dialogue",
    "name": "黑衣男",
    "words": "要是她使用瞬間傳送，",
    "voice": null,
    "unit_id": 331
  },
  {
    "type": "dialogue",
    "name": "黑衣男",
    "words": "就能鎖定出大致的位置了……",
    "voice": null,
    "unit_id": 331
  },
  {
    "type": "dialogue",
    "name": "黑衣上司",
    "words": "……可惡。",
    "voice": "vo_adv_1312004_005",
    "unit_id": 8031
  },
  {
    "type": "dialogue",
    "name": "黑衣上司",
    "words": "\\n淨是給人添亂。",
    "voice": null,
    "unit_id": 8031
  },
  {
    "type": "dialogue",
    "name": "黑衣男",
    "words": "……不過，",
    "voice": "vo_adv_1312004_006",
    "unit_id": 331
  },
  {
    "type": "dialogue",
    "name": "黑衣男",
    "words": "還真厲害呢。",
    "voice": null,
    "unit_id": 331
  },
  {
    "type": "dialogue",
    "name": "黑衣男",
    "words": "\\n明明有這麼多人",
    "voice": null,
    "unit_id": 331
  },
  {
    "type": "dialogue",
    "name": "黑衣男",
    "words": "追了好幾天，",
    "voice": null,
    "unit_id": 331
  },
  {
    "type": "dialogue",
    "name": "黑衣男",
    "words": "\\n在幾乎不使用超能力的情況下，",
    "voice": null,
    "unit_id": 331
  },
  {
    "type": "dialogue",
    "name": "黑衣男",
    "words": "兩個小鬼竟然能持續逃跑……",
    "voice": null,
    "unit_id": 331
  },
  {
    "type": "dialogue",
    "name": "黑衣上司",
    "words": "……少在那邊感嘆了，",
    "voice": "vo_adv_1312004_007",
    "unit_id": 8031
  },
  {
    "type": "dialogue",
    "name": "黑衣上司",
    "words": "\\n給我再更有危機意識一點，",
    "voice": null,
    "unit_id": 8031
  },
  {
    "type": "dialogue",
    "name": "黑衣上司",
    "words": "蠢貨。",
    "voice": null,
    "unit_id": 8031
  },
  {
    "type": "dialogue",
    "name": "黑衣上司",
    "words": "\\n上頭平時",
    "voice": null,
    "unit_id": 8031
  },
  {
    "type": "dialogue",
    "name": "黑衣上司",
    "words": "就已經夠煩躁了啊……",
    "voice": null,
    "unit_id": 8031
  },
  {
    "type": "dialogue",
    "name": "黑衣上司",
    "words": "萬一Ｍ３號被其他組織帶走，",
    "voice": "vo_adv_1312004_008",
    "unit_id": 8031
  },
  {
    "type": "dialogue",
    "name": "黑衣上司",
    "words": "\\n或是在某處力竭而亡，",
    "voice": null,
    "unit_id": 8031
  },
  {
    "type": "dialogue",
    "name": "黑衣上司",
    "words": "\\n",
    "voice": null,
    "unit_id": 8031
  },
  {
    "type": "dialogue",
    "name": "黑衣上司",
    "words": "我們可是會被宰掉的……！",
    "voice": null,
    "unit_id": 8031
  },
  {
    "type": "dialogue",
    "name": "黑衣男",
    "words": "咿",
    "voice": "vo_adv_1312004_009",
    "unit_id": 331
  },
  {
    "type": "dialogue",
    "name": "黑衣男",
    "words": "咿咿……！",
    "voice": null,
    "unit_id": 331
  },
