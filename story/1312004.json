    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "\\n",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "雖然",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "我沒有看過貉就是了。",
    "voice": null,
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "就像我之前說的。",
    "voice": "vo_adv_1312004_020",
    "unit_id": 118231
  },
  {
    "type": "dialogue",
    "name": "魅空",
    "words": "\\n因為我",
