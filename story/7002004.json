  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我們稍微休息一會兒吧。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "贊成！　",
    "voice": "vo_adv_7002004_001",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里，已經精疲力盡了～",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "既然決定休息了……",
    "voice": "vo_adv_7002004_002",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "欸、",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "咻。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "姊姊，",
    "voice": "vo_adv_7002004_003",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "那是什麼啊？",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "哼哼哼……",
    "voice": "vo_adv_7002004_004",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "這個啊，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n是今天我才從雜貨店買的，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "最新款遊戲機哦！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "是濃縮了機能的小型遊戲機。",
    "voice": "vo_adv_7002004_005",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n這時候拿來玩豈不是正好嗎？",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "好厲害――！",
    "voice": "vo_adv_7002004_006",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n如此一來",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "就能在外頭盡情地玩了♪",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "說的一點也沒錯……",
    "voice": "vo_adv_7002004_007",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "欸，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "你似乎也挺感興趣的呢。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "哼哼哼，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "你的心情～我能夠理解！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "機會難得，",
    "voice": "vo_adv_7002004_008",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "讓你來玩玩看。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我也是第一次玩，",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "詳細操作方式我也不是很清楚。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "我們就一起來試試吧！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "…………",
    "voice": "vo_adv_7002004_009",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "呵呵，",
    "voice": "vo_adv_7002004_010",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "和哥哥聊開來",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n姊姊看上去開心極了♪",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "真好，",
    "voice": "vo_adv_7002004_011",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "茜里也想和哥哥好好地相處呢♪",
    "voice": null,
    "unit_id": 100611
  }
