    "name": "克莉絲提娜",
    "words": "說。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n人和事物不依賴他人，不揣測他人，",
    "voice": null,
    "unit_id": 107131
  },
