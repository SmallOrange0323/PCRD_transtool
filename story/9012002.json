[
  {
    "type": "background",
    "bg_id": "500653"
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "……哇啊～",
    "voice": "vo_adv_9012002_000",
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "夜晚越來越深的大江戶。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n雪野與剎鬼兩人，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "正抬頭看著夜空。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "剎鬼，",
    "voice": "vo_adv_9012002_001",
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "妳有發現嗎？",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "\\n",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "在這裡，",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "天空中有小小的光芒，",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "一閃一閃亮著。",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "\\n儂一開始",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "還不是很清楚，",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "但一直",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "看著",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "就覺得……",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "很漂亮，",
    "voice": "vo_adv_9012002_002",
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "令人著迷……",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "\\n",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "妳看，",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "就像寒冷早晨裡凍結的冰",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "一樣閃閃發光──",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "\\n",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "感覺一伸手",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "就能碰到，",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "但卻又碰不到，",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "這部分也有點像呢。",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "是啊。",
    "voice": "vo_adv_9012002_003",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "那就是",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "所謂的星星吧。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "跟我們那只會降下遺灰的世界相當不一樣──",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n是個截然不同",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "的地方呢。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "對了，",
    "voice": "vo_adv_9012002_004",
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "小公主好像說",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "她也有看過。",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "\\n",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "在跟騎士一起去蘭德索爾的時候。",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "\\n這裡的人，",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "好像一到晚上",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "就會觀看星星，",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "然後許願",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "的樣子。",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "在星星落下來的時候，",
    "voice": "vo_adv_9012002_005",
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "唸三遍願望，",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "就會",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "實現的樣子。",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "\\n",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "……騎士他們，",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "是不是也會",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "像這樣",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "許願呢？",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "誰知道呢。",
    "voice": "vo_adv_9012002_006",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "如果是騎士公他們，",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "應該會靠自己來實現吧。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "畢竟他們是群有骨氣的傢伙。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "嗯……",
    "voice": "vo_adv_9012002_007",
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "也是。",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "騎士他，",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "一直",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "都很非常努力",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "在加油著。",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "\\n",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "那、",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "那麼，",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "剎鬼妳呢？",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "\\n有想過",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "希望實現的",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "願望嗎？",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "我嗎？",
    "voice": "vo_adv_9012002_008",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "我怎麼可能有……",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "不對。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "要說一個都沒有那是騙人的。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "咦、",
    "voice": "vo_adv_9012002_009",
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "咦！？",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "是嗎……！？",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "驚訝過頭了，妳這個傻瓜。",
    "voice": "vo_adv_9012002_010",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "無論是誰，都會有內心迷惘的時候吧。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "對、",
    "voice": "vo_adv_9012002_011",
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "對、",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "對不起。",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "\\n",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "因為剎鬼，",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "總是那麼可靠。",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "\\n所以儂",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "有點意外……",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "哈。",
    "voice": "vo_adv_9012002_012",
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n──那麼妳又是如何？",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n只有妳在提問，",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "這說不通吧。",
    "voice": null,
    "unit_id": 135912
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "儂、",
    "voice": "vo_adv_9012002_013",
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "儂？",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "儂……",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "其實，",
    "voice": "vo_adv_9012002_014",
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "儂原本以為，",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "儂沒有",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "想要實現的願望。",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "\\n",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "但是，",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "現在──",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "儂……",
    "voice": "vo_adv_9012002_015",
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "那個。",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "想、",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "想要",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "試著，",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "去冒險……",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "看看。",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "\\n",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "儂至今，",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "都一直待在吉歐‧尼布爾黑爾。",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "\\n對外面的世界，",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "不是很了解。",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "想要跟小公主，",
    "voice": "vo_adv_9012002_016",
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "還有剎鬼一起。",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "去各種地方……",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "\\n要是還能交到",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "像騎士或拿娜",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "那樣的新朋友，",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "儂",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "會很開心。",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "\\n",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "這樣，",
    "voice": null,
    "unit_id": 135812
  },
  {
    "type": "dialogue",
