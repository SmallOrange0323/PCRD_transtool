  },
  {
    "type": "dialogue",
    "name": "女島民 2",
    "words": "鈴奈平常是什麼感覺啊？",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女島民 2",
    "words": "\\n放學後妳們會去哪裡玩啊？",
    "voice": null,
    "unit_id": 1211
  },
  {
    "type": "dialogue",
    "name": "女島民 2",
    "words": "\\n",
    "voice": null,
    "unit_id": 1211
  },
  {
