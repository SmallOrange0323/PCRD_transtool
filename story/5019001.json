    "voice": "vo_adv_5019001_068",
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "\\n我身為一名淑女，",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "當然是很",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "美咲",
    "words": "重視打扮的！",
    "voice": null,
    "unit_id": 110211
  },
  {
    "type": "dialogue",
    "name": "女島民 1",
    "words": "不過，",
    "voice": "vo_adv_5019001_069",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "女島民 1",
    "words": "超羨慕的，是她的同班同學耶！",
