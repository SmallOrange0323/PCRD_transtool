[
  {
    "type": "background",
    "bg_id": "500881"
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "聖誕節",
    "voice": "vo_adv_5132411_000",
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "結束了呢。",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "像這樣看著收拾工作，",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "就更加確實感受到了……",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不過，",
    "voice": "vo_adv_5132411_001",
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "會感到如此寂寥，",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "就是之前也同樣開心的證明吧！",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "您說的沒錯呢。",
    "voice": "vo_adv_5132411_002",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "我也因為得以",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "充分看到面對麻煩",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n手忙腳亂的克蕾琪塔小姐",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "而感到非常滿足。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "給我把那扭曲的快感藏在心裡！",
    "voice": "vo_adv_5132411_003",
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n……",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "不過啊，",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我為了僅僅一天的聖誕節",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n拼命準備至今，",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "所以果然確實會有寂寥感呢。",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "──真的只是那樣嗎？",
    "voice": "vo_adv_5132411_004",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "妳有說什麼嗎？",
    "voice": "vo_adv_5132411_005",
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "秘書一號。",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "不，",
    "voice": "vo_adv_5132411_006",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "沒什麼。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……我稍後會堵住秘書一號那口無遮攔的嘴。",
    "voice": "vo_adv_5132411_007",
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "讓陛下有寂寥的感受可是嚴重的事態，",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n所以，",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "還請陛下這之後稍微陪我一下。",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "咦？",
    "voice": "vo_adv_5132411_008",
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "可以是可以，",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但究竟要做什……",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我招呼了這次協助的人來慶功宴！",
    "voice": "vo_adv_5132411_009",
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n雖然也能以讓人回味的感傷作結，",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "但果然必須",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "要讓陛下常保笑容才行！",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "費用出自克蕾琪塔小姐的個人財產，",
    "voice": "vo_adv_5132411_010",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "所以還請",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "盡情吃喝吧。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "哼，",
    "voice": "vo_adv_5132411_011",
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "妳以為我會因為那種話而慌亂嗎？",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "錢這種東西，不管再怎麼花，",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "也只要用完再賺就好了！",
    "voice": null,
    "unit_id": 128011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "……欸嘿嘿，",
    "voice": "vo_adv_5132411_012",
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "結果從頭到尾，",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我都一直在依靠克蕾琪塔小姐呢。",
    "voice": null,
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "那我就感謝妳的好意，",
    "voice": "vo_adv_5132411_013",
    "unit_id": 127911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不客氣地盡情享受了☆",
    "voice": null,
    "unit_id": 127911
  }
]
