[
  {
    "type": "background",
    "bg_id": "500520"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}在瑪爾傑海岸\\n和【墨丘利財團】的珠希與美冬相遇，\\n為了釣魚當晚餐搭船出海了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "500500001"
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "嗯──",
    "voice": "vo_adv_5005000_000",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "魚完全不上鉤呢……",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "因為難得來海邊",
    "voice": "vo_adv_5005000_001",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "自己煮晚餐的話比較便宜，\\n雖然我也理解美冬的想法，",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n不過我快厭倦了喵……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "已經想回家了喵……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "不不珠希，",
    "voice": "vo_adv_5005000_002",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "在這裡放棄才是最沒效率的唷。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n這艘船可不是免費租來的，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n得賺回本才行！",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "話說回來，也謝謝{0}，",
    "voice": "vo_adv_5005000_003",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n協助我們借這艘船呢。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "幫了大忙喔！",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "不過……",
    "voice": "vo_adv_5005000_004",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這樣一直釣不到魚的話好無聊喵……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n啊～啊，",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這種時候有貓咪在就好了喵～",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "在蘭德索爾的話因為貓咪會來幫忙，",
    "voice": "vo_adv_5005000_005",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n如果我能把事情交給貓咪自己去一邊涼快就好了喵……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "別說些沒道理的話了。",
    "voice": "vo_adv_5005000_006",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n海上怎麼可能會有貓呢。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n又不是夢裡的故事。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "夢裡的故事……",
    "voice": "vo_adv_5005000_007",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n說到這個，",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "昨天有觀光客\\n在海邊說了這樣的事情喵。",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "據說是，",
    "voice": "vo_adv_5005000_008",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "從這個瑪爾傑海岸往南的地方，",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n有一座「實現願望之島」……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "的樣子喵。",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "啊啊，",
    "voice": "vo_adv_5005000_009",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我也有聽過那個傳聞喔。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n抵達那座島的漂流者，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "可以獲得金銀財寶之類的……",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "不過，",
    "voice": "vo_adv_5005000_010",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "說到底也只是傳聞，\\n並不是從實際上去過的人那聽來的喵。",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "一定是編出來的故事喵。",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "如果是我的話，",
    "voice": "vo_adv_5005000_011",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "想要用貓咪打造出很多樂園，",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n被貓咪包圍著優雅地生活喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "雖然我沒期望到那樣，",
    "voice": "vo_adv_5005000_012",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "但如果能讓物價變便宜的話我會很開心呢。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "不過，",
    "voice": "vo_adv_5005000_013",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "「實現願望之島」",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "雖然不可能存在，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n但像這樣只做著白日夢的話也很開心呢……",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "就是啊喵～",
    "voice": "vo_adv_5005000_014",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "總覺得，",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "陽光暖呼呼的，",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n好像真的要作夢一樣喵……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "嗯……",
    "voice": "vo_adv_5005000_015",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "從剛剛開始釣竿一點反應也沒有，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n海浪也很平靜，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "好像開始……",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "變得很想睡呢……",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "嗚喵……",
    "voice": "vo_adv_5005000_016",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "好舒服喵～",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n只睡……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "只睡一下下",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "午覺就好了喵……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "哎呀，{0}？",
    "voice": "vo_adv_5005000_017",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "已經睡著了。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "啊，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "珠希也躺下去了……",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "不過，算了。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "啊，",
    "voice": "vo_adv_5005000_018",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "{0}，太狡猾了竟然先睡喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我也要睡了喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "轉眼之間大家都睡著了呢……",
    "voice": "vo_adv_5005000_019",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n因為我是這艘船的船長",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "所以不能睡著……",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "不能……",
    "voice": "vo_adv_5005000_020",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "睡著……",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "呼啊……",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "background",
    "bg_id": "500280"
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "……嗯",
    "voice": "vo_adv_5005000_021",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "咦？",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這裡，",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "是哪裡喵？",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n我，",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "睡在沙灘上……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n我們什麼時候回到瑪爾傑海岸上的喵……？",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "不過，",
    "voice": "vo_adv_5005000_022",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "能平安無事歸來就好……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "不過，",
    "voice": "vo_adv_5005000_023",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "周圍的景色和瑪爾傑海岸\\n完全不一樣喵────！？",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "美冬、",
    "voice": "vo_adv_5005000_024",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "{0}！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "快起來喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n事情糟糕了喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "嗯……",
    "voice": "vo_adv_5005000_025",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "幹嘛啦……",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "再睡一下……",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "欸，",
    "voice": "vo_adv_5005000_026",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我、",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "睡著了！？",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "真是太大意了！",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這、",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "這裡到底是哪裡！？",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n至少不是瑪爾傑海岸的樣子……",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "剛剛搭的船也不曉得去哪了……",
    "voice": "vo_adv_5005000_027",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "也就是說，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n在睡著的期間船沉了，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n只有我們這麼剛好地抵達這裡嗎？",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "嗯……",
    "voice": "vo_adv_5005000_028",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n不諳水性的我也不可能無意識的游泳，",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "雖然這麼說",
    "voice": null,
    "unit_id": 107911
  },
