[
  {
    "type": "background",
    "bg_id": "501663"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "阿爾莎特在吉歐‧格黑納引發的異變，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n也流傳到其他世界。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "唔……！",
    "voice": "vo_adv_5220005_000",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n剛才的晃動究竟是……",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "哎呀，",
    "voice": "vo_adv_5220005_001",
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "可沒時間東張西望的喔～？",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "唔……！",
    "voice": "vo_adv_5220005_002",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n可惡……！",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "這種時候，",
    "voice": "vo_adv_5220005_003",
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "居然還在意周遭的情況嗎？",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n真拿妳沒辦法～",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "嗯……",
    "voice": "vo_adv_5220005_004",
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "這樣啊。",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "小幻現在的公主騎士，那位山羊女孩，",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n背地裡似乎搞了些小動作……？　",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "……",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "唉……",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……！",
    "voice": "vo_adv_5220005_005",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n那傢伙……！？",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "background",
    "bg_id": "502560"
  },
  {
    "type": "background",
    "bg_id": "501663"
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "既然如此，",
    "voice": "vo_adv_5220005_006",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "現在根本不是做這種事的時候……唔！",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "但是──",
    "voice": "vo_adv_5220005_007",
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "那和妳有關係嗎？",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "什……",
    "voice": "vo_adv_5220005_008",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "畢竟妳啊，",
    "voice": "vo_adv_5220005_009",
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "遲早會在這裡",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "被單方面地消滅。",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n啊，",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "妳在擔心妳姊姊嗎？",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n解決妳之後我也會立刻",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "去解決掉她的，",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "妳就放心吧♪",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "background",
    "bg_id": "501663"
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "妳……",
    "voice": "vo_adv_5220005_010",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "──唔啊！",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "……吶，烏爾姆。",
    "voice": "vo_adv_5220005_011",
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "妳想幫助大家嗎？",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "都已經自暴自棄了，",
    "voice": "vo_adv_5220005_012",
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "也不肯向任何人商量，",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n還因為自私的理由，甚至傷害了重要的姊姊。",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n即使如此，",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "妳還說得出「想幫助大家」嗎？",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "唔……！",
    "voice": "vo_adv_5220005_013",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "那",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "是……",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "妳明明很聰明，",
    "voice": "vo_adv_5220005_014",
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "卻做什麼都是個半吊子呢～♪",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n就連現在也是，",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "妳明明應該很恨我，",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "卻無法完全反駁我的話。",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "因為害怕被消滅",
    "voice": "vo_adv_5220005_015",
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "而自暴自棄。",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "明明連自己的心聲都不願說出口，",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "卻又把他人推開，認為沒人能理解自己的心情。",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "到頭來",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "甚至連自己真正的願望都迷失了，",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "整天迷惘個不停。",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "不過，",
    "voice": "vo_adv_5220005_016",
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "這也沒辦法♪",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n因為妳是",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "「贗品」",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "嘛。",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……贗",
    "voice": "vo_adv_5220005_017",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "品……？",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "難道不是嗎？",
    "voice": "vo_adv_5220005_018",
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n妳從頭到尾，",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "全～都是人造的。",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n就連感情",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "也不知道是不是真的呢～",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "無論妳再怎麼哭喊著說不一樣，",
    "voice": "vo_adv_5220005_019",
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n你們的生命與我們的生命本質不同，",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n這是無法抗拒的事實。",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "差不多該面對現實，",
    "voice": "vo_adv_5220005_020",
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "坦然接受了吧？",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n承認自己並不是什麼「正品」。",
    "voice": null,
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "…",
    "voice": "vo_adv_5220005_021",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……………",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "background",
    "bg_id": "500111"
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我",
    "voice": "vo_adv_5220005_022",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "身為吉歐‧提格尼亞的代表──",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n[rub:・]在[/rub][rub:・]這[/rub][rub:・]個[/rub][rub:・]世[/rub][rub:・]界[/rub][rub:・]誕[/rub][rub:・]生[/rub][rub:・]的[/rub][rub:・]人[/rub][rub:・]們[/rub]",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我發誓，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我一定會守護到底。",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "background",
    "bg_id": "501710"
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "因為我",
    "voice": "vo_adv_5220005_023",
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "從出生起就是「人造」的。",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "或許我無法理解",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "烏爾姆",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n直到最近才得知自己是「人造」的，",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "因而大受打擊的心情。",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "但是，",
    "voice": "vo_adv_5220005_024",
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "就算如此！",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n只要傷害了大家，",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "最終也會傷害到琳德的──！",
    "voice": null,
    "unit_id": 134511
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "可是……",
    "voice": "vo_adv_5220005_025",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "我啊，",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n雖然很不甘心，",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "卻也不會不甘心。",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "因為……",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "妳跟我不同……",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "知道",
    "voice": "vo_adv_5220005_026",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "烏爾姆有厲害的才能──",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "我很高興。",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "background",
    "bg_id": "501663"
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "…………不對。",
    "voice": "vo_adv_5220005_027",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n妳是",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "錯的。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "……！",
    "voice": "vo_adv_5220005_028",
    "unit_id": 106712
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "的確，",
    "voice": "vo_adv_5220005_029",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我是人造的。",
    "voice": null,
    "unit_id": 127812
  },
  {
