  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "守株待兔這種工作，",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "果然不合我的個性。",
    "voice": null,
