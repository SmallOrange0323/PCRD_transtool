[
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "莫夫，",
    "voice": "vo_adv_5118323_000",
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "你還想繼續打嗎？",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n不管戰鬥幾次，結果都會是一樣的。",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "莫夫",
    "words": "……呵呵，",
    "voice": "vo_adv_5118323_001",
    "unit_id": 17512
  },
  {
    "type": "dialogue",
    "name": "莫夫",
    "words": "還沒結束。",
    "voice": null,
    "unit_id": 17512
  },
  {
    "type": "dialogue",
    "name": "莫夫",
    "words": "\\n我還沒拿出所有的本事呢……！",
    "voice": null,
    "unit_id": 17512
  },
  {
    "type": "dialogue",
    "name": "莫夫",
    "words": "\\n",
    "voice": null,
    "unit_id": 17512
  },
  {
    "type": "dialogue",
    "name": "莫夫",
    "words": "不，",
    "voice": null,
    "unit_id": 17512
  },
  {
    "type": "dialogue",
    "name": "莫夫",
    "words": "不如說，精彩的才正要開始！",
    "voice": null,
    "unit_id": 17512
  },
  {
    "type": "dialogue",
    "name": "莫夫",
    "words": "到現在這一瞬間為止，我所累積的",
    "voice": "vo_adv_5118323_002",
    "unit_id": 17512
  },
  {
    "type": "dialogue",
    "name": "莫夫",
    "words": "知識、",
    "voice": null,
    "unit_id": 17512
  },
  {
    "type": "dialogue",
    "name": "莫夫",
    "words": "經驗、",
    "voice": null,
    "unit_id": 17512
  },
  {
    "type": "dialogue",
    "name": "莫夫",
    "words": "意志力！",
    "voice": null,
    "unit_id": 17512
  },
  {
    "type": "dialogue",
    "name": "莫夫",
    "words": "\\n讓我將其彙整，用來一口氣擊潰你們吧！",
    "voice": null,
    "unit_id": 17512
  },
  {
    "type": "dialogue",
    "name": "莫夫",
    "words": "\\n無知的存在啊，",
    "voice": null,
    "unit_id": 17512
  },
  {
    "type": "dialogue",
    "name": "莫夫",
    "words": "是時候懂得懼怕我所擁有的智慧了！！",
    "voice": null,
    "unit_id": 17512
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "哈哈！",
    "voice": "vo_adv_5118323_003",
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n都到了這地步竟開始耀武揚威，",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "莫夫你還是太缺乏鍛鍊了呢！",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "或許這也代表",
    "voice": "vo_adv_5118323_004",
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "他已經被逼到沒有心力管那麼多了。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n接下來恐怕會出現比先前更猛烈的攻勢。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "聽起來真不妙！",
    "voice": "vo_adv_5118323_005",
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "但反過來說，",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "只要撐過這一波，莫夫就沒辦法再耍花招了對吧？",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "既然如此，",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "我們要做的事只有一件！",
    "voice": null,
    "unit_id": 125611
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我們就堂堂正正地",
    "voice": "vo_adv_5118323_006",
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "正面粉碎莫夫的野心吧！",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n大家，",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "要上囉！",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "碧卡拉、花凜",
    "words": "嗯！\\n好的！",
    "voice": "vo_adv_5118323_007",
    "unit_id": null
  }
]
