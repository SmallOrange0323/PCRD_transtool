    "name": "拿娜",
    "words": "那個……",
    "voice": null,
    "unit_id": 136241
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "小騎士願意選拿娜……",
    "voice": null,
    "unit_id": 136241
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "\\n拿娜是嚇了一跳，",
    "voice": null,
    "unit_id": 136241
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "但卻更覺得開心！",
    "voice": null,
    "unit_id": 136241
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "\\n就是情緒突然湧出，",
    "voice": null,
    "unit_id": 136241
  },
