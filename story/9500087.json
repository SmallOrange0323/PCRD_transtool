  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "直都是沒用的兔子。",
    "voice": null,
    "unit_id": 136241
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "\\n很難努力，",
    "voice": null,
    "unit_id": 136241
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "即使偶爾努力了也會失敗。",
    "voice": null,
    "unit_id": 136241
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "\\n可即便如此，",
    "voice": null,
    "unit_id": 136241
  },
  {
    "type": "dialogue",
    "name": "拿娜",
    "words": "小騎士也沒有放棄拿娜……",
    "voice": null,
    "unit_id": 136241
  },
