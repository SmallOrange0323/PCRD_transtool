[
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "…………\\n……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "510450"
  },
  {
    "type": "dialogue",
    "name": "醫療人員",
    "words": "啊，",
    "voice": "vo_adv_1812004_000",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "醫療人員",
    "words": "你是深月小姐的助手對吧。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "醫療人員",
    "words": "\\n今天也是來確認紫布菜的狀況嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "醫療人員",
    "words": "我想紫布菜一定也會很高興。",
    "voice": "vo_adv_1812004_001",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "醫療人員",
    "words": "\\n不過，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "醫療人員",
    "words": "那個……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "醫療人員",
    "words": "\\n還請不要太過勉強自己喔。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "醫療人員",
    "words": "之前也有說過，",
    "voice": "vo_adv_1812004_002",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "醫療人員",
    "words": "就理論上來看，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "醫療人員",
    "words": "\\n紫布菜的靈魂",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "醫療人員",
    "words": "的確已經回到肉體裡了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "醫療人員",
    "words": "先不論好壞，",
    "voice": "vo_adv_1812004_003",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "醫療人員",
    "words": "接下來都只能靠她自己……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "醫療人員",
    "words": "\\n所以要是大家先把自己的身體搞壞，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "醫療人員",
    "words": "可就得不償失了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "醫療人員",
    "words": "這樣啊……",
    "voice": "vo_adv_1812004_004",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "醫療人員",
    "words": "\\n看來你真的",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "醫療人員",
    "words": "很重視紫布菜呢。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "醫療人員",
    "words": "\\n其實，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "醫療人員",
    "words": "其他人也都跟你說了一樣的話。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "醫療人員",
    "words": "既然如此，",
    "voice": "vo_adv_1812004_005",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "醫療人員",
    "words": "我也不再多說什麼了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "醫療人員",
    "words": "\\n但請記得",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "醫療人員",
    "words": "務必要好好休息，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "醫療人員",
    "words": "\\n這也是",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "醫療人員",
    "words": "為了紫布菜好。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "主人！",
    "voice": "vo_adv_1812004_006",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "原來您也來了。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "說到這個……",
    "voice": "vo_adv_1812004_007",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "她果然",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "還是沒有要甦醒的徵兆。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "雖然",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "生命跡象一切正常……",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n但是不是",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "有著連醫生也無法掌握的問題呢……",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "主人……",
    "voice": "vo_adv_1812004_008",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "您說得對。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n在下也真是的，",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "一不注意就過於操心了。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "除了深月小姐之外，",
    "voice": "vo_adv_1812004_009",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n其他醫療人員",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "也都很努力地在釐清原因。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "雪菲小姐",
    "voice": "vo_adv_1812004_010",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "也絕對不會想要這樣繼續下去。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n就像跟阿剌克涅女士",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "戰鬥的時候一樣……",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "她一定",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "會醒過來的對吧。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "雪菲小姐……",
    "voice": "vo_adv_1812004_011",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "不對，",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "應該叫阿賀斗紫布菜小姐才對。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n在下",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "曾在網路上",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "欣賞過您的表演。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "紫布菜小姐在冰上滑行時，",
    "voice": "vo_adv_1812004_012",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "不僅英氣風發，",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "還十分美麗。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "在下沒想過人可以像那樣在空中飛舞……",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "一不小心",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "就看入迷了。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "果然是這樣……",
    "voice": "vo_adv_1812004_013",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n她肯定是不停地鍛鍊自己呢。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "即便",
    "voice": "vo_adv_1812004_014",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "是在「另一邊」，",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n雪菲小姐也是十分努力的人。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "在下可以想像得出來，",
    "voice": "vo_adv_1812004_015",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "她即便做不好",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "也絕不放棄……",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "無論要試多少次，",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n都會帶著堅定直率的眼神，",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "努力練習的身影。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "…………",
    "voice": "vo_adv_1812004_016",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "……主人，",
    "voice": "vo_adv_1812004_017",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "在下該怎麼辦才好。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n一聊到",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "雪菲小姐的話題，",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n就越來越想念她了。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "關於雪菲小姐的回憶，",
    "voice": "vo_adv_1812004_018",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n那些跟【美食殿堂】一起度過，",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "熱鬧又開心的日子，",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "都不斷地湧上心頭……",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "雪菲小姐……",
    "voice": "vo_adv_1812004_019",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "不對，",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "紫布菜小姐。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "在下真的",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "好想早點跟您談話。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "像是彼此在這個世界的事情，",
    "voice": "vo_adv_1812004_020",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "以及",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "您跟家人……",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "跟贊恩先生的回憶等等。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "不管是想說的話，還是想問的事，",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "都有好多好多。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "不用說，",
    "voice": "vo_adv_1812004_021",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "在這邊也請讓在下盡情地照顧您。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "即便是不同的世界……",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "在下",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "依然是您的「媽媽」。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "……！",
    "voice": "vo_adv_1812004_022",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n裝置有點不太對勁……",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n難不成，",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "是因為碰到了主人的手……？",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "still",
    "still_id": "181200401"
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "……嗚、",
    "voice": "vo_adv_1812004_023",
    "unit_id": 106432
  },
  {
    "type": "dialogue",
    "name": "紫布菜",
    "words": "嗚嗚……",
    "voice": null,
    "unit_id": 106432
  },
  {
    "type": "dialogue",
