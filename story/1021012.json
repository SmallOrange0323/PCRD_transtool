  {
    "type": "dialogue",
    "name": "旁白",
    "words": "慈善義演當天──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n蘭德索爾廣場擠滿了等待",
    "voice": null,
    "unit_id": null
  },
  {
