    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500585"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "舞台劇在滿堂的鼓掌與喝彩聲中降下了帷幕。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n觀眾散場後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "劇團團員們聚集在熱氣猶存的舞台後方。",
