    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "男爵",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "男爵",
    "words": "請您務必",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "男爵",
    "words": "用自己的雙眼確認。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "另一方面，舞台後方。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}等人正從舞台側翼",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "偷偷觀察著觀眾席。",
