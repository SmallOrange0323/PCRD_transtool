  },
  {
    "type": "dialogue",
    "name": "男爵",
    "words": "公爵夫人，",
    "voice": "vo_adv_1021012_000",
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "男爵",
    "words": "\\n",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "男爵",
    "words": "非常感謝您的蒞臨。",
    "voice": null,
    "unit_id": 2511
  },
  {
    "type": "dialogue",
    "name": "觀眾１",
    "words": "我才要感謝您的邀請，",
    "voice": "vo_adv_1021012_001",
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "觀眾１",
    "words": "很期待今天的演出呢。",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "觀眾１",
    "words": "\\n",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "觀眾１",
    "words": "我從公爵那裡聽說囉？",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "觀眾１",
    "words": "\\n雖然是個沒什麼名氣的劇團，",
    "voice": null,
    "unit_id": 1514
  },
  {
    "type": "dialogue",
    "name": "觀眾１",
    "words": "但演技似乎非常亮眼呢。",
