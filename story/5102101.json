[
  {
    "type": "background",
    "bg_id": "500040"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──收藏家七七香的公會小屋中。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n鈴跟七七香正在小屋裡熱烈地玩格鬥遊戲。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "唔唔唔唔唔……！",
    "voice": "vo_adv_5102101_000",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "鈴閣下，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "妳變強了呢……！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "但是",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "這場勝負，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我會贏的！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "妳太認真了啦。",
    "voice": "vo_adv_5102101_001",
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "\\n",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "嘿。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "鈴",
    "words": "有破綻。",
    "voice": null,
    "unit_id": 102611
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "呀──！",
    "voice": "vo_adv_5102101_002",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "輸掉了──！？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我說，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "再打一場！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "再打一場吧！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "……哎呀？",
    "voice": "vo_adv_5102101_003",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我們玩得正盡興的說。",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n到底",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "是誰呀？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "來了──",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我現在就來開門喔──",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "……嗯，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "咦～！？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "午安，",
    "voice": "vo_adv_5102101_004",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "小七七香。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n抱歉，我突然來訪。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "為、",
    "voice": "vo_adv_5102101_005",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "為什麼【王宮騎士團】的團長，\\n會到我的公會小屋來！？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "難道說……",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "妳是來逮捕我的嗎！？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不，",
    "voice": "vo_adv_5102101_006",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "不是那樣的。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n……不過妳",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "有做了該被逮捕的壞事嗎？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "不不不不！",
    "voice": "vo_adv_5102101_007",
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "我怎麼敢呢！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "\\n",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "總、",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "總之，",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "比起那個！",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "七七香",
    "words": "妳找我有什麼事嗎？",
    "voice": null,
    "unit_id": 101311
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯。",
    "voice": "vo_adv_5102101_008",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "其實我有事情想要拜託妳……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "background",
    "bg_id": "500020"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "同一時刻。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n智在郊外巡邏時，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n看到了某面旗幟。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "那是",
    "voice": "vo_adv_5102101_009",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "「蘭德索爾文化祭」的旗子……",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "真好……",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "看起來好有趣……！",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我至今為止",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "都沒參加過呢……",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……",
    "voice": "vo_adv_5102101_010",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "但是",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我不能因為那種祭典而分心。",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "因為",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我除了是【王宮騎士團】的團員……",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n還是御久間流的繼承人啊……！",
    "voice": null,
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智等人",
    "words": "下回",
    "voice": "vo_adv_5102101_011",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "智等人",
    "words": "「點讚！最愛！大集合！　",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "智等人",
    "words": "至高祭典與少女祕密的本命任務」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500020"
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我",
    "voice": "vo_adv_5102101_012",
    "unit_id": 103712
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "會把我的「喜歡」隱藏好的……！",
    "voice": null,
    "unit_id": 103712
  }
]
