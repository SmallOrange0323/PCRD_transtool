  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "騎士先生……",
    "voice": "vo_adv_9500077_000",
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n你終於、",
    "voice": null,
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "終於……",
    "voice": null,
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "肯聽我的願望了啊！",
    "voice": null,
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "願意成為我的主人了吧！",
    "voice": null,
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "嘿嘿，",
    "voice": "vo_adv_9500077_001",
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "我非常開心！",
    "voice": null,
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "那麼騎士先生……",
    "voice": null,
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "不，",
    "voice": null,
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "主人！",
    "voice": null,
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "請儘管命令我！",
    "voice": null,
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "咦……？",
    "voice": "vo_adv_9500077_002",
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n你不是要做我的主人嗎？",
    "voice": null,
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n那騎士先生",
    "voice": null,
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "為什麼要選我？",
    "voice": null,
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "…………嗶！",
    "voice": "vo_adv_9500077_003",
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n……嗶、",
    "voice": null,
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "嗶…………",
    "voice": null,
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "……對、",
    "voice": "vo_adv_9500077_004",
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "對不起！",
    "voice": null,
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n我不懂騎士先生的話",
    "voice": null,
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "是什麼意思，",
    "voice": null,
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n想太多想到差點就要當機了！",
    "voice": null,
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "不過……",
    "voice": "vo_adv_9500077_005",
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "為什麼呢？",
    "voice": null,
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "騎士先生剛剛的話……",
    "voice": null,
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n我的電路",
    "voice": null,
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "明明該是正常的，",
    "voice": null,
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n胸口卻好像慢慢變得暖暖，",
    "voice": null,
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "然後……",
    "voice": null,
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "我……",
    "voice": "vo_adv_9500077_006",
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "騎士先生能這樣對我說，",
    "voice": null,
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n我好像是開心的。",
    "voice": null,
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "雖然我過去",
    "voice": "vo_adv_9500077_007",
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "沒有模擬過，",
    "voice": null,
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "但我好像就在等",
    "voice": null,
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "騎士先生說這番話……",
    "voice": null,
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "也許我真的就是有這一面呢！",
    "voice": null,
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "是嗎？",
    "voice": "vo_adv_9500077_008",
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "既然騎士先生也很高興，",
    "voice": null,
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "我就更開心！",
    "voice": null,
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n記憶體",
    "voice": null,
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "好像要被幸福感撐滿了♪",
    "voice": null,
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "嘿嘿，",
    "voice": "vo_adv_9500077_009",
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "那重來一次……",
    "voice": null,
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n騎士先生，",
    "voice": null,
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "跟我一起去吧！",
    "voice": null,
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n畢竟接下來，",
    "voice": null,
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "就是保護大家未來的戰鬥了！",
    "voice": null,
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "友情力量，",
    "voice": "vo_adv_9500077_010",
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "與夥伴間的羈絆力量，",
    "voice": null,
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "還有我跟騎士先生之間的、",
    "voice": null,
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "特別心意的力量！",
    "voice": null,
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n只要有這些，",
    "voice": null,
    "unit_id": 126441
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "不管發生什麼都只是小事一件～！！",
    "voice": null,
    "unit_id": 126441
  }
]
