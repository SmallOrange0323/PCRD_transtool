    "words": "\\n",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "怎麼會這樣……",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "她、",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "她們兩個",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "變成石頭……",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "喔～",
    "voice": "vo_adv_5160322_003",
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "呵呵！",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "石化不是妳的專利啊。",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "好啦，",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "妳也乖乖變成石頭吧。",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n我會讓妳沒有痛苦地結束的！",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "……結束？",
    "voice": "vo_adv_5160322_004",
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "別開玩笑了啊。",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "\\n這兩個人沒有那麼簡單就會結束的！",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "她們馬上就會復活的，",
    "voice": "vo_adv_5160322_005",
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "\\n在那之前我會一個人",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "梅杜莎",
    "words": "撐過去給妳看看！",
    "voice": null,
    "unit_id": 133611
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "好氣──！",
    "voice": "vo_adv_5160322_006",
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "就是這樣我才覺得小孩子很麻煩啊！",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n把她們三個全部變成壓醬菜的石頭吧──！",
    "voice": null,
    "unit_id": 134911
  }
]
