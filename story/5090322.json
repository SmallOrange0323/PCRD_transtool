[
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "哦……",
    "voice": "vo_adv_5090322_000",
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "沒想到妳們竟能擊退我的收藏品。",
    "voice": null,
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "\\n",
    "voice": null,
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "看來有一定的實力嘛。",
    "voice": null,
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "接下來就輪到你了，",
    "voice": "vo_adv_5090322_001",
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "莫名其妙的西裝老頭！",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "哼哼哼……",
    "voice": "vo_adv_5090322_002",
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "\\n在那之前，",
    "voice": null,
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "先讓妳們看看有趣的東西吧！",
    "voice": null,
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "嘖……！",
    "voice": "vo_adv_5090322_003",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n那個混帳……！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "竟然用「龍之卵」展開護盾……！！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "沒錯！",
    "voice": "vo_adv_5090322_004",
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "這就是用「龍之卵」使出的絕對防禦護盾！",
    "voice": null,
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "\\n我就在頭等席上",
    "voice": null,
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "欣賞妳們白費力氣的掙扎吧！",
    "voice": null,
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那種東西",
    "voice": "vo_adv_5090322_005",
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "到底",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "該怎麼才好……！？",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "不可以放棄喔，",
    "voice": "vo_adv_5090322_006",
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "祈梨……！！",
    "voice": null,
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "一定有方法",
    "voice": null,
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "可以解決的……！",
    "voice": null,
    "unit_id": 121511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "步未未……！",
    "voice": "vo_adv_5090322_007",
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……說得也是呢！",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那種東西，",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n只要一直揍一直揍一直揍下去，",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "遲早",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "就能打破了！",
    "voice": null,
    "unit_id": 121611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "哈，",
    "voice": "vo_adv_5090322_008",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這麼簡單不是很好嗎。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "那我們",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "拿出全力上吧！",
    "voice": null,
    "unit_id": 106511
  }
]
