  {
    "type": "dialogue",
    "name": "優衣",
    "words": "你、",
    "voice": "vo_adv_1289004_054",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "你說漂亮！",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n我是有注意別讓肌膚太乾燥，",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n但是",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "這樣就讓你說了漂亮……！",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "still",
    "still_id": "128900402"
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "咦？",
    "voice": "vo_adv_1289004_055",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n是、",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "是嗎。",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "你說的真美──",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "啊。",
    "voice": "vo_adv_1289004_056",
    "unit_id": 100231
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "still",
    "still_id": "128900403"
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "這樣啊，",
    "voice": "vo_adv_1289004_057",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "是花！",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n是在說花吧？",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "也對，",
    "voice": "vo_adv_1289004_058",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "畢竟我們在看花，",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n所以不會是說其他東西嘛，",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "啊哈哈……",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "再怎麼說也太會錯意了吧，",
    "voice": "vo_adv_1289004_059",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我真是的～！　",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "background",
    "bg_id": "510101"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "{0}。",
    "voice": "vo_adv_1289004_060",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n抱歉，",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "讓你陪我到這麼晚。",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "但多虧有你，幫了我大忙喔。",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……謝謝你。",
    "voice": "vo_adv_1289004_061",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n我也很開心。",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "明天……",
    "voice": "vo_adv_1289004_062",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "也對，",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "不如說",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "這本來就是為了明天而買的。",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "得將我們選的這束花，",
    "voice": "vo_adv_1289004_063",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n好好裝飾在教室裡。",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "真的嗎？",
    "voice": "vo_adv_1289004_064",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "真開心。",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n我變得越來越期待",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "明天到來了。",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "那麼，",
    "voice": "vo_adv_1289004_065",
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "{0}。",
    "voice": null,
    "unit_id": 100231
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n明天見！",
    "voice": null,
    "unit_id": 100231
  },
