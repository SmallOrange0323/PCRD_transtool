[
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "要尊重對方，",
    "voice": "vo_adv_5122301_000",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "這可是",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "做生意的基礎。",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "從你小看我們的那一刻起，",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "就已經毀掉了與我們共存的可能性了喔。",
    "voice": null,
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "難得這麼久才見面……",
    "voice": "vo_adv_5122301_001",
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "都還沒舉杯暢飲一番的說，",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "真可惜呢。",
    "voice": null,
    "unit_id": 126811
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "區區人類……",
    "voice": "vo_adv_5122301_002",
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "真令人不快！！",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "不好意思，",
    "voice": "vo_adv_5122301_003",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "令人不快的是你。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "妳說什麼！？",
    "voice": "vo_adv_5122301_004",
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "島鯨",
    "words": "\\n少瞧不起我……！",
    "voice": null,
    "unit_id": 10412
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "──來吧，",
    "voice": "vo_adv_5122301_005",
    "unit_id": 126711
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "要上囉！",
    "voice": null,
    "unit_id": 126711
  }
]
