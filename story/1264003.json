[
  {
    "type": "background",
    "bg_id": "501660"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "克蘿茜首次拜訪阿斯特賴亞大陸後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n過了數天──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "然後呢，",
    "voice": "vo_adv_1264003_000",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "波波爺爺！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n蘭德索爾",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "有一座非常大的城堡！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n而且",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "不是用點心做成的喔！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "聽過很多遍了所以老夫知道。",
    "voice": "vo_adv_1264003_001",
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "\\n是用石頭做的對吧？",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "\\n真是的，",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "妳這陣子都只顧著說蘭德索爾的事情。",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "嘿嘿，",
    "voice": "vo_adv_1264003_002",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "抱歉♪",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "──啊，",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "騎士先生！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "喂──",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "這裡～！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "你來了啊，",
    "voice": "vo_adv_1264003_003",
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "小伙子！",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "\\n等你很久囉！",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "嘎哈哈，",
    "voice": "vo_adv_1264003_004",
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "問得真好！",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "\\n事不宜遲，",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "就讓你看看這傢伙吧！",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "\\n老夫開發的",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "新裝備──────！！",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "鏘鏘鏘鏘～♪",
    "voice": "vo_adv_1264003_005",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "才不是！",
    "voice": "vo_adv_1264003_006",
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "\\n",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "不，",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "看起來雖然是這樣，這點老夫不否定喔？",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "老夫理解你為什麼誤會！",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "\\n",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "但是，",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "這完全是",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "別的東西！",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "畢竟這傢伙是──",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "能連接你和克蘿茜的",
    "voice": "vo_adv_1264003_007",
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "特製系統啊！",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "我和騎士先生？",
    "voice": "vo_adv_1264003_008",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "你看，",
    "voice": "vo_adv_1264003_009",
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "這個座位前面有個皮帶對吧？",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "\\n",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "有了這個啊，",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "克蘿茜就可以揹上這傢伙。",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "就像是後揹包一樣的感覺呢！",
    "voice": "vo_adv_1264003_010",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n然後呢然後呢？",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "首先是小伙子坐上座椅！",
    "voice": "vo_adv_1264003_011",
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "\\n然後接著",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "克蘿茜把小伙子和座椅整個揹起來！",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "嗯哼嗯哼！",
    "voice": "vo_adv_1264003_012",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "就像",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "揹小孩一樣對吧？",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "不要說這麼煞風景的話！",
    "voice": "vo_adv_1264003_013",
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "\\n",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "跟揹小孩不一樣，妳的雙手可以自由使用喔？",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "\\n很方便吧！",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "這還用得著說嗎！",
    "voice": "vo_adv_1264003_014",
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "\\n為了要確認你們的可能性啊！",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "雖然不曉得原因，",
    "voice": "vo_adv_1264003_015",
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "但你確實能幫克蘿茜充電。",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "\\n",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "老夫一直在調查機械人族，",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "卻都沒有其他像這樣方便的存在。",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "\\n……隨便使用太多能量也會被萊拉耶爾殿下罵。",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "這次的裝備",
    "voice": "vo_adv_1264003_016",
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "是為了防止克蘿茜耗盡能量。",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "\\n只要經常和小伙子待在一起，",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "隨時隨地都能充電！",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "\\n所以一定還能附帶",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "力量全開的功能！",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "更何況！",
    "voice": "vo_adv_1264003_017",
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "\\n現在的你們",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "還要一起擊退魔物，",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "也會一起出門旅行。",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "\\n你們稍微貼在一起應該也不會造成問題。",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "不是嗎？",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "原來如此──！",
    "voice": "vo_adv_1264003_018",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "確實是這樣呢！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n我們",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "比之前也更有默契了♪",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "好──！",
    "voice": "vo_adv_1264003_019",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n那麼騎士先生！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "我們來試試",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "連接系統吧！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "嘿咻！",
    "voice": "vo_adv_1264003_020",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n騎士先生，",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "坐起來舒適嗎？",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "哇！",
    "voice": "vo_adv_1264003_021",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n真的嗎？",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "嘿嘿，",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "總覺得好開心～！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "啊哈哈，",
    "voice": "vo_adv_1264003_022",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "沒關係！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n這也只是實驗！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n完──全不會丟臉喔♪",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "各就各位了！",
    "voice": "vo_adv_1264003_023",
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "\\n",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "小伙子，",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "幫克蘿茜充電！",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "來了來了──！",
    "voice": "vo_adv_1264003_024",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "騎士先生的能量",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "直接傳過來了！！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n我隨時都能飛喔～！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "好了去吧，",
    "voice": "vo_adv_1264003_025",
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "你們兩個！",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "\\n「騎士組合‧連接系統　",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "揹-揹」！！",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "\\n",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "實驗開始──────！！！",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "好的！",
    "voice": "vo_adv_1264003_026",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n騎士先生，",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "抓緊了喔！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "準……",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "備！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "still",
    "still_id": "126400301"
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "克蘿茜，",
    "voice": "vo_adv_1264003_027",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "起飛──！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "哇！",
    "voice": "vo_adv_1264003_028",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n這是比我以前都還要更厲害的",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "速度呢！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n說不定比之前在蘭德索爾飛行的時候還要快？",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "啊！",
    "voice": "vo_adv_1264003_029",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n該不會，",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "就是因為那時候並沒有在充電的緣故？",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "是的話我們說不定實驗成功了呢！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "喂喂～！",
    "voice": "vo_adv_1264003_030",
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "\\n感覺",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "如何！",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "狀態極佳──！",
    "voice": "vo_adv_1264003_031",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "嘎哈哈！",
    "voice": "vo_adv_1264003_032",
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "\\n這樣啊這樣啊，",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "果然老夫的判斷沒有錯！",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "\\n如何，",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "你們暫時先在這附近來回飛看看！",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "這也是實驗！",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "好──！",
    "voice": "vo_adv_1264003_033",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n波波爺爺，",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "我出發了──♪",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "騎士先生騎士先生！",
    "voice": "vo_adv_1264003_034",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n雖然已經飛得很好了，",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "你覺得這個速度可以嗎？",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n要再快一點嗎？",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "那就好！",
    "voice": "vo_adv_1264003_035",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n速度如果太快，",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "導致裝備壞掉的話就不好了！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n啊哈哈♪",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "而且，",
    "voice": "vo_adv_1264003_036",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "我好驚訝。",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n事實上，",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "我幾乎沒有這麼長時間飛行過喔～！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n噴射器太耗能了！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "所以，",
    "voice": "vo_adv_1264003_037",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "緊急時刻！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "的時候才會使用飛行能力！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n萊拉耶爾殿下也是這麼交代的。",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "因為我很喜歡在空中飛行，",
    "voice": "vo_adv_1264003_038",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "所以還覺得有點遺憾呢……",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n能量耗盡的話就不好了。",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n因此原本覺得那也是沒有辦法的事。",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "就是因為這樣！",
    "voice": "vo_adv_1264003_039",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n如果沒有遇上騎士先生，",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n我也就不能像這樣在空中飛行了呢！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "我",
    "voice": "vo_adv_1264003_040",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "真心覺得遇到騎士先生真的太好了！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "啊！",
    "voice": "vo_adv_1264003_041",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n當然不只是因為",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "你會幫我充電喔！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "雖說這一點",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "當然也很重要……",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "嗯──",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "怎麼說呢……",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "我感到非常",
    "voice": "vo_adv_1264003_042",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "非常",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "非～",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "常！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n開心～",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n變得想要",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "一直待在一起的程度～♪",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "畢竟",
    "voice": "vo_adv_1264003_043",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "和騎士先生在一起的話，什麼事情都辦得到！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n而且而且！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n騎士先生",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "還教會了我許多事情！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "像是擊退魔物的方式，",
    "voice": "vo_adv_1264003_044",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "還有其他世界的事情！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n我還有好──多不知道的事情！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "所以，騎士先生！",
    "voice": "vo_adv_1264003_045",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n以後也多多教我一些",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "我不知道的事情吧！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "謝謝你！",
    "voice": "vo_adv_1264003_046",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n我",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "該不會其實好奇心很旺盛吧？",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n啊哈哈，",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "我連這件事都不知道呢♪",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "啊！",
    "voice": "vo_adv_1264003_047",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n相對的，",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "「吉歐‧提格尼亞」的事情也都可以問我喔！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "我們互教對方吧♪",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "still",
    "still_id": "126400302"
  },
  {
    "type": "dialogue",
    "name": "魔物群",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "咦？",
    "voice": "vo_adv_1264003_048",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n騎士先生，",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "那邊的空中有孔洞！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n魔物也出現了喔！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "不好了！",
    "voice": "vo_adv_1264003_049",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n波波爺爺就在那下面，",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "得快點──",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "魔物群",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "哇哇！？",
    "voice": "vo_adv_1264003_050",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "牠們往這裡飛過來了！",
    "voice": null,
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n仔細一看，都是有翅膀的魔物！",
    "voice": null,
    "unit_id": 126411
  },
