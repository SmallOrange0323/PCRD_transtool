  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "一樣？",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "波波爺爺",
    "words": "\\n怎怎怎麼說！？",
    "voice": null,
    "unit_id": 9212
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "只要騎士先生幫我充電，",
    "voice": "vo_adv_1264003_060",
    "unit_id": 126411
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "都能暫時變得元氣滿滿！",
