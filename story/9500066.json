    "unit_id": 123341
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "真的真的是真的嗎？",
    "voice": null,
    "unit_id": 123341
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 123341
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "你喜歡涅婭姐姐我嗎？",
    "voice": null,
    "unit_id": 123341
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "嗯呵呵呵呵～",
    "voice": "vo_adv_9500066_001",
    "unit_id": 123341
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "這樣啊這樣啊～♪",
    "voice": null,
    "unit_id": 123341
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n不妙，",
    "voice": null,
    "unit_id": 123341
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "我超開心的～",
    "voice": null,
    "unit_id": 123341
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "真的是兩情相悅嘛～♡",
    "voice": null,
    "unit_id": 123341
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "嗯呵呵～",
    "voice": "vo_adv_9500066_002",
    "unit_id": 123341
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 123341
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "小騎士像這樣把愛情具象化，",
    "voice": null,
    "unit_id": 123341
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 123341
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "讓我感～覺有了勇氣♡",
    "voice": null,
    "unit_id": 123341
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "哈～～",
    "voice": "vo_adv_9500066_003",
    "unit_id": 123341
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "太棒了♡",
    "voice": null,
    "unit_id": 123341
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "太棒了♡",
    "voice": null,
    "unit_id": 123341
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n真～讓人興奮～",
    "voice": null,
    "unit_id": 123341
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n果然愛情",
    "voice": null,
    "unit_id": 123341
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "就是會超越",
    "voice": null,
    "unit_id": 123341
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "喜歡的類型和",
    "voice": null,
    "unit_id": 123341
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "性癖之類的呢～",
    "voice": null,
    "unit_id": 123341
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "胸口這一帶",
    "voice": "vo_adv_9500066_004",
    "unit_id": 123341
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "會揪緊，",
    "voice": null,
    "unit_id": 123341
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "變得超～級溫暖……",
    "voice": null,
    "unit_id": 123341
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n該說跟正太感應器嗶嗶☆",
    "voice": null,
    "unit_id": 123341
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "響那種感覺",
    "voice": null,
    "unit_id": 123341
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "有點不一樣嗎？",
    "voice": null,
    "unit_id": 123341
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n這一定",
    "voice": null,
    "unit_id": 123341
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "就是喜歡、真正戀愛",
    "voice": null,
    "unit_id": 123341
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "的那種感覺吧？",
    "voice": null,
    "unit_id": 123341
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "之類的？",
    "voice": null,
    "unit_id": 123341
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "話說～",
    "voice": "vo_adv_9500066_005",
    "unit_id": 123341
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "被喜歡的人喜歡著什麼的～",
    "voice": null,
    "unit_id": 123341
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n可是我的初次經驗啊♡",
    "voice": null,
    "unit_id": 123341
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "呀～心動到停不下來了～",
    "voice": null,
    "unit_id": 123341
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n真的謝啦，",
    "voice": null,
    "unit_id": 123341
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "小騎士♡",
    "voice": null,
    "unit_id": 123341
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "……不過，",
    "voice": "vo_adv_9500066_006",
    "unit_id": 123341
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "要說有什麼障礙的話，",
    "voice": null,
    "unit_id": 123341
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "大概就只有引進一妻多夫制了吧～",
    "voice": null,
    "unit_id": 123341
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 123341
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "跟小卡里莎也是，",
    "voice": null,
    "unit_id": 123341
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "雖然不知道會是幾年後。",
    "voice": null,
    "unit_id": 123341
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 123341
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "但是，",
    "voice": null,
    "unit_id": 123341
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "我們３人",
    "voice": null,
    "unit_id": 123341
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "可是「Love♡Forever」啊？",
    "voice": null,
    "unit_id": 123341
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "今後也是，",
    "voice": "vo_adv_9500066_007",
    "unit_id": 123341
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "都能齊心協力克服的吧♪",
    "voice": null,
    "unit_id": 123341
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 123341
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "總之小騎士，",
    "voice": null,
    "unit_id": 123341
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "讓我抱一下～♡",
    "voice": null,
    "unit_id": 123341
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 123341
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "真是的～",
    "voice": null,
    "unit_id": 123341
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "真的超喜歡你～♪",
    "voice": null,
    "unit_id": 123341
  },
  {
