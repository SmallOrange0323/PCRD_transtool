[
  {
    "type": "background",
    "bg_id": "500651"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "平穩的日子日復一日，一年又接近尾聲了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n三名女性走在準備迎接跨年，充滿活力大江戶町。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "哇～",
    "voice": "vo_adv_5108000_000",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n大家看起來都好忙喔～♪",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "應該是因為商人都在準備年末和年初的特賣，",
    "voice": "vo_adv_5108000_001",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "而公務人員也忙著預防事故吧。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "看到這種熱鬧的景象，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "真的會讓人感覺到一年要結束了呢。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀哎呀，",
    "voice": "vo_adv_5108000_002",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "會讓人坐立難安，覺得自己也該動起來呢～",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "不去幫忙好嗎……",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不行，美里，",
    "voice": "vo_adv_5108000_003",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "別想那種事情。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我們這次",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "來大江戶町是為了──",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "──舉辦「大人的尾牙」",
    "voice": "vo_adv_5108000_004",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "而來的～♪",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "呵呵，",
    "voice": "vo_adv_5108000_005",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "這我當然知道♪",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "這趟溫泉旅行",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "要持續到跨年，",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "真是奢華的享受呢。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "深月、",
    "voice": "vo_adv_5108000_006",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "帆稀，",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n謝謝妳們",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "邀請我。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n……",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "不過，",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "為什麼會想到要找我呢？",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我想，",
    "voice": "vo_adv_5108000_007",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "應該算緣分吧。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n美里平常總是會分享治療藥的素材給我。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "精靈之森的植物是很珍貴的，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "所以這幫了我不少忙喔。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "而我的狀況是，",
    "voice": "vo_adv_5108000_008",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n平時我們家的成員",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "要是受傷了都會找深月幫忙～",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "所以美里也算是",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "間接地幫助了我喔～♪",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "呵呵，",
    "voice": "vo_adv_5108000_009",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "還真是",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "隔了好幾層的緣分呢。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "既然如此，",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "那我就不客氣地接受兩位的好意了。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "帆稀，話說回來，",
    "voice": "vo_adv_5108000_010",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我們要去的溫泉旅館在哪裡？",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n我之前也有來大江戶泡過溫泉，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n再走下去，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "就要走出城鎮了喔？",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "呵呵呵～",
    "voice": "vo_adv_5108000_011",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我們今天要去的地方呀～",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n是一家在城鎮邊緣，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "在大江戶之中",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "也屬歷史悠久的溫泉旅館老店喔～",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "聽說年末那邊幾乎都客滿，",
    "voice": "vo_adv_5108000_012",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "這次有稍微努力一番，才成功預約到房間喔～♪\\n………………………………………………………………",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "讓祈梨努力了。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "剛剛",
    "voice": "vo_adv_5108000_013",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "最後好像還有說了些什麼……",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "是喔，",
    "voice": "vo_adv_5108000_014",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "真令人期待。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "感覺會是能悠閒放鬆，最棒的一次跨年……♪",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "咦～？",
    "voice": "vo_adv_5108000_015",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n真難想像地下社會極負盛名的",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "「獨眼惡魔」會說出這種話呢～",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "哎呀，妳不也是一樣。",
    "voice": "vo_adv_5108000_016",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n幫派成員的頭目來泡溫泉跨年，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n這樣能當家族的榜樣嗎？",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "兩人",
    "words": "呵呵呵呵呵……♪",
    "voice": "vo_adv_5108000_017",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀哎呀，",
    "voice": "vo_adv_5108000_018",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "妳們感情真好呢～",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "不過，",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "鎮上的人都被妳們嚇到了，",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "要在城鎮裡笑",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "請適可而止喔。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "……不過，",
    "voice": "vo_adv_5108000_019",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "只有我來享受，",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "總覺得有點過意不去。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "希望哪天可以和孩子們，",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "還有公會的大家一起來。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "然後，",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "也和他……",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "嗯～？",
    "voice": "vo_adv_5108000_020",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "美里剛剛",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "在想誰呀？",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "一臉含情脈脈的表情，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "真好奇～♪",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎、",
    "voice": "vo_adv_5108000_021",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀哎呀，",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我哪有擺出那種表情。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n……",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "深月，",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "應該沒有吧？",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "別擔心，",
    "voice": "vo_adv_5108000_022",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "帆稀她在捉弄妳而已。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我一直很嚮往，",
    "voice": "vo_adv_5108000_023",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "聊這種姐妹淘之間的話題～♪",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我身邊的孩子們，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "各個都血氣方剛～",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "感覺他們",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "比起談情說愛，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "更喜歡以拳交心。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
