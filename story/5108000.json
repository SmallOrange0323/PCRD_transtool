  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "謝謝妳們。",
    "voice": null,
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "{0}，你也聽到了。",
    "voice": "vo_adv_5108000_071",
    "unit_id": 101512
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n可以讓我們",
