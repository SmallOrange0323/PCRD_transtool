[
  {
    "type": "background",
    "bg_id": "509040"
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "咦？",
    "voice": "vo_adv_9500079_000",
    "unit_id": 127741
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n怎麼會……",
    "voice": null,
    "unit_id": 127741
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "真的要選我嗎？",
    "voice": null,
    "unit_id": 127741
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "因為我",
    "voice": "vo_adv_9500079_001",
    "unit_id": 127741
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "又不擅長戰鬥，",
    "voice": null,
    "unit_id": 127741
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "只是個女僕……",
    "voice": null,
    "unit_id": 127741
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n並不是像騎士先生等人",
    "voice": null,
    "unit_id": 127741
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "那樣的人類喔？",
    "voice": null,
    "unit_id": 127741
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n好不容易才有的特別之力，",
    "voice": null,
    "unit_id": 127741
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "還是選別人會更好……",
    "voice": null,
    "unit_id": 127741
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "那、",
    "voice": "vo_adv_9500079_002",
    "unit_id": 127741
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "那是……",
    "voice": null,
    "unit_id": 127741
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "……這、",
    "voice": "vo_adv_9500079_003",
    "unit_id": 127741
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "還用說嘛。",
    "voice": null,
    "unit_id": 127741
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "明明城堡的各位和",
    "voice": "vo_adv_9500079_004",
    "unit_id": 127741
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "萊拉耶爾殿下都受了傷，",
    "voice": null,
    "unit_id": 127741
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n烏爾姆那麼痛苦。",
    "voice": null,
    "unit_id": 127741
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n",
    "voice": null,
    "unit_id": 127741
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "……明明被「製造」成會痛苦的樣子。",
    "voice": null,
    "unit_id": 127741
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "然而，",
    "voice": "vo_adv_9500079_005",
    "unit_id": 127741
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "當時的我沒有力量。",
    "voice": null,
    "unit_id": 127741
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n就算是現在，",
    "voice": null,
    "unit_id": 127741
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "我也還是會感到恐懼。",
    "voice": null,
    "unit_id": 127741
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n這樣、",
    "voice": null,
    "unit_id": 127741
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "我當然很不甘心啊……！",
    "voice": null,
    "unit_id": 127741
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "我",
    "voice": "vo_adv_9500079_006",
    "unit_id": 127741
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "真沒用啊。",
    "voice": null,
    "unit_id": 127741
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n明明是想著這下或許能報恩了，",
    "voice": null,
    "unit_id": 127741
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n",
    "voice": null,
    "unit_id": 127741
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "結果",
    "voice": null,
    "unit_id": 127741
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "還是要讓騎士先生顧慮我。",
    "voice": null,
    "unit_id": 127741
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "不過，",
    "voice": "vo_adv_9500079_007",
    "unit_id": 127741
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "其實我有種感覺。",
    "voice": null,
    "unit_id": 127741
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n",
    "voice": null,
    "unit_id": 127741
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "我總是受到騎士先生的幫助……",
    "voice": null,
    "unit_id": 127741
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n或許一輩子",
    "voice": null,
    "unit_id": 127741
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "都還不了這份恩情了、",
    "voice": null,
    "unit_id": 127741
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "這樣。",
    "voice": null,
    "unit_id": 127741
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "騎士先生……",
    "voice": "vo_adv_9500079_008",
    "unit_id": 127741
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "好的！",
    "voice": null,
    "unit_id": 127741
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n等我們一起打倒那個人，",
    "voice": null,
    "unit_id": 127741
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n請讓我",
    "voice": null,
    "unit_id": 127741
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "再跟你「道謝」！",
    "voice": null,
    "unit_id": 127741
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "顏色……",
    "voice": "vo_adv_9500079_009",
    "unit_id": 127741
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "呵呵。",
    "voice": null,
    "unit_id": 127741
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n",
    "voice": null,
    "unit_id": 127741
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "說得對。",
    "voice": null,
    "unit_id": 127741
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n得罵壞人一頓，",
    "voice": null,
    "unit_id": 127741
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "讓她好好反省！",
    "voice": null,
    "unit_id": 127741
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "我們走吧，",
    "voice": "vo_adv_9500079_010",
    "unit_id": 127741
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "騎士先生！",
    "voice": null,
    "unit_id": 127741
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n得教會那些人，",
    "voice": null,
    "unit_id": 127741
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "就算是弱小的「人造物」……",
    "voice": null,
    "unit_id": 127741
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n也能好好戰鬥！",
    "voice": null,
    "unit_id": 127741
  }
]
