    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "……嘻嘻。",
    "voice": "vo_adv_1027009_002",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n嘻嘻嘻……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我找到您了……",
    "voice": "vo_adv_1027009_003",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n{0}大人……♪",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "background",
    "bg_id": "501580"
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "您醒來了嗎？",
    "voice": "vo_adv_1027009_004",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n嘻嘻嘻嘻……♪",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "您露出了",
    "voice": "vo_adv_1027009_005",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "不知道這是哪裡的表情呢……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n還請放心，",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "這裡是位於蘭德索爾郊區的一間空屋……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "咦？",
    "voice": "vo_adv_1027009_006",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "您說自己",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "無法動彈……？",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n我想也是。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "畢竟，",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我把您的手腳都綁起來了。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "還請不要在意這種小事……",
    "voice": "vo_adv_1027009_007",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "因為從今天起，",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我們兩人……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "就要一起在這裡生活了。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "命中注定要結合的兩人……",
    "voice": "vo_adv_1027009_008",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "今後要",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "一年四季！",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "一天24小時！",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "直到永遠！",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n都只看著對方活下去……！",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "既然如此，就算身體無法動彈……",
    "voice": "vo_adv_1027009_009",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n也算不了什麼……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "咦……？",
    "voice": "vo_adv_1027009_010",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "嘻嘻……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "沒有這回事喔……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n我是惠理子……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "是大人您的",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "惠理子……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "而您則是……",
    "voice": "vo_adv_1027009_011",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n我的……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n沒錯……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我的{0}大人……♪",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "來……",
    "voice": "vo_adv_1027009_012",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n請您好好看清楚……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我的眼睛、",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "臉蛋、",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "身體……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "將我的一切，",
    "voice": "vo_adv_1027009_013",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "盡收眼底……！！",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "妳這頭野獸，",
    "voice": "vo_adv_1027009_014",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "給我住手。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "唔！",
    "voice": "vo_adv_1027009_015",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "這個聲音是……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子？",
    "words": "我可不准妳繼續胡作非為。",
    "voice": "vo_adv_1027009_016",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子？",
    "words": "\\n別用那骯髒的臉，",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子？",
    "words": "接近那位大人。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "真遺憾……",
    "voice": "vo_adv_1027009_017",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "被妳找到了……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "還以為妳無法掌握我的行蹤呢……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子？",
    "words": "{0}大人，",
    "voice": "vo_adv_1027009_018",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子？",
    "words": "您搞錯了。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子？",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子？",
    "words": "我才是惠理子。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子？",
    "words": "而那頭野獸",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子？",
    "words": "並不是我……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "background",
    "bg_id": "501580"
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "唔…",
    "voice": "vo_adv_1027009_019",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "…！？",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "不明魔物",
    "words": "嗚嗚……！",
    "voice": "vo_adv_1027009_020",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "不明魔物",
    "words": "\\n這傢伙……",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "不明魔物",
    "words": "一口氣就拉近了距離……！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "總算變回原本的樣子了。",
    "voice": "vo_adv_1027009_021",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n接下來……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我要懲罰妳擅自觸碰那位大人！",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "不明魔物",
    "words": "哼……",
    "voice": "vo_adv_1027009_022",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "不明魔物",
    "words": "我可不會讓妳得逞……",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "不明魔物",
    "words": "\\n現在就先暫時撤退……！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "不明魔物",
    "words": "大人……",
    "voice": "vo_adv_1027009_023",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "不明魔物",
    "words": "\\n這次的幽會被人打擾了，",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "不明魔物",
    "words": "就讓我們下次再相見吧……",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "不明魔物",
    "words": "再會了……♪",
    "voice": "vo_adv_1027009_024",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "被它逃掉了嗎……",
    "voice": "vo_adv_1027009_025",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n動作那麼俐落，真是礙眼……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "啊啊，",
    "voice": "vo_adv_1027009_026",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "更重要的是……！",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "{0}大人，",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "您沒有受傷吧……！",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "來，",
    "voice": "vo_adv_1027009_027",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我解開繩子了……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "那隻魔物竟然對您這麼粗暴……！",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "果然",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "不能就這樣放過它……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "這個……",
    "voice": "vo_adv_1027009_028",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "目前的狀況有些複雜。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n我一定會跟您說明清楚……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "但我們先離開這個地方吧。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "background",
    "bg_id": "500950"
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "來吧，",
    "voice": "vo_adv_1027009_029",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "到這裡應該就安全了。",
