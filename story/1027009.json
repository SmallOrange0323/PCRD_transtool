  {
    "type": "dialogue",
    "name": "旁白",
    "words": "當{0}在散步時，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n看見惠理子似乎正在找人。",
