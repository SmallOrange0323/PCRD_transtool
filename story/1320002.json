[
  {
    "type": "background",
    "bg_id": "500160"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "為了觀察{0}，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n艾姬多娜開始在夏天的海邊打工了，但是──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "132000201"
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "這裡的沙子",
    "voice": "vo_adv_1320002_000",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "還真細呢。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n是海邊這種地方的特徵嗎？",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "原來如此。",
    "voice": "vo_adv_1320002_001",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n海邊不只是水，",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "連沙子都含有大量的鹽分呢。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n這就是導致植物無法生長的原因嗎？",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "稍微離開一點的地方，",
    "voice": "vo_adv_1320002_002",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "有長出樹木。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n海的影響",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "會對大地造成何種程度的作用，",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "讓我很有興趣呢。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "嗯。",
    "voice": "vo_adv_1320002_003",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n這個被丟掉的容器使用的素材，",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "是我沒看過的素材。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n它的原料是什麼啊？",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "從它被這樣",
    "voice": "vo_adv_1320002_004",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "隨意丟棄的狀況來看，",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n應該不是太貴重的東西的樣子。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "也就是說",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "被大量生產了嗎。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "人的慾望沒有盡頭呢。",
    "voice": "vo_adv_1320002_005",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "啊，不是，",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我不是在譴責他們喔。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "因為慾望",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "對我來說",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "是伴侶啊。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "still",
    "still_id": "132000201"
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "哎呀？",
    "voice": "vo_adv_1320002_006",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "這個生物",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "有著不可思議的形狀呢。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我想把牠帶回去，",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "好好觀察牠的生態啊。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "這邊也有",
    "voice": "vo_adv_1320002_007",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我沒看過的生物……！",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "這會讓我忍不住分心呢。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我希望不只沙灘上，",
    "voice": "vo_adv_1320002_008",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "連海裡的生物都能好好地……",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "哎呀，",
    "voice": "vo_adv_1320002_009",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "居然被懷疑我沒有在工作，那讓我覺得很遺憾呢。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我希望你能好好想一下。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我來這個世界",
    "voice": "vo_adv_1320002_010",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "還沒有多久喔？",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "換句話說，",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我目前的狀態，還沒辦法分辨出",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n打工這項行為所要收集的東西，",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "也就是說沒辦法分辨哪些是垃圾啊。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "正是因為如此，",
    "voice": "vo_adv_1320002_011",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我才必須先像這樣好好觀察，",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n去理解它們才行喔。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我很高興你能理解。",
    "voice": "vo_adv_1320002_012",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "雖然我",
    "voice": "vo_adv_1320002_013",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "並沒有什麼太深遠的意思，",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n但是在跟我以外的人講話時，",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "你稍微多抱點疑心應該比較好呢。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "因為這世上",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "有很多壞人啊。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "那麼就繼續觀察……",
    "voice": "vo_adv_1320002_014",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "撿垃圾吧。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "那邊也",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "有什麼奇妙的──",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "──嗯。",
    "voice": "vo_adv_1320002_015",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "不，",
    "voice": "vo_adv_1320002_016",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "沒什麼事啦。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n我只是",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "已經累到站不起來了而已。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我說過了吧？",
    "voice": "vo_adv_1320002_017",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我不擅長肉體勞動啊。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n而且你已經",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "撿了很多垃圾了吧？",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "就算是你也該……",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "你看起來還很健康呢。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "讓我很吃驚啊。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "……抱歉，可以拉我一把嗎？",
    "voice": "vo_adv_1320002_018",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n要是我就這樣站不起來，",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "被波浪捲走溺死的話，",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n你的良心也會過意不去吧？",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "background",
    "bg_id": "500160"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "謝謝你。",
    "voice": "vo_adv_1320002_019",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "好啦……",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "應該差不多可以了吧。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我已經充分享受了這個名為打工的行為了。",
    "voice": "vo_adv_1320002_020",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我確實有說我會幫你。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n但是，",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "已經──",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "那真是太好了。",
    "voice": "vo_adv_1320002_021",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我當然",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "是還有餘力啦，",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "但是你說要結束的話，",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我很樂意──",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "……你說什麼？",
    "voice": "vo_adv_1320002_022",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "抱歉，",
    "voice": "vo_adv_1320002_023",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我可能是聽錯了。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "你剛剛說了什麼，",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "可以再說給我聽一次嗎？",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "接下來是要……",
    "voice": "vo_adv_1320002_024",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "在海邊巡邏……？",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "難道說你",
    "voice": "vo_adv_1320002_025",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "還要繼續這個名為打工的行為嗎？",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "……老實說這出乎我的預料之外。",
    "voice": "vo_adv_1320002_026",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "雖然我本來打算要結束了──",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n但是我變得",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "想更想了解你了。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "你的行動本身",
    "voice": "vo_adv_1320002_027",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "就是「未知」啊。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "啊，",
    "voice": "vo_adv_1320002_028",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我當然會幫忙喔。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "因為說了要幫忙你的人是我啊。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "……但是，",
    "voice": "vo_adv_1320002_029",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我可不想再繼續肉體勞動了喔？",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "background",
    "bg_id": "501030"
  },
  {
    "type": "background",
    "bg_id": "501030"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "――嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "也就是說",
    "voice": "vo_adv_1320002_030",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "這次是要確保海邊的安全嗎。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "如果是對人來說很好的自然環境的話，",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "魔物當然也會靠過來。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "這裡看起來，",
    "voice": "vo_adv_1320002_031",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n沒有驅除魔物的結界之類的東西呢。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "不過，",
    "voice": "vo_adv_1320002_032",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "就算有結界──",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "魔物群",
    "words": "──咕喔喔喔喔喔！\\n──咕喔喔喔喔喔！\\n──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "在看到面前這麼多的魔物之後，",
    "voice": "vo_adv_1320002_033",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n它也應該沒有在運作了吧。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "情勢看起來對你似乎不太好，",
    "voice": "vo_adv_1320002_034",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "沒問題嗎？",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "在我來看，",
    "voice": "vo_adv_1320002_035",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n你不擅長單獨作戰。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "魔物群",
    "words": "…………",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "你也可以選擇逃離這裡，不用勉強自己喔。",
    "voice": "vo_adv_1320002_036",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "當然，",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "你要是有什麼絕招的話，",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "要施展出來也行。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "真有個什麼萬一就由我──",
    "voice": "vo_adv_1320002_037",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "……我確實在思考為何你只顧防守，",
    "voice": "vo_adv_1320002_038",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "原來如此。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n你是以我的安全為優先嗎。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "真是的，",
    "voice": "vo_adv_1320002_039",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "能做到這種程度很厲害啊。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "雖然你那信念盡頭的結局",
    "voice": "vo_adv_1320002_040",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "也讓我很在意──",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "魔物群",
    "words": "──咕喔喔喔喔喔！\\n──咕喔喔喔喔喔！\\n──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "呵呵。",
    "voice": "vo_adv_1320002_041",
    "unit_id": 132011
  },
  {
    "type": "background",
    "bg_id": "500160"
  },
  {
    "type": "dialogue",
    "name": "魔物群",
    "words": "……！？",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "哎呀。",
    "voice": "vo_adv_1320002_042",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "魔物逃跑了呢。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "牠們是看到什麼恐怖的東西了嗎──",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "background",
    "bg_id": "500690"
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "──終於結束了。",
    "voice": "vo_adv_1320002_043",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我才",
    "voice": "vo_adv_1320002_044",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "剛剛鬆了口氣而已耶。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "……你還打算繼續嗎？",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "你看起來也不像是缺錢……",
    "voice": "vo_adv_1320002_045",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "看",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "來",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我能理解你慾望的根源了。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我說不定是第一次",
    "voice": "vo_adv_1320002_046",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "為了取得金錢類型的報酬",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n而這麼拼命工作啊。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "然後呢？",
    "voice": "vo_adv_1320002_047",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "接下來要做什麼？",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "這裡的服務生看起來人數很充足啊。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我說，",
    "voice": "vo_adv_1320002_048",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "你是以什麼為基準來選打工的啊？",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n你該不會是",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n二話不說地",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "就答應來請求你幫忙的人吧？",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "不過，",
    "voice": "vo_adv_1320002_049",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "如果是那種事情的話",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "就交給我吧。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我當然",
    "voice": "vo_adv_1320002_050",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "可以自由使用店裡有的材料沒關係吧？",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n這可是能體驗此地飲食文化的",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "大好機會啊。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "像這種香氣強烈的植物跟果實，",
    "voice": "vo_adv_1320002_051",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n也能從外觀",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "來推測它們味道的特徵。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我的腦裡",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "也刻劃著有效組合它們的方法。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "呵呵，",
    "voice": "vo_adv_1320002_052",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我就用我的知識",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "來創造未知的味道吧。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "──好啦，",
    "voice": "vo_adv_1320002_053",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "這樣就完成了。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "要在冷掉之前喝掉喔。",
    "voice": "vo_adv_1320002_054",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "……居然一口氣喝完魔女拿出來的東西，",
    "voice": "vo_adv_1320002_055",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "你還真勇敢呢。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "居然猶豫要不要喝掉少女親手做的料理，",
    "voice": "vo_adv_1320002_056",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "這很傷人呢。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "……",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "你喝下去了吧。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "那麼",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "就讓你來付出代價吧。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我是",
    "voice": "vo_adv_1320002_057",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "開玩笑的啦。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n那麼，",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "讓我聽聽你的感想吧。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "看來暫且是成功了呢。",
    "voice": "vo_adv_1320002_058",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "雖然在理論上是一定會成功，",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n但結果",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "並不一定會井井有條地遵循理論，",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "所以這下我放心了。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我試著做出新穎又特殊，",
    "voice": "vo_adv_1320002_059",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "還有深度的味道。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "如果能讓你覺得不可思議，",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "那就能說是成功了吧。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "泡法我也整理好了。",
    "voice": "vo_adv_1320002_060",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n你要讓不管是誰來泡都能泡出一樣的味道來喔。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "……嗯？",
    "voice": "vo_adv_1320002_061",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我真的沒有加任何奇怪的東西進去喔。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "但是，",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "因為是要當商品。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "所以我只有下了點功夫，",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "讓它變成會讓人想喝的味道而已──",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "background",
    "bg_id": "500161"
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "──到目前為止我們經歷了好幾份打工。",
    "voice": "vo_adv_1320002_062",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "對很久沒有勞動過的我來說，",
    "voice": "vo_adv_1320002_063",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n每個打工都是很新鮮的經驗。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "看來只要觀察你，",
    "voice": "vo_adv_1320002_064",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "就能感受到「未知」的這個論點，",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n似乎沒有錯呢。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我必須將我今天一整天的感謝傳達給你才行呢。",
    "voice": "vo_adv_1320002_065",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我非常滿足了。",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "真的很謝謝你。",
    "voice": "vo_adv_1320002_066",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "就是這樣，",
    "voice": "vo_adv_1320002_067",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "所以差不多該結束──",
    "voice": null,
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "…………",
    "voice": "vo_adv_1320002_068",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "只有你的打工的盡頭在何處這點讓我無法預測……",
    "voice": "vo_adv_1320002_069",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "你真的",
    "voice": "vo_adv_1320002_070",
    "unit_id": 132011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "非常有意思呢……",
    "voice": null,
    "unit_id": 132011
  }
]
