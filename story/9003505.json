[
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "嗯……",
    "voice": "vo_adv_9003505_000",
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "\\n公主殿下你們",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "趕上了啊。",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "陛下！",
    "voice": "vo_adv_9003505_001",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "純小姐！",
    "voice": "vo_adv_9003505_002",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n還有各位！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不好意思我們來晚了！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "太好了──",
    "voice": "vo_adv_9003505_003",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "妳們平安無事呢！",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "看來妳們也沒事，",
    "voice": "vo_adv_9003505_004",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "太好了。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這裡的防守要是被突破就危險了……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "真不愧是【王宮騎士團】。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "本來只靠我們幾個",
    "voice": "vo_adv_9003505_005",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "撐得很辛苦，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "不過後來出現了意外的幫手……",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "嘿嘿，",
    "voice": "vo_adv_9003505_006",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "多虧有我們幫忙啊。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "要好～好感謝我們喔？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "沒錯！",
    "voice": "vo_adv_9003505_007",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n只要給我們這國家一年的稅金來答謝這件事就這麼算了！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "哇啊～♪",
    "voice": "vo_adv_9003505_008",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n祈梨妳呀，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "太客氣了～♪",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這、",
    "voice": "vo_adv_9003505_009",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這實在很為難……",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我會被小凱留和克蕾琪塔小姐罵的～",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "……哎呀哎呀。",
    "voice": "vo_adv_9003505_010",
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "\\n儘管有人數優勢，",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "想不到妳們居然擊退了贊恩。",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "\\n",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "真教人吃驚啊。",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "那個叫贊恩的男人",
    "voice": "vo_adv_9003505_011",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "真的很強……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n就算我們在那裡敗給他",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "也一點都不奇怪。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "當然……",
    "voice": "vo_adv_9003505_012",
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "妳們也",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "不可能全身而退。",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "\\n與他一戰是不是相對地消耗了不少力量呢？",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這一點你應該也差不多！",
    "voice": "vo_adv_9003505_013",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n因為純小姐她們也與你一戰了！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "……【憤怒‧軍團】",
    "voice": "vo_adv_9003505_014",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "阿澤爾德。",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n這是第三次",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "與你交鋒了……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "這次就來",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "做個了斷吧！",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "是啊，",
    "voice": "vo_adv_9003505_015",
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "這一戰沒有下回了。",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "\\n究竟誰能站到最後──",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "阿澤爾德",
    "words": "一決勝負吧！",
    "voice": null,
    "unit_id": 191911
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "──呵呵♪",
    "voice": "vo_adv_9003505_016",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n嘉夜、祈梨，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "再加把勁吧。",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我們的目標是",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "坐收漁翁之利",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "喔～♪",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "嘉夜、祈梨",
    "words": "了解！",
    "voice": "vo_adv_9003505_017",
    "unit_id": null
  }
]
