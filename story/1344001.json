[
  {
    "type": "background",
    "bg_id": "500170"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在失控的精靈引發騷動後過了一段時間──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}與千歌一起",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "造訪了精靈族之村。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我有重要的事要說，",
    "voice": "vo_adv_1344001_000",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "{0}。",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我……",
    "voice": "vo_adv_1344001_001",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "想要小寶寶。",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "啊……",
    "voice": "vo_adv_1344001_002",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我、",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我講得不夠清楚！",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "那個，",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "不、",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "不是那種意思……",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "不是的……",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "沒、",
    "voice": "vo_adv_1344001_003",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "沒有，所以說，那個、",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "那個，",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "呃……",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "咳咳。",
    "voice": "vo_adv_1344001_004",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "呃……",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "那個",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "啊。",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "雖然我說小寶寶，",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "但我是指新出生的精靈。",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "其實，",
    "voice": "vo_adv_1344001_005",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "前些日子與失控精靈的戰鬥，",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "讓我的精靈們",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "相當疲憊……",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "要是近期發生了什麼事，",
    "voice": "vo_adv_1344001_006",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我可能無法",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "像現在一樣",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n作為唱喚士借用精靈的力量。",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n如果",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "變成那樣的話──",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是的。",
    "voice": "vo_adv_1344001_007",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "所以",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我想說要是能獲得新的精靈之力，",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n我既能夠變強，",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "也能減少其他精靈的負擔吧。",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是的。",
    "voice": "vo_adv_1344001_008",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "長老在不久前",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "告訴我了。",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n說是有孕育新精靈的方法。",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "雖然聽說非常困難，",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "但並不是沒有先例。",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "那",
    "voice": "vo_adv_1344001_009",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "就是指優衣小姐。",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "當然優衣小姐的努力不在話下，",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n但我聽說在她身邊支持的你也出了很大一份力。",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我不曉得",
    "voice": "vo_adv_1344001_010",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "能不能成功。",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n畢竟優衣小姐孕育出的精靈，",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "和以唱喚術締結契約的精靈",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n是不同種類……",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "儘管如此！",
    "voice": "vo_adv_1344001_011",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "既然可能性不是零，",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n我也想挑戰看看。",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n挑戰和你",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "一起孕育出新誕生的精靈……",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "謝、",
    "voice": "vo_adv_1344001_012",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "謝謝你！",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是的！",
    "voice": "vo_adv_1344001_013",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我從神廟借來了古老的文獻。",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "畢竟大多都是相當古老的，",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "所以不知道",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n正確度，",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "但應該還是值得一試的！",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "那麼，",
    "voice": "vo_adv_1344001_014",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我們馬上就來試試看吧。",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "這是用來孕育精靈的歌曲。",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "想像自己想要孕育的精靈……",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "讓魔力搭著歌曲……",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "～～～～♪",
    "voice": "vo_adv_1344001_015",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "……咦、",
    "voice": "vo_adv_1344001_016",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "咦？",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "好奇怪啊……",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "音有唱準",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "對吧？　",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "……",
    "voice": "vo_adv_1344001_017",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "什麼都沒發生呢。",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "真奇怪啊，",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "樂譜應該沒錯才對，",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我也練習過了。",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是不是必須",
    "voice": "vo_adv_1344001_018",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "唱得更正確、更細膩才行呢……",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "～～～～♪",
    "voice": "vo_adv_1344001_019",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "果然很奇怪……",
    "voice": "vo_adv_1344001_020",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "魔力竟然無法搭配上歌曲……",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "得注意節奏才行。",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n……",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "冷靜，",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "冷靜下來再試一次。",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "呼哈……",
    "voice": "vo_adv_1344001_021",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "呼哈……",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "為什麼……？",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n魔力竟然沒辦法順利搭配上歌曲……",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "說的也是呢……",
    "voice": "vo_adv_1344001_022",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "因為就算著急，",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "也一定不會有好結果。",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "我去向村裡的人",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "打聽一下。",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n希望多少有一點線索。",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "background",
    "bg_id": "501200"
  },
  {
    "type": "dialogue",
    "name": "村裡的居民1",
    "words": "咦？",
    "voice": "vo_adv_1344001_023",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "村裡的居民1",
    "words": "孕育精靈的儀式？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "村裡的居民1",
    "words": "\\n你們兩個",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "村裡的居民1",
    "words": "在挑戰那麼困難的事嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "拜託了！",
    "voice": "vo_adv_1344001_024",
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n我",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "無論如何都想成功孕育精靈。",
    "voice": null,
    "unit_id": 134411
  },
  {
    "type": "dialogue",
