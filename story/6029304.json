    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "她們真的是完美地",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "抓住了人民的心啊。",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這說不定會成為",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身征服世界的障礙。",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯。",
    "voice": "vo_adv_6029304_001",
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "望她既有行動力，",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n似乎也具備成為領導者的資質。",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "只好趁現在",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "把她納入妾身的麾下……",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身是說笑的。",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "當然！",
    "voice": "vo_adv_6029304_002",
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "　妾身怎麼可能會輸！",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n吾之眷屬啊！",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "畢竟還有你跟在妾身身邊啊！",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你說什麼！",
    "voice": "vo_adv_6029304_003",
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "　沒想到還有這招……！",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n這真是個驚人的想法……",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯……",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不過，妾身要鄭重地",
    "voice": null,
    "unit_id": 111711
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "否決這個提議。",
    "voice": null,
    "unit_id": 111711
  }
]
