[
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}一個人散步的時候――",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "咦，這不是秀才嗎！",
    "voice": "vo_adv_1016004_000",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "在做什麼呢？散步中？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家正要去工作。",
    "voice": "vo_adv_1016004_001",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "接下來有模特兒的工作喔～",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "……咦？你覺得有工作很厲害嗎？",
    "voice": "vo_adv_1016004_002",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "沒有那回事啦。",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n人家最喜歡模特兒的工作了。",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家是因為喜歡才做的，所以超輕鬆，",
    "voice": "vo_adv_1016004_003",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n模特兒夥伴們也都像朋友一樣，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "感覺不像是在工作喔～",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才有興趣的話，也可以來觀摩――",
    "voice": "vo_adv_1016004_004",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "哇！",
    "voice": "vo_adv_1016004_005",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": " 這道光是什麼？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "好刺眼啊？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "background",
    "bg_id": "510350"
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才，哈嚕～！",
    "voice": "vo_adv_1016004_006",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "你非常準時耶？",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "那麼就趕快去玩吧！",
    "voice": "vo_adv_1016004_007",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "……雖然想這麼說，",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "不過抱歉！可以等人家一下嗎？",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家剛剛正在那邊進行雜誌的拍攝，",
    "voice": "vo_adv_1016004_008",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n但因為沒有拍出好照片，",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n時間會稍微延後喔～",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "感覺今天狀況不怎麼好呢？",
    "voice": "vo_adv_1016004_009",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "該說是表情太僵硬了嗎？",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "因為重拍了好幾次，",
    "voice": "vo_adv_1016004_010",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n花了不少時間……",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "雖然攝影師和工作人員",
    "voice": "vo_adv_1016004_011",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n都說照片拍得很好，",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "但人家就是不能接受！",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家是因為喜歡才當模特兒的，所以可不能隨便妥協對吧？",
    "voice": "vo_adv_1016004_012",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "在拍出好照片之前，似乎還要花點時間……",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "你願意等人家嗎？",
    "voice": "vo_adv_1016004_013",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才，謝謝你！",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n人家很快就會拍完的，再等一下喔！",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "background",
    "bg_id": "510350"
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "為了秀才，得快點拍完才行！",
    "voice": "vo_adv_1016004_014",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "……啊！",
    "voice": "vo_adv_1016004_015",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n秀才正往這邊看。",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "啊哈哈！",
    "voice": "vo_adv_1016004_016",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n秀才那麼誇張地揮手，超有趣～",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才好好笑～",
    "voice": "vo_adv_1016004_017",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "明明周圍還有其他人，還叫那麼大聲，太引人注目了……",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "但是，秀才也在為人家加油呢？",
    "voice": "vo_adv_1016004_018",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家也得努力了～！",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "鈴奈的表情變得很到位了呢。",
    "voice": "vo_adv_1016004_019",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "\\n這樣的話，應該很快就能結束拍攝了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "真的嗎？",
    "voice": "vo_adv_1016004_020",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "太好了～！",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "模特兒夥伴",
    "words": "鈴奈，是因為那個吧？",
    "voice": "vo_adv_1016004_021",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "模特兒夥伴",
    "words": "\\n因為男朋友來看了，所以感覺充滿幹勁？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "呃？什！？",
    "voice": "vo_adv_1016004_022",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "不、不是什麼男朋友啦！",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "模特兒夥伴",
    "words": "欸～？",
    "voice": "vo_adv_1016004_023",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "模特兒夥伴",
    "words": "\\n你們無論怎麼看，都是在交往嘛？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "不、不是啦！",
    "voice": "vo_adv_1016004_024",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n秀才只是朋友！",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "哎呀？",
    "voice": "vo_adv_1016004_025",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "\\n鈴奈的表情又變得僵硬了……倒不如說是滿臉通紅？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "攝影師",
    "words": "\\n這樣的照片沒辦法用啊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "討厭啦……都是你們說了奇怪的話……",
    "voice": "vo_adv_1016004_026",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "害人家這麼慌張，沒辦法集中精神……",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "本來好不容易可以快點結束的說，",
    "voice": "vo_adv_1016004_027",
    "unit_id": 101631
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n 這下還要花時間完成剩下的拍攝……",
    "voice": null,
    "unit_id": 101631
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "哎呀呀……結果還是因為你的關係，",
    "voice": "vo_adv_1016004_028",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "延誤了拍攝呢～",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "話雖如此，",
    "voice": "vo_adv_1016004_029",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n鈴奈工作時會進入專業模式，變得很認真呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好帥氣～！",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "嗯？你問剛才的是什麼？",
    "voice": "vo_adv_1016004_030",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n啊～我還沒有說明呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這個是我創造的「夢」喔。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "雖說是「夢」，但這是依照你和鈴奈的",
    "voice": "vo_adv_1016004_031",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n「記憶碎片」創造出來的東西唷。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "是不是覺得有些懷念呢？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "如果你收集到更多的「記憶碎片」，",
    "voice": "vo_adv_1016004_032",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n我就會再讓你做「夢」的。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你和許多女孩在一起的「夢」做得越多……",
    "voice": "vo_adv_1016004_033",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n就可以藉此還原世界的真實面貌。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n要加油喔♪",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那麼，下次見囉～ ♪",
    "voice": "vo_adv_1016004_034",
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "嗯……",
    "voice": "vo_adv_1016004_035",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "嗯～？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "咦？人家睡著了嗎？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才也是？",
    "voice": "vo_adv_1016004_036",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "竟然在街道正中央睡著，超有趣～",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "人家好像做了奇怪的夢？",
    "voice": "vo_adv_1016004_037",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
