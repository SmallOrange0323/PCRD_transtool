[
  {
    "type": "background",
    "bg_id": "509040"
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比啊，",
    "voice": "vo_adv_9500097_000",
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "最喜歡僕從了。",
    "voice": null,
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "自從第一次見面，",
    "voice": null,
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "選了你做僕從後，",
    "voice": null,
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "班比就一──直",
    "voice": null,
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n想讓你成為",
    "voice": null,
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "只屬於班比的真正僕從。",
    "voice": null,
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "但是，",
    "voice": "vo_adv_9500097_001",
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "僕從",
    "voice": null,
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "不是只為了班比，",
    "voice": null,
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "而是為了大家──",
    "voice": null,
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "為了保護大家的「容身之處」，",
    "voice": null,
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n現在",
    "voice": null,
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "才準備簽訂「契約」。",
    "voice": null,
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "是因為僕從是這個樣子，",
    "voice": "vo_adv_9500097_002",
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n班比",
    "voice": null,
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "那一天",
    "voice": null,
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "才會想讓你",
    "voice": null,
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "成為僕從。",
    "voice": null,
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "所以啊，",
    "voice": "vo_adv_9500097_003",
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n班比也",
    "voice": null,
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "必須為了大家，",
    "voice": null,
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n成為一個",
    "voice": null,
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "更～了不起的主人，不讓這樣的僕從丟臉♪",
    "voice": null,
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "咦？",
    "voice": "vo_adv_9500097_004",
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n那，",
    "voice": null,
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "你選班比是因為──",
    "voice": null,
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "……！",
    "voice": "vo_adv_9500097_005",
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "僕從……",
    "voice": null,
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n你是",
    "voice": null,
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "有了那種",
    "voice": null,
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "心情……",
    "voice": null,
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n想跟班比",
    "voice": null,
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "一起冒險……",
    "voice": null,
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "一起努力很多事情嗎？",
    "voice": null,
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "你要的不是別的誰，",
    "voice": "vo_adv_9500097_006",
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n而是班比嗎？",
    "voice": null,
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n覺得班比",
    "voice": null,
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "身邊更好嗎？",
    "voice": null,
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "……",
    "voice": "vo_adv_9500097_007",
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "嘿嘿，",
    "voice": null,
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "啊哈哈♪",
    "voice": null,
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n僕從",
    "voice": null,
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "第一次耍任性了！",
    "voice": null,
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n真是個壞孩子～♪",
    "voice": null,
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "嗯，",
    "voice": "vo_adv_9500097_008",
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "知道了。",
    "voice": null,
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "僕從那任性的心意，",
    "voice": null,
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n班比會當作祕密得到的、",
    "voice": null,
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "只屬於班比的",
    "voice": null,
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "寶物。",
    "voice": null,
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n那麼……",
    "voice": null,
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "來做吧，",
    "voice": "vo_adv_9500097_009",
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n做伊莉亞說的",
    "voice": null,
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "祕密契約，",
    "voice": null,
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "「羈絆契約」。",
    "voice": null,
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n",
    "voice": null,
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "過來這邊，",
    "voice": null,
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "閉上眼睛，",
    "voice": null,
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "僕從。",
    "voice": null,
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "那個啊，",
    "voice": "vo_adv_9500097_010",
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n班比的血──",
    "voice": null,
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "非～常",
    "voice": "vo_adv_9500097_011",
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "好喝喔，",
    "voice": null,
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "\\n比晚餐的湯還好喝。",
    "voice": null,
    "unit_id": 122341
  },
  {
    "type": "dialogue",
    "name": "班比",
    "words": "嘿嘿♪",
    "voice": null,
    "unit_id": 122341
  },
  {
    "type": "background",
    "bg_id": "509040"
  }
]
