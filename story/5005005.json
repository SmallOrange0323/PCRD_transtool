[
  {
    "type": "background",
    "bg_id": "500240"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "珠希、美冬和{0}\\n在找到筆記本後，聊著之後的打算。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "接下來要怎麼辦呢……",
    "voice": "vo_adv_5005005_000",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n對我們來說",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "有兩個選項。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "一個是，",
    "voice": "vo_adv_5005005_001",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "讓島鯨滿足我們的欲望，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n盡其所能地享受奢華生活，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "結束短短的一生……",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "另一個則是，",
    "voice": "vo_adv_5005005_002",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n打倒或說服島鯨",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "讓我們回到現實世界嗎",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "喵……？",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "對我們來說，哪一個選項才是幸福呢……",
    "voice": "vo_adv_5005005_003",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我能說的是……",
    "voice": "vo_adv_5005005_004",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "現在的生活，",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "直白來講就是舒適喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "也是呢，",
    "voice": "vo_adv_5005005_005",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "可以做所有喜歡的事情",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "悠哉悠哉地生活。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n可說是理想的世界呢。",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "果然……",
    "voice": "vo_adv_5005005_006",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n一直待在這裡，",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "也是可行的喵……？",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "有什麼關係喵！",
    "voice": "vo_adv_5005005_007",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "要失去現在的生活什麼的，",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n我受不了喵……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "老實說，",
    "voice": "vo_adv_5005005_008",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "我也同意呢……",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "沒有那種事喵！",
    "voice": "vo_adv_5005005_009",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n我不想要{0}管這麼多喵！",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "總之，",
    "voice": "vo_adv_5005005_010",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "先在這座島上",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "再生活一陣子一邊思考吧！",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "嗯呵呵……",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我贊成喵！",
    "voice": "vo_adv_5005005_011",
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "總之，",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n今天我們也玩完後才回家，",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n{0}可以先悠哉地回去就好了喵。",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "喵呵呵……",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "沒錯呢，",
    "voice": "vo_adv_5005005_012",
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "嗯呵呵……",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n先鍛鍊，",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "接著再去特賣會唷──！",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "dialogue",
    "name": "美冬",
    "words": "\\n晚點見，{0}！",
    "voice": null,
    "unit_id": 108011
  },
  {
    "type": "background",
    "bg_id": "500280"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "和珠希、美冬分開的{0}，\\n在洞窟的入口處，\\n想著接下來該怎麼辦才好。",
    "voice": null,
    "unit_id": 107911
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "呼、",
    "voice": "vo_adv_5005005_013",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "呼……",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "這座島很大呢……",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "哎呀？",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "在那裡的該不會是，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n{0}大人嗎？",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "啊──",
    "voice": "vo_adv_5005005_014",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "果然是{0}！",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n能見到你真是太好了！",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "你在這個地方做什麼呢？",
    "voice": "vo_adv_5005005_015",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n珠希和美冬",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "沒有和你在一起嗎？",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "嗯嗯……",
    "voice": "vo_adv_5005005_016",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "「實現願望之島」，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n是叫做島鯨的魔物呢。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "狀況我了解了。",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "然後，那兩人",
    "voice": "vo_adv_5005005_017",
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "被這個島的魅力迷惑住，",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n所以你正在思考該怎麼辦才好……",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "既然如此，",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "接下來就交給我們吧！",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "好嗎？",
    "voice": null,
    "unit_id": 103411
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "兩個小時過後……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "嗚喵～",
    "voice": "vo_adv_5005005_018",
    "unit_id": 107912
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "今天也玩得好累喵～",
    "voice": null,
    "unit_id": 107912
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 107912
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "雇幾隻貓",
    "voice": null,
    "unit_id": 107912
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "請牠們送我到珠希宮殿喵～",
    "voice": null,
    "unit_id": 107912
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "那邊的小貓咪──！",
    "voice": "vo_adv_5005005_019",
    "unit_id": 107912
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n用這個貓幣，",
    "voice": null,
    "unit_id": 107912
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "我想請你把我送到宮殿喵！",
    "voice": null,
    "unit_id": 107912
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "咦？",
    "voice": "vo_adv_5005005_020",
    "unit_id": 107912
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "這個錢幣不能用？",
    "voice": null,
    "unit_id": 107912
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "為、",
    "voice": null,
    "unit_id": 107912
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "為什麼喵？",
    "voice": null,
    "unit_id": 107912
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n咦……",
    "voice": null,
    "unit_id": 107912
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "海邊的方向好像有誰在喵！？",
    "voice": null,
    "unit_id": 107912
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "那是……",
    "voice": null,
    "unit_id": 107912
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "秋乃喵！？",
    "voice": null,
    "unit_id": 107912
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "哦──呵呵呵！",
    "voice": "vo_adv_5005005_021",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n如此一來這座島的流通貨幣就全是我的東西了！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n因為我全都買下來了，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "所以這個錢幣已經不能再用了喔！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "接下來",
    "voice": "vo_adv_5005005_022",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "不是「貓幣」，",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "而是冠上我名字的",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n「秋乃幣」要在市場上流通唷──！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "呀，",
    "voice": "vo_adv_5005005_023",
    "unit_id": 107912
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "貓幣的經濟圈，",
    "voice": null,
    "unit_id": 107912
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n因為一個超級有錢人的關係而崩壞了喵──！",
    "voice": null,
    "unit_id": 107912
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "哎呀",
    "voice": "vo_adv_5005005_024",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "珠希！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "妳果然在這裡呢！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n平安無事真是太好了！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "秋乃……",
    "voice": "vo_adv_5005005_025",
    "unit_id": 107912
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "妳為什麼在這裡喵！？",
    "voice": null,
    "unit_id": 107912
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "那當然是因為，",
    "voice": "vo_adv_5005005_026",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "為了來救妳們兩位和{0}大人而來的啊！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n和優花梨一起！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "優花梨？",
    "voice": "vo_adv_5005005_027",
    "unit_id": 107912
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "沒看到人呀，",
    "voice": null,
    "unit_id": 107912
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "在哪裡喵？",
    "voice": null,
    "unit_id": 107912
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "優花梨的話，",
    "voice": "vo_adv_5005005_028",
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "應該是去了無人商店街唷！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n為了讓美冬清醒過來！",
    "voice": null,
    "unit_id": 103211
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "這個時候，在無人商店街……",
    "voice": null,
