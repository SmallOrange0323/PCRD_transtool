[
  {
    "type": "background",
    "bg_id": "500792"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "以被囚禁著的霸瞳皇帝為目標，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n【憤怒‧軍團】的贊恩，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n正獨自一人朝著蘭德索爾的王城前進。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "士兵們",
    "words": "嗚啊啊啊～！",
    "voice": "vo_adv_2103015_000",
    "unit_id": 4311
  },
  {
    "type": "dialogue",
    "name": "士兵１",
    "words": "咿～！",
    "voice": "vo_adv_2103015_001",
    "unit_id": 4311
  },
  {
    "type": "dialogue",
    "name": "士兵１",
    "words": "\\n快逃，",
    "voice": null,
    "unit_id": 4311
  },
  {
    "type": "dialogue",
    "name": "士兵１",
    "words": "快逃啊！",
    "voice": null,
    "unit_id": 4311
  },
  {
    "type": "dialogue",
    "name": "士兵２",
    "words": "他是怪物啊，",
    "voice": "vo_adv_2103015_002",
    "unit_id": 4311
  },
  {
    "type": "dialogue",
    "name": "士兵２",
    "words": "根本不是人啊！",
    "voice": null,
    "unit_id": 4311
  },
  {
    "type": "dialogue",
    "name": "士兵２",
    "words": "\\n這絕對是贏不了的！",
    "voice": null,
    "unit_id": 4311
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "唔、",
    "voice": "vo_adv_2103015_003",
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "唔唔唔唔！",
    "voice": null,
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "\\n豈有這種道理啊！",
    "voice": null,
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "\\n宮殿前的守衛，",
    "voice": null,
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "他竟然獨自一人就輕易地突破了啊……！",
    "voice": null,
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "贊恩",
    "words": "……",
    "voice": "vo_adv_2103015_004",
    "unit_id": 191711
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "咿！",
    "voice": "vo_adv_2103015_005",
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "\\n……撤、",
    "voice": null,
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "撤退，",
    "voice": null,
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "撤退！",
    "voice": null,
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "\\n【黃金之手】部隊，",
    "voice": null,
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "全軍撤～退～！",
    "voice": null,
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "隊長",
    "words": "可、",
    "voice": "vo_adv_2103015_006",
    "unit_id": 4312
  },
  {
    "type": "dialogue",
    "name": "隊長",
    "words": "可是議長！",
    "voice": null,
    "unit_id": 4312
  },
  {
    "type": "dialogue",
    "name": "隊長",
    "words": "\\n這樣的話宮殿就沒有人防守了……！",
    "voice": null,
    "unit_id": 4312
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "蠢貨！",
    "voice": "vo_adv_2103015_007",
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "\\n我等需保護的對象是陛下的玉體！",
    "voice": null,
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "\\n而既然陛下都親自出征到外頭了，",
    "voice": null,
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "那如今在這死撐還有何意義！",
    "voice": null,
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "因此……",
    "voice": "vo_adv_2103015_008",
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "\\n",
    "voice": null,
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "撤退！",
    "voice": null,
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "\\n撤～退～！",
    "voice": null,
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "隊長",
    "words": "議長～！",
    "voice": "vo_adv_2103015_009",
    "unit_id": 4312
  },
  {
    "type": "dialogue",
    "name": "隊長",
    "words": "\\n請您等等～！",
    "voice": null,
    "unit_id": 4312
  },
  {
    "type": "background",
    "bg_id": "500092"
  },
  {
    "type": "dialogue",
    "name": "贊恩",
    "words": "……",
    "voice": "vo_adv_2103015_010",
    "unit_id": 191711
  },
  {
    "type": "dialogue",
    "name": "贊恩",
    "words": "……？",
    "voice": "vo_adv_2103015_011",
    "unit_id": 191711
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "哎呀，",
    "voice": "vo_adv_2103015_012",
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "不得了呀不得了。",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n所謂的一騎當千就是在說你呢，",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "【憤怒‧軍團】。",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "贊恩",
    "words": "妳是……",
    "voice": "vo_adv_2103015_013",
    "unit_id": 191711
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "呃——",
    "voice": "vo_adv_2103015_014",
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我有需要",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "自我介紹嗎？",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "贊恩",
    "words": "「七冠」——",
    "voice": "vo_adv_2103015_015",
    "unit_id": 191711
  },
  {
    "type": "dialogue",
    "name": "贊恩",
    "words": "\\n迷宮女王，",
    "voice": null,
    "unit_id": 191711
  },
  {
    "type": "dialogue",
    "name": "贊恩",
    "words": "拉比林斯達。",
    "voice": null,
    "unit_id": 191711
  },
  {
    "type": "dialogue",
    "name": "贊恩",
    "words": "\\n",
    "voice": null,
    "unit_id": 191711
  },
  {
    "type": "dialogue",
    "name": "贊恩",
    "words": "……模索路晶。",
    "voice": null,
    "unit_id": 191711
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "哼嗯～",
    "voice": "vo_adv_2103015_016",
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "你用「那邊」的名字叫我呀。",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n外加你那雙角，",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "還有那條尾巴……",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "真是讓人越來越感興趣了呢～",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "所以說，",
    "voice": "vo_adv_2103015_017",
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n你的目標",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這座宮殿裡的千里真那嗎？",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "贊恩",
    "words": "是。",
    "voice": "vo_adv_2103015_018",
    "unit_id": 191711
  },
  {
    "type": "dialogue",
    "name": "贊恩",
    "words": "\\n",
    "voice": null,
    "unit_id": 191711
  },
  {
    "type": "dialogue",
    "name": "贊恩",
    "words": "……但正確來說……",
    "voice": null,
    "unit_id": 191711
  },
  {
    "type": "dialogue",
    "name": "贊恩",
    "words": "應為「將軍抽車」才是。",
    "voice": null,
    "unit_id": 191711
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "啊哈哈。",
    "voice": "vo_adv_2103015_019",
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n這麼說來，",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我不就被你給釣個正著了嗎～",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n……看來你們正在獵殺七冠的傳聞，",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "是真的呢。",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "……我們全員都是你們的目標。",
    "voice": "vo_adv_2103015_020",
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n同時，",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "你們並不是為了要報仇",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "……哈哈。",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n這下我大概猜得出來了唷，",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "關於你們的",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "背景身分。",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "贊恩",
    "words": "……",
    "voice": "vo_adv_2103015_021",
    "unit_id": 191711
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "畢竟{0}少年他們現在也不太妙嘛……",
    "voice": "vo_adv_2103015_022",
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "這也沒辦法，",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我就姑且兩肋插把刀吧。",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n再說，",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "我也不想在這個階段就把真那交出去呢～",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "還有就是那個嘛，",
    "voice": "vo_adv_2103015_023",
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n如果大罪犯被賊黨給奪走了的話，",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n我想利用的",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "「皇家的威信」，不也會有所影響了嘛？",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "贊恩",
    "words": "……",
    "voice": "vo_adv_2103015_024",
    "unit_id": 191711
  },
  {
    "type": "dialogue",
    "name": "贊恩",
    "words": "——獻醜了。",
    "voice": "vo_adv_2103015_025",
    "unit_id": 191711
  },
  {
    "type": "movie",
    "movie_id": "210301501"
  },
  {
    "type": "background",
    "bg_id": "500092"
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "——",
    "voice": "vo_adv_2103015_026",
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "哎呀，",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "越看越覺得厲害了呢，",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "你呀。",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n竟然連覺醒都沒有就擁有這種程度的力量。",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "\\n",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "再加上，",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "那把劍——",
    "voice": null,
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "贊恩",
    "words": "咬碎她——",
    "voice": "vo_adv_2103015_027",
    "unit_id": 191711
  },
  {
    "type": "dialogue",
    "name": "拉比林斯達",
    "words": "！",
    "voice": "vo_adv_2103015_028",
    "unit_id": 106811
  },
  {
    "type": "dialogue",
    "name": "贊恩",
    "words": "——「蠻牙龍咬」。",
    "voice": "vo_adv_2103015_029",
    "unit_id": 191711
  }
]
