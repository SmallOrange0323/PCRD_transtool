    "words": "是「歡」的詞～♪",
    "voice": null,
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "！！",
    "voice": "vo_adv_5126308_005",
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n……我、",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我對妳也滿……",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "喜……",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "喜……",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊啊真是的，",
    "voice": null,
    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那種話等打贏這傢伙再說啦！！",
