    "unit_id": 127211
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "咦～",
    "voice": "vo_adv_5126308_006",
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "要等結束之後呀……",
    "voice": null,
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "但是既然妳都這麼說了，",
    "voice": null,
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "那就絕對會打贏！！",
    "voice": null,
    "unit_id": 127311
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這就是最後了……！！",
