  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "呀哎呀哎呀♪",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "芙蕾雅看起來搖搖晃晃的呢♪",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "就由美麗動人的本小姐，",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "來給妳最後一擊，",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n取走妳的小命囉～♪",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "──納命來！！！！",
    "voice": null,
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "──「[rub:復仇咆哮]復仇咆哮[/rub]」！！",
    "voice": "vo_adv_9006710_002",
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "──咿呀啊啊啊啊～～！？！？",
    "voice": "vo_adv_9006710_003",
    "unit_id": 134911
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "華音小～姐！",
    "voice": "vo_adv_9006710_004",
    "unit_id": 139612
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "死掉了。",
    "voice": "vo_adv_9006710_005",
    "unit_id": 139712
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "還沒結束……！",
    "voice": "vo_adv_9006710_006",
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n我的怒火，",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "才剛被點燃而已……！",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "喝啊啊",
    "voice": "vo_adv_9006710_007",
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "啊……！！",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……！",
    "voice": "vo_adv_9006710_008",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n竟然，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "還有如此強大的力量……！",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "而且──",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "──漆身吞炭。",
    "voice": "vo_adv_9006710_009",
    "unit_id": 139512
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n簡直就像",
    "voice": null,
    "unit_id": 139512
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "不斷添柴，燃燒著生命的火焰……",
    "voice": null,
    "unit_id": 139512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "芙蕾雅小姐……！",
    "voice": "vo_adv_9006710_010",
    "unit_id": 138311
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "…",
    "voice": "vo_adv_9006710_011",
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "…唔……",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n那種──",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n憐憫般的眼神──",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "我啊，",
    "voice": "vo_adv_9006710_012",
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "[rub:・]非[/rub][rub:・]常[/rub]討厭妳。",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "妳的眼睛。",
    "voice": "vo_adv_9006710_013",
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "妳的聲音。",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "妳的臉。",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "妳的個性。",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n妳的同情。",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n妳的一切──！",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "尤絲蒂亞娜──",
    "voice": "vo_adv_9006710_014",
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "不！",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n蘭德索爾的公主，",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "貪吃佩可！！",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "\\n我要讓妳那卑賤的肚子，",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "徹底品嚐我的怒火，",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "芙蕾雅",
    "words": "直到撐破為止！！！",
    "voice": null,
    "unit_id": 193713
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "──好的！",
    "voice": "vo_adv_9006710_015",
    "unit_id": 138312
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我會用我的肚子，",
    "voice": null,
    "unit_id": 138312
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "承受妳的一切攻擊！",
    "voice": null,
    "unit_id": 138312
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可、芙蕾雅",
