    "name": "鳳凰",
    "words": "輪迴無數、",
    "voice": null,
    "unit_id": 134741
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "無數、",
    "voice": null,
    "unit_id": 134741
  },
