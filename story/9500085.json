    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n絕對",
    "voice": null,
    "unit_id": 134741
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "沒有身分差距的問題──",
    "voice": null,
    "unit_id": 134741
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "──好了，",
    "voice": "vo_adv_9500085_009",
    "unit_id": 134741
  },
