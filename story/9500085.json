    "unit_id": 134741
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n",
    "voice": null,
    "unit_id": 134741
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "畢、",
    "voice": null,
    "unit_id": 134741
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "畢竟",
    "voice": null,
    "unit_id": 134741
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "我可是",
    "voice": null,
    "unit_id": 134741
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "活了成千上萬年、",
    "voice": null,
    "unit_id": 134741
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "不死",
    "voice": null,
    "unit_id": 134741
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "不滅的鳥！",
    "voice": null,
    "unit_id": 134741
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n是有深思熟慮和分寸的！",
    "voice": null,
    "unit_id": 134741
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "……咦！？怎、",
    "voice": "vo_adv_9500085_004",
    "unit_id": 134741
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "怎麼了？",
    "voice": null,
    "unit_id": 134741
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "這難道是要放棄的節奏？",
    "voice": null,
    "unit_id": 134741
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n",
    "voice": null,
    "unit_id": 134741
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "我是說自己有分寸，",
    "voice": null,
    "unit_id": 134741
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "但這樣是不是不太對？",
    "voice": null,
    "unit_id": 134741
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n",
    "voice": null,
    "unit_id": 134741
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "應該是要用兩人熊熊燃燒的火焰，",
    "voice": null,
    "unit_id": 134741
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "瞬間燒光這種標準才對吧！？",
    "voice": null,
    "unit_id": 134741
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "呃，",
    "voice": "vo_adv_9500085_005",
    "unit_id": 134741
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "就說了，",
    "voice": null,
    "unit_id": 134741
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "那個、",
    "voice": null,
    "unit_id": 134741
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "就是…………",
    "voice": null,
    "unit_id": 134741
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "哎呀──！",
    "voice": null,
    "unit_id": 134741
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n",
    "voice": null,
    "unit_id": 134741
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "知道了！",
    "voice": null,
    "unit_id": 134741
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "我也是！",
    "voice": null,
    "unit_id": 134741
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "對你很有好感！",
    "voice": null,
    "unit_id": 134741
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n",
    "voice": null,
    "unit_id": 134741
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "以、",
    "voice": null,
    "unit_id": 134741
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "以此為前提，",
    "voice": null,
    "unit_id": 134741
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "你再說一次！",
    "voice": null,
    "unit_id": 134741
  },
