    "name": "鳳凰",
    "words": "咳咳。",
    "voice": null,
    "unit_id": 134741
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n",
    "voice": null,
    "unit_id": 134741
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "我很──清楚",
    "voice": null,
    "unit_id": 134741
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "騎士先生的心意喔，",
    "voice": null,
    "unit_id": 134741
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n那份想跟華麗優雅、",
    "voice": null,
    "unit_id": 134741
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "才色兼備的我",
    "voice": null,
    "unit_id": 134741
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "結婚的心意！",
    "voice": null,
    "unit_id": 134741
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "只、",
    "voice": "vo_adv_9500085_002",
    "unit_id": 134741
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "只是",
    "voice": null,
    "unit_id": 134741
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "姑且、",
    "voice": null,
    "unit_id": 134741
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "就是、",
    "voice": null,
    "unit_id": 134741
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "那個啊？",
    "voice": null,
    "unit_id": 134741
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n",
    "voice": null,
    "unit_id": 134741
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "我是",
    "voice": null,
    "unit_id": 134741
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "神鳥，",
    "voice": null,
    "unit_id": 134741
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "而你是",
    "voice": null,
    "unit_id": 134741
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "人類嘛……",
    "voice": null,
    "unit_id": 134741
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "所以──",
    "voice": null,
    "unit_id": 134741
  },
