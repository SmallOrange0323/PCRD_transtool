    "name": "鳳凰",
    "words": "我？",
    "voice": null,
    "unit_id": 134741
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "啊……",
    "voice": "vo_adv_9500085_001",
    "unit_id": 134741
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "不、",
    "voice": null,
    "unit_id": 134741
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "不是……",
    "voice": null,
    "unit_id": 134741
  },
  {
