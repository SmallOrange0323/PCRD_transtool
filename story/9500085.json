    "name": "鳳凰",
    "words": "要選我嗎？",
    "voice": null,
    "unit_id": 134741
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "\\n不是別人，",
    "voice": null,
    "unit_id": 134741
  },
  {
    "type": "dialogue",
    "name": "鳳凰",
    "words": "而是……",
    "voice": null,
    "unit_id": 134741
  },
  {
