    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "這是心理創傷等級的難忘吧～",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n這應該變成夏天的回憶了吧～？",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "那、",
    "voice": "vo_adv_5148071_003",
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "那種製造回憶的方法，",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n跟我們當成目標的方法",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n方向是不是不一樣呢……",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "小莉莉，",
    "voice": "vo_adv_5148071_004",
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "妳太操心了啦～",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n這種事情要看現場的氣氛，",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "隨興地～",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "\\n熱鬧地做下去就OK～啦♪",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "涅婭",
    "words": "的感覺吧～",
    "voice": null,
    "unit_id": 131111
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "沒錯沒錯，",
    "voice": "vo_adv_5148071_005",
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "隨興OK就好～",
    "voice": null,
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "結果沒問題啊★",
    "voice": null,
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n",
    "voice": null,
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "而且因為我的射擊準度太差了，",
    "voice": null,
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n結果沒有打到她喔？",
    "voice": null,
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "要是出了點差錯，",
    "voice": "vo_adv_5148071_006",
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "下場就會很嚴重啊……！",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n之後要再去跟凱留小姐",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "道歉一次才行……",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "唔──",
    "voice": "vo_adv_5148071_007",
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n",
    "voice": null,
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "那麼那麼，",
    "voice": null,
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "下次就把我當成西瓜用沙子埋起來～",
    "voice": null,
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n然後請凱留來打我！",
    "voice": null,
    "unit_id": 131213
