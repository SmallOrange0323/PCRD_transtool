  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "這是我第一次",
    "voice": null,
    "unit_id": 129011
  },
  {
    "type": "dialogue",
    "name": "厄莉絲",
    "words": "見到實物……",
