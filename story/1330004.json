  },
  {
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "如果一個運氣不好，",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "被流箭射中頭部的話，",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "\\n馬上就會死翹翹GAMEOVER……",
