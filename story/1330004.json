  },
  {
    "name": "旁白",
    "words": "\\n{0}",
    "voice": null
  },
  {
    "name": "旁白",
    "words": "正在打著瞌睡──",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "──騎士氏。",
    "voice": "vo_adv_1330004_000"
  },
  {
    "name": "格蕾斯",
    "words": "\\n騎士氏。",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "早安，",
    "voice": "vo_adv_1330004_001"
  },
  {
    "name": "格蕾斯",
    "words": "騎士氏。",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "不過……",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "很可惜。",
    "voice": "vo_adv_1330004_002"
  },
  {
    "name": "格蕾斯",
    "words": "\\n你的冒險",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "就到此為止了。",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "更進一步來說。",
    "voice": "vo_adv_1330004_003"
  },
  {
    "name": "格蕾斯",
    "words": "\\n你已經死了。",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "你在睡覺時，",
    "voice": "vo_adv_1330004_004"
  },
  {
    "name": "格蕾斯",
    "words": "被殭屍咬死了。",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "\\n當場斃命。",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "是啊。",
    "voice": "vo_adv_1330004_005"
  },
  {
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "不過大多數的人，",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "在死時都是這麼想的。",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "\\n突如其來的死亡更是如此。",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "從今以後，",
    "voice": "vo_adv_1330004_006"
  },
  {
    "name": "格蕾斯",
    "words": "就跟我一起",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "在天上守望著大家吧。",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "那麼，",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "Let's go。",
    "voice": null
  },
  {
    "name": "薇歐莉特",
    "words": "……格蕾斯！？",
    "voice": "vo_adv_1330004_007"
  },
  {
    "name": "薇歐莉特",
    "words": "\\n妳",
    "voice": null
  },
  {
    "name": "薇歐莉特",
    "words": "要把騎士先生帶去哪裡！？",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "啊。",
    "voice": "vo_adv_1330004_008"
  },
  {
    "name": "格蕾斯",
    "words": "\\n是殭屍。",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "\\n呀──",
    "voice": null
  },
  {
    "name": "薇歐莉特",
    "words": "格蕾斯──",
    "voice": "vo_adv_1330004_009"
  },
  {
    "name": "薇歐莉特",
    "words": "\\n格蕾斯……！",
    "voice": null
  },
  {
    "type": "background",
