    "name": "旁白",
    "words": "某一天。",
    "voice": null
  },
  {
    "name": "旁白",
    "words": "\\n當{0}",
    "voice": null
  },
  {
    "name": "旁白",
    "words": "從瞌睡中醒過來時……",
    "voice": null
  },
  {
    "name": "？？？",
    "words": "沉重……",
    "voice": "vo_adv_1330004_010"
  },
  {
    "name": "？？？",
    "words": "…………",
    "voice": "vo_adv_1330004_011"
  },
  {
    "name": "？？？",
    "words": "沉重……",
    "voice": "vo_adv_1330004_012"
  },
  {
    "name": "？？？",
    "words": "你好。",
    "voice": "vo_adv_1330004_013"
  },
  {
    "name": "？？？",
    "words": "\\n我是你的背後靈。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "──幽野飛白。",
    "voice": "vo_adv_1330004_014"
  },
  {
    "name": "飛白",
    "words": "\\n朝氣蓬勃的大學生，",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "歷史系三年級。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "\\n享年21歲。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "這當然是因為，",
    "voice": "vo_adv_1330004_015"
  },
  {
    "name": "飛白",
    "words": "我充滿朝氣呀。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "不過，",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "我確實是個幽靈沒錯。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "身體整個透明。",
    "voice": "vo_adv_1330004_016"
  },
  {
    "name": "飛白",
    "words": "\\n只要我想要，",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "連牆壁都能穿過去。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "來，",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "你來摸摸看。",
    "voice": null
  },
  {
    "name": "旁白",
    "words": "──柔軟。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "…………",
    "voice": "vo_adv_1330004_017"
  },
  {
    "name": "飛白",
    "words": "……沒有穿透呢。",
    "voice": "vo_adv_1330004_018"
  },
  {
    "name": "飛白",
    "words": "討厭。",
    "voice": "vo_adv_1330004_019"
  },
  {
    "name": "飛白",
    "words": "\\n色狼。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "哎呀……",
    "voice": "vo_adv_1330004_020"
  },
  {
    "name": "飛白",
    "words": "被你抓到把柄了。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "這在法庭上似乎對我不利呢。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "話說回來。",
    "voice": "vo_adv_1330004_021"
  },
  {
    "name": "飛白",
    "words": "\\n既然你都摸了，作為回禮……",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "這麼說似乎不太合理，",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "\\n但是我有個請求。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "我現在，",
    "voice": "vo_adv_1330004_022"
  },
  {
    "name": "飛白",
    "words": "有件很傷腦筋的事。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "是的。",
    "voice": "vo_adv_1330004_023"
  },
  {
    "name": "飛白",
    "words": "\\n小飛白我，",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "似乎失去了記憶呢。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "\\n只記得名字與年齡。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "就連我為何會在這裡，",
    "voice": "vo_adv_1330004_024"
  },
  {
    "name": "飛白",
    "words": "都完全不記得了。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "\\n也無法讓身體變透明……",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "不知道該如何是好。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "就像「妳應該已經死了喔阿富小姐」",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "那樣。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "然後。",
    "voice": "vo_adv_1330004_025"
  },
  {
    "name": "飛白",
    "words": "\\n在我去醫院之前，",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "想稍微在街上到處看看。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "或許會想起什麼也說不定。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "Exactly.",
    "voice": "vo_adv_1330004_026"
  },
  {
    "name": "飛白",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "因為總覺得，",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "我好像認識你……",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "我有這種感覺。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "太好了。",
    "voice": "vo_adv_1330004_027"
  },
  {
    "name": "飛白",
    "words": "\\n那麼……",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "這就是約會了呢。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "\\nHere we go.",
    "voice": null
  },
  {
    "type": "background",
    "bg_id": "510300"
  },
  {
    "name": "飛白",
    "words": "嗯嗯……",
    "voice": "vo_adv_1330004_028"
  },
  {
    "name": "飛白",
    "words": "\\n喔喔……",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "\\n原來如此……",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "不，",
    "voice": "vo_adv_1330004_029"
  },
  {
    "name": "飛白",
    "words": "完全沒有。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "但是",
    "voice": "vo_adv_1330004_030"
  },
  {
    "name": "飛白",
    "words": "似乎有哪裡，",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "感覺不太一樣。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "比如說──",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "在那裡的汽車。",
    "voice": "vo_adv_1330004_031"
  },
  {
    "name": "飛白",
    "words": "\\n看起來沒有排氣也能行駛……",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "Why。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "咦。",
    "voice": "vo_adv_1330004_032"
  },
  {
    "name": "飛白",
    "words": "車子居然能靠水來行走還真是厲害。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "還有就是從剛剛開始，",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "就一直有像是直升機的孫子般的東西",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "\\n在天上飛來飛去。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "無人機……？",
    "voice": "vo_adv_1330004_033"
  },
  {
    "name": "飛白",
    "words": "\\n是幽靈船的親戚嗎。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "不對，哪來的幽靈船啊。",
    "voice": null
  },
  {
    "type": "background",
    "bg_id": "510030"
  },
  {
    "name": "飛白",
    "words": "這裡是……",
    "voice": "vo_adv_1330004_034"
  },
  {
    "name": "飛白",
    "words": "遊戲中心？",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "討厭，",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "這裡不就是閒閒沒事的不良學生會聚集的場所嗎。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "老爺子曾叮嚀過我，",
    "voice": "vo_adv_1330004_035"
  },
  {
    "name": "飛白",
    "words": "不要靠近這類場所呢。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "\\n別看我這樣，",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "好歹也是個大小姐喔。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "\\n開玩笑的。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "……話說回來。",
    "voice": "vo_adv_1330004_036"
  },
  {
    "name": "飛白",
    "words": "\\n以遊戲中心來說還真是明亮呢。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "也沒有看到像是品行不良的生命體。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "雖然我不太了解，",
    "voice": "vo_adv_1330004_037"
  },
  {
    "name": "飛白",
    "words": "但平民百姓也能放心地在這裡遊玩是嗎。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "\\n呀哈。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "\\n那麼，",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "我想玩看看那個用槍射擊的遊戲。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "啊，",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "殭屍的那個就免了。",
    "voice": null
  },
  {
    "type": "background",
    "bg_id": "510150"
  },
  {
    "name": "飛白",
    "words": "肚子有點餓了呢。",
    "voice": "vo_adv_1330004_038"
  },
  {
    "name": "飛白",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "稍微休息一下吧。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "我要無花果的水果塔",
    "voice": "vo_adv_1330004_039"
  },
  {
    "name": "飛白",
    "words": "跟薑汁花草茶。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "你要……",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "草莓蛋糕跟咖啡歐蕾？",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "呵。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "可以哦，",
    "voice": "vo_adv_1330004_040"
  },
  {
    "name": "飛白",
    "words": "這裡就由大姐姐我來請客。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "\\n那麼，",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "讓你看看我呼叫店員的華麗技巧。",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "飛白",
    "words": "Hey waiter……",
