    "words": "正處在生與死的夾縫中。",
    "voice": null
  },
  {
    "name": "媞雅",
    "words": "這是在2033年稍早以前的事情。",
    "voice": "vo_adv_1330004_089"
  },
  {
    "name": "媞雅",
    "words": "\\n在mimi",
    "voice": null
  },
  {
    "name": "媞雅",
    "words": "與《阿斯特朗傳奇》開發時，",
    "voice": null
  },
  {
    "name": "媞雅",
    "words": "\\n不可或缺的必備條件之一──",
    "voice": null
  },
  {
    "name": "媞雅",
    "words": "就是確保「LSS（生命維持裝置）」。",
    "voice": null
  },
  {
    "name": "媞雅",
    "words": "LSS的研究本身，",
    "voice": "vo_adv_1330004_090"
  },
  {
    "name": "媞雅",
    "words": "與mimi無關，",
    "voice": null
  },
  {
    "name": "媞雅",
    "words": "\\n而是全世界的研究者，",
    "voice": null
  },
  {
    "name": "媞雅",
    "words": "一──",
    "voice": null
  },
  {
    "name": "媞雅",
    "words": "直以來都在研究的。",
    "voice": null
  },
  {
    "name": "媞雅",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "媞雅",
    "words": "剛好",
    "voice": null
  },
  {
    "name": "媞雅",
    "words": "在飛白的時代，",
    "voice": null
  },
  {
    "name": "媞雅",
    "words": "有相當大的突破性進展呢。",
    "voice": null
  },
  {
    "name": "媞雅",
    "words": "從那發展而出的生命維持技術，",
    "voice": "vo_adv_1330004_091"
  },
  {
    "name": "媞雅",
    "words": "多虧了有嚮導老君",
    "voice": null
  },
  {
    "name": "媞雅",
    "words": "及迷宮女王",
    "voice": null
  },
  {
    "name": "媞雅",
    "words": "統整，",
    "voice": null
  },
  {
    "name": "媞雅",
    "words": "\\n將之提升至能夠實用的階段，",
    "voice": null
  },
  {
    "name": "媞雅",
    "words": "因此就算發生了「米奈娃的禁錮」，",
    "voice": null
  },
  {
    "name": "媞雅",
    "words": "\\n你們的身體也能平安無事……",
    "voice": null
  },
  {
    "name": "媞雅",
    "words": "似乎是這樣呢。",
    "voice": null
  },
  {
    "name": "媞雅",
    "words": "……不過。",
    "voice": "vo_adv_1330004_092"
  },
  {
    "name": "媞雅",
    "words": "飛白時代的技術，",
    "voice": null
  },
  {
    "name": "媞雅",
    "words": "\\n頂多只能讓身體冬眠，",
    "voice": null
  },
  {
    "name": "媞雅",
    "words": "維持「不要死掉」而已。",
    "voice": null
  },
  {
    "name": "媞雅",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "媞雅",
    "words": "還沒有發展出",
    "voice": null
  },
  {
    "name": "媞雅",
    "words": "能讓身體甦醒過來的技術……",
    "voice": null
  },
  {
    "name": "媞雅",
    "words": "……嗯？",
    "voice": "vo_adv_1330004_093"
  },
  {
    "name": "媞雅",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "媞雅",
    "words": "你問說，",
    "voice": null
  },
  {
    "name": "媞雅",
    "words": "那樣的她為何會在遊戲裡面",
    "voice": null
  },
  {
    "name": "媞雅",
    "words": "是嗎……？",
    "voice": null
  },
  {
    "name": "媞雅",
    "words": "誰知道呢？",
    "voice": "vo_adv_1330004_094"
  },
  {
    "name": "媞雅",
    "words": "\\n那種事，",
    "voice": null
  },
  {
    "name": "媞雅",
    "words": "我怎麼會知道。",
    "voice": null
  },
  {
    "name": "媞雅",
    "words": "不過嘛。",
    "voice": "vo_adv_1330004_095"
  },
  {
    "name": "媞雅",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "媞雅",
    "words": "她搞笑時你就寬容點，",
    "voice": null
  },
  {
    "name": "媞雅",
    "words": "對她抱持尊敬吧？",
    "voice": null
  },
  {
    "name": "媞雅",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "媞雅",
    "words": "畢竟她算是",
    "voice": null
  },
  {
    "name": "媞雅",
    "words": "你人生的前輩呀？",
    "voice": null
  },
  {
    "type": "background",
    "bg_id": "502480"
  },
  {
    "name": "格蕾斯",
    "words": "……騎士氏。",
    "voice": "vo_adv_1330004_096"
  },
  {
    "name": "格蕾斯",
    "words": "\\n騎士氏。",
    "voice": null
  },
  {
    "name": "薇歐莉特",
    "words": "騎士先生……！",
    "voice": "vo_adv_1330004_097"
  },
  {
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "薇歐莉特",
    "words": "太好了，",
    "voice": null
  },
  {
    "name": "薇歐莉特",
    "words": "你終於醒了呢……！",
    "voice": null
  },
  {
    "name": "薇歐莉特",
    "words": "格蕾斯，",
    "voice": "vo_adv_1330004_098"
  },
  {
    "name": "薇歐莉特",
    "words": "妳真是的……",
    "voice": null
  },
  {
    "name": "薇歐莉特",
    "words": "\\n居然將靈魂出竅的藥，",
    "voice": null
  },
  {
    "name": "薇歐莉特",
    "words": "加進了騎士先生的茶裡……！",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "習慣後就會愛上的。",
    "voice": "vo_adv_1330004_099"
  },
  {
    "name": "格蕾斯",
    "words": "\\n能夠穿透牆壁、",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "潛入地板或天花板──",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "還能盡情地偷窺女生溫泉。",
    "voice": null
  },
  {
    "name": "薇歐莉特",
    "words": "騎士先生，",
    "voice": "vo_adv_1330004_100"
  },
  {
    "name": "薇歐莉特",
    "words": "並不是會做那種事的人……！",
    "voice": null
  },
  {
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "薇歐莉特",
    "words": "……話說回來……",
    "voice": null
  },
  {
    "name": "薇歐莉特",
    "words": "格蕾斯，",
    "voice": null
  },
  {
    "name": "薇歐莉特",
    "words": "妳為什麼要做這種惡作劇呢？",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "是──",
    "voice": "vo_adv_1330004_101"
  },
  {
    "name": "格蕾斯",
    "words": "因為我想思考一下，",
    "voice": "vo_adv_1330004_102"
  },
  {
    "name": "格蕾斯",
    "words": "關於騎士氏死後的事。",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "我聽說，",
    "voice": "vo_adv_1330004_103"
  },
  {
    "name": "格蕾斯",
    "words": "騎士氏似乎是作為冒險者來維生……",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "的樣子。",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "\\n也就是說，",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "是個與死亡同在的",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "危險職業。",
