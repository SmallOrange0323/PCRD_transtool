[
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "咦……",
    "voice": "vo_adv_5064600_000",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這是",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "什麼東西？",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "是聖學祭的記錄本。",
    "voice": "vo_adv_5064600_001",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "咦，",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "反而該問妳怎麼會不知道？",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n這應該有發給所有學生才對。",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "這麼說來，",
    "voice": "vo_adv_5064600_002",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "昨天的確有",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "老師送了什麼東西來「象牙之塔」。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "\\n",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "但我想肯定又是來催繳還沒交的論文，",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "就沒有打開看了。",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "反正也沒差吧，",
    "voice": "vo_adv_5064600_003",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "上面都是些給來賓看的東西。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n實際上也是有些沒刊登在上面的祕密無趣競賽之類的。",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "不是那種問題啦！",
    "voice": "vo_adv_5064600_004",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "這可是刻劃了珍貴校園生活的紀念碑耶。",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n這可是在未來回首時，開啟記憶大門用的鑰匙。",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "好了學姐們！",
    "voice": "vo_adv_5064600_005",
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "\\n",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "琪愛兒",
    "words": "我們就來一起回想聖學祭的記憶熱鬧一番吧！",
    "voice": null,
    "unit_id": 116311
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "哦哦，",
    "voice": "vo_adv_5064600_006",
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "優妮",
    "words": "感覺好青春！",
    "voice": null,
    "unit_id": 116411
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "聖學祭啊……",
    "voice": "vo_adv_5064600_007",
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "\\n",
    "voice": null,
    "unit_id": 116211
  },
  {
    "type": "dialogue",
    "name": "克蘿依",
    "words": "是可以啊，雖然我記得都沒發生什麼好事。",
    "voice": null,
    "unit_id": 116211
  }
]
