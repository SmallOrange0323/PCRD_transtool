  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "哼哼，",
    "voice": "vo_adv_9055156_000",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "也沒什麼大不了的嘛！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "看我給你最後一擊！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "等等，",
    "voice": "vo_adv_9055156_001",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "小凱留！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n從魔物身上",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "已經感受不到敵意了。",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "而且──",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "牠的肚子",
    "voice": "vo_adv_9055156_002",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "叫得好大聲……！",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "看來牠很餓呢。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "搞不好",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "牠是餓壞了，",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "才會",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "忍不住襲擊人的？",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "若真是如此，",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "感覺有點可憐呀……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "可、",
    "voice": "vo_adv_9055156_003",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "可是我差點",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "被這傢伙吃掉耶！？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "差點就被啃得一乾二凈了耶──！？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "還請冷靜下來，",
    "voice": "vo_adv_9055156_004",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "凱留小姐。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n牠看起來也無意反抗，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n就分一點食物給牠吧……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "來，",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "請收下。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "啊……",
    "voice": "vo_adv_9055156_005",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "乖乖地吃下去了。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "牠似乎比想像中",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "還有智慧呢……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是呀，",
    "voice": "vo_adv_9055156_006",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "確實……",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "哦？",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "魔物遞了什麼東西出來呢。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "哇～！",
    "voice": "vo_adv_9055156_007",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是一個大鐵鍋，",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "跟一套廚具！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是不是要",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "謝謝我們給牠吃的，並且為壓壞鍋子道歉呀？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "謝謝你喔☆",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這鍋子真的有夠大耶……",
    "voice": "vo_adv_9055156_008",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "會是牠自己做的嗎？",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……哼，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "牠給人的感覺確實",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不像是生性邪惡的魔物。",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那就放過你吧！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不可以再襲擊人了喔～！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "牠跑走了。",
    "voice": "vo_adv_9055156_009",
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "……呵呵。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "不過真沒想到，",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "居然會從傳說中的",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "魔物手中拿到鍋子。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n果然",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "冒險",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "不曉得會發生什麼事呢……",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "讓人好雀躍呀。",
    "voice": null,
    "unit_id": 106412
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "是呀。",
    "voice": "vo_adv_9055156_010",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "往後大家也",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "一起去各種地方冒險吧。",
