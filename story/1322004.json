[
  {
    "type": "background",
    "bg_id": "502362"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "留守阿爾克絲鍊金堂的最後一晚。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n收拾完畢的{0}",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n準備好要回家後，跟望打了招呼。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "{0}，",
    "voice": "vo_adv_1322004_000",
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "辛苦你了。",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n謝謝你幫忙收拾店裡。",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "再次謝謝你，",
    "voice": "vo_adv_1322004_001",
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "謝謝你陪我",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n一起留守阿爾克絲鍊金堂。",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "接下來",
    "voice": "vo_adv_1322004_002",
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我想進行最後的鍊金。",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n因為我想要給你",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "一起留守的禮物。",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n這可能會花點時間──",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我、",
    "voice": "vo_adv_1322004_003",
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我的調製又搞砸了嗎！？",
    "voice": null,
    "unit_id": 132212
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "呀啊啊～～～！！",
    "voice": "vo_adv_1322004_004",
    "unit_id": 132212
  },
  {
    "type": "background",
    "bg_id": "510080"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "叮咚～",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你好～♪",
    "voice": "vo_adv_1322004_005",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "呼～",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "為了避免曝光，我小心翼翼地來，",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n結果花了好多時間……",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "對不起，我遲到了。",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "如果被週刊或網路新聞報導",
    "voice": "vo_adv_1322004_006",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "「櫻井望熱戀曝光！",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "躲在男朋友家約會！！」",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……之類的",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "有的沒的，就傷腦筋了。",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "咦……？",
    "voice": "vo_adv_1322004_007",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n這是",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "如果跟我傳出誹聞，你會高興的意思嗎……？",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……如果是這樣，",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我也",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "很高……",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不、",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不對不可以啦！！",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯、",
    "voice": "vo_adv_1322004_008",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯，",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "會傷腦筋對吧……",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n如果真的引起話題，",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "就不能再像這樣",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "來訪了呀。",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "可是……",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我有點受到打擊呢。",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "比起這個，",
    "voice": "vo_adv_1322004_009",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我今天來可是有重大的目的。",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n{0}，",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你還記得嗎？",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嘿嘿嘿。",
    "voice": "vo_adv_1322004_010",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你果然還記得。",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我買了這～麼多的",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "食材喔！",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "欸～",
    "voice": "vo_adv_1322004_011",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "你忘記了？",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我買了這麼多的食材來耶！",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "就算忘記了也給我想起來～！",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "其實下個月，",
    "voice": "vo_adv_1322004_012",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我接到最近大受歡迎的烹飪節目的來賓通告。",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "所以，",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我得在節目上做咖哩……",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……通告的契機是這篇雜誌的報導。",
    "voice": "vo_adv_1322004_013",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n這是我剛開始當偶像時的訪談，",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n那個，",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我稍微念一下喔……",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "「嘿嘿嘿。",
    "voice": "vo_adv_1322004_014",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "小望望的興趣是烹飪的說♪",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n尤其咖哩的風味更是不輸餐廳的說♪」",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不、",
    "voice": "vo_adv_1322004_015",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不是喔！",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n我才沒這樣說……！",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我又沒在偶像的人設上搖擺過！",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這是……",
    "voice": "vo_adv_1322004_016",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "當時的製作人擅自撰寫的。",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "「小望望」也是，",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "句尾的「的說」也是……",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "而且。",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n……還說我的興趣是烹飪，",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "這一切都是隨便寫的。",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "只是一篇小小的報導，",
    "voice": "vo_adv_1322004_017",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我自己也忘記了……",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n但烹飪節目的工作人員",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "似乎對這篇報導有印象。",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n因此",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "才會發這次的通告給我……",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "可是，",
    "voice": "vo_adv_1322004_018",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我根本沒有擅長烹飪……",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "甚至",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "可說是很不擅長……",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n所、",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "所以，",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "要是這樣下去，應該會出糗……",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "所以，",
    "voice": "vo_adv_1322004_019",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "希望你能幫我試吃。",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n試看看我做的咖哩的味道。",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……那個，",
    "voice": "vo_adv_1322004_020",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "如果不好吃，",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "也可以老實說你的感想喔。",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "只要知道哪裡不足，",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我也能好好練習。",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "好……",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "那麼，",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我們就快開始吧……！",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "烹煮咖哩，",
    "voice": "vo_adv_1322004_021",
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "開始！",
    "voice": null,
    "unit_id": 102931
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "於是，望開始做菜。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n她用著笨拙的動作將切好的材料放進鍋中。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "132200401"
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "……攪拌攪拌……",
    "voice": "vo_adv_1322004_022",
    "unit_id": 102931
  },
  {
