    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n好像有棘手的傢伙",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "出現了耶？",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "而且，",
    "voice": "vo_adv_5054321_001",
    "unit_id": 114611
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "\\n每當我們有什麼動作，",
    "voice": null,
    "unit_id": 114611
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "對方就會變得更強大。",
    "voice": null,
    "unit_id": 114611
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "看來對方還沒有把底牌亮出來呢。",
    "voice": "vo_adv_5054321_002",
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "……不過，",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "就算能看穿我們的行動",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "也沒用。",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "因為結局，",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "秋乃",
    "words": "早就已經決定好了！",
    "voice": null,
    "unit_id": 114411
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我們要奪回能讓大家幸福的聖誕節，",
    "voice": "vo_adv_5054321_003",
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "對吧？",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "那麼，",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "又要開始工作囉。",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "嗯！",
    "voice": "vo_adv_5054321_004",
    "unit_id": 114611
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "我也會為了工作結束後的麥酒",
    "voice": null,
    "unit_id": 114611
  },
  {
    "type": "dialogue",
    "name": "優花梨",
    "words": "好好努力的！",
    "voice": null,
    "unit_id": 114611
  }
