    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "耶──！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "\\n我打倒壞蛋了！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "我成為正義的夥伴了──！",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "呵呵。",
    "voice": "vo_adv_1167003_069",
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "你玩得很棒喔……！",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "那個玩具因為你的玩法",
    "voice": "vo_adv_1167003_070",
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "而變成正義的夥伴了！",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n雖然看起來很凶，",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "但他擁有溫柔的心！",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "他原本或許是非常邪惡的角色，",
    "voice": "vo_adv_1167003_071",
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "但你的玩法卻加入了",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "原創的設定！",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "玩具的玩法是自由的……",
    "voice": "vo_adv_1167003_072",
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "是沒有限制的。",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n我是這麼認為的喔。",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "用原本的設定玩也不錯，",
    "voice": "vo_adv_1167003_073",
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n但它是你好不容易才拿到，",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "只屬於你自己的玩具。",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "所以，",
    "voice": "vo_adv_1167003_074",
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "你也可以",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "像剛才那樣，",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n照自己喜歡的方式玩，對吧……？",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "少年",
    "words": "照自己喜歡的方式……",
