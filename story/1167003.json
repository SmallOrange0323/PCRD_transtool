    "type": "dialogue",
    "name": "碧",
    "words": "太好了……",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "架上還有很多其他工廠製作的玩具……",
    "voice": "vo_adv_1167003_002",
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n每一個都好帥氣……！",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "我也想把「有我在喔好朋友號V4」",
