    "name": "碧",
    "words": "我小時候不曾玩過這種玩具。",
    "voice": null,
    "unit_id": 116711
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n畢竟是在精靈之森長大的。",
    "voice": null,
    "unit_id": 116711
  },
