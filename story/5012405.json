  {
    "type": "dialogue",
    "name": "霞",
    "words": "呵呵，",
    "voice": "vo_adv_5012405_001",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "看妳那個表情",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "根本不需要推理呢。",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n看著助手先生接連地打倒敵人，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "讓妳又重新迷上他了吧？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "這、",
    "voice": "vo_adv_5012405_002",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "這麼說霞才是，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n前輩打倒敵人的時候，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "妳不也小聲地說了",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "「好帥氣……」嗎！",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "妳、",
    "voice": "vo_adv_5012405_003",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "妳聽到了我那時候說的話嗎！？",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "那、",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "那只是客觀的評價，",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我說他帥氣",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "並不是那種意思……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "那個……",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "…………盯～",
    "voice": "vo_adv_5012405_004",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "……啊～真是的，",
    "voice": "vo_adv_5012405_005",
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這個話題就到此為止！",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "接下來",
    "voice": null,
    "unit_id": 101411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "也集中精神來戰鬥吧！",
    "voice": null,
    "unit_id": 101411
  }
