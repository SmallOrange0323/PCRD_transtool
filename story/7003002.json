[
  {
    "type": "background",
    "bg_id": "500430"
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "之前的時裝秀……",
    "voice": "vo_adv_7003002_000",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "由於身體狀況不佳，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "還真是累死我了～",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "不過",
    "voice": "vo_adv_7003002_001",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "看見了粉絲們的笑容，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "聽見了他們的聲音，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n我便完全忘記了自己的身體狀況",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "很平常地走在伸展台上了～",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "嗯，",
    "voice": "vo_adv_7003002_002",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我十分能體會那種感覺！",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "我也在發高燒時依然進行了演唱會活動，",
    "voice": "vo_adv_7003002_003",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "當我一踏上舞台，發燒的事情便在我腦海中煙消雲散了一般。",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "可是，",
    "voice": "vo_adv_7003002_004",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "一從舞台退下身體便完全使不上力了……",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "隔天，就只能待在被窩裡甚麼也不能做了呢。",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "啊哈哈，",
    "voice": "vo_adv_7003002_005",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "真好笑～♪",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n我們真的是很相似呢！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "欸，",
    "voice": "vo_adv_7003002_006",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "怎麼了秀才？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "怎麼一副可怕的表情……",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "啊，",
    "voice": "vo_adv_7003002_007",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "抱歉了。",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n只有我們兩個太興奮過頭了嗎？",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "咦？",
    "voice": "vo_adv_7003002_008",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "　……我們兩個，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "要好好愛惜自己的身體是嗎？",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "什、",
    "voice": "vo_adv_7003002_009",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "什麼嘛～",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "別嚇我嘛——",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不過，",
    "voice": "vo_adv_7003002_010",
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "也是呢……",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "謝謝你。",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "雖然大家都會關心我，",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不過會這麼為我操心的，\\n也只有{0}了呢。",
    "voice": null,
    "unit_id": 102911
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "我也是呢，",
    "voice": "vo_adv_7003002_011",
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "秀才！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "謝謝你了，",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "感覺你能讓我的心情更加放鬆了呢！",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "鈴奈",
    "words": "果然秀才的人真的很好呢―♪",
    "voice": null,
    "unit_id": 101611
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "之後一陣子，兩人的笑容許久都沒有消失。",
    "voice": null,
    "unit_id": null
  }
]
