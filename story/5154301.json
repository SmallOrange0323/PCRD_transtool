    "name": "露易絲瑪莉",
    "words": "但是",
    "voice": null,
    "unit_id": 132311
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "跟魔物辭典上記載的一般種外表不一樣。",
    "voice": null,
    "unit_id": 132311
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "\\n感覺整體上，",
    "voice": null,
    "unit_id": 132311
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "更黑……！",
    "voice": null,
    "unit_id": 132311
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "不是只有外表啊露易！",
    "voice": "vo_adv_5154301_001",
    "unit_id": 132211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n恐怕強度也不是",
    "voice": null,
    "unit_id": 132211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "一般種可以比擬的……！",
    "voice": null,
    "unit_id": 132211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "\\n……大家，",
    "voice": null,
    "unit_id": 132211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "加油吧……！",
    "voice": null,
    "unit_id": 132211
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "沒問題的，",
    "voice": "vo_adv_5154301_002",
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "望。",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n我們的保鑣，",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "劍術可是一流的呢。",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "是～的！",
    "voice": "vo_adv_5154301_003",
    "unit_id": 132411
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "\\n彩羽可是最強的──！",
    "voice": null,
    "unit_id": 132411
  },
  {
    "type": "dialogue",
    "name": "惡毒巨蛇",
    "words": "嘶啊啊啊！！",
    "voice": null,
    "unit_id": 18611
  },
  {
    "type": "dialogue",
    "name": "彩羽",
    "words": "……怎麼？",
    "voice": "vo_adv_5154301_004",
    "unit_id": 132411
  },
  {
    "type": "dialogue",
    "name": "惡毒巨蛇",
    "words": "──唔！！？",
    "voice": null,
    "unit_id": 18611
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "咦……",
    "voice": "vo_adv_5154301_005",
    "unit_id": 132211
  },
  {
    "type": "dialogue",
    "name": "望",
    "words": "魔物的動作停止了！？",
    "voice": null,
    "unit_id": 132211
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "就像青蛙被蛇盯上會無法動彈一樣，",
    "voice": "vo_adv_5154301_006",
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n牠就像是被彩羽給盯上",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "的蛇嗎？",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "\\n",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "不過",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
    "name": "苑",
    "words": "可不能大意哦。",
    "voice": null,
    "unit_id": 132511
  },
  {
    "type": "dialogue",
