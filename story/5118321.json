    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "看起來似乎是想使出什麼絕招！",
    "voice": null,
    "unit_id": 125511
  },
  {
    "type": "dialogue",
    "name": "莫夫",
    "words": "……就讓我向各位宣告吧。",
    "voice": "vo_adv_5118321_002",
    "unit_id": 17512
  },
  {
    "type": "dialogue",
    "name": "莫夫",
    "words": "\\n接下來我所使出的這記攻擊，",
    "voice": null,
    "unit_id": 17512
  },
  {
    "type": "dialogue",
    "name": "莫夫",
    "words": "肯定會打倒你們其中一人。",
