  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "如果這是在說笑，或許還能輕鬆應對……",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "但瞧這個氣勢，他是說真的。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "還是認真對待剛才的發言比較好。",
    "voice": null,
    "unit_id": 125711
  },
  {
    "type": "dialogue",
    "name": "碧卡拉",
    "words": "不過，",
