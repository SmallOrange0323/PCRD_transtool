  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "哇！",
    "voice": "vo_adv_5046308_000",
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n牠越來越凶狠了～！",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "哎呀～",
    "voice": "vo_adv_5046308_001",
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "這個樣子，",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "看來很難",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "靠溝通解決呢～",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n我其實是想要溫柔地放你回海裡去呢",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "……傷腦筋～",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "……不過，",
    "voice": "vo_adv_5046308_002",
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "似乎不是說這種話的時候了！",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "如果放著牠不管的話，",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "大賽會變得一團亂的──！",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "為了大家的夢想而戰吧！",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我們必須守護這座球場！",
    "voice": null,
    "unit_id": 113411
  }
