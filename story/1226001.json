    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "……你別誤會了。",
    "voice": "vo_adv_1226001_042",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "我只是不想再讓負債增加了。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "\\n我話先說在前頭，",
    "voice": null,
