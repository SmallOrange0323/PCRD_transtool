[
  {
    "type": "background",
    "bg_id": "500520"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "【破曉之星】和{0}，\\n從南島度假回來後過了幾天──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "在南島",
    "voice": "vo_adv_1226001_000",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "玩得真開心啊……",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我忍不住",
    "voice": "vo_adv_1226001_001",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "說出來了呢。",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n對騎士先生說了",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "「最喜歡你了」這種話……",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n是因為當時是在那座火熱又耀眼的島，",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我才說得出口嗎……",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "嗚……！！",
    "voice": "vo_adv_1226001_002",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "不過……",
    "voice": "vo_adv_1226001_003",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "不過……",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我並不覺得後悔。",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n因為那是……",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我的……",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "background",
    "bg_id": "500040"
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "真心的……！",
    "voice": "vo_adv_1226001_004",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "呀啊啊啊啊！",
    "voice": "vo_adv_1226001_005",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n騎、",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "騎士先生！？",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "你什麼時候開始在那裡的！？",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "呃，",
    "voice": "vo_adv_1226001_006",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "你在是完全沒有問題啦……！",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n只不過……",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我希望你能再",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "出點聲音",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "這樣……！",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "所以，",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "你今天來是有什麼事嗎？",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "幫忙騎士先生的，",
    "voice": "vo_adv_1226001_007",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "打工……？",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "這樣啊，",
    "voice": "vo_adv_1226001_008",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我是很想",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "直接答應啦……",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n不過日和跟怜今天都不在。",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我一個人也",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "幫得上忙嗎……？",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "真的嗎？",
    "voice": "vo_adv_1226001_009",
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n……你被要求",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "「要和女孩子兩個人一起去」？",
    "voice": null,
    "unit_id": 100213
  },
  {
    "type": "background",
    "bg_id": "500160"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "優衣和{0}總之還是來到了打工雇主的「社長」所在之處──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "哦，",
    "voice": "vo_adv_1226001_010",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "等你們很久了。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "妳叫什麼名字？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "優衣？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "請多指教囉～",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "啊，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "這是名片。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "我在經營舉辦活動的公司。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "\\n我是社長，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "這位是",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "我的專務",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "兼妻子。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "……你們好。",
    "voice": "vo_adv_1226001_011",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "那麼",
    "voice": "vo_adv_1226001_012",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "進入正題。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "\\n想請兩位協助的活動就是……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "專為情侶設計的",
    "voice": "vo_adv_1226001_013",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "海灘慶典",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "嗎……？",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "對。",
    "voice": "vo_adv_1226001_014",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "有看到嗎？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "那邊一整排的夏季活動設施。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "\\n那些",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "全都是情侶專用的。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "很厲害吧？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "這一定會爆紅的～",
    "voice": "vo_adv_1226001_015",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "\\n遊客肯定會像",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "那朵積雨雲一樣",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "湧入這裡。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "……負債也像那朵積雨雲一樣膨脹就是了。",
    "voice": "vo_adv_1226001_016",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "那種事",
    "voice": "vo_adv_1226001_017",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "不重要啦！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "所以，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "我",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "想請兩位來當這個慶典的",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "「體驗測試人員」。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "體驗測試人員……？",
    "voice": "vo_adv_1226001_018",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "對。",
    "voice": "vo_adv_1226001_019",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "其實在那邊的各項活動設施，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "\\n都還沒確認完",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "其安全性與實效性。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "\\n所以想拜託兩位",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "幫忙做事前檢測。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "也就是說，",
    "voice": "vo_adv_1226001_020",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "這個工作是要我們兩個，",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n去試玩情侶活動",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "的意思嗎……？",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "對，",
    "voice": "vo_adv_1226001_021",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "一點也沒錯。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "原、",
    "voice": "vo_adv_1226001_022",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "原來如此……",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我跟騎士先生……",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "一起玩",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "情侶取向的……",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "………………",
    "voice": "vo_adv_1226001_023",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "……你們兩個有在交往嗎？",
    "voice": "vo_adv_1226001_024",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "咦！？",
    "voice": "vo_adv_1226001_025",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "那種小細節",
    "voice": "vo_adv_1226001_026",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "不重要吧？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "這很重要好嗎？",
    "voice": "vo_adv_1226001_027",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "\\n難道",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "你又想隨便檢測讓實際舉辦時出大包，",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "\\n辦成讓負債滾雪球的活動嗎？",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "不、",
    "voice": "vo_adv_1226001_028",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "不是啦，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "社長",
    "words": "我不是那個意思──",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "我已經受夠陪著你打腫臉充胖子了。",
    "voice": "vo_adv_1226001_029",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "\\n",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "不好意思，",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "可以請你們告訴我嗎？",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "只要說有沒有在交往就好。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "\\n抱歉問了這麼隱私的問題。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "啊啊不會！",
    "voice": "vo_adv_1226001_030",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n……說得也是。",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n畢竟這是情侶取向的慶典體驗測試人員……",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "會問也是正常的。",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "那個……",
    "voice": "vo_adv_1226001_031",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "對不起。",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n我跟騎士先生",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "之間並不是",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "情侶……",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "關係。",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "啊，",
    "voice": "vo_adv_1226001_032",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "你們沒有在交往啊？",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "感覺好意外。",
