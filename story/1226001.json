    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "對吧……？",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "不，",
    "voice": "vo_adv_1226001_034",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "沒在交往的話就好。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "\\n",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "錄取了，",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "抱歉要你們說出來。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "錄取！？",
    "voice": "vo_adv_1226001_035",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n我們並不是情侶，",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "真的沒關係嗎？",
    "voice": null,
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "嗯，",
    "voice": "vo_adv_1226001_036",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "不是情侶",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "反而還比較好。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "\\n",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "所謂的檢測",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "不就得設想各種情境，",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "\\n讓你們依照這邊的指示，",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "去做出各式各樣的動作才行嗎？",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "你們去請對真正的情侶來看看。",
    "voice": "vo_adv_1226001_037",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "\\n一定測試到一半就開始進入兩人世界，不然就是吵起架來。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "情侶檔的狀況，",
    "voice": "vo_adv_1226001_038",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "\\n可是比歐拉爾高山的山頂天氣還不穩定。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "\\n根本沒辦法照我們這邊所想的去檢測。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "所以「裝作」是情侶，",
    "voice": "vo_adv_1226001_039",
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "然後「演戲」比較好。",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "\\n不如說對對方完全沒感覺的人，",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "\\n才比較會",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "專務",
    "words": "乖乖照這邊的指示行動吧？",
    "voice": null,
    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "原來如此……",
    "voice": "vo_adv_1226001_040",
    "unit_id": 122611
  },
