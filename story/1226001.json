    "unit_id": 6511
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "……是的。",
    "voice": "vo_adv_1226001_033",
    "unit_id": 122611
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "所以就不錄取了",
