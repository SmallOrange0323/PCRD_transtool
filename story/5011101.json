  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n馬上就要到快樂的情人節了！",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "要做什麼巧克力給哥哥好呢～",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "咦，",
    "voice": "vo_adv_5011101_001",
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "奇怪？",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n在那邊的人是",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "惠理子和姐姐！？",
    "voice": null,
    "unit_id": 101112
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "靜流……",
    "voice": "vo_adv_5011101_002",
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "妳要在情人節",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n贈送{0}大人巧克力",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "是真的嗎？",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "當然是真的呀，",
    "voice": "vo_adv_5011101_003",
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "畢竟是一年一次的情人節嘛。",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n為了能讓{0}感到高興，",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "姐姐會加油的！",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "{0}大人應該不會收取我之外的女性",
    "voice": "vo_adv_5011101_004",
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n贈送的巧克力才是……",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "是這樣嗎？",
    "voice": "vo_adv_5011101_005",
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我認為{0}不會收下姐姐之外的人",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n給的巧克力才對喔？",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "既然如此，",
    "voice": "vo_adv_5011101_006",
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n那就必須排除障礙了呢。",
    "voice": null,
    "unit_id": 109011
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "這是要做個了斷的意思嗎？",
    "voice": "vo_adv_5011101_007",
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "那麼……",
    "voice": null,
    "unit_id": 109111
  },
  {
    "type": "dialogue",
    "name": "靜流、惠理子",
    "words": "開始",
    "voice": "vo_adv_5011101_008",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "靜流、惠理子",
    "words": "正式比賽！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "璃乃、靜流、惠理子",
    "words": "下回，",
    "voice": "vo_adv_5011101_009",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "璃乃、靜流、惠理子",
    "words": "「情人節之戰！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "璃乃、靜流、惠理子",
    "words": "　正中紅心的甜蜜戰鬥」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500610"
  },
  {
    "type": "dialogue",
    "name": "璃乃",
