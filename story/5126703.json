[
  {
    "type": "background",
    "bg_id": "500081"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "正在讀書的凱留與{0}。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n兩人一起讀書的日子到今天迎來最後一天。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……好啦，",
    "voice": "vo_adv_5126703_000",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "今天就念到這裡吧。",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不過話說回來，",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "今天是最後一天了。",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "如何？",
    "voice": "vo_adv_5126703_001",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我們努力念了這麼久，",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n考試應該沒問題吧？",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "哦，",
    "voice": "vo_adv_5126703_002",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "很敢說嘛！",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不過，",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我們很認真地念書了嘛～",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊～？",
    "voice": "vo_adv_5126703_003",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "怎麼一臉沒自信的樣子～！",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……我說你，",
    "voice": "vo_adv_5126703_004",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "把鉛筆拿出來！",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……你在發什麼楞啊！",
    "voice": "vo_adv_5126703_005",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我不是在開始準備考試時有給你一支鉛筆嗎～？",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n還說了要認真讀書，讀到把鉛筆用完。",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊啊，",
    "voice": "vo_adv_5126703_006",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "就是這個。",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……呵呵，",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "稍微借我一下喔。",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……好厲害。",
    "voice": "vo_adv_5126703_007",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "交給你的時候還是全新的，",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n現在已經短到都快握不住了。",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你很認真努力呢。",
    "voice": "vo_adv_5126703_008",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "真沒辦法，我就給你個獎勵吧！",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "哼，",
    "voice": "vo_adv_5126703_009",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那是當然囉！",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我都親自教你了，如果你還沒有動力，",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我可是會宰了你喔♪",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……來，",
    "voice": "vo_adv_5126703_010",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這是給你的",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "禮物。",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "是新的鉛筆喔。",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你就用這支來考試吧。",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……咦？",
    "voice": "vo_adv_5126703_011",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這隻短的鉛筆比較好？",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "可是這支筆，",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不管怎麼說都太短了吧。",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "好啦，",
    "voice": "vo_adv_5126703_012",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我給你一支新的，",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n那支就丟了吧。",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……！！",
    "voice": "vo_adv_5126703_013",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "什……",
    "voice": "vo_adv_5126703_014",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "什麼～？",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你說這就是青春，",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n未免也太寒酸了吧！！",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……哎，",
    "voice": "vo_adv_5126703_015",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "隨便你了！",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "那麼，考前讀書就到這裡結束！",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n我還要再多待一下，",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你先回去吧！",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "再見囉！",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你要是敢在正門等我，我就宰了你喔！？",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "…………他走掉了吧？",
    "voice": "vo_adv_5126703_016",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n應該聽不到我說話了吧……？",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……呵呵，",
    "voice": "vo_adv_5126703_017",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "說什麼那支鉛筆是青春。",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n還說是他",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "和我的……",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "青春。",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "呵呵呵。",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "感覺",
    "voice": "vo_adv_5126703_018",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "很想笑呢。",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n明明我一點也不覺得高興啊♪",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "……我會繼續送你的，",
    "voice": "vo_adv_5126703_019",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "再送個",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "100支",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "鉛筆吧。",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "真希望這段時光",
    "voice": "vo_adv_5126703_020",
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "能夠繼續下去──",
    "voice": null,
    "unit_id": 127214
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就這樣，認真讀書的兩人，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n面帶著笑容迎接了期末考的挑戰。",
    "voice": null,
    "unit_id": null
  }
]
