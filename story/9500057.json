  {
    "type": "dialogue",
    "name": "步未",
    "words": "咦……",
    "voice": "vo_adv_9500057_001",
    "unit_id": 105541
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "咦……",
    "voice": null,
    "unit_id": 105541
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105541
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "咦咦咦咦咦咦咦咦……！？",
    "voice": null,
    "unit_id": 105541
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我、",
    "voice": "vo_adv_9500057_002",
    "unit_id": 105541
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我！？",
    "voice": null,
    "unit_id": 105541
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n前輩",
    "voice": null,
    "unit_id": 105541
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "真的對我……！？",
    "voice": null,
    "unit_id": 105541
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "可、",
    "voice": "vo_adv_9500057_003",
    "unit_id": 105541
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "可是我",
    "voice": null,
    "unit_id": 105541
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "存在感很薄弱，",
    "voice": null,
    "unit_id": 105541
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "又會跟蹤前輩，",
    "voice": null,
    "unit_id": 105541
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n而且也不像其他人那樣有著鮮明的個性……",
    "voice": null,
    "unit_id": 105541
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105541
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "明明……",
    "voice": null,
    "unit_id": 105541
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "明明是那樣，",
    "voice": "vo_adv_9500057_004",
    "unit_id": 105541
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "選我",
    "voice": null,
    "unit_id": 105541
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "真的好嗎……？",
    "voice": null,
    "unit_id": 105541
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "前輩……",
    "voice": "vo_adv_9500057_005",
    "unit_id": 105541
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n謝謝你。",
    "voice": null,
    "unit_id": 105541
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我、",
    "voice": "vo_adv_9500057_006",
    "unit_id": 105541
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我、",
    "voice": null,
    "unit_id": 105541
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我也…………",
    "voice": null,
    "unit_id": 105541
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "喜",
    "voice": null,
    "unit_id": 105541
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "歡",
    "voice": null,
    "unit_id": 105541
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "前輩。",
    "voice": null,
    "unit_id": 105541
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "……最初，",
    "voice": "vo_adv_9500057_007",
    "unit_id": 105541
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我想我只是單純地憧憬著前輩。",
    "voice": null,
    "unit_id": 105541
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105541
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "憧憬著對人溫柔",
    "voice": null,
    "unit_id": 105541
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "又很帥氣的前輩。",
    "voice": null,
    "unit_id": 105541
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "但憧憬",
    "voice": "vo_adv_9500057_008",
    "unit_id": 105541
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "不知不覺就變成了喜歡……",
    "voice": null,
    "unit_id": 105541
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105541
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "至今",
    "voice": null,
    "unit_id": 105541
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我一直都只是跟蹤前輩、",
    "voice": null,
    "unit_id": 105541
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "默默地注視著前輩而已，",
    "voice": null,
    "unit_id": 105541
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n但從今以後，",
    "voice": null,
    "unit_id": 105541
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我想改變",
    "voice": null,
    "unit_id": 105541
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "這樣的自己。",
    "voice": null,
    "unit_id": 105541
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "因為……",
    "voice": "vo_adv_9500057_009",
    "unit_id": 105541
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我想並肩站在",
    "voice": null,
    "unit_id": 105541
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n選擇了",
    "voice": null,
    "unit_id": 105541
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我的前輩身旁。",
    "voice": null,
    "unit_id": 105541
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n為了不讓自己迷失，",
    "voice": null,
    "unit_id": 105541
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "我會像這樣緊緊握住你的手的。",
    "voice": null,
    "unit_id": 105541
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "所以……",
    "voice": null,
    "unit_id": 105541
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "從現在開始，",
    "voice": "vo_adv_9500057_010",
    "unit_id": 105541
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "請讓我一直、",
    "voice": null,
    "unit_id": 105541
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "一直陪伴在你身邊喔。",
    "voice": null,
    "unit_id": 105541
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n前輩……♪",
    "voice": null,
    "unit_id": 105541
  }
]
