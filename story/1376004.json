  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "解決異狀後……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n可可蘿和{0}暫時停留在精靈族之村，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n來到附近的森林查看狀況。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "看來森林裡的精靈們，",
    "voice": "vo_adv_1376004_000",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "已經完全恢復以前的狀態了呢。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n恢復成以往熟悉的景色，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "令人感到十分開心。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "今天的風，",
    "voice": "vo_adv_1376004_001",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "感覺又更舒服了一些。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "願意的話，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "主人要不要休息一下呢。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n若您希望，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "躺大腿之類的也……",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……咦？",
    "voice": "vo_adv_1376004_002",
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這道光，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "看起來是愛梅斯大人的神諭呢。",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "十分久違了，",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "令人很是期待……",
    "voice": null,
    "unit_id": 137611
  },
  {
    "type": "background",
    "bg_id": "510350"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "這一天，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}受到可蘿的邀請，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n前往自然公園野餐。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "{0}先生，",
    "voice": "vo_adv_1376004_003",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "讓您久等了……",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "是，",
    "voice": "vo_adv_1376004_004",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "早安。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n今天為了讓{0}先生",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "度過安心的一段時間，",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n在下",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "會盡心盡力照顧……",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "……哎呀？",
    "voice": "vo_adv_1376004_005",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n這身體",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "還是原本小時候的……？",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "啊，",
    "voice": "vo_adv_1376004_006",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "沒事……",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "失禮了。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "……接下來，",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "就出發去野餐吧。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "background",
    "bg_id": "510070"
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "今天的天空",
    "voice": "vo_adv_1376004_007",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "真的是",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "晴朗到感覺很舒服呢。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n適合野餐的天氣",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "完全就是像這樣的天氣。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "{0}先生每天用功讀書，",
    "voice": "vo_adv_1376004_008",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "在下想讓您有個機會充足休息。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "或許是在下的這個願望",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "上達天聽了也說不定呢。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "background",
    "bg_id": "510390"
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "{0}先生，",
    "voice": "vo_adv_1376004_009",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "請看。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n這裡開著很可愛的花呢。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "咦，",
    "voice": "vo_adv_1376004_010",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "要拍照片是嗎。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "……咦，",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "在下也一起？",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "明白了。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "請多指教。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "background",
    "bg_id": "510070"
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "差不多要到中午了呢。",
    "voice": "vo_adv_1376004_011",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n在下",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "準備了三明治。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n請多多享用。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "您高興那就太好了。",
    "voice": "vo_adv_1376004_012",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n在大自然之中用餐，",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "本身就像是加了高品質的調味，",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n能夠增加滿足感呢。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "接下來……",
    "voice": "vo_adv_1376004_013",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "走一段時間想必也累了，",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n就在適度的陽光下暖暖身體吧。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "方便的話，",
    "voice": "vo_adv_1376004_014",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "來吧，",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "過來這邊……",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n請躺到在下的大腿上，",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "好好休息吧。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "……說是這麼說，",
    "voice": "vo_adv_1376004_015",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "再大一點的雙腿，",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n才會比較有安心感吧……",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "沒、",
    "voice": "vo_adv_1376004_016",
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "沒事，",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "沒有問題。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "\\n來來，",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "可蘿",
    "words": "請躺下來吧。",
    "voice": null,
    "unit_id": 105932
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在晴朗的太陽光和可蘿的溫柔包覆下，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}度過了一段快樂的野餐時光……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "……小可可蘿。",
    "voice": "vo_adv_1376004_017",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n啊啊，小可可蘿，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "小可可蘿……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "呼～",
    "voice": "vo_adv_1376004_018",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "小可可蘿果然好可愛。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n光是看著就覺得滿足感源源不絕。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "咦，",
    "voice": "vo_adv_1376004_019",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你在意的是那一點？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "難道說，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你比較想和大人版的小可可蘿野餐",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "之類的？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "嗯～",
    "voice": "vo_adv_1376004_020",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "確實……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "可是這部分沒辦法呀。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n這場夢",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "只不過是我準備的模擬世界而已。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "如果在那邊的世界，",
    "voice": "vo_adv_1376004_021",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "要讓那孩子自由行動",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "就會需要義體身體對吧？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "跟真實的身體不一樣，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "要製造出成長後的形象",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "沒那麼容易啦。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "原來如此，",
    "voice": "vo_adv_1376004_022",
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "有這樣子的理由呢。",
    "voice": null,
    "unit_id": 105913
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 105913
  },
