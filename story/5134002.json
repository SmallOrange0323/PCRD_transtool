[
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "為了阻止在預知夢中出現的隕石落下，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}一行人展開了行動。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n他們前往位於森林裡的祠堂，以尋找線索……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500170"
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "呼、",
    "voice": "vo_adv_5134002_000",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "呼……",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "雖然知道地點在森林深處……",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n但真的在非常裡面耶。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "初音，",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "妳的腳還好嗎？",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嗯──",
    "voice": "vo_adv_5134002_001",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "好像有點不太好……",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n如果要和你一起去新年參拜的話，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "似乎得想點辦法才行呢。",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "咦，",
    "voice": "vo_adv_5134002_002",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "初音她，",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "要和助手先生去新年參拜……！？",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我這不是完全錯過時機了嗎……！　",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "他們是單獨兩個人？",
    "voice": "vo_adv_5134002_003",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "還是和大家一起……？",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "首先要先冷靜下來……！",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "從她現在的話裡能夠推理出來的事情是……",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "霞霞，",
    "voice": "vo_adv_5134002_004",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n走路不看路的話，會撞到樹枝喔！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "咦……",
    "voice": "vo_adv_5134002_005",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "嗚呀啊！！",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "抱、",
    "voice": "vo_adv_5134002_006",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "抱歉，",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "助手先生。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我剛剛在想事情……",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "讓我幫妳看看。",
    "voice": "vo_adv_5134002_007",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "……太好了，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "沒有腫起來！",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "初音，謝謝妳，",
    "voice": "vo_adv_5134002_008",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我接下來會好好集中精神的。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我們得想辦法找到夢中的少女，",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "向她打聽消息才行。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "background",
    "bg_id": "500180"
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……這就是那座祠堂。",
    "voice": "vo_adv_5134002_009",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我製作的新年裝飾的確不見了呢。",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "和你們上午來的時候相比，",
    "voice": "vo_adv_5134002_010",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "還有什麼不一樣的地方嗎？",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "不管是多麼細微的事情都好。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不一樣的地方啊……？",
    "voice": "vo_adv_5134002_011",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "嗯……",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "咦？",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這麼說起來，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "祠堂的門是開著的嗎？",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n我當時本來想要打掃裡面的，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "但我記得門是打不開的……",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "裡面……",
    "voice": "vo_adv_5134002_012",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "看起來空空如也呢。",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "是被那位女孩拿走了嗎？",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這座祠堂看起來相當古老，",
    "voice": "vo_adv_5134002_013",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n就算發生竊盜或是風化導致裡面空無一物，",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "也不奇怪……",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "但如果在上午時門是關著的話，",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "那東西的確有可能是被拿走了。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "這裡面究竟是供奉什麼樣的神明呢？",
    "voice": "vo_adv_5134002_014",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我為了這次調查，",
    "voice": "vo_adv_5134002_015",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n有帶了記載各種神明的書來……",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "從祠堂的形狀來看，",
    "voice": "vo_adv_5134002_016",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這裡供奉的應該是",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "名為森神的神明吧。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n在很久以前，",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "似乎是極少部分的精靈族所信奉的。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "初音也是精靈族……",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "妳有聽說過嗎？",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "沒有呢。",
    "voice": "vo_adv_5134002_017",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "但是……",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "祂被遺忘了這麼久，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "一定很寂寞吧。",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "有你和祈梨幫忙打掃，",
    "voice": "vo_adv_5134002_018",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n森神大人一定也很開心吧？",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "正是如此！！",
    "voice": "vo_adv_5134002_019",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n不知不覺便被放置了數百年而無人問津……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n久違地獻上的信仰心，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "已經沁入了儂的五臟六腑！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "咦！？",
    "voice": "vo_adv_5134002_020",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "咦！？",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "有誰在這裡嗎！？",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "看清楚了！",
    "voice": "vo_adv_5134002_021",
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "儂乃",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "神明是也！",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "\\n",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "由於那邊的小姑娘和少年所獻上的信仰心，",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "而得以復活！",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "什麼～！？",
    "voice": "vo_adv_5134002_022",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n那孩子",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "就是我在夢中見到的女孩，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "沒想到祂竟然是神明！？",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n雖說人不可貌相，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "但神明也一樣不可貌相呢～",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "別說是線索了，",
    "voice": "vo_adv_5134002_023",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "沒想到會直接找到本人呢。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "助手先生、",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "祈梨，",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "你們立下大功了。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……也就是說，",
    "voice": "vo_adv_5134002_024",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這傢伙在城鎮陷入危機時袖手旁觀，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n是個只會在一旁啃著烤玉米的神明對吧？",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這樣會被人遺忘也是理所當然的吧！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "咦？",
    "voice": "vo_adv_5134002_025",
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "不，",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "妳在說什麼……？",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "\\n雖然才剛見面就收到不太友善的反應，",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "\\n",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "但儂從很久以前開始",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "就只做值得被感謝的事情喔！",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "不過，",
    "voice": "vo_adv_5134002_026",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "那件事畢竟算是未來的事情嘛。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我想順便問一下，",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "所謂「值得被感謝的事情」，",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "具體來說是做些什麼事呢？",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "哼哼，",
    "voice": "vo_adv_5134002_027",
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "儂可是個體貼的神明喔。",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "\\n",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "像是西邊有個炸了成堆炸雞塊的年輕人，",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "\\n儂會悄悄幫他擠上檸檬汁……",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "在東邊舉辦的披薩派對上，儂會悄悄在披薩上放鳳梨；",
    "voice": "vo_adv_5134002_028",
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "\\n",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "在南邊的流水素麵，儂會加上櫻桃……",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "在北邊，當儂事先把烤雞串的竹籤拔掉時，",
    "voice": "vo_adv_5134002_029",
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "\\n",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "大家",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "都會感激流涕，",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "哽咽地說",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "「這到底是誰做的」……",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "呃，",
    "voice": "vo_adv_5134002_030",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "那個",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "真的是因為感謝而流下的淚水嗎……？",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我覺得實際上可能不太一樣呢～",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "祂大概",
    "voice": "vo_adv_5134002_031",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "是會帶著善意做出邪惡行為的那種神明。",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n我們還是盡快將祂制伏，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "把祂永遠封印起來比較好。",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "看來，",
    "voice": "vo_adv_5134002_032",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "祂就是那位傳說中的神明沒錯呢。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "根據書中記載，",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "即使祂擁有能與其他神明匹敵的力量，",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n卻不懂得察言觀色，",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "所做的事情總是適得其反，因而失去人們對祂的信仰。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "才、",
    "voice": "vo_adv_5134002_033",
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "才不是這樣，",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "那都是誤會！",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "\\n",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "儂這次明明也實現了小姑娘和少年的願望，",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "\\n為何非得要被那樣子批評啊！！",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "啊！",
    "voice": "vo_adv_5134002_034",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這麼說起來，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我向祢許的願望是能拿到壓歲錢吧！！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "祢一定會在元旦那天給我一大筆壓歲錢對吧！？",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "嗯？",
    "voice": "vo_adv_5134002_035",
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "一大筆？",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "\\n儂只是照著你們的願望，",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "召喚出",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "一顆",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "\\n「能一生無虞的壓碎岩」而已啊？",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……一顆？",
    "voice": "vo_adv_5134002_036",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n那個，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "祢會給我「壓歲錢」吧？",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n我是在問祢，我要到什麼時候才能變成大富翁啊。",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "不不不，",
    "voice": "vo_adv_5134002_037",
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "為何會提到變成大富翁的事？",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "\\n",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "用一顆石頭壓碎，",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "跟財富沒有關係吧？",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "祈梨、森神",
    "words": "……嗯嗯？",
    "voice": "vo_adv_5134002_038",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "……",
    "voice": "vo_adv_5134002_039",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "看來祈梨說的「壓歲錢」",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "和森神大人說的「壓碎岩」，",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n似乎不太一樣呢。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "森神大人，",
    "voice": "vo_adv_5134002_040",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "祢實際上",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "是實現了什麼樣的願望呢？",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "嗯。",
    "voice": "vo_adv_5134002_041",
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "\\n只要生物還在竭盡全力地活著，",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "\\n人生",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "就不可能沒有煩惱和憂愁。",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "感覺祢好像要發表長篇大論，",
    "voice": "vo_adv_5134002_042",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "請直接講結論就好。",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "簡單來說，",
    "voice": "vo_adv_5134002_043",
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "如果用「壓碎岩」讓大家碎碎平安，",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "\\n往後的人生便不會再有煩惱。",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "\\n",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "畢竟，",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "一切事物都在那個時間點終結了。",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……啥？",
    "voice": "vo_adv_5134002_044",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "碎碎平安？",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這傢伙",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "是在說什麼啊？",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n我完全聽不懂祂的意思耶。",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "該不會……",
    "voice": "vo_adv_5134002_045",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n那個「壓碎岩」，",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "是尺寸很大，",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "會從天上掉的東西吧？",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "嗯！",
    "voice": "vo_adv_5134002_046",
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "\\n儂認為盡可能地從高處落下，",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "就越能確實地壓碎！",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "原來如此……",
    "voice": "vo_adv_5134002_047",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這樣看來，",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "就有結論了。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "助手先生，",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "你有搞清楚這件事了嗎？",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "難道……",
    "voice": "vo_adv_5134002_048",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "祂誤以為「壓歲錢」是",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "讓巨大隕石砸下來的",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n「壓碎岩」嗎！？",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "怎麼可能有人會這樣亂解釋啊……！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……不，",
    "voice": "vo_adv_5134002_049",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "偏偏身邊就有這樣一個人。",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "而且還是個會帶著明確的惡意去做的老太婆。",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "就算如此，",
    "voice": "vo_adv_5134002_050",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這的確是個很罕見的誤會。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "就結論而言，",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "可以說元凶就是祈梨許的願望吧？",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "等等，",
    "voice": "vo_adv_5134002_051",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "妳那樣子總結的話，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不就變成是我的錯了嗎！！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "既然是祢自己誤會我的意思，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那就快點想辦法解決啊！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "可是不會負這種責的──！！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "……也就是說，",
    "voice": "vo_adv_5134002_052",
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "\\n那個，",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "不好意思，",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "難道",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "儂誤解了妳的願望嗎？",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "\\n",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "儂從以前",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "就常被提醒，在採取行動之前要先跟人討論過。",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "祢從頭到尾、",
    "voice": "vo_adv_5134002_053",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "徹徹底底地都搞錯了啊！！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "要是蘭德索爾毀滅了，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我是要去哪裡花我的壓歲錢啊～！！",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "對對對、",
    "voice": "vo_adv_5134002_054",
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "對不起～！？",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "……所以說，",
    "voice": "vo_adv_5134002_055",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n「壓歲錢」指的是",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "在新年時發錢給小孩子的習俗，",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n並非指「掉下來壓碎東西的石頭」。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "唔……",
    "voice": "vo_adv_5134002_056",
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "嗚嗚……！",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "\\n",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "儂真的，",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "沒有任何的惡意……！",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "\\n",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "儂只是不知道最近的流行……",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "壓歲錢也不是什麼流行啊。",
    "voice": "vo_adv_5134002_057",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "為什麼連小孩子都知道的事情，祢這神明卻不知道？",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我覺得祂是真的",
    "voice": "vo_adv_5134002_058",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "不知道壓歲錢這個概念。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "畢竟祂是在幾百年前，",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "由極少部分的精靈族所供奉的神明。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n那時候可能還沒有任何貨幣經濟的概念。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "在過去，",
    "voice": "vo_adv_5134002_059",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "也是有單靠以物易物的方式就能存活的村莊。",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "如果沒有錢的話，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "自然也就沒有壓歲錢的習俗呢……",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "但是，",
    "voice": "vo_adv_5134002_060",
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "如果儂說了不知道的話，",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "儂怕會被當作鄉巴佬……",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "\\n",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "而且儂以為",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "她是想從根本上擺脫這一生的痛苦……",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嗯──",
    "voice": "vo_adv_5134002_061",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "好厲害喔～",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n聽了祢這一番話，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我就覺得",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "祢真的是神明呢～",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這根本就是漫畫中出現的魔王會有的想法好嗎。",
    "voice": "vo_adv_5134002_062",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "連我家老大都不太會做到這種地步了。",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "嗚嗚……",
    "voice": "vo_adv_5134002_063",
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "\\n真的非常抱歉……",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "\\n",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "這一切，",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "都是儂貿然行事，是儂的責任……",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "嗯？",
    "voice": "vo_adv_5134002_064",
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "為什麼你要道歉呢？",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "小哥你沒有錯！",
    "voice": "vo_adv_5134002_065",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不然的話，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "感覺就連我都要\\n被追究責任了，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "所以就先這樣吧。",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "那麼，",
    "voice": "vo_adv_5134002_066",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "就不要再怪罪於誰了吧！",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n森神大人也是，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "就算會感到羞愧，不懂的時候還是要提問才行。",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "接下來",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "大家就再多注意一點吧──！",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "雖然很感謝妳提供了很有意義的建議，",
    "voice": "vo_adv_5134002_067",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n但再這樣下去，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我就只能到下輩子再實踐了。",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嗯，",
    "voice": "vo_adv_5134002_068",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "說得也是！",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n首先要想辦法處理隕石的事情才行。",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "既然祢能夠召喚隕石出來，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "應該也能取消吧？",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "不，",
    "voice": "vo_adv_5134002_069",
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "那種事儂辦不到……",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "\\n",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "由於儂的「實現願望之力」很強大，",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "\\n",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "一旦發動後，",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "便無法收回。",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那麼，就把這傢伙交給【王宮騎士團】，",
    "voice": "vo_adv_5134002_070",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n再叫鎮上居民去避難就可以了吧。",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n只要有證人的話，他們應該就會聽我們說話了？",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嗯……",
    "voice": "vo_adv_5134002_071",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "他們會聽進去森神大人說的話嗎？",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "光是我的預知夢，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "感覺都很難讓他們相信了……",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "老實說，",
    "voice": "vo_adv_5134002_072",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "我覺得有困難。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這極有可能",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "會被他們當成荒誕無稽的虛構故事。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "更何況，",
    "voice": "vo_adv_5134002_073",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "現在是年底。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n【王宮騎士團】都在四處\\n巡邏戒備，",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "應該正處於人手不足的狀態呢。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "得想其他的對策才行～",
    "voice": "vo_adv_5134002_074",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n用超能……",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "用超☆魔法也無法破壞它，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n如果用祈梨的龍人力量試試看呢？",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "就算是超厲害的龍人族，",
    "voice": "vo_adv_5134002_075",
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "對於毫無辦法的事情也是沒有辦法的。",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "光聽妳的描述就知道，那隕石非常大顆，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "反而是我會被壓扁。",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "就算我向它噴火，",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "也起不了什麼作用──",
    "voice": null,
    "unit_id": 128311
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "這麼說也是～",
    "voice": "vo_adv_5134002_076",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嗯～",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "該怎麼辦呢……？",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "森神大人，",
    "voice": "vo_adv_5134002_077",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n如果無法取消願望的話，",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n那麼",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "有可能追加實現其他的願望嗎？",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "嗯，",
    "voice": "vo_adv_5134002_078",
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "若是這樣的話就可以喔。",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "\\n",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "在迎接新年之前，",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "還可以實現",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "兩個願望。",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "咦，",
    "voice": "vo_adv_5134002_079",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "真的嗎？",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n話說回來，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "期限和次數還滿明確的呢。",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "書上說，",
    "voice": "vo_adv_5134002_080",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "在森神大人的信仰中，",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "藉由奉獻祈願，",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n該年就能夠獲得三個恩惠的樣子。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "這裡所說的",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "恩惠，",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "應該就是指實現願望這件事吧？",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "正是如此。",
    "voice": "vo_adv_5134002_081",
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "\\n",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "但是，",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "就算後面能再許願，",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "森神",
    "words": "\\n也無法撤銷已經許過的願望。",
    "voice": null,
    "unit_id": 5413
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "果然不能那樣用啊……",
    "voice": "vo_adv_5134002_082",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "我才剛想到這個方法呢。",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "不用想得那麼複雜，",
    "voice": "vo_adv_5134002_083",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n許更簡單的願望就好了吧？",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "嗯？",
    "voice": "vo_adv_5134002_084",
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n小霞，",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "妳說的是什麼意思？",
    "voice": null,
    "unit_id": 128411
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "既然無法讓隕石消失，",
    "voice": "vo_adv_5134002_085",
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "那就直接迎擊它就好。",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "\\n",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "用剩下的兩個願望，",
    "voice": null,
    "unit_id": 128511
  },
  {
    "type": "dialogue",
    "name": "霞",
    "words": "在隕石落下來之前破壞掉它！",
    "voice": null,
    "unit_id": 128511
  }
]
