  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在夜晚的海邊，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "普蕾西亞正抬頭看著天空──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "普蕾西亞，",
    "voice": "vo_adv_9012001_000",
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "原來妳在這裡呀。",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "嗯。",
    "voice": "vo_adv_9012001_001",
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n天空。",
    "voice": null,
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "星星。",
    "voice": null,
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "呵呵。",
    "voice": "vo_adv_9012001_002",
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n星星，",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "非常漂亮呢。",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n感覺好浪漫……♪",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "嗯。",
    "voice": "vo_adv_9012001_003",
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n流口水。",
    "voice": null,
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "流、",
    "voice": "vo_adv_9012001_004",
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "流口水……？",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n妳、",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "妳的意思是……？",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "啊，",
    "voice": "vo_adv_9012001_005",
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "確實♪",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n星星長得",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "很像糖果和金平糖呢♪",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "原來如此。",
    "voice": "vo_adv_9012001_006",
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "普蕾西亞的感性，",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "真是厲害──",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "啊！",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n剛剛閃過的光芒，",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "是……",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "流星嗎？",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "這正是流星趕月，",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "可謂是風流韻事……",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "莉莉，妳知道嗎？",
    "voice": "vo_adv_9012001_007",
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n在流星落下前",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "將願望唸三遍的話，",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "就會實現哦。",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "這是以前奶奶教我的。",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "但是──",
    "voice": "vo_adv_9012001_008",
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "流星在一瞬間就會消失呢。",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "比眨眼還要短暫的剎那……",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "別說唸出來，",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "就連開口都來不及……",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "而且，",
    "voice": "vo_adv_9012001_009",
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "對我來說，",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "就連要許什麼願望，",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "都無法選擇。",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n因為想實現的願望、",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "希望被實現的願望",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "太多了……",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "莉莉妳真是的，",
    "voice": "vo_adv_9012001_010",
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "太認真了啦♪",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "只要把腦中瞬間浮現的願望說出來就好了，",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "輕鬆一點輕鬆一點。",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "嗯。",
    "voice": "vo_adv_9012001_011",
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "很多很多，",
    "voice": null,
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n金平糖。",
    "voice": null,
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "之類的？",
    "voice": null,
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "啊，",
    "voice": "vo_adv_9012001_012",
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "這個不錯呢♪",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n雖然流星劃過後就會消失，",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n但是肯定",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "會有很多金平糖堆在沙灘上。",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "好甜，",
    "voice": "vo_adv_9012001_013",
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "好好吃。",
    "voice": null,
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n沙子。",
    "voice": null,
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n好漂亮。",
    "voice": null,
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "呵呵，",
    "voice": "vo_adv_9012001_014",
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "但是吃太多甜食",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "可不好。",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n也別忘記要刷牙喔？",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "了解。",
    "voice": "vo_adv_9012001_015",
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n那，",
    "voice": null,
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "下一個。",
    "voice": null,
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n願望。",
    "voice": null,
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "莉莉。",
    "voice": null,
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "好的，",
    "voice": "vo_adv_9012001_016",
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "普蕾西亞。",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n那麼恕我冒昧，",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "我也來──",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "願望……",
    "voice": "vo_adv_9012001_017",
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "雖然真的有很多。",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "但希望總有一天，",
    "voice": "vo_adv_9012001_018",
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "能將我們該做的事情，",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n好好地",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "完成。",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "在那之前……",
    "voice": "vo_adv_9012001_019",
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "希望與兄長大人、",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "璃亞",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "以及普蕾西亞，",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n一起冒險──",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "……呼。",
    "voice": "vo_adv_9012001_020",
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "璃亞，",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "妳也許願了嗎？",
    "voice": null,
    "unit_id": 131611
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "呵呵。",
    "voice": "vo_adv_9012001_021",
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "\\n我的願望──",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "肯定跟莉莉",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "可璃亞",
    "words": "是一樣的哦。",
    "voice": null,
    "unit_id": 135311
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "嗯。",
    "voice": "vo_adv_9012001_022",
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "普蕾西亞",
    "words": "\\n一樣。",
    "voice": null,
    "unit_id": 135211
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "少女們的願望，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "靜悄悄地融入了流星劃過的夜空中。",
    "voice": null,
    "unit_id": null
  }
]
