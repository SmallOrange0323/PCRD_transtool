    "words": "\\n",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "會變成比上次……",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
