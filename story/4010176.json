    "type": "dialogue",
    "name": "千歌",
    "words": "這是",
    "voice": "vo_adv_4010176_002",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "演唱會的門票？",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n因為我之前邀請過你……？",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "啊……",
    "voice": "vo_adv_4010176_003",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是指聖誕節那時候",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是嗎。",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "你還記得啊……",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是的，",
    "voice": "vo_adv_4010176_004",
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "那天我也很開心……",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n原來你",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "也有同樣感受啊。",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "呵呵……",
