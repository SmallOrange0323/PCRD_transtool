    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "今天的計劃",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "「全包在我身上」……",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "\\n我可以請問",
    "voice": null,
    "unit_id": 104232
  },
  {
    "type": "dialogue",
    "name": "千歌",
    "words": "是要做什麼嗎？",
