    "words": "\\n",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "香甜入口即化、",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "蓬鬆柔軟的口感……",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "舌頭和心",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "都要融化了……",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "弟弟的味道，",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我好好享受到了……♪",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我也有做過",
    "voice": "vo_adv_5213073_001",
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "重現弟弟模樣的",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "可麗餅。",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "但能把弟弟的魅力還原到這種程度……",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "如果沒有用極深的愛去觀察弟弟，",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "是不可能達到這種境界的！",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "沒想到你對弟弟的了解如此深刻，",
    "voice": "vo_adv_5213073_002",
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "看來萊拉耶爾小姐也……",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "咦……？",
    "voice": "vo_adv_5213073_003",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "不、",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "不是，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我並沒有那樣……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n騎士只是",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "重要的客人而已，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "\\n",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "我並沒有對他抱持特別的感情，",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "絕、",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "絕對沒有……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "萊拉耶爾小姐也",
    "voice": "vo_adv_5213073_004",
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "想當弟弟的",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "姐姐呢！",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "…………",
    "voice": "vo_adv_5213073_005",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "姐姐？",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "確實這個蛋糕，",
    "voice": "vo_adv_5213073_006",
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "充滿了姐姐之力……",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "但",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "身為弟弟的永久終身榮譽殿堂級姐姐，",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n我也不能這麼輕易就認定別人是姐姐。",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "抱歉了！",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "啊，",
    "voice": "vo_adv_5213073_007",
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "不過，",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "在我和璃乃之間！",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n如果是「次女」的位置",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "是可以的喔。",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我們姐妹一起把弟弟夾在中間，",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "好好地寵愛他吧♪",
    "voice": null,
    "unit_id": 104914
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "那、",
    "voice": "vo_adv_5213073_008",
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "那個……",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "那、",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "那我就恭敬地",
    "voice": null,
    "unit_id": 126511
  },
  {
    "type": "dialogue",
    "name": "萊拉耶爾",
    "words": "接受了……？",
    "voice": null,
    "unit_id": 126511
  }
]
