    "name": "惠理子",
    "words": "噓！",
    "voice": "vo_adv_5142006_017",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "這是用來奪走魔物視力的藥物。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n發出聲音的話會被發現，",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "所以安靜點……！",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n趁現在開始撤離吧。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "background",
    "bg_id": "500214"
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "呼～！",
    "voice": "vo_adv_5142006_018",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n總算是成功脫逃了呢！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "喬",
    "words": "原本還很擔心會變成怎樣呢～！",
    "voice": "vo_adv_5142006_019",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "喬",
    "words": "\\n真不愧是惠理子教官～！！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "不要發出那麼大的聲音。",
    "voice": "vo_adv_5142006_020",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n那隻魔物",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "似乎有著不錯的聽覺，",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "要是你們太吵又會被發現喔？",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "喬",
    "words": "呃啊，",
    "voice": "vo_adv_5142006_021",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "喬",
    "words": "我可不想再被追了……！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "就、",
    "voice": "vo_adv_5142006_022",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "就是說啊……",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "那麼，",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "惠理子，",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "要怎麼做呢？",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n這件事情，",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "妳要去報告嗎？",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "現在應該還沒有人察覺到這場騷動，",
    "voice": "vo_adv_5142006_023",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n保密不提也是個方法喔。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "這個嘛……",
    "voice": "vo_adv_5142006_024",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "不管提不提都無所謂呢。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n畢竟結果似乎已經出爐了。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "咦……？",
    "voice": "vo_adv_5142006_025",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "其他班的新兵1",
    "words": "我已經狩獵10隻了喔！",
    "voice": "vo_adv_5142006_026",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "其他班的新兵1",
    "words": "\\n我應該是第一名吧～？",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "其他班的新兵2",
    "words": "那算什麼！",
    "voice": "vo_adv_5142006_027",
    "unit_id": 717
  },
  {
    "type": "dialogue",
    "name": "其他班的新兵2",
    "words": "我可是12隻！",
    "voice": null,
    "unit_id": 717
  },
  {
    "type": "dialogue",
    "name": "其他班的新兵2",
    "words": "\\n勳章就由我收下了！",
    "voice": null,
    "unit_id": 717
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "……這樣啊，",
    "voice": "vo_adv_5142006_028",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "原來如此。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "也是呢……",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "好像完全被拉開差距了。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "弗萊迪",
    "words": "嗚",
    "voice": "vo_adv_5142006_029",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "弗萊迪",
    "words": "嗚……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "弗萊迪",
    "words": "對不起，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "弗萊迪",
    "words": "惠理子教官，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "弗萊迪",
    "words": "\\n還有",
