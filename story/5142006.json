    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "喬",
    "words": "不過，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "喬",
    "words": "已經很難再逃跑了……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "喬",
    "words": "\\n快要被追上了……！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "路克",
    "words": "是啊……！",
    "voice": "vo_adv_5142006_011",
    "unit_id": 717
  },
  {
    "type": "dialogue",
    "name": "路克",
    "words": "我的體力",
    "voice": null,
    "unit_id": 717
  },
  {
    "type": "dialogue",
    "name": "路克",
    "words": "也已經",
    "voice": null,
    "unit_id": 717
  },
  {
    "type": "dialogue",
    "name": "路克",
    "words": "到極限了……！",
    "voice": null,
    "unit_id": 717
  },
  {
    "type": "dialogue",
    "name": "路克",
    "words": "\\n要是再被猛撞攻擊一次的話──",
    "voice": null,
    "unit_id": 717
  },
  {
    "type": "dialogue",
    "name": "北方森林的魔物",
    "words": "──嘎喔喔喔喔喔！",
