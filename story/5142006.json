  },
  {
    "type": "dialogue",
    "name": "弗萊迪",
    "words": "\\n對、",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "弗萊迪",
    "words": "對不起，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "弗萊迪",
    "words": "我……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "藉口之後再說。",
    "voice": "vo_adv_5142006_005",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "比起這個，",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我現在在問你沒事嗎？",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "弗萊迪",
    "words": "是、",
    "voice": "vo_adv_5142006_006",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "弗萊迪",
    "words": "是的……！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "弗萊迪",
    "words": "\\n多虧有喬和路克來幫忙，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "弗萊迪",
    "words": "總算把魔物給甩掉了……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "弗萊迪",
    "words": "是他們兩個幫忙引走魔物的。",
    "voice": "vo_adv_5142006_007",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "弗萊迪",
    "words": "\\n我跟他們說找到救援後一定會回來……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "弗萊迪",
    "words": "就一路跑到這裡了。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "弗萊迪",
    "words": "\\n是在這個方向！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "北方森林的魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 18311
  },
  {
    "type": "dialogue",
    "name": "喬",
    "words": "嗚哇啊啊！？",
    "voice": "vo_adv_5142006_008",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "路克",
    "words": "你沒事吧，喬！",
    "voice": "vo_adv_5142006_009",
    "unit_id": 717
  },
  {
    "type": "dialogue",
    "name": "喬",
    "words": "沒、",
    "voice": "vo_adv_5142006_010",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "喬",
    "words": "沒事……",
