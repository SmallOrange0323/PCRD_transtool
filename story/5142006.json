    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "弗萊迪",
    "words": "大家……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "道歉也不會改變事實。",
    "voice": "vo_adv_5142006_030",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "現在就慶幸你保住了小命吧。",
