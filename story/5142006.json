    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "喬",
    "words": "好的！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "沒錯，",
    "voice": "vo_adv_5142006_015",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "這樣就好……！",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "剩下的就由我──！",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "北方森林的魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 18311
  },
  {
    "type": "dialogue",
    "name": "路克",
    "words": "惠、",
    "voice": "vo_adv_5142006_016",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "路克",
    "words": "惠理子",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "路克",
    "words": "教官……？",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "路克",
    "words": "這些煙是……",
