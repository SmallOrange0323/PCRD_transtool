    "words": "這附近的魔物似乎已經被一掃而空了。",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "教官",
    "words": "\\n這是你們首次立下的功勞！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "教官",
    "words": "為勝利歡呼吧！！",
    "voice": null,
    "unit_id": 712
  },
  {
    "type": "dialogue",
    "name": "新兵們",
    "words": "喔喔喔喔喔！！！！",
    "voice": "vo_adv_5142006_032",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "唉呀……",
    "voice": "vo_adv_5142006_033",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "結束了呢。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "看樣子受到表揚的應該會是其他班的傢伙。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "……",
    "voice": "vo_adv_5142006_034",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "這下不妙了。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "咦？",
    "voice": "vo_adv_5142006_035",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "妳是指什麼？",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我剛才也說過了吧？",
    "voice": "vo_adv_5142006_036",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n那隻魔物……",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "聽覺很敏銳。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n要是現在發出那麼大的聲音……",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "北方森林的魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 18311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "什麼！？",
    "voice": "vo_adv_5142006_037",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "牠果然",
    "voice": "vo_adv_5142006_038",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "在對聲音做出反應，",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n應該會朝傳出歡呼聲的方向過去吧。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "索菲",
    "words": "怎、",
    "voice": "vo_adv_5142006_039",
    "unit_id": 717
  },
  {
    "type": "dialogue",
    "name": "索菲",
    "words": "怎麼這樣……！？",
    "voice": null,
    "unit_id": 717
  },
  {
    "type": "dialogue",
    "name": "路克",
    "words": "教官，",
    "voice": "vo_adv_5142006_040",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "路克",
    "words": "我們該怎麼辦……？",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "路克",
    "words": "\\n牠要是就這樣撞向其他班的人，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "路克",
    "words": "事情就不得了了……！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "是啊。",
    "voice": "vo_adv_5142006_041",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "而且，",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "牠要是突破新兵們的阻擋，",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n附近的村莊也會有危險吧……",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "那、",
    "voice": "vo_adv_5142006_042",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "那可就糟了！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我們得想辦法應付才行！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "……",
    "voice": "vo_adv_5142006_043",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "把牠引誘到其他地方吧。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "弗萊迪",
    "words": "咦？",
    "voice": "vo_adv_5142006_044",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "弗萊迪",
    "words": "惠理子教官……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "弗萊迪",
    "words": "\\n您的意思是……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "沒錯，",
    "voice": "vo_adv_5142006_045",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "就由我們來打倒牠。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "索菲",
    "words": "由、",
    "voice": "vo_adv_5142006_046",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "索菲",
    "words": "由我們，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "索菲",
    "words": "來打倒那麼強",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "索菲",
    "words": "的魔物嗎？",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "索菲",
    "words": "\\n雖然說有教官們在，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "索菲",
    "words": "但還是很困難吧……？",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "是啊，",
    "voice": "vo_adv_5142006_047",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "那樣的魔物，",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "光憑我一人恐怕無法招架。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "但是……",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "戰鬥的基礎",
    "voice": "vo_adv_5142006_048",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "是以多對一……",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "沒錯吧？",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "！",
    "voice": "vo_adv_5142006_049",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "惠理子……！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "……嘿嘿。",
    "voice": "vo_adv_5142006_050",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "妳也開始明白了嘛！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "沒錯，",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "對方只有一隻，",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n而我們有這麼多人！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "就來打倒牠吧……！",
    "voice": "vo_adv_5142006_051",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n我們馬上來思考作戰計畫！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "這樣的話，",
    "voice": "vo_adv_5142006_052",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我有一個計策。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我後方",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "有個陡峭的下坡，",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n而對方的眼睛",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "現在看不見……",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "所以大家",
    "voice": "vo_adv_5142006_053",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "就躲藏在斜坡下。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n然後由當誘餌的人，",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "負責把那傢伙引誘到我們潛伏的地點。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "趁牠沒注意到陡坡使得身體失去平衡時，",
    "voice": "vo_adv_5142006_054",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n所有人一起攻擊牠……",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "怎麼樣？",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "啊啊，",
    "voice": "vo_adv_5142006_055",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我覺得這個作戰很好。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "但是……",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "要由誰來當誘餌──",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "弗萊迪",
    "words": "……",
    "voice": "vo_adv_5142006_056",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "弗萊迪",
    "words": "請讓我",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "弗萊迪",
    "words": "來當誘餌吧。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "索菲",
    "words": "咦……",
    "voice": "vo_adv_5142006_057",
    "unit_id": 717
  },
  {
    "type": "dialogue",
    "name": "索菲",
    "words": "弗萊迪！？",
    "voice": null,
    "unit_id": 717
  },
  {
    "type": "dialogue",
    "name": "索菲",
    "words": "\\n騙人的吧，",
    "voice": null,
    "unit_id": 717
  },
  {
    "type": "dialogue",
    "name": "索菲",
    "words": "你都受傷了……",
    "voice": null,
    "unit_id": 717
  },
  {
    "type": "dialogue",
    "name": "弗萊迪",
    "words": "沒問題，",
    "voice": "vo_adv_5142006_058",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "弗萊迪",
    "words": "剛才是你們救了我，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "弗萊迪",
    "words": "這次該輪到我努力了。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "弗萊迪",
    "words": "\\n而且，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "弗萊迪",
    "words": "那傢伙之所以會生氣，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "弗萊迪",
    "words": "是因為我闖入了牠的地盤。",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "弗萊迪",
    "words": "\\n請給我挽回的機會吧……",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "弗萊迪",
    "words": "教官！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "……",
    "voice": "vo_adv_5142006_059",
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我明白了。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n這就是最後的",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "長跑訓練了。",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n使盡全力奔跑吧，",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我可不准你……",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "偷懶喔？",
    "voice": null,
    "unit_id": 129911
  },
  {
    "type": "dialogue",
    "name": "弗萊迪",
    "words": "是！",
    "voice": "vo_adv_5142006_060",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "弗萊迪",
    "words": "Yes！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "北方森林的魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 18311
  },
  {
    "type": "dialogue",
    "name": "弗萊迪",
    "words": "喂！",
    "voice": "vo_adv_5142006_061",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "弗萊迪",
    "words": "魔物──！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "弗萊迪",
    "words": "我在這裡──！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "北方森林的魔物",
    "words": "！？",
    "voice": null,
    "unit_id": 18311
  },
  {
    "type": "dialogue",
    "name": "弗萊迪",
    "words": "快過來啊！",
    "voice": "vo_adv_5142006_062",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "弗萊迪",
    "words": "我就是在你地盤搗亂的罪魁禍首！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "弗萊迪",
    "words": "\\n不、",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "弗萊迪",
    "words": "不來追我沒關係嗎！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "北方森林的魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 18311
  },
  {
    "type": "dialogue",
    "name": "弗萊迪",
    "words": "噫！？",
    "voice": "vo_adv_5142006_063",
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "弗萊迪",
    "words": "追來了！",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "弗萊迪",
    "words": "\\n不對，",
    "voice": null,
    "unit_id": 711
  },
  {
    "type": "dialogue",
    "name": "弗萊迪",
