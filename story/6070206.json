    "voice": "vo_adv_6054206_003",
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "\\n鍛えられたしね！　",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "……とは言っても、",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "\\n今回は負けちゃったし、",
    "voice": null,
    "unit_id": 114511
  },
  {
