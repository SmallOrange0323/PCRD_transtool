    "voice": "vo_adv_6054206_001",
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "子供たちに伝えておくわ。",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "\\nとっても喜ぶと思う。",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "\\n",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "その時は、",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "あたしも参加しようかしら！",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "覚えてたんだ。",
    "voice": "vo_adv_6054206_002",
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "\\n",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "二人だけなのに、",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "雪投げに夢中になって、",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "最後は汗だくになってたわね。",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "\\n",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "……あんたとの記憶は全部、",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
    "words": "そんなキラキラした思い出ばかり。",
    "voice": null,
    "unit_id": 114511
  },
  {
    "type": "dialogue",
    "name": "サレン",
