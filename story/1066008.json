    "name": "祈梨",
    "words": "唔～嗯，",
    "voice": "vo_adv_1066008_047",
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "話說回來，",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "「龍膽掃帚」老師",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n究竟是個怎麼樣的人呢……",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "她一定是個",
    "voice": "vo_adv_1066008_048",
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "很會照顧別人、既溫柔又美麗的人……",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n肯定和那個給了我龍人角色，",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "總是嘻嘻笑的奇怪阿姨差很多！",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "嗯？",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這個未公開內容裡的……",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "是誰啊，",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這個小不點。",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "「這是我疼愛的孩子的肖像畫喔～",
    "voice": "vo_adv_1066008_049",
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n她有些傻乎乎的，",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "讓人無法置之不理呢♪",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n雖然現在和我還不太親近，不過那正是她的可愛之處～」",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "唔～！",
    "voice": "vo_adv_1066008_050",
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這傢伙也太不知感恩了吧！",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n光是能被「龍膽掃帚」老師關心",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n就已經夠讓人羨慕了！",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "她怎麼可以如此無禮！",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "啊啊～",
    "voice": "vo_adv_1066008_051",
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "好嫉妒喔～！",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n我身邊就只有那個總是嘻嘻笑的阿姨啊！",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "但是，",
    "voice": "vo_adv_1066008_052",
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我才不會認輸呢！",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n我要用那個阿姨給我的龍人角色向上爬……",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "成為阿斯特朗裡的大人物，",
    "voice": "vo_adv_1066008_053",
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n和「龍膽掃帚」老師見面！",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好了，",
    "voice": "vo_adv_1066008_054",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "辛苦囉。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你只要和祈梨待在一起\\n就總是會被捲入麻煩中呢……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "還有，那個插畫日記裡出現的孩子，",
    "voice": "vo_adv_1066008_055",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n你不覺得很眼熟嗎？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這種情況",
    "voice": "vo_adv_1066008_056",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "就叫做當局者迷吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n自己嫉妒自己什麼的，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "總覺得還真是不可思議呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "嗯──",
    "voice": "vo_adv_1066008_057",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "不過這個情況是兩個人彼此都沒有發現？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n或者說對方早就知道了……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好像可以來稍微調查看看呢……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "啊，",
    "voice": "vo_adv_1066008_058",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "這只是我自說自話，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你不需要在意喔。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "話說回來，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你要好好照顧祈梨喔？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "她本人大概不太清楚自己的力量是怎麼來的，",
    "voice": "vo_adv_1066008_059",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n也不太了解什麼是覺醒……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你要看好她，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "別讓她的力量失控了喔。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "……是說，",
    "voice": "vo_adv_1066008_060",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "該不會連這件事也全都在那個人的計算之中吧……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "算了，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "想這麼多也沒有用呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "你就做好你力所能及的事吧。",
    "voice": "vo_adv_1066008_061",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "可以吧？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n那麼就這樣囉。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "掰掰。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500891"
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "小哥，",
    "voice": "vo_adv_1066008_062",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "小～哥！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "你終於醒了啊。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n你又在這種地方睡著了喔……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "話說回來，",
    "voice": "vo_adv_1066008_063",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我又做了個奇怪的夢呢……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "啊，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "小哥也是嗎？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我在夢中好像在買什麼東西……",
    "voice": "vo_adv_1066008_064",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "啊，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "差點忘了！！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "正想說哪裡怪怪的……",
    "voice": "vo_adv_1066008_065",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我想起來了啦！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n今天是……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "慈樂之音全新寫真集的發售日！",
    "voice": "vo_adv_1066008_066",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我怎麼會忘記這麼重要的事情！！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n要是現在不趕快去買",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "就要賣完了啦！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "正好我手上有錢……",
    "voice": "vo_adv_1066008_067",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "嗚嗚嗚，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "但是這些錢",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "是要用來請小哥吃飯的預算……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "唔，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "嗚嗚……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我、",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "能、",
    "voice": "vo_adv_1066008_068",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "能克制物欲才稱得上是幫派分子……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n這種時候就只能含淚……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "欸？",
    "voice": "vo_adv_1066008_069",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "小哥要買寫真集給我嗎？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不過，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "反正小哥打工賺到的錢也不多吧……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "什麼，",
    "voice": "vo_adv_1066008_070",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這次竟然有大鈔！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n有這麼多錢的話的確是買得起寫真集啦……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n但真的可以嗎？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "小哥……",
    "voice": "vo_adv_1066008_071",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "既、",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "既然如此",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我就老實地接受吧！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n小哥的心意，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我收下囉！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "好、",
    "voice": "vo_adv_1066008_072",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "好吧……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "既然你都這麼說了……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "看在小哥的面子上，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我會心懷感激地收下的。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "哎呀，",
    "voice": "vo_adv_1066008_073",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "現在可不是說這種話的時候！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n要趕快在賣完之前搶到寫真集！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "在那之後，我會請你吃到撐的，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "要跑起來了喔！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "出發囉……",
    "voice": "vo_adv_1066008_074",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "全力衝刺！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "祈梨和{0}兩個人，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在夕陽餘暉之中全力地向前衝刺著。",
    "voice": null,
    "unit_id": null
  }
]
