    "voice": "vo_adv_1066008_034",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "\\n打擾正在物色同人誌的人",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "可是很失禮的喔？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "小哥要好好反省喔，",
    "voice": "vo_adv_1066008_035",
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "真是的……",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "咦，",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我也要道歉嗎！？",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106631
  },
  {
