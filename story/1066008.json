    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "阿斯特朗冒險日記》",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n可是很健全的讀物喔。",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "你看！",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "still",
    "still_id": "106600801"
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "啊──",
    "voice": "vo_adv_1066008_040",
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我終於買到了！",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n在這個年代裡，沒有在任何活動中販售，",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "甚至連電子版書籍都沒有！",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n這種只透過寄售的同人誌，",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "可是非常稀有的喔。",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
