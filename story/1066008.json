    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "小哥害我臉丟大了啦！",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n我再也不敢去那間店了！",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "啊嗚嗚……",
