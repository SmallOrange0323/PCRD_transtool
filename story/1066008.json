[
  {
    "type": "background",
    "bg_id": "500890"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在蘭德索爾的巷弄中走著的{0}，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n被一個充滿朝氣的叫喚聲攔了下來。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "小哥！",
    "voice": "vo_adv_1066008_000",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我找你好久了！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "真是的，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "既然你一直都很閒的話，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n就不能在更好找的地方閒晃嗎！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "哎呀呀，",
    "voice": "vo_adv_1066008_001",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "對了。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "哼哼哼……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "你就儘管搖著尾巴高興吧，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "小哥！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n我今天啊……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "要來請你吃飯！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我之前在火山那裡覺醒，",
    "voice": "vo_adv_1066008_002",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n為了保護小哥，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "就把魔物揍一頓扔出去、",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "再揍一頓再扔出去的事情，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n你應該還記得吧？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我有啦！",
    "voice": "vo_adv_1066008_003",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "哼哼哼，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "雖然我一擊就把它解決掉，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n所以沒有揍也沒有扔就是了！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "沒錯沒錯！",
    "voice": "vo_adv_1066008_004",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不愧是小哥！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n理解力真快，讓我省了不少麻煩。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……不過，",
    "voice": "vo_adv_1066008_005",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那個覺醒實際上和嘉夜夜的一樣，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n好像都不算是真正的覺醒……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我把當時為保護小哥而戰的事，",
    "voice": "vo_adv_1066008_006",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "告訴老大和嘉夜夜之後，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n她們竟然給了我薪水和零用錢喔。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "欸嘿嘿嘿……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……但是，",
    "voice": "vo_adv_1066008_007",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "扣掉之前不小心亂買東西花的錢，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n現在應該已經所剩無幾了……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不過，能拿到錢",
    "voice": "vo_adv_1066008_008",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "多少也有一點點",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "是因為小哥的關係，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n所以今天就由我來請客！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "作為幫派分子，",
    "voice": "vo_adv_1066008_009",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "可不能做出把錢留到隔天這種丟臉的行為！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "來吧，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "要把錢一口氣花光光！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n這就是我",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "邁向幫派之路的第一步！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "小哥，",
    "voice": "vo_adv_1066008_010",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我知道你很高興，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "但也不至於高興到發光……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "光？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "小、",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "小哥！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n怎麼好像",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "又在發光……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "了……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "background",
    "bg_id": "510370"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "來到動漫商店的{0}，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n看見了一個熟悉的身影。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那、",
    "voice": "vo_adv_1066008_011",
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那個……",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "有什麼事嗎……",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n為什麼從剛剛開始就一直盯著我看……",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n你再這樣下去我要叫人了……",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "咦？",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……啥？",
    "voice": "vo_adv_1066008_012",
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "什麼最強的阿斯特朗玩家祈梨，",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n我不認識那種人喔～？",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n話說回來，",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "小哥你是哪位啊～？",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……我不認識那個人耶……",
    "voice": "vo_adv_1066008_013",
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n你、",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "你認錯人了喔？",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "動畫店員",
    "words": "這位客人？",
    "voice": "vo_adv_1066008_014",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "動畫店員",
    "words": "請問發生什麼事了嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "噫呀？",
    "voice": "vo_adv_1066008_015",
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "咦，",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那個……",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "那個男生，",
    "voice": "vo_adv_1066008_016",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "好像不認識這個女孩子，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "卻一直纏著她……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "動畫店員",
    "words": "您沒事吧，",
    "voice": "vo_adv_1066008_017",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "動畫店員",
    "words": "客人。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "動畫店員",
    "words": "\\n……請不要在我們店裡搭訕。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "咦？",
    "voice": "vo_adv_1066008_018",
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這、",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這個……",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那個……",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "好像有很多人誤以為，",
    "voice": "vo_adv_1066008_019",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "會出現在這種店裡的人，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "\\n都是些很好騙到手的宅宅呢！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "事事事、",
    "voice": "vo_adv_1066008_020",
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "事情不是這樣的……",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "動畫店員",
    "words": "你要是再纏著她的話，",
    "voice": "vo_adv_1066008_021",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "動畫店員",
    "words": "我就叫警察來了喔？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "咦咦咦！？",
    "voice": "vo_adv_1066008_022",
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這、",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這樣我會很困擾……",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "別擔心，",
    "voice": "vo_adv_1066008_023",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "我們都站在妳這邊！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "\\n束手就擒吧，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "搭訕男！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "雖然的確是誤會沒錯，",
    "voice": "vo_adv_1066008_024",
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "但在這種情況下也很難說清楚……",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "動畫店員",
    "words": "竟然還向那個女孩子搭話！",
    "voice": "vo_adv_1066008_025",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "動畫店員",
    "words": "看來你是講不聽呢。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "就、",
    "voice": "vo_adv_1066008_026",
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "就算你這樣看著我，我也沒辦法啦小哥……",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "竟然還擅自叫了那個女孩子的名字！",
    "voice": "vo_adv_1066008_027",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "\\n真是讓人看不下去了！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "動畫店員",
    "words": "店長！",
    "voice": "vo_adv_1066008_028",
    "unit_id": null
  },
  {
    "type": "dialogue",
