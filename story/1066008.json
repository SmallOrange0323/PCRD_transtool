    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "真的嗎？",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "咦咦咦咦咦？",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "小哥，",
    "voice": "vo_adv_1066008_042",
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "你竟然不認識「龍膽掃帚」老師嗎！？",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n這也太不可思議了吧？",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "你太外行了啦，",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "外行！",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n根本就是個假玩家！",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這位老師之前在知名的SNS網站上傳插畫日記，",
    "voice": "vo_adv_1066008_043",
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n但是馬上就刪除了。",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "統整老師作品的網站也一下就不見了……",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "有謠言說，",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "他甚至還拒絕了阿斯特朗月刊的取材邀約……",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "能讀到",
    "voice": "vo_adv_1066008_044",
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這位身分不明的神秘作家，",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "「龍膽掃帚」老師\\n作品的管道，",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "就只有這本統整了老師插畫日記的同人誌！",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n而且還有附上未公開的內容喔！",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……不過，",
    "voice": "vo_adv_1066008_045",
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "要是小哥無論如何都想要讀讀看的話，",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n我也可以借你看看喔？",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "畢竟不明白它有趣之處的這種事，",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "已經可以算是一種罪了……",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "小哥就一邊感謝我那比神秘森林還要寬闊的胸懷一邊讀吧！",
    "voice": "vo_adv_1066008_046",
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n好了，",
    "voice": null,
    "unit_id": 106631
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "去坐在那裡讀！",
    "voice": null,
    "unit_id": 106631
  },
