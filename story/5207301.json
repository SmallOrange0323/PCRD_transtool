[
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "因為夏天時會變得虛弱，所以就要把整個世界變冷！？",
    "voice": "vo_adv_5207301_000",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "別開玩笑了，誰會允許啊，",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n貓咪可不擅長應對寒冷！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "是！",
    "voice": "vo_adv_5207301_001",
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n而且，",
    "voice": null,
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "為了璃亞和安涅默涅小姐的",
    "voice": null,
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "旅途安寧，",
    "voice": null,
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n不能讓你們通過這裡……！",
    "voice": null,
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "與默涅她們距離足夠……",
    "voice": "vo_adv_5207301_002",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "若在此地，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n應當能在那兩人察覺前，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "先一步驅除魔物吧。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "嗯。",
    "voice": "vo_adv_5207301_003",
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "兩人能平安抵達目的地嗎？",
    "voice": null,
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "能好好相處嗎？",
    "voice": null,
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "兩邊",
    "voice": null,
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "莉莉",
    "words": "都讓人擔心啊……",
    "voice": null,
    "unit_id": 125811
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "現在就相信她們，",
    "voice": "vo_adv_5207301_004",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "炸飛這群魔物吧！",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "但儘可能保持安靜喔！",
    "voice": null,
    "unit_id": 106011
  }
]
