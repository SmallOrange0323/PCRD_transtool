[
  {
    "type": "background",
    "bg_id": "502910"
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "オープンまであと二日。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "完成間近の『R＆Aリゾート』で、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "\\nクレジッタは今日も朝から忙しく働いていた。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ちょっと秘書１号？　",
    "voice": "vo_adv_1400003_000",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "次の予定は？",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "定例のMTGが３件に",
    "voice": "vo_adv_1400003_001",
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "雑誌の取材が２件入っております。",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\nその間に",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "報告書の確認が６件、",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "取引会社さんとの面談が８件、",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "あとは……",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ちなみに今のは午前の予定ですわ。",
    "voice": "vo_adv_1400003_002",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "リゾートのオープンまであと少しですからね。",
    "voice": "vo_adv_1400003_003",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nその時まで、",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "できる限りの準備を欠かさない。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nそれがプロの仕事ってものですわ。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……と、",
    "voice": "vo_adv_1400003_004",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "そんなことより少年。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "あなた今日はお休みでしょう？",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "いい仕事をするためには休息も必要ですわよ。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……ん？　",
    "voice": "vo_adv_1400003_005",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "なにをもじもじしておられるのですか？",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……わたくしと？",
    "voice": "vo_adv_1400003_006",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "今の聞いてましたわよね、",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "仕事がありますので無理ですわ。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "あくまで一般論です、",
    "voice": "vo_adv_1400003_007",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "わたくしには関係ありませんわ。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "わたくしにとっては仕事が生きがいですから、",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "心配なさらず。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nその気になりましたら一日25時間働けますので。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "……時空が歪んでおりますが……",
    "voice": "vo_adv_1400003_008",
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "クレジッタさま、",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n今日は騎士さんと休暇を取られては？",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "あなた、",
    "voice": "vo_adv_1400003_009",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "記憶ぶっ飛んでらっしゃるの？",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n分刻みのスケジュールですのよ休みなど取れる訳ないでしょうっ！",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "ですが、",
    "voice": "vo_adv_1400003_010",
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "騎士さんの思いに応えてあげてもよろしいのでは？",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n今日までたくさん働いてくださったのですから。",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……っ。",
    "voice": "vo_adv_1400003_011",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……これは……",
    "voice": "vo_adv_1400003_012",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "海水浴場のチケット？",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nバイト代で買ったんですの？　",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……わたくしの、",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ために……",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……全く、",
    "voice": "vo_adv_1400003_013",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "お金の使い方がなってませんわね。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nそれでは将来、",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "一流の男になれませんわよ？",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "…",
    "voice": "vo_adv_1400003_014",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "…ぐっ！！",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nその捨て犬のような潤んだ瞳は反則ですわ……！",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……ああ、",
    "voice": "vo_adv_1400003_015",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "もうっ！",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "わかったわかった、",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "わかりましたわよっ！",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……秘書１号っ！　",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "今日の予定、",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "直ちにキャンセルなさいっ！",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "ふふ……",
    "voice": "vo_adv_1400003_016",
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "承知いたしました。",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……さあ、",
    "voice": "vo_adv_1400003_017",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "行きますわよ海水浴。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n少年に免じて",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ほんの少しだけ休暇を取って差し上げますわ。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "なんであなたがそんなにうれしそうなんですのよ。",
    "voice": "vo_adv_1400003_018",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……ふふ、",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "まったく。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "background",
    "bg_id": "500160"
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……まあまあ、",
    "voice": "vo_adv_1400003_019",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ずいぶん庶民的な海水浴場ですわね。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "人でごった返して、",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "皆テンション爆上がりで。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nとてもゆっくりできる雰囲気ではありませんわ。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……ですが",
    "voice": "vo_adv_1400003_020",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "日常を忘れて開放的に盛り上がれる……",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nそれもバカンスの一つの形……",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ですわね。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "うちでも高級リゾートというコンセプトは守りつつ、",
    "voice": "vo_adv_1400003_021",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nこちらの要素を取り入れることはできないものかしら……",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "はっ……",
    "voice": "vo_adv_1400003_022",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "いけませんわ、",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ついいつもの癖で。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "今日は休暇でしたわね",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "休暇。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "さて、",
    "voice": "vo_adv_1400003_023",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "どうします……？　",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "まずはお食事でも……",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "といっても",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "このあたりにレストランなどないですわよね？",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……イカ焼き、",
    "voice": "vo_adv_1400003_024",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "焼きそば、",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "かき氷……",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nまあまあなんてジャンクなんでしょう。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "せっかくなので一口……",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "もぐ。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……フム。",
    "voice": "vo_adv_1400003_025",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "びっくりするくらい想像通りの味ですわ。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n「こういう味だろうな」",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "という想定を、",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n上回りも下回りもせずピッタリ同じ、",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "驚きが無さ過ぎて驚きました。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "あら、どうも。",
    "voice": "vo_adv_1400003_026",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nではわたくしの焼きそば、",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "一口どうぞ。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……あら、",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "手が塞がっておりますわね、",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "仕方ありません。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "はい、",
    "voice": "vo_adv_1400003_027",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "あーんして差し上げますわ。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……あーん。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……っ。",
    "voice": "vo_adv_1400003_028",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n……あーん。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "んぐ……",
    "voice": "vo_adv_1400003_029",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "んぐ……",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "このたこ焼きも想像通りの味。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……？　",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "それなのに、",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "なぜでしょう？",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nうちの一流シェフの料理にも負けておりませんわ……",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "味とは別の要素。",
    "voice": "vo_adv_1400003_030",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nやはりロケーション？",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……いえ、",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "それだけでは。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……っ。",
    "voice": "vo_adv_1400003_031",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "え、",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ええ。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "なんですのその屈託のない笑顔……",
    "voice": "vo_adv_1400003_032",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……味とは別の要素……",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "もしかして……",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "い、",
    "voice": "vo_adv_1400003_033",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "いえ……",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "まあそうですわね。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……さあ、",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "それでは行きましょうか。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n料理長、",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "チェックしてくださる？",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "海の家の店主",
    "words": "え……",
    "voice": "vo_adv_1400003_034",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "海の家の店主",
    "words": "料理長って……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "海の家の店主",
    "words": "俺？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "海の家の店主",
    "words": "\\nいやいや",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "海の家の店主",
    "words": "料金なら先払いでもうもらってるよ、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "海の家の店主",
    "words": "この少年から。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "なっ、",
    "voice": "vo_adv_1400003_035",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "そんなそんないけませんわ……！",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "わたくしが誰かから施しを受けるなど、",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "しかも年下の少年に。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "お金ならわたくしが……！",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……っ。",
    "voice": "vo_adv_1400003_036",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……っ。",
    "voice": "vo_adv_1400003_037",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nお、",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "お待ちになって……！",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……海はいいですわ。",
    "voice": "vo_adv_1400003_038",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n今日まで、",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "それに明日からずっと、",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "毎日眺めることになりますから。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "近くにプライベートプールがありましたわね、",
    "voice": "vo_adv_1400003_039",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "そちらに行きましょう。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "お食事のお礼にお代はわたくしが出しますわっ！",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……ふうっ。",
    "voice": "vo_adv_1400003_040",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n気持ちいいですわっ♪",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "あらあら、",
    "voice": "vo_adv_1400003_041",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "どうしましたの少年？",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nぽかんとわたくしを見つめたりなんかして。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "まさか",
    "voice": "vo_adv_1400003_042",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "見惚れてらっしゃいますの、",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "このおませさん♪",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "何を今更、",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "この夏二度もわたくしの胸に挟まっておいて──",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "って",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "そんなことはどうでもよろしいですわ……っ！！",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……さあ、",
    "voice": "vo_adv_1400003_043",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "少年。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "こっちにいらっしゃい。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n一緒に泳ぎましょう。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……ふふ、",
    "voice": "vo_adv_1400003_044",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nプライベートプールで二人っきりだなんて。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nあなたには少し早すぎたかしら？",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "こんな大人の恋愛は……",
    "voice": "vo_adv_1400003_045",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "などという訳ではなくっ！！",
    "voice": "vo_adv_1400003_046",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……ふう。",
    "voice": "vo_adv_1400003_047",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n夏のせいでおかしくなってますわ。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nこれは休暇を取って正解だったかもしれません。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……「今日は僕に甘えてください。」",
    "voice": "vo_adv_1400003_048",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ふふっ、",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "そんなこと初めて言われましたわ。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……ああいう時、",
    "voice": "vo_adv_1400003_049",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "甘えられたらいいのでしょうね。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "でも、",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "わたくしはクレジッタ・キャッシュ。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "そんな生き方をしていない。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "唯一の例外は、",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "陛下に助けられたときだけ……",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……そう、",
    "voice": "vo_adv_1400003_050",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "これがわたくし。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nこれが……",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "……ふふ、",
    "voice": "vo_adv_1400003_051",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ごめんなさい。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nですが",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "今のは仕事のことじゃありません。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "プライベートなことですわ。",
    "voice": "vo_adv_1400003_052",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "{0}のおかげで、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "束の間の休暇を楽しんだクレジッタ。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "\\n次の日から業務効率が上がり、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "休みもありだと学んだクレジッタだった。",
    "voice": null,
    "unit_id": null
  }
]
