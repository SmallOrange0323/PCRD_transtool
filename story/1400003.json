[
  {
    "type": "background",
    "bg_id": "502910"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "距離開幕還剩兩天。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在快要完成的「R＆A度假村」中，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n克蕾琪塔今天也一早就開始忙於工作。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "秘書一號？",
    "voice": "vo_adv_1400003_000",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "接下來的行程是？",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "有三場例行會議",
    "voice": "vo_adv_1400003_001",
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "和兩場雜誌採訪。",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n中間有",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "六份報告書需要確認，",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "以及八個與合作公司的面談，",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "還有……",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "順帶一提，剛才那是中午前的行程。",
    "voice": "vo_adv_1400003_002",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "畢竟離度假村開幕只剩一點時間了。",
    "voice": "vo_adv_1400003_003",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n在那之前，",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "要把所有能做的準備都做好才行。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n這就是職業人士的工作。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……哦，",
    "voice": "vo_adv_1400003_004",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "比起這個，少年。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "你今天不是休假嗎？",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "要做好工作，休息也是必要的喔。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……嗯？",
    "voice": "vo_adv_1400003_005",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "為什麼扭扭捏捏的？",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……跟我一起？",
    "voice": "vo_adv_1400003_006",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "剛才的行程你也聽到了吧，",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我有工作所以沒辦法。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "那只是一般來說，",
    "voice": "vo_adv_1400003_007",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "跟我無關。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "因為對我來說工作就是生存的意義，",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "不用擔心。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n只要我想，一天工作25小時也沒問題。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "……那樣時空都扭曲了吧……",
    "voice": "vo_adv_1400003_008",
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "不過，克蕾琪塔小姐，",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n今天就和騎士先生休息如何呢？",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "妳是",
    "voice": "vo_adv_1400003_009",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "失憶了嗎？",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n行程可是用分鐘為單位在排的，怎麼可能有時間休息！",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "但是，",
    "voice": "vo_adv_1400003_010",
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "是不是也該回應騎士先生的心意呢？",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n畢竟他至今為止也幫了許多忙。",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……唔。",
    "voice": "vo_adv_1400003_011",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……這是……",
    "voice": "vo_adv_1400003_012",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "海水浴場的入場券？",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n你用打工費買的嗎？",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n……是、",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "為了我……",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……真是的，",
    "voice": "vo_adv_1400003_013",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "真不會善用金錢。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n這樣將來",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "可當不了一流的男人喔？",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "…",
    "voice": "vo_adv_1400003_014",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "…唔！！",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n那種被遺棄的小狗般的眼神太犯規了……！",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……唉，",
    "voice": "vo_adv_1400003_015",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "真是的！",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "好啦好啦，",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我知道了！",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……秘書一號！",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "今天的行程",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "馬上都取消掉！",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "呵呵……",
    "voice": "vo_adv_1400003_016",
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "好的。",
    "voice": null,
    "unit_id": 6112
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……好了，",
    "voice": "vo_adv_1400003_017",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我們去海水浴吧。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n看在少年的面子上，",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我就稍微休假一下。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "為什麼你會這麼開心啊。",
    "voice": "vo_adv_1400003_018",
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……呵呵，",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "真是的。",
    "voice": null,
    "unit_id": 140011
  },
  {
    "type": "background",
    "bg_id": "500160"
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……哎呀哎呀，",
    "voice": "vo_adv_1400003_019",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "真是庶民的海水浴場呢。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "人山人海的，",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "大家都興致高昂。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n完全不是能夠悠閒度過的氛圍。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……不過，",
    "voice": "vo_adv_1400003_020",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "忘掉日常放開狂歡……",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n這也是一種……",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "度假的方式呢。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我們能不能也在維持高級度假村主題的前提下，",
    "voice": "vo_adv_1400003_021",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n將這裡的要素加入其中呢……",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "啊……",
    "voice": "vo_adv_1400003_022",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "糟糕，",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "因為平時的習慣不小心就這樣了。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "今天可是來休假的，",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "休假。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "那麼，",
    "voice": "vo_adv_1400003_023",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "接下來呢……？",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "要不要先吃飯……",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "雖然這麼說，",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "但這附近沒有餐廳吧？",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……烤魷魚、",
    "voice": "vo_adv_1400003_024",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "炒麵、",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "刨冰……",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n哎呀哎呀都是垃圾食物呢。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "機會難得，就吃一口……",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "嚼。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……唔嗯。",
    "voice": "vo_adv_1400003_025",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "令人驚訝地完全是想像中的味道呢。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n對於「大概是這種味道吧」",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "的想像，",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n既沒有更好也沒有更差，正好一樣，",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "一點驚喜都沒有反而令人感到驚喜。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "哎呀，謝謝。",
    "voice": "vo_adv_1400003_026",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n那你也吃一口",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我的炒麵吧。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……哎呀，",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "沒有手拿了呢，",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "沒辦法了。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "來，",
    "voice": "vo_adv_1400003_027",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我餵你吃吧。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……啊──",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……唔。",
    "voice": "vo_adv_1400003_028",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n……啊──",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "嚼……",
    "voice": "vo_adv_1400003_029",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "嚼……",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "這個章魚燒也是想像中的味道。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……？",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "明明是這樣，",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "但為什麼呢？",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n感覺不輸給我們的一流廚師做出來的料理……",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "是因為味道以外的要素。",
    "voice": "vo_adv_1400003_030",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n果然是地點嗎？",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……不，",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "不只是那樣。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……唔。",
    "voice": "vo_adv_1400003_031",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "是、",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "是啊。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "那無憂無慮的笑容是怎樣……",
    "voice": "vo_adv_1400003_032",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……味道以外的要素……",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "難道說……",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "那、",
    "voice": "vo_adv_1400003_033",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "那個……",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "是啊。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……好了，",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我們走吧。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n主廚，",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "請幫我們買單。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "咦……",
    "voice": "vo_adv_1400003_034",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "主廚……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "是叫我嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "\\n不不，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "剛剛這位少年",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "海之家的店長",
    "words": "已經先付完錢了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "什麼，",
    "voice": "vo_adv_1400003_035",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "那、那可不行……！",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "居然讓我接受他人的施捨，",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "甚至還是年紀比我小的少年。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "錢的話讓我來……！",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……唔。",
    "voice": "vo_adv_1400003_036",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……唔。",
    "voice": "vo_adv_1400003_037",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n請、",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "請等等……！",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……大海就不必了。",
    "voice": "vo_adv_1400003_038",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n畢竟到今天為止，",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "以及明天以後，",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "每天都會一直看到呢。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "這附近有私人泳池對吧，",
    "voice": "vo_adv_1400003_039",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我們去那邊。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "作為請我吃飯的回禮，這次的費用就讓我來出！",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……呼。",
    "voice": "vo_adv_1400003_040",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n好舒服♪",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "哎呀哎呀，",
    "voice": "vo_adv_1400003_041",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "怎麼了，少年？",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n呆呆地看著我。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "難道是",
    "voice": "vo_adv_1400003_042",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "看得入迷了嗎，",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "這早熟的孩子♪",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "怎麼現在還這樣，",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "這次夏天明明兩次都被夾在我的胸──",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "不對，",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "那種事一點都不重要……！！",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……來吧，",
    "voice": "vo_adv_1400003_043",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "少年，",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "過來這裡。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n一起游泳吧。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……呵呵，",
    "voice": "vo_adv_1400003_044",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n在私人泳池兩人獨處什麼的，",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n對你來說還太早了嗎？",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "像這種大人的戀愛……",
    "voice": "vo_adv_1400003_045",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "才不是這樣！！",
    "voice": "vo_adv_1400003_046",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……呼。",
    "voice": "vo_adv_1400003_047",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n因為夏天的關係都變得奇怪了。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n休假可能是正確的選擇。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……「今天請依賴我吧。」",
    "voice": "vo_adv_1400003_048",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我第一次被說這種話。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……那種時候，",
    "voice": "vo_adv_1400003_049",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "要是真的能放開來依賴就好了。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "不過，",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我可是克蕾琪塔‧凱許。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "那不是我的生存方式。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "唯一的例外，",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "只有被陛下拯救的時候……",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……沒錯，",
    "voice": "vo_adv_1400003_050",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "這才是我。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n這才是……",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "……呵呵，",
    "voice": "vo_adv_1400003_051",
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "抱歉。",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n不過，",
    "voice": null,
    "unit_id": 140012
  },
  {
    "type": "dialogue",
