    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "[FFFFFFFF]騎空士的吉塔！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]妳認識我……？",
    "voice": "vo_adv_5118063_002",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
