  {
    "type": "dialogue",
    "name": "旁白",
    "words": "[FFFFFFFF]為了確認騎空團是否有委託進來，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "[FFFFFFFF]\\n吉塔和{0}來到佈告欄前。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]委託、",
    "voice": "vo_adv_5118063_000",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]委託……",
    "voice": null,
    "unit_id": 105712
