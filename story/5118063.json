  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]嗯，",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]看來目前是沒有呢。",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "[FFFFFFFF]喔～呵呵呵！",
    "voice": "vo_adv_5118063_001",
