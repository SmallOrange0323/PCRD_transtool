  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n妳都事先準備好水了，",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "我倒是希望妳能阻止拉姆啊……",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "因為雷姆希望昴",
    "voice": "vo_adv_5152007_059",
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "也能感受到姊姊的溫柔。",
    "voice": null,
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "但是同時，",
    "voice": null,
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "雷姆也能預測到你的舌頭會麻掉，",
    "voice": null,
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "所以就先準備好冰水了。",
    "voice": null,
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "也有甜的果汁喔。",
    "voice": null,
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "姊姊的溫柔實在有夠過激的啊……",
    "voice": "vo_adv_5152007_060",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "呵呵。",
    "voice": "vo_adv_5152007_061",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "大家",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "看起來都非～常開心。",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "夏天的海邊，",
    "voice": "vo_adv_5152007_062",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "有讓大家露出笑容的力量喔。",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "嗯，",
    "voice": "vo_adv_5152007_063",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "真的呢。",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "就跟昴說的一樣啊。",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這次非常……",
    "voice": "vo_adv_5152007_064",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "不對，",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這次也",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "非常謝謝妳，",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "愛蜜莉雅。",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "多虧有妳在，",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "我們才能守護住快樂的夏天海邊。",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "啊，",
    "voice": "vo_adv_5152007_065",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "妳不用跟我道謝喔。",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "因為我們",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "也在享受「夏日佳期」啊。",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "而且，",
    "voice": "vo_adv_5152007_066",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "我這次",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "還成為了照顧小孩的",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "「專家」了。",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "──這樣的判斷太天真了。",
    "voice": "vo_adv_5152007_067",
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "可可蘿……？",
    "voice": "vo_adv_5152007_068",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這還只是養育小孩之路的",
    "voice": "vo_adv_5152007_069",
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "途中而已喔，",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "愛蜜莉雅小姐。",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "咦？",
    "voice": "vo_adv_5152007_070",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "養育小孩子的方法",
    "voice": "vo_adv_5152007_071",
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "可是千差萬別。",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "愛蜜莉雅小姐",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "只是知道了其中的一小部分而已。",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "啊～",
    "voice": "vo_adv_5152007_072",
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "的確是這樣呢。",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "這個世界上可還有很多的啊。",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "所謂的媽媽。",
    "voice": "vo_adv_5152007_073",
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅、昴",
    "words": "媽媽……！？",
    "voice": "vo_adv_5152007_074",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "啊，",
    "voice": "vo_adv_5152007_075",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "請看那邊！",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n是因為騷動平息的關係吧，",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "大家都來了喔☆",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "喂～♪",
    "voice": "vo_adv_5152007_076",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n各位，",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這邊喔～！",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n我來替妳們介紹",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "從異世界來的朋友～♪",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "大家",
    "words": "…………",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "居然還有這麼多的媽媽嗎……！？",
    "voice": "vo_adv_5152007_077",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "與充滿母性的人們產生新的邂逅。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n異世界的羈絆進一步地擴展，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "並且加深──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "──呼，",
    "voice": "vo_adv_5152007_078",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "似乎終於處理完了呢。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "真是的。",
    "voice": "vo_adv_5152007_079",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n我可不想要再碰上什麼異世界介入了啊。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "盡是發生些無法預測的事情。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "……不過，",
    "voice": "vo_adv_5152007_080",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "那傢伙似乎對這個邂逅感到很高興，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n也很珍惜締結的羈絆就是了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "就是說啊。",
    "voice": "vo_adv_5152007_081",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n與未知的相遇很可貴，",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "而羈絆則是很重要的東西。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "…………",
    "voice": "vo_adv_5152007_082",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "於我而言",
    "voice": "vo_adv_5152007_083",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "也有了很有意思的體驗呢。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "…………",
    "voice": "vo_adv_5152007_084",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我們這邊的話題，",
    "voice": "vo_adv_5152007_085",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "最後似乎默默地帶到了他們的身上，",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n這是妳做的好事嗎？",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "…………",
    "voice": "vo_adv_5152007_086",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "為什麼要無視我呢？",
    "voice": "vo_adv_5152007_087",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "這是難得締結的緣分，",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "我們就來進一步加深交情吧。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "好嗎，",
    "voice": "vo_adv_5152007_088",
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "艾姬多娜",
    "words": "愛梅斯。",
    "voice": null,
    "unit_id": 132012
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "唔～～",
    "voice": "vo_adv_5152007_089",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "～～～！",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "妳快點給我回去啦─────！",
    "voice": "vo_adv_5152007_090",
    "unit_id": 190011
  },
