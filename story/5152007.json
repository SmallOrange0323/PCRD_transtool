[
  {
    "type": "background",
    "bg_id": "500691"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "因為昴的奔走而聚集起來的異世界羈絆。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n他們集結眾人的力量，打倒了白島鯨。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n讓海邊回歸平靜的他們，再次展開心心念念的夏日假期──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "515200702"
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "不過，",
    "voice": "vo_adv_5152007_000",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "人變得很多呢。",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "各位～♪",
    "voice": "vo_adv_5152007_001",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n這是大勝利紀念！",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "大家就盡情地吃吧☆",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "愛蜜莉雅大人，",
    "voice": "vo_adv_5152007_002",
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "這個似乎是熱帶果汁。",
    "voice": null,
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "大精靈大人也請用。",
    "voice": null,
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "謝謝妳，雷姆。",
    "voice": "vo_adv_5152007_003",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "雷姆",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "也要好好休息才行喔？",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "這飲料的顏色還真是奇怪呢？",
    "voice": "vo_adv_5152007_004",
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "\\n想像不到它的味道呀……",
    "voice": null,
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "啊，",
    "voice": null,
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "這個好好喝♪",
    "voice": null,
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "巴魯斯之前說過，",
    "voice": "vo_adv_5152007_005",
    "unit_id": 109812
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "到海邊的話就要吃炒麵。",
    "voice": null,
    "unit_id": 109812
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n必須確認巴魯斯是不是又說謊了才行呢。",
    "voice": null,
    "unit_id": 109812
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "\\n雷姆，",
    "voice": null,
    "unit_id": 109812
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "去幫我拿炒麵過來。",
    "voice": null,
    "unit_id": 109812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "明明就是雙胞胎女僕，這差異是怎麼回事啊……",
    "voice": "vo_adv_5152007_006",
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "不過……",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "來吧，拉姆，",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我幫妳拿了很好吃很好吃的炒麵過來喔～？",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "凱留小姐。",
    "voice": "vo_adv_5152007_007",
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n您剛剛似乎",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "往那盤炒麵加了很多辣椒粉……",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "您應該不是打算把那個拿給拉姆小姐吧？",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "still",
    "still_id": "515200703"
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "這麼說來，",
    "voice": "vo_adv_5152007_008",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "我還沒有游泳呢……",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "先稍微游一下之後，",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "再來吃東西吧。",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "\\n鏡華要不要也一起來？",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "咦？",
    "voice": "vo_adv_5152007_009",
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "那個，",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我對游泳還沒有自信……",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "如果是那樣的話我有個好東西。",
    "voice": "vo_adv_5152007_010",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n我這裡有橡膠船，",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "用這個就沒問題了吧。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "哇……",
    "voice": "vo_adv_5152007_011",
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "看起來好有趣……♪",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n如果是這樣的話感覺好像很不錯……！",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我跟妳兩個人的話",
    "voice": "vo_adv_5152007_012",
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這個尺寸可說是綽綽有餘吧。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "剛好也抓到動力來源了。",
    "voice": null,
    "unit_id": 126611
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "那個，",
    "voice": "vo_adv_5152007_013",
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "妳說的動力來源",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "咲戀",
    "words": "應該不是指我吧？",
    "voice": null,
    "unit_id": 110311
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "我說",
    "voice": "vo_adv_5152007_014",
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "蘭法，",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "妳要不要再稍微",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "靠過來一點呀。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "不，",
    "voice": "vo_adv_5152007_015",
    "unit_id": 126911
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "那個……",
    "voice": null,
    "unit_id": 126911
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "我，",
    "voice": null,
    "unit_id": 126911
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "在這裡就好……",
    "voice": null,
    "unit_id": 126911
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "那麼，",
    "voice": "vo_adv_5152007_016",
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "老師能過去妳那邊嗎。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "……好、",
    "voice": "vo_adv_5152007_017",
    "unit_id": 126911
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "好的……！",
    "voice": null,
    "unit_id": 126911
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "\\n因為我……",
    "voice": null,
    "unit_id": 126911
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "也有很多事情，",
    "voice": null,
    "unit_id": 126911
  },
  {
    "type": "dialogue",
    "name": "蘭法",
    "words": "想要問妳……",
    "voice": null,
    "unit_id": 126911
  },
  {
    "type": "background",
    "bg_id": "500691"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "──海邊",
    "voice": "vo_adv_5152007_018",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "果然很棒啊。",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "喔，兄弟。",
    "voice": "vo_adv_5152007_019",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "你不去那邊沒關係嗎？",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n這裡就只有",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "覺得被穿著泳裝的女孩包圍很坐立難安，",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n所以縮在角落扭扭捏捏地看著那邊，",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "多愁善感的我而已喔？",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "那還真是光榮呢。",
    "voice": "vo_adv_5152007_020",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n那麼",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "你想聊啥？",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "戀愛話題嗎？",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n如果你有喜歡的女孩就告訴我吧～",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "……",
    "voice": "vo_adv_5152007_021",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "不過兄弟，",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "你也很辛苦呢。",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "你有好幾次都失去記憶……",
    "voice": "vo_adv_5152007_022",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "變成「那個狀態」了吧？",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "很多人都知道呢。",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "我可不想習慣啊！？",
    "voice": "vo_adv_5152007_023",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "老實說，",
    "voice": "vo_adv_5152007_024",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "我光是想起自己在愛蜜莉雅醬面前",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n說出吧哺吧哺的樣子，",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "我的臉就要熱起來了啊……",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "唉……",
    "voice": "vo_adv_5152007_025",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "而且還被很多人看到了……",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "啊，",
    "voice": "vo_adv_5152007_026",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "被很多人看到的是之前那輪嗎。",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "不不不，",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "別在意別在意，",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "這是我自己的事。",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "不過，",
    "voice": "vo_adv_5152007_027",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "總而言之，",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "你是個很厲害的人啊！",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n大家都為了你而行動，",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "所以這次也順利解決了吧？",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "該說是",
    "voice": "vo_adv_5152007_028",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "能感受到羈絆嗎。",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "那樣的羈絆，",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "會變成很強大的力量呢。",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n你累積起來的東西，",
    "voice": null,
    "unit_id": 2713
  },
