[
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "晶のことが気になっているノウェムは、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "\\n同じ七冠である変貌大妃に、どんな人物か尋ねてみることにした。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "なぁ、",
    "voice": "vo_adv_5111605_000",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "ネネカ。",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\n晶って、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "ネネカから見て",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "どんなヤツなんだ？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\n七冠だから、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "すごい優秀っていうのは分かるけどさ。",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "その通りです、",
    "voice": "vo_adv_5111605_001",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "無能では七冠は務まりません。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "\\n彼女も類まれなる才能と、",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "それを磨き続ける忍耐力を備えています。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "へー、",
    "voice": "vo_adv_5111605_002",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "やっぱりすごいヤツなのか！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\nじゃあ、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "敵になる前は",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "尊敬したり、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "信頼したりしてたのか？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "いいえ、",
    "voice": "vo_adv_5111605_003",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "まったく、",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "これっぽっちも。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "信用できない七冠ランキングを作ったら、",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "\\n間違いなく彼女がトップだと思います。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "……へー",
    "voice": "vo_adv_5111605_004",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "なにか言いたそうですね？",
    "voice": "vo_adv_5111605_005",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "いや、",
    "voice": "vo_adv_5111605_006",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "別に。",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "で、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "どの辺が信用できないんだ？　",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "能力的には問題ないんだろ？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\n詳しく教えてくれ！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "周囲の人間との連携に問題があります。",
    "voice": "vo_adv_5111605_007",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "\\n例えば",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "作業の進捗を確認しても",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "「普通」としか言いません。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "協力会社との交渉の手ごたえを確認しても",
    "voice": "vo_adv_5111605_008",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "「普通」、",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "\\nクレーム対応の結果を確認しても",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "「普通」、",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "出前を頼むとき、",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "メニューを確認しても",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "「普通」……",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "とにかく秘密主義で、",
    "voice": "vo_adv_5111605_009",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "自分のことを話さない。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "にもかかわらず、",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "生み出す結果は常に「最高」。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "いろいろと怪しくて、",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "信用するなど不可能ですね。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "秘密主義っていうか、",
    "voice": "vo_adv_5111605_010",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "適当に返事してるだけの気もするけど……",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "ま",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "ぁ、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "ネネカが苦労してるのはよく分かった！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\nちなみに、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "あとどれくらいそんな感じの話があるんだ？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "そうですね、",
    "voice": "vo_adv_5111605_011",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "少し待ってください。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "テキストファイルに",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "彼女から受けた仕打ちを",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "\\nまとめてあったはずなのですが……",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "そ、",
    "voice": "vo_adv_5111605_012",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "そんなものまであるのか！？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\nいくらなんでも根に持ちすぎだろ！？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "ならば貴方も、",
    "voice": "vo_adv_5111605_013",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "晶と同じオフィスで働いてみてください。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "彼女の思い付きに付き合わされて、",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "何度も寝袋で眠ることになれば、",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "\\n私の気持ちがよく理解できるはずです。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "うっ、",
    "voice": "vo_adv_5111605_014",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "それはイヤかも……",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "でも、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "結局そこまでして付き合ったってことは、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\n仲がいいってことにならないか？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "……なぜか、",
    "voice": "vo_adv_5111605_015",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "他のメンバーが作業に行き詰まっていると、",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "\\nどこからか嗅ぎつけてヘルプにやってきますからね。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "私も、",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "助けられたことがないわけではありません。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "仲がいいと感じたことはありませんが、",
    "voice": "vo_adv_5111605_016",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "借りを作ったままにしておくのも",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "気分が悪かったので。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "お互い、",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "最低限の義理立ては果たしていた……",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "というだけの話です。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "おお！　",
    "voice": "vo_adv_5111605_017",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "なんか、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "かっこいい関係だな！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\n恨み言をまとめるくらいなら、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "そういう思い出をまとめた方が",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\n腹も立たなくていいんじゃないか？",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "……既に、",
    "voice": "vo_adv_5111605_018",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "私と彼女は敵同士です。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "今さら過去を懐かしんだとしても、",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "状況は変わりません。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "そうだな……",
    "voice": "vo_adv_5111605_019",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "悪かったよ。",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "なんか、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "うれしそうに話してたから、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "つい。",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "もうこの話はやめにしましょう。",
    "voice": "vo_adv_5111605_020",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "\\n晶は七冠で最も謎が多く、",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "信用ならない……",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "\\n",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "とても怪しい女だと覚えてもらえれば結構です。",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "そうか、",
    "voice": "vo_adv_5111605_021",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "分かったぞ！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\n",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "でもやっぱり、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "怪しさならネネカだって……",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "あっ。",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "……先ほどから何か言いたそうではありましたが、",
    "voice": "vo_adv_5111605_022",
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "\\nどうやら",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "私に思うところがあるようですね？",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "\\n一対一で",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "変貌大妃",
    "words": "話し合う場でも設けましょうか？",
    "voice": null,
    "unit_id": 107011
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "えっ！？　",
    "voice": "vo_adv_5111605_023",
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "あ～、",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "それは～……！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\nしまった！　",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "オクトーと待ち合わせしてたんだった！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "\\n待たせると悪いから",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "もう行くぞ！　",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ノウェム",
    "words": "じゃあな～！",
    "voice": null,
    "unit_id": 106114
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "これ以上変貌大妃に追及されてはたまらないと、",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
