[
  {
    "type": "dialogue",
    "name": "日和",
    "words": "很好，",
    "voice": "vo_adv_5042323_000",
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "連闇影也打倒了！",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "就這樣順勢一口氣……",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "黑之王",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 13411
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這、",
    "voice": "vo_adv_5042323_001",
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這股瘴氣是怎麼回事啊！？",
    "voice": null,
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n強度是之前所無法比擬的！",
    "voice": null,
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "原來如此……",
    "voice": "vo_adv_5042323_002",
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "牠把所有瘴氣",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "都朝向了我們……",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "這大概就是",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "黑之王的全力……",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n不對，",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "應該說是最後的垂死掙扎吧？",
    "voice": null,
    "unit_id": 106711
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "妳、",
    "voice": "vo_adv_5042323_003",
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "妳是說，",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "牠的力量比至今為止都還要強嗎？",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "怎怎怎、",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "怎麼辦啊～！？",
    "voice": null,
    "unit_id": 113011
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "這超乎了我的想像。",
    "voice": "vo_adv_5042323_004",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n再這樣下去，",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "很不妙呢……",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "……沒事的！！",
    "voice": "vo_adv_5042323_005",
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "璃、",
    "voice": "vo_adv_5042323_006",
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "璃乃？",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "因為",
    "voice": "vo_adv_5042323_007",
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "這裡有救世主……",
    "voice": null,
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "不對，",
    "voice": null,
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "因為這裡有這麼多",
    "voice": null,
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n想拯救這個世界的人啊！",
    "voice": null,
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我們的心意……",
    "voice": "vo_adv_5042323_008",
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我們的意念，",
    "voice": null,
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "是不會輸的！",
    "voice": null,
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "璃乃……",
    "voice": "vo_adv_5042323_009",
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "妳說得對！",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "\\n",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "我們的心意，",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "愛麗絲",
    "words": "不會輸給任何人！",
    "voice": null,
    "unit_id": 4611
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "就是說啊！",
    "voice": "vo_adv_5042323_010",
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "\\n我也一樣，",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "日和",
    "words": "我超喜歡這個世界！",
    "voice": null,
    "unit_id": 100113
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "哼！",
    "voice": "vo_adv_5042323_011",
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n既然如此我就奉陪到最後吧！",
    "voice": null,
    "unit_id": 106612
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "來，",
    "voice": "vo_adv_5042323_012",
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我們走吧！",
    "voice": null,
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "去保護這個世界！",
    "voice": null,
    "unit_id": 112911
  },
  {
    "type": "dialogue",
    "name": "大家",
    "words": "好──！！",
    "voice": "vo_adv_5042323_013",
    "unit_id": null
  }
]
