  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "某天，在蘭德索爾。\\n{0}陪著【哞哞自衛隊】\\n的真琴進行街道巡守，走在街上。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "這邊看起來也沒有異常。",
    "voice": "vo_adv_5012000_000",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n{0}你那邊怎……",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "咦，",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "奇怪？",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "{0}！？　你跑去哪啦！",
    "voice": "vo_adv_5012000_001",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "喂～！　{0}！",
    "voice": "vo_adv_5012000_002",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n如果在就回應一下啊！",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "啊，",
    "voice": "vo_adv_5012000_003",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "竟然在那種地方！",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "{0}，抓到你囉！",
    "voice": "vo_adv_5012000_004",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "真是的，",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "別像小孩一樣亂跑啦。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "雖然我沒生氣，",
    "voice": "vo_adv_5012000_005",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "但也別讓我擔心啦。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "比起這個，",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "你發現什麼了嗎？",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "在那邊",
    "voice": "vo_adv_5012000_006",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "看到了郵件配送打工時很照顧你的人嗎？",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "咦，",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "郵遞馬車的老闆",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "還自己做馬車，這麼厲害。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "……怎麼看起來沒什麼精神呢。",
    "voice": "vo_adv_5012000_007",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "稍微問問看吧。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "郵遞馬車的老闆",
    "words": "啊啊，",
    "voice": "vo_adv_5012000_008",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "郵遞馬車的老闆",
    "words": "是你啊。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "郵遞馬車的老闆",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "郵遞馬車的老闆",
    "words": "好久不見啊……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "郵遞馬車的老闆",
    "words": "咦，",
    "voice": "vo_adv_5012000_009",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "郵遞馬車的老闆",
    "words": "你問我發生了什麼事？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "郵遞馬車的老闆",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "郵遞馬車的老闆",
    "words": "其實，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "郵遞馬車的老闆",
    "words": "有一點麻煩的事呢。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "郵遞馬車的老闆",
    "words": "為了今年的馬車競賽，",
    "voice": "vo_adv_5012000_010",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "郵遞馬車的老闆",
    "words": "本來想說要大顯身手，而做了一台馬車，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "郵遞馬車的老闆",
    "words": "\\n但騎手卻受傷了……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "嗯，",
    "voice": "vo_adv_5012000_011",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "那還真是可憐……",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "郵遞馬車的老闆",
    "words": "唉……",
    "voice": "vo_adv_5012000_012",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "郵遞馬車的老闆",
    "words": "這次優勝馬車所屬的郵務商行，可以得到",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "郵遞馬車的老闆",
    "words": "\\n『蘭德索爾最快郵遞馬車』",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "郵遞馬車的老闆",
    "words": "稱號的說……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "這稱號還真是直白……",
    "voice": "vo_adv_5012000_013",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "你想要那種東西啊？",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "郵遞馬車的老闆",
    "words": "有了那個的話，",
    "voice": "vo_adv_5012000_014",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "郵遞馬車的老闆",
    "words": "會很有宣傳效果喔。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "郵遞馬車的老闆",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "郵遞馬車的老闆",
    "words": "身為打造馬車的人，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "郵遞馬車的老闆",
    "words": "我希望所屬的郵務商行能夠",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "郵遞馬車的老闆",
    "words": "因此一舉成名！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "郵遞馬車的老闆",
    "words": "唉……",
    "voice": "vo_adv_5012000_015",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "郵遞馬車的老闆",
    "words": "但就缺騎手……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "郵遞馬車的老闆",
    "words": "\\n騎手……",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "郵遞馬車的老闆",
    "words": "只要有騎手……！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "郵遞馬車的老闆",
    "words": "對了，{0}！",
    "voice": "vo_adv_5012000_016",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "郵遞馬車的老闆",
    "words": "\\n你可以幫忙當騎手，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "郵遞馬車的老闆",
    "words": "替我們參加比賽嗎！？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "欸……",
    "voice": "vo_adv_5012000_017",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "喂喂，",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "突然叫他參加，他會很困擾的？",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "這個嘛、店長。",
    "voice": "vo_adv_5012000_018",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n{0}也有",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n很多事得做吧……",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "……咦，",
    "voice": "vo_adv_5012000_019",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "沒那麼多事嗎！",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "那你想要參加競賽嗎？",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "郵遞馬車的老闆",
    "words": "拜託啦，{0}！",
    "voice": "vo_adv_5012000_020",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "郵遞馬車的老闆",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "郵遞馬車的老闆",
    "words": "啊，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "郵遞馬車的老闆",
    "words": "而且會有獎品喔！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "郵遞馬車的老闆",
    "words": "　如果贏的話，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "郵遞馬車的老闆",
    "words": "我就把獎品給你！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "郵遞馬車的老闆",
    "words": "獎品每年都不同……",
    "voice": "vo_adv_5012000_021",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "郵遞馬車的老闆",
    "words": "但我打聽過今年的是，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "郵遞馬車的老闆",
    "words": "\\n獲得大概吃個一年都不成問題的",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "郵遞馬車的老闆",
    "words": "\\n超大量食材的樣子喔！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "咦～",
    "voice": "vo_adv_5012000_022",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "那還真不錯！",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "{0}也試著出賽如何？",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "萬一",
    "voice": "vo_adv_5012000_023",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "遇到危險的話，",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "我一定會保護你的！",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "　",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "怎麼樣？",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "郵遞馬車的老闆",
    "words": "咦，",
    "voice": "vo_adv_5012000_024",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "郵遞馬車的老闆",
    "words": "你願意參加？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "郵遞馬車的老闆",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "郵遞馬車的老闆",
    "words": "太棒了！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "郵遞馬車的老闆",
    "words": "　謝謝！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "郵遞馬車的老闆",
    "words": "　那就拜託你了！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "郵遞馬車的老闆",
    "words": "競賽時馬車上",
    "voice": "vo_adv_5012000_025",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "郵遞馬車的老闆",
    "words": "騎手會需要一位夥伴，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "郵遞馬車的老闆",
    "words": "\\n若是兩位的話就夠了！？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "郵遞馬車的老闆",
    "words": "　",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "郵遞馬車的老闆",
    "words": "你們的表現，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "郵遞馬車的老闆",
    "words": "我很期待唷！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "夥伴……",
    "voice": "vo_adv_5012000_026",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "呃、",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "是指我嗎？",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "郵遞馬車的老闆",
    "words": "對啊！",
    "voice": "vo_adv_5012000_027",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "郵遞馬車的老闆",
    "words": "\\n情侶一起",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "郵遞馬車的老闆",
    "words": "親密地參加馬車競賽不是很棒嗎？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "情、",
    "voice": "vo_adv_5012000_028",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "情侶！？",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "　",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "不、",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "真琴",
