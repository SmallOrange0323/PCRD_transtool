[
  {
    "type": "background",
    "bg_id": "500160"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}作為流夏打工的魚店助手，\\n陪流夏一同前往海岸附近的城鎮批貨。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "好了，",
    "voice": "vo_adv_1056002_000",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "終於到了。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "今天也請多多指教囉！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小哥。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不過其實也就只是批貨搬魚而已。",
    "voice": "vo_adv_1056002_001",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "放鬆點沒關係。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "喔喔，",
    "voice": "vo_adv_1056002_002",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "這不是流夏嗎。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "……原來如此，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "消息還沒有傳到蘭德索爾啊。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "怎麼啦？",
    "voice": "vo_adv_1056002_003",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "一臉愁眉苦臉的樣子。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "發生什麼事了？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "其實……",
    "voice": "vo_adv_1056002_004",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "我今天沒有魚可以賣給妳。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "一尾都沒有？",
    "voice": "vo_adv_1056002_005",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "是啊，",
    "voice": "vo_adv_1056002_006",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "一尾都沒有。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……發生什麼事了？",
    "voice": "vo_adv_1056002_007",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "事情是這樣……",
    "voice": "vo_adv_1056002_008",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "從昨天開始，附近的海岸一帶出現了凶暴的魔物，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "\\n害我們無法出海捕魚。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "而且那隻魔物，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "\\n牠的移動範圍橫跨了我們鎮跟鄰鎮。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "也就是說，",
    "voice": "vo_adv_1056002_009",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就算想去鄰鎮買也沒用……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "沒錯。",
    "voice": "vo_adv_1056002_010",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "我們的城鎮也是一團糟……",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你是",
    "voice": "vo_adv_1056002_011",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "鄰鎮的……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "不只是我們漁夫。",
    "voice": "vo_adv_1056002_012",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "像你們這樣來買魚的人，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "\\n也都深受其害！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "漁夫3",
    "words": "可惡！",
    "voice": "vo_adv_1056002_013",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "漁夫3",
    "words": "再這樣下去根本做不了生意……！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "漁夫3",
    "words": "\\n難道沒有辦法可以打倒那隻魔物嗎？",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "辦法我們早就都試過了！",
    "voice": "vo_adv_1056002_014",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "鄰鎮的你們應該也早就舉雙手投降了吧！？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "\\n如果能輕鬆解決的話，我們早就做了！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "\\n難道你連這個道理都不懂嗎！？",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫3",
    "words": "你說什麼？你這個混帳！",
    "voice": "vo_adv_1056002_015",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "漁夫3",
    "words": "就算你不說，我也很清楚！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "呱呱叫吵死人了，",
    "voice": "vo_adv_1056002_016",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "成何體統！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n你們年紀也不小了，這種時候吵架能解決問題嗎！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n要吵的話，就去別的地方吵！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "抱歉……",
    "voice": "vo_adv_1056002_017",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "我們能做的都做了。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "\\n可是啊！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "不管射箭還是魔法，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "都沒效……！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "魔法也不行？",
    "voice": "vo_adv_1056002_018",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這下可麻煩了……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這樣的話，",
    "voice": "vo_adv_1056002_019",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "能解決牠的就只剩我一個人了吧……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "唉唉……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "沒辦法。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那隻魔物，",
    "voice": "vo_adv_1056002_020",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就由我來收拾吧。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "漁夫3",
    "words": "咦咦！？",
    "voice": "vo_adv_1056002_021",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "漁夫3",
    "words": "可、",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "漁夫3",
    "words": "可是真的不要緊嗎？",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "漁夫3",
    "words": "\\n雖然妳手上握有武器，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "漁夫3",
    "words": "但流夏，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "漁夫3",
    "words": "妳只是個賣魚的吧！？",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "管它是賣魚的還是騎士，",
    "voice": "vo_adv_1056002_022",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "只要能打倒魔物，職業是什麼都無所謂吧。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不過，我有個條件",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "要是我打倒魔物，魚要算我便宜一點喔？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "沒、",
    "voice": "vo_adv_1056002_023",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "沒問題。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "如果妳能幫我們打倒牠的話，要多便宜都沒關係。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "成交。",
    "voice": "vo_adv_1056002_024",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "交給我吧。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "嗯……？",
    "voice": "vo_adv_1056002_025",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "真稀奇，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "是地震嗎？",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "漁夫3",
    "words": "不，不對！",
    "voice": "vo_adv_1056002_026",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "漁夫3",
    "words": "這是──",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "牠來了！",
    "voice": "vo_adv_1056002_027",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "大家快逃！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這麼快就上門了？",
    "voice": "vo_adv_1056002_028",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "省了我去找的功夫。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "哈哈，",
    "voice": "vo_adv_1056002_029",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你竟然替我擔心，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小哥你人真好。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你冷靜一點。",
    "voice": "vo_adv_1056002_030",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "別擔心，有我在。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "像這種魔物，",
    "voice": "vo_adv_1056002_031",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我已經交手過好幾次了，沒什麼。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小哥你退後一點吧！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小哥！",
    "voice": "vo_adv_1056002_032",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "看樣子你是認真的。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "好，我知道了！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "一下就好。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你去引開牠的注意力！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "background",
    "bg_id": "500160"
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "危險！",
    "voice": "vo_adv_1056002_033",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "那位小哥",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "看起來呆頭呆腦的，想不到還真有膽識！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "他是在拖延時間吧，",
    "voice": "vo_adv_1056002_034",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "漁夫2",
    "words": "流夏到底在幹嘛啊！？",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……",
    "voice": "vo_adv_1056002_035",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "小哥快逃啊！！",
    "voice": "vo_adv_1056002_036",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "漁夫1",
    "words": "啊啊！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "流夏",
