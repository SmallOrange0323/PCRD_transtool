[
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "某一天在蘭德索爾裡，\\n一名少女正忙著準備離開城鎮邁向旅途。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "──目的地是",
    "voice": "vo_adv_1057001_000",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "沿海的城鎮……",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n這些就是所有要運送的貨物嗎？",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "是啊，",
    "voice": "vo_adv_1057001_001",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "拜託妳了喔。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "話說回來，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "妳一個人沒問題嗎？",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n那個城鎮很遠呢……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "而且還得帶一匹馬拖著貨車。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "請儘管交給我！",
    "voice": "vo_adv_1057001_002",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n馬的事情也沒有問題。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "牠看起來",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "很溫和。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "莽夫１",
    "words": "嘖！",
    "voice": "vo_adv_1057001_003",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "莽夫１",
    "words": "竟然把工作委託給那種小鬼！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "莽夫２",
    "words": "你要是之後後悔沒有委託我們，",
    "voice": "vo_adv_1057001_004",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "莽夫２",
    "words": "\\n也不關我們的事啊！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "莽夫２",
    "words": "嘖！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "不要介意。",
    "voice": "vo_adv_1057001_005",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "他們只是因為這份工作被妳搶走，\\n才抱怨幾句而已。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "明明就是哄抬報酬的人不對。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "啊哈哈……",
    "voice": "vo_adv_1057001_006",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "謝謝你。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "對了。",
    "voice": "vo_adv_1057001_007",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "那邊還有另一位剛才我委託他其他工作的人，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n目的地和妳一樣。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "可以的話你們就一起走吧。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "喂～！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "你稍微過來一下！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我委託她另一個運貨的工作，目的地是一樣的城鎮，",
    "voice": "vo_adv_1057001_008",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n機會難得你們就一起行動吧。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n也不知道會在城鎮外遇到什麼事呢。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "初次見面，你好。",
    "voice": "vo_adv_1057001_009",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "你就是要和我去同一個城鎮的人？",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n那個……",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "一起去會不會，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "給你添麻煩呢？",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "謝謝……！",
    "voice": "vo_adv_1057001_010",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n我是吉塔。請多指教囉！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "background",
    "bg_id": "500320"
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "──這樣啊。",
    "voice": "vo_adv_1057001_011",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "原來你送的是信。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "你的裝備很輕便呢，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "有個萬一時也比較好行動，這很重要吧。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "……其實呢，",
    "voice": "vo_adv_1057001_012",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我有一點點不安，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n不知道能不能獨自完成這個工作。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "雖然之前也有做過類似的工作，",
    "voice": "vo_adv_1057001_013",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n不過那次從頭到尾都一直是一個人，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n從早到晚都沒有說話的對象，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "非常寂寞呢……",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "今天有你在，",
    "voice": "vo_adv_1057001_014",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "就不寂寞了呢。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "嘿嘿……",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "莽夫１",
    "words": "──終於來了啊。",
    "voice": "vo_adv_1057001_015",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "莽夫１",
    "words": "那邊的小鬼，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "莽夫１",
    "words": "給我停下來！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "background",
    "bg_id": "500130"
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "你們是剛才的……",
    "voice": "vo_adv_1057001_016",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "莽夫２",
    "words": "把你們運送的東西全部交出來吧！",
    "voice": "vo_adv_1057001_017",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "莽夫２",
    "words": "\\n要是好好配合就放過你們！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "莽夫２",
    "words": "聽到沒，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "莽夫２",
    "words": "快點！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "這個要求……",
    "voice": "vo_adv_1057001_018",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我辦不到。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n承接下來的工作，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "就必須好好完成到最後。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "莽夫１",
    "words": "這傢伙完全不怕嗎……？",
    "voice": "vo_adv_1057001_019",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "莽夫１",
    "words": "\\n妳也只有現在能囂張了！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "莽夫１",
    "words": "喂，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "莽夫１",
    "words": "要上了喔！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "莽夫２",
    "words": "哦哦！",
    "voice": "vo_adv_1057001_020",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "莽夫２",
    "words": "納命來吧！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "{0}你先退下！",
    "voice": "vo_adv_1057001_021",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n他們的目標是我。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "所以這裡只要由我……",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "莽夫１",
    "words": "這傢伙是想怎樣！",
    "voice": "vo_adv_1057001_022",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "莽夫１",
    "words": "我們要找的只有那個小鬼！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "莽夫１",
    "words": "\\n你不要礙事！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "{0}……！謝謝！",
    "voice": "vo_adv_1057001_023",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "……不過放心吧。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "接下來",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我會一個人處理好的。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "莽夫１",
    "words": "竟然敢在我面前說大話！",
    "voice": "vo_adv_1057001_024",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "莽夫１",
    "words": "接招！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "喝啊！",
    "voice": "vo_adv_1057001_025",
    "unit_id": 105711
  },
  {
    "type": "background",
    "bg_id": "500130"
  },
  {
    "type": "dialogue",
    "name": "莽夫１",
    "words": "唔啊啊！",
    "voice": "vo_adv_1057001_026",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "莽夫１",
    "words": "這傢伙，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "莽夫１",
    "words": "動作好快……！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "剩下一個人！",
    "voice": "vo_adv_1057001_027",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "噠啊！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "background",
    "bg_id": "500130"
  },
  {
    "type": "dialogue",
    "name": "莽夫２",
    "words": "嘎哈啊！",
    "voice": "vo_adv_1057001_028",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "莽夫２",
    "words": "怎、",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "莽夫２",
    "words": "怎麼回事！？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我想就不用再打下去了吧……",
    "voice": "vo_adv_1057001_029",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "要是你們還想繼續，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我就不會手下留情了！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "莽夫１",
    "words": "呿……！",
    "voice": "vo_adv_1057001_030",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "莽夫１",
    "words": "喂，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "莽夫１",
    "words": "走人了！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "莽夫２",
    "words": "可惡！",
    "voice": "vo_adv_1057001_031",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "莽夫２",
    "words": "給我記住！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "……",
    "voice": "vo_adv_1057001_032",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "呼。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "剛才謝謝你。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "有沒有受傷？",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "太好了……",
    "voice": "vo_adv_1057001_033",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "抱歉啊。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n把你捲進我引起的麻煩裡。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "他們說不定會帶同伴回來這裡，",
    "voice": "vo_adv_1057001_034",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n我們得立刻離開才行。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "話說回來他們真過分呢。",
    "voice": "vo_adv_1057001_035",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n明明是他們哄抬報酬我才能拿到工作的，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "卻反過來怨恨我。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "他們大概是認為能夠打倒我吧，",
    "voice": "vo_adv_1057001_036",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "別看我這樣子，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "好歹我也為了成為獨當一面的騎空士，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "每天都有在鍛鍊呢。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "你知道騎空士嗎？",
    "voice": "vo_adv_1057001_037",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "就是隸屬於騎空團，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n乘坐巨大的飛艇……",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "騎空艇，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n在世界各地冒險的人們……",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "你不知道，",
    "voice": "vo_adv_1057001_038",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "對吧……",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "最近也幾乎看不見騎空艇了……",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "……我的父親呢，",
    "voice": "vo_adv_1057001_039",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "是一名騎空士。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n現在正在這片大陸之外的地方冒險著。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "總有一天，",
    "voice": "vo_adv_1057001_040",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我也想要成為像父親一樣的騎空士……",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "於是我也成立了騎空團，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "成為騎空士。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "不過現在團員只有我一個，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "也沒有騎空艇就是了……",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "所以為了先存錢買艘騎空艇，",
    "voice": "vo_adv_1057001_041",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n我才會做各式各樣的工作，順便當作修行。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "然後……",
    "voice": "vo_adv_1057001_042",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "那個呢。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n剛才你幫我的時候，",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我想了想。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "要是有夥伴能像剛才一樣互相幫助",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "就好了呢……",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "拜託你！",
    "voice": "vo_adv_1057001_043",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "能不能加入我的騎空團呢！？",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我想要和你一起在空中冒險……",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n所以……！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "可以嗎……？",
    "voice": "vo_adv_1057001_044",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "太好了！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "是第一位夥伴──！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "啊，",
    "voice": "vo_adv_1057001_045",
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "抱歉！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "我太高興了就不禁……",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "嘿嘿。",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "\\n從今以後就請多指教了！{0}！",
    "voice": null,
    "unit_id": 105711
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}就這樣接受吉塔的邀約，\\n加入了騎空團開始以騎空士的身分活動。",
    "voice": null,
    "unit_id": null
  }
]
