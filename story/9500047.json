  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "啊啊，",
    "voice": "vo_adv_9500047_000",
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "{0}大人……",
    "voice": null,
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "您終於",
    "voice": null,
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "用明確的言語，",
    "voice": null,
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "表達出自己的心意了呢。",
    "voice": null,
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "您選擇了我，",
    "voice": null,
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "作為加深彼此羈絆，",
    "voice": null,
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "攜手走向永恆的伴侶……",
    "voice": null,
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "當然，",
    "voice": "vo_adv_9500047_001",
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我們命中注定要結為連理……",
    "voice": null,
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "即便如此……",
    "voice": null,
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "是啊，",
    "voice": null,
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "即便如此……！",
    "voice": null,
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n能夠接受您的愛，",
    "voice": null,
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "這份喜悅是無可取代的……",
    "voice": null,
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n嘻嘻嘻嘻嘻嘻，",
    "voice": null,
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "嘻嘻嘻嘻嘻嘻嘻嘻嘻！！",
    "voice": null,
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我當然很冷靜。",
    "voice": "vo_adv_9500047_002",
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "不過……",
    "voice": null,
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "即使這是終將到來的命運，",
    "voice": null,
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我仍盼望著您的愛。",
    "voice": null,
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n這份情感在我的心中，",
    "voice": null,
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "或許膨脹得比我所想的還要強烈……",
    "voice": null,
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "畢竟，我們一路走來，",
    "voice": "vo_adv_9500047_003",
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "曾一次又一次地受到各種阻礙。",
    "voice": null,
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n……",
    "voice": null,
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "這麼說來，",
    "voice": null,
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "現在也還有那樣的傢伙在外橫行。",
    "voice": null,
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n如果不解決掉那傢伙，",
    "voice": null,
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我們就無法迎來",
    "voice": null,
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "光明的未來……",
    "voice": null,
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "不過，",
    "voice": "vo_adv_9500047_004",
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "事到如今，",
    "voice": null,
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "已經不足為懼了。",
    "voice": null,
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n既然已經得到{0}大人的愛，",
    "voice": null,
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我根本不可能被打敗，",
    "voice": null,
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n連億分之一的可能性都沒有……",
    "voice": null,
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "嘻嘻嘻。",
    "voice": null,
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "…",
    "voice": "vo_adv_9500047_005",
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "…！！",
    "voice": null,
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "啊啊，",
    "voice": null,
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "{0}大人……♪",
    "voice": null,
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n我能感覺到大人的愛",
    "voice": null,
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "正漸漸流遍全身……！",
    "voice": null,
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "等一切結束後，",
    "voice": null,
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "請您再說一次",
    "voice": null,
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "剛才那番話。",
    "voice": null,
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "來吧，",
    "voice": "vo_adv_9500047_006",
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "事已至此，",
    "voice": null,
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "不會再給對方片刻喘息的時間……",
    "voice": null,
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "讓那可恨的龍女，",
    "voice": null,
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "還有",
    "voice": null,
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "全世界，",
    "voice": null,
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "都好好見識我們愛的羈絆！",
    "voice": null,
    "unit_id": 102741
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "嘻嘻嘻嘻嘻嘻嘻嘻嘻！！",
    "voice": null,
    "unit_id": 102741
  }
]
