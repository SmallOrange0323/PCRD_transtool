  {
    "type": "dialogue",
    "name": "旁白",
    "words": "因料理的話題而興趣相投的靜流與惠理子，\\n兩人有說有笑地逛著店內。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "對了對了，",
    "voice": "vo_adv_5011001_000",
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "在咖哩中加入這個的話，",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "味道會變得很濃郁非常美味喔！",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n弟弟也稱讚很好吃喔。",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "原來靜流有弟弟啊。",
    "voice": "vo_adv_5011001_001",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "你們感情真好真讓人羨慕，",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "嘻嘻。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "啊，",
    "voice": "vo_adv_5011001_002",
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "這裡有賣酒呀！？",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "正在找這瓶利口酒呢。",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "哎呀，",
    "voice": "vo_adv_5011001_003",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "真是巧。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我也正在找加入巧克力中的\\n利口酒。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "它的味道很香，是我喜歡的酒類……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "still",
    "still_id": "501100101"
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "咦……？",
    "voice": "vo_adv_5011001_004",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "啊……",
    "voice": "vo_adv_5011001_005",
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
