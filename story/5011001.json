  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "這話我可不能當作沒聽見。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "再說，",
    "voice": "vo_adv_5011001_018",
    "unit_id": 102711
