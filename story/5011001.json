  {
    "type": "dialogue",
    "name": "靜流",
    "words": "是啊，",
    "voice": "vo_adv_5011001_009",
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "而且上頭還寫了僅剩上架品。",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "still",
    "still_id": "501100102"
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我無論如何都需要這瓶酒。",
    "voice": "vo_adv_5011001_010",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "若是少了這個，",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我的巧克力會無法完成。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "那點我也一樣啊！",
    "voice": "vo_adv_5011001_011",
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我想把那個巧克力送給那位大人吃！",
    "voice": "vo_adv_5011001_012",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我也一樣，",
    "voice": "vo_adv_5011001_013",
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "想給弟弟吃好吃的巧克力啊！",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "既然是給弟弟的巧克力，可以不需要這麼講究呀！",
    "voice": "vo_adv_5011001_014",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n可以請妳把這瓶酒讓給我嗎？",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "我",
    "voice": "vo_adv_5011001_015",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "無論用什麼手段",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "都絕對要在情人節裡，",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "惠理子",
    "words": "讓{0}大人\\n吃到巧克力才行啊！",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "background",
    "bg_id": "500610"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "咦？　",
    "voice": "vo_adv_5011001_016",
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "等一下！",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "那個人，",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
