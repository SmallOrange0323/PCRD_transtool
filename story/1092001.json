    "type": "dialogue",
    "name": "安",
    "words": "這邊，",
    "voice": null,
    "unit_id": 109211
  },
  {
    "type": "dialogue",
    "name": "安",
    "words": "到處都是沒讀過的書耶！",
    "voice": null,
    "unit_id": 109211
  },
