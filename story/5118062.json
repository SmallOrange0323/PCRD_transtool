  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "[FFFFFFFF]吉塔等人今天也來到跳蚤市場。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "[FFFFFFFF]\\n然後，突然有人從某個攤位上叫了{0}的名字。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "[FFFFFFFF]王子先生～",
    "voice": "vo_adv_5118062_000",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "[FFFFFFFF]\\n這邊這邊～",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]王子先生！？",
    "voice": "vo_adv_5118062_001",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "[FFFFFFFF]是的，",
    "voice": "vo_adv_5118062_002",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "[FFFFFFFF]他是真步真步王國的王子先生♪",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "[FFFFFFFF]王子先生也來了啊。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "[FFFFFFFF]\\n而且……",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "[FFFFFFFF]還是跟這～麼可愛的女孩子一起。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]可、",
    "voice": "vo_adv_5118062_003",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]可愛……？",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "[FFFFFFFF]王子先生很受歡迎",
    "voice": "vo_adv_5118062_004",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "[FFFFFFFF]是很令人驕傲……",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "[FFFFFFFF]但是丟下人家，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "[FFFFFFFF]跑去約會……",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "[FFFFFFFF]王子先生真是壞心眼呢。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]約……！？",
    "voice": "vo_adv_5118062_005",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]不、",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]不是那樣的！",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]\\n我們只是同個騎空團的夥伴，",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]並不是妳想的那樣……！",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "[FFFFFFFF]呵呵，",
    "voice": "vo_adv_5118062_006",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "[FFFFFFFF]別那麼慌張啦～",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "[FFFFFFFF]\\n人家只是開個小玩笑♪",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "[FFFFFFFF]在那之後──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "[FFFFFFFF]\\n吉塔和真步重新自我介紹。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "[FFFFFFFF]\\n在互相了解對方後，吉塔詢問關於真步攤位的事。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]話說，",
    "voice": "vo_adv_5118062_007",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]真步的攤位都在賣些什麼呢？",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "[FFFFFFFF]是賣玩偶和衣服喔～♪",
    "voice": "vo_adv_5118062_008",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "[FFFFFFFF]\\n人家想說可以貼補【哞哞自衛隊】的預算。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "[FFFFFFFF]這全都是人家手工製的，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "[FFFFFFFF]外面可～是買不到的唷～",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]全是妳手工製的？",
    "voice": "vo_adv_5118062_009",
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]好厲害，",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]妳的手真靈巧！",
    "voice": null,
    "unit_id": 105712
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "[FFFFFFFF]謝謝誇獎～♪",
    "voice": "vo_adv_5118062_010",
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "[FFFFFFFF]有看上什麼",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "[FFFFFFFF]就別客氣盡量說，",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "[FFFFFFFF]吉塔小姐。",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "[FFFFFFFF]\\n",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "真步",
    "words": "[FFFFFFFF]想修改衣服也包在人家身上～",
    "voice": null,
    "unit_id": 101011
  },
  {
    "type": "dialogue",
    "name": "吉塔",
    "words": "[FFFFFFFF]謝謝妳！",
