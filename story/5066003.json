  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "祈梨成為【龍族巢穴】的新老大之後過了幾天。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那我現在來發表新制度！",
    "voice": "vo_adv_5066003_000",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n嘉夜夜",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "要繼續當幹部扶持我！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "小哥",
    "voice": "vo_adv_5066003_001",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "則在我身邊服侍我！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n有誰有意見嗎？",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "沒有異議！",
    "voice": "vo_adv_5066003_002",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流氓2",
    "words": "沒有異議！",
    "voice": "vo_adv_5066003_003",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "喂喂，",
    "voice": "vo_adv_5066003_004",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這樣沒關係嗎……",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "然後！",
    "voice": "vo_adv_5066003_005",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我不再是從前的可愛龍龍了……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "如今我是超越老大的存在──",
    "voice": "vo_adv_5066003_006",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "Big Boss",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "祈梨大人！",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "流氓們",
    "words": "Big Boss！",
    "voice": "vo_adv_5066003_007",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "流氓們",
    "words": "Big Boss！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "總之你先來",
    "voice": "vo_adv_5066003_008",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "替我揉揉肩膀。",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "是！",
    "voice": "vo_adv_5066003_009",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "嗯嗯，",
    "voice": "vo_adv_5066003_010",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "你按得挺好的。",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "下次交易就交給你啦。",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "啊，",
    "voice": "vo_adv_5066003_011",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "謝謝老大！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "說到交易，",
    "voice": "vo_adv_5066003_012",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "前幾天採購點心真是戰果豐碩呀。",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "可以想買就買真是太讚了！",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……哎呀？",
    "voice": "vo_adv_5066003_013",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我想起來了，點心快不夠吃了。",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那邊那個！",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "你去買些點心回來！",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "流氓2",
    "words": "是！",
    "voice": "vo_adv_5066003_014",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流氓2",
    "words": "我這就去買！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "對了，",
    "voice": "vo_adv_5066003_015",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這樣太麻煩了，直接把整間店買下來也不錯呀！",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n把它變成我的專用店好了！",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n你先跑一趟",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "去跟他們交涉！",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "流氓2",
    "words": "是！",
    "voice": "vo_adv_5066003_016",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流氓2",
    "words": "包在我身上！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "呵呵呵，",
    "voice": "vo_adv_5066003_017",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "對現在已經成為大咖的我來說……",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "老大的椅子坐起來還不賴呀。",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那麼，",
    "voice": "vo_adv_5066003_018",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "今天也要辦就職派對喔！",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n快去準備！",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "流氓3",
    "words": "是，",
    "voice": "vo_adv_5066003_019",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "流氓3",
    "words": "馬上辦！",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "哈～哈哈哈哈～！",
    "voice": "vo_adv_5066003_020",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n超棒的啦～！",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這下看來，",
    "voice": "vo_adv_5066003_021",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "她很明顯地又得意忘形了啊……",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "如果關鍵的祈梨是這副德性，暫時也回不去吧？",
    "voice": "vo_adv_5066003_022",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "算了，",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "先觀察一陣子看看……",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "嘉夜夜！",
    "voice": "vo_adv_5066003_023",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "小哥！",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "要去派對會場了喔！",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n快點快點！",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "好好好。",
    "voice": "vo_adv_5066003_024",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "知道了。",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n話說妳那是",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "什麼打扮啊……",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "怎麼樣？",
    "voice": "vo_adv_5066003_025",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "是不是很帥！？",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "是是是，",
    "voice": "vo_adv_5066003_026",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "很帥啊。",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……對喔，",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n畢竟妳是從形式開始著手的類型嘛……",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "知道就好！",
    "voice": "vo_adv_5066003_027",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "知道就好！",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "呵呵呵，",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "前老大也沒有要回來的意思……",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n這就是",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "所謂的黃金時期啦～！",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "那之後又過了幾天，公會小屋裡傳出祈梨震天的怒吼聲。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這……",
    "voice": "vo_adv_5066003_028",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這是什麼狀況啊！",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我說呀！",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "非、",
    "voice": "vo_adv_5066003_029",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "非常抱歉！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "\\n都、",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "都是我的錯……",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "唉……",
    "voice": "vo_adv_5066003_030",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "所以你乖乖去跟人交易，",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n結果上當了，被人塞了破爛玩意嗎？",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這、",
    "voice": "vo_adv_5066003_031",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這次交易",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我投入了巨額的公會資金呀。",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n這這、",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這下子會怎麼樣？",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "流氓2",
    "words": "這個嘛，",
    "voice": "vo_adv_5066003_032",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流氓2",
    "words": "交易對象已經逃得只剩空殼了……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流氓3",
    "words": "而且這次的事情",
    "voice": "vo_adv_5066003_033",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "流氓3",
    "words": "不知不覺間",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "流氓3",
    "words": "在這一帶傳開了……",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "流氓3",
    "words": "\\n",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "流氓3",
    "words": "我們徹底淪為笑柄了啊！",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "事已至此，",
    "voice": "vo_adv_5066003_034",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "我只有切腹謝罪了啊啊啊！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流氓2",
    "words": "你、",
    "voice": "vo_adv_5066003_035",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流氓2",
    "words": "你這傢伙……！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "流氓3",
    "words": "唔喔喔喔！",
    "voice": "vo_adv_5066003_036",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "流氓3",
    "words": "那我也",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "流氓3",
    "words": "跟他同罪！",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……唉。",
    "voice": "vo_adv_5066003_037",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……",
    "voice": "vo_adv_5066003_038",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "妳好像有什麼話想說呢。",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "沒啦。",
    "voice": "vo_adv_5066003_039",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "只是在想",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "如果是之前的老大，",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "應該會在演變成這樣之前",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n就看出端倪吧。",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "嘉夜夜……",
    "voice": "vo_adv_5066003_040",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "怎麼了？",
    "voice": "vo_adv_5066003_041",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……我有些話要跟妳說。",
    "voice": "vo_adv_5066003_042",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n你們先去外面等。",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "老大……",
    "voice": "vo_adv_5066003_043",
    "unit_id": 811
  },
  {
    "type": "background",
    "bg_id": "501330"
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "所以",
    "voice": "vo_adv_5066003_044",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "妳想說什麼？",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "我想請妳叫出時間管理員。",
    "voice": "vo_adv_5066003_045",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "喔，",
    "voice": "vo_adv_5066003_046",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "總算不想當老大，",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "打算回去了嗎？",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "不是啦！",
    "voice": "vo_adv_5066003_047",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n我只是不能接受就這樣到最後都被瞧不起而已！",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n我要回到交易之前",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "阻止它發生！",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "唉，",
    "voice": "vo_adv_5066003_048",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這樣啊。",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我知道了。",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "老是被瞧不起也不合我的個性。",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n喂，",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "時間管理員！",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你聽得到吧？",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "時間管理員",
    "words": "主人，",
    "voice": "vo_adv_5066003_049",
    "unit_id": 14611
  },
  {
    "type": "dialogue",
    "name": "時間管理員",
    "words": "請問有什麼事？",
    "voice": null,
    "unit_id": 14611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我們有事情要辦，",
    "voice": "vo_adv_5066003_050",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "麻煩你打開時光隧道。",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "時間管理員",
    "words": "即將啟動時間儀。",
    "voice": "vo_adv_5066003_051",
    "unit_id": 14611
  },
  {
    "type": "dialogue",
    "name": "時間管理員",
    "words": "\\n請進入時空之門。",
    "voice": null,
    "unit_id": 14611
  },
  {
    "type": "background",
    "bg_id": "501290"
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "目標是交易當天！",
    "voice": "vo_adv_5066003_052",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "就是這樣，",
    "voice": "vo_adv_5066003_053",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "拜託了。",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "時間管理員",
    "words": "即將啟動時間儀。",
    "voice": "vo_adv_5066003_054",
    "unit_id": 14611
  },
  {
    "type": "dialogue",
    "name": "時間管理員",
    "words": "\\n請進入時空之門。",
    "voice": null,
    "unit_id": 14611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "走囉，嘉夜夜！",
    "voice": "vo_adv_5066003_055",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n突擊！",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "background",
    "bg_id": "500610"
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "很好，",
    "voice": "vo_adv_5066003_056",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "到了……",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "喂，",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "祈梨，",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n情況有點奇怪。",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "過去祈梨",
    "words": "嘉夜夜？",
    "voice": "vo_adv_5066003_057",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "過去祈梨",
    "words": "怎麼了？",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不，",
    "voice": "vo_adv_5066003_058",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這裡是……",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "過去嘉夜",
    "words": "祈梨？",
    "voice": "vo_adv_5066003_059",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "過去嘉夜",
    "words": "妳叫我嗎？",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "跑出其他的我和嘉夜夜了唷！？",
    "voice": "vo_adv_5066003_060",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n不對，",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這個不是",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "過去的我們嗎！？",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "過去祈梨",
    "words": "怎、",
    "voice": "vo_adv_5066003_061",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "過去祈梨",
    "words": "怎麼回事、怎麼回事？",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "過去嘉夜",
    "words": "那是",
    "voice": "vo_adv_5066003_062",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "過去嘉夜",
    "words": "我們嗎？",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "話說這裡",
    "voice": "vo_adv_5066003_063",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不就是前陣子整間買下來的點心店嗎！",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "糟了，",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "快出去！",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "知、",
    "voice": "vo_adv_5066003_064",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "知道了！",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "小哥也快走！",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "background",
    "bg_id": "500890"
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "為什麼會出現在那種地方呀？",
    "voice": "vo_adv_5066003_065",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n嘉夜夜，",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "妳是不是疏忽什麼了？",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "時間就如我們指定的，",
    "voice": "vo_adv_5066003_066",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "可是地點弄錯了啦！",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "可惡，",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "再耗下去交易要開始了啊！",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "喂，管理員！",
    "voice": "vo_adv_5066003_067",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n為什麼不送我們去交易對象那邊？",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n之前不是都會出現在我們想要的地點嗎！",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "時間管理員",
    "words": "由於未輸入空間座標，",
    "voice": "vo_adv_5066003_068",
    "unit_id": 14611
  },
  {
    "type": "dialogue",
    "name": "時間管理員",
    "words": "\\n因此將同時間點的主人",
    "voice": null,
    "unit_id": 14611
  },
  {
    "type": "dialogue",
    "name": "時間管理員",
    "words": "套用為錨點了。",
    "voice": null,
    "unit_id": 14611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那就是嘉夜夜疏忽了呀！",
    "voice": "vo_adv_5066003_069",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n不過",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "先不論那個，",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n一般來說這麼重要的事你應該要跟我們確認清楚！",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "時間管理員",
    "words": "我並無指定",
    "voice": "vo_adv_5066003_070",
    "unit_id": 14611
  },
  {
    "type": "dialogue",
    "name": "時間管理員",
    "words": "未輸入事項的權限。",
    "voice": null,
    "unit_id": 14611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這件事的確是嘉夜夜呆呆沒錯，",
    "voice": "vo_adv_5066003_071",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "但你也太死腦筋了！",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "啊──好嘛，",
    "voice": "vo_adv_5066003_072",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "是我不好！",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不過趕時間更重要，",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "祈梨！",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n總之能阻止交易就沒事了！",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "這場交易",
    "voice": "vo_adv_5066003_073",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "給我等一下！",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "老大？",
    "voice": "vo_adv_5066003_074",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "怎麼了嗎？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "\\n不是叫我今天去收購點心……",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "交易的事怎麼樣了？",
    "voice": "vo_adv_5066003_075",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "剛剛正好結束啊。",
    "voice": "vo_adv_5066003_076",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "\\n你們看，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "這個……",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "你看仔細！",
    "voice": "vo_adv_5066003_077",
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "那是沒用的破爛喔！",
    "voice": null,
    "unit_id": 116511
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "咦、",
    "voice": "vo_adv_5066003_078",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "咦咦咦咦？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "交易對象跑去哪了？",
    "voice": "vo_adv_5066003_079",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "往、",
    "voice": "vo_adv_5066003_080",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "流氓1",
    "words": "往那邊去了……",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我們追，祈梨！",
    "voice": "vo_adv_5066003_081",
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "趕快召集大家！",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n別讓對方逃了啊！",
    "voice": null,
    "unit_id": 116611
  },
  {
    "type": "dialogue",
