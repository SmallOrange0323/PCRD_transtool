[
  {
    "type": "background",
    "bg_id": "501890"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "深月的密醫形象傳遍館內，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n今天年初診所依然熱鬧非凡。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "多虧有醫生在，",
    "voice": "vo_adv_1247003_000",
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "地新會的客人們都～",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "很放心。",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "\\n",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "氣氛越來越熱烈，",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "簡直變成無法地帶了。",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "\\n",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "因為會點很多酒和料理，",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "我們倒是高興到尖叫就是了。",
    "voice": null,
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "哎呀，",
    "voice": "vo_adv_1247003_001",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "那真是太好了。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "無法地帶，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我也超喜歡的。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n盡情地把患者帶過來吧。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "領班",
    "words": "遵命！",
    "voice": "vo_adv_1247003_002",
    "unit_id": 1412
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "另一方面，一般溫泉顧客們──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客1",
    "words": "雖然技術確實很高超，",
    "voice": "vo_adv_1247003_003",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客1",
    "words": "\\n但沒想到，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客1",
    "words": "竟然是密醫……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客1",
    "words": "\\n還是別扯上關係比較好。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客2",
    "words": "對啊。",
    "voice": "vo_adv_1247003_004",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客2",
    "words": "\\n那身服裝，",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客2",
    "words": "仔細一瞧也很不正經啊。",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客1",
    "words": "還有眼罩，",
    "voice": "vo_adv_1247003_005",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客1",
    "words": "仔細一想挺恐怖的呢……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客2",
    "words": "孩子們！",
    "voice": "vo_adv_1247003_006",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客2",
    "words": "不可以接近那個人！",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "是啊，",
    "voice": "vo_adv_1247003_007",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這個距離感，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "就算稱作心理隔閡也不為過了呢。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n看來他們終於知道",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我既不是他們的放鬆場所也不是彈弓了。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這樣才是密醫，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "是我應有的姿態。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "好了，",
    "voice": "vo_adv_1247003_008",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "要繼續暗中活躍囉──",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "小深……？",
    "voice": "vo_adv_1247003_009",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n小深！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n妳果然是小深哪！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……！？",
    "voice": "vo_adv_1247003_010",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "是誰？",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "事到如今，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "還用這名字稱呼我的無禮之人──",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "小深！",
    "voice": "vo_adv_1247003_011",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n是我啊，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "是我。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "…………！！！！",
    "voice": "vo_adv_1247003_012",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "沒錯。",
    "voice": "vo_adv_1247003_013",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n我就是小深老家",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "斜對面開懷舊零食店的",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "那個老婆婆啊。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "哎呀～",
    "voice": "vo_adv_1247003_014",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "小深長大了呢！",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "最後一次見面時，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "妳明明",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "才這～麼小而已呢。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "變得如此出色，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "我都要認不出來了呢。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "我啊，",
    "voice": "vo_adv_1247003_015",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "是參加老人會的慰勞旅行來這裡住的。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "小深也是來這裡過年嗎？",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "咦？",
    "voice": "vo_adv_1247003_016",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "啊，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不……",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "哎呀哎呀，",
    "voice": "vo_adv_1247003_017",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "各位是小深的夥伴嗎？",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "小深平時受你們照顧了。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "這個，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "雖然是賣剩的零食，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "請拿一個吧～",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客們",
    "words": "（交頭接耳……！）",
    "voice": "vo_adv_1247003_018",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客2",
    "words": "怎麼會有這麼好的老婆婆……",
    "voice": "vo_adv_1247003_019",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客2",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客2",
    "words": "是那個密醫的熟人嗎？",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客2",
    "words": "真叫人意外……",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "這位也是嗎？",
    "voice": "vo_adv_1247003_020",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "請拿一個吧～",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "患者們",
    "words": "（交頭接耳……！）",
    "voice": "vo_adv_1247003_021",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "患者1",
    "words": "喂、",
    "voice": "vo_adv_1247003_022",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "患者1",
    "words": "喂……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "患者1",
    "words": "這種場面，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "患者1",
    "words": "\\n我們是不是不該在場啊……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "患者2",
    "words": "是啊。",
    "voice": "vo_adv_1247003_023",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "患者2",
    "words": "\\n正因為是地下社會的人，",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "患者2",
    "words": "才更應該要會看氣氛……",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "患者2",
    "words": "這是頭目的教誨。",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "患者2",
    "words": "\\n我們悄悄溜走吧。",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "等、",
    "voice": "vo_adv_1247003_024",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "等等！",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n別溜走啊。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不……",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不是這樣的！",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這種溫馨的情節展開……",
    "voice": "vo_adv_1247003_025",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不妙，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "太不妙了。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這下我拚命建立起的",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "密醫形象就要……！　",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "婆、",
    "voice": "vo_adv_1247003_026",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "婆婆？",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n雖然很可惜，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "您是不是認錯人了呢？",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "因為我",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "從出生到現在",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "從來沒被人叫做",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "「小深」過啊。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "哎呀！",
    "voice": "vo_adv_1247003_027",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "是這樣啊。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "那我真是失禮了。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n畢竟上了年紀，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "請原諒我吧。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……呼。",
    "voice": "vo_adv_1247003_028",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不會，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "沒關係的，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "是剛好長得像吧。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "畢竟瀏海長的女性有很多嘛。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客1",
    "words": "喂，",
    "voice": "vo_adv_1247003_029",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客1",
    "words": "說是認錯人了耶。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客1",
    "words": "\\n難怪……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客1",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客1",
    "words": "那個密醫",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客1",
    "words": "哪可能認識這麼和善的人嘛。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "患者1",
    "words": "什麼嘛，",
    "voice": "vo_adv_1247003_030",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "患者1",
    "words": "原來是這樣啊。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "患者1",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "患者1",
    "words": "那麼，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "患者1",
    "words": "我們待著",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "患者1",
    "words": "也沒關係囉。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……安全過關。",
    "voice": "vo_adv_1247003_031",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "好了，",
    "voice": "vo_adv_1247003_032",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "婆婆，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "您住哪個房間？",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "該回去了吧。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "嗯？",
    "voice": "vo_adv_1247003_033",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "但這麼成熟的聲音……",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "從小時候就沒變過……",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "妳果然",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "的確是小深──",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "領班先生！",
    "voice": "vo_adv_1247003_034",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n請帶這位婆婆回房間！",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "我想起來了！",
    "voice": "vo_adv_1247003_035",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "咦……",
    "voice": "vo_adv_1247003_036",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "妳頭上戴的那個是",
    "voice": "vo_adv_1247003_037",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "薔薇對吧？",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "小深",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "從小就最喜歡薔薇了啊。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n妳",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "果然是小深！",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "妳今天穿的小洋裝，",
    "voice": "vo_adv_1247003_038",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "還有戴著的頭巾，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "都是妳最喜歡的薔薇樣式呢。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "很適合妳喔～",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我說，",
    "voice": "vo_adv_1247003_039",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這不是小洋裝，是和服……",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n也不是頭巾，是眼罩……",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "妳從小",
    "voice": "vo_adv_1247003_040",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "無論是襯衫還是襯衣",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "都是薔薇花樣的……",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "就連帽子、",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "襪子、",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "還有傘也都是薔薇花樣。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不，",
    "voice": "vo_adv_1247003_041",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我說啊……",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "所以……",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "噢對了，",
    "voice": "vo_adv_1247003_042",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "就連尿布──",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "哪有小孩的尿布是薔薇花樣的，很奇怪吧！",
    "voice": "vo_adv_1247003_043",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n襯衫和襯衣是薔薇花樣的沒錯，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "但其他的很普通啦，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "是素色的！",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "是這樣嗎……",
    "voice": "vo_adv_1247003_044",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "……啊，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "對了，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "說到薔薇！",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "小深",
    "voice": "vo_adv_1247003_045",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "從以前就最喜歡玩醫生遊戲了呢。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n把朋友當作患者，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "經常在",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "角落的空地玩呢。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我說，這跟薔薇",
    "voice": "vo_adv_1247003_046",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "有關係嗎？",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n這話題是打哪來的啊？",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "對了對了，",
    "voice": "vo_adv_1247003_047",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "那時妳還不太會講呢，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "講「醫生」。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n總是「伊森、",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "伊森」的，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "說得口齒不清……",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "到不久之前都還是這樣呢。",
    "voice": "vo_adv_1247003_048",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "怎麼可能啊！",
    "voice": "vo_adv_1247003_049",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "您到底以為我幾歲啊！",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n雖然很不想說，",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "但我好歹也老大不小了喔？",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n會說成「伊森」……應該也頂多是10歲之前的事了吧！？",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "是這樣嗎……",
    "voice": "vo_adv_1247003_050",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "不過啊……",
    "voice": "vo_adv_1247003_051",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "小深？",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "意外地就只有歲數",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "是無法蒙混過去的。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n並非年輕才是正義喔？",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不，",
    "voice": "vo_adv_1247003_052",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我沒有蒙混啊？",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n我什麼時候",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "試圖蒙混歲數──",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這種說法，就算是找碴",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "也很惡劣耶？",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "是啊……",
    "voice": "vo_adv_1247003_053",
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "但我是站在小深你這邊的喔？",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "不是有老話說，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "就算怎麼看都是方形年糕，",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n只要堅持說那是圓形年糕，它就會是圓形年糕。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "加油。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "拜託，這種事不用鼓勵我。",
