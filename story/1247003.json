  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "我塞進你的手套裡了～",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "老奶奶",
    "words": "\\n你已經逃不了了。",
    "voice": null,
    "unit_id": 611
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "什……",
    "voice": "vo_adv_1247003_089",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "什",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……！",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "回去！",
    "voice": "vo_adv_1247003_090",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "婆婆妳快回去啦～！",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n妳不回去的話……",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我就幫您注射，讓您那過度活動的神經突觸",
    "voice": "vo_adv_1247003_091",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "進入永眠！",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n露出您的靜脈，靜脈～！",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "患者2",
    "words": "哈哈哈。",
    "voice": "vo_adv_1247003_092",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "患者2",
    "words": "\\n小深，",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "患者2",
    "words": "連耳朵都變得紅通通的。",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "患者2",
    "words": "\\n所有事情都曝光了呢。",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "患者1",
    "words": "對啊。",
    "voice": "vo_adv_1247003_093",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "患者1",
    "words": "\\n雖說是密醫，但這樣",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "患者1",
    "words": "也就是個姑娘而已。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "患者1",
    "words": "哈哈哈哈。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "老婆婆就這樣",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n把深月不像密醫的溫暖小插曲全都暴露出來，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n好不容易才肯罷休。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "然後──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "124700101"
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客2",
    "words": "醫生，",
    "voice": "vo_adv_1247003_094",
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客2",
    "words": "妳",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客2",
    "words": "果然是個好姑娘呢～",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客2",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客2",
    "words": "聽說妳從小",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客2",
    "words": "就非常喜歡薔薇？",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客2",
    "words": "\\n",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客2",
    "words": "這身和服與眼罩",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客2",
    "words": "也非常適合妳哦～",
    "voice": null,
    "unit_id": 1511
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客1",
    "words": "喂，小兄弟，",
    "voice": "vo_adv_1247003_095",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客1",
    "words": "這麼好的姑娘，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客1",
    "words": "你可不能放手喔？",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客1",
    "words": "\\n知道嗎？",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客1",
    "words": "喂喂，",
    "voice": "vo_adv_1247003_096",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客1",
    "words": "你在害羞嗎？",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客1",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客1",
    "words": "不過我同意。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客1",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客1",
    "words": "小深醫生",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "溫泉顧客1",
    "words": "毫無疑問是個好醫生！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "孩子們",
    "words": "小深！",
    "voice": "vo_adv_1247003_097",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "孩子們",
    "words": "\\n小深！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "一夥",
    "words": "啊哈哈哈哈！",
    "voice": "vo_adv_1247003_098",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……哈哈",
    "voice": "vo_adv_1247003_099",
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "哈哈哈哈。",
    "voice": null,
    "unit_id": 124711
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "密醫的形象被破壞得體無完膚，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n深月也只能乾笑了。",
    "voice": null,
    "unit_id": null
  },
