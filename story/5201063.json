  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這孩子……",
    "voice": "vo_adv_5201063_000",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "就",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "放在這邊好了。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "咦，",
    "voice": "vo_adv_5201063_001",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "似似花妳又買了嗎？",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n變色龍玩偶。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "嗯。",
    "voice": "vo_adv_5201063_002",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n很可愛對吧。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "咦？",
    "voice": "vo_adv_5201063_003",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "啊～",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "嗯。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n把親近的東西放在身邊尋求心靈安定",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n在醫學上也是個很好的方法呢，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "我覺得工作效率也會跟著提升喔。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我沒有問妳",
    "voice": "vo_adv_5201063_004",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "醫學上的見解。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "啊哈哈，",
    "voice": "vo_adv_5201063_005",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "那真是抱歉。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n我是覺得",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "很可愛啦。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n莫非妳",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "還有為這些孩子取名字嗎？",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "名字嗎？",
    "voice": "vo_adv_5201063_006",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "沒有呢。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "那不太好喔。",
    "voice": "vo_adv_5201063_007",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n名字很重要的吧，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "畢竟看妳",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "買了這麼多隻。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "是這樣子的嗎？",
    "voice": "vo_adv_5201063_008",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我覺得沒有特別需要──",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "凱思帕魯格，",
    "voice": "vo_adv_5201063_009",
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "就這個吧。",
    "voice": null,
    "unit_id": 107131
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "說什麼呢，克莉絲，",
    "voice": "vo_adv_5201063_010",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這麼突然。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "我並沒有在募集名字。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "迦羅求羅",
    "voice": "vo_adv_5201063_011",
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "拉基尼卡東",
    "words": "就可以了吧。",
    "voice": null,
    "unit_id": 107331
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "怎麼連教授你也來湊熱鬧。",
    "voice": "vo_adv_5201063_012",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "就說了我沒有要名字──",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "大家取的名字都有點難懂啊，",
    "voice": "vo_adv_5201063_013",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "是不是有點缺乏記憶點？",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "既然是似似花的變色龍，",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "就是似似龍吧。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n不錯吧？",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "似似龍。",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "……………………………………",
    "voice": "vo_adv_5201063_014",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "這種名字是想讓人記住什麼啊？",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "我都聽見了喔～？",
    "voice": "vo_adv_5201063_015",
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "不然",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "真那你會取什麼樣的名字呢～？",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "\\n想必",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "有個了不起的",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "好名字",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "晶",
    "words": "在等著拿出來對吧？",
    "voice": null,
    "unit_id": 106831
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "哈，",
    "voice": "vo_adv_5201063_016",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "無聊。",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "無機物需要什麼名字嗎？",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "你們的遊戲我可沒有興趣。",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "沒錯，",
    "voice": "vo_adv_5201063_017",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "真那說得對──",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "不然就叫希留耶好了？",
    "voice": "vo_adv_5201063_018",
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "\\n",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "真那",
    "words": "我隨便想的名字。",
    "voice": null,
    "unit_id": 106931
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "結果還是要參加的話",
    "voice": "vo_adv_5201063_019",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "有必要先說自己沒有興趣嗎，",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "真那？　",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "現士實似似花啊。",
    "voice": "vo_adv_5201063_020",
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……莫非連長老你也想參加？",
    "voice": "vo_adv_5201063_021",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "不，",
    "voice": "vo_adv_5201063_022",
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "我就不參加了。",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "\\n",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "比起這些，",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "有人要我傳話給妳。",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "不參加……",
    "voice": "vo_adv_5201063_023",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "太好了。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "\\n不會再繼續增加──",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……傳話？",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "是誰……？",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "「現士實",
    "voice": "vo_adv_5201063_024",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "高冠。」",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "是「她」的提案。",
    "voice": "vo_adv_5201063_025",
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "…………",
    "voice": "vo_adv_5201063_026",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "……所以說，",
    "voice": "vo_adv_5201063_027",
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "怎麼辦？",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "\\n既然大家都提出意見，",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "就該一起來好好決定了。",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "七冠們",
    "words": "…………",
    "voice": "vo_adv_5201063_028",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "……格列戈爾。",
    "voice": "vo_adv_5201063_029",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "七冠們",
    "words": "！？",
    "voice": "vo_adv_5201063_030",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "這孩子的名字",
    "voice": "vo_adv_5201063_031",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "是格列戈爾。",
    "voice": null,
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "似似花啊，",
    "voice": "vo_adv_5201063_032",
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "也該考慮其他意見──",
    "voice": null,
    "unit_id": 107231
  },
  {
    "type": "dialogue",
    "name": "似似花",
    "words": "格列戈爾。",
    "voice": "vo_adv_5201063_033",
    "unit_id": 107031
  },
  {
    "type": "dialogue",
    "name": "宙",
    "words": "……那就格列戈爾。",
    "voice": "vo_adv_5201063_034",
    "unit_id": 107231
  }
]
