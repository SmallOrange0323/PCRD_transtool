[
    {
        "type": "background",
        "bg_id": "501070"
    },
    {
        "name": "純",
        "words": "唷，",
        "voice": "vo_adv_2103002_000"
    },
    {
        "name": "純",
        "words": "小咲戀。",
        "voice": null
    },
    {
        "name": "純",
        "words": "\\n好一陣子沒見面了呢。",
        "voice": null
    },
    {
        "name": "貪吃佩可",
        "words": "還讓妳特地跑到王宮一趟，",
        "voice": "vo_adv_2103002_001"
    },
    {
        "name": "貪吃佩可",
        "words": "真的非常感謝妳！",
        "voice": null
    },
    {
        "name": "咲戀",
        "words": "您太客氣了，",
        "voice": "vo_adv_2103002_002"
    },
    {
        "name": "咲戀",
        "words": "尤絲蒂亞娜陛下。",
        "voice": null
    },
    {
        "name": "咲戀",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "咲戀",
        "words": "畢竟也並非說是不相識，",
        "voice": null
    },
    {
        "name": "咲戀",
        "words": "\\n若您有所望",
        "voice": null
    },
    {
        "name": "咲戀",
        "words": "下人必當前來拜見。",
        "voice": null
    },
    {
        "name": "咲戀",
        "words": "而且……",
        "voice": null
    },
    {
        "name": "咲戀",
        "words": "自從您回歸公主的身分後，",
        "voice": "vo_adv_2103002_003"
    },
    {
        "name": "咲戀",
        "words": "還是首次有機會",
        "voice": null
    },
    {
        "name": "咲戀",
        "words": "前來晉見陛下。",
        "voice": null
    },
    {
        "name": "咲戀",
        "words": "\\n於此再次鄭重地向您稟報……",
        "voice": null
    },
    {
        "name": "咲戀",
        "words": "我是【咲戀育幼院】的公會長，",
        "voice": null
    },
    {
        "name": "咲戀",
        "words": "名為咲戀。",
        "voice": null
    },
    {
        "name": "咲戀",
        "words": "\\n對於陛下能重回王座，",
        "voice": null
    },
    {
        "name": "咲戀",
        "words": "個人衷心地感到與有榮焉",
        "voice": null
    },
    {
        "name": "咲戀",
        "words": "並獻上最深的祝賀。",
        "voice": null
    },
    {
        "name": "貪吃佩可",
        "words": "呃……",
        "voice": "vo_adv_2103002_004"
    },
    {
        "name": "貪吃佩可",
        "words": "咲戀小姐。",
        "voice": null
    },
    {
        "name": "貪吃佩可",
        "words": "如果妳不介意的話。",
        "voice": null
    },
    {
        "name": "貪吃佩可",
        "words": "\\n那麼見外的話，",
        "voice": null
    },
    {
        "name": "貪吃佩可",
        "words": "可不可以就扔到一邊去了呢？",
        "voice": null
    },
    {
        "name": "貪吃佩可",
        "words": "\\n畢竟現在這裡，",
        "voice": null
    },
    {
        "name": "貪吃佩可",
        "words": "只有我們幾個在而已嘛。",
        "voice": null
    },
    {
        "name": "咲戀",
        "words": "……呵呵。",
        "voice": "vo_adv_2103002_005"
    },
    {
        "name": "咲戀",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "咲戀",
        "words": "距離我還在王宮內就職時",
        "voice": null
    },
    {
        "name": "咲戀",
        "words": "也過了好一段時間嘛，",
        "voice": null
    },
    {
        "name": "咲戀",
        "words": "\\n妳可以願意讓我不用這麼在意談吐，",
        "voice": null
    },
    {
        "name": "咲戀",
        "words": "對我來說",
        "voice": null
    },
    {
        "name": "咲戀",
        "words": "倒真是幫了大忙。",
        "voice": null
    },
    {
        "name": "純",
        "words": "但畢竟妳可是那位小咲戀，",
        "voice": "vo_adv_2103002_006"
    },
    {
        "name": "純",
        "words": "若是談到禮儀與作法……",
        "voice": null
    },
    {
        "name": "純",
        "words": "\\n即便是如今，",
        "voice": null
    },
    {
        "name": "純",
        "words": "也比隨便哪位貴族都能做得更完美吧。",
        "voice": null
    },
    {
        "name": "純",
        "words": "\\n同時包括這份謙遜，",
        "voice": null
    },
    {
        "name": "純",
        "words": "妳也依舊沒什麼變呢。",
        "voice": null
    },
    {
        "name": "咲戀",
        "words": "真是的。",
        "voice": "vo_adv_2103002_007"
    },
    {
        "name": "咲戀",
        "words": "\\n加了『小』這個稱呼就饒了我吧，",
        "voice": null
    },
    {
        "name": "咲戀",
        "words": "純。",
        "voice": null
    },
    {
        "name": "咲戀",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "咲戀",
        "words": "妳才是，",
        "voice": null
    },
    {
        "name": "咲戀",
        "words": "我才想說妳真的一點都沒變呢。",
        "voice": null
    },
    {
        "name": "純",
        "words": "失禮了，",
        "voice": "vo_adv_2103002_008"
    },
    {
        "name": "純",
        "words": "一不注意。",
        "voice": null
    },
    {
        "name": "純",
        "words": "\\n……總覺得，",
        "voice": null
    },
    {
        "name": "純",
        "words": "光是這段交談就很令人懷念了呢。",
        "voice": null
    },
    {
        "name": "純",
        "words": "\\n哈哈。",
        "voice": null
    },
    {
        "type": "still",
        "still": "210300201",
        "still_id": "210300201"
    },
    {
        "name": "咲戀",
        "words": "呵呵，",
        "voice": "vo_adv_2103002_009"
    },
    {
        "name": "咲戀",
        "words": "是呢。",
        "voice": null
    },
    {
        "name": "咲戀",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "咲戀",
        "words": "上一次我們在這邊談話的時候，",
        "voice": null
    },
    {
        "name": "咲戀",
        "words": "\\n是因為克莉絲提娜的關係，",
        "voice": null
    },
    {
        "name": "咲戀",
        "words": "所以和獸人族起了糾紛嘛……",
        "voice": null
    },
    {
        "name": "純",
        "words": "當時也有當時的難處，",
        "voice": "vo_adv_2103002_010"
    },
    {
        "name": "純",
        "words": "可也是夠折騰人了。",
        "voice": null
    },
    {
        "name": "純",
        "words": "\\n不知真步她這陣子過得怎麼樣呢……",
        "voice": null
    },
    {
        "name": "咲戀",
        "words": "嗯，",
        "voice": "vo_adv_2103002_011"
    },
    {
        "name": "咲戀",
        "words": "似乎過得挺有精神的。",
        "voice": null
    },
    {
        "name": "咲戀",
        "words": "雖然我並沒有直接和她見到面，",
        "voice": null
    },
    {
        "name": "咲戀",
        "words": "\\n但最近這陣子，",
        "voice": null
    },
    {
        "name": "咲戀",
        "words": "以【哞哞自衛隊】為首，",
        "voice": null
    },
    {
        "name": "咲戀",
        "words": "人們和獸人族之間的貿易",
        "voice": null
    },
    {
        "name": "咲戀",
        "words": "\\n似乎也相當順遂的樣子……",
        "voice": null
    },
    {
        "name": "咲戀",
        "words": "不好。",
        "voice": "vo_adv_2103002_012"
    },
    {
        "name": "咲戀",
        "words": "非常抱歉，陛下……",
        "voice": null
    },
    {
        "name": "咲戀",
        "words": "不對，",
        "voice": null
    },
    {
        "name": "咲戀",
        "words": "貪吃佩可。",
        "voice": null
    },
    {
        "name": "咲戀",
        "words": "\\n我們竟然把妳擱在一旁逕自談起話來了。",
        "voice": null
    },
    {
        "name": "貪吃佩可",
        "words": "沒事沒事！",
        "voice": "vo_adv_2103002_013"
    },
    {
        "name": "貪吃佩可",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "貪吃佩可",
        "words": "剛剛聽妳們兩位的對談，",
        "voice": null
    },
    {
        "name": "貪吃佩可",
        "words": "讓我明白了純小姐和咲戀",
        "voice": null
    },
    {
        "name": "貪吃佩可",
        "words": "\\n妳們兩位的感情是真的很好呢☆",
        "voice": null
    },
    {
        "name": "貪吃佩可",
        "words": "同時……",
        "voice": "vo_adv_2103002_014"
    },
    {
        "name": "貪吃佩可",
        "words": "只要是純小姐能夠信賴的人物，",
        "voice": null
    },
    {
        "name": "貪吃佩可",
        "words": "\\n那麼對我來說也就是能夠信賴的人了。",
        "voice": null
    },
    {
        "name": "貪吃佩可",
        "words": "\\n因為我對純小姐的事情，",
        "voice": null
    },
    {
        "name": "貪吃佩可",
        "words": "可是相當信賴的呢。",
        "voice": null
    },
    {
        "name": "純",
        "words": "陛下……",
        "voice": "vo_adv_2103002_015"
    },
    {
        "name": "純",
        "words": "您如此當面向我訴說此事，",
        "voice": null
    },
    {
        "name": "純",
        "words": "著實讓我有些感到無地自容。",
        "voice": null
    },
    {
        "name": "純",
        "words": "\\n畢竟我",
        "voice": null
    },
    {
        "name": "純",
        "words": "可是曾被霸瞳皇帝徹底操弄在手掌心上——",
        "voice": null
    },
    {
        "name": "純",
        "words": "\\n說穿了",
        "voice": null
    },
    {
        "name": "純",
        "words": "便是有著前科。",
        "voice": null
    },
    {
        "name": "貪吃佩可",
        "words": "但那是因為妳被洗腦裝置影響了的關係嘛，",
        "voice": "vo_adv_2103002_016"
    },
    {
        "name": "貪吃佩可",
        "words": "\\n會變成那樣也沒有辦法啦！",
        "voice": null
    },
    {
        "name": "貪吃佩可",
        "words": "\\n雖然當妳發誓侍奉我為妳的王時開始，",
        "voice": null
    },
    {
        "name": "貪吃佩可",
        "words": "我就已經說過好幾次了……",
        "voice": null
    },
    {
        "name": "貪吃佩可",
        "words": "也就是說呢，",
        "voice": "vo_adv_2103002_017"
    },
    {
        "name": "貪吃佩可",
        "words": "請妳不要太在意當時的事了。",
        "voice": null
    },
    {
        "name": "貪吃佩可",
        "words": "\\n如果真要說的話，",
        "voice": null
    },
    {
        "name": "貪吃佩可",
        "words": "讓霸瞳皇帝有機會可以奪走王位，",
        "voice": null
    },
    {
        "name": "貪吃佩可",
        "words": "\\n我也得要負起一定的責任呀。",
        "voice": null
    },
    {
        "name": "純",
        "words": "非常感激您的大德大量……",
        "voice": "vo_adv_2103002_018"
    },
    {
        "name": "純",
        "words": "陛下。",
        "voice": null
    },
    {
        "type": "background",
        "bg_id": "501070"
    },
    {
        "type": "still",
        "still": "end"
    },
    {
        "name": "咲戀",
        "words": "難不成……",
        "voice": "vo_adv_2103002_019"
    },
    {
        "name": "咲戀",
        "words": "\\n妳就像剛剛那樣，",
        "voice": null
    },
    {
        "name": "咲戀",
        "words": "到處跟所有當過霸瞳皇帝夥伴的貴族與士兵們，",
        "voice": null
    },
    {
        "name": "咲戀",
        "words": "\\n用相同說法去原諒他們了嗎？",
        "voice": null
    },
    {
        "name": "貪吃佩可",
        "words": "欸嘿嘿。",
        "voice": "vo_adv_2103002_020"
    },
    {
        "name": "貪吃佩可",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "貪吃佩可",
        "words": "……但這裡頭",
        "voice": null
    },
    {
        "name": "貪吃佩可",
        "words": "也藏了一點私情就是了喔？",
        "voice": null
    },
    {
        "name": "咲戀",
        "words": "私情……？",
        "voice": "vo_adv_2103002_021"
    },
    {
        "name": "貪吃佩可",
        "words": "是的。",
        "voice": "vo_adv_2103002_022"
    },
    {
        "name": "貪吃佩可",
        "words": "\\n我呀……",
        "voice": null
    },
    {
        "name": "貪吃佩可",
        "words": "想要守護我",
        "voice": null
    },
    {
        "name": "貪吃佩可",
        "words": "最喜歡的好朋友。",
        "voice": null
    },
    {
        "type": "still",
        "still": "200801301",
        "still_id": "200801301"
    },
    {
        "name": "貪吃佩可",
        "words": "那孩子呀，",
        "voice": "vo_adv_2103002_023"
    },
    {
        "name": "貪吃佩可",
        "words": "似乎原本是處於霸瞳皇帝左右手的立場。",
        "voice": null
    },
    {
        "name": "貪吃佩可",
        "words": "\\n而且為了我這個目標，",
        "voice": null
    },
    {
        "name": "貪吃佩可",
        "words": "還隱藏了身分接近我……",
        "voice": null
    },
    {
        "name": "貪吃佩可",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "貪吃佩可",
        "words": "在那之後，",
        "voice": null
    },
    {
        "name": "貪吃佩可",
        "words": "當我知道了真相時。",
        "voice": null
    },
    {
        "name": "貪吃佩可",
        "words": "我們還吵了場架……",
        "voice": null
    },
    {
        "type": "still",
        "still": "200400501",
        "still_id": "200400501"
    },
    {
        "name": "貪吃佩可",
        "words": "但是。",
        "voice": "vo_adv_2103002_024"
    },
    {
        "name": "貪吃佩可",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "貪吃佩可",
        "words": "到了最後，",
        "voice": null
    },
    {
        "name": "貪吃佩可",
        "words": "她選擇了與我們站在一起。",
        "voice": null
    },
    {
        "name": "貪吃佩可",
        "words": "\\n如果沒有她在我們身邊，",
        "voice": null
    },
    {
        "name": "貪吃佩可",
        "words": "我們可能早就輸掉了。",
        "voice": null
    },
    {
        "type": "background",
        "bg_id": "501070"
    },
    {
        "type": "still",
        "still": "end"
    },
    {
        "name": "貪吃佩可",
        "words": "……話雖這麼說……",
        "voice": "vo_adv_2103002_025"
    },
    {
        "name": "貪吃佩可",
        "words": "但在什麼都不知道的人眼裡，",
        "voice": null
    },
    {
        "name": "貪吃佩可",
        "words": "\\n那孩子就是",
        "voice": null
    },
    {
        "name": "貪吃佩可",
        "words": "做為霸瞳皇帝左右手的罪人。",
        "voice": null
    },
    {
        "name": "貪吃佩可",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "貪吃佩可",
        "words": "所以……",
        "voice": null
    },
    {
        "name": "咲戀",
        "words": "所以，",
        "voice": "vo_adv_2103002_026"
    },
    {
        "name": "咲戀",
        "words": "妳就利用了原諒眾人的這件事，",
        "voice": null
    },
    {
        "name": "咲戀",
        "words": "\\n製造難以譴責『她』的狀況……",
        "voice": null
    },
    {
        "name": "咲戀",
        "words": "嗎？",
        "voice": null
    },
    {
        "name": "貪吃佩可",
        "words": "是的。",
        "voice": "vo_adv_2103002_027"
    },
    {
        "name": "貪吃佩可",
        "words": "……這種事，",
        "voice": null
    },
    {
        "name": "貪吃佩可",
        "words": "就是私情對吧。",
        "voice": null
    },
    {
        "name": "貪吃佩可",
        "words": "\\n或許是因為到處旅行流浪的關係，",
        "voice": null
    },
    {
        "name": "貪吃佩可",
        "words": "所以忘記了身為一位王族，",
        "voice": null
    },
    {
        "name": "貪吃佩可",
        "words": "\\n要公平公正對待所有人不該有偏袒。",
        "voice": null
    },
    {
        "name": "貪吃佩可",
        "words": "……而我也因此常常被念了呢。",
        "voice": null
    },
    {
        "name": "咲戀",
        "words": "……是呢。",
        "voice": "vo_adv_2103002_028"
    },
    {
        "name": "咲戀",
        "words": "\\n或許是這樣沒錯。",
        "voice": null
    },
    {
        "name": "咲戀",
        "words": "為了自己的朋友，",
        "voice": "vo_adv_2103002_029"
    },
    {
        "name": "咲戀",
        "words": "而利用了身為王族的權力……",
        "voice": null
    },
    {
        "name": "咲戀",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "咲戀",
        "words": "同時也理解了這麼做的含意，",
        "voice": null
    },
    {
        "name": "咲戀",
        "words": "導致自己陷入了苦惱與糾結……",
        "voice": null
    },
    {
        "name": "咲戀",
        "words": "嗎。",
        "voice": null
    },
    {
        "name": "咲戀",
        "words": "\\n嗯……",
        "voice": null
    },
    {
        "name": "純",
        "words": "……咲戀？",
        "voice": "vo_adv_2103002_030"
    },
    {
        "name": "貪吃佩可",
        "words": "……那個……",
        "voice": "vo_adv_2103002_031"
    },
    {
        "name": "貪吃佩可",
        "words": "\\n該不會我說的話，",
        "voice": null
    },
    {
        "name": "貪吃佩可",
