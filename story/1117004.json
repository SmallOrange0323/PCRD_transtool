  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "――討厭大蒜的伊莉亞因為不小心誤食加了大蒜的雞腿，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n而虛弱地無法變回原本的姿態。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n兩人向著較為安靜的郊外前進，並在長椅上稍作休息。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗚嗚……",
    "voice": "vo_adv_1117004_000",
    "unit_id": 111712
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "大蒜……",
    "voice": null,
    "unit_id": 111712
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n大蒜討厭……",
    "voice": null,
    "unit_id": 111712
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗚、",
    "voice": "vo_adv_1117004_001",
    "unit_id": 111712
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯……",
    "voice": null,
    "unit_id": 111712
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n稍微穩定下來了……",
    "voice": null,
    "unit_id": 111712
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 111712
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "再等一下下，",
    "voice": null,
    "unit_id": 111712
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "應該就能恢復本來的身體了……",
    "voice": null,
    "unit_id": 111712
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗚嗚……",
    "voice": "vo_adv_1117004_002",
    "unit_id": 111712
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "居然會如此失態……",
    "voice": null,
    "unit_id": 111712
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 111712
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "可惡的大蒜……",
    "voice": null,
    "unit_id": 111712
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n為什麼那種東西",
    "voice": null,
    "unit_id": 111712
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "會存在於這個世界上呢……",
    "voice": null,
    "unit_id": 111712
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……要是平常的話，",
    "voice": "vo_adv_1117004_003",
    "unit_id": 111712
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "應該會說別把妾身當成小孩，",
    "voice": null,
    "unit_id": 111712
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 111712
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "雖然不甘心，",
    "voice": null,
    "unit_id": 111712
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "但是現在",
    "voice": null,
    "unit_id": 111712
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "溫暖的手，",
    "voice": null,
    "unit_id": 111712
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "卻讓人很安心……",
    "voice": null,
    "unit_id": 111712
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗚嗚……",
    "voice": "vo_adv_1117004_004",
    "unit_id": 111712
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "居然會變成這麼難為情的樣子……",
    "voice": null,
    "unit_id": 111712
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 111712
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "但是，",
    "voice": null,
    "unit_id": 111712
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不論陷入什麼狀況，",
    "voice": null,
    "unit_id": 111712
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n妾身的『偉大計劃』都一定要成功！　",
    "voice": null,
    "unit_id": 111712
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "{0}！！",
    "voice": "vo_adv_1117004_005",
    "unit_id": 111712
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n那個，",
    "voice": null,
    "unit_id": 111712
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "繼續剛剛的……",
    "voice": null,
    "unit_id": 111712
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "咦？",
    "voice": null,
    "unit_id": 111712
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n怎、",
    "voice": null,
    "unit_id": 111712
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "怎麼了，",
    "voice": null,
    "unit_id": 111712
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你的身體在發光…………！？",
    "voice": null,
    "unit_id": 111712
  },
  {
    "type": "still",
    "still_id": "111700401"
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "諸位喔！！",
    "voice": "vo_adv_1117004_006",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n妾身可是在販售蛋糕，",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "心懷感激來購買吧！",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "唔……",
    "voice": "vo_adv_1117004_007",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "即便妾身有滿溢的魅力，",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "也已經賣不出去了嗎。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "畢竟都已經這個時間了，",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n聖誕派對應該也早就開始了吧。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "輪、輪不到你來道謝！",
    "voice": "vo_adv_1117004_008",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n妾身只是很在意",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n到底是什麼事",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "讓你拒絕妾身",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "也要去做！",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "才、",
    "voice": "vo_adv_1117004_009",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "才不是，",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n想要跟你一起",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "度過",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "聖誕節喔！",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n才、",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "才不是那樣喔！！",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不過{0}。",
    "voice": "vo_adv_1117004_010",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n也沒必要連這種時候都在工作吧？",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "咦……",
    "voice": "vo_adv_1117004_011",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "因為人手不足店家很困擾，",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "所以被拜託幫忙了？",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "唉……",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "明明是聖誕節，",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你還真是……",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "雖然瞭解理由了，",
    "voice": "vo_adv_1117004_012",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "但就算是那樣，",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "也工作過頭了。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n你也應該",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "那個……",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n有、",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "有可以一起過節的",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "對象吧？",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "呵呵呵……",
    "voice": "vo_adv_1117004_013",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "怎麼了～？",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n眼神在飄移喔～？",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嘛，",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "今天可是有妾身在你身邊，",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "心懷感謝吧♪",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……什麼！？",
    "voice": "vo_adv_1117004_014",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n那個……",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "的、",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "的確是呢……",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "跟妾身在一起……",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "對、",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "對能跟妾身一起過節這件事情，",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "儘管心懷感謝吧！",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "啊，",
    "voice": "vo_adv_1117004_015",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "兩位～！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n今天應該已經賣不出去了，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n整理好販賣窗口之後就可以下班囉～",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "哼……",
    "voice": "vo_adv_1117004_016",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n看來，",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "蛋糕販售也結束了呢。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "still",
    "still_id": "111700402"
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "………………",
    "voice": "vo_adv_1117004_017",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……不、",
    "voice": "vo_adv_1117004_018",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不要看這邊！",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "就、",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "就這樣聽好。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……其實",
    "voice": "vo_adv_1117004_019",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "今天，",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n過來幫你的忙，",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "是有理由的。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "那個……",
    "voice": "vo_adv_1117004_020",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "因為一直以來都受到你的照顧，",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "所以想要用什麼東西來回禮，",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身才自己想了這個計劃。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身的",
    "voice": "vo_adv_1117004_021",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "『偉大計劃』……",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
