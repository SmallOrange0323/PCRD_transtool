  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "朝著露娜之塔的上方繼續前進的{0}一行人，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n被突然出現的魔物給包圍。",
    "voice": null,
