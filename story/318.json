[
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "緊、緊、",
    "voice": "vo_adv_0000318_000",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "緊急狀態！",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "這是緊急狀態！！",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "我代表公會管理協會，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "立刻宣布進入緊急狀態！！",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "上次，",
    "voice": "vo_adv_0000318_001",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "委託討伐的魔物",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "好像得到前所未有的力量，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n再次前來向各位挑戰！",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "但是……",
    "voice": "vo_adv_0000318_002",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "請看。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "透過這次的活動，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "與您締結了強烈羈絆的眾人，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n表情明顯不同。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "看起來充滿了力量！",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "您與大家之間",
    "voice": "vo_adv_0000318_003",
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "細心培育的「羈絆之力」……",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "這點應該",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "能成為您最大的武器。",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "\\n",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "編組最佳隊伍，",
    "voice": null,
    "unit_id": 190811
  },
  {
    "type": "dialogue",
    "name": "花凜",
    "words": "迎接這場決戰吧！",
    "voice": null,
    "unit_id": 190811
  }
]
