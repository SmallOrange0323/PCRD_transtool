    "type": "dialogue",
    "name": "噗媽",
    "words": "「那個三明治，",
    "voice": "vo_adv_1023008_029",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "噗媽",
    "words": "你喜歡嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "噗媽",
    "words": "\\n那是綾音和噗吉一起做的喔～",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "噗媽",
    "words": "\\n使用了自製的美乃滋♪」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "「嗯嗯？",
    "voice": "vo_adv_1023008_030",
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n你說好吃到每天",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "都想吃……？",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "\\n那個",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗吉",
    "words": "意思是……？」",
    "voice": null,
    "unit_id": 2131
  },
  {
    "type": "dialogue",
    "name": "噗爸",
    "words": "「你這沒禮貌的傢伙！」",
    "voice": "vo_adv_1023008_031",
    "unit_id": null
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "噗媽",
    "words": "「哎呀，老公。",
    "voice": "vo_adv_1023008_032",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "噗媽",
    "words": "\\n我還想說怎麼沒看到你，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "噗媽",
    "words": "\\n原來你在我的裡頭啊。」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "噗爸",
    "words": "「沒有錯。",
    "voice": "vo_adv_1023008_033",
    "unit_id": 102332
  },
  {
    "type": "dialogue",
    "name": "噗爸",
    "words": "\\n都怪這傢伙太無禮了，",
    "voice": null,
    "unit_id": 102332
  },
  {
    "type": "dialogue",
    "name": "噗爸",
    "words": "\\n害我想都沒想就跑出來了。」",
    "voice": null,
    "unit_id": 102332
  },
  {
    "type": "dialogue",
    "name": "噗爸",
    "words": "「喂，",
    "voice": "vo_adv_1023008_034",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "噗爸",
    "words": "\\n那邊的小鬼！」",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "噗爸",
    "words": "「你說每天都想吃……",
    "voice": "vo_adv_1023008_035",
    "unit_id": 102332
  },
  {
    "type": "dialogue",
    "name": "噗爸",
    "words": "\\n簡單來說，",
    "voice": null,
    "unit_id": 102332
  },
  {
    "type": "dialogue",
    "name": "噗爸",
    "words": "\\n就是你想和綾音結婚的意思吧？」",
    "voice": null,
    "unit_id": 102332
  },
  {
    "type": "dialogue",
    "name": "噗爸",
    "words": "「嗯嗯，你說不是？",
    "voice": "vo_adv_1023008_036",
    "unit_id": 102332
  },
  {
    "type": "dialogue",
    "name": "噗爸",
    "words": "\\n明明沒有結婚的意思，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "噗爸",
    "words": "卻說了類似求婚的發言？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "噗爸",
    "words": "\\n",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "噗爸",
    "words": "真是輕薄的男人！」",
    "voice": null,
    "unit_id": 102332
  },
  {
    "type": "dialogue",
    "name": "噗爸",
    "words": "「唔？",
    "voice": "vo_adv_1023008_037",
    "unit_id": 102332
  },
  {
    "type": "dialogue",
    "name": "噗爸",
    "words": "\\n你說純粹是太好吃了，",
    "voice": null,
    "unit_id": 102332
  },
  {
    "type": "dialogue",
    "name": "噗爸",
    "words": "\\n所以想如果能每天都吃到會很幸福？」",
    "voice": null,
    "unit_id": 102332
  },
  {
    "type": "dialogue",
    "name": "噗爸",
    "words": "「嗯……",
    "voice": "vo_adv_1023008_038",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "噗爸",
    "words": "\\n",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "噗爸",
    "words": "等、等一下。",
    "voice": null,
    "unit_id": 102332
  },
  {
    "type": "dialogue",
    "name": "噗爸",
    "words": "\\n",
    "voice": null,
    "unit_id": 102332
  },
  {
    "type": "dialogue",
    "name": "噗爸",
    "words": "大家",
    "voice": null,
    "unit_id": 102332
  },
  {
    "type": "dialogue",
    "name": "噗爸",
    "words": "先來開個家庭會議。」",
    "voice": null,
    "unit_id": 102332
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "數分鐘後……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "噗爸",
    "words": "「嗯，",
    "voice": "vo_adv_1023008_039",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "噗爸",
    "words": "要每天是很困難。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "噗爸",
    "words": "\\n",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "噗爸",
    "words": "但如果偶爾的話，",
    "voice": null,
    "unit_id": 102332
  },
  {
    "type": "dialogue",
    "name": "噗爸",
    "words": "倒是可以做給你吃……",
    "voice": null,
    "unit_id": 102332
  },
  {
    "type": "dialogue",
    "name": "噗爸",
    "words": "\\n噗媽是這樣說的。」",
    "voice": null,
    "unit_id": 102332
  },
  {
    "type": "dialogue",
    "name": "噗爸",
    "words": "「你就好好感謝",
    "voice": "vo_adv_1023008_040",
    "unit_id": 102332
  },
  {
    "type": "dialogue",
    "name": "噗爸",
    "words": "\\n噗媽的溫柔吧。」",
    "voice": null,
    "unit_id": 102332
  },
  {
    "type": "dialogue",
    "name": "噗爸",
    "words": "「相對的，",
    "voice": "vo_adv_1023008_041",
    "unit_id": 102332
  },
  {
    "type": "dialogue",
    "name": "噗爸",
    "words": "\\n如果綾音叫你，你可要隨傳隨到喔。",
    "voice": null,
    "unit_id": 102332
  },
  {
    "type": "dialogue",
    "name": "噗爸",
    "words": "\\n即使是下雨、",
    "voice": null,
    "unit_id": 102332
  },
  {
    "type": "dialogue",
    "name": "噗爸",
    "words": "打雷，",
    "voice": null,
    "unit_id": 102332
  },
  {
    "type": "dialogue",
    "name": "噗爸",
    "words": "還是半夜裡……",
    "voice": null,
    "unit_id": 102332
  },
  {
    "type": "dialogue",
    "name": "噗爸",
    "words": "都要喔。」",
    "voice": null,
    "unit_id": 102332
  },
  {
    "type": "dialogue",
    "name": "綾音 ",
    "words": "……嘿嘿♪",
