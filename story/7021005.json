    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "咦？",
    "voice": "vo_adv_7021005_065",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我、",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我才沒有。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "只是不太習慣被這樣子稱讚……",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "那個……",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n覺得有點困惑。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "呵呵呵。",
    "voice": "vo_adv_7021005_066",
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n那我就先當作是這樣吧。",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "不過，",
    "voice": "vo_adv_7021005_067",
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "深月小姐倒也是個一被捉弄就會出現有趣反應的人呢。",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n妳那含蓄典雅的害臊模樣，",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "令人百看不厭。",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "今天的活動雖然中止了，",
    "voice": "vo_adv_7021005_068",
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "下次你們兩位要去進行田野調查時，",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n也可以帶我一起去嗎？",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "當然沒問題，",
    "voice": "vo_adv_7021005_069",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "可以增加人手，我很歡迎……",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "但是……",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "總覺得妳的說話方式",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "好像有點怪怪的……？",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "呵呵，",
    "voice": "vo_adv_7021005_070",
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "看來今後會越來越有趣了♪",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "還請多指教囉，",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "深月小姐！",
    "voice": null,
    "unit_id": 103731
  },
