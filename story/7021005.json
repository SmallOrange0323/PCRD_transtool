  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}一行人在與一大群強大的魔物們戰鬥後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n露娜之塔的地板上堆滿了",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n被深月的毒藥所毒殺的魔物們。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "這景象……",
    "voice": "vo_adv_7021005_000",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "真是壯觀。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "呵呵，",
    "voice": "vo_adv_7021005_001",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我也很開心能夠蒐集到綽綽有餘的資料。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "魔物的遺體也得好好調查一番……",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "咦？",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n那個是什麼？",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "是塊很不可思議的石頭。",
    "voice": "vo_adv_7021005_002",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n不同於塔的牆壁和地板，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "而且還淡淡地發著光……？",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……原來如此。",
    "voice": "vo_adv_7021005_003",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n這是{0}在找尋的記憶線索吧。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "這塊石頭上竟然有記憶的線索，",
    "voice": "vo_adv_7021005_004",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n真令人難以置信……",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "嗯！？",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "光突然變強了……！？",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "好刺眼……！",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "background",
    "bg_id": "510070"
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "就像我剛才所說的，",
    "voice": "vo_adv_7021005_005",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "希望你能來協助我探索\\n間隔數十年後再次在山上被目擊到的植物。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "而且在找到之前，我絕不放你回去，",
    "voice": "vo_adv_7021005_006",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "你可要做好覺悟喔♪",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "咦～？",
    "voice": "vo_adv_7021005_007",
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "這不是{0}嗎？",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "竟然會在這裡遇到，",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "真是巧啊。",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "妳是……",
    "voice": "vo_adv_7021005_008",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n{0}的朋友嗎？",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "初次見面。",
    "voice": "vo_adv_7021005_009",
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我是御久間智。",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n因為看到{0}和可疑的，",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "呃、不是，",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "和漂亮的人在一起而",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "感到好奇，所以就來打聲招呼。",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "剛剛",
    "voice": "vo_adv_7021005_010",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "好像有聽到她說了什麼可疑……",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n是我聽錯了嗎……？　",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "原、",
    "voice": "vo_adv_7021005_011",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "原來是這樣啊。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我是宵濱深月。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n正在邀約{0}來幫我做研究。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "哦～",
    "voice": "vo_adv_7021005_012",
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "研究啊！",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "聽起來很有趣呢！",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我也可以加入你們嗎？",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "呃、",
    "voice": "vo_adv_7021005_013",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "可以啊。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "人手增加是幫了我一個大忙，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我完全不介意。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "總、",
    "voice": "vo_adv_7021005_014",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "總覺得她好像話中帶刺，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n我曾對她做過什麼嗎？",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我們應該是第一次見面",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "吧？　",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "background",
    "bg_id": "510400"
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "咦？",
    "voice": "vo_adv_7021005_015",
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "原來是要找尋\\n不知道是不是真的存在的植物啊？",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我是在確定有這種植物的前提下來尋找的。",
    "voice": "vo_adv_7021005_016",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "況且",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這是以前理當曾經存在過的野生植物，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n就算有也不足為奇。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "因為受到森林砍伐和外來種的影響，",
    "voice": "vo_adv_7021005_017",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "一般認為\\n它已在這一帶絕跡。不過，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "如果真能夠找到，將會是一大發現，",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n得趕緊與地方政府合作展開保護活動。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "……",
    "voice": "vo_adv_7021005_018",
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "原來妳真的是研究者啊。",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "妳會這樣說",
    "voice": "vo_adv_7021005_019",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "，那妳原先是",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "怎麼看我的啊。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "因為我聽到妳對{0}說：",
    "voice": "vo_adv_7021005_020",
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n「我絕不放你回去，你可要做好覺悟喔♪」",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n以為他是不是",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "碰到什麼麻煩事……",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……！？",
    "voice": "vo_adv_7021005_021",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這、",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這是天大的誤會",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n。我的意思是說，在找到植物之前絕不會放他走。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "呵呵，",
    "voice": "vo_adv_7021005_022",
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "不管怎樣，在我聽來，這種說法也是有問題的喔。",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "…………",
    "voice": "vo_adv_7021005_023",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "不過，",
    "voice": "vo_adv_7021005_024",
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "從深月小姐的口吻",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "可以知道妳的確是個研究者。",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "所以我也會認真給予協助的",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n。因為得讓{0}能夠平安地回來呢。",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "真是的，",
    "voice": "vo_adv_7021005_025",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "請不要再捉弄大人了。",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "抱歉，",
    "voice": "vo_adv_7021005_026",
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我就是喜歡捉弄人。",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "嗚嗚～！",
    "voice": "vo_adv_7021005_027",
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "好痛～！！！",
    "voice": null,
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "小孩子的哭聲？",
    "voice": "vo_adv_7021005_028",
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "聲音是從那邊傳來的！",
    "voice": "vo_adv_7021005_029",
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我們走吧！",
    "voice": null,
    "unit_id": 105131
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "咦？",
    "voice": "vo_adv_7021005_030",
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "好、",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "好的！",
    "voice": null,
    "unit_id": 103731
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "嗚",
    "voice": "vo_adv_7021005_031",
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "小孩",
    "words": "嗚～！！！",
    "voice": null,
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "啊，",
    "voice": "vo_adv_7021005_032",
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "老公……！",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "\\n這該怎麼辦……！",
    "voice": null,
    "unit_id": 1231
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "呃、",
    "voice": "vo_adv_7021005_033",
    "unit_id": 1031
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "那個……！",
    "voice": null,
    "unit_id": 1031
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "看你們好像遇到了麻煩，",
    "voice": "vo_adv_7021005_034",
    "unit_id": 105131
  },
