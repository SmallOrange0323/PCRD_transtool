    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n我也還差得遠呢。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "妳可以把魔物扛回去",
    "voice": "vo_adv_7021005_075",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "試著調查看看啊？",
