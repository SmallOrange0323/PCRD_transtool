    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "剛才的景象，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "到底是……？",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "總覺得……",
    "voice": "vo_adv_7021005_072",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "好像做了一個難以釋疑的夢……",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "那塊石頭所發出的光芒似乎已經消失了……",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n{0}，你覺得有什麼改變嗎？",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這樣啊……",
    "voice": "vo_adv_7021005_073",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "有點可惜。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不過，",
    "voice": null,
    "unit_id": 105111
  },
  {
