  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "還是有人很需要我。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "這就是所謂的是毒是藥皆有用嗎？",
    "voice": "vo_adv_7021005_078",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n我覺得我好像稍微長一智了。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "能夠幫助小智成長，真令人開心♪",
    "voice": "vo_adv_7021005_079",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "不過，",
    "voice": "vo_adv_7021005_080",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "一旦被我掌握到證據，",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "我一定會毫不留情地逮捕妳的。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n妳可別大意了！",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "{0}也願意幫我對吧。",
    "voice": "vo_adv_7021005_081",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n謝謝你。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "哎呀，",
    "voice": "vo_adv_7021005_082",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "{0}你竟然要站在小智那邊，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n我好傷心喔。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "為了不讓{0}",
    "voice": "vo_adv_7021005_083",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "也掌握到證據，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n我在各方面都得格外小心。",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "在各方面，",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "是吧？",
    "voice": null,
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}感受到深月所散發出的壓迫感，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n連忙閉上了嘴，邁步走下露娜之塔。",
