  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "\\n",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "唉……",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "妳真是個可怕的對手。",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "呵呵，",
    "voice": "vo_adv_7021005_077",
    "unit_id": 105111
  },
  {
    "type": "dialogue",
    "name": "深月",
