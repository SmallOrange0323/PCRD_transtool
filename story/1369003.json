  {
    "type": "dialogue",
    "name": "旁白",
    "words": "{0}他們離開了璐璐伊的故鄉「深邃庭園」。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在返回巨鯨城的路上，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "璐璐伊她──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "姿勢的話，",
    "voice": "vo_adv_1369003_000",
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "素這樣的！",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "這樣！",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "再扭動得更多……",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "更有魅力！",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "就照那個樣子讓身體看起來大一點！",
    "voice": "vo_adv_1369003_001",
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "腳也多一點比較好呢。",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "嗚啾！",
    "voice": "vo_adv_1369003_002",
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "就素那種感覺！",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "充滿活力的樣子很有魅力。",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "不知不覺就肚子餓了……",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "嗚啾……",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "目標",
    "voice": "vo_adv_1369003_003",
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "素擁有能被「深邃庭園」",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n認可的帥氣。",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "為此首先，",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "要將腳上的吸盤……",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "那素因為……",
    "voice": "vo_adv_1369003_004",
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "騎士先生",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "向偶做出了那個姿勢。",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "雖然偶那時嚇到逃跑了……",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "騎",
    "voice": "vo_adv_1369003_005",
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "士先生的心意，",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "偶已經確實接收到了。",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "覺得非常開心呢。",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "所以……",
    "voice": "vo_adv_1369003_006",
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "雖然這次沒能成功，",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "但為了總有一天能獲得認可，",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "偶們一起努力吧！",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "喔～！",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "和騎士先生一起的話，",
    "voice": "vo_adv_1369003_007",
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "一定沒問題的。",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n只要偶們同心協力，",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "就能成為一族",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n與巨鯨城之間的",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "橋梁。",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "為了這個目標，",
    "voice": "vo_adv_1369003_008",
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "現在──",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n必須讓大家",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "承認「候補」的身分才行……！　",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "第22王子",
    "words": "那傢伙……",
    "voice": "vo_adv_1369003_009",
    "unit_id": 52311
  },
  {
    "type": "dialogue",
    "name": "第22王子",
    "words": "居然還把那個人類當作是「候補」。",
    "voice": null,
    "unit_id": 52311
  },
  {
    "type": "dialogue",
    "name": "第22王子",
    "words": "\\n腦子還挺天真的──",
    "voice": null,
    "unit_id": 52311
  },
  {
    "type": "dialogue",
    "name": "第22王子",
    "words": "不過算了。",
    "voice": null,
    "unit_id": 52311
  },
  {
    "type": "dialogue",
    "name": "第22王子",
    "words": "\\n就讓她維持那種蠢樣，",
    "voice": null,
    "unit_id": 52311
  },
  {
    "type": "dialogue",
    "name": "第22王子",
    "words": "為我所用吧。",
    "voice": null,
    "unit_id": 52311
  },
  {
    "type": "dialogue",
    "name": "第22王子",
    "words": "那傢伙──",
    "voice": "vo_adv_1369003_010",
    "unit_id": 52311
  },
  {
    "type": "dialogue",
    "name": "第22王子",
    "words": "是獻給巨鯨城的友好證明。",
    "voice": null,
    "unit_id": 52311
  },
  {
    "type": "dialogue",
    "name": "第22王子",
    "words": "\\n是為了和平而存在，重要的公主殿下。",
    "voice": null,
    "unit_id": 52311
  },
  {
    "type": "dialogue",
    "name": "第22王子",
    "words": "要是那傢伙失蹤的話……",
    "voice": "vo_adv_1369003_011",
    "unit_id": 52311
  },
  {
    "type": "dialogue",
    "name": "第22王子",
    "words": "嗚啾嚕嚕嚕……",
    "voice": null,
    "unit_id": 52311
  },
  {
    "type": "dialogue",
    "name": "第22王子",
    "words": "\\n對方恐怕沒辦法向父親交代吧。",
    "voice": null,
    "unit_id": 52311
  },
  {
    "type": "dialogue",
    "name": "第22王子",
    "words": "\\n",
    "voice": null,
    "unit_id": 52311
  },
  {
    "type": "dialogue",
    "name": "第22王子",
    "words": "你們幾個──",
    "voice": null,
    "unit_id": 52311
  },
  {
    "type": "dialogue",
    "name": "第22王子",
    "words": "別搞砸了。",
    "voice": null,
    "unit_id": 52311
  },
  {
    "type": "dialogue",
    "name": "第22王子",
    "words": "知道嗎。",
    "voice": null,
    "unit_id": 52311
  },
  {
    "type": "dialogue",
    "name": "王子的部下們",
    "words": "…………",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "接下來素跳舞。",
    "voice": "vo_adv_1369003_012",
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "要以魅惑「深邃庭園」的所有女孩為目標，",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n扭啊扭！",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "……嗚啾！？",
    "voice": "vo_adv_1369003_013",
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "突、",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "突然做出那種動作……",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "嗚啾啾啾啾……",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "好、",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "好害羞喔……",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "騎士先生……",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "聽、",
    "voice": "vo_adv_1369003_014",
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "聽好了騎士先生。",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n關於……",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "剛才的動作。",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "在偶們族人之間，",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n只有在特殊時候",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "會展現給特別的對象看……",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "「候補」的騎士先生做出那樣的動作……",
    "voice": "vo_adv_1369003_015",
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "那個。",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n……嗚啾……",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "雖然很高興，",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "但素，",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n在公共場合有點……",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "害羞！",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "啊！",
    "voice": "vo_adv_1369003_016",
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "不過，",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "請不要沮喪！",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "一開始大家都會失敗的！",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "以後慢慢記住就行了！",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "就像偶從公主姐接他們那裡，",
    "voice": "vo_adv_1369003_017",
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "學到各種禮儀一樣。",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "偶",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "會教導騎士先生的。",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "這樣的話，",
    "voice": "vo_adv_1369003_018",
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "一定──",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "就能成為",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "騎士先生所縮的，",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "連結家族之間的橋梁。",
    "voice": null,
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "一起努力",
    "voice": "vo_adv_1369003_019",
    "unit_id": 136912
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "記住吧！",
    "voice": null,
    "unit_id": 136912
  },
