  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "嘉夜和大吾之間的打架對決約定下來的數天後。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n{0}走在蘭德索爾的附近，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n尋找著嘉夜。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "喝呀啊啊啊！！",
    "voice": "vo_adv_1065010_000",
    "unit_id": 106511
  },
  {
    "type": "background",
    "bg_id": "500130"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "呼……",
    "voice": "vo_adv_1065010_001",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "哦！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "{0}！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "沒想到會在這種地方遇見你，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "還真是巧呢！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你問我在做什麼？",
    "voice": "vo_adv_1065010_002",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我在進行以魔物為對手的特訓啊。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "畢竟對方可是",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "傳說中的打手。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "其實之前遇見大吾先生時，",
    "voice": "vo_adv_1065010_003",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n我忘了",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "跟他約時間和地點之類的。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "但是，",
    "voice": "vo_adv_1065010_004",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "在那些圍觀的人口中，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這場架的細節\\n好像在不知不覺間談妥了。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "因為大吾先生似乎說OK了，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n我也就順著接受了。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "所以我目前為了這場架，",
    "voice": "vo_adv_1065010_005",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n正在不停鍛鍊自己。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……我一直很憧憬",
    "voice": "vo_adv_1065010_006",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "那個人的強大力量。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我想要拿出我的所有力量……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "打贏他。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n靠徹底領悟",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "龍人族之力用法的我打贏他。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "就麻煩你當天",
    "voice": "vo_adv_1065010_007",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "為我加油啦！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "拜託囉！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這樣好嗎？",
    "voice": "vo_adv_1065010_008",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "既然你都這麼說了，那就拜託你啦！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "有你支持我的話，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我就更不覺得自己會輸了！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "好！",
    "voice": "vo_adv_1065010_009",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "熱血沸騰起來啦！！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "background",
    "bg_id": "500220"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "從那天之後，{0}為了",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n支援嘉夜進行特訓，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n和她一同行動了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "今天要把這一帶的魔物",
    "voice": "vo_adv_1065010_010",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "一隻隻地打爆！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你們就全部一起上吧！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "喝呀啊啊啊！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "background",
    "bg_id": "500200"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "對於和大吾之間的打架對決，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n嘉夜心中的那股幹勁",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n表現在特訓的內容上。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "現在開始要把這座岩山打飛！",
    "voice": "vo_adv_1065010_011",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "要上啦！！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "唔哦哦哦哦！！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "background",
    "bg_id": "500230"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "嘉夜克服了許多光看就覺得很困難的特訓。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n但是有一天──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我今天一定要掌握覺醒的力量！",
    "voice": "vo_adv_1065010_012",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你就來當我的墊腳石吧！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……快想起那時的感覺。",
    "voice": "vo_adv_1065010_013",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不要抵抗衝動。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "追求享樂。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "解放……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "力量……！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "唔喔喔喔喔喔喔！",
    "voice": "vo_adv_1065010_014",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "喝啊！！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "background",
    "bg_id": "500230"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "嘖！",
    "voice": "vo_adv_1065010_015",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這傢伙……！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n為什麼打不倒啊！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "趕快",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "給我倒下！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "background",
    "bg_id": "500230"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "該不會",
    "voice": "vo_adv_1065010_016",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "沒有效吧……！？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "明明應該有……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "覺醒的感覺啊……！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "平常的我面對這種程度的魔物，",
    "voice": "vo_adv_1065010_017",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "理應不會陷入苦戰的……！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我到底是怎麼了！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "振作一點！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這樣下去的話，",
    "voice": "vo_adv_1065010_018",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "一個弄不好，危險的反而是我嗎……！？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你！",
    "voice": "vo_adv_1065010_019",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "等一下！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我還能打！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我現在還在",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "掌握那個感覺……！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……不，",
    "voice": "vo_adv_1065010_020",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "剛剛的",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "當我沒說。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "現在就先撤退吧……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "background",
    "bg_id": "500130"
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "可惡……！",
    "voice": "vo_adv_1065010_021",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "為什麼……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "為什麼會這樣……！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n我也太沒用了吧！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "振作一點！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我連覺醒的力量也沒辦法好好使用，這怎麼行！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "總算有一場讓人熱血沸騰的架可打了……",
    "voice": "vo_adv_1065010_022",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "然而",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "再這樣下去，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "就只有被打得落花流水的份啊……！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……抱歉。",
    "voice": "vo_adv_1065010_023",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "「事情不該是這樣」的\\n心情太強烈了，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "所以不小心就……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "打手",
    "words": "哦哦！",
    "voice": "vo_adv_1065010_024",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "打手",
    "words": "找到了找到了！",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "打手",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "打手",
    "words": "喂～！",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "打手",
    "words": "嘉夜～！！",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "那是",
    "voice": "vo_adv_1065010_025",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "之前聊過的打手……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "打手",
    "words": "我聽說了喔，",
    "voice": "vo_adv_1065010_026",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "打手",
    "words": "妳要和大吾交手對吧？",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "打手",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "打手",
    "words": "也讓我們幫點忙吧。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "吃的就交給我吧！",
    "voice": "vo_adv_1065010_027",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n不管要吃什麼料理，我這邊都會提供喔！",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "雖然……",
    "voice": "vo_adv_1065010_028",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "我幫不上什麼忙，",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "不過我會幫妳加油的！",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……",
    "voice": "vo_adv_1065010_029",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "那個，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我很感謝你們有這份心意，但是……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "打手",
    "words": "笨～蛋！",
    "voice": "vo_adv_1065010_030",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "打手",
    "words": "現在是拒絕別人幫忙的時候嗎！",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "打手",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "打手",
    "words": "妳可是要和大吾交手喔？",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "打手",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "打手",
    "words": "就算有我們幫忙，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "打手",
    "words": "要與他交手還遠遠不足啊。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "據說沒有人",
    "voice": "vo_adv_1065010_031",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "在單純的鬥毆中勝過他。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "聽到嘉夜要和那種人交手，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n我們當然會坐也不是、站也不是啊。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這樣啊。",
    "voice": "vo_adv_1065010_032",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "那個人",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "原來這麼強啊。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "啥！？",
    "voice": "vo_adv_1065010_033",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "嘉夜，",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "妳難道不知道嗎！",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "嗯，",
    "voice": "vo_adv_1065010_034",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我不知道。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "畢竟之前那次是我們第二次碰面。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "打手",
    "words": "在妳們那個家族組建而成之前，",
    "voice": "vo_adv_1065010_035",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "打手",
    "words": "\\n那傢伙隻身一人",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "打手",
    "words": "打趴了近一百人的",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "打手",
    "words": "幫派。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "他還在我的店前大鬧特鬧過啊……",
    "voice": "vo_adv_1065010_036",
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "\\n",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "和他一對一交手的話，",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "店長",
    "words": "事情會很不妙喔。",
    "voice": null,
    "unit_id": 1411
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "據說就算跟他有交情，",
    "voice": "vo_adv_1065010_037",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "互毆時他好像也不會手下留情……",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "\\n",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "他甚至有",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "把人從城鎮揍飛到火山的傳聞喔？",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這樣啊……",
    "voice": "vo_adv_1065010_038",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "大吾先生果然是個",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "很不得了的人呢。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "上次見面時他散發的霸氣──",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "該說是氣場吧，那也很不得了，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我已經做好心理準備，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "知道這會是至今為止最艱苦的一架。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……不過，",
    "voice": "vo_adv_1065010_039",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這也是我目前為止最期待的一架。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n畢竟我這邊也擁有",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "至今獲得的力量啊。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我現在",
    "voice": "vo_adv_1065010_040",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "也有這種感覺喔。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不是只有我自身",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "才是自己的力量。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "雖然我不太明白，",
    "voice": "vo_adv_1065010_041",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "但只要打贏這場架，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n我好像就能獲得某樣",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不只是龍人族之力的事物……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不過",
    "voice": "vo_adv_1065010_042",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "對現在的我來說，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你就是最可靠的那個人。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "果然就是要像這樣，得有死黨陪伴在身邊呢。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "正式交手時，就麻煩你在附近默默守護我囉。",
    "voice": "vo_adv_1065010_043",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "在那之後，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "也要一直這麼做。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "是一～直喔。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這是為什麼呢？",
    "voice": "vo_adv_1065010_044",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "最近",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "只要近距離看著{0}，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "就會有一種無法言喻的感覺……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "background",
    "bg_id": "500021"
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……",
    "voice": "vo_adv_1065010_045",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "真不可思議。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "雖然不知道這是為什麼，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n但我的雙眼無法從{0}身上移開……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不僅如此……",
    "voice": "vo_adv_1065010_046",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "一被他這樣子盯著看，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n我們之間的距離就越來越近，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "感覺要被吸過去了……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……",
    "voice": "vo_adv_1065010_047",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這樣下去的話，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "嘴唇好像就要碰在一起了……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我是怎麼了……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "是變得不正常了嗎……？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "background",
    "bg_id": "500130"
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "唔哇啊啊啊啊啊啊！",
    "voice": "vo_adv_1065010_048",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "沒沒沒沒、",
    "voice": "vo_adv_1065010_049",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "沒什麼！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我沒事！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n真的沒什麼！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我為什麼會想起那時候的事啊！",
    "voice": "vo_adv_1065010_050",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我和他",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "應該是死黨吧！？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "都這種時候了，",
    "voice": "vo_adv_1065010_051",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我在想什麼啊……！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "意思是「如果不是這種時候就可以想」嗎！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n我這樣",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不對吧！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "再思考下去的話就輸了！",
    "voice": "vo_adv_1065010_052",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "總之",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我再去特訓一次！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "唔哦哦哦哦！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就這樣，嘉夜獲得了城鎮居民的幫助，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n過起了進行充實訓練的每一天──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500010"
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "所以說咧？",
    "voice": "vo_adv_1065010_053",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你今天叫我出來是有什麼事？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "打手",
    "words": "我試著幫妳挑了實戰訓練的對手。",
    "voice": "vo_adv_1065010_054",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "打手",
    "words": "\\n我選了至少體格",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "打手",
    "words": "和大吾相近的人。",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "打手",
    "words": "\\n",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "打手",
    "words": "應戰方式",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "打手",
    "words": "也先稍微掌握起來比較好，對吧？",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "說得也是……",
    "voice": "vo_adv_1065010_055",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "是誰願意當我的對手？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n不打過來的話，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "就由我主動出擊囉……？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "background",
    "bg_id": "500230"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "background",
    "bg_id": "500230"
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "嗚啊！",
    "voice": "vo_adv_1065010_056",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "可惡，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這傢伙果然……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "很強……！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "但是我",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "怎麼能輸呢……！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "我、",
    "voice": "vo_adv_1065010_057",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "我說，嘉夜……",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "就先特訓到這裡為止好不好？",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "\\n",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "喂，",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "你也一起來阻止她啊！",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "小混混",
    "words": "\\n這樣下去嘉夜會死掉的！",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不，",
    "voice": "vo_adv_1065010_058",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我還能繼續下去……！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我得把自己逼得更緊才行！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n這是為了熟練使用我體內的力量……！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不管怎樣，我都要掌握",
    "voice": "vo_adv_1065010_059",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "覺醒的感覺……！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n這不只是為了我，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "也是為了大家、",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "為了他……！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "！？",
    "voice": "vo_adv_1065010_060",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "剛才那是",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "覺醒的感覺……！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這樣啊。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "說不定……！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "嘉夜數次挑戰讓自己陷入苦戰的魔物，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n卻沒能打倒牠，不斷重複著撤退。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n接著，到了特訓的最後一天，兩天後就要迎來和大吾之間的決戰──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "嗨，",
    "voice": "vo_adv_1065010_061",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "抱歉啦，讓你陪我交手了好幾次。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不過今天就是最後一次了。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我要上啦……！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "最近的我，",
    "voice": "vo_adv_1065010_062",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "為了滿足自己的渴望而使盡全力……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不過",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這樣是不行的吧。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n我的架，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "並不只屬於我。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "為了某人……",
    "voice": "vo_adv_1065010_063",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "為了死黨，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我要拿下勝利。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n我要打趴這傢伙，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "大吾先生……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我也要",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "打贏你！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "喝啊啊啊啊！！",
    "voice": "vo_adv_1065010_064",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n龍之",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "終結拳────！！！！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "background",
    "bg_id": "500230"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……",
    "voice": "vo_adv_1065010_065",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "就這樣啦。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你啊，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "還滿強的。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "嗯！",
    "voice": "vo_adv_1065010_066",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "就算用了覺醒的力量，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n也不像之前那樣會有強烈的失控感，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n我已經做好打架的準備了！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "謝啦！",
    "voice": "vo_adv_1065010_067",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n我能走到這一步，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "都是託你這位死黨的福！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我們會不會",
    "voice": "vo_adv_1065010_068",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "高興得",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "有點太誇張了啊？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不過算了，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這樣也沒什麼不好的吧。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "畢竟很不容易啊。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……因為有你在，",
    "voice": "vo_adv_1065010_069",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我才能跨越難關。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n你真的幫了我很多喔。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "非常謝謝你。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……對我來說，",
    "voice": "vo_adv_1065010_070",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "你果然是不可或缺的。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "因為有你在，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我才……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……",
    "voice": "vo_adv_1065010_071",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "感覺",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "好像",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "口渴起來了……",
    "voice": null,
    "unit_id": 106511
  },
