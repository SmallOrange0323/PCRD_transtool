  {
    "type": "dialogue",
    "name": "宮子",
    "words": "想和宮子在一起？",
    "voice": "vo_adv_9500021_000",
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "……你好奇怪喲。",
    "voice": null,
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "事到如今還說這種話？",
    "voice": null,
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "不管是你還是你的布丁，",
    "voice": null,
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "早就是宮子的喲。",
    "voice": null,
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "你會和宮子一直在一起，",
    "voice": "vo_adv_9500021_001",
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "也是理所當然的事喲。",
    "voice": null,
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n所以，",
    "voice": null,
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "人家也沒有",
    "voice": null,
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "特別開心之類的……",
    "voice": null,
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "……好奇怪喲。",
    "voice": "vo_adv_9500021_002",
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n明明{0}選擇宮子是",
    "voice": null,
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "理所當然的才對……",
    "voice": null,
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "但能被你選擇，",
    "voice": null,
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "不知怎麼地覺得好開心。",
    "voice": null,
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "就像吃布丁的時候一樣，",
    "voice": "vo_adv_9500021_003",
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n身體比平常還要輕飄飄的，",
    "voice": null,
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "心裡也暖洋洋的。",
    "voice": null,
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "……",
    "voice": null,
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "你，",
    "voice": null,
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "對宮子做了什麼？",
    "voice": null,
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "……既然如此，",
    "voice": "vo_adv_9500021_004",
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子也最喜歡你了喲！",
    "voice": null,
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n你會幫人家買布丁，",
    "voice": null,
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "買不到的話還會親手做給人家吃，",
    "voice": null,
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n所以，人家最喜歡你了，",
    "voice": null,
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "就像人家最喜歡布丁一樣喲！",
    "voice": null,
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "還有，",
    "voice": "vo_adv_9500021_005",
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子想見你的時候，",
    "voice": null,
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "你就會來找宮子。",
    "voice": null,
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n如果有奇怪的人欺負人家，",
    "voice": null,
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "你就會來救人家。",
    "voice": null,
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n宮子的心願，",
    "voice": null,
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "你也有好好聽進去……",
    "voice": null,
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "咦……？",
    "voice": "vo_adv_9500021_006",
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "說著說著，",
    "voice": null,
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "已經和布丁沒什麼關係了呢。",
    "voice": null,
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n喜歡布丁和",
    "voice": null,
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "喜歡{0}……",
    "voice": null,
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n感覺好像是",
    "voice": null,
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "不太一樣的「喜歡」。",
    "voice": null,
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "如果宮子",
    "voice": "vo_adv_9500021_007",
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "說喜歡你，",
    "voice": null,
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "{0}也會感到開心嗎？",
    "voice": null,
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n……也會像宮子一樣，",
    "voice": null,
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "身體輕飄飄的嗎？",
    "voice": null,
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "嗯……",
    "voice": "vo_adv_9500021_008",
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "雖然不是很懂，",
    "voice": null,
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "但人家明白了！",
    "voice": null,
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n既然這樣，",
    "voice": null,
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "我們就是",
    "voice": null,
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "一樣的「喜歡」了喲！",
    "voice": null,
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n這可是大發現喲！",
    "voice": null,
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子",
    "voice": "vo_adv_9500021_009",
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "再也不會",
    "voice": null,
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "離開你了！",
    "voice": null,
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n從今以後，",
    "voice": null,
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "要永遠、",
    "voice": null,
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "永～遠，",
    "voice": null,
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "和你一起生活！",
    "voice": null,
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n為了這個，",
    "voice": null,
    "unit_id": 100741
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子不管什麼事都會努力的！",
    "voice": null,
    "unit_id": 100741
  }
