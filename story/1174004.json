[
  {
    "type": "background",
    "bg_id": "500280"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "與紡希來到祕境之島的隔天。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在清晨的沙灘上，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "出現了紡希獨自收集著「星之碎片」的身影。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我還想說是誰，",
    "voice": "vo_adv_1174004_000",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "原來是騎士先生啊。",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n你是早上起床散步嗎？",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我呢，",
    "voice": "vo_adv_1174004_001",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "嗯，",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "在接續昨天的事。",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n「星之碎片」",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "還沒全部找齊嘛。",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "但是，還剩下那麼一點，",
    "voice": "vo_adv_1174004_002",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "無論怎麼找也找不到呢……",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "朝陽也快完全昇起來了。",
    "voice": "vo_adv_1174004_003",
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "嗯～",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "陽光真耀眼。",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "不過好像有點太耀眼了──",
    "voice": null,
    "unit_id": 117411
  },
  {
    "type": "background",
    "bg_id": "510250"
  },
  {
    "type": "dialogue",
    "name": "友人1",
    "words": "要來囉──！",
    "voice": "vo_adv_1174004_004",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "友人1",
    "words": "看──球！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "休想得逞！",
    "voice": "vo_adv_1174004_005",
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "好！",
    "voice": "vo_adv_1174004_006",
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "勉強接到球了！",
    "voice": null,
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "接下來──",
    "voice": null,
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "騎士先生！",
    "voice": "vo_adv_1174004_007",
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "請你把球打上去！！",
    "voice": null,
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "友人2",
    "words": "呵呵，",
    "voice": "vo_adv_1174004_008",
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "友人2",
    "words": "我們先",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "友人2",
    "words": "得一分啦。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "友人2",
    "words": "\\n照這情況看來，我們第二局",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "友人2",
    "words": "或許也能直接拿下勝利呢。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "嗚唔唔……！",
    "voice": "vo_adv_1174004_009",
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "騎士先生，",
    "voice": null,
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "你剛才為什麼沒接到球啊！？",
    "voice": null,
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "又說「對不起」……",
    "voice": "vo_adv_1174004_010",
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "你的道歉我已經聽膩了！",
    "voice": null,
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "聽好了！",
    "voice": "vo_adv_1174004_011",
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "不論以何種形式，",
    "voice": null,
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "不讓球落地是最重要的！",
    "voice": null,
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n不要等在原地，要衝去接球啊！",
    "voice": null,
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "聽懂了嗎！？",
    "voice": null,
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "友人1",
    "words": "好啦好啦，",
    "voice": "vo_adv_1174004_012",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "友人1",
    "words": "紡希。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "友人1",
    "words": "\\n妳這樣責備他，他也太可憐了！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "友人2",
    "words": "我們正愁著人數不足，",
    "voice": "vo_adv_1174004_013",
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "友人2",
    "words": "這個人就自願加入了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "友人2",
    "words": "\\n不可以對他發脾氣啦。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "說得那麼事不關己……",
    "voice": "vo_adv_1174004_014",
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n我明明從頭到尾都反對騎士先生加入！",
    "voice": null,
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "然而！！　",
    "voice": null,
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "說什麼「想和他打好關係，",
    "voice": "vo_adv_1174004_015",
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "請教有關怜大人的事♪」！",
    "voice": null,
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n根本就沒有打算要好好玩沙灘排球嘛！？　",
    "voice": null,
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "還有騎士先生也真是的！",
    "voice": "vo_adv_1174004_016",
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n就算剛好是打工的休息時間，",
    "voice": null,
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "也別這麼輕易地答應嘛！　",
    "voice": null,
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "啊啊……",
    "voice": "vo_adv_1174004_017",
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我真恨那個",
    "voice": null,
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "在分組時出了布的自己。",
    "voice": null,
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "不如說，",
    "voice": null,
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "更恨那個當時同樣出了布的騎士先生！　",
    "voice": null,
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "騎士先生！",
    "voice": "vo_adv_1174004_018",
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "請你站起來！！",
    "voice": null,
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n我們下次一定要得分喔！？",
    "voice": null,
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "友人2",
    "words": "球打上去了！",
    "voice": "vo_adv_1174004_019",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "友人1",
    "words": "右邊",
    "voice": "vo_adv_1174004_020",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "友人1",
    "words": "有空隙喔！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "友人1",
    "words": "\\n嘿！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "糟糕！",
    "voice": "vo_adv_1174004_021",
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "來不及了！！　",
    "voice": null,
    "unit_id": 117431
  },
  {
    "type": "background",
    "bg_id": "510250"
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "等等！？",
    "voice": "vo_adv_1174004_022",
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "哪有人用臉去接球啊！？",
    "voice": null,
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "Stop、Stop～！",
    "voice": null,
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "暫停一下！！",
    "voice": null,
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我說你啊！",
    "voice": "vo_adv_1174004_023",
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n雖然是叫你衝去接球，",
    "voice": null,
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "但也該有個限度吧！",
    "voice": null,
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "……你不是故意的？",
    "voice": "vo_adv_1174004_024",
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "那就好。",
    "voice": null,
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n比起這個，讓我看看你被球打到的地方。",
    "voice": null,
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "……嗯，",
    "voice": null,
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "有一點點紅，",
    "voice": null,
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "不過似乎沒有受傷。",
    "voice": null,
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "可是，",
    "voice": "vo_adv_1174004_025",
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "這都是我的錯。",
    "voice": null,
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我對騎士先生說得太過分了……",
    "voice": null,
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "得好好反省才行……",
    "voice": null,
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "那、",
    "voice": "vo_adv_1174004_026",
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "那個，騎士先生。",
    "voice": null,
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n關於剛剛說的話……",
    "voice": null,
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "咦？",
    "voice": "vo_adv_1174004_027",
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "你怎麼突然這麼有幹勁啊！？",
    "voice": null,
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "「多虧了紡希，我終於能碰到球了？」",
    "voice": "vo_adv_1174004_028",
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "……你這個人永遠都這麼積極樂觀呢。",
    "voice": null,
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "不過，",
    "voice": null,
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "這樣啊……",
    "voice": null,
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "既然你這麼有幹勁，",
    "voice": "vo_adv_1174004_029",
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我也不需要手下留情了！",
    "voice": null,
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "\\n",
    "voice": null,
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "騎士先生，",
    "voice": null,
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "我們來盡情得分吧！！",
    "voice": null,
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "友人1",
    "words": "我把球托上去了！",
    "voice": "vo_adv_1174004_030",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "友人1",
    "words": "\\n盡全力打過去吧！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "友人2",
    "words": "我要上了……！",
    "voice": "vo_adv_1174004_031",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "休想得逞！！",
    "voice": "vo_adv_1174004_032",
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "很好！",
    "voice": "vo_adv_1174004_033",
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "騎士先生，",
    "voice": null,
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "請你把球打上去！！",
    "voice": null,
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "做得好！",
    "voice": "vo_adv_1174004_034",
    "unit_id": 117431
  },
  {
    "type": "dialogue",
    "name": "紡希",
    "words": "接下來就由我來……",
    "voice": null,
