    },
    {
        "name": "秘書",
        "words": "……克蕾琪塔小姐。",
        "voice": "vo_adv_2105099_031"
    },
    {
        "name": "秘書",
        "words": "\\n結果您還是",
        "voice": null
    },
    {
        "name": "秘書",
        "words": "沒有在陛下的食物中……",
        "voice": null
    },
    {
        "name": "秘書",
