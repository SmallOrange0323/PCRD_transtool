[
    {
        "name": "旁白",
        "words": "然後，到了與阿澤爾德戰鬥後的隔天──",
        "voice": null
    },
    {
        "name": "旁白",
        "words": "【里士滿工商會】的克蕾琪塔，",
        "voice": null
    },
    {
        "name": "旁白",
        "words": "\\n再次受到豪紳議長傳喚。",
        "voice": null
    },
    {
        "type": "background",
        "bg_id": "501070"
    },
    {
        "name": "豪紳",
        "words": "──克蕾琪塔‧凱許。",
        "voice": "vo_adv_2105099_000"
    },
    {
        "name": "豪紳",
        "words": "\\n妳自己做了什麼事，導致現在被我叫來……",
        "voice": null
    },
    {
        "name": "豪紳",
        "words": "妳應該很清楚吧？",
        "voice": null
    },
    {
        "name": "克蕾琪塔",
        "words": "……哎呀哎呀，",
        "voice": "vo_adv_2105099_001"
    },
    {
        "name": "克蕾琪塔",
        "words": "我有做什麼",
        "voice": null
    },
    {
        "name": "克蕾琪塔",
        "words": "\\n會害議長您心情不好……",
        "voice": null
    },
    {
        "name": "克蕾琪塔",
        "words": "的事嗎？",
        "voice": null
    },
    {
        "name": "克蕾琪塔",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "克蕾琪塔",
        "words": "如果是「我沒有做的事」，",
        "voice": null
    },
    {
        "name": "克蕾琪塔",
        "words": "這我倒是有頭緒。",
        "voice": null
    },
    {
        "name": "豪紳",
        "words": "哼，",
        "voice": "vo_adv_2105099_002"
    },
    {
        "name": "豪紳",
        "words": "\\n妳很清楚嘛。",
        "voice": null
    },
    {
        "name": "豪紳",
        "words": "吾輩的手下傳來報告，",
        "voice": "vo_adv_2105099_003"
    },
    {
        "name": "豪紳",
        "words": "\\n聽說在昨天的騷動之中，",
        "voice": null
    },
    {
        "name": "豪紳",
        "words": "陛下身體不適時，妳明明在場……",
        "voice": null
    },
    {
        "name": "豪紳",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "豪紳",
        "words": "卻什麼都沒有做是吧？",
        "voice": null
    },
    {
        "name": "克蕾琪塔",
        "words": "是啊，",
        "voice": "vo_adv_2105099_004"
    },
    {
        "name": "克蕾琪塔",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "克蕾琪塔",
        "words": "因為我太笨拙……",
        "voice": null
    },
    {
        "name": "克蕾琪塔",
        "words": "準備得不夠充分，",
        "voice": null
    },
    {
        "name": "克蕾琪塔",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "克蕾琪塔",
        "words": "請您原諒。",
        "voice": null
    },
    {
        "name": "克蕾琪塔",
        "words": "畢竟我",
        "voice": "vo_adv_2105099_005"
    },
    {
        "name": "克蕾琪塔",
        "words": "僅僅是個商人，",
        "voice": null
    },
    {
        "name": "克蕾琪塔",
        "words": "\\n並非醫生或魔法師。",
        "voice": null
    },
    {
        "name": "克蕾琪塔",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "克蕾琪塔",
        "words": "因此看見陛下倒在眼前時，",
        "voice": null
    },
    {
        "name": "克蕾琪塔",
        "words": "我只能夠驚慌失措……",
        "voice": null
    },
    {
        "name": "克蕾琪塔",
        "words": "想進行「治療行為」，",
        "voice": "vo_adv_2105099_006"
    },
    {
        "name": "克蕾琪塔",
        "words": "實在太困難了，",
        "voice": null
    },
    {
        "name": "克蕾琪塔",
        "words": "\\n畢竟在那混亂的戰場上……",
        "voice": null
    },
    {
        "name": "克蕾琪塔",
        "words": "您能理解吧？",
        "voice": null
    },
    {
        "name": "豪紳",
        "words": "……少得意忘形了，",
        "voice": "vo_adv_2105099_007"
    },
    {
        "name": "豪紳",
        "words": "區區一個商人。",
        "voice": null
    },
    {
        "name": "豪紳",
        "words": "幾天前，",
        "voice": "vo_adv_2105099_008"
    },
    {
        "name": "豪紳",
        "words": "\\n吾輩對妳說了什麼……",
        "voice": null
    },
    {
        "name": "豪紳",
        "words": "可不准妳說妳忘了。",
        "voice": null
    },
    {
        "name": "克蕾琪塔",
        "words": "這個嘛……",
        "voice": "vo_adv_2105099_009"
    },
    {
        "name": "克蕾琪塔",
        "words": "我想想，",
        "voice": null
    },
    {
        "name": "克蕾琪塔",
        "words": "\\n「統治這個國家，",
        "voice": null
    },
    {
        "name": "克蕾琪塔",
        "words": "是擁有智慧的大人的職責」……",
        "voice": null
    },
    {
        "name": "克蕾琪塔",
        "words": "\\n您似乎說了這些話吧。",
        "voice": null
    },
    {
        "name": "豪紳",
        "words": "在那之後呢？",
        "voice": "vo_adv_2105099_010"
    },
    {
        "name": "克蕾琪塔",
        "words": "…………",
        "voice": "vo_adv_2105099_011"
    },
    {
        "name": "克蕾琪塔",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "克蕾琪塔",
        "words": "「陛下統治期間拖久了，",
        "voice": null
    },
    {
        "name": "克蕾琪塔",
        "words": "對這個國家來說並不樂見」",
        "voice": null
    },
    {
        "name": "克蕾琪塔",
        "words": "……您這麼說了。",
        "voice": null
    },
    {
        "name": "克蕾琪塔",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "克蕾琪塔",
        "words": "確實我也",
        "voice": null
    },
    {
        "name": "克蕾琪塔",
        "words": "對此深有同感……",
        "voice": null
    },
    {
        "name": "豪紳",
        "words": "……哼，",
        "voice": "vo_adv_2105099_012"
    },
    {
        "name": "豪紳",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "豪紳",
        "words": "那麼，",
        "voice": null
    },
    {
        "name": "豪紳",
        "words": "妳應該要怎麼做呢？",
        "voice": null
    },
    {
        "name": "克蕾琪塔",
        "words": "……那個，",
        "voice": "vo_adv_2105099_013"
    },
    {
        "name": "克蕾琪塔",
        "words": "議長。",
        "voice": null
    },
    {
        "name": "克蕾琪塔",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "克蕾琪塔",
        "words": "雖然我有同感……",
        "voice": null
    },
    {
        "name": "克蕾琪塔",
        "words": "\\n但是也沒必要",
        "voice": null
    },
    {
        "name": "克蕾琪塔",
        "words": "這麼著急行事吧？",
        "voice": null
    },
    {
        "name": "豪紳",
        "words": "……啊啊？",
        "voice": "vo_adv_2105099_014"
    },
    {
        "name": "克蕾琪塔",
        "words": "只要我們出手，",
        "voice": "vo_adv_2105099_015"
    },
    {
        "name": "克蕾琪塔",
        "words": "要讓那個天真的公主殿下孤立，",
        "voice": null
    },
    {
        "name": "克蕾琪塔",
        "words": "\\n成為方便的傀儡，並非難事。",
        "voice": null
    },
    {
        "name": "克蕾琪塔",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "克蕾琪塔",
        "words": "……粗魯的手段",
        "voice": null
    },
    {
        "name": "克蕾琪塔",
        "words": "反而只會引起蘭德索爾的混亂不是嗎──",
        "voice": null
    },
    {
        "name": "豪紳",
        "words": "住口！！",
        "voice": "vo_adv_2105099_016"
    },
    {
        "name": "克蕾琪塔",
        "words": "……唔！",
        "voice": "vo_adv_2105099_017"
    },
    {
        "name": "豪紳",
        "words": "聽好了！",
        "voice": "vo_adv_2105099_018"
    },
    {
        "name": "豪紳",
        "words": "\\n至今為止，",
        "voice": null
    },
    {
        "name": "豪紳",
        "words": "吾輩只是因為妳工作時稍微懂得變通，",
        "voice": null
    },
    {
        "name": "豪紳",
        "words": "\\n才處處給妳方便……！",
        "voice": null
    },
    {
        "name": "豪紳",
        "words": "如果說妳無能到連吾輩話語中的意涵，",
        "voice": "vo_adv_2105099_019"
    },
    {
        "name": "豪紳",
        "words": "也無法自行察覺的話──",
        "voice": null
    },
    {
        "name": "豪紳",
        "words": "\\n吾輩要讓妳搞清楚，",
        "voice": null
    },
    {
        "name": "豪紳",
        "words": "像妳這樣一文不值的商人，吾輩隨時都能把妳轟走！",
        "voice": null
    },
    {
        "name": "豪紳",
        "words": "\\n因為貴族議會的權力，",
        "voice": null
    },
    {
        "name": "豪紳",
        "words": "可是掌握在吾輩手中的啊！",
        "voice": null
    },
    {
        "name": "克蕾琪塔",
        "words": "……這是當然，",
        "voice": "vo_adv_2105099_020"
    },
    {
        "name": "克蕾琪塔",
        "words": "\\n我會銘記於心的，",
        "voice": null
    },
    {
        "name": "克蕾琪塔",
        "words": "豪紳議長大人。",
        "voice": null
    },
    {
        "name": "豪紳",
        "words": "……很好。",
        "voice": "vo_adv_2105099_021"
    },
    {
        "name": "豪紳",
        "words": "\\n",
        "voice": null
    },
    {
        "name": "豪紳",
        "words": "那麼，",
        "voice": null
    },
    {
        "name": "豪紳",
        "words": "吾輩就賜予妳最後的機會吧。",
        "voice": null
    },
    {
        "name": "豪紳",
        "words": "\\n聽好了，",
        "voice": null
    },
    {
        "name": "豪紳",
        "words": "妳這無能的傢伙──",
        "voice": null
    },
    {
        "type": "background",
        "bg_id": "500095"
    },
    {
        "name": "克蕾琪塔",
        "words": "…………",
