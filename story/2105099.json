    },
    {
        "name": "秘書",
        "words": "話說……",
        "voice": "vo_adv_2105099_036"
    },
    {
        "name": "秘書",
        "words": "您為了預防您不得不親自吃下",
        "voice": null
    },
    {
        "name": "秘書",
        "words": "\\n加有「配料」的料理的情況，而帶去的解毒藥",
