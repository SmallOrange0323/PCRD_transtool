    },
    {
        "name": "克蕾琪塔",
        "words": "……哎呀？",
        "voice": "vo_adv_2105099_024"
    },
    {
        "name": "克蕾琪塔",
        "words": "\\n怎麼了嗎，祕書1號？",
        "voice": null
    },
    {
        "name": "克蕾琪塔",
        "words": "\\n我不是給了妳大福利，",
        "voice": null
    },
    {
        "name": "克蕾琪塔",
        "words": "讓妳今天特別可以準時下班嗎？",
        "voice": null
    },
    {
        "name": "秘書",
        "words": "不，",
        "voice": "vo_adv_2105099_025"
    },
    {
        "name": "秘書",
        "words": "那是理所當然的待遇……",
        "voice": null
    },
    {
        "name": "秘書",
        "words": "先別說這個了，",
