    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "都一樣不是嗎？",
    "voice": null,
    "unit_id": 132311
  },
  {
    "type": "dialogue",
    "name": "露易絲瑪莉",
    "words": "唯有不放棄的傢伙才能得到最後的勝利。",
