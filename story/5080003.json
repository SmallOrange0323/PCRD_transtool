[
  {
    "type": "background",
    "bg_id": "500334"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "根據{0}的主意，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n一行人前往遠離蘭德索爾的各個村莊展開兜售。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "靠過來",
    "voice": "vo_adv_5080003_000",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "看過來，",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "正於蘭德索爾舉辦的",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "聖誕節甜點大賽參賽點心，",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n來巡迴販賣啦～",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "我們帶來了很多可口的點心喔。",
    "voice": "vo_adv_5080003_001",
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "\\n請務必過來看看。",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "…………",
    "voice": "vo_adv_5080003_002",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "好了，",
    "voice": "vo_adv_5080003_003",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "宮子。",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n別一直賭氣了，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "打起精神叫賣吧。",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n妳不是都吃好多布丁了嗎。",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "可是……",
    "voice": "vo_adv_5080003_004",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "村民1",
    "words": "哎呀，",
    "voice": "vo_adv_5080003_005",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "村民1",
    "words": "看起來很好吃呢。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "村民1",
    "words": "\\n那我買",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "村民1",
    "words": "這個巧克力蛋糕好了。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "妳真有眼光！",
    "voice": "vo_adv_5080003_006",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "這家店的巧克力，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n以取自於可可亞烏拉這種魔物的",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "特殊可可亞",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "製作而成，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n非常好吃喔！",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "村民1",
    "words": "啊，",
    "voice": "vo_adv_5080003_007",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "村民1",
    "words": "我好像有聽過。",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "村民1",
    "words": "\\n連這麼少見的東西，在蘭德索爾也有普通在賣啊……",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "並不普通喔。",
    "voice": "vo_adv_5080003_008",
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "這是這家店講究的特色。",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "如果妳喜歡的話，",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "來蘭德索爾的時候",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "請再去",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "購買吧。",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "村民1",
    "words": "好的，",
    "voice": "vo_adv_5080003_009",
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "村民1",
    "words": "謝謝！",
    "voice": null,
    "unit_id": 411
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "婆婆",
    "voice": "vo_adv_5080003_010",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "不賣自己的點心，",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n只顧著推薦別人店裡的點心。",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子不明白這麼做有什麼意思。",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "唉，我也理解宮子的心情就是了。",
    "voice": "vo_adv_5080003_011",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "當老婆婆說出",
    "voice": "vo_adv_5080003_012",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "要盡可能將",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "參加比賽的其他店家的點心",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n一起帶來的時候，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我也覺得",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "很困惑呢。",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "抱歉，",
    "voice": "vo_adv_5080003_013",
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "要大家接受我",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "任性的要求。",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "我心想既然要去遙遠的村莊，",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "\\n那我想把蘭德索爾的慶典氣氛",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "也一起帶去。",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "真的！",
    "voice": "vo_adv_5080003_014",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n明明好不容易獨占了客人，",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "全都泡湯了！",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "嗯～",
    "voice": "vo_adv_5080003_015",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "如果只考慮比賽，",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n宮子的想法",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "應該是對的，但是……",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "村民2",
    "words": "哎呀～",
    "voice": "vo_adv_5080003_016",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "村民2",
    "words": "沒想到你會帶這麼棒的伴手禮回來。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "村民3",
    "words": "有好多只在傳聞中聽過的名店甜點！",
    "voice": "vo_adv_5080003_017",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "哎呀，",
    "voice": "vo_adv_5080003_018",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "這真的是巧合的結果。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n應該要感謝的是他們幾位，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n願意特地過來這種鄉下地方啊。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "因為大家看起來都很開心，",
    "voice": "vo_adv_5080003_019",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "讓我覺得",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "有這樣做真好。",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "人家一點也不懂好在哪裡！",
    "voice": "vo_adv_5080003_020",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n沒贏得勝利就沒有宣傳效果喲！",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "不不，",
    "voice": "vo_adv_5080003_021",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "像這樣巡迴各種地方也是",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "很好的宣傳啊。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "就是先混個臉熟，讓人對點心味道留下印象",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "這樣。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "而且妳沒注意到嗎？",
    "voice": "vo_adv_5080003_022",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n老婆婆的點心的銷售情況，",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "比起在蘭德索爾的時候賣得好喔？",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "是嗎……？",
    "voice": "vo_adv_5080003_023",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "但如果是那樣，",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "沒有其他點心應該會賣得更好喲！",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "這",
    "voice": "vo_adv_5080003_024",
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "很難講。",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "我的點心並不華麗，",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "\\n如果只有我的點心，",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "大概賣不出去吧？",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "感覺華麗的點心與樸實的點心",
    "voice": "vo_adv_5080003_025",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "在互相襯托，",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n相得益彰呢。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "在像蘭德索爾那種華麗的氣氛中，",
    "voice": "vo_adv_5080003_026",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n無論如何都會是",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "花俏的東西更暢銷，",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "但在這樣的地方兜售，",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "搭配起來就變得剛剛好啦。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "……啊！？",
    "voice": "vo_adv_5080003_027",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "難道妳是為了獲得加乘作用",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "而讓其他店的產品寄賣！？",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "\\n",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "真不愧是老婆婆！",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "這就叫辣椒還是比薑辣吧！",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "妳要說的是",
    "voice": "vo_adv_5080003_028",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "薑還是老的辣",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "吧。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "辣椒感覺當然",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "比薑更辣就是了。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "如果我說",
    "voice": "vo_adv_5080003_029",
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "從一開始就有這個打算，",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "聽起來大概很像那麼回事，",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "\\n但我連想都沒想過",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "那種事。",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "我只在蘭德索爾做過生意，",
    "voice": "vo_adv_5080003_030",
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "\\n所以也不像真陽一樣",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "有關於兜售的智慧與經驗。",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "只是，",
    "voice": "vo_adv_5080003_031",
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "要怎麼說呢。",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "看到熱衷於比賽的人，",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "\\n我總覺得很討厭",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "用那種方式強迫推銷。",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "雖然大家難得過來幫忙，",
    "voice": "vo_adv_5080003_032",
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "\\n我大概必須更有野心才行……",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "但我至今",
    "voice": "vo_adv_5080003_033",
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "都是因為喜歡人們為點心感到高興的表情而做生意的。",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "\\n我不想捨棄",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "這個根本的想法。",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "我就是愛說這種天真的話，",
    "voice": "vo_adv_5080003_034",
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "才會跟不上時代，",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "\\n導致店鋪經營不下去的吧。",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "老婆婆……",
    "voice": "vo_adv_5080003_035",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "大家",
    "voice": "vo_adv_5080003_036",
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "都在努力加油，",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "\\n所以我不能說這種喪氣話對吧。",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "我會",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "以我的方式",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "盡力的。",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子也會為了婆婆努力的！",
    "voice": "vo_adv_5080003_037",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n一定要讓店鋪繼續開下去喲！",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "要加油喲！",
    "voice": "vo_adv_5080003_038",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "宮子",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "去村子裡繞一圈！",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "你也跟過來喲！",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "咦？",
    "voice": "vo_adv_5080003_039",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "我還以為她又會要求布丁的說。",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "說來說去，",
    "voice": "vo_adv_5080003_040",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n宮子真的",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "是在為老婆婆而努力呢。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "宮子真是個溫柔的孩子呢。",
    "voice": "vo_adv_5080003_041",
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "璃乃、真陽",
    "words": "…………",
    "voice": "vo_adv_5080003_042",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "呵呵，",
    "voice": "vo_adv_5080003_043",
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "是真的喔。",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "雖然這或許得上了年紀",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "才能明白。",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "是這樣嗎？",
    "voice": "vo_adv_5080003_044",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "嗯……",
    "voice": "vo_adv_5080003_045",
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "璃乃",
    "words": "雖然她是個不可思議地讓人無法討厭的孩子……",
    "voice": null,
    "unit_id": 119311
  },
  {
    "type": "dialogue",
    "name": "小孩１",
    "words": "等等～",
    "voice": "vo_adv_5080003_046",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "小孩１",
    "words": "聖誕老人～",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "小孩２",
    "words": "給我禮物嘛～",
    "voice": "vo_adv_5080003_047",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩３",
    "words": "妳是怎麼飄起來的～？",
    "voice": "vo_adv_5080003_048",
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "小孩３",
    "words": "\\n雪橇在哪裡～？",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "小孩３",
    "words": "馴鹿呢～",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "別跟過來～",
    "voice": "vo_adv_5080003_049",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n人家沒空理你們這些沒錢的小孩～",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "哇哇！？",
    "voice": "vo_adv_5080003_050",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n妳帶了好多非常可愛的客人回來啦。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "小孩１",
    "words": "哇～",
    "voice": "vo_adv_5080003_051",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "小孩１",
    "words": "大姐姐是馴鹿？",
    "voice": null,
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "嗯？",
    "voice": "vo_adv_5080003_052",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "沒錯啦。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n馴鹿大姐姐拉著攤子……",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "不，",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "\\n",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "是雪橇",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "來到這裡啦。",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "小孩２",
    "words": "這裡的點心是",
    "voice": "vo_adv_5080003_053",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩２",
    "words": "禮物嗎～？",
    "voice": null,
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "不是喲！",
    "voice": "vo_adv_5080003_054",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "這個是……",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "這個嘛。",
    "voice": "vo_adv_5080003_055",
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "算是提早了一點的",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "聖誕禮物吧。",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "\\n大家有沒有好好地",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "當個乖孩子呢？",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "孩子們",
    "words": "有啊～！",
    "voice": "vo_adv_5080003_056",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "那就得給你們禮物才行囉。",
    "voice": "vo_adv_5080003_057",
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "來，",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "各拿一片餅乾吧。",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "小孩２",
    "words": "哇～！",
    "voice": "vo_adv_5080003_058",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩１",
    "words": "謝謝～！",
    "voice": "vo_adv_5080003_059",
    "unit_id": 211
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "呵呵，",
    "voice": "vo_adv_5080003_060",
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "不客氣。",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "婆婆，",
    "voice": "vo_adv_5080003_061",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "妳在做什麼呀！",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "這些點心是……",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "still",
    "still_id": "508000301"
  },
  {
    "type": "dialogue",
    "name": "小孩２",
    "words": "謝謝聖誕老人～",
    "voice": "vo_adv_5080003_062",
    "unit_id": 111
  },
  {
    "type": "dialogue",
    "name": "小孩３",
    "words": "哇啊！",
    "voice": "vo_adv_5080003_063",
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "小孩３",
    "words": "這個餅乾好好吃喔！",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "喂！",
    "voice": "vo_adv_5080003_064",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "你們擅自吃什麼吃！",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "宮子，",
    "voice": "vo_adv_5080003_065",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "老婆婆都說了可以……",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "吃以前要先說「我開動了」！",
    "voice": "vo_adv_5080003_066",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n吃完後要說「謝謝招待」喲！",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "喔、",
    "voice": "vo_adv_5080003_067",
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "真陽",
    "words": "喔喔……？",
    "voice": null,
    "unit_id": 119211
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "呵呵，",
    "voice": "vo_adv_5080003_068",
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "對呀。",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "\\n",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "要好好地說「我開動了」",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "奶奶",
    "words": "還有「謝謝招待」喔。",
    "voice": null,
    "unit_id": 7912
  },
  {
    "type": "dialogue",
    "name": "小孩３",
    "words": "……啊！",
    "voice": "vo_adv_5080003_069",
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "小孩３",
    "words": "對不起。",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "小孩３",
    "words": "\\n",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "小孩３",
    "words": "謝謝招待。",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "小孩３",
    "words": "很好吃喔！",
    "voice": null,
    "unit_id": 416
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "做得很好！",
    "voice": "vo_adv_5080003_070",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n「我開動了」和「謝謝招待」很重要的喲！",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "…………嗯？",
    "voice": "vo_adv_5080003_071",
    "unit_id": 119911
  },
  {
    "type": "dialogue",
    "name": "宮子",
    "words": "\\n宮子",
    "voice": null,
    "unit_id": 119911
  },
  {
    "type": "dialogue",
