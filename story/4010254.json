  {
    "type": "dialogue",
    "name": "布武機",
    "words": "哇～",
    "voice": "vo_adv_4010254_000",
    "unit_id": 130231
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "好吃～～♡",
    "voice": null,
    "unit_id": 130231
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n這三球冰淇淋",
    "voice": null,
    "unit_id": 130231
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "有草莓、香草和巧克力，",
    "voice": null,
    "unit_id": 130231
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 130231
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "還有雜碎哥哥錢包的味道～♡",
    "voice": null,
    "unit_id": 130231
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "接下來想喝飲料耶～？",
    "voice": "vo_adv_4010254_001",
    "unit_id": 130231
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 130231
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "當然，",
    "voice": null,
    "unit_id": 130231
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "是雜碎哥哥請客♪",
    "voice": null,
    "unit_id": 130231
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "欸～",
    "voice": "vo_adv_4010254_002",
    "unit_id": 130231
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "可以吧～？",
    "voice": null,
    "unit_id": 130231
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n畢竟是我一年一度的生日嘛♡",
    "voice": null,
    "unit_id": 130231
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 130231
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "你甚至應該感謝我",
    "voice": null,
    "unit_id": 130231
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "讓你幫我慶祝才對～♡",
    "voice": null,
    "unit_id": 130231
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "……咦？",
    "voice": "vo_adv_4010254_003",
    "unit_id": 130231
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "不不不，",
    "voice": null,
    "unit_id": 130231
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "這完全是兩回事吧。",
    "voice": null,
    "unit_id": 130231
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n冰淇淋跟飲料只能算是入場費啦！",
    "voice": null,
    "unit_id": 130231
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 130231
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "不算數啦！",
    "voice": null,
    "unit_id": 130231
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "不算數！",
    "voice": null,
    "unit_id": 130231
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "不算數！",
    "voice": null,
    "unit_id": 130231
  },
  {
    "type": "dialogue",
