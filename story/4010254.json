    "type": "dialogue",
    "name": "布武機",
    "words": "\\n",
    "voice": null,
    "unit_id": 130231
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "討厭～",
    "voice": null,
    "unit_id": 130231
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "雜碎哥哥",
