  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "之前約會時，",
    "voice": null,
    "unit_id": 130231
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "\\n我一眼就愛上的頸鍊嗎～♡",
    "voice": null,
    "unit_id": 130231
  },
