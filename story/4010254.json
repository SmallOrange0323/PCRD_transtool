    "voice": "vo_adv_4010254_007",
    "unit_id": 130231
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "話說～",
    "voice": null,
    "unit_id": 130231
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "送人家頸鍊，",
    "voice": null,
    "unit_id": 130231
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "你知道是什麼意思嗎～？",
