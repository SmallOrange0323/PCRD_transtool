    "unit_id": 130231
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "的私心也太明顯了吧♡",
    "voice": null,
    "unit_id": 130231
  },
  {
    "type": "dialogue",
    "name": "布武機",
    "words": "真是的～",
    "voice": "vo_adv_4010254_008",
    "unit_id": 130231
  },
  {
    "type": "dialogue",
    "name": "布武機",
