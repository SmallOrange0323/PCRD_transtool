[
  {
    "type": "background",
    "bg_id": "502110"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "由於前些日子「蘭德索爾國際博覽會」的事件，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n涅妃‧涅羅邀請了{0}來到鬼岩城寨，\\n想再次向他致謝……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "──歡迎，",
    "voice": "vo_adv_1382001_000",
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "歡迎！",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "\\n進貨了",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "不錯的魔物肉喔～！",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "\\n只要好好去掉致命的毒，",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "那多汁的程度可是會讓人大吃一驚！",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "現在買的話，",
    "voice": "vo_adv_1382001_001",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "巴西利斯克的眼珠打七折！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "\\n雖然因為還殘留著魔力，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "對上眼的話就會石化，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "\\n但只要小心食用，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "入口即化的美味肯定會在口中",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "擴散開來！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "這般怪異至極的活動，",
    "voice": "vo_adv_1382001_002",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "乃是吉歐‧格黑納才有的意趣。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "於其他世界，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "想必是未曾見過的罕事吧。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "名為",
    "voice": "vo_adv_1382001_003",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "「大魔物市」",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "因是數年一度的活動，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "稀有魔物肉等物，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n亦會趁機",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "於此銷售。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "是的～",
    "voice": "vo_adv_1382001_004",
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "當皇女大人突然說出",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "想邀請騎士閣下先生",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n參加危險的「大魔物市」時，",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "我真是嚇了一跳～",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "不過嘛，",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "有皇女大人在的話",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "應該就沒問題了～",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "前些日子的事件中，",
    "voice": "vo_adv_1382001_005",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "受到騎士閣下",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "莫大的幫助。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "是故奴家，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n欲按吉歐‧格黑納禮數",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "聊表報恩之意。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "關於魔物飲食，",
    "voice": "vo_adv_1382001_006",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家曉得",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "恁見多識廣，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "然若是魔物羅列如這「大魔物市」，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n想必能找到",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "滿足恁味蕾之珍品吧。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "若有中意之物，",
    "voice": "vo_adv_1382001_007",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "請儘管",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "吩咐。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家欲親手烹飪，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "以款待騎士閣下。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n雖是微薄心意，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "倘若恁願意笑納，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家深感榮幸。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "但是～",
    "voice": "vo_adv_1382001_008",
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "請小心一點喔？",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n因為也陳列著許多活潑過頭的魔物～",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "我也有好幾次",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "差點被整個吞掉～",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家時常告誡汝，",
    "voice": "vo_adv_1382001_009",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "此並非值得張揚之事。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "……然而，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "對於騎士閣下，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "則無須擔心。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "如有萬一，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家會以此身為盾",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "守護恁。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "啊，",
    "voice": "vo_adv_1382001_010",
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "涅妃‧涅羅大人！",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "\\n",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "居然看上了我們家的商品，",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "真是榮幸！",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "\\n",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "如何，",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "巨蛇的一夜乾！",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "也可以試吃喔～",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "哦，",
    "voice": "vo_adv_1382001_011",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "試吃嗎？",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "這油脂分布可真漂亮。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "呵呵……",
    "voice": "vo_adv_1382001_012",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "騎士閣下呀。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n恁意下如何呢？",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n若恁不介意，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "請至奴家身旁。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "來吧，",
    "voice": "vo_adv_1382001_013",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "「啊～」……♪",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "皇女大人竟然",
    "voice": "vo_adv_1382001_014",
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "要親自餵食",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "騎士閣下先生……！？",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "呃，",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "不對不對！",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "那隻魔物",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "可是帶有很強的毒性呀～！",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n雖然說已經去毒了，",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "但騎士閣下先生想必也會猶豫的吧～！",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "咦咦～！？",
    "voice": "vo_adv_1382001_015",
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n居、",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "居然沒有一絲猶豫……！",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "不會太大膽了嗎～！？",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "善哉、",
    "voice": "vo_adv_1382001_016",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "善哉。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "不愧是騎士閣下，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "如此豪氣干雲，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n正是英雄本色。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "米亞呀。",
    "voice": "vo_adv_1382001_017",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n汝也該學習騎士閣下的勇猛，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n稍微挺起胸膛，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "伸直尾巴才是。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "嗚嗚～",
    "voice": "vo_adv_1382001_018",
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "我是文官，",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "就算被這麼說也很難呀～",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "話說騎士閣下先生……",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "難道並非因為有膽識，",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n而是單純貪吃嗎，",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "應該不是這樣吧～？",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "太無禮了，",
    "voice": "vo_adv_1382001_019",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "別滑稽。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "要有作為煉獄之民的驕傲──",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "巨大的魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "嗚哇啊啊啊啊啊！？",
    "voice": "vo_adv_1382001_020",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "\\n這傢伙，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "突然躁動起來了！！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "商人３",
    "words": "所以我才說別活捉啊！",
    "voice": "vo_adv_1382001_021",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "商人３",
    "words": "\\n就算鮮度跟稀有價值會減低也一樣……！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "巨大的魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "商人們",
    "words": "噫噫噫噫！？",
    "voice": "vo_adv_1382001_022",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "真是意想不到。",
    "voice": "vo_adv_1382001_023",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n話音剛落",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "隨即便至──",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "正是如此呢。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "騎士閣下呀，",
    "voice": "vo_adv_1382001_024",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "請稍微退後些。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n該魔物，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "看來是氣血上湧，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "而相當暴躁。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家明白。",
    "voice": "vo_adv_1382001_025",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n現下時機正巧，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "該魔物，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "亦是美味非凡。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "務必務必，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "要讓奴家以此珍味款待騎士閣下。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "……若放血出了差錯，",
    "voice": "vo_adv_1382001_026",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "損及肉質，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "味道必然大受影響……",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "然而，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "這也是無可奈何之事。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n總不能看著商人們，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "白白斷送性命──",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "請等一下！",
    "voice": "vo_adv_1382001_027",
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "\\n涅妃‧涅羅大人！",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "……嗯？",
    "voice": "vo_adv_1382001_028",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "難得涅妃‧涅羅大人，",
    "voice": "vo_adv_1382001_029",
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "\\n打算要親手下廚款待客人……",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "\\n要是食材品質不佳，",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "可就白費心意了！",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "即使不依靠涅妃‧涅羅大人的力量，",
    "voice": "vo_adv_1382001_030",
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "\\n我們自己會想辦法解決的！",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "\\n",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "雖然這麼說有些放肆……",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "不過這邊就交給我們吧！",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "對、",
    "voice": "vo_adv_1382001_031",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "對啊！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "\\n我們不能老是躲在涅妃‧涅羅大人的背後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "\\n受您保護！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "商人３",
    "words": "我們可是吉歐‧格黑納勇猛的居民！",
    "voice": "vo_adv_1382001_032",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "商人３",
    "words": "\\n為了讓涅妃‧涅羅大人能順利款待客人，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "商人３",
    "words": "\\n大家盡全力",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "商人３",
    "words": "戰鬥吧！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "商人們",
    "words": "唔喔喔喔喔喔喔！！",
    "voice": "vo_adv_1382001_033",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "奇、",
    "voice": "vo_adv_1382001_034",
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "奇怪……！？",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "總覺得，",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "這個氣氛好像沒辦法隔岸觀火～！",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "我、",
    "voice": "vo_adv_1382001_035",
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "我明白了！",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "我明白了啦～！",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n雖然覺得一定幫不上忙，",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "但是我也會豁出去的～！",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n唔喔喔喔喔～～！",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "……這可真是。",
    "voice": "vo_adv_1382001_036",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "成了意想不到的局面呀。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n究竟最後會如何呢。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "不必擔憂。",
    "voice": "vo_adv_1382001_037",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n若此時由奴家出手，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "那可謂是掃興至極。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "最好的做法，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "應是在旁守望吧。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "再者，",
    "voice": "vo_adv_1382001_038",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "受先前「蘭德索爾國際博覽會」一事影響，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n吉歐‧格黑納",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "也正逐漸產生變化。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n轉變除可見於黎民百姓……",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "亦可見於奴家之心。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "騎士閣下呀。",
    "voice": "vo_adv_1382001_039",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n在守望彼些傢伙奮鬥的期間，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "還望恁能撥冗。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "可否願意，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "稍微聽聽",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家的閒言碎語呢？",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──時間回溯。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n那是在「蘭德索爾國際博覽會」發生騷動期間的事。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "502091"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "為了尋找製作至高料理所需的傳說食材，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n涅妃‧涅羅獨自一人，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "前往了位於吉歐‧格黑納深處的\\n火山口──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "噴火橫綱豬神",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "……哦。",
    "voice": "vo_adv_1382001_040",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n此便是傳說中的",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "「噴火橫綱豬神」。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n身軀如此雄偉壯碩，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "被冠以獸神之名，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "看來並非虛傳。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "噴火橫綱豬神",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "background",
    "bg_id": "502091"
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "唔……",
    "voice": "vo_adv_1382001_041",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "……原來如此，",
    "voice": "vo_adv_1382001_042",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "可真是棘手至極。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n力氣強勁，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "並且身手如羚羊般矯捷。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家如今身軀衰弱，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "許是有些難對付。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "噴火橫綱豬神",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "當真是怪力亂神，",
    "voice": "vo_adv_1382001_043",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "正面交鋒乃愚昧之舉。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "雖說以計謀之為常道……",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "然而眼下可沒工夫徐徐圖之。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "既如此，對付此般氣力──",
    "voice": "vo_adv_1382001_044",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "唯有傾全力",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "將之擊潰。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "background",
    "bg_id": "502091"
  },
  {
    "type": "dialogue",
    "name": "噴火橫綱豬神",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "……哎呀，",
    "voice": "vo_adv_1382001_045",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "對老身真是有些吃不消呢。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "默涅呀，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "汝可無事──",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "…………\\n……",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "…………",
    "voice": "vo_adv_1382001_046",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "……奴家竟糊塗忘了。",
    "voice": "vo_adv_1382001_047",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "默涅等中了「獄蜂」奸計，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "如今身陷囹圄。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n奴家正是為了救稚兒，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "因而不攜隨從，隻身趕赴此地。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "連這不滅之身，",
    "voice": "vo_adv_1382001_048",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "亦衰弱到",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "令人目不忍睹嗎。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "亦或是受黎民百姓環繞，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "平淡度日期間……",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "方驚覺隻身一人萬事難成這般定理，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "也說不定。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "正因如此，",
    "voice": "vo_adv_1382001_049",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "得要趕緊動身。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n為了將那定理，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "重新握於",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家掌中。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "background",
    "bg_id": "502110"
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "實在奇妙。",
    "voice": "vo_adv_1382001_050",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "於此身而言，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "黎民百姓雖是應當庇護的存在，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "但在平日，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "卻未曾察覺彼等位於身旁。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "於奴家而言，",
    "voice": "vo_adv_1382001_051",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "百姓的存在",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "便如同稚兒。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n唯有以掌包覆，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "護之不受危害，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n方能保全可貴生命──",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家向來如此認為。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "「非人」",
    "voice": "vo_adv_1382001_052",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "演起「凡人」，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "不過小小嬉戲。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "本來，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "應是不值一提的小事罷了。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "請別露出此般神情。",
    "voice": "vo_adv_1382001_053",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "自與騎士閣下相遇，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "看著默涅成長──",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家的視野與思維，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "如今也正迎來轉變。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "面對恐懼，",
    "voice": "vo_adv_1382001_054",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "挺身對抗。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n彼等身上所具有的",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "堅韌心性。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "不知何時起，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "已為其心之力所吸引……",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "現下已不再是微不足道之事了。",
    "voice": "vo_adv_1382001_055",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n彼等的存在，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "於奴家心中",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "已是意義非凡。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "是以如今，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家更想守望其英姿，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "予以信任。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "巨大的魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "商人們",
    "words": "哇呀啊啊啊啊啊！？",
    "voice": "vo_adv_1382001_056",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "雖、",
    "voice": "vo_adv_1382001_057",
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "雖然試著努力了，",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "但果然辦不到啊～！",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n皇女大人～！！",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n救、",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "救救我～！",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "話雖如此……",
    "voice": "vo_adv_1382001_058",
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "若欲放手讓彼等闖蕩，",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "似乎仍為時尚早呢。",
    "voice": null,
    "unit_id": 129711
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "──堅定不移的驕傲，",
    "voice": "vo_adv_1382001_059",
    "unit_id": 138212
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "即在此處。",
    "voice": null,
    "unit_id": 138212
  },
  {
    "type": "dialogue",
    "name": "巨大的魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "一、",
    "voice": "vo_adv_1382001_060",
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "一擊就把那個凶暴的魔物打倒了……？",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "商人１",
    "words": "\\n不愧是涅妃‧涅羅大人！",
    "voice": null,
    "unit_id": 50811
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "肉質毫無損傷，",
    "voice": "vo_adv_1382001_061",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "精準擊穿了頸部的要害！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "商人２",
    "words": "\\n放血也處理得非常完美！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "……嗯，",
    "voice": "vo_adv_1382001_062",
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "尚可尚可。",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "並無任何異樣。",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "鬼面佛心──",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "看來此身已是駕輕就熟了。",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "哎呀～",
    "voice": "vo_adv_1382001_063",
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "得救了……",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n不愧是皇女大人，",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "這份力量簡直是",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "英勇無雙！",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n任何魔物到了您面前，",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "都像是砧板上的肉呢～！",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "……嗯，",
    "voice": "vo_adv_1382001_064",
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "可以這麼說嗎～",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "既然您能如此精準地擊穿要害，",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "那我們根本不用戰鬥，",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "\\n從一開始",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "由皇女大人",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "米亞",
    "words": "展現那副姿態不就好了嗎～？",
    "voice": null,
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "若曉得能坐享其成，",
    "voice": "vo_adv_1382001_065",
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "汝定會有所保留吧？",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "有道是，",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "獅子亦會狠心將愛子推落谷底一般，",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "見證汝等成長，",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "亦是奴家身為皇女所應盡之責。",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "此般小事，",
    "voice": "vo_adv_1382001_066",
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "卻一身狼狽，",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "實在令人無語。",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n鍛鍊不足之事一目瞭然。",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "\\n",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "既如此，",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "諸位──",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "奴家便以此姿態，",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "涅妃‧涅羅",
    "words": "來指導鍛鍊吧。",
    "voice": null,
    "unit_id": 138211
  },
  {
    "type": "dialogue",
    "name": "全員",
    "words": "噫噫～",
    "voice": "vo_adv_1382001_067",
    "unit_id": 51611
  },
  {
    "type": "dialogue",
    "name": "全員",
    "words": "～～！！？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "看著發出哀求聲的民眾們，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "涅妃‧涅羅感到有些無奈。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n然而她的表情，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "似乎面帶滿足……",
    "voice": null,
    "unit_id": null
  }
]
