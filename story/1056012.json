[
  {
    "type": "background",
    "bg_id": "501372"
  },
  {
    "type": "background",
    "bg_id": "501372"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "選擇戀情、還是選擇刀。無法做出決定的流夏",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在夜晚前往偏僻之地，不斷斬殺襲來的魔物。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "但是，真正想斬斷的事物卻一個也斬不斷。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……喝啊！",
    "voice": "vo_adv_1056012_000",
    "unit_id": 105612
  },
  {
    "type": "background",
    "bg_id": "501372"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……喝！",
    "voice": "vo_adv_1056012_001",
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n……哈！",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "background",
    "bg_id": "501372"
  },
  {
    "type": "dialogue",
    "name": "魔物群",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "魔物群",
    "words": "\\n──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "戀情……",
    "voice": "vo_adv_1056012_002",
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "或刀嗎……",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n如果做不出選擇",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我就會迷失自我……",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n但是、",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "但是……",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "喝啊啊啊！！",
    "voice": "vo_adv_1056012_003",
    "unit_id": 105612
  },
  {
    "type": "background",
    "bg_id": "501372"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "啊──",
    "voice": "vo_adv_1056012_004",
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "真是的。",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我最不擅長思考這種複雜的事情了！　",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "既然這樣……",
    "voice": "vo_adv_1056012_005",
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "乾脆不要靠自己思考好了！",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n等等出現的魔物如果只有一隻，",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就是戀情。",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "若是兩隻，",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就是刀。",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就靠這個，來做取捨。",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不得異議",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "也無從猶豫！　",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "魔物群",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "兩隻！",
    "voice": "vo_adv_1056012_006",
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那麼──",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我就是……",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "武士！",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "background",
    "bg_id": "501372"
  },
  {
    "type": "dialogue",
    "name": "魔物群",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "沒錯。",
    "voice": "vo_adv_1056012_007",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "無須再迷惘。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n在考慮多餘的事情之前，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n得趕快向那孩子，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "清楚說出「別再見面了」──",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小哥！",
    "voice": "vo_adv_1056012_008",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你為什麼",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "會在這種地方……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "是、",
    "voice": "vo_adv_1056012_009",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "是嗎……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n昨天",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "真是抱歉。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "麻煩你收拾善後。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那個……",
    "voice": "vo_adv_1056012_010",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就是啊。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我有件事情，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "必須跟小哥你說。",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我、",
    "voice": "vo_adv_1056012_011",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "從今以後，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不會再跟小哥你──",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "等等。",
    "voice": "vo_adv_1056012_012",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n妳這樣，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "真的好嗎？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "什麼人！",
    "voice": "vo_adv_1056012_013",
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "哼哼哼，",
    "voice": "vo_adv_1056012_014",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "妳沉迷情愛而把我給忘了嗎。",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "\\n我是以前被妳所鎮壓住，",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "如今握在妳手中的妖刀，",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "波浪丸啊。",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "波浪丸不就是，",
    "voice": "vo_adv_1056012_015",
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我的……",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "第二把刀嗎！？",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你居然還保有著妖力！",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "波浪丸",
    "words": "應該說是，",
    "voice": "vo_adv_1056012_016",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "波浪丸",
    "words": "前妖刀才對。",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "波浪丸",
    "words": "微弱到無法與過去相比了。",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "波浪丸",
    "words": "\\n畢竟是被絕世無雙的使刀之人所用，",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "波浪丸",
    "words": "\\n所以根本",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "波浪丸",
    "words": "不需用到妖力。",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "波浪丸",
    "words": "……本應該，",
    "voice": "vo_adv_1056012_017",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "波浪丸",
    "words": "是這樣子才對。",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "波浪丸",
    "words": "\\n但這使刀之人，",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "波浪丸",
    "words": "最近似乎內心有點迷惘。",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "咦……",
    "voice": "vo_adv_1056012_018",
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "波浪丸",
    "words": "被名為戀情這種",
    "voice": "vo_adv_1056012_019",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "波浪丸",
    "words": "比妖怪還詭異的事物所迷惑，",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "波浪丸",
    "words": "\\n若妳因為這樣而把刀給拋棄，",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "波浪丸",
    "words": "我可無法忍受。",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "波浪丸",
    "words": "\\n為了導正妳的迷惘，",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "波浪丸",
    "words": "我才會像這樣",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "波浪丸",
    "words": "再次顯現。",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你說迷惘……",
    "voice": "vo_adv_1056012_020",
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "所、",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "所以說",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我現在正要",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "把它給斬斷──",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "波浪丸",
    "words": "就憑魔物的數量嗎？",
    "voice": "vo_adv_1056012_021",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "波浪丸",
    "words": "\\n靠這種占卜般的東西，",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "波浪丸",
    "words": "是不可能斬斷迷惘的。",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……唔！",
    "voice": "vo_adv_1056012_022",
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "波浪丸",
    "words": "無形之物難以斬斷。",
    "voice": "vo_adv_1056012_023",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "波浪丸",
    "words": "更何況是戀心",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "波浪丸",
    "words": "這種極其棘手之物。",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "波浪丸",
    "words": "\\n我看是無法光靠氣勢去斬斷吧。",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這種事要怎麼做",
    "voice": "vo_adv_1056012_024",
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "是我的自由吧！",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n我已經下定決心要做個了斷了，",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "事到如今──",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "波浪丸",
    "words": "我把我的妖力借給妳吧。",
    "voice": "vo_adv_1056012_025",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "波浪丸",
    "words": "在妳內心深處",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "波浪丸",
    "words": "依然還有迷惘對吧？",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "波浪丸",
    "words": "\\n我來讓妳的戀心，",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "波浪丸",
    "words": "化成更容易斬斷的",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "波浪丸",
    "words": "「形態」。",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那種事情",
    "voice": "vo_adv_1056012_026",
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "怎麼可能辦到。",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n你這把妖刀",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就算想騙我，",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我也不會讓你得逞的。",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n別在那胡說八道！",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "波浪丸",
    "words": "為了導正使刀之人的錯誤。",
    "voice": "vo_adv_1056012_027",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "波浪丸",
    "words": "我會不遺餘力。",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "波浪丸",
    "words": "\\n看好了。",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "波浪丸",
    "words": "\\n唔唔唔唔唔唔……",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "波浪丸",
    "words": "喝啊！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "咦…………！？",
    "voice": "vo_adv_1056012_028",
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "波浪丸",
    "words": "只針對妳的「戀心」投影並實體化的，",
    "voice": "vo_adv_1056012_029",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "波浪丸",
    "words": "另一個流夏。",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "波浪丸",
    "words": "\\n也就是「戀愛中的流夏」。",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "波浪丸",
    "words": "\\n來吧，",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "波浪丸",
    "words": "用妳的雙手，",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "波浪丸",
    "words": "親自斬斷她，",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "波浪丸",
    "words": "讓她無法再次成形！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "原來如此，",
    "voice": "vo_adv_1056012_030",
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "在戀愛的人是我。",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n使自己迷失方向的人",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "也是我──",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "也就是說",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "要來斬斷自身是嗎。",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "啊啊，",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這還真是簡單明瞭多了！",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "戀愛中的流夏",
    "words": "等一下！",
    "voice": "vo_adv_1056012_031",
    "unit_id": 105621
  },
  {
    "type": "dialogue",
    "name": "戀愛中的流夏",
    "words": "妳打算",
    "voice": null,
    "unit_id": 105621
  },
  {
    "type": "dialogue",
    "name": "戀愛中的流夏",
    "words": "斬斷自己的戀心嗎？",
    "voice": null,
    "unit_id": 105621
  },
  {
    "type": "dialogue",
    "name": "戀愛中的流夏",
    "words": "\\n明明不管是睡著還是醒著、甚至在打算斬斷後，",
    "voice": null,
    "unit_id": 105621
  },
  {
    "type": "dialogue",
    "name": "戀愛中的流夏",
    "words": "\\n這孩子的事都仍一直懸在你心中！",
    "voice": null,
    "unit_id": 105621
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "妳、",
    "voice": "vo_adv_1056012_032",
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "妳別胡說八道！",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "戀愛中的流夏",
    "words": "我就要全部說出來。",
    "voice": "vo_adv_1056012_033",
    "unit_id": 105621
  },
  {
    "type": "dialogue",
    "name": "戀愛中的流夏",
    "words": "\\n把那些妳打算封印起來埋藏起來的事，",
    "voice": null,
    "unit_id": 105621
  },
  {
    "type": "dialogue",
    "name": "戀愛中的流夏",
    "words": "全部說出來！",
    "voice": null,
    "unit_id": 105621
  },
  {
    "type": "dialogue",
    "name": "戀愛中的流夏",
    "words": "我啊……",
    "voice": "vo_adv_1056012_034",
    "unit_id": 105621
  },
  {
    "type": "dialogue",
    "name": "戀愛中的流夏",
    "words": "比起堅硬冰冷的利刃，",
    "voice": null,
    "unit_id": 105621
  },
  {
    "type": "dialogue",
    "name": "戀愛中的流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105621
  },
  {
    "type": "dialogue",
    "name": "戀愛中的流夏",
    "words": "更想只為一個",
    "voice": null,
    "unit_id": 105621
  },
  {
    "type": "dialogue",
    "name": "戀愛中的流夏",
    "words": "既溫暖又溫柔的男人而活。",
    "voice": null,
    "unit_id": 105621
  },
  {
    "type": "dialogue",
    "name": "戀愛中的流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105621
  },
  {
    "type": "dialogue",
    "name": "戀愛中的流夏",
    "words": "這就是我",
    "voice": null,
    "unit_id": 105621
  },
  {
    "type": "dialogue",
    "name": "戀愛中的流夏",
    "words": "毫無偽裝的真正想法！",
    "voice": null,
    "unit_id": 105621
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不對、",
    "voice": "vo_adv_1056012_035",
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不對不對……！",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我是一名武士。",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n不管是在過去",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "還是在未來，",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我都只為了刀而活！",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "戀愛中的流夏",
    "words": "別再裝了！",
    "voice": "vo_adv_1056012_036",
    "unit_id": 105621
  },
  {
    "type": "dialogue",
    "name": "戀愛中的流夏",
    "words": "\\n妳在身為武士之前",
    "voice": null,
    "unit_id": 105621
  },
  {
    "type": "dialogue",
    "name": "戀愛中的流夏",
    "words": "也是一個女人對吧？",
    "voice": null,
    "unit_id": 105621
  },
  {
    "type": "dialogue",
    "name": "戀愛中的流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105621
  },
  {
    "type": "dialogue",
    "name": "戀愛中的流夏",
    "words": "我已經打從心底，",
    "voice": null,
    "unit_id": 105621
  },
  {
    "type": "dialogue",
    "name": "戀愛中的流夏",
    "words": "愛上這個孩子了！",
    "voice": null,
    "unit_id": 105621
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "妳……",
    "voice": "vo_adv_1056012_037",
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這混蛋……",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "別太囂張了！",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "來一決勝負吧！",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "給我拔刀！",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "戀愛中的流夏",
    "words": "我才不要。",
    "voice": "vo_adv_1056012_038",
    "unit_id": 105621
  },
  {
    "type": "dialogue",
    "name": "戀愛中的流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105621
  },
  {
    "type": "dialogue",
    "name": "戀愛中的流夏",
    "words": "我在這孩子面前",
    "voice": null,
    "unit_id": 105621
  },
  {
    "type": "dialogue",
    "name": "戀愛中的流夏",
    "words": "想當個可愛的女孩子。",
    "voice": null,
    "unit_id": 105621
  },
  {
    "type": "dialogue",
    "name": "戀愛中的流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105621
  },
  {
    "type": "dialogue",
    "name": "戀愛中的流夏",
    "words": "刀子什麼的，",
    "voice": null,
    "unit_id": 105621
  },
  {
    "type": "dialogue",
    "name": "戀愛中的流夏",
    "words": "我才不會拔呢。",
    "voice": null,
    "unit_id": 105621
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "是嗎。",
    "voice": "vo_adv_1056012_039",
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n如果妳不拔……",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就由我把妳給斬了！",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "波浪丸",
    "words": "沒錯，",
    "voice": "vo_adv_1056012_040",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "波浪丸",
    "words": "讓她灰飛煙滅吧！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "──",
    "voice": "vo_adv_1056012_041",
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小哥",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你讓開！",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n要是你出手干涉，",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "小心刀刃不長眼！",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不管哪邊……",
    "voice": "vo_adv_1056012_042",
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "都是",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我？",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "哈，",
    "voice": "vo_adv_1056012_043",
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "別說傻話了。",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n就是因為想要同時接納兩邊，",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n我才會",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "變得動彈不得啊！",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "如果不做出取捨，",
    "voice": "vo_adv_1056012_044",
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我就",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "會變得不再是我。",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你不想跟這傢伙一起被斬的話，",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "就快點",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "讓開吧！",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……咦咦？",
    "voice": "vo_adv_1056012_045",
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你說……",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "要我不要小看……",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "自己……？",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "…………",
    "voice": "vo_adv_1056012_046",
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n小哥……",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "…………啊啊，",
    "voice": "vo_adv_1056012_047",
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "可惡！",
    "voice": null,
    "unit_id": 105612
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……",
    "voice": "vo_adv_1056012_048",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "是、",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "嗎……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n……原來，",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "是我搞錯了……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "原來是……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "這麼……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "回事……",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "…………唔！",
    "voice": "vo_adv_1056012_049",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……啊啊啊真是的！",
    "voice": "vo_adv_1056012_050",
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……我知道了……！",
    "voice": null,
    "unit_id": 105611
  },
  {
    "type": "dialogue",
    "name": "波浪丸",
    "words": "把刀、",
    "voice": "vo_adv_1056012_051",
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "波浪丸",
    "words": "朝向了自己……！？",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "波浪丸",
    "words": "\\n妳想要",
