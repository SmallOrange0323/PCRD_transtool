    "voice": "vo_adv_1238002_033",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "粉絲２",
    "words": "\\n別以妹妹自居啦──！",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "哦，",
