    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "粉絲１",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "粉絲１",
    "words": "那傢伙該不會",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "粉絲１",
    "words": "打算唱慈樂之音的歌吧……！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "「一唱歌就開始擺盪的這顆心，",
    "voice": "vo_adv_1238002_037",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n進進退退的情感……」",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "「你更喜歡",
    "voice": "vo_adv_1238002_038",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "姐姐還是我呢？",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "朋友以上？",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
