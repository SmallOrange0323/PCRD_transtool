    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "事務所工作人員",
    "words": "怎麼會……",
    "voice": "vo_adv_1238002_050",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "事務所工作人員",
    "words": "\\n",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "事務所工作人員",
    "words": "你的意思是我只能眼睜睜地",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "事務所工作人員",
    "words": "看著事情演變成最壞的情況嗎！",
