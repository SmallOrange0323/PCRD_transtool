  },
  {
    "type": "dialogue",
    "name": "粉絲１",
    "words": "可、",
    "voice": "vo_adv_1238002_055",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "粉絲１",
    "words": "可是……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "粉絲１",
    "words": "等一下。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "粉絲１",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "粉絲１",
    "words": "仔細想想，那傢伙是不是完美重現了",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "粉絲１",
    "words": "\\n慈樂之音的",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "粉絲１",
    "words": "複雜舞步啊？",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "粉絲２",
    "words": "……",
    "voice": "vo_adv_1238002_056",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "粉絲２",
    "words": "咦？",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "粉絲２",
    "words": "喔，",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "粉絲２",
    "words": "你這麼一說好像是。",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "粉絲２",
    "words": "\\n望、",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "粉絲２",
    "words": "千歌、",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "粉絲２",
    "words": "紡希的精彩場面都一一展現出來了……",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "粉絲２",
    "words": "\\n光靠她自己一個人。",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "粉絲２",
    "words": "要說的話……",
    "voice": "vo_adv_1238002_057",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "粉絲２",
    "words": "不光是舞步。",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "粉絲２",
    "words": "\\n她還用不同的音色",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "粉絲２",
    "words": "唱了三個人的單獨演唱片段……",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "粉絲２",
    "words": "\\n",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "粉絲２",
    "words": "一個臨陣磨槍的偶像",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "粉絲２",
    "words": "是不可能擁有這麼高超的技術的。",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "粉絲１",
    "words": "因為個人風格太強烈了，看起來像是當作自己的歌在表演……",
    "voice": "vo_adv_1238002_058",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "粉絲１",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "粉絲１",
    "words": "會不會",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "粉絲１",
    "words": "她是真的",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "粉絲１",
    "words": "在對慈樂之音致敬呀……？",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "嗯？",
    "voice": "vo_adv_1238002_059",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "哥哥們，這是怎麼啦？",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n突然這麼安靜，",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "你們已經沒電啦？",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "喂，你們幾個。",
    "voice": "vo_adv_1238002_060",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n好歹也是",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "迷上胡蘿蘿☆的",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "第一號粉絲吧？",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n怎麼這麼沒自信，",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "真不像話！",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "粉絲１",
    "words": "好強烈的壓迫感……",
    "voice": "vo_adv_1238002_061",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "粉絲１",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "粉絲１",
    "words": "確實是和",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "粉絲１",
    "words": "慈樂之音一點都不像的妹妹形象……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "粉絲２",
    "words": "是啊。",
    "voice": "vo_adv_1238002_062",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "粉絲２",
    "words": "\\n從另一種角度來說，",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "粉絲２",
    "words": "\\n她是巧妙地避開和望、",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "粉絲２",
    "words": "千歌、",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "粉絲２",
    "words": "紡希的",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "粉絲２",
    "words": "形象重疊啊。",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "粉絲１",
    "words": "原來如此……",
    "voice": "vo_adv_1238002_063",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "粉絲１",
    "words": "所以才是這種厚臉皮妹妹的形象嗎！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "粉絲１",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "粉絲１",
    "words": "聽你這麼一說，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "粉絲１",
    "words": "確實是很高招的安排啊。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "粉絲１",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "粉絲１",
    "words": "可惡……",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "粉絲１",
    "words": "不得不承認！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "粉絲２",
    "words": "真不愧是頂尖能幹的製作人",
    "voice": "vo_adv_1238002_064",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "粉絲２",
    "words": "──克莉絲提娜……",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "粉絲２",
    "words": "\\n完全中了她的圈套。",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "粉絲２",
    "words": "\\n我彷彿都能看見",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "粉絲２",
    "words": "她在後台奸笑的模樣！",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "聽好了，你們幾個，",
    "voice": "vo_adv_1238002_065",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我就告訴你們吧。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "演唱會就是戰場。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "是我和你們的單挑。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "勝敗可不是最重要的哦？",
    "voice": "vo_adv_1238002_066",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n重要的是全力以赴。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "哪怕",
    "voice": "vo_adv_1238002_067",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "最後靈魂被奪走了……",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n那也是至高無上的快樂。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "怎麼樣，",
    "voice": "vo_adv_1238002_068",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "哥哥們！",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n想不想成為",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "快樂的死屍呀☆",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "觀眾們",
    "words": "……唔、",
    "voice": "vo_adv_1238002_069",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "觀眾們",
    "words": "唔哦哦哦哦哦哦────！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "粉絲１",
    "words": "多麼完美的煽動啊！",
    "voice": "vo_adv_1238002_070",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "粉絲１",
    "words": "\\n讓人完全無法抗拒！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "粉絲１",
    "words": "\\n我太喜歡了！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "粉絲１",
    "words": "胡蘿蘿☆我愛妳！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "粉絲２",
    "words": "把我們變成一具具死屍吧──！！",
    "voice": "vo_adv_1238002_071",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "觀眾們",
    "words": "胡蘿蘿☆！",
    "voice": "vo_adv_1238002_072",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "觀眾們",
    "words": "\\n胡蘿蘿☆！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "觀眾們",
    "words": "\\n胡蘿蘿☆！",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "哈哈哈。",
    "voice": "vo_adv_1238002_073",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n看來大家終於下定決心啦！",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "still",
    "still_id": "123800201"
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "好吧。",
    "voice": "vo_adv_1238002_074",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "那就讓你們聽聽吧。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這次再不認真對待的話，",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "可是會要了你們的小命哦……！",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "要唱囉！",
    "voice": "vo_adv_1238002_075",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n胡蘿蘿☆",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "原創出道曲……",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n「蹦蹦跳跳大亂鬥☆」！",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "粉絲１",
    "words": "是新歌耶！",
    "voice": "vo_adv_1238002_076",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "觀眾們",
    "words": "唔唔唔哦哦哦哦哦哦──────！！！！",
    "voice": "vo_adv_1238002_077",
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500584"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "事務所工作人員",
    "words": "天啊，",
    "voice": "vo_adv_1238002_078",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "事務所工作人員",
    "words": "沒想到會是這樣。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "事務所工作人員",
    "words": "\\n──難道你……",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "事務所工作人員",
    "words": "已經預料到會是這種發展嗎？",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "事務所工作人員",
    "words": "真的假的，",
    "voice": "vo_adv_1238002_079",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "事務所工作人員",
    "words": "你也太厲害了吧。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "事務所工作人員",
    "words": "\\n看來你這身披風不是白穿的啊……",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "於是，胡蘿蘿☆虜獲了現場所有粉絲的心，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在響亮的歡呼聲中，依依不捨地結束了發表演唱會。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "500030"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──在那之後。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "好評聲浪傳遍蘭德索爾，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n胡蘿蘿☆一躍成為當紅人物，然而──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "粉絲１",
    "words": "什麼，",
    "voice": "vo_adv_1238002_080",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "粉絲１",
    "words": "退出演藝圈！？",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "粉絲１",
    "words": "胡蘿蘿☆嗎？",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "粉絲１",
    "words": "\\n已經要退出了！？",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "粉絲１",
    "words": "可是上星期才剛舉辦",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "粉絲１",
    "words": "發表演唱會──",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "粉絲２",
    "words": "就是說啊。",
    "voice": "vo_adv_1238002_081",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "粉絲２",
    "words": "\\n好像是因為",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "粉絲２",
    "words": "和事務所有合約上的認知差異……",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "粉絲２",
    "words": "\\n所以她決定要",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "粉絲２",
    "words": "徹底退出幕前。",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "粉絲１",
    "words": "真的假的……",
    "voice": "vo_adv_1238002_082",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "粉絲１",
    "words": "\\n哇，太打擊了──",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "嗯。",
    "voice": "vo_adv_1238002_083",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我的慾望已經被充分滿足了。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我個人是不惋惜主義的♪",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "而且……",
    "voice": "vo_adv_1238002_084",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "你看。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "粉絲２",
    "words": "不，",
    "voice": "vo_adv_1238002_085",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "粉絲２",
    "words": "我們不必感到悲傷。",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "粉絲２",
    "words": "\\n",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "粉絲２",
    "words": "胡蘿蘿☆的意志",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "粉絲２",
    "words": "肯定託付給慈樂之音了。",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "粉絲２",
    "words": "\\n因為她是……",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "粉絲２",
    "words": "慈樂之音貨真價實的妹妹啊。",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "粉絲２",
    "words": "你說是吧？",
    "voice": null,
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "粉絲１",
    "words": "嗯……",
    "voice": "vo_adv_1238002_086",
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "粉絲１",
    "words": "你說得對。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "粉絲１",
    "words": "\\n從今以後",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "粉絲１",
    "words": "就是帶著胡蘿蘿☆意志的慈樂之音了。",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "粉絲１",
    "words": "\\n",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "粉絲１",
    "words": "好！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "粉絲１",
    "words": "我要把更多更多的愛獻給慈樂之音！",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不出所料，",
    "voice": "vo_adv_1238002_087",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "慈樂之音的粉絲",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "人數劇增。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "製造話題這個手段非常成功。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "哦，",
    "voice": "vo_adv_1238002_088",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "難得聽見你誇獎我呢。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "真是太榮幸了♪",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……對了，小子。",
    "voice": "vo_adv_1238002_089",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n聽說工作人員試圖中斷演唱會的時候，",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n你堅決反對了。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "你還說了「要相信胡蘿蘿☆」",
    "voice": "vo_adv_1238002_090",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "吧？",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "呵呵呵。",
    "voice": "vo_adv_1238002_091",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n雖然剛開始",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "你還搞不清楚狀況，一旦徹底吸收理解了，",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n就會當作自己的信念",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "堅持到底。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……看來我也得",
    "voice": "vo_adv_1238002_092",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "誇一誇自己了。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "誇讚自己選擇了你",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "作為未婚夫☆",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "好，小子！",
    "voice": "vo_adv_1238002_093",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n為了回應你的熱情，",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "就把我珍貴的東西送給你吧。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "你可是沒權利拒絕的哦？",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "那當然是……",
    "voice": "vo_adv_1238002_094",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "胡蘿蘿☆頭號粉絲的稱號呀。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "既然本人都已經退出演藝圈，",
    "voice": "vo_adv_1238002_095",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這就是無法推翻的既成事實。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n將會是永生永世",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "緊緊抓著你的一個稱號。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這一輩子",
    "voice": "vo_adv_1238002_096",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "都請你多多關照囉！",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n啊～哈哈哈☆",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就這樣，胡蘿蘿☆的名字，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n作為夢幻偶像載入了蘭德索爾的偶像史中。",
    "voice": null,
    "unit_id": null
  }
]
