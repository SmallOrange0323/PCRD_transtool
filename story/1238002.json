  },
  {
    "type": "dialogue",
    "name": "事務所工作人員",
    "words": "這簡直是糟透了。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "事務所工作人員",
    "words": "\\n聽說是製作人強力推薦的新人，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "事務所工作人員",
    "words": "\\n所以才安排了發表演唱會……",
