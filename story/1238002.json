    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "對偶像粉絲來說，",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "改愛其他偶像可是一件大事。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n一個魅力十足的新人登場，",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "必然會伴隨這些掙扎呢。",
    "voice": null,
