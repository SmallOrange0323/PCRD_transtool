    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "事務所工作人員",
    "words": "……啥！？",
    "voice": "vo_adv_1238002_051",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "嗯嗯嗯，",
    "voice": "vo_adv_1238002_052",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "太爽快了！",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "無論是噓聲還是歡呼聲，",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不分種類。",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "來吧，",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "讓我見識你們的熱情！",
    "voice": null,
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "在我心滿意足之前，",
    "voice": "vo_adv_1238002_053",
    "unit_id": 123811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我是不會唱下一首歌的哦♪",
    "voice": null,
    "unit_id": 123811
  },
