    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "事務所工作人員",
    "words": "也會傷害到慈樂之音本尊的評價。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "事務所工作人員",
    "words": "但是，",
    "voice": "vo_adv_1238002_048",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "事務所工作人員",
    "words": "可惡，",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "事務所工作人員",
    "words": "胡蘿蘿☆那傢伙……",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "事務所工作人員",
    "words": "\\n不管我怎麼打手勢，她都不肯下台！",
