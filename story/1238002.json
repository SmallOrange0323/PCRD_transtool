    "type": "dialogue",
    "name": "粉絲１",
    "words": "\\n而且，",
    "voice": null,
    "unit_id": 311
  },
  {
    "type": "dialogue",
    "name": "粉絲１",
    "words": "還完全當作是自己的歌。",
