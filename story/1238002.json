    "name": "粉絲２",
    "words": "那傢伙",
    "voice": "vo_adv_1238002_054",
    "unit_id": 3311
  },
  {
    "type": "dialogue",
    "name": "粉絲２",
    "words": "還打算繼續唱耶……",
