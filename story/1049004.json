    "type": "dialogue",
    "name": "靜流",
    "words": "拿到備份鑰匙的喔♪",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "你已經逃離不了",
    "voice": "vo_adv_1049004_031",
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "姐姐的手掌心了，\\n{0}……♪",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "哇啊！？",
    "voice": "vo_adv_1049004_032",
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n你、你不要這麼突然起身啦，{0}！",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "好痛……",
    "voice": "vo_adv_1049004_033",
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n臉湊得太近了，",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n直接撞上了起身的{0}！",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "嗚嗚，",
