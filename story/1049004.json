    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我沒聽說過呀。",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "居然發生了連我們公會長",
    "voice": "vo_adv_1049004_017",
    "unit_id": 104911
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n都沒有察覺到的異常情況……？",
    "voice": null,
    "unit_id": 104911
  },
  {
    "type": "background",
    "bg_id": "510090"
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "早安，{0}！",
    "voice": "vo_adv_1049004_018",
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n今天是個舒服的早晨呢☆",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "溫柔的姐姐",
    "voice": "vo_adv_1049004_019",
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n來叫醒賴床鬼{0}囉～！",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "要是不快點起床，",
    "voice": "vo_adv_1049004_020",
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n你上學就要遲到了……",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "唷♪",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "呵呵呵。",
    "voice": "vo_adv_1049004_021",
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n我都叫這麼久了，",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "他還是完全睡死了呢。",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "那就沒辦法了。",
    "voice": "vo_adv_1049004_022",
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n只好動用武力了。",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "清醒的猛烈一擊，",
    "voice": "vo_adv_1049004_023",
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n降臨……",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "囉♪",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "不過，在這之前。",
    "voice": "vo_adv_1049004_024",
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我先看一會兒……♪",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "把{0}的可愛睡臉",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n看到燒起來～♪",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "呼……",
    "voice": "vo_adv_1049004_025",
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n啊，",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "多麼可愛呀……♪",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "好想就這樣讓他安穩地睡下去～",
    "voice": "vo_adv_1049004_026",
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "好想寵著他呀……♪",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "可是，不行。",
    "voice": "vo_adv_1049004_027",
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n我要狠下心來",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "叫他起床。",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "{0}的雙親出差去了，",
    "voice": "vo_adv_1049004_028",
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n他們特別交代我「就麻煩靜流叫醒他了～」",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "嗯。",
    "voice": "vo_adv_1049004_029",
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n為了讓大家認知到我是{0}的姐姐，",
    "voice": null,
    "unit_id": 104931
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n就連雙親那邊，我都做好完美的準備。",
