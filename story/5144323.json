[
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "呼啊……",
    "voice": "vo_adv_5144323_000",
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n好、",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "好不容易把它逼到這個地步了……",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "魔物植物",
    "words": "──嘎喔喔喔喔喔！！",
    "voice": null,
    "unit_id": 12012
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "敵人",
    "voice": "vo_adv_5144323_001",
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "也變得很拚命，",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "就算只差一點點，",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "也千萬不可以大意！",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "好的！",
    "voice": "vo_adv_5144323_002",
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n大家同心協力準備到現在的鮮花祭……",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n絕對",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "不能讓魔物搞砸！",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "魔物植物",
    "words": "──嘎喔喔喔喔喔！！",
    "voice": null,
    "unit_id": 12012
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "擺好架式吧，",
    "voice": "vo_adv_5144323_003",
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "鏡華！",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n現在已經來到鮮花祭會場附近了，",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鈴莓",
    "words": "\\n我們在這裡攔下它吧！",
    "voice": null,
    "unit_id": 130811
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "包在我身上！",
    "voice": "vo_adv_5144323_004",
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n現在的話和鈴莓小姐的默契，",
    "voice": null,
    "unit_id": 130711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "也是完美無缺！",
    "voice": null,
    "unit_id": 130711
  }
]
