  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "總之要先打敗這傢伙，",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "讓牠乖乖就範才行喵！",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "\\n",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "珠希",
    "words": "就跟爭奪地盤是一樣的喵～！",
    "voice": null,
    "unit_id": 125111
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "說、",
    "voice": "vo_adv_5114301_003",
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "說得也是……",
    "voice": null,
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "嗯？",
    "voice": null,
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "這",
    "voice": null,
    "unit_id": 125211
  },
  {
    "type": "dialogue",
    "name": "莫妮卡",
    "words": "是在爭奪地盤嗎？",
