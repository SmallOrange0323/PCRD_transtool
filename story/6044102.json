[
  {
    "type": "background",
    "bg_id": "501030"
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "玩耍過後，",
    "voice": "vo_adv_6044102_000",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "喉嚨開始覺得渴了……",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "去買點東西吧。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你呢？",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "如果有什麼想喝的，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我可以順便幫你買回來。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "嗯，",
    "voice": "vo_adv_6044102_001",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那是來觀光必買的飲料呢。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我想裡頭的水果會多到非常驚人……",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "你自己喝要是喝不完，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "我也能幫你喝喔。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "哦，",
    "voice": "vo_adv_6044102_002",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不錯啊。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "自從長大之後，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n就不太喝這種飲料了，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "但偶爾也會突然想喝呢。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "該怎麼說呢，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "有種夏日風情的感覺。",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "不對，",
    "voice": "vo_adv_6044102_003",
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "那是不能喝的東西吧！？",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n要是不小心把那東西當成麥茶喝下去，可是會很痛苦啊！",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "\\n",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "……我說你，",
    "voice": null,
    "unit_id": 113111
  },
  {
    "type": "dialogue",
    "name": "流夏",
    "words": "該不會把那個誤以為是飲料了吧？",
    "voice": null,
    "unit_id": 113111
  }
]
