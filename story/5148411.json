  {
    "type": "dialogue",
    "name": "美空",
    "words": "\\n",
    "voice": null,
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "比方說從海裡出現巨大怪奇怪靈，",
    "voice": null,
    "unit_id": 131213
  },
  {
    "type": "dialogue",
    "name": "美空",
    "words": "到處破壞城市之類的？",
