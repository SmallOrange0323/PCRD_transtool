  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "儘管數度遭遇魔物襲擊，一行人仍順利地向上登塔。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "好～",
    "voice": "vo_adv_7025003_000",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "船到橋頭自然直～！",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "background",
    "bg_id": "500430"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……",
    "voice": "vo_adv_7025003_001",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "呼，",
    "voice": "vo_adv_7025003_002",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我們爬了不少樓呢～",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "魔物也越來越強了，",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n要更加把勁才行～",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "不過，",
    "voice": "vo_adv_7025003_003",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "和嘉夜一起行動",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "就什麼都不用擔心啦～",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n照這個狀態應該能一直闖下去～",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……我還是",
    "voice": "vo_adv_7025003_004",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "忍不下去。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "嘉夜妳怎麼了？",
    "voice": "vo_adv_7025003_005",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……我很清楚",
    "voice": "vo_adv_7025003_006",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "現在不該說這些。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "但",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我有點忍不住了。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "香織，",
    "voice": "vo_adv_7025003_007",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "和我打一架吧！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "咦？",
    "voice": "vo_adv_7025003_008",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "打架？",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "是不是做了什麼對不起嘉夜的事呢～？",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n如果是的話我向妳道歉……",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "啊──",
    "voice": "vo_adv_7025003_009",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "抱歉，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "打架這說法不好。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "那個……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "過招，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "對，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我想和妳過過招！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "啊～",
    "voice": "vo_adv_7025003_010",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "是這個意思呀～？",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "嚇我一跳～",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "如果嘉夜會比較開心，",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "那我不介意喔～",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "不過",
    "voice": "vo_adv_7025003_011",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "你覺得好嗎？",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "我們是來保護你的，",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "就交給你判斷吧～",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "是啊。",
    "voice": "vo_adv_7025003_012",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我並不是不把你的記憶的事放在心上，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n但能給我一點時間嗎？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "當然啦～",
    "voice": "vo_adv_7025003_013",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "那，請嘉夜手下留情～",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "謝謝。",
    "voice": "vo_adv_7025003_014",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n我當然會留意，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "但要是我打得太投入",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "就抱歉囉！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "嘿。",
    "voice": "vo_adv_7025003_015",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "哈哈，",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "好厲害的刺拳～",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "唔，",
    "voice": "vo_adv_7025003_016",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "那這招如何！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "喝啊喝啊喝啊！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "嘿唷、",
    "voice": "vo_adv_7025003_017",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "嘿、",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "嘿唷～",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "啊哈哈，",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "真好玩～",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "嘖，",
    "voice": "vo_adv_7025003_018",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "居然漫不經心地閃開了！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "那就賞妳個強力一擊！　",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "看招！",
    "voice": "vo_adv_7025003_019",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "狂龍猛擊！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "哇，",
    "voice": "vo_adv_7025003_020",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "這招好像會很痛～？",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "那我",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "就這樣──",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "background",
    "bg_id": "500430"
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "唔！",
    "voice": "vo_adv_7025003_021",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "打擊的軌道被架開了！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "有破綻～！",
    "voice": "vo_adv_7025003_022",
    "unit_id": 101711
  },
  {
    "type": "background",
    "bg_id": "500430"
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "唔……！",
    "voice": "vo_adv_7025003_023",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "居然連那招也被化解掉了……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n明明跟我一樣都是打擊型的卻是個難纏的對手。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "不過，",
    "voice": "vo_adv_7025003_024",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "好戲才要開始啦──",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "啊，",
    "voice": "vo_adv_7025003_025",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "魔物來了～",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "嘉夜，",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "先比到這裡吧～",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "可惡，",
    "voice": "vo_adv_7025003_026",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "別來礙事！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "滾開！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "唔……",
    "voice": "vo_adv_7025003_027",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "這傢伙的身體",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "打起來簡直像塊厚實的橡膠。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "一擊解決不了的話，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "就用連擊痛扁你！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──咕喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "唔哇！",
    "voice": "vo_adv_7025003_028",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "混帳，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "完全不痛不癢……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n我們先撤！",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "用物理攻擊無法撂倒這──",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "喝啊──！",
    "voice": "vo_adv_7025003_029",
    "unit_id": 101711
  },
  {
    "type": "background",
    "bg_id": "500430"
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "──嘎喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1614
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "啊哈～",
    "voice": "vo_adv_7025003_030",
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "實力果然和下面的魔物",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "不一樣呀～",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "\\n",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "嘉夜",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "香織",
    "words": "妳沒事吧？",
    "voice": null,
    "unit_id": 101711
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……",
    "voice": "vo_adv_7025003_031",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "為什麼？",
    "voice": "vo_adv_7025003_032",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "明明我的拳頭完全不管用，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n為什麼香織才出一招就把牠幹掉了？　",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "而且剛才過招時",
    "voice": "vo_adv_7025003_033",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我的招式也都被香織輕易避開了。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n到底是什麼？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我跟香織之間",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "到底有什麼不同啊！　",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……終究是因為珍視的事物、",
    "voice": "vo_adv_7025003_034",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "想守護的事物有差異嗎？",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n假設如此，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "沒有故鄉的我註定贏不過香織嗎？　",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "嘉夜對自己的實力產生了迷惘。究竟她能否找到答案呢？",
    "voice": null,
    "unit_id": null
  }
]
