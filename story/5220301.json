[
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "我絕對不會原諒傷害大家的壞魔物。",
    "voice": "vo_adv_5220301_000",
    "unit_id": 140611
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n所以我現在",
    "voice": null,
    "unit_id": 140611
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "超級生氣的！",
    "voice": null,
    "unit_id": 140611
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n",
    "voice": null,
    "unit_id": 140611
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "我要把你們全部沖走！",
    "voice": null,
    "unit_id": 140611
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "嘩啦～！！",
    "voice": null,
    "unit_id": 140611
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……哇噗。",
    "voice": "vo_adv_5220301_001",
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "等等，克蘿小姐，",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "幹勁十足是很好。",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n但也用力過猛了吧。",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "哇哇！？",
    "voice": "vo_adv_5220301_002",
    "unit_id": 140611
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n對不起，烏爾姆～！",
    "voice": null,
    "unit_id": 140611
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "沒關係的。",
    "voice": "vo_adv_5220301_003",
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "克蘿小姐現在的心情……",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我也",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "能理解。",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我們一起把那傢伙",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "狠狠揍飛吧！",
    "voice": null,
    "unit_id": 140511
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "好的！",
    "voice": "vo_adv_5220301_004",
    "unit_id": 140611
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "\\n黎薩也一起吧！",
    "voice": null,
    "unit_id": 140611
  },
  {
    "type": "dialogue",
    "name": "克蘿茜",
    "words": "我們一起加油！",
    "voice": null,
    "unit_id": 140611
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "……在這種時候依然吵鬧的兩個孩子呢。",
    "voice": "vo_adv_5220301_005",
    "unit_id": 140411
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140411
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "算了，",
    "voice": null,
    "unit_id": 140411
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "至少我會守住妳們的後方。",
    "voice": null,
    "unit_id": 140411
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n我們速戰速決吧。",
    "voice": null,
    "unit_id": 140411
  }
]
