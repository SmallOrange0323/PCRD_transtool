[
  {
    "type": "background",
    "bg_id": "500090"
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "新兵たちの訓練課程が無事終わった、ある日のこと。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "\\nエリコとマコトはジュンに呼ばれ、ランドソル王城を訪れていた。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "エリコ・マコト",
    "words": "魔物の掃討任務？",
    "voice": "vo_adv_5142700_000",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "ああ。",
    "voice": "vo_adv_5142700_001",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "今期の訓練兵たちは、",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "類いまれな好成績を残してくれた。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "\\n既存の課程だけでは、",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "実力を評価しきれないほどにね。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "そこで、",
    "voice": "vo_adv_5142700_002",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "さらなるステップアップを目指す訓練課程として、",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "\\n魔物の掃討任務に参加してもらうことになったんだ。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "つまり、",
    "voice": "vo_adv_5142700_003",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "前の遠征のように魔物と戦うのでしょうか。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "\\n今回はどちらへ？",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "かつて街道として使われていたが、",
    "voice": "vo_adv_5142700_004",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "\\n今は魔物がすみつき",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "通れなくなっている場所があってね。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "強力な魔物はいないようだけれど、",
    "voice": "vo_adv_5142700_005",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "いかんせん数が多い。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "\\nでも",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "エリコ班やマコト班を筆頭に、",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "今期の新兵は実に優秀だ。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "\\n彼らになら",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "掃討任務を任せられると思う。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "それでお呼びがかかった、",
    "voice": "vo_adv_5142700_006",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "ってことか。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "しかし、",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "強くはないっつっても",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "万が一はあるんじゃないか？",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "……そうですね。",
    "voice": "vo_adv_5142700_007",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "そういった相手にこそ、",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "油断や慢心も生じやすいでしょうし。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "もちろん。",
    "voice": "vo_adv_5142700_008",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "だから二人にも参加してもらいたい。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "\\n君たちなら、",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "経験不足な兵たちを",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "うまく導いてくれるだろう。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "なるほど、",
    "voice": "vo_adv_5142700_009",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "それで呼ばれたわけか。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "なら、",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "教え子の面倒は最後まで見てやらないとな。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "\\nエリコはどうだ？",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "その程度の仕事であれば、",
    "voice": "vo_adv_5142700_010",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "構いませんわ。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "\\n数が集まっただけの烏合の衆など、",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "\\n私が全員蹴散らして差し上げましょう。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "いや、",
    "voice": "vo_adv_5142700_011",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "ダメだろそれじゃ。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "あくまで戦うのは新兵たちの役目で、",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "\\nあたしたちは指示を飛ばすだけ。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "そんなとこだろ？",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "面倒ですわね……",
    "voice": "vo_adv_5142700_012",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "\\n私たちが手を下せば、",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "確実な戦果が手早く得られますのに。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "大事なのは、",
    "voice": "vo_adv_5142700_013",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "新兵がしっかり実力をつけることだよ。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "\\nその道のりに近道なんてないんだ。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "わかっています。",
    "voice": "vo_adv_5142700_014",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "まったく、",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "教官というのは一筋縄ではいかない仕事ですわね。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "では改めて……",
    "voice": "vo_adv_5142700_015",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "\\n今回二人には、",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "街道を占拠する魔物の掃討にあたって、",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "\\n新兵たちの部隊を指揮する役目を任せよう。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "訓練課程での班編成より",
    "voice": "vo_adv_5142700_016",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "大人数の兵士をまとめるわけだけど、",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "\\n君たちになら",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "みんなついてきてくれるはずだよ。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "なるほど……",
    "voice": "vo_adv_5142700_017",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "わかりました。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "\\n私の教え子たちが、",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "邪魔くさい魔物たちを",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "\\n一匹残らず駆逐してみせましょう。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "そんじゃ、",
    "voice": "vo_adv_5142700_018",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "二人で引き受けるってことで。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "みんなの成長を見届けるつもりで頑張ろうぜ、",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "エリコ。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "マコトさん、",
    "voice": "vo_adv_5142700_019",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "ぬるいことを言っている暇はありません。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "新兵たちが最高の結果を残せるよう、",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "\\n私たちも全力で指揮にあたるのです。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "お、",
    "voice": "vo_adv_5142700_020",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "おう……？　",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "いや待てエリコ。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "\\n面倒そうだったのに、",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "なんかいきなり乗り気になってないか？",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "当然ですわ。",
    "voice": "vo_adv_5142700_021",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "\\n大勢の新兵たちを指揮することになると聞いたでしょう？",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "つまりそれは、",
    "voice": "vo_adv_5142700_022",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "優秀な教官である私の姿……",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "ひいては、",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "あのおかたの伴侶に相応しい姿を",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "大勢の目に焼き付ける",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "\\n絶好の機会だということ。",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "手を抜くわけにはまいりません！",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "どんな理屈だ！",
    "voice": "vo_adv_5142700_023",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "\\n",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "相変わらずぶっ飛んでるなおまえ！",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "何を言っているのです。",
    "voice": "vo_adv_5142700_024",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "マコトさんにとっても同じことでしょう？",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "んなっ……！？　",
    "voice": "vo_adv_5142700_025",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "い、",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "いや、",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "あたしは別に？",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "\\nあ、",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "あいつの伴侶とかそういうのは、",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "その……",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "私とあのおかたの仲を全力で応援するのなら、",
    "voice": "vo_adv_5142700_026",
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "\\nあなたにとっても",
    "voice": null,
    "unit_id": 102711
  },
  {
    "type": "dialogue",
    "name": "エリコ",
    "words": "またとないチャンスです。",
    "voice": null,
