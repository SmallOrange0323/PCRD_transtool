    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "そうそう、",
    "voice": "vo_adv_5142700_028",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "助っ人として参加してもらえるよう、",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "\\n君たちの友人にも依頼してあるんだ。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "\\n協力して任務を進めてほしい。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "ああ、",
    "voice": "vo_adv_5142700_029",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "そりゃ助かるぜ。",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "\\n戦力が多いに越したことはないし……",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "……ん？　",
    "voice": "vo_adv_5142700_030",
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "まさかそれって、",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "こっちが引き受けるの前提で",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "\\nとっくに話を進めてたってことか！？",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "ふっ、",
    "voice": "vo_adv_5142700_031",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "期待していたと言ってくれ。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "ジュン",
    "words": "君たちは優秀な教官だからね。",
    "voice": null,
    "unit_id": 104711
  },
