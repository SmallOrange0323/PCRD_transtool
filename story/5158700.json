  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "だから",
    "voice": null,
    "unit_id": 104311
  },
  {
    "type": "dialogue",
    "name": "マコト",
    "words": "あたしはそういうつもりじゃ……",
