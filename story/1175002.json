[
  {
    "type": "background",
    "bg_id": "500651"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "深月與{0}，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在大江戶町購物。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "放在那邊的中藥，",
    "voice": "vo_adv_1175002_000",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "還有那邊的中藥，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "有多少我就買多少。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我記得這個也剩得不多了……",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "可以拿給我嗎？",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "哎呀，",
    "voice": "vo_adv_1175002_001",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "你怎麼看得這麼認真？",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "對呀。",
    "voice": "vo_adv_1175002_002",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "中藥是以各種藥草為原料製作的，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "因此種類繁多。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "譬如這種中藥，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "就是用含劇毒的植物製成的喔。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不過，",
    "voice": "vo_adv_1175002_003",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "那種危險的植物",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "只要運用得好，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "也會替人們帶來健康。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n就像活在黑暗中的科學家，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "有時會作為醫生幫助他人一樣。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "呵呵。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "沒錯。",
    "voice": "vo_adv_1175002_004",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "仔細一看，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "就會發現它的形狀有些扭曲怪異。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "不過，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這樣的植物",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "對人有所助益，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "很不可思議吧。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "呵呵。",
    "voice": "vo_adv_1175002_005",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "難以用常識對付但確實很有實力，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "中藥這樣的一面，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n或許跟",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "【暮光流星群】有些相似呢。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "另一頭也有經手中藥的藥品批發商呢。",
    "voice": "vo_adv_1175002_006",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我們過去看看吧。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n我在醫院看診時幾乎把藥材都用光了，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n想在回蘭德索爾前",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "補充庫存。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "往這邊走，",
    "voice": "vo_adv_1175002_007",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "跟我來。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "──呀！？",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "哎呀",
    "voice": "vo_adv_1175002_008",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "抱歉……",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我不小心走神了……",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "啊，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "妳不是",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "深月醫生嗎？",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "哎呀，",
    "voice": "vo_adv_1175002_009",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "你是……",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我記得是",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "來道一家的……",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "你的臉色好蒼白，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "怎麼了嗎？",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "不……",
    "voice": "vo_adv_1175002_010",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n沒什麼大不了的……",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n這歸根究柢都是我的錯……",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "將軍……",
    "voice": "vo_adv_1175002_011",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "謝謝你。",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "一直受到你們的照顧，我真沒出息……",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "那個，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "其實──",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "嗯～",
    "voice": "vo_adv_1175002_012",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "總之，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "有個惡質的旅行商人騙你買下了",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "昂貴的",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "假中藥吧。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "沒錯。",
    "voice": "vo_adv_1175002_013",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "因為希望頭目長保身體健康……",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n我不慎聽信了",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "那個旅行商人的花言巧語……",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我以為買到了好藥，",
    "voice": "vo_adv_1175002_014",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "去找熟悉中藥的傢伙炫耀，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "他卻告訴我那是假的中藥……",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "……的確，",
    "voice": "vo_adv_1175002_015",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "這個成分",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "是沒有藥效的植物。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n唉，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "以外行人的眼光",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "應該無法分辨中藥的真假……",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n這商人手段還真黑心。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "即使質問他，",
    "voice": "vo_adv_1175002_016",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "他也用不知情來推託過去………",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "就算去告狀，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "【王宮騎士團】的人也說因為沒有證據，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n無法逮捕旅行商人……",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我在搞什麼啊……！",
    "voice": "vo_adv_1175002_017",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "頭目不在的期間，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我不僅沒保護好城鎮，",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n還上當遭到詐欺……！",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "部下這麼不爭氣，",
    "voice": "vo_adv_1175002_018",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "頭目也沒辦法安心休息吧……",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n我",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "沒有臉見頭目……",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "因為是前幾天才發生的事，",
    "voice": "vo_adv_1175002_019",
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "我想大概還在……",
    "voice": null,
    "unit_id": 1111
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "等等。",
    "voice": "vo_adv_1175002_020",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "真是的。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "你還是老樣子，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "看到有人碰到困難就沒辦法置之不理。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n真是個濫好人。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "算了。",
    "voice": "vo_adv_1175002_021",
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n既然是這麼回事，",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "我也有個想法。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "\\n",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "一個對於會做非法生意的惡質之輩",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "深月",
    "words": "非常管用的方法。",
    "voice": null,
    "unit_id": 117511
  },
  {
    "type": "dialogue",
    "name": "旅行商人",
    "words": "來來來，",
    "voice": "vo_adv_1175002_022",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "旅行商人",
