  {
    "type": "dialogue",
    "name": "優衣",
    "words": "\\n",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "我們總共找回了……",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "目前是",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "優衣",
    "words": "四顆。",
    "voice": null,
    "unit_id": 100211
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "被彌勒拿走了",
    "voice": "vo_adv_9100115_002",
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "八顆對吧。",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "\\n",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "雪菲",
    "words": "剩下的四顆會在哪裡呢？",
    "voice": null,
    "unit_id": 106411
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "哼──哈哈哈！",
    "voice": "vo_adv_9100115_003",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "！？",
    "voice": "vo_adv_9100115_004",
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "\\n剛才那是",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "怜",
    "words": "什麼聲音……",
    "voice": null,
    "unit_id": 100311
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "唔～",
    "voice": "vo_adv_9100115_005",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n聽起來很耳熟耶……",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "該不會是……！？",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "哼──哈哈哈！",
    "voice": "vo_adv_9100115_006",
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "\\n哼──哈哈哈哈！！",
    "voice": null,
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "唉呀唉呀，",
    "voice": "vo_adv_9100115_007",
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "是吃閒飯的貪吃公主啊！",
    "voice": null,
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "\\n拖著一大群同伴，",
    "voice": null,
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "要到死後世界去散步嗎？",
    "voice": null,
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "果然，",
    "voice": "vo_adv_9100115_008",
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是豪紳先生！？",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "這是你第二次",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "造反了吧……！",
    "voice": null,
    "unit_id": 105811
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "哎呀哎呀。",
    "voice": "vo_adv_9100115_009",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n你還真是完全沒學到教訓耶，議長大人。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "啊～",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我失禮了……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "是「前」",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "議長才對吧？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "克蕾琪塔‧凱許……！",
    "voice": "vo_adv_9100115_010",
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "\\n骯髒的女商人，",
    "voice": null,
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "要是那時就解決掉妳的話……！",
    "voice": null,
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "哦～呵呵呵♪",
    "voice": "vo_adv_9100115_011",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我要向你道謝呢，混蛋議長♪",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "多虧了你派來刺客時，陛下救了我，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n我",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "才能覺醒！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "那對陛下的忠義之心！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "真是的，",
    "voice": "vo_adv_9100115_012",
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "得了便宜還賣乖啊……",
    "voice": null,
    "unit_id": 106011
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "妳這種守財奴",
    "voice": "vo_adv_9100115_013",
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "說什麼忠義忠義的！",
    "voice": null,
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "\\n別再說些令人不快的胡言亂語了！",
    "voice": null,
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "\\n呼嗯，",
    "voice": null,
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "黑暗豪紳最愛神奇光束！！",
    "voice": null,
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "危險！",
    "voice": "vo_adv_9100115_014",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n……妳沒事吧？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "克蕾琪塔……！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "唔！",
    "voice": "vo_adv_9100115_015",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "純騎士團長……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "妳竟然保護了我。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "我們同為服務陛下",
    "voice": "vo_adv_9100115_016",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "以及國家的人。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n守護值得信賴的夥伴，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "是理所當然的事啊，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "克蕾琪塔。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "請、",
    "voice": "vo_adv_9100115_017",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "請妳別誤會囉！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "我是服侍陛下，",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "國家只是其次。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "克蕾琪塔",
    "words": "\\n還有，可以不要叫我叫得那麼親暱嗎！？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "嗯……",
    "voice": "vo_adv_9100115_018",
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "竟然能擋住剛才那一擊，",
    "voice": null,
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "\\n",
    "voice": null,
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "真不愧是【王宮騎士團】的團長啊……！",
    "voice": null,
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "\\n既然如此……！",
    "voice": null,
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "黑暗豪紳最終極限波！",
    "voice": null,
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "唔！？",
    "voice": "vo_adv_9100115_019",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "唔唔！？",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "團長！",
    "voice": "vo_adv_9100115_020",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "妳沒事吧！？",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "嗯，",
    "voice": "vo_adv_9100115_021",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "還好……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n但小心點，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "小智，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "茉莉。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n那個衝擊波……",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "似乎不是人類能自然擁有的力量……！",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "哼──哈哈哈！",
    "voice": "vo_adv_9100115_022",
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "\\n",
    "voice": null,
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "妳說得沒錯，",
    "voice": null,
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "現在的吾輩已經超越了人類！",
    "voice": null,
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "\\n",
    "voice": null,
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "來吧，看清楚了！",
    "voice": null,
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "新王，",
    "voice": null,
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "豪紳",
    "words": "黑暗之王豪紳的誕生！",
    "voice": null,
    "unit_id": 191411
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "議長的外觀",
    "voice": "vo_adv_9100115_023",
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "智",
    "words": "改變了……！？",
    "voice": null,
    "unit_id": 103711
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "就像怪人一樣！",
    "voice": "vo_adv_9100115_024",
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "\\n",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "到底是怎麼回事啊？",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "茉莉",
    "words": "那個人……！？",
    "voice": null,
    "unit_id": 100511
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "目前還不曉得……",
    "voice": "vo_adv_9100115_025",
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "\\n現在先採取防禦陣形，",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "純",
    "words": "小心應對吧。",
    "voice": null,
    "unit_id": 104711
  },
  {
    "type": "dialogue",
    "name": "兩人",
    "words": "是！",
    "voice": "vo_adv_9100115_026",
    "unit_id": null
  }
