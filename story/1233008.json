    "name": "卡里莎",
    "words": "什麼！？",
    "voice": "vo_adv_1233008_061",
    "unit_id": 191611
  },
  {
    "type": "dialogue",
    "name": "卡里莎",
    "words": "剛才的那個，",
    "voice": null,
    "unit_id": 191611
  },
