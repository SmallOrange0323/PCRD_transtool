[
  {
    "type": "dialogue",
    "name": "碧",
    "words": "成功了嗎……？",
    "voice": "vo_adv_5094203_000",
    "unit_id": 122111
  },
  {
    "type": "dialogue",
    "name": "碧",
    "words": "\\n",
