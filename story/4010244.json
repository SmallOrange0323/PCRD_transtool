    "type": "dialogue",
    "name": "撫瑠無",
    "words": "既然這樣，你倒是早點說好嗎。",
    "voice": null,
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "\\n害我剛才一直亂摸你的身體，",
    "voice": null,
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "\\n搞得像是什麼色色的女孩子一樣。",
    "voice": null,
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "啊……",
    "voice": "vo_adv_4010244_019",
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "該不會",
    "voice": null,
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "那也在你的算計之中？",
    "voice": null,
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "\\n",
    "voice": null,
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "看來被你擺了一道呢。",
    "voice": null,
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "\\n",
    "voice": null,
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "……哇。",
    "voice": null,
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "我突然覺得",
    "voice": null,
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "有點害羞。",
    "voice": null,
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "算了，",
    "voice": "vo_adv_4010244_020",
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "開玩笑就先到此為止……",
    "voice": null,
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "\\n",
    "voice": null,
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "那",
    "voice": null,
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "我們",
    "voice": null,
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "走吧。",
    "voice": null,
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "\\n不用擔心，",
    "voice": null,
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "我不會要求什麼貴重禮物的。",
    "voice": null,
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "畢竟，",
    "voice": "vo_adv_4010244_021",
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "\\n",
    "voice": null,
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "我最想要的……",
    "voice": null,
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "\\n是跟騎士先生還有老姊她們",
    "voice": null,
    "unit_id": 127831
  },
  {
    "type": "dialogue",
    "name": "撫瑠無",
    "words": "永遠相處在一起嘛。",
    "voice": null,
    "unit_id": 127831
  }
]
