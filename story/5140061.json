[
  {
    "type": "background",
    "bg_id": "501070"
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "王家主催のクリスマスイベントまで一ヵ月を切ったある日。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "ナレーション",
    "words": "\\n執務室でクレジッタは頭を抱えていた。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ああっ……",
    "voice": "vo_adv_5132061_000",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "不安ですわ！　",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "不安不安っ！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n「安からず」と書いて不安！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "当日まで時間がないというのに、",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "不安でおかしくなりそうですわ……！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "綿密に立てたプランに、",
    "voice": "vo_adv_5132061_001",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "資材や商品、",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "催し……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "全てこの目で選び抜いた一級品ばかり。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n必ずや陛下のお眼鏡にかなうはずですのに、",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "なぜなんですの！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "やっぱり計画を一から見直すべき？　",
    "voice": "vo_adv_5132061_002",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "いいえいいえ、",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nどこかにミスがないか、",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "まずは計画書を最初からチェックして……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ほら、",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "貴女も手伝いなさいな！　",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "そっちの山を頼みますわよ！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "……",
    "voice": "vo_adv_5132061_003",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "不安なお気持ちは分かりますが、",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\nここまで進んだ計画を",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "今ひっくり返したら",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "経費がどれだけ",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\nかかるかも",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "お分かりでしょう。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "計算してお見せしますか？",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "いまさら大枠は変えられない以上、",
    "voice": "vo_adv_5132061_004",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n腹をくくっていただかないと。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "言われなくともわかってますわ。",
    "voice": "vo_adv_5132061_005",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nですが、",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "これは陛下自らがわたくしに任せてくださった仕事！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n万全に万全を期すためには",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "労も金も惜しみませんわよ！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "まあ、",
    "voice": "vo_adv_5132061_006",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "慎重になってくれているのはいいことです。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "うっかり調子に乗った挙句",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "失敗してクビになっても",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "困りますしね。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "貴女ねえ！　",
    "voice": "vo_adv_5132061_007",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ただでさえ不安にさいなまれている雇い主に",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n縁起の悪いこと言わないでくださる！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "これでもし失敗して陛下のおそばにいられなくなったら",
    "voice": "vo_adv_5132061_008",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\nどうしてくれるんですの！　",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "わたくしの心痛、",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n貴女のボーナスをカットするだけじゃ補填できませんわよ！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "困りましたね、",
    "voice": "vo_adv_5132061_009",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "すっかりテンパってしまっています。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "私に腹パンや首根っこをストッとやれる技術があれば",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "クレジッタさまを落ち着かせて差し上げられたのですが……",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ちょっ、",
    "voice": "vo_adv_5132061_010",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "秘書１号っ！？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n物騒なセリフを吐きつつ",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n腕まくりしながら近づかないでいただけますことかしらっ！？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "あ、",
    "voice": "vo_adv_5132061_011",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "あの……",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "大きな声が聞こえましたが",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "大丈夫ですか？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "へ、",
    "voice": "vo_adv_5132061_012",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "陛下！？",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "いえいえいえ",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ななななんでもありませんわほほほほほ……",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "丁度いいところにいらっしゃいました、",
    "voice": "vo_adv_5132061_013",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "陛下。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "クレジッタさまがイベントへの不安から",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "右往左往しておりますので、",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "\\n優しいお言葉の一つでも",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "かけてあげていただけませんか？",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "こ、",
    "voice": "vo_adv_5132061_014",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "こら！　",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "余計なことは言わなくていいんですのよ！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "クレジッタさんでも不安に思うこと、",
    "voice": "vo_adv_5132061_015",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "あるんですね☆",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "今回はクレジッタさんを信頼してお任せしたのですから、",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "思うようにばーんとやってください！",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "陛下……",
    "voice": "vo_adv_5132061_016",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "なんと寛大で深いお心をお持ちなのでしょう！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "いえ",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "もちろん前から知っていましたが",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "何度でも感動してしまいますわっ。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "商人として確かな目を持つクレジッタさんなら大丈夫です！",
    "voice": "vo_adv_5132061_017",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "わたしも秘書さんも信じてますから☆",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "ええ、",
    "voice": "vo_adv_5132061_018",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "信じてます。",
    "voice": null,
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "貴女いくら何でも棒読みが過ぎませんこといつも以上にっ！？",
    "voice": "vo_adv_5132061_019",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "でももし、",
    "voice": "vo_adv_5132061_020",
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "執務室で不安になっちゃうようでしたら、",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "気分転換に",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "街に出てみてはどうですか？",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "街のみなさん、",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "クリスマスイベントを楽しみにしてるみたいですよ☆",
    "voice": null,
    "unit_id": 105812
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "ありがとうございます、",
    "voice": "vo_adv_5132061_021",
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "陛下。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "では、",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "お言葉に甘えさせていただきます。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "現場を見ずして催事の成功などありえませんもの。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "\\n頭を冷やして",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "よりいいイベントにするとお約束いたします。",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "クレジッタ",
    "words": "失礼！",
    "voice": null,
    "unit_id": 118011
  },
  {
    "type": "dialogue",
    "name": "秘書",
    "words": "……ふぅ、",
    "voice": "vo_adv_5132061_022",
    "unit_id": 6111
  },
  {
    "type": "dialogue",
    "name": "秘書",
