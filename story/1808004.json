  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在那起事件後──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n美美等人在恢復和平的祕密基地享受著悠閒的時光。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "３人",
    "words": "呼哇～～～",
    "voice": "vo_adv_1808004_000",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "感覺已經很久",
    "voice": "vo_adv_1808004_001",
    "unit_id": 102012
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "沒有這麼悠閒了呢～",
    "voice": null,
    "unit_id": 102012
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "因為我們一直被奇怪的事件波及啊。",
    "voice": "vo_adv_1808004_002",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "但我們幫助了傷腦筋的人，",
    "voice": "vo_adv_1808004_003",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "也取回了蝴蝶結！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊喜歡惡作劇，",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "但趕跑「大魔王」也很不錯呢！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "呵呵♪",
    "voice": "vo_adv_1808004_004",
    "unit_id": 102012
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n我們第一次玩耍時，",
    "voice": null,
    "unit_id": 102012
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "也有說要去打倒「大魔王」，",
    "voice": null,
    "unit_id": 102012
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n一起經歷了很多冒險呢～",
    "voice": null,
    "unit_id": 102012
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我想起來了。",
    "voice": "vo_adv_1808004_005",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n雖然那天很辛苦，",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "卻過得很快樂呢。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "我們",
    "voice": "vo_adv_1808004_006",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "馬上就變成好朋友了呢！",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "說到這個，在那時候啊，",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n禊總覺得自己不是第一次跟妳們一起玩。",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "兩人",
    "words": "…………",
    "voice": "vo_adv_1808004_007",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "雖然那是不可能的，",
    "voice": "vo_adv_1808004_008",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "但我好像多少能懂那種感覺。",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "美美也是～",
    "voice": "vo_adv_1808004_009",
    "unit_id": 102012
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n因為和妳們在一起時，",
    "voice": null,
    "unit_id": 102012
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "美美會覺得很放心。",
    "voice": null,
    "unit_id": 102012
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n可以和大家待在一起，",
    "voice": null,
    "unit_id": 102012
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "好開心…………",
    "voice": null,
    "unit_id": 102012
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "美美睡著了。",
    "voice": "vo_adv_1808004_010",
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "但因為很溫暖，",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "禊也來小睡…………",
    "voice": null,
    "unit_id": 100411
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "真是的……",
    "voice": "vo_adv_1808004_011",
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n妳們兩個",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "真的很孩子氣耶…………",
    "voice": null,
    "unit_id": 103611
  },
  {
    "type": "background",
    "bg_id": "510400"
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "今、",
    "voice": "vo_adv_1808004_012",
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "今天是第一次",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n和鏡華跟禊",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "在外頭見面……",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "因為這是「校外教學」，",
    "voice": "vo_adv_1808004_013",
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n所以並不是要一起去玩……",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "但如果可以跟她們當好朋友，美美會很開心的……",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "沒問題，",
    "voice": "vo_adv_1808004_014",
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "沒問題的……",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n那位在美美迷路時",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "幫助我的大兔子先生也有說過啊。",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "牠說「只要鼓起勇氣開口，",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "就可以當好朋友」……",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "是因為美美",
    "voice": "vo_adv_1808004_015",
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "有努力向她們開口，",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n我們才能在同一隊的啊。",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "美美一定",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "也可以和她們當好朋友吧。",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "哇！！！！",
    "voice": "vo_adv_1808004_016",
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "嗚呀……！！",
    "voice": "vo_adv_1808004_017",
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "啊哈哈！",
    "voice": "vo_adv_1808004_018",
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n禊的惡作劇",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "很成功呢！！",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "妳不可以那麼做啦！",
    "voice": "vo_adv_1808004_019",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n妳看，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "這不是害她快哭出來了嗎！",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "咦！？",
    "voice": "vo_adv_1808004_020",
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "對、",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "對不起！",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n因為禊看妳好像很緊張……",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n妳不喜歡這樣嗎……？",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "不，",
    "voice": "vo_adv_1808004_021",
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "是美美",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "太容易被嚇到了……",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n那個，",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "就是啊……",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "謝、",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "謝謝妳們",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "來參加。",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n那我們就去山裡",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "拍鳥的照片吧！",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "background",
    "bg_id": "510400"
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "不知道她們",
    "voice": "vo_adv_1808004_022",
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "喜歡什麼東西～",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "美美好想問，",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "但要怎麼開口才好呢～",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "啊！",
    "voice": "vo_adv_1808004_023",
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "這顆紅色的果實是什麼啊！",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "等、",
    "voice": "vo_adv_1808004_024",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "等等！",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n我們不是來玩的啊！",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "請妳找出野鳥！",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "嘖～",
    "voice": "vo_adv_1808004_025",
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n玩一下又沒什麼關係。",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "受不了妳……",
    "voice": "vo_adv_1808004_026",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "不過",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "仔細想想，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n我們分頭去找",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "好像能比較快找到啊。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "我晚點",
    "voice": "vo_adv_1808004_027",
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "還要去補習班。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n而且我們",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "已經交換過聯絡方式了，",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "這時候就先分頭行動吧。",
    "voice": null,
    "unit_id": 103631
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "等、",
    "voice": "vo_adv_1808004_028",
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "等一下……！",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n因為我們難得在同一隊……！",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n美美",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "想跟妳們一起去找……！",
    "voice": null,
    "unit_id": 102031
  },
  {
    "type": "dialogue",
    "name": "兩人",
    "words": "…………",
    "voice": "vo_adv_1808004_029",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "雖然禊自己一個人",
    "voice": "vo_adv_1808004_030",
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "也沒問題……",
    "voice": null,
    "unit_id": 100431
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "但既然隊長都這麼說了……",
    "voice": "vo_adv_1808004_031",
    "unit_id": 103631
  },
