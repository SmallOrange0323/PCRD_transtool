  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "我要上了！　",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "冰結凍獄絕零破！！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "――吼喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "呼……",
    "voice": "vo_adv_7007003_001",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "真無趣！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "喔……",
    "voice": "vo_adv_7007003_002",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "果然是不辱冥河之名的強大寒氣呀。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "哦哦，",
    "voice": "vo_adv_7007003_003",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "沒想到妳能理解我的咒文所蘊含的真意！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "不愧是奧恩斯坦大臣！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "――吼喔喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "唔，",
    "voice": "vo_adv_7007003_004",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "是新的魔物！　",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "修特帕魯！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "既然如此，",
    "voice": "vo_adv_7007003_005",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "下一招就用……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "雷神疾風閃‧剎那無常！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "魔物",
    "words": "――吼喔喔喔喔！",
    "voice": null,
    "unit_id": 1611
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "喔喔，",
    "voice": "vo_adv_7007003_006",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "用飛昇以及閃電來命名嗎，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "非常有意思呢。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n宛如",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "一道從大地向上飛騰的轟隆雷光",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "似的。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "雖然…",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "最後的詞語",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "就搞不懂是什麼意思了……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "哦哦……",
    "voice": "vo_adv_7007003_007",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "哦哦！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n居然連這種事都知道，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "奧恩斯坦大臣，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "難不成妳是我前世的……？",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "唔呣，",
    "voice": "vo_adv_7007003_008",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不知為何聽起來很熟悉……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "喔喔，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "對了。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身前陣子閱讀的書籍裡，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n記載著類似的咒文。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "咦……？",
    "voice": "vo_adv_7007003_009",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n那、",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "那本書叫什麼名字……！？",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "我記得是……",
    "voice": "vo_adv_7007003_010",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "對了對了。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "冥、",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "風？　",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "什麼戰記之類的。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "冥……",
    "voice": "vo_adv_7007003_011",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "冥風戰記！？",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "喔喔！　",
    "voice": "vo_adv_7007003_012",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "沒錯沒錯。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妳也知道那本書嗎？",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "說起來",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這還真是奇妙。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "沒想到在書上看過的那咒文",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "竟然被修特帕魯、",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "也就是妳給使出來了。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "啊，",
    "voice": "vo_adv_7007003_013",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "是……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "是那樣子呢……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "所以……",
    "voice": "vo_adv_7007003_014",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "那個、",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "奧恩斯坦大臣對於魔法知之甚深，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n那麼冥風戰記讀完的感想，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "究竟是如何呢……？",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "唔呣。",
    "voice": "vo_adv_7007003_015",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "看起來很像曾經參與古代魔法戰爭",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "的一本戰士手札呢。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n稱不上是正統史書，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "但是值得一讀。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "尤其是",
    "voice": "vo_adv_7007003_016",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "有關前世記憶的部份",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "寫得特別有趣。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身雖然活了很長一段時間，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "但是再怎麼樣都不可能在",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "人界形成前誕生。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "或許",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身也有所謂的",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "前世，只是不記得罷了。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "是、",
    "voice": "vo_adv_7007003_017",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "是那樣？　",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "妳覺得有趣嗎！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "當作一般讀物來看確實不錯。",
    "voice": "vo_adv_7007003_018",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "雖然有些部份屬於無稽之談，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不過魔法理論描述得條理分明。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身認為不能輕易斷定",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "都",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "只是空穴來風……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "就在此時，",
    "voice": "vo_adv_7007003_019",
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "和那本書一樣的魔法師……",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "修特帕魯出現了。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n所謂神話",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "是在口耳相傳過程中",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "經過渲染誇大的產物。",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不過也有可能出乎意料之外，",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "其實是有歷史根據的事實呢！",
    "voice": null,
    "unit_id": 104412
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "喔、",
    "voice": "vo_adv_7007003_020",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "喔喔……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "原來如此原來如此。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "嗯、",
    "voice": "vo_adv_7007003_021",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "嗯嗯……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "能獲得「傳說的吸血鬼」",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "的認可……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "總覺得好難為情啊！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "真的是很有意思喔。",
    "voice": "vo_adv_7007003_022",
    "unit_id": 104412
