[
  {
    "type": "background",
    "bg_id": "500260"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在蘭德索爾充分享受過新年，\\n伊莉亞和{0}",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "一臉滿足地回到了古城。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "呼，",
    "voice": "vo_adv_1209004_000",
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "總算回到妾身的城堡了。",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這身子的步伐",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "果然比較小，",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "回家的路走起來感覺特別遠呢。",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不過，",
    "voice": "vo_adv_1209004_001",
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "一想到妾身因此而能和這傢伙相處得更久，",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n這副姿態",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "也不是一無是處哪……",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "但",
    "voice": "vo_adv_1209004_002",
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "雖說妾身是為了未來的人民，",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n才放棄真正姿態的……",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "現在又得找出變回去的方法了哪。",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……喂，",
    "voice": "vo_adv_1209004_003",
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "幹嘛一臉滿足地呆站著？",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n妾身會變回這副姿態，",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "還不就是你出的主意害的？",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "接下來也要當護花使者、",
    "voice": "vo_adv_1209004_004",
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "護花使者。",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "暫時",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不許你離開妾身的身邊哦。",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……嗯？",
    "voice": "vo_adv_1209004_005",
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "為什麼房間好像散發著奇異的光芒……",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n難道是哪個房間的窗簾沒有拉好嗎？",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗚，",
    "voice": "vo_adv_1209004_006",
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "好、",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "好刺眼……！",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "──等等，",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "在發光的",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不就是你嗎！？",
    "voice": null,
    "unit_id": 120912
  },
  {
    "type": "background",
    "bg_id": "510202"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "──在將要迎來新年的某夜。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "人們正趕著回家，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n而伊莉亞隻身一人，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在瞭望台眺望燈火通明的城鎮。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯。",
    "voice": "vo_adv_1209004_007",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n怪不得妾身覺得城鎮變得冷清了。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……已經要過年了啊。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "唉，",
    "voice": "vo_adv_1209004_008",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "真憂鬱。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n這時節的寒冷",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不知為何要比往常更加刺骨。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……心中這份因長命而生的寂寞，",
    "voice": "vo_adv_1209004_009",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身早在許久以前就決定要遺忘的。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "但年復一年，",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身總在要忘記時又再度想起。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "孤獨這傢伙啊……",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "簡直能自詡為妾身的家人了呢。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "還是說，",
    "voice": "vo_adv_1209004_010",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這也是因為與那傢伙相遇，",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "所以打從心底信任他的緣故呢。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "反常地",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "變得感傷了呀……",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "呀啊啊啊！？",
    "voice": "vo_adv_1209004_011",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n怎、",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "怎怎怎、",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "怎麼了！？",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n──是你啊！！",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "別在妾身無精打采的時候……",
    "voice": "vo_adv_1209004_012",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n忽、",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "忽然向妾身搭話！",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "而、",
    "voice": "vo_adv_1209004_013",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "而且，",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n偏偏還是在",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身想著這傢伙的時候……",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "哎唷，",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "該擺出什麼表情才好……",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……耳、",
    "voice": "vo_adv_1209004_014",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "耳朵真尖啊。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n明明平常就呆呆的，",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "卻只在這種時候……",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "算了，",
    "voice": "vo_adv_1209004_015",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "是因為妾身",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "活得比你更久的緣故吧。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "所以才會不斷回顧過往呢。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "比起這個……",
    "voice": "vo_adv_1209004_016",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n你應該也有等著你回去的家人吧？",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "太陽馬上就要下山了，",
    "voice": "vo_adv_1209004_017",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "而且天氣也很冷。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "別在這種地方徘徊了，",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "快點回家比較好哦。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾、",
    "voice": "vo_adv_1209004_018",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身……",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n妾身很中意這片從瞭望台看出去的夜景。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "尤其是，",
    "voice": "vo_adv_1209004_019",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "在這個時節所望見的城鎮燈火，",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n因為空氣澄澈，",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "所以別有韻味。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "在征服世界之前，",
    "voice": "vo_adv_1209004_020",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n妾身想先獨占這片絕景。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "再享受一下子，",
    "voice": "vo_adv_1209004_021",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身也要回去了。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你也不要有所顧慮，",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "快點回到家人身邊吧。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……快，",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你還不走嗎？",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你說什麼？",
    "voice": "vo_adv_1209004_022",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "在這裡等一下",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "是什麼意思……",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n──喂、",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "喂，",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你！",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "唉，",
    "voice": "vo_adv_1209004_023",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "還是跟往常一樣，老是這麼不穩重啊。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n至少也說一下到底要做什麼吧……",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "啊，",
    "voice": "vo_adv_1209004_024",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你回來了！",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n剛剛去了哪裡？",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "還有，",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "那堆東西到底是……",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你背上背的東西是……",
    "voice": "vo_adv_1209004_025",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "新年裝飾",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗎？",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n還有像是玩具之類的東西……",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "還有，",
    "voice": "vo_adv_1209004_026",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "那個……",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你手上拿著的鍋子？這又是？",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你、",
    "voice": "vo_adv_1209004_027",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你說年糕湯？",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n是人民在這種時候",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "會聚在一起吃的那個年糕湯？",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n……還有點熱呢",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "──不，",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這根本是燙的呀。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "難道",
    "voice": "vo_adv_1209004_028",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你……",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n回家一趟後",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "又回來這裡？",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "………………",
    "voice": "vo_adv_1209004_029",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "哼，",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "呵呵──",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "哈哈哈！",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你、",
    "voice": "vo_adv_1209004_030",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你這傢伙，",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "真是個打破常規的人哪！",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n不論什麼時候，",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "都不曉得你會做出什麼事來！",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "想看夜景，所以抱著裝有年糕湯的鍋子，",
    "voice": "vo_adv_1209004_031",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n在年前的街上走來走去……",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "哈哈哈，",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你這種人，妾身也是第一次看見呢。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "就是為了",
    "voice": "vo_adv_1209004_032",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "和你這般有趣又奇怪的人相遇……",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n呵呵，",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身才會活這麼久的吧。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……好吧。",
    "voice": "vo_adv_1209004_033",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這是你讓妾身發出新年第一笑的回禮。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n能和妾身",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "共賞這片絕景的榮耀，",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n就特別賞賜給你一人吧……",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "但是，",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這可是有條件的。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "趁還沒涼之前，",
    "voice": "vo_adv_1209004_034",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "把那年糕湯給妾身吧。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n在這裡看見的景色",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "都將會納入妾身的統治，",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n所以年糕湯就當作是參觀費了。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這次特別算你一碗就好。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "still",
    "still_id": "120900401"
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "──呼哈……",
    "voice": "vo_adv_1209004_035",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "好溫暖。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n簡直像",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "吸吮美味之血時的感覺……",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n全身暖呼呼的，好舒服哦。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯、",
    "voice": "vo_adv_1209004_036",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "年糕湯吃得到濃郁香味，",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "真好吃。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n妾身不知道是你的父親還母親做的，",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不過真是好手藝。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "當妾身完成征服世界之時，",
    "voice": "vo_adv_1209004_037",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n妾身很樂意",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "納他為專屬的廚師。這手藝就是這麼好。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "連那種東西都……",
    "voice": "vo_adv_1209004_038",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "是特地裝在保溫瓶裡帶過來的嗎？",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n你又費了一番心思呀。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不過，",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "還真體貼。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "就讚賞你吧。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……呼。",
    "voice": "vo_adv_1209004_039",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "果然是好景色呢。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n妾身已看過這片夜景無數次，",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "但像這樣和你一起眺望，",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n又更加別有風味。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "街上的每一簇燈光",
    "voice": "vo_adv_1209004_040",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "看起來都好溫暖……",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "以前，妾身總覺得它們在遠方閃耀，",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "但此刻",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "卻感覺它們忽然靠得好近。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "真是不可思議呀。",
    "voice": "vo_adv_1209004_041",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n即便現在妾身非常喜愛這景色，",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "從前卻認為終有一天會對此感到厭煩。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "只要待在你身邊……",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "就不會無趣。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "呵呵，",
    "voice": "vo_adv_1209004_042",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "真是令人愉快的傢伙哪。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n今年也",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "盡心取悅妾身吧。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n可以的話，",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "明年也要如此，",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "後年也是。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……妾身會期待",
    "voice": "vo_adv_1209004_043",
    "unit_id": 104431
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "並等著的。",
    "voice": null,
    "unit_id": 104431
  },
  {
    "type": "background",
    "bg_id": "500270"
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "嗚……",
    "voice": "vo_adv_1209004_044",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "總覺得",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "好想哭哦。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n一直以來崇高又精神滿滿的伊莉亞，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n居然也有這一面……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "所有人都希望長命百歲，",
    "voice": "vo_adv_1209004_045",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n雖然我不認為那是多奢侈的願望……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "但有些痛苦啊，唯有活得夠久，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "才得以體會。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "可是……",
    "voice": "vo_adv_1209004_046",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "此刻的伊莉亞",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "有你在。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n她已經不是孤身一人了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "一定是這樣吧？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "至少，在這個瞬間，",
    "voice": "vo_adv_1209004_047",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "伊莉亞應該會這麼想吧。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "……「幸好有你」。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n呵呵，",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "接下來你也要好好珍惜她哦？",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "啊，",
    "voice": "vo_adv_1209004_048",
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "還有……",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "差點忘記說了。",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "祝你新年快樂～",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "今年也多多指教囉～！",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "dialogue",
    "name": "愛梅斯",
    "words": "\\n再見～",
    "voice": null,
    "unit_id": 190011
  },
  {
    "type": "background",
    "bg_id": "500260"
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "唔、",
    "voice": "vo_adv_1209004_049",
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯……？",
    "voice": null,
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身是怎麼了？",
    "voice": null,
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "好像在不知不覺間睡著了。",
    "voice": null,
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "但是……",
    "voice": "vo_adv_1209004_050",
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "好像做了個非常美好的夢。",
    "voice": null,
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n溫暖的感覺在胸口深處慢慢地湧現。",
    "voice": null,
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這傢伙也頂著一張幸福的臉睡著了。",
    "voice": "vo_adv_1209004_051",
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……喂，",
    "voice": null,
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你啊，",
    "voice": null,
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "還不起來嗎？",
    "voice": null,
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "在這種地方睡著的話，會感冒的哦。",
    "voice": null,
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你還沒清醒嗎？",
    "voice": "vo_adv_1209004_052",
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n現在妾身的身體是縮小的……",
    "voice": null,
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "對吧……？",
    "voice": null,
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n嗯？",
    "voice": null,
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯嗯～？",
    "voice": null,
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "哦、",
    "voice": "vo_adv_1209004_053",
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "哦哦……！",
    "voice": null,
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這是怎麼回事！",
    "voice": null,
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n妾身這不是……",
    "voice": null,
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "又變回真正的姿態了嗎！",
    "voice": null,
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "還真是僥倖！",
    "voice": "vo_adv_1209004_054",
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n這也是",
    "voice": null,
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "做了好夢的關係嗎？",
    "voice": null,
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "不論如何，",
    "voice": "vo_adv_1209004_055",
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "就暫時",
    "voice": null,
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "讓妾身安享這美妙的幸福吧。",
    "voice": null,
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯嗯，",
    "voice": "vo_adv_1209004_056",
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "對吧、對吧♪",
    "voice": null,
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n能立刻說出讚美之言，",
    "voice": null,
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n你啊，",
    "voice": null,
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "剛起床的時候反而更伶俐呢。",
    "voice": null,
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你難得能再次見到妾身的真正姿態，",
    "voice": "vo_adv_1209004_057",
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n別浪費這次機會，",
    "voice": null,
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "儘管稱讚妾身便是。",
    "voice": null,
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "如果你想的話，",
    "voice": null,
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "接下來的一整年也隨你稱讚。",
    "voice": null,
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "呵呵，",
    "voice": "vo_adv_1209004_058",
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "只要和你在一起，",
    "voice": null,
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "果然就不無聊呢。",
    "voice": null,
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "……妾身從前所懷抱的憂鬱情感，",
    "voice": null,
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "都不知道消散到哪去了呢。",
    "voice": null,
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "今年自然不必多提，",
    "voice": "vo_adv_1209004_059",
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "明年，",
    "voice": null,
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "還有後年……",
    "voice": null,
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n今後也要多加關照囉。",
    "voice": null,
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身的頭號眷屬啊！",
    "voice": null,
    "unit_id": 120911
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "在這之後，伊莉亞還是變回了小孩，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n但和{0}一同度過了幸福的新年，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n主人與眷屬間的情誼又加深了不少。",
    "voice": null,
    "unit_id": null
  }
]
