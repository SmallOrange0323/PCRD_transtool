  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n被門產生的力量推回來了……！",
    "voice": null,
    "unit_id": 122911
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "\\n",
    "voice": null,
    "unit_id": 122911
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "這樣子",
    "voice": null,
    "unit_id": 122911
  },
  {
    "type": "dialogue",
    "name": "美美",
    "words": "小繆就過不去了～",
    "voice": null,
    "unit_id": 122911
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "好──",
    "voice": "vo_adv_5098301_001",
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "那就輪到我們出馬囉！",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n我們在門裡面，",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "禊",
    "words": "\\n製造一條能讓小繆安全通過的路吧！",
    "voice": null,
    "unit_id": 122811
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "只要大家一起攻擊，",
    "voice": "vo_adv_5098301_002",
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n那個部分的門的魔力應該就會減弱……",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n那麼一來",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "一定會形成道路的！",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "小繆，",
    "voice": "vo_adv_5098301_003",
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "等著吧！",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "\\n我們",
    "voice": null,
    "unit_id": 122711
  },
  {
    "type": "dialogue",
    "name": "鏡華",
    "words": "會讓你平安回到原本的世界！",
    "voice": null,
    "unit_id": 122711
  }
]
