[
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "あれ、",
    "voice": "vo_adv_5048602_000",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "お姉ちゃん。",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "またラフィちゃんのお手紙読んで、",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "どうしたの？",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "ア、",
    "voice": "vo_adv_5048602_001",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "アカリ……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "えっと……",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "あの子の手紙を読み返してると、",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "どうしてかしら、",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "\\n元気と勇気が湧いてくる気がするから、",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "なんとなく、",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "ね。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "そうなの？　",
    "voice": "vo_adv_5048602_002",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "えへへ、",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "実は私もなんだ♪",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "ラフィちゃんが頑張ってる姿を想像するだけで、",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "何だか心があったかくなって、",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "幸せが湧いてくるんだよ。",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "それで、",
    "voice": "vo_adv_5048602_003",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "この幸せを",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "エンジェルとしてみんなにおすそ分けするの。",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "そうやってみんなの笑顔が見れたら、",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "また幸せになるの。",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "幸せが巡り巡って、",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "世界中が幸せになれたら最高だよね！",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "ふふ、",
    "voice": "vo_adv_5048602_004",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "やっぱりアカリはすごいわね。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "\\nもう立派なエンジェルじゃない。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "そういうお姉ちゃんだって、",
    "voice": "vo_adv_5048602_005",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "最高のエンジェルだよ♪",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "\\n双子エンジェルとして",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "アカリも鼻が高いよ！",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "……何言ってるのよ、",
    "voice": "vo_adv_5048602_006",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "もう。",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "さて、",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "元気も勇気ももらったことだし、",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "ヨリ",
    "words": "頑張らなくちゃね！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "うん、",
    "voice": "vo_adv_5048602_007",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "ランドソルのみんなに、",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "い～",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "っぱい幸せを届けちゃおう！",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "美少女エンジェル",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "アカリ",
    "words": "降臨だよ♪",
    "voice": null,
    "unit_id": 100611
  }
]
