    "name": "格蕾斯",
    "words": "還碰上許多棘手的事情，",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "但也遇到了更多的好事。",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "經歷過的每一件事情，",
    "voice": "vo_adv_1389003_069"
  },
  {
    "name": "格蕾斯",
    "words": "\\n不僅讓我重新審視",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "身為守護騎士的自己，",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "\\n也再次確認到",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "包含騎士氏在內，",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "身邊所有人的可貴。",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "因為有大家在身旁，",
    "voice": "vo_adv_1389003_070"
  },
  {
    "name": "格蕾斯",
    "words": "即使陷入嚴峻的狀況，也能成功跨越。",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "就像以答謝的形式，",
    "voice": "vo_adv_1389003_071"
  },
  {
    "name": "格蕾斯",
    "words": "招待鏡華大小姐與夫人",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "到餐廳一樣，",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "\\n我今後也想繼續傳達感謝之意。",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "\\n雖然不知道當時",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "為何會連騎士氏一起招待。",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "你覺得開心就好。",
    "voice": "vo_adv_1389003_072"
  },
  {
    "name": "格蕾斯",
    "words": "\\n因為我也受到了騎士氏的照顧呢。",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "其實，",
    "voice": "vo_adv_1389003_073"
  },
  {
    "name": "格蕾斯",
    "words": "一起喝茶，兩人共乘布羅肯，",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "\\n不只是為了釐清自己的情感，",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "同時也是對騎士氏的道謝唷。",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "不過……",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "在一起共度的期間，",
    "voice": "vo_adv_1389003_074"
  },
  {
    "name": "格蕾斯",
    "words": "\\n我認為自己不是只有「想要道謝」的想法……",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "\\n這份情感──",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "嗯──",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "有種心裡明白，",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "但不願理解的感覺。",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "……騎士氏，",
    "voice": "vo_adv_1389003_075"
  },
  {
    "name": "格蕾斯",
    "words": "從與我相遇起至今，你覺得如何呢？",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "\\n我與騎士氏參與過的事件中，",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "也有需要賭上性命的，",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "你肯定",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "覺得很艱辛吧。",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "騎士氏，",
    "voice": "vo_adv_1389003_076"
  },
  {
    "name": "格蕾斯",
    "words": "你真堅強呢。",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "……不過，",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "我也一樣就是。",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "跟騎士氏待在一起，就會感到開心……",
    "voice": "vo_adv_1389003_077"
  },
  {
    "name": "格蕾斯",
    "words": "Equal，",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "我不想與騎士氏分開。",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "\\n因為我當時產生那種想法……",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "所以，",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "鎖鏈才會把我們鏈在一起。",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "……總之，",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "「就是那麼一回事」吧。",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "唉……",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "……意思是",
    "voice": "vo_adv_1389003_078"
  },
  {
    "name": "格蕾斯",
    "words": "我也是個女人嗎。",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "……鎖鏈。",
    "voice": "vo_adv_1389003_079"
  },
  {
    "name": "格蕾斯",
    "words": "\\n消失了。",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "天曉得？",
    "voice": "vo_adv_1389003_080"
  },
  {
    "name": "格蕾斯",
    "words": "\\n它可能是定時制的吧。",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "而且──",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "橫刀奪愛這種事，",
    "voice": "vo_adv_1389003_081"
  },
  {
    "name": "格蕾斯",
    "words": "對菫過意不去。",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "我可不打算成為會搶別人布丁的幽靈。",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "謎團",
    "voice": "vo_adv_1389003_082"
  },
  {
    "name": "格蕾斯",
    "words": "不是很棒嗎。",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "\\n既神祕又美麗，",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "這是男生的憧憬吧？",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "總之，",
    "voice": "vo_adv_1389003_083"
  },
  {
    "name": "格蕾斯",
    "words": "謝謝你。",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "\\n多虧騎士氏的協助，才能成功消除鎖鏈，",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "\\n還度過了一段意外開心的時光。",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "就算鎖鏈消失了，",
    "voice": "vo_adv_1389003_084"
  },
  {
    "name": "格蕾斯",
    "words": "我們的緣分也依舊在，",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "\\n下次再一起玩吧。",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "跟騎士氏待在一起，",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "感覺也很開心。",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "……呵呵。",
    "voice": "vo_adv_1389003_085"
  },
  {
    "name": "格蕾斯",
    "words": "\\n騎士氏，",
    "voice": null
  },
  {
    "name": "格蕾斯",
    "words": "你果然是個很會泡妞的人呢。",
    "voice": null
  },
  {
    "name": "旁白",
    "words": "那之後，",
    "voice": null
  },
  {
    "name": "旁白",
    "words": "格蕾斯順利參加守護騎士的任命儀式。",
    "voice": null
  },
  {
    "name": "旁白",
    "words": "\\n正式恢復為薇歐莉特的守護騎士，",
    "voice": null
  },
  {
    "name": "旁白",
    "words": "\\n她的表現遠比之前來得更加出色。",
    "voice": null
  }
]