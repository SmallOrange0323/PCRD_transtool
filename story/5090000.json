  },
  {
    "type": "dialogue",
    "name": "保鑣",
    "words": "是這樣嗎？",
    "voice": "vo_adv_5090000_085",
    "unit_id": 8011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "就是這樣。",
