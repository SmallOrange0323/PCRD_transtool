  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "那邊那個小鬼……",
    "voice": "vo_adv_5090000_088",
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "\\n我記得，",
