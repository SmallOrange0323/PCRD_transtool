  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "雖然我聽不太懂……",
    "voice": "vo_adv_5090000_052",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n不過嘉夜小姐她們跟賭場之間，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "是不是",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "發生過什麼事呢……？　",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "……啊，",
    "voice": "vo_adv_5090000_053",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "已經這麼晚了，",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "我們差不多該去工作了。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……你們接下來要去打工吧。",
    "voice": "vo_adv_5090000_054",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n我覺得應該是不會有什麼問題啦……",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "但如果發生什麼事，",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "\\n要立即向我們的",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "手下求助喔！",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "嗯、",
    "voice": "vo_adv_5090000_055",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "嗯……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "謝謝妳……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "那我們走囉，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "祈梨、",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "嘉夜小姐……♪",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "嘿咻、",
    "voice": "vo_adv_5090000_056",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "嘿咻……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "……呼，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "地板",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "弄乾淨了……♪",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n掃除打工",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "出乎意料地有趣呢。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "接著",
    "voice": "vo_adv_5090000_057",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "去擦拭那座銅像吧。",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "……哎呀？",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "對面好像在吵什麼……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "混帳東西！",
    "voice": "vo_adv_5090000_058",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "怎麼可能有這種事！",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "\\n你們一定出老千啦！",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "經銷商",
    "words": "這位貴賓，",
    "voice": "vo_adv_5090000_059",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "經銷商",
    "words": "本賭場的賭博都是公正公開，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "經銷商",
    "words": "\\n絕對沒有任何造假。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "你閉嘴！",
    "voice": "vo_adv_5090000_060",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "\\n誰會相信你的鬼話啊！",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "\\n你以為我賭了幾百萬的盧幣！",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "那可是我全部的財產啊！",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "哎呀呀……",
    "voice": "vo_adv_5090000_061",
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "還真吵啊。",
    "voice": null,
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "你是……！？",
    "voice": "vo_adv_5090000_062",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "……那傢伙",
    "voice": "vo_adv_5090000_063",
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "祈梨",
    "words": "就是這間賭場的老闆吧。",
    "voice": null,
    "unit_id": 106611
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "沒錯。",
    "voice": "vo_adv_5090000_064",
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "【賭場王】……",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "吉諾。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "\\n",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "沒想到",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "嘉夜",
    "words": "他居然會親自出面處理爭執。",
    "voice": null,
    "unit_id": 106511
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "這位貴賓，",
    "voice": "vo_adv_5090000_065",
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "請問本賭場有什麼問題嗎？",
    "voice": null,
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "大有問題啦，混蛋！",
    "voice": "vo_adv_5090000_066",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "因為你們出老千，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "害我身無分文了！",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "\\n把錢還給我，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "混帳東西！",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "要是不還的話……！",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "哼哼哼。",
    "voice": "vo_adv_5090000_067",
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "氣勢不錯喔。",
    "voice": null,
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "\\n",
    "voice": null,
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "好吧，",
    "voice": null,
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "我就親自跟你比劃比劃。",
    "voice": null,
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "你這傢伙……！",
    "voice": "vo_adv_5090000_068",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "討厭，",
    "voice": "vo_adv_5090000_069",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "女性",
    "words": "要打架嗎……！？",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "各位貴賓",
    "voice": "vo_adv_5090000_070",
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "請不用擔心，",
    "voice": null,
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "這只是一場表演，",
    "voice": null,
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "\\n只是我的收藏品",
    "voice": null,
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "發表會而已。",
    "voice": null,
    "unit_id": 16011
  },
  {
    "type": "still",
    "still_id": "509000001"
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "現場的各位貴賓，你們運氣真好！",
    "voice": "vo_adv_5090000_071",
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "\\n因為你們即將目睹",
    "voice": null,
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "\\n全世界唯一一顆的寶石……",
    "voice": null,
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "「龍之卵」的能力！",
    "voice": null,
    "unit_id": 16011
  },
  {
    "type": "still",
    "still_id": "end"
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "那顆寶石……",
    "voice": "vo_adv_5090000_072",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "\\n雖然漂亮，",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "但給人一種奇怪的感覺……",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "你這混蛋！",
    "voice": "vo_adv_5090000_073",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "我管你是賭場王還是誰，",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "\\n不把錢還我，我就要揍飛你啦！",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "去死吧！",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "哼……",
    "voice": "vo_adv_5090000_074",
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "什麼！？",
    "voice": "vo_adv_5090000_075",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "發生了什麼事……！？",
    "voice": null,
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "這顆「龍之卵」有一個神奇的特性。",
    "voice": "vo_adv_5090000_076",
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "\\n它可以吸收所有的攻擊。",
    "voice": null,
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "然後，",
    "voice": "vo_adv_5090000_077",
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "還可以自由自在地！",
    "voice": null,
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "\\n施放吸收的能量！",
    "voice": null,
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "就像這樣！",
    "voice": null,
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "客人",
    "words": "咕啊啊啊啊！？",
    "voice": "vo_adv_5090000_078",
    "unit_id": 414
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "客人或許是神吧。",
    "voice": "vo_adv_5090000_079",
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "\\n",
    "voice": null,
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "但是！",
    "voice": null,
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "我可是比神更偉大的存在啊！",
    "voice": null,
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "\\n",
    "voice": null,
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "……喂，",
    "voice": null,
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "趕緊把這個昏過去的傢伙拖出去。",
    "voice": null,
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "手下",
    "words": "是。",
    "voice": "vo_adv_5090000_080",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "啊、",
    "voice": "vo_adv_5090000_081",
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "步未",
    "words": "啊哇哇……！？",
    "voice": null,
    "unit_id": 105511
  },
  {
    "type": "dialogue",
    "name": "保鑣",
    "words": "……真是的。",
    "voice": "vo_adv_5090000_082",
    "unit_id": 8011
  },
  {
    "type": "dialogue",
    "name": "保鑣",
    "words": "\\n你有必要",
    "voice": null,
    "unit_id": 8011
  },
  {
    "type": "dialogue",
    "name": "保鑣",
    "words": "特地使用珍藏的收藏品嗎？",
    "voice": null,
    "unit_id": 8011
  },
  {
    "type": "dialogue",
    "name": "保鑣",
    "words": "就算不用「龍之卵」，",
    "voice": "vo_adv_5090000_083",
    "unit_id": 8011
  },
  {
    "type": "dialogue",
    "name": "保鑣",
    "words": "\\n",
    "voice": null,
    "unit_id": 8011
  },
  {
    "type": "dialogue",
    "name": "保鑣",
    "words": "也可以交給警衛，",
    "voice": null,
    "unit_id": 8011
  },
  {
    "type": "dialogue",
    "name": "保鑣",
    "words": "或是用我的拳頭打倒他吧。",
    "voice": null,
    "unit_id": 8011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "哈，",
    "voice": "vo_adv_5090000_084",
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "這你就不懂了。",
    "voice": null,
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "\\n所謂的收藏家，",
    "voice": null,
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
