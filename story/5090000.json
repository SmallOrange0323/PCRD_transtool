    "name": "賭場王",
    "words": "\\n",
    "voice": null,
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
    "words": "就算是打工第一天，",
    "voice": null,
    "unit_id": 16011
  },
  {
    "type": "dialogue",
    "name": "賭場王",
