    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "其他新兵也跟上！",
    "voice": "vo_adv_5142001_070",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n第二排去掩護第一排的，避免讓他們",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "受到攻擊！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "新兵們",
    "words": "遵命！！",
    "voice": "vo_adv_5142001_071",
    "unit_id": null
  },
  {
