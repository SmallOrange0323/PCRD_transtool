    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "真是的，惠理子那傢伙……！",
    "voice": "vo_adv_5142001_063",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n居然惹出這種麻煩事！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "只好用武力阻止他們了！",
    "voice": "vo_adv_5142001_064",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n……",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "雖然很想這樣說，",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n但也不能讓新兵受傷……！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "想辦法",
    "voice": "vo_adv_5142001_065",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "是嗎……",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "真是強人所難。",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "不過……",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "的確不是沒有方法！",
    "voice": "vo_adv_5142001_066",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n看好了！！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "still",
    "still_id": "514200101"
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "喂！",
    "voice": "vo_adv_5142001_067",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "你們這些到處逃竄的新兵！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n接下來聽我的命令行動！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "所有人，",
    "voice": "vo_adv_5142001_068",
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "立刻把盾牌舉起來！",
    "voice": null,
    "unit_id": 129811
  },
  {
    "type": "dialogue",
    "name": "真琴",
    "words": "\\n包圍住失控的新兵們！",
    "voice": null,
    "unit_id": 129811
  },
