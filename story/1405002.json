  {
    "type": "background",
    "bg_id": "501720"
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "妳說誰在偷懶？",
    "voice": "vo_adv_1405002_010",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n我是在休息啦！",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "那烏爾姆妳自己呢？",
    "voice": "vo_adv_1405002_011",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n整理書房、",
