  {
    "type": "dialogue",
    "name": "旁白",
    "words": "自克蘿茜成為「背面世界的管理者」並消失蹤影後，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n已經過了好幾天。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "──天氣真好呢。",
