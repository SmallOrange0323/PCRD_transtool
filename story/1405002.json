    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "我會幫妳的，所以快點──",
    "voice": null,
    "unit_id": 127712
  },
  {
