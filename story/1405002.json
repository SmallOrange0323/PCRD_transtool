    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "畢竟你已經恢復精神了呢。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "那麼，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "等你吃完這個再說，好嗎？",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n來，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "啊──",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……那麼，",
    "voice": "vo_adv_1405002_030",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "味道怎麼樣？",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n今天也是吉歐‧提格尼亞風味喔。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……這樣啊。",
    "voice": "vo_adv_1405002_031",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "來，",
    "voice": "vo_adv_1405002_032",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "啊──",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "話說回來，",
    "voice": "vo_adv_1405002_033",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n從幫忙更衣到協助洗澡，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我都已經做了這麼多事，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "既然都這樣了，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "乾脆就讓我照顧到底不好嗎？",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "來吧，",
    "voice": "vo_adv_1405002_034",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "啊──",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "之後，\\n{0}接受了烏爾姆",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "充滿愛意（？）的款待，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n一直到",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "盤子空了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "background",
    "bg_id": "502960"
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "給你，",
    "voice": "vo_adv_1405002_035",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "這是飯後的稀有道具",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "「烏爾姆紅茶」。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n請品嚐看看。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我倒是",
    "voice": "vo_adv_1405002_036",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "又想喝騎士先生幫我泡的\\n超～苦澀的",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "紅茶了呢。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……我是說真的喔？",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "回想起那個味道，",
    "voice": "vo_adv_1405002_037",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "就會覺得",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "心裡暖暖的，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n也有點懷念呢。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我曾想過",
    "voice": "vo_adv_1405002_038",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "「這是為什麼呢」，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "但答案從以前就沒變過，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "一直都在我身邊。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "想替我發燙的額頭降溫的，",
    "voice": "vo_adv_1405002_039",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "老姊小小的手掌。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n還有把布丁餵到我嘴邊時，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "萊拉耶爾殿下的眼神。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我想著，",
    "voice": "vo_adv_1405002_040",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "「……啊啊，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "原來如此。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "原來我一直以來，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n都被傾注了這麼多",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "令人火燒心的",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "『甜』啊～」",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "直到最近，我才終於察覺到這一點呢。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "所以，",
    "voice": "vo_adv_1405002_041",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "創造出我「這裡」的，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n並不是創造我的那些傢伙。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "早在很久以前，",
    "voice": "vo_adv_1405002_042",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n那個空空如也的人偶，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "就已經被來自吉歐‧提格尼亞的",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n充滿甜蜜的愛意填滿了。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "或許我是個人偶。",
    "voice": "vo_adv_1405002_043",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "但是，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我並不是在「模仿人類」。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我",
    "voice": "vo_adv_1405002_044",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "有自己的心。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "就算他人說三道四，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "只要我是這麼認為的，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "那就不會錯。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……嘛，",
    "voice": "vo_adv_1405002_045",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我也是花了不少時間才能夠這麼想。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "而最後推了我一把的，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "居然是那個設計出我、",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "叫做「帆稀」的人，還真是讓人不爽呢。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "──所以，",
    "voice": "vo_adv_1405002_046",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我想，這次該換我",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "報恩了。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "即使回不到一無所知的時光，",
    "voice": "vo_adv_1405002_047",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n也依然能延續「一如往昔的日常」。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "大家都如此努力延續著「同樣的每一天」，",
    "voice": "vo_adv_1405002_048",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我也想試著",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "不再嫌麻煩，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "認真地生活看看。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……嘛，",
    "voice": "vo_adv_1405002_049",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "總之就是這樣。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "「今後",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "也請多多關照不成材的烏爾姆」，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "大概就是這種感覺吧。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "…………",
    "voice": "vo_adv_1405002_050",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "呀──！",
    "voice": "vo_adv_1405002_051",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "烏爾姆──！",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "\\n妳把",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "床單晾到哪裡去了──！？",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……啊，",
    "voice": "vo_adv_1405002_052",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "糟糕。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n被發現了。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "啊……",
    "voice": "vo_adv_1405002_053",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "因為今天沒風嘛，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n騎士先生不是坐飯糰",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "來這裡的嗎？",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我就去和飯糰交涉，",
    "voice": "vo_adv_1405002_054",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n以點心作為交換，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "讓牠在廣場上跑來跑去──",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "還在牠身上綁了床單。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "你看，",
    "voice": "vo_adv_1405002_055",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "這樣床單好像乾得比較快吧。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n而且要等到晚上",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "才能收床單，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "不覺得很煩嗎？",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "那樣很累人，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "而且我也想早點休息。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "是啊，",
    "voice": "vo_adv_1405002_056",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "所以，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我也很努力偷懶啊。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n話先說在前頭，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我也是不得已呢，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "不得已。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "果然，",
    "voice": "vo_adv_1405002_057",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "就跟我喜歡照顧騎士先生一樣──",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "我也很喜歡被老姊關心呢♪",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "烏～",
    "voice": "vo_adv_1405002_058",
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "爾～",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "琳德",
    "words": "姆～～～～！？",
    "voice": null,
    "unit_id": 127712
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "……啊，",
    "voice": "vo_adv_1405002_059",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "剛才說的要對老姊保密喔。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "她也差不多要進來了。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "那",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "麼──",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "騎士先生，",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "失禮了。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "窸窸窣窣……",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "那還用說嗎？",
    "voice": "vo_adv_1405002_060",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n當然是要躲起來啊。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "所以，",
    "voice": "vo_adv_1405002_061",
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "就麻煩你",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "應付老姊囉。",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "烏爾姆",
    "words": "\\n「主人」♪",
    "voice": null,
    "unit_id": 127812
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "幾秒後──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "琳德闖入了{0}的客房。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n而今天，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n也再次上演了",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "雙胞胎女僕「一如往昔的日常」。",
    "voice": null,
    "unit_id": null
  }
