[
  {
    "type": "background",
    "bg_id": "500783"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "霸瞳皇帝和誓約女君・克莉絲提娜兩人，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n正在展開一場炙熱的戰鬥。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "哈哈哈！",
    "voice": "vo_adv_2014008_000",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n愉快！　",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "真愉快呀！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "――……！",
    "voice": "vo_adv_2014008_001",
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這可真是令人愉快呀！",
    "voice": "vo_adv_2014008_002",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "啊啊！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n在更早一些",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "就這麼做不就得了嗎！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我能施展出絕對命中之斬擊！",
    "voice": "vo_adv_2014008_003",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n而同時你能預知之，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "再以最少的魔力採取防禦！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "互換立場也亦然！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "永遠觸不及對方的孤獨！",
    "voice": "vo_adv_2014008_004",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "只要瞬間的失誤就會崩壞，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "有如沙堡一般！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "啊啊，",
    "voice": "vo_adv_2014008_005",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "簡直就像舞蹈一般！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n真想如此這般一直跳下去啊！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "跳這場求愛與",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "相殺的圓舞曲呀！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "――……",
    "voice": "vo_adv_2014008_006",
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "這就是，",
    "voice": "vo_adv_2014008_007",
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "克莉絲提娜的――",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "『誓約女君』的全力。",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "儘管早已知悉，",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "但果然很棘手呢……",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "並且逃走了的{0}他們，",
    "voice": "vo_adv_2014008_008",
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n似乎也有想要做些什麼事的樣子。",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "可以的話得盡早，",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "給克莉絲提娜致命一擊才行呢……",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "還有思考的餘裕呢！",
    "voice": "vo_adv_2014008_009",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "陛下！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這可真令人受傷呀！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n如果要思考的話，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "希望你心中想的只有我一人啊！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "沒錯――",
    "voice": "vo_adv_2014008_010",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "再多看著我一點呀！　",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "恨我吧！　",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "愛我吧！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "從今以後每一日都互相殘殺吧！　",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "如同這般，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "每一日都相愛相殺吧！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n你不覺得這樣實在太美好了嗎！　",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不是嗎！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "霸瞳皇帝！！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "――",
    "voice": "vo_adv_2014008_011",
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "是呢。",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "那的確是……",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "一件相當美好之事吧。",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n對於如同妳這般，",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "必須得和他人交會才能得到快樂的人來說。",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "哦哦？",
    "voice": "vo_adv_2014008_012",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "哈哈哈，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "沒想到你竟然會回應我的追求呢――",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "但是呀――",
    "voice": "vo_adv_2014008_013",
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "『我』，",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "並不是那種人呢。",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "克莉絲提娜，",
    "voice": "vo_adv_2014008_014",
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "妳剛才這麼說了吧。",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n妳被我的美貌，",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "被才能，",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "被我這扭曲的靈魂給吸引了。",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n所以，",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "才會想與我一同。",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "說得沒錯！",
    "voice": "vo_adv_2014008_015",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n從各種角度來說，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "如同你一般優異的人類！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n擁有這種素養能夠讓我如此心儀的人類，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不論到哪都不存在呀！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "當然，",
    "voice": "vo_adv_2014008_016",
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "沒錯――",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "然而呀。",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n如此優異的『我』，",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "並不需要什麼友人。",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "『我』是……",
    "voice": "vo_adv_2014008_017",
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "為了成為『神』而被養大的。",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n神不論友人或是戀人，",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "妻子亦或丈夫都不需要。",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "所謂絕對之神，",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "不論何時",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "皆是孤高之物啊。",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "原來如此！",
    "voice": "vo_adv_2014008_018",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n由於你是那絕對之神的緣故，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我才會如此心儀於你――",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n而也就因為這個緣故，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "所以我也才會被你給甩了嗎！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "哈哈哈！",
    "voice": "vo_adv_2014008_019",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "哎呀真困擾，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這就是所謂的矛盾嗎！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "似乎是呢――",
    "voice": "vo_adv_2014008_020",
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "那麼，",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "能不能請妳放棄呢？",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不成，",
    "voice": "vo_adv_2014008_021",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不成不成！　",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "若如此――",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n我就靠蠻力硬是將你從絕對之神的位上給拉下！　",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "用我的刀刃和你相吻！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "而後除了再一次提出相同問題外別無他法啦！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "啊啊――",
    "voice": "vo_adv_2014008_022",
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "沒有比這還令人不愉快之事了呢！",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "那無法將事遂成之人的高談闊論！",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "movie",
    "movie_id": "201400801"
  },
  {
    "type": "background",
    "bg_id": "500783"
  },
  {
    "type": "dialogue",
    "name": "拉基拉基",
    "words": "……克莉絲提娜",
    "voice": "vo_adv_2014008_023",
    "unit_id": 107312
  },
  {
    "type": "dialogue",
    "name": "拉基拉基",
    "words": "那渾身的一擊……",
    "voice": null,
    "unit_id": 107312
  },
  {
    "type": "dialogue",
    "name": "拉基拉基",
    "words": "\\n即便如此，",
    "voice": null,
    "unit_id": 107312
  },
  {
    "type": "dialogue",
    "name": "拉基拉基",
    "words": "仍被擋下來了……！",
    "voice": null,
    "unit_id": 107312
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……似乎是這樣呢。",
    "voice": "vo_adv_2014008_024",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "然而……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "您怎麼了呢？　",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "陛下。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "做為防禦所使用的魔力，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "似乎比方才所使用的來得更多了唷？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "『霸瞳天星』的精準度，",
    "voice": "vo_adv_2014008_025",
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "正在下降……",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "不只是終端的魔物而已，",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n就連闇影們也被一一剔除的樣子呢……",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "看來是將此處的機關給看破的那似似花，",
    "voice": "vo_adv_2014008_026",
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n將這件事告訴那孩子了呢。",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "真是的，",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "太令人不悅了……！　",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "……給我從那兒讓開，",
    "voice": "vo_adv_2014008_027",
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "克莉絲提娜。",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "讓開？",
    "voice": "vo_adv_2014008_028",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "無聊的笑話就免了。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我可是被人拜託了",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n說要拖延你的腳步……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我可沒有要失約的打算。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "而且……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "更別說――",
    "voice": "vo_adv_2014008_029",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "要我從如此令人愉快的嬉戲，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "在中途退出豈有可能呀！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "拉基拉基",
    "words": "我們也是，",
    "voice": "vo_adv_2014008_030",
    "unit_id": 107312
  },
  {
    "type": "dialogue",
    "name": "拉基拉基",
    "words": "已經做好覺悟才會與你有所牽扯的。",
    "voice": null,
    "unit_id": 107312
  },
  {
    "type": "dialogue",
    "name": "拉基拉基",
    "words": "\\n",
    "voice": null,
    "unit_id": 107312
  },
  {
    "type": "dialogue",
    "name": "拉基拉基",
    "words": "如此一來，",
    "voice": null,
    "unit_id": 107312
  },
  {
    "type": "dialogue",
    "name": "拉基拉基",
    "words": "我們自然也得讓你付出相應的代價唷，",
    "voice": null,
    "unit_id": 107312
  },
  {
    "type": "dialogue",
    "name": "拉基拉基",
    "words": "霸瞳皇帝。",
    "voice": null,
    "unit_id": 107312
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "真是夠了，",
    "voice": "vo_adv_2014008_031",
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "你們一個又一個……",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "可真是一群令人無言以對的人呢。",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "啊啊，",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我明白了……",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "那麼我這兒，",
    "voice": "vo_adv_2014008_032",
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "也就跟著換一副手牌來打吧。",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "\\n",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "儘管……",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "霸瞳皇帝",
    "words": "我也是千百個不願意。",
    "voice": null,
    "unit_id": 106914
  },
  {
    "type": "dialogue",
    "name": "拉基拉基",
    "words": "克莉絲提娜……",
    "voice": "vo_adv_2014008_033",
    "unit_id": 107312
  },
  {
    "type": "dialogue",
    "name": "拉基拉基",
    "words": "小心一點。",
    "voice": null,
    "unit_id": 107312
  },
  {
    "type": "dialogue",
    "name": "拉基拉基",
    "words": "\\n她的氛圍變了。",
    "voice": null,
    "unit_id": 107312
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "似乎是呢――",
    "voice": "vo_adv_2014008_034",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不過嘛，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "怎樣都行。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n只要他能繼續陪我玩下去就行。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "來吧，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "就讓我們繼續把這場舞跳下去吧，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "陛下！",
    "voice": null,
    "unit_id": 107111
  }
]
