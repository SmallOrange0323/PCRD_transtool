    "name": "克莉絲提娜",
    "words": "……",
    "voice": "vo_adv_1071008_091",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "什麼？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n要不要你教我一點訣竅，",
