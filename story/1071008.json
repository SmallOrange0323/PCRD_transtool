[
  {
    "type": "background",
    "bg_id": "500111"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "順利躲過中止危機的結婚生活模擬演習，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n在那之後也很順利地繼續著。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "表面上看似如此──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……不對勁。",
    "voice": "vo_adv_1071008_000",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "為什麼到了這時間還不回來？",
    "voice": "vo_adv_1071008_001",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n他的工作應該早就已經做完了才對。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "最近幾天",
    "voice": "vo_adv_1071008_002",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "都這樣。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n就算問他原因，他也會很明顯地轉移話題……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……",
    "voice": "vo_adv_1071008_003",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "該不會……？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "可是，",
    "voice": "vo_adv_1071008_004",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "小子他不可能……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……不，正因為是小子，",
    "voice": "vo_adv_1071008_005",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "所以有可能嗎──",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "…………",
    "voice": "vo_adv_1071008_006",
    "unit_id": 107111
  },
  {
    "type": "background",
    "bg_id": "500131"
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "抱歉突然問個怪問題，",
    "voice": "vo_adv_1071008_007",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "你有看到一個穿披風的暖男嗎？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n他應該是走這條路回家的。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "穿披風的暖男？",
    "voice": "vo_adv_1071008_008",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "穿披風的暖男……",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……呵。",
    "voice": "vo_adv_1071008_009",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n雖然是自己的行為，但還是忍不住讓我露出苦笑。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "沒想到被稱為狂犬的女豪傑克莉絲提娜，",
    "voice": "vo_adv_1071008_010",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n竟然會因為嫉妒這種動機，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "跑來四處打聽老公的下落……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "啊啊，",
    "voice": "vo_adv_1071008_011",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "這麼說來我是有看到！",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "\\n他往那邊的方向走了。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "他是一個人嗎？",
    "voice": "vo_adv_1071008_012",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "不。",
    "voice": "vo_adv_1071008_013",
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "男性",
    "words": "不是一個人。",
    "voice": null,
    "unit_id": 4911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……",
    "voice": "vo_adv_1071008_014",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "是嗎。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n感謝",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "你的情報。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "background",
    "bg_id": "500400"
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "在這邊嗎……？",
    "voice": "vo_adv_1071008_015",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n竟然跑到這種沒有人煙的地方，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "小子",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "究竟是打算和誰做什……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "你這混帳，",
    "voice": "vo_adv_1071008_016",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "再不老實招來，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "小心吃上苦頭！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "\\n克莉絲提娜到底在哪！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……嗯？",
    "voice": "vo_adv_1071008_017",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "別給我裝傻！",
    "voice": "vo_adv_1071008_018",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "\\n我們早就掌握到情報，她現在跟你這混帳住在一起！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒3",
    "words": "都怪那傢伙突然間不見蹤影，",
    "voice": "vo_adv_1071008_019",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "暴徒3",
    "words": "\\n你瞧，",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "暴徒3",
    "words": "想和她打招呼的客人都像這樣大排長龍啦。",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "你肯定也感到很困擾吧？",
    "voice": "vo_adv_1071008_020",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "\\n連續好幾天都有像我們這樣",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "長得凶神惡煞的傢伙跑到職場來。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "你要天天",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "成功把我們全甩掉才回家，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "也是很費心思吧。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "…………！　",
    "voice": "vo_adv_1071008_021",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "我也覺得不太好意思啊？",
    "voice": "vo_adv_1071008_022",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "可",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "是哪，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "追根究柢，就要怪那傢伙先前把我們痛扁一頓。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "\\n這可是克莉絲提娜播下的禍種。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "你就告訴我們",
    "voice": "vo_adv_1071008_023",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "那傢伙在哪吧。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "好不好？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "原來是這麼一回事嗎……",
    "voice": "vo_adv_1071008_024",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "你這混帳家伙──",
    "voice": "vo_adv_1071008_025",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "\\n我們不過是好聲好氣了點，你就囂張起來啦！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "\\n如果硬是不肯說，",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "就只好讓你嚐嚐苦頭！",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "給我慢著……！",
    "voice": "vo_adv_1071008_026",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "你們這些傢伙是什麼意思？",
    "voice": "vo_adv_1071008_027",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "竟然想瞞著我偷偷和小子加深感情哪。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n真令我感到嫉妒啊。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "暴徒們",
    "words": "──是克莉絲提娜！",
    "voice": "vo_adv_1071008_028",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "你們很想見我啊？",
    "voice": "vo_adv_1071008_029",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n那還真是抱歉哪，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "一直放著你們不管。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "就坦白告訴你們吧，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我現在已經是人妻了。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "所以你們對我這些日積月累的感情，",
    "voice": "vo_adv_1071008_030",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我要全數斬斷，扔到一旁去。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n──好啦，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "放馬過來！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "……妳總算現身啦？",
    "voice": "vo_adv_1071008_031",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "小子──！",
    "voice": "vo_adv_1071008_032",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "你們幾個打算做什麼？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "你們的目標是我才對吧。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "沒錯，妳確實是我們的目標。",
    "voice": "vo_adv_1071008_033",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "不過如果我們直接和妳打，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "可說是幾乎不可能打贏。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "照目前的狀況看來，",
    "voice": "vo_adv_1071008_034",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "你們應該是結婚了吧……？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "竟然願意為了保護妻子，而親自涉險，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "\\n妳還真是找到了一個好老公啊，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "克莉絲提娜。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "只不過，",
    "voice": "vo_adv_1071008_035",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "抱歉啦，就讓我好好利用他一下。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "\\n",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "這傢伙",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "現在起就是負責擋下妳攻擊的盾牌了♪",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "…………唔！",
    "voice": "vo_adv_1071008_036",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "哇～哈哈哈！",
    "voice": "vo_adv_1071008_037",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "\\n看到沒？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "欸，你們看到沒？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "\\n這還是我第一次見到",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "克莉絲提娜露出動搖的表情啊～！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……現在要讓小子有機會逃走，",
    "voice": "vo_adv_1071008_038",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "再把這些傢伙教訓一頓，對我來說可謂簡單至極。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n用不到幾秒就能解決。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "但是……",
    "voice": "vo_adv_1071008_039",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "問題並不在那裡。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "而是在於小子",
    "voice": "vo_adv_1071008_040",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "他想要保護我這點上。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "──確實，",
    "voice": "vo_adv_1071008_041",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n我已經決定無論發生什麼事，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "都要與小子同進退。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "然而我當初，",
    "voice": "vo_adv_1071008_042",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "是否有料想到小子竟會為了我劍下產生的恩怨，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n而選擇自己將性命，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "暴露在危險之下的情況……？　",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "…………",
    "voice": "vo_adv_1071008_043",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "自己積下的恩怨要自己清算，",
    "voice": "vo_adv_1071008_044",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "你別出手……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n就算我這麼說，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "那傢伙恐怕也不會乖乖聽話吧。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "如果有危險要逼近我，",
    "voice": "vo_adv_1071008_045",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n他就會打算先用自己那纖細的手將其擋掉。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "他就是那樣的男人……",
    "voice": "vo_adv_1071008_046",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "…………",
    "voice": "vo_adv_1071008_047",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "暴徒3",
    "words": "嘿嘿嘿！",
    "voice": "vo_adv_1071008_048",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "暴徒3",
    "words": "\\n瞧妳這傷腦筋的模樣。",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "暴徒3",
    "words": "\\n誰叫蘭德索爾最凶猛的狂犬，",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "暴徒3",
    "words": "竟然選擇結婚了呢～",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "果然，",
    "voice": "vo_adv_1071008_049",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我和小子的人生無法有所交會。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "是不該有",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "交會的──",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……嗯？",
    "voice": "vo_adv_1071008_050",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "小子他正在……",
    "voice": "vo_adv_1071008_051",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "向我傳達什麼？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "交給我吧……",
    "voice": "vo_adv_1071008_052",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n我會閃過攻擊的……？　",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "小子……！",
    "voice": "vo_adv_1071008_053",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n你該不會……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "打算在最後一刻閃過我的攻勢，",
    "voice": "vo_adv_1071008_054",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n然後讓攻擊打中在背後的流氓們吧……！　",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "不，",
    "voice": "vo_adv_1071008_055",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這狀況我一個人就足以解決。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n而且說到底，這是我得自己收拾的問題。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n你沒有必要再繼續擋在我──",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……什麼？",
    "voice": "vo_adv_1071008_056",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "希望我能交給你？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n頭……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "髮……？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n就像弄乾",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "頭髮時那樣……？　",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "喂，小子。",
    "voice": "vo_adv_1071008_057",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "雖然你說得好像很簡單，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n但你明白要躲過我的攻擊，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "是件多困難的事嗎？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n這道理可和弄乾頭髮不同──",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……",
    "voice": "vo_adv_1071008_058",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "什麼？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "因為想和我……",
    "voice": "vo_adv_1071008_059",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "一起跨越這道難關……？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……",
    "voice": "vo_adv_1071008_060",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "小子……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……重要的並非",
    "voice": "vo_adv_1071008_061",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "事務的大小……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n而是願意彼此託付這點……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這樣才是",
    "voice": "vo_adv_1071008_062",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "所謂的攜手共進退……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n道理是……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "相同的……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "…………！",
    "voice": "vo_adv_1071008_063",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "喂，",
    "voice": "vo_adv_1071008_064",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "你們在那邊磨磨蹭蹭地說些什麼！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "\\n如果不打算抵抗，",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "我可就要出手──",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "─",
    "voice": "vo_adv_1071008_065",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "─好。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n小子，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "就託付給你了。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "哈哈哈☆",
    "voice": "vo_adv_1071008_066",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n手下留情？",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這話是在對誰說呢。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我要上了，小子！",
    "voice": "vo_adv_1071008_067",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n可別死囉──☆",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "「極值聖域」！",
    "voice": "vo_adv_1071008_068",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "嗚哇啊啊啊，",
    "voice": "vo_adv_1071008_069",
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "那傢伙",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "正面攻過來了！？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒２",
    "words": "\\n她打算連自己的老公一起殺掉嗎！？",
    "voice": null,
    "unit_id": 811
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "別退縮！",
    "voice": "vo_adv_1071008_070",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "\\n那傢伙的攻擊是絕對不會打偏的。",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "就把她老公當成盾牌──",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "──啊啊！！？？",
    "voice": "vo_adv_1071008_071",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "\\n這傢伙……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "竟然閃過了克莉絲提娜的攻擊！？",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "怎麼可能──",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒們",
    "words": "唔啊啊啊啊啊啊啊────！",
    "voice": "vo_adv_1071008_072",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "你們太小看夫婦間的羈絆了♪",
    "voice": "vo_adv_1071008_073",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "好啦，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "剩下的傢伙也放馬過來吧！",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "我就讓你們用身體好好記住，",
    "voice": "vo_adv_1071008_074",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n對克莉絲提娜的老公出手是什麼下場☆",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "暴徒3",
    "words": "唔啊啊！？",
    "voice": "vo_adv_1071008_075",
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "暴徒3",
    "words": "\\n這次……",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "暴徒3",
    "words": "她連劍都沒揮，卻出現了劍的攻擊軌跡！？",
    "voice": null,
    "unit_id": 6311
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "「演算劍桌」！",
    "voice": "vo_adv_1071008_076",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "暴徒們",
    "words": "呃啊啊啊啊啊──！！",
    "voice": "vo_adv_1071008_077",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "不行，",
    "voice": "vo_adv_1071008_078",
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "這下要收到找她碴的一萬倍回禮了……",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "跟平時是相同的發展！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒１",
    "words": "\\n快逃啊──！",
    "voice": null,
    "unit_id": 911
  },
  {
    "type": "dialogue",
    "name": "暴徒們",
    "words": "唔哇啊啊啊啊──！",
    "voice": "vo_adv_1071008_079",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……哼。",
    "voice": "vo_adv_1071008_080",
    "unit_id": 107111
  },
  {
    "type": "background",
    "bg_id": "500400"
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "…………",
    "voice": "vo_adv_1071008_081",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "小子。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "你不要搶走我要說的台詞啊。",
    "voice": "vo_adv_1071008_082",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……呵呵♪",
    "voice": "vo_adv_1071008_083",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "確實……",
    "voice": "vo_adv_1071008_084",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n和他人一起攜手生活，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "實在是件很煩人的事。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n相較之下，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "一個人獨自解決問題要快得多了。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "──只不過，",
    "voice": "vo_adv_1071008_085",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n看來有些景色……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "似乎只有一起跨越難關後才能看到呢。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "這片從「結婚」陣營中心才能看見的風景……",
    "voice": "vo_adv_1071008_086",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "雖然現在我們倆，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "只能窺見其一角……",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "但光是明白世上有這樣的景色，",
    "voice": "vo_adv_1071008_087",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n這場模擬演習就已經可以說是",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "很有收穫了♪　",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "──好。",
    "voice": "vo_adv_1071008_088",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n我們回去吧，",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "小子☆",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "background",
    "bg_id": "500113"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "當天晚上──",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "…………",
    "voice": "vo_adv_1071008_089",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "嗯。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "麻煩了。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "要確實弄乾喔。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "……這麼說來，",
    "voice": "vo_adv_1071008_090",
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "育幼院的大家",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "明天就會回來了呢。",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "\\n看來模擬演習",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "也只能到今天",
    "voice": null,
    "unit_id": 107111
  },
  {
    "type": "dialogue",
    "name": "克莉絲提娜",
    "words": "為止了。",
    "voice": null,
    "unit_id": 107111
  },
  {
