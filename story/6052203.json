  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "摩拉牠",
    "voice": "vo_adv_6052203_000",
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "是為了拯救這座城鎮",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "才從魔法國度來的吧？",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "\\n",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "明明身型那麼嬌小，",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "想想還真厲害耶……",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "嗯，",
    "voice": "vo_adv_6052203_001",
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "像牠圓圓的大眼睛、",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "\\n靜不下來的小動作，",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "怎麼看都看不膩。",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "\\n",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "魔法少女吉祥物果然就是要這樣才行。",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "唔……",
    "voice": "vo_adv_6052203_002",
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "果然是這樣嗎……",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "不是，",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "因為我沒摸過……",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "\\n",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "你想嘛，",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "跟牠說「讓我摸」",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "感覺有點不好意思。",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "\\n",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "咦？",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "你要幫我去說嗎？",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "那……",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "就拜託你囉。",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "嗯，",
    "voice": "vo_adv_6052203_003",
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "畢竟牠是自己來的，",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "\\n",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "搞不好牠其實是魔法國度裡的菁英分子呢。",
    "voice": null,
    "unit_id": 114311
  },
  {
    "type": "dialogue",
    "name": "Shiny★智",
    "words": "\\n感覺摩拉身上還充滿著許多的謎團啊。",
    "voice": null,
    "unit_id": 114311
  }
]
