    "words": "應該就能讓那些樹別再搖了吧！",
    "voice": null,
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那個……",
    "voice": "vo_adv_1081004_026",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "他說『交給我吧，",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我馬上就叫他們住手』。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "真的嗎！？　",
    "voice": "vo_adv_1081004_027",
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "那就",
    "voice": null,
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "麻煩你了！　",
    "voice": null,
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "摸摸摸……",
    "voice": null,
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "哇――！　",
    "voice": "vo_adv_1081004_028",
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "骷髏頭先生好厲害～！",
    "voice": null,
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "\\n真的很謝謝你～！！",
    "voice": null,
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "小朋友",
    "voice": "vo_adv_1081004_029",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "都走掉了呢。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "呵呵，",
    "voice": "vo_adv_1081004_030",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "非常謝謝",
