    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "『時代終於追上我的腳步了！』",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n他是這麼說的！",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
