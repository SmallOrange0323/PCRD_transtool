  {
    "type": "dialogue",
    "name": "旁白",
    "words": "持續到早上的萬聖節舞會結束了，\\n跳了整晚的幽靈們都回去之後――",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "好了，",
    "voice": "vo_adv_1081004_000",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "接著要來收拾呢……",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "雖然只差一點就完成，",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "很想努力做完……",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "但有點……",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不對，",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "是非常……",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "想睡覺……",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "嗯……",
    "voice": "vo_adv_1081004_001",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "這個是",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "什麼光呢？",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "感覺",
    "voice": "vo_adv_1081004_002",
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "特別的刺眼……",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "呀啊！",
    "voice": null,
    "unit_id": 108111
  },
  {
    "type": "still",
    "still_id": "108100401"
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "『不給糖就搗蛋！』聽到這麼說就要接",
    "voice": "vo_adv_1081004_003",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n『萬聖節快樂！』",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "……這樣嗎？",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "然後",
    "voice": "vo_adv_1081004_004",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "還要給糖果……",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "嗎？",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "我知道了。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n我可以的，",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "並沒有在勉強自己。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "難得{0}約我參加\\n萬聖節活動，",
    "voice": "vo_adv_1081004_005",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "所以我也想知道要如何享受這節日……",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "只是很擔心",
    "voice": "vo_adv_1081004_006",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "自己能不能做好……",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "但我會努力的。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "姐姐，",
    "voice": "vo_adv_1081004_007",
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "不給糖就搗蛋唷！",
    "voice": null,
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "馬上就來了呢……",
    "voice": "vo_adv_1081004_008",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "雖、",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "雖然有點害羞……",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那個，",
    "voice": "vo_adv_1081004_009",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "萬聖節……",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "快樂。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n來，",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "給你糖果。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "太好了！　",
    "voice": "vo_adv_1081004_010",
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "謝謝。",
    "voice": null,
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "\\n也謝謝骷髏頭先生！",
    "voice": null,
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那個。",
    "voice": "vo_adv_1081004_011",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不、",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "不客氣……",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n爸爸，",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "你被小朋友摸了呢。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "不給糖就搗蛋！",
    "voice": "vo_adv_1081004_012",
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "啊……",
    "voice": "vo_adv_1081004_013",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "萬、",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "萬聖節快樂。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "哇！　",
    "voice": "vo_adv_1081004_014",
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "謝謝。",
    "voice": null,
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "\\n姐姐，",
    "voice": null,
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "我可以摸一下這個骷髏頭嗎？",
    "voice": null,
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "咦？　",
    "voice": "vo_adv_1081004_015",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "嗯，",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "好喔。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "哇啊♪　",
    "voice": "vo_adv_1081004_016",
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "哈哈哈，",
    "voice": null,
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "滑滑的～！",
    "voice": null,
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "\\n謝謝！",
    "voice": null,
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "……嘻嘻。",
    "voice": "vo_adv_1081004_017",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n這樣感覺還不錯呢。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "有種",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "幸福的感覺。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "而且，",
    "voice": "vo_adv_1081004_018",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
