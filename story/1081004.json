    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "哇。",
    "voice": "vo_adv_1081004_019",
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "怎麼了，",
    "voice": null,
    "unit_id": 131
  },
  {
    "type": "dialogue",
    "name": "男子",
    "words": "樹木突然搖晃了起來……",
