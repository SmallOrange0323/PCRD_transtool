  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "呵呵，",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "或許呢。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n是說，",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "爸爸很受歡迎呢。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "是這樣嗎……",
    "voice": "vo_adv_1081004_032",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "看來爸爸",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
