    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "可是沒有風吹過來耶？",
    "voice": null,
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "\\n為什麼！？",
    "voice": null,
    "unit_id": 231
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "…………",
    "voice": "vo_adv_1081004_021",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "呵呵。",
    "voice": "vo_adv_1081004_022",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "那是",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "幽靈們的惡作劇吧。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n應該是因為看到萬聖節的活動感覺很有趣，所以才聚集過來。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "雖然沒辦法發糖果給小朋友，",
    "voice": "vo_adv_1081004_023",
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "\\n不過，各位也一起來",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "忍",
    "words": "「萬聖節快樂」。",
    "voice": null,
    "unit_id": 103131
  },
  {
    "type": "dialogue",
    "name": "女子",
    "words": "姐姐，",
