    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "你的夥伴，",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n遭到只有七冠或公主騎士才能使用的力量襲擊，",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "你會怎麼想？",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "你不會想",
