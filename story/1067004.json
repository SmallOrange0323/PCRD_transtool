    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "不過，",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "萬一……",
