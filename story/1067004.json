  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "我希望大家，",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n可以公平地盡情遊玩阿斯特朗這款遊戲。",
    "voice": null,
    "unit_id": 106731
  },
  {
    "type": "dialogue",
    "name": "帆稀",
    "words": "\\n哪怕對戰對手是開發者也是一樣。",
