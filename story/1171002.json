[
  {
    "type": "background",
    "bg_id": "500160"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "為了租一間理想中的海濱小屋，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n靜流與{0}來到了海邊。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n兩人看見了廉價出租房屋的廣告，於是決定租下它。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "找到了廉價物件是很好，",
    "voice": "vo_adv_1171002_000",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "……可是，真是傷腦筋。",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "能用來租房的資金不太夠呢。",
    "voice": "vo_adv_1171002_001",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n因為距離我實際規劃的",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "租房日期還有一段時間……",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "但是，",
    "voice": "vo_adv_1171002_002",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "如此實惠的物件，",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n如果現在不租，",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "一定",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "馬上就會被搶走吧。",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "真想趁現在快點簽約啊……",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "咦？",
    "voice": "vo_adv_1171002_003",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n在這裡？",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "原來如此……",
    "voice": "vo_adv_1171002_004",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "有很多人會來海邊玩，",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n或許能一口氣賺上不少……！",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "真不愧是弟弟！",
    "voice": "vo_adv_1171002_005",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "既然如此，",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "得回街上準備器具呢！",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我們快走吧，",
    "voice": "vo_adv_1171002_006",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "弟弟！",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "background",
    "bg_id": "500690"
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "可麗餅店",
    "voice": "vo_adv_1171002_007",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "拉比林斯，",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "移動分店！",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n開幕囉♪",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "……雖然",
    "voice": "vo_adv_1171002_008",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "像這樣氣勢十足地開幕了。",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "但是沒什麼客人呢……",
    "voice": "vo_adv_1171002_009",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "也是啦，",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "在蘭德索爾那邊也總是門可羅雀，",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "看來就算換了地點",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "生意也不會突然變好呢。",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "環顧四周，",
    "voice": "vo_adv_1171002_010",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "競爭攤販也有不少。",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "刨冰和熱帶果汁、",
    "voice": "vo_adv_1171002_011",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n章魚燒和炒麵、",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n冰淇淋和……",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "還有鯛魚燒啊。",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "感覺客人全被吸走了呢。",
    "voice": "vo_adv_1171002_012",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n畢竟我們的可麗餅",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "無論是味道還是外觀都很普通……",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "{0}！？",
    "voice": "vo_adv_1171002_013",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n你說找客人……",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "是要幫我招攬客人嗎！？",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "謝謝……！",
    "voice": "vo_adv_1171002_014",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n竟然為了姐姐做到這種程度，",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n我真是一個",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "擁有好弟弟的幸福姐姐～～～！",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "……但是，",
    "voice": "vo_adv_1171002_015",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "沒問題嗎？",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n你能自己去",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "招攬客人嗎？",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "沒有姐姐陪著沒關係嗎？",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "啊，",
    "voice": "vo_adv_1171002_016",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "姐姐要是陪著你去",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "就沒人顧店了呢。",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "但是、",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "但是……！",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "那至少，",
    "voice": "vo_adv_1171002_017",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "要待在我看得見的範圍內喔！",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n一定要喔！",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "和姐姐約定好囉～～～！",
    "voice": "vo_adv_1171002_018",
    "unit_id": 117111
  },
  {
    "type": "background",
    "bg_id": "500160"
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "嗯？",
    "voice": "vo_adv_1171002_019",
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "什麼事？",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "可麗餅？",
    "voice": "vo_adv_1171002_020",
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "喔喔，",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "那邊那個攤位啊。",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "\\n",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "不，",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "但我現在不是吃東西的時候……",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "我不小心把錢包弄丟了。",
    "voice": "vo_adv_1171002_021",
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "\\n我這樣子根本什麼也買不了。",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "什麼？",
    "voice": "vo_adv_1171002_022",
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "你願意幫我一起找嗎？",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "\\n真是幫大忙了……",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "真的可以嗎？",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "\\n",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "我連掉在哪裡都不清楚……",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "嗯，",
    "voice": "vo_adv_1171002_023",
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "知道了。",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "\\n那如果找到了錢包，",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "我一定會去買可麗餅。",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "background",
    "bg_id": "500690"
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "……",
    "voice": "vo_adv_1171002_024",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "{0}",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "在做什麼啊？",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n看起來像是在海灘上來回繞著……",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "八成",
    "voice": "vo_adv_1171002_025",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "是有人掉了什麼東西，",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n然後弟弟就說要和他",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "一起找之類的吧。",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "但是像弟弟那樣",
    "voice": "vo_adv_1171002_026",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "在這麼寬廣的沙灘上找東西，",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n根本就是大海撈針嘛。",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "……唔唔，",
    "voice": "vo_adv_1171002_027",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "弟弟沒問題吧？",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我知道我必須顧店……",
    "voice": "vo_adv_1171002_028",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "雖然",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "知道……！",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "只是默默地看著不幫忙就稱不上是姐姐了嘛！",
    "voice": "vo_adv_1171002_029",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "弟弟！",
    "voice": "vo_adv_1171002_030",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n姐姐也來幫你────！",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "謝謝你幫我找到錢包。",
    "voice": "vo_adv_1171002_031",
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "\\n請給我1份……",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "不，",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "男性客人",
    "words": "3份可麗餅！",
    "voice": null,
    "unit_id": 312
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "謝謝惠顧～♪",
    "voice": "vo_adv_1171002_032",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 117111
  },
  {
