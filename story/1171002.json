    "words": "我和弟弟",
    "voice": "vo_adv_1171002_070",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "可不只是姐弟而已唷！",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我們有深～厚的羈絆聯繫著彼此，",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "是命中註定的一對！",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我們兩個之間，",
    "voice": "vo_adv_1171002_071",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "是容不下任何人的！",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "什、",
    "voice": "vo_adv_1171002_072",
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "什麼啦，",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "幹嘛放閃給我看……！",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "呵呵，",
    "voice": "vo_adv_1171002_073",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "弟弟～♪",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "算、",
    "voice": "vo_adv_1171002_074",
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "算了啦！",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "\\n我去找別的男人就是了！",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "女顧客",
    "words": "找個比他更好的男人！",
    "voice": null,
    "unit_id": 1212
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "呵呵……",
    "voice": "vo_adv_1171002_075",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n這世界上不可能有比",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "{0}更好的男人了。",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "謝謝你選擇了姐姐唷，",
    "voice": "vo_adv_1171002_076",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "弟弟。",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "但是，",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "弟弟長得這麼帥，",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n這之後一定還是會",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "被各種女孩子搭話……",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "我想到了！",
    "voice": "vo_adv_1171002_077",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n那麼姐姐",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "就稍微和你一起繞繞吧！",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "像這樣讓周圍的人",
    "voice": "vo_adv_1171002_078",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "看見我們相親相愛的樣子，",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n就不會有人",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "想來搭訕了吧♪",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "欸嘿嘿……",
    "voice": "vo_adv_1171002_079",
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "好啦弟弟，",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "再貼近一點嘛♪",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "\\n",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "靜流",
    "words": "向大家炫耀我們姐弟深～厚的羈絆吧♪",
    "voice": null,
    "unit_id": 117111
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "就這樣，靜流向周遭的人",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n宣示著她和{0}之間的好感情。",
    "voice": null,
