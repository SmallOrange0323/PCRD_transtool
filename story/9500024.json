    "unit_id": 104441
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104441
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "想必你也只是",
    "voice": null,
    "unit_id": 104441
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "想要盡到眷屬的職責，是吧。",
    "voice": null,
    "unit_id": 104441
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身是活過漫長歲月的吸血鬼。",
    "voice": "vo_adv_9500024_002",
    "unit_id": 104441
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "而你是吾之眷屬……",
    "voice": null,
    "unit_id": 104441
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n",
    "voice": null,
    "unit_id": 104441
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "既然如此，",
    "voice": null,
    "unit_id": 104441
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "妾身完全無法接受",
    "voice": null,
    "unit_id": 104441
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "你在這種地方徹底腐朽。",
    "voice": null,
    "unit_id": 104441
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n讓咱們共同跨越這場戰鬥，",
    "voice": null,
    "unit_id": 104441
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "將妾身的傳說化為永恆──",
    "voice": null,
    "unit_id": 104441
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "嗯？",
    "voice": "vo_adv_9500024_003",
    "unit_id": 104441
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "竟敢頂嘴，",
    "voice": null,
    "unit_id": 104441
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "真是不知好歹。",
