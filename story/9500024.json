  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "這是理所當然的吧。",
    "voice": null,
    "unit_id": 104441
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "\\n妾身",
    "voice": null,
    "unit_id": 104441
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
    "words": "早在很久以前，",
    "voice": null,
    "unit_id": 104441
  },
  {
    "type": "dialogue",
    "name": "伊莉亞",
