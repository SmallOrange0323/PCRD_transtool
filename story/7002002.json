    "type": "dialogue",
    "name": "依里",
    "words": "才、",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "才不是呢！！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n我",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "才沒有那麼想呢！！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "你、",
    "voice": "vo_adv_7002002_007",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "你想和誰一起去哪裡",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "是你的自由！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "\\n我",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "也沒有對你說三道四的權利！！",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "咦～？　",
    "voice": "vo_adv_7002002_008",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "雖然可能沒有權利，",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n但是傳達自己的心意",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "是個人的自由對吧？",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "唔唔～",
    "voice": "vo_adv_7002002_009",
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "剛才還真是可惜啊～！",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "不過，",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "比之前更有進展了呢！",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "按這個步調繼續下去……",
