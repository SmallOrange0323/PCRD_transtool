    "type": "dialogue",
    "name": "茜里",
    "words": "\\n",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "要是能先和我們說一聲就好了！　",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "茜里",
    "words": "這樣。",
    "voice": null,
    "unit_id": 100611
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "是啊……",
    "voice": "vo_adv_7002002_006",
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "哎、",
    "voice": null,
    "unit_id": 102211
  },
  {
    "type": "dialogue",
    "name": "依里",
    "words": "咦！？　",
    "voice": null,
    "unit_id": 102211
