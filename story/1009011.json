  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "自從典禮上發生的事件以來，修特帕魯的煩惱增加了。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n結果，她始終提不起勁，「冥風戰記」的寫作遲遲沒有進展。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "唔唔……",
    "voice": "vo_adv_1009011_000",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "完全寫不下去，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "就忍不住跑到外面來了……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "最近",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "真的很和平呢……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "典禮之後，",
    "voice": "vo_adv_1009011_001",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "感覺【暮光流星群】的壞名聲",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "也稍微減少了。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "是當時的那些貴族們",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "幫忙澄清了那些不好的傳言嗎？",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "英雄閣下、",
    "voice": "vo_adv_1009011_002",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "嗎……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "世人果然還是",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "比較喜歡",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "那樣賢淑端莊的我吧。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "既然如此，",
    "voice": "vo_adv_1009011_003",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "作為獎金獵人、",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "作為「冥風戰記」的作者，\\n這個名為疾風之冥姬的我，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "真的",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "是被人需要的嗎……？",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "唔，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "不行不行，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我到底在想些什麼啊……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我上次寫的，描述與永劫魔幻龍戰鬥的",
    "voice": "vo_adv_1009011_004",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n「冥風戰記」的新篇章也差不多",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "要發售了吧……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "好，",
    "voice": "vo_adv_1009011_005",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "稍微",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "去店裡看一下吧。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "況且我也很在意",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "銷量如何……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "background",
    "bg_id": "500370"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "修特帕魯來到了有販售「冥風戰記」的店裡。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "很好，",
    "voice": "vo_adv_1009011_006",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "在這裡應該能低調地",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "觀察情況……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "那麼，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "書是不是已經上架了呢……？",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "呀啊！",
    "voice": "vo_adv_1009011_007",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "呃，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "吉格魯特！？",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n你、",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "你怎麼會在這裡……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "你來買東西？",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "說、",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "說得也是……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我、",
    "voice": "vo_adv_1009011_008",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我嗎？",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我是來、",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "那個……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "難、",
    "voice": "vo_adv_1009011_009",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "難以啟齒……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "因為很在意自己的書賣得好不好就來了，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n總覺得這樣說",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "感覺好像很遜……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "我也是",
    "voice": "vo_adv_1009011_010",
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "來買東西的！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "嗯。",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "對，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "沒錯沒錯就是這個，",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "就是這道光……",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "嗯？",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "\\n這、",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "這道光芒",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "dialogue",
    "name": "修特帕魯",
    "words": "難道是……！",
    "voice": null,
    "unit_id": 100911
  },
  {
    "type": "background",
    "bg_id": "510300"
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "走在街上的{0}聽見了熟悉的聲音而停下了腳步。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "？？？",
    "words": "吾等乃飛舞於煉獄……",
    "voice": "vo_adv_1009011_011",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "啊哈哈，",
    "voice": "vo_adv_1009011_012",
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "真不愧是閃光的吉格魯特，",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n我就知道你能注意到我。",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "嗯？",
    "voice": "vo_adv_1009011_013",
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "怎麼了？",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n有什麼在意的事嗎？",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "呼呼呼，",
    "voice": "vo_adv_1009011_014",
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "這樣啊這樣啊。",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "你果然",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "很在意這個啊！",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "沒錯！",
    "voice": "vo_adv_1009011_015",
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "這正是",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "記載了我倆靈魂記憶的",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "「冥風戰記」！",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "什麼？",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "你說這只不過是塊平板？",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "哎，",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "你別先著急。",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "我們是透過《阿斯特朗傳奇》再度相遇的。",
    "voice": "vo_adv_1009011_016",
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n那麼此份記憶",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "會漂浮於電腦之海也沒什麼好奇怪的。",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "嗯，",
    "voice": "vo_adv_1009011_017",
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "也就是",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "電子的宇宙本源，",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "電靈偏在記憶！",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n用這個就能隨時隨地",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "把想到的……",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "不對，",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "是能夠在想起來的時候，",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "把記憶給記錄下來。",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "恰好紀錄告一個段落時，",
    "voice": "vo_adv_1009011_018",
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n就看見了你。",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "\\n",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
    "words": "啊哈哈，",
    "voice": null,
    "unit_id": 100931
  },
  {
    "type": "dialogue",
    "name": "杏奈",
