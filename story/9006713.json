[
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "卓越刺擊──",
    "voice": "vo_adv_9006713_000",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "螺旋！",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "唔嗚……！",
    "voice": "vo_adv_9006713_001",
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "……",
    "voice": "vo_adv_9006713_002",
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n到此為止",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "了吧……",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "沒能讓妳成佛，",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "真是遺憾呢……",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "格蕾斯。",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "……是啊。",
    "voice": "vo_adv_9006713_003",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "原本以為",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "妳還會再掙扎一下的。",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "雖然覺得已經足夠了……",
    "voice": "vo_adv_9006713_004",
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n……",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "多虧了妳，",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "讓我做了一場好夢。",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "…………",
    "voice": "vo_adv_9006713_005",
    "unit_id": 133114
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "來吧。",
    "voice": "vo_adv_9006713_006",
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n要殺要剮，",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "都隨你們。",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "剎鬼……！",
    "voice": "vo_adv_9006713_007",
    "unit_id": 135811
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "──該收尾了。",
    "voice": "vo_adv_9006713_008",
    "unit_id": 135913
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "\\n「六角納骨‧",
    "voice": null,
    "unit_id": 135913
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "獨鈷榫」。",
    "voice": null,
    "unit_id": 135913
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "──等一下！",
    "voice": "vo_adv_9006713_009",
    "unit_id": 133114
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n剎鬼……！",
    "voice": null,
    "unit_id": 133114
  },
  {
    "type": "dialogue",
    "name": "剎鬼",
    "words": "…………",
    "voice": "vo_adv_9006713_010",
    "unit_id": 135911
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "公主姐接……？",
    "voice": "vo_adv_9006713_011",
    "unit_id": 136911
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "唔……",
    "voice": "vo_adv_9006713_012",
    "unit_id": 133114
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "……真是的。",
    "voice": "vo_adv_9006713_013",
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n我還以為妳萌生了",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "身為公主應有的覺悟而對妳改觀了──",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n這可不行，",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "事到如今可不能阻止處刑啊。",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "畢竟我可是反叛者。",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "……黎薩。",
    "voice": "vo_adv_9006713_014",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n我代替公主，",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "有件事想問妳。",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "妳",
    "voice": "vo_adv_9006713_015",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "直到最後……",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "都沒有使用公主騎士之力吧。",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "\\n那是因為──",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "啊……",
    "voice": "vo_adv_9006713_016",
    "unit_id": 135811
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "\\n黎、",
    "voice": null,
    "unit_id": 135811
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "黎薩，",
    "voice": null,
    "unit_id": 135811
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "\\n難道妳並沒有認同",
    "voice": null,
    "unit_id": 135811
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "幻境龍后為公主，",
    "voice": null,
    "unit_id": 135811
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "所以才……？",
    "voice": null,
    "unit_id": 135811
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "…………誰知道呢。",
    "voice": "vo_adv_9006713_017",
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n大概單純只是……",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "不適合我吧。",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n那種只有在逆境",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "或背水一戰的情況下才會發動的強化。",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "……再說了。",
    "voice": "vo_adv_9006713_018",
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n我本來就不是那種會服侍人的性格。",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n對吧。",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "……我是個",
    "voice": "vo_adv_9006713_019",
    "unit_id": 133114
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "不爭氣的公主。",
    "voice": null,
    "unit_id": 133114
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133114
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "黎薩會那樣想，",
    "voice": null,
    "unit_id": 133114
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "也是必然的。",
    "voice": null,
    "unit_id": 133114
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "……即便如此。",
    "voice": "vo_adv_9006713_020",
    "unit_id": 133114
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133114
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "妳還是沒有向幻境龍后屈服……",
    "voice": null,
    "unit_id": 133114
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "我真的很開心。",
    "voice": null,
    "unit_id": 133114
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "…………",
    "voice": "vo_adv_9006713_021",
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "……對了。",
    "voice": "vo_adv_9006713_022",
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n我也還有兩件遺言",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "必須交代。",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "即便在這個人造世界裡──",
    "voice": "vo_adv_9006713_023",
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n我們的吉歐‧尼布爾黑爾",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "似乎也顯得格外異常。",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "雖然從芙蕾雅和幻境龍后那裡得到了情報，",
    "voice": "vo_adv_9006713_024",
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "也調查了許多。",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n但從騎士們所處的「現實」來說，",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "[rub:・]這[/rub][rub:・]應[/rub][rub:・]該[/rub][rub:・]是[/rub][rub:・]個[/rub][rub:・]無[/rub][rub:・]法[/rub][rub:・]活[/rub][rub:・]著[/rub][rub:・]抵[/rub][rub:・]達[/rub][rub:・]的[/rub][rub:・]世[/rub][rub:・]界[/rub]。",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "大家",
    "words": "……！",
    "voice": "vo_adv_9006713_025",
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "……什、",
    "voice": "vo_adv_9006713_026",
    "unit_id": 135811
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "什、",
    "voice": null,
    "unit_id": 135811
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "什麼意思？",
    "voice": null,
    "unit_id": 135811
  },
  {
    "type": "dialogue",
    "name": "雪野",
    "words": "\\n黎薩……",
    "voice": null,
    "unit_id": 135811
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "和騎士們不同。",
    "voice": "vo_adv_9006713_027",
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n我們的靈魂，",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "或許沒有回去的地方……",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "就是這個意思。",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "雖然我不確定",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "是否全員都一樣。",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "不過……",
    "voice": "vo_adv_9006713_028",
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "即便被他們拋下。",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n光憑妳們幾個，",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "也要仔細思考",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "讓這個世界延續下去的方法。",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "黎薩姐接……！",
    "voice": "vo_adv_9006713_029",
    "unit_id": 136911
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "\\n姐接難道素，",
    "voice": null,
    "unit_id": 136911
  },
  {
    "type": "dialogue",
    "name": "璐璐伊",
    "words": "為了這個原因才背叛的嗎……！？",
    "voice": null,
    "unit_id": 136911
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "那可不是。",
    "voice": "vo_adv_9006713_030",
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "我剛才不是說了嗎──",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "──我說做了個好夢。",
    "voice": "vo_adv_9006713_031",
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "拋開優等生的面具，",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n肆意妄為了一場……",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "看來",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "還挺開心的。",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "……另一件「遣言」",
    "voice": "vo_adv_9006713_032",
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "格蕾斯",
    "words": "又是什麼呢？",
    "voice": null,
    "unit_id": 133011
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "別欺負",
    "voice": "vo_adv_9006713_033",
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "黎薩",
    "words": "\\n庫喔。",
    "voice": null,
    "unit_id": 140414
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "我",
    "voice": "vo_adv_9006713_034",
    "unit_id": 133114
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "明白了……",
    "voice": null,
    "unit_id": 133114
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "黎薩。",
    "voice": null,
    "unit_id": 133114
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "\\n",
    "voice": null,
    "unit_id": 133114
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "唔……",
    "voice": null,
    "unit_id": 133114
  },
  {
    "type": "dialogue",
    "name": "薇歐莉特",
    "words": "皇權──",
