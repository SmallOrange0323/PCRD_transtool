  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "糟糕～！",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "這樣根本",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "沒辦法比賽了呢。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n可是",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "牠那麼生氣，",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "感覺也沒辦法溝通……",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "唔～嗯……",
    "voice": "vo_adv_5046301_002",
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "\\n可能只能讓牠冷靜下來，",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "初音",
    "words": "再請牠乖乖聽話……",
    "voice": null,
    "unit_id": 113411
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "是呢……",
    "voice": "vo_adv_5046301_003",
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "雖然很可憐，",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "現在看來只能這麼做了。",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
    "name": "美里",
    "words": "\\n抱歉，",
    "voice": null,
    "unit_id": 113511
  },
  {
    "type": "dialogue",
