[
  {
    "type": "background",
    "bg_id": "509040"
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "哎～呀哎呀哎呀？",
    "voice": "vo_adv_9500086_000",
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "阿貓阿馬的意思是，要選擇本小姐嗎？",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "嗯～",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "這也難怪，",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "對生命體來說，",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n會渴望宇宙第一美麗的本小姐",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "也是理所當然──",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "……不是？",
    "voice": "vo_adv_9500086_001",
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "嗯，",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "那麼……",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "哦！",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "難道這是什麼陷阱嗎！？",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "就為了陷害我！",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n是像之前那樣",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "有用胸針錄音嗎……！？",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "唔……",
    "voice": "vo_adv_9500086_002",
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "無、",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "無、",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "無法理解，",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "我完全無法理解……！",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "……一直無法勝過可恨的涅妃‧涅羅，",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n不管是偷走魔劍的計畫，",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "還是拉攏的計畫也全都落空……",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "還被浮現在走馬燈中的",
    "voice": "vo_adv_9500086_003",
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "你的面容……",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "搞",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "得在魔卡裡臉紅心跳……！",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n我盡幹些丟臉的事情，",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "你為什麼會選我！？",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "唔",
    "voice": "vo_adv_9500086_004",
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "────！！",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "……嗚。",
    "voice": "vo_adv_9500086_005",
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "……之前會想要得到你，",
    "voice": "vo_adv_9500086_006",
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "或許並不是、",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "想要拉攏你啊……",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "──好！",
    "voice": "vo_adv_9500086_007",
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n我就承認吧，",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "都這種時候了，就華麗地承認了！",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "聽好了喔？",
    "voice": "vo_adv_9500086_008",
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "不是你選中我！",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "而、",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "是、",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "本、",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "小",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "姐",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "我！",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "選了你！",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "選你成為最強且美麗的華音大人的、",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "獨一無二的馬先生！",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "要是你擅自不見，",
    "voice": "vo_adv_9500086_009",
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "我可不會原諒你喔。",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "因為你",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "就是屬於本小姐的……",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "……只屬於我",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "一個人的。",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "──唔，",
    "voice": "vo_adv_9500086_010",
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "我、",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "我剛剛什麼都沒說！！",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n快忘記！",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "裝作沒聽到！",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "\\n",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "……約好了喔，",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "阿貓阿馬",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "……要陪在",
    "voice": null,
    "unit_id": 134941
  },
  {
    "type": "dialogue",
    "name": "華音",
    "words": "我身邊。",
    "voice": null,
    "unit_id": 134941
  }
]
