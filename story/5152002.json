    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "……",
    "voice": "vo_adv_5152002_100",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "也是呢。",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
