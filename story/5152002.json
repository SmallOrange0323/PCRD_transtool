    "words": "\\n",
    "voice": null,
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "雖然有點令人心跳不已……",
    "voice": null,
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "但是雷姆也會盡全力努力的！",
