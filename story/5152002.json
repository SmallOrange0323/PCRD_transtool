  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "\\n……",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "不。",
    "voice": null,
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "妳什麼都沒有做錯喔，愛蜜莉雅醬。",
