  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "貪吃佩可等人跟愛蜜莉雅一行人在盛夏的海邊暫時擊退了白島鯨。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n但是就在那個時候，昴跟{0}被奪去了記憶，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n變得像小嬰兒一樣。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "──奪走記憶的能力。",
    "voice": "vo_adv_5152002_000",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n所以貪吃佩可剛剛",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "才沒有試圖接近牠戰鬥是嗎。",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "是的……",
    "voice": "vo_adv_5152002_001",
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n牠的能力我事前聽似似──",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "聽消息靈通的人說過了，",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "\\n",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "貪吃佩可",
    "words": "但是我並不知道牠奪走記憶的方法。",
    "voice": null,
    "unit_id": 107512
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "在那種狀況下，不知道從哪裡來的巴魯斯卻意氣風發地衝了過去呢。",
    "voice": "vo_adv_5152002_002",
    "unit_id": 109812
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "姊姊……",
    "voice": "vo_adv_5152002_003",
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "昴他──",
    "voice": null,
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "──昴先生他",
    "voice": "vo_adv_5152002_004",
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "非常地勇敢。",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n託他的福，",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "我們也明白了",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "白島鯨奪走記憶的方法。",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "可可蘿小姐……！",
    "voice": "vo_adv_5152002_005",
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "我們這邊在事前應該就已經知道那件事的老好人",
    "voice": "vo_adv_5152002_006",
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n也一股腦地衝出去了呢。",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "\\n",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "凱留",
    "words": "你們不用在意啦。",
    "voice": null,
    "unit_id": 107812
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "那麼，",
    "voice": "vo_adv_5152002_007",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "接下來",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "要怎麼辦才好……",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "白島鯨",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "好像也不知道逃到哪裡去了……",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "比起那個，",
    "voice": "vo_adv_5152002_008",
    "unit_id": 109812
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "應該問要怎麼處理「這個」，",
    "voice": null,
    "unit_id": 109812
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "才對吧。",
    "voice": null,
    "unit_id": 109812
  },
