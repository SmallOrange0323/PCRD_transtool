    "unit_id": 109812
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "昴，",
    "voice": "vo_adv_5152002_014",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "要怎麼樣你才會變回來呢……",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "……嗚？",
    "voice": "vo_adv_5152002_015",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "啊……",
    "voice": "vo_adv_5152002_016",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "對不起喔，",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "我露出了陰沉的表情。",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "昴真是的，",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "就算變成這樣也還在擔心我呢。",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "就算失去記憶，",
