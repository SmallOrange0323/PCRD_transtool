    "type": "dialogue",
    "name": "昴",
    "words": "吧哺？",
    "voice": "vo_adv_5152002_009",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "昴",
    "words": "噠──噠──！",
    "voice": "vo_adv_5152002_010",
    "unit_id": 2713
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "…",
    "voice": "vo_adv_5152002_011",
    "unit_id": 109812
  },
  {
    "type": "dialogue",
    "name": "拉姆",
    "words": "…噗。",
    "voice": null,
    "unit_id": 109812
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "姊姊？",
    "voice": "vo_adv_5152002_012",
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "妳為什麼要把臉轉過去不看昴？",
    "voice": null,
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "\\n",
    "voice": null,
    "unit_id": 132112
  },
  {
    "type": "dialogue",
    "name": "雷姆",
    "words": "是雷姆的錯覺嗎，",
