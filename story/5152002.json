  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "\\n",
    "voice": null,
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "我的尾巴很敏感的啊！？",
    "voice": null,
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "啊哇哇哇哇哇哇哇哇哇哇哇哇哇哇哇哇！",
    "voice": "vo_adv_5152002_095",
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "似乎不行呢……",
    "voice": "vo_adv_5152002_096",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "\\n抱歉喔，帕克。",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "你就再稍微忍耐一下吧？",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "怎麼這樣──！？",
