    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "如果是有可能被毀約的約定，",
    "voice": "vo_adv_1319002_084",
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "帕克",
    "words": "那是不是不要承諾比較好啊？",
    "voice": null,
    "unit_id": 2612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "……不，",
    "voice": "vo_adv_1319002_085",
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "愛蜜莉雅小姐。",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就算是那樣子，",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "我們還是來約定吧。",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n因為可能無法守約，",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "而連約定都無法承諾的話，",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "很讓人悲傷啊。",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "就算沒有一定能實現的保證，",
    "voice": "vo_adv_1319002_086",
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n想要與他人承諾約定的那份心意，",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "才是最重要的。",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "\\n",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "這是",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "可可蘿",
    "words": "在下的想法。",
    "voice": null,
    "unit_id": 107612
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "可可蘿……",
    "voice": "vo_adv_1319002_087",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "……",
    "voice": "vo_adv_1319002_088",
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "嗯，",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "說得也是呢。",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "愛蜜莉雅",
    "words": "我們約好了喔。",
    "voice": null,
    "unit_id": 131911
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "愛蜜莉雅一行人分享了在夏天海邊的回憶。",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n懷念今天的心情，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "還有對將來的遙想，",
    "voice": null,
    "unit_id": null
  },
  {
    "type": "dialogue",
    "name": "旁白",
    "words": "\\n寄宿到了大家的心中……",
    "voice": null,
    "unit_id": null
  }
]
